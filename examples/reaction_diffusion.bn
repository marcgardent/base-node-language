// @showcase camera=0.0,-5.0,3.6 rotation=55.0,0.0,0.0 lens=40 frames
// Gray-Scott reaction-diffusion on a square Grid, after Pearson, "Complex Patterns in a Simple
// System" (Science, 1993), and Turk, "Generating Textures on Arbitrary Surfaces Using
// Reaction-Diffusion" (SIGGRAPH 1991). Two chemicals U and V, in cell units:
//   dU/dt = du * lap(U) - U * V * V + feed * (1 - U)
//   dV/dt = dv * lap(V) + U * V * V - (feed + kill) * V
// The borders wrap around (a torus), so the pattern has no edge. U and V are kept in the
// x and y of the attribute "gray scott"; V alone in "v", for a material.

// The value of a field c at the neighbour (di, dj) of each vertex of an n x n Grid, wrapped
geometry graph wrapped(grid: Geometry, c: Vector, di: Int, dj: Int, n: Int) -> Vector {
  i = mod(floor(Index() / n) + di + n, n)
  j = mod(Index() + dj + n, n)
  return SampleIndex(grid, c, i * n + j, data_type: FLOAT_VECTOR)
}

// The 9-point Laplacian: 0.2 for each side, 0.05 for each corner, -1 for the cell
geometry graph laplacian(grid: Geometry, c: Vector, n: Int) -> Vector {
  sides = wrapped(grid, c, -1, 0, n)
    + wrapped(grid, c, 1, 0, n)
    + wrapped(grid, c, 0, -1, n)
    + wrapped(grid, c, 0, 1, n)
  corners = wrapped(grid, c, -1, -1, n)
    + wrapped(grid, c, 1, 1, n)
    + wrapped(grid, c, 1, -1, n)
    + wrapped(grid, c, -1, 1, n)
  return sides * 0.2 + corners * 0.05 - c
}

// One explicit Euler step of the two chemicals
geometry graph "gray scott step"(
    grid: Geometry,
    n: Int,
    rates: Vector,
    du: Float,
    dv: Float,
    dt: Float
) -> Geometry {
  c = NamedAttribute(name: "gray scott", data_type: FLOAT_VECTOR).attribute
  lap = laplacian(grid, c, n)
  react = c.x * c.y * c.y
  u = c.x + dt * (du * lap.x - react + rates.x * (1.0 - c.x))
  v = c.y + dt * (dv * lap.y + react - (rates.x + rates.y) * c.y)
  return StoreNamedAttribute(
    grid,
    name: "gray scott",
    value: CombineXYZ(u, v),
    data_type: FLOAT_VECTOR)
}

// U = 1 and V = 0 everywhere but in a few blobs placed by the seed, where U = 0.5, V = 0.5,
// with Pearson's 1% of noise
geometry graph "gray scott seed"(grid: Geometry, seed: Int) -> Geometry {
  blob = NoiseTexture(vector: Position(), w: seed, scale: 2.5, noise_dimensions: "4D").factor > 0.68
  noise = RandomValue(0.0, 0.01, seed: seed)
  start = (blob ? (0.5, 0.5, 0.0) : (1.0, 0.0, 0.0)) + CombineXYZ(-noise, noise)
  return StoreNamedAttribute(grid, name: "gray scott", value: start, data_type: FLOAT_VECTOR)
}

// Feed and kill of a preset, or the ones given; the time step no larger than the scheme holds
geometry graph "gray scott rates"(
    preset: Menu = Coral,
    feed: Float,
    kill: Float,
    du: Float,
    dv: Float,
    dt: Float
) -> (rates: Vector, dt: Float) {
  rates = MenuSwitch(
    preset,
    Spots: (0.03, 0.062, 0.0),
    Stripes: (0.029, 0.057, 0.0),
    Coral: (0.0545, 0.062, 0.0),
    Mitosis: (0.0367, 0.0649, 0.0),
    Custom: CombineXYZ(feed, kill))
  // The Laplacian of a checkerboard is -1.6 times it: an Euler step stays stable while
  // dt * D * 1.6 < 2, kept at dt * D <= 1 for the margin the reaction needs
  return (rates: rates, dt: min(dt, 1.0 / max(du, dv)))
}

// The grid lifted by V, which is kept in the attribute "v"
geometry graph "gray scott relief"(grid: Geometry, height: Float) -> Geometry {
  v = NamedAttribute(name: "gray scott", data_type: FLOAT_VECTOR).attribute.y
  return grid
    |> StoreNamedAttribute(name: "v", value: v)
    |> SetPosition(offset: CombineXYZ(z: v * height))
}

geometry graph "reaction diffusion"(
    grid: Geometry,
    preset: Menu = Coral,
    iterations: Int = 3000 in 0..,
    seed: Int = 0,
    height: Float = 0.1,
    "Custom"(default_closed: true) {
        feed: Float = 0.055 in 0.0..0.1,
        kill: Float = 0.062 in 0.0..0.1,
        du: Float = 1.0 in 0.0..,
        dv: Float = 0.5 in 0.0..,
        dt: Float = 1.0 in 0.0..
    }
) -> Geometry {
  "Grows a Gray-Scott pattern on a square Grid, `iterations` steps at once"
  n = floor(sqrt(DomainSize(grid).point_count) + 0.5)
  r = gray_scott_rates(preset, feed, kill, du, dv, dt)
  grown = repeat(iterations, g: gray_scott_seed(grid, seed)) -> {
    return (g: gray_scott_step(g, n, r.rates, du, dv, r.dt))
  }
  return gray_scott_relief(grown.g, height)
}

geometry graph "growing reaction diffusion"(
    grid: Geometry,
    preset: Menu = Coral,
    "steps per frame": Int = 40 in 1..,
    seed: Int = 0,
    height: Float = 0.1,
    "Custom"(default_closed: true) {
        feed: Float = 0.055 in 0.0..0.1,
        kill: Float = 0.062 in 0.0..0.1,
        du: Float = 1.0 in 0.0..,
        dv: Float = 0.5 in 0.0..,
        dt: Float = 1.0 in 0.0..
    }
) -> Geometry {
  "The same pattern growing frame after frame: `steps per frame` steps in each"
  n = floor(sqrt(DomainSize(grid).point_count) + 0.5)
  r = gray_scott_rates(preset, feed, kill, du, dv, dt)
  grown = simulate(g: gray_scott_seed(grid, seed)) -> {
    stepped = repeat(steps_per_frame, h: g) -> {
      return (h: gray_scott_step(h, n, r.rates, du, dv, r.dt))
    }
    return (g: stepped.h)
  }
  return gray_scott_relief(grown.g, height)
}

geometry graph "reaction diffusion tile"(
    resolution: Int = 256 in 3..,
    preset: Menu = Coral,
    iterations: Int = 3000 in 0..
) -> Geometry {
  "A 4 x 4 Grid grown with a Gray-Scott pattern"
  return Grid(4.0, 4.0, resolution, resolution)
    |> reaction_diffusion(preset: preset, iterations: iterations)
    |> SetShadeSmooth()
}
