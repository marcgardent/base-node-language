// @module title_sequence_step4
// @title A title sequence, step 4: a tagline typed on, with its cursor
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example title_sequence

use text_animate (animate_characters, text_characters, text_mesh, text_reveal, typewriter)

shader(material: true) graph Title() -> (surface: Shader) {
  "Warm white letters that give their own light, as opaque as their opacity"
  shown = Attribute[attribute_name: "opacity"]().factor
  return (
    surface: MixShader(
      factor: shown,
      a: TransparentBSDF(),
      b: Emission(color: (1.0, 0.86, 0.62), strength: 2.5)))
}

shader(material: true) graph Tagline() -> (surface: Shader) {
  "Cyan letters that give their own light"
  return (surface: Emission(color: (0.25, 0.8, 1.0), strength: 3.0))
}

geometry graph centred(geometry: Geometry) -> Geometry {
  "The geometry moved so that the middle of its bounding box is at the origin"
  box = BoundingBox(RealizeInstances(geometry), use_radius: false)
  return TransformGeometry(geometry, translation: (box.min + box.max) * -0.5)
}

geometry graph title(progress: Float(subtype: FACTOR)) -> Geometry {
  "The title, its letters falling into place in a random order as progress goes from 0 to 1"
  chars = text_characters(text: "NEON NIGHTS", size: 1.0, character_spacing: 1.15)
    |> centred()
  shown = text_reveal(
    chars,
    progress: progress,
    softness: 4.0,
    by: Character,
    order: Random,
    seed: 3)
  return chars
    |> animate_characters(
      amount: 1.0 - shown,
      offset: (0.0, 0.9, 0.0),
      rotation: -0.7,
      scale: 3.0,
      opacity: 0.0)
    |> text_mesh()
    |> SetMaterial(material: Title)
}

geometry graph tagline(progress: Float(subtype: FACTOR), blink: Bool) -> Geometry {
  "A line under the title, typed on as progress goes from 0 to 1, a cursor after its last letter, shown while it types and when blink is true"
  chars = text_characters(text: "LIVE FROM GEOMETRY NODES", size: 0.3, character_spacing: 1.6)
    |> centred()
  typed = typewriter(chars, progress: progress)
  line = BoundingBox(RealizeInstances(chars), use_radius: false)
  end = BoundingBox(RealizeInstances(typed), use_radius: false).max.x
  some = DomainSize[INSTANCES](typed).instance_count > 0
  x = some ? end + 0.08 : line.min.x
  shown = progress > 0.0 and (progress < 1.0 or blink)
  cursor = Grid(size_x: 0.035, size_y: 0.34, vertices_x: 2, vertices_y: 2)
    |> TransformGeometry(translation: CombineXYZ(x: x, y: (line.min.y + line.max.y) * 0.5))
  return text_mesh(typed) + Switch[GEOMETRY](switch: shown, true_: cursor)
    |> SetMaterial(material: Tagline)
    |> TransformGeometry(translation: (0.0, -1.05, 0.0))
}

geometry graph title_sequence() -> Geometry {
  "The title falls into place, then its tagline is typed on under it"
  f = SceneTime().frame
  return title(progress: Clamp(value: (f - 6.0) / 30.0))
    + tagline(progress: Clamp(value: (f - 34.0) / 30.0), blink: mod(f, 12.0) < 7.0)
}
