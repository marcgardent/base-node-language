// @module title_sequence_step6
// @title A title sequence, step 6: a comet, its echoes and its trail
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example title_sequence

use echoes (echoes, motion_trail)
use particles2d (particle_sprites_2d, particles_2d, shape_emitter)
use text_animate (animate_characters, text_characters, text_mesh, text_reveal, typewriter)

shader(material: true) graph Title() -> (surface: Shader) {
  "Warm white letters that give their own light, as opaque as their opacity"
  shown = Attribute(attribute_name: "opacity").factor
  return (
    surface: MixShader(shown, TransparentBSDF(), Emission(color: (1.0, 0.86, 0.62), strength: 2.5)))
}

shader(material: true) graph Tagline() -> (surface: Shader) {
  "Cyan letters that give their own light"
  return (surface: Emission(color: (0.25, 0.8, 1.0), strength: 3.0))
}

shader(material: true) graph Spark() -> (surface: Shader) {
  "A spark, white-hot gold at its birth, magenta at its end, as opaque as its opacity"
  life = Attribute(attribute_type: INSTANCER, attribute_name: "life_factor").factor
  shown = Attribute(attribute_type: INSTANCER, attribute_name: "opacity").factor
  hot = Mix(factor: life, a: (1.0, 0.62, 0.18, 1.0), b: (1.0, 0.08, 0.55, 1.0), data_type: RGBA)
  return (surface: MixShader(shown, TransparentBSDF(), Emission(color: hot, strength: 3.0)))
}

shader(material: true) graph Comet() -> (surface: Shader) {
  "The head and its echoes: white now, toward the tint stored on the oldest, as opaque as their opacity"
  tint = Attribute(attribute_name: "tint").color
  shown = Attribute(attribute_name: "opacity").factor
  return (surface: MixShader(shown, TransparentBSDF(), Emission(color: tint, strength: 4.0)))
}

shader(material: true) graph Trail() -> (surface: Shader) {
  "A magenta trail, fading to its tail"
  tail = Attribute(attribute_name: "trail_factor").factor
  return (
    surface: MixShader(
      1.0 - tail,
      TransparentBSDF(),
      Emission(color: (1.0, 0.1, 0.55), strength: 3.0)))
}

geometry graph centred(geometry: Geometry) -> Geometry {
  "The geometry moved so that the middle of its bounding box is at the origin"
  box = BoundingBox(RealizeInstances(geometry), use_radius: false)
  return TransformGeometry(geometry, translation: (box.min + box.max) * -0.5)
}

geometry graph title(progress: Float(subtype: FACTOR)) -> Geometry {
  "The letters of the title, still one instance each, falling into place in a random order as progress goes from 0 to 1"
  chars = text_characters(text: "NEON NIGHTS", size: 1.0, character_spacing: 1.15)
    |> centred()
  shown = text_reveal(
    chars,
    progress: progress,
    softness: 4.0,
    by: Character,
    order: Random,
    seed: 3)
  return animate_characters(
    chars,
    amount: 1.0 - shown,
    offset: (0.0, 0.9, 0.0),
    rotation: -0.7,
    scale: 3.0,
    opacity: 0.0)
}

geometry graph tagline(progress: Float(subtype: FACTOR), blink: Bool) -> Geometry {
  "A line under the title, typed on as progress goes from 0 to 1, a cursor after its last letter, shown while it types and when blink is true"
  chars = text_characters(text: "LIVE FROM GEOMETRY NODES", size: 0.3, character_spacing: 1.6)
    |> centred()
  typed = typewriter(chars, progress: progress)
  line = BoundingBox(RealizeInstances(chars), use_radius: false)
  end = BoundingBox(RealizeInstances(typed), use_radius: false).max.x
  some = DomainSize(typed, component: INSTANCES).instance_count > 0
  x = some ? end + 0.08 : line.min.x
  shown = progress > 0.0 and (progress < 1.0 or blink)
  cursor = Grid(size_x: 0.035, size_y: 0.34, vertices_x: 2, vertices_y: 2)
    |> TransformGeometry(translation: CombineXYZ(x: x, y: (line.min.y + line.max.y) * 0.5))
  return text_mesh(typed) + Switch(switch: shown, true_: cursor, input_type: GEOMETRY)
    |> SetMaterial(material: Tagline)
    |> TransformGeometry(translation: (0.0, -1.05, 0.0))
}

geometry graph sparks(letters: Geometry) -> Geometry {
  "Sparks born on the outline of the letters once they are more than half shown, thrown up, lifted, slowed and stirred; drawn as discs stretched along their speed, fading out"
  landed = DeleteGeometry(
    letters,
    selection: NamedAttribute(name: "opacity").attribute < 0.5,
    domain: INSTANCE)
  return shape_emitter(landed)
    |> particles_2d(
      rate: 300.0,
      seed: 7,
      speed: 1.3,
      speed_random: 0.7,
      spread: 1.6,
      life: 1.0,
      life_random: 0.6,
      gravity: (0.0, 0.6, 0.0),
      drag: 1.6,
      turbulence: 3.0,
      turbulence_size: 0.5)
    |> particle_sprites_2d(size: 0.03, size_end: 0.3, fade_in: 0.2, fade_out: 0.6, stretch: 2.0)
    |> SetMaterial(material: Spark)
    |> TransformGeometry(translation: (0.0, 0.0, 0.02))
}

geometry graph comet(progress: Float(subtype: FACTOR)) -> Geometry {
  "A bright disc that sweeps in from the left, under the title, and out at the top right as progress goes from 0 to 1, easing in and out; its echoes over the frames before, and a trail that thins to its tail"
  path = BezierSegment(64, (-7.5, -2.4, 0.0), (-1.5, -3.9, 0.0), (4.5, -2.6, 0.0), (6.8, 4.8, 0.0))
  eased = progress * progress * (3.0 - 2.0 * progress)
  at = SampleCurve(path, factor: eased).position
  head = MeshCircle(vertices: 24, radius: 0.13, fill_type: NGON)
    |> TransformGeometry(translation: at)
  echoed = head
    |> echoes(count: 6, every: 2, decay: 0.7, tint: (0.2, 0.75, 1.0, 1.0))
    |> SetMaterial(material: Comet)
  trail = Points(position: at)
    |> motion_trail(frames: 14, radius: 0.09)
    |> CurveToMesh(profile_curve: CurveCircle(resolution: 6, radius: 1.0), scale: Radius())
    |> SetMaterial(material: Trail)
  return echoed + trail
    |> TransformGeometry(translation: (0.0, 0.0, 0.04))
}

geometry graph title_sequence() -> Geometry {
  "The title falls into place throwing sparks off its letters, its tagline is typed on under it, and a comet sweeps past"
  f = SceneTime().frame
  letters = title(progress: Clamp(value: (f - 6.0) / 30.0))
  return (text_mesh(letters) |> SetMaterial(material: Title))
    + sparks(letters)
    + tagline(progress: Clamp(value: (f - 34.0) / 30.0), blink: mod(f, 12.0) < 7.0)
    + comet(progress: Clamp(value: (f - 36.0) / 36.0))
}
