// @module clone_wall_step8
// @title The clone wall, step 8: coloured by the weight
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example clone_wall

use cloners
use effectors
use falloffs

shader graph clone_paint(
    paint: Color = (1.0, 0.9, 0.78),
    hot: Color = (0.25, 0.95, 0.85),
    glow: Float = 0.6 in 0.0..
) -> Shader {
  "Satin plastic of the colour paint at rest, hot and glowing where the effect weighs"
  // weight, which the geometry stored on each clone: 0 at rest, 1 under the falloff
  w = Attribute(attribute_name: "weight").factor
  color = Mix(factor: w, a: paint, b: hot, data_type: RGBA)
  return PrincipledBSDF(
    base_color: color,
    roughness: 0.32,
    coat_weight: 0.4,
    emission_color: hot,
    emission_strength: w * w * glow)
}

shader(material: true) graph Cream() -> (surface: Shader) {
  return (surface: clone_paint())
}

shader(material: true) graph Coral() -> (surface: Shader) {
  return (surface: clone_paint(paint: (0.95, 0.4, 0.3)))
}

shader(material: true) graph Mustard() -> (surface: Shader) {
  return (surface: clone_paint(paint: (0.98, 0.68, 0.18)))
}

geometry graph rounded_cube(
    size: Float(subtype: DISTANCE) = 0.2,
    radius: Float(subtype: DISTANCE) = 0.04
) -> Geometry {
  "A cube of size, its edges and corners rounded by radius"
  // Every point of a dense cube pulled to radius from the core, a smaller cube inside it
  h = size * 0.5 - radius
  p = Position()
  core = min(max(p, CombineXYZ(-h, -h, -h)), CombineXYZ(h, h, h))
  return Cube(size: CombineXYZ(size, size, size), vertices_x: 9, vertices_y: 9, vertices_z: 9)
    |> SetPosition(position: core + normalize(p - core) * radius)
    |> SetShadeSmooth()
}

geometry graph clone_wall(
    period: Float = 3.0 in 0.1..,
    across: Vector = (1.0, 0.35, 0.0)
) -> Geometry {
  "The rippling wall, each clone coloured by the weight of the band where it is"
  // Once across the wall every period seconds, from off its left side to off its right
  front = fract(SceneTime().seconds / period) * 6.0 - 3.0
  // A band: up a ramp to the front, down an inverted ramp behind it; their minimum is a tent
  rise = linear_falloff(origin: CombineXYZ(x: front - 0.5), direction: across, length: 0.5)
  fall = invert_falloff(
    linear_falloff(origin: CombineXYZ(x: front), direction: across, length: 0.5))
  w = combine_falloffs(rise, fall, mode: Minimum)
  // The collection to pick from: a rounded cube, a ball (the same, fully rounded), a puck
  shapes = GeometryToInstance(
    rounded_cube() |> SetMaterial(material: Cream),
    rounded_cube(radius: 0.1) |> SetMaterial(material: Coral),
    Cylinder(vertices: 32, radius: 0.1, depth: 0.12).mesh |> SetMaterial(material: Mustard))
  return shapes
    |> grid_cloner(count_x: 18, count_y: 10, spacing: (0.22, 0.22, 0.22), pick: Random, seed: 4)
    // The weight where each clone stands, kept on it for the material
    |> StoreNamedAttribute(name: "weight", value: w, domain: INSTANCE)
    |> random_effector(
      offset: (0.02, 0.02, 0.1),
      rotation: (0.5, 0.5, 0.8),
      scale: 0.3,
      seed: 7,
      weight: w)
    |> plain_effector(offset: (0.0, 0.0, 0.5), scale: (0.35, 0.35, 0.35), weight: w)
    |> noise_effector(
      offset: (0.0, 0.0, 0.12),
      rotation: (0.25, 0.25, 0.0),
      size: 0.9,
      speed: 0.35,
      weight: w)
    |> spring_effector(stiffness: 70.0, damping: 3.5)
    // The grid lies on XY: stand it up, its face toward -Y, its bottom row on the floor
    |> TransformGeometry(translation: (0.0, 0.0, 1.14), rotation: (1.5707964, 0.0, 0.0))
    |> RealizeInstances()
}
