// @module lunar_ground_step8
// @title Lunar ground, step 8: details. Irregular rims, rough slopes, pits smaller than a vertex
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example lunar_ground

geometry graph crater_profile(
    x: Float,
    floor_depth: Float = -0.6 in -1.0..0.0,
    rim_width: Float = 0.5 in 0.0..,
    rim_steepness: Float = 0.8 in 0.0..,
    smoothness: Float = 0.25 in 0.0..
) -> (height: Float) {
  "Height of a crater at x radii from its centre: -1 at the bottom of the bowl, 0 far away"
  bowl = x * x - 1.0
  floored = Math(bowl, floor_depth, smoothness, operation: SMOOTH_MAX)
  outside = min(x - 1.0 - rim_width, 0.0)
  rim = rim_steepness * outside * outside
  return (height: Math(floored, rim, smoothness, operation: SMOOTH_MIN))
}

geometry graph crater_field(
    p: Vector,
    scale: Float = 1.5 in 0.0..,
    seed: Float,
    density: Float = 0.8 in 0.0..1.0,
    depth: Float = 0.5 in 0.0..
) -> (height: Float, young: Float) {
  "One crater or none in each Voronoi cell, scale cells per metre"
  cell = VoronoiTexture(vector: p, w: seed, scale: scale, randomness: 0.8, voronoi_dimensions: "4D")
  radius = 0.2 + cell.color.x * 0.25
  // A noise a quarter of a cell wide pulls the rim in and out: no crater is a perfect circle
  wobble = NoiseTexture(vector: p, w: seed, scale: scale * 4.0, noise_dimensions: "4D").factor
  x = cell.distance / radius * (0.85 + wobble * 0.3)
  here = cell.color.y < density
  age = cell.color.z
  edge = VoronoiTexture(
    vector: p,
    w: seed,
    scale: scale,
    randomness: 0.8,
    voronoi_dimensions: "4D",
    feature: DISTANCE_TO_EDGE)
  fade = Clamp(edge.distance * 6.0) * here
  height = crater_profile(x).height * radius / scale * depth * (1.0 - age * 0.7)
  return (height: height * fade, young: (1.0 - age) * (1.0 - age) * Clamp(1.5 - x) * fade)
}

geometry graph slab(ground: Geometry, bottom: Float = -0.3) -> Geometry {
  "Walls down from the border of a ground to a flat bottom"
  border = EdgeNeighbors().face_count == 1
  before = DomainSize(ground).point_count
  p = Position()
  return ground
    |> ExtrudeMesh(selection: border, offset: CombineXYZ(z: -1.0), mode: EDGES).mesh
    |> SetPosition(selection: Index() >= before, position: CombineXYZ(x: p.x, y: p.y, z: bottom))
}

shader graph pits(p: Vector, scale: Float = 40.0 in 0.0..) -> (height: Float) {
  "Small bowls, one in half of the Voronoi cells, scale cells per metre"
  cell = VoronoiTexture(vector: p, scale: scale, randomness: 0.8)
  radius = 0.15 + cell.color.x * 0.2
  x = cell.distance / radius
  // No Compare in a shader tree: Math's Less Than gives 1 or 0
  here = Math(cell.color.y, 0.5, operation: LESS_THAN)
  return (height: min(x * x - 1.0, 0.0) * radius / scale * 0.5 * here)
}

shader(material: true) graph Regolith() -> (surface: Shader) {
  "Grey dust, lighter around young craters, grainy and pitted"
  young = Attribute(attribute_name: "young").factor
  p = TextureCoordinate().object
  patches = NoiseTexture(vector: p, scale: 0.6, detail: 4.0).factor
  grain = NoiseTexture(vector: p, scale: 80.0, detail: 6.0, roughness: 0.7).factor
  // Heights in metres, as the geometry's: Bump at distance 1.0 and strength 1.0 lights them as relief
  relief = (grain - 0.5) * 0.004 + pits(p, 40.0).height + pits(p + (7.1, 3.3, 0.0), 110.0).height
  grey = 0.07 + patches * 0.08 + young * 0.2
  dust = PrincipledBSDF(
    base_color: CombineColor(red: grey, green: grey, blue: grey * 0.94),
    roughness: 1.0,
    normal: Bump(strength: 1.0, distance: 1.0, height: relief))
  return (surface: dust)
}

geometry graph lunar_ground(
    size: Float = 4.0 in 0.1..,
    resolution: Int = 1200 in 2..,
    craters: Float = 0.8 in 0.0..,
    layers: Int = 6 in 1..8,
    density: Float = 0.8 in 0.0..1.0
) -> Geometry {
  "A square of lunar ground: a rolling plain, craters of every size, on a slab"
  p = Position()
  flat = CombineXYZ(x: p.x, y: p.y)
  plain = (NoiseTexture(vector: flat, scale: 0.4, detail: 3.0).factor - 0.5) * 0.3
  // Rough ground at every scale under a few centimetres: craters dig into it, it covers them
  rough = (NoiseTexture(vector: flat, scale: 6.0, detail: 10.0, roughness: 0.6).factor - 0.5) * 0.05
  field = repeat(layers, height: 0.0, young: 0.0, scale: craters) {
    c = crater_field(flat, scale: scale, seed: iteration, density: density)
    return (height: height + c.height, young: max(young, c.young), scale: scale * 2.0)
  }
  return Grid(size, size, resolution, resolution)
    |> SetPosition(offset: CombineXYZ(z: plain + rough + field.height))
    |> StoreNamedAttribute(name: "young", value: field.young)
    |> slab()
    |> SetMaterial(material: Regolith)
}
