// @module valley_step1
// @title The valley, step 1: a valley on a grid
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example valley

shader graph valley_ground(clay: Color = (0.3, 0.27, 0.24)) -> Shader {
  "Clay, to see the shape and nothing else"
  return PrincipledBSDF(base_color: clay, roughness: 0.9)
}

shader(material: true) graph Ground() -> (surface: Shader) {
  return (surface: valley_ground())
}

geometry graph valley() -> Geometry {
  "A valley that winds along x, on a grid of square cells"
  // 6 m by 4 m, a point every 3.3 cm: 181 by 121 points, square cells
  grid = Grid(size_x: 6.0, size_y: 4.0, vertices_x: 181, vertices_y: 121).mesh
  // The valley winds: its middle swings 40 cm either side of y = 0 along x
  middle = sin(Position().x * 1.1) * 0.4
  // 0 along the middle of the valley, 1 two metres away
  across = (Position().y - middle) / 2.0
  sides = across * across
  return grid
    |> SetPosition(offset: CombineXYZ(z: sides))
    |> SetShadeSmooth()
    |> SetMaterial(material: Ground)
}
