// @module final_shot_step5
// @title The final shot, step 5: glow and light wrap
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender-compositor
// @offer groups

use light
use merge (keymix, over, with_alpha)
use passes

compositor graph final_shot() -> Color {
  "The render rebuilt from its passes, the sphere painted blue, a warm light added, a haze, the light spilling over the edges"
  l = RenderLayers()
  // The sphere, found in the world by the Position pass; its colour changed, its light kept
  sphere = p_matte(l.position, (-1.2, 2.2, 0.9), 0.9, 0.05).matte
  paint = keymix((0.04, 0.16, 0.45, 1.0), l.diffuse_color, sphere)
  beauty = rebuild_beauty(
    diffuse_direct: l.diffuse_direct,
    diffuse_indirect: l.diffuse_indirect,
    diffuse_color: paint,
    glossy_direct: l.glossy_direct,
    glossy_indirect: l.glossy_indirect,
    glossy_color: l.glossy_color,
    transmission_direct: l.transmission_direct,
    transmission_indirect: l.transmission_indirect,
    transmission_color: l.transmission_color,
    emission: l.emission,
    environment: l.environment,
    alpha: l.alpha)
  // A point light at the bulb of the lamp post, on the colours of the diffuse surfaces
  lit = beauty
    |> relight(
      paint,
      l.normal,
      l.position,
      light_position: (1.7, 1.2, 3.05),
      light_color: (1.0, 0.6, 0.3, 1.0),
      intensity: 12.0)
  // A haze, thicker with the distance; the sky has no depth, and a matte of the first
  // kilometre keeps the haze off it
  solid = depth_slice(l.depth, 0.0, 1000.0, 1.0).matte
  hazy = lit
    |> depth_fog(l.depth, (0.09, 0.06, 0.06, 1.0), near: 5.0, far: 1000.0, density: 0.005)
  shot = keymix(hazy, lit, solid)
  // The sky bleeds over the edges of what stands in front of it: the solid things cut out by
  // their matte, the sky alone from the Environment pass
  front = with_alpha(shot * solid, solid)
  wrapped = over(light_wrap(front, l.environment, 15.0, 2.0), shot)
  // What is brighter than white blooms: the bulbs, the windows
  return wrapped
    |> glow(1.0, 0.6, 0.9, 3.0)
}
