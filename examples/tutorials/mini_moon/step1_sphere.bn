// @module mini_moon_step1
// @title Mini moon, step 1: a sphere of even triangles
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example mini_moon

geometry graph mini_moon(radius: Float = 1.0 in 0.0.., subdivisions: Int = 8 in 1..9) -> Geometry {
  "A sphere of even triangles: an icosahedron whose triangles are cut in four, again and again"
  return IcoSphere(radius: radius, subdivisions: subdivisions).mesh
    |> SetShadeSmooth()
}
