// @module mini_moon_step3
// @title Mini moon, step 3: one layer of craters, each in the plane of its own normal
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example mini_moon

geometry graph crater_profile(
    x: Float,
    floor_depth: Float = -0.6 in -1.0..0.0,
    rim_width: Float = 0.5 in 0.0..,
    rim_steepness: Float = 0.8 in 0.0..,
    smoothness: Float = 0.25 in 0.0..
) -> (height: Float) {
  "Height of a crater at x radii from its centre: -1 at the bottom of the bowl, 0 far away"
  bowl = x * x - 1.0
  floored = smooth_max(bowl, floor_depth, smoothness)
  outside = min(x - 1.0 - rim_width, 0.0)
  rim = rim_steepness * outside * outside
  return (height: smooth_min(floored, rim, smoothness))
}

geometry graph crater_sites(surface: Geometry, size: Float = 0.3 in 0.0.., seed: Int) -> Geometry {
  "Crater centres on a surface, at least three radii apart: the craters of one layer never touch"
  apart = size * 3.0
  sites = surface
    |> DistributePointsOnFaces[POISSON](
      distance_min: apart,
      density_max: 4.0 / (apart * apart),
      seed: seed)
  return sites.points
    |> StoreNamedAttribute[FLOAT_VECTOR](name: "normal", value: sites.normal)
    |> StoreNamedAttribute(
      name: "radius",
      value: RandomValue(min: size * 0.5, max: size, seed: seed))
    |> StoreNamedAttribute(name: "age", value: RandomValue(seed: seed + 1))
}

geometry graph crater_layer(
    p: Vector,
    sites: Geometry,
    depth: Float = 0.5 in 0.0..
) -> (height: Float) {
  "The height a layer of craters gives a point: from the nearest site, in the plane of its normal"
  i = SampleNearest(sites, sample_position: p).index
  centre = SampleIndex[FLOAT_VECTOR](sites, value: Position(), index: i)
  n = SampleIndex[FLOAT_VECTOR](
    sites,
    value: NamedAttribute[FLOAT_VECTOR](name: "normal"),
    index: i)
  radius = SampleIndex(sites, value: NamedAttribute(name: "radius"), index: i)
  age = SampleIndex(sites, value: NamedAttribute(name: "age"), index: i)
  v = p - centre
  across = v - n * (v ⋅ n)
  wobble = NoiseTexture(vector: p / radius, scale: 1.5).factor
  x = length(across) / radius * (1.0 + wobble * 0.3)
  height = crater_profile(x: x).height * radius * depth * (1.0 - age * 0.7)
  return (height: height)
}

geometry graph mini_moon(
    radius: Float = 1.0 in 0.0..,
    subdivisions: Int = 8 in 1..9,
    largest: Float = 0.3 in 0.0..
) -> Geometry {
  "A sphere and one layer of craters, dug along its normals"
  sphere = IcoSphere(radius: radius, subdivisions: subdivisions).mesh
  craters = crater_layer(p: Position(), sites: crater_sites(sphere, size: largest, seed: 0))
  return sphere
    |> SetPosition(offset: Normal() * craters.height)
    |> SetShadeSmooth()
}
