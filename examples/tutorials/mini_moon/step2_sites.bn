// @module mini_moon_step2
// @title Mini moon, step 2: where the craters go
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example mini_moon

geometry graph crater_sites(surface: Geometry, size: Float = 0.3 in 0.0.., seed: Int) -> Geometry {
  "Crater centres on a surface, at least three radii apart: the craters of one layer never touch"
  apart = size * 3.0
  sites = surface
    |> DistributePointsOnFaces(
      distance_min: apart,
      density_max: 4.0 / (apart * apart),
      seed: seed,
      distribute_method: POISSON)
  return sites.points
    |> StoreNamedAttribute(name: "normal", value: sites.normal, data_type: FLOAT_VECTOR)
    |> StoreNamedAttribute(
      name: "radius",
      value: RandomValue(min: size * 0.5, max: size, seed: seed))
    |> StoreNamedAttribute(name: "age", value: RandomValue(seed: seed + 1))
}

shader(material: true) graph Marker() -> (surface: Shader) {
  "An orange that shows in the dark"
  return (surface: Emission(color: (1.0, 0.45, 0.1), strength: 1.5))
}

geometry graph mini_moon(
    radius: Float = 1.0 in 0.0..,
    subdivisions: Int = 8 in 1..9,
    largest: Float = 0.3 in 0.0..
) -> Geometry {
  "A sphere and the sites of one layer of craters, each drawn as the disc its crater will cover"
  sphere = IcoSphere(radius: radius, subdivisions: subdivisions).mesh
  normal = NamedAttribute(name: "normal", data_type: FLOAT_VECTOR)
  discs = crater_sites(sphere, size: largest, seed: 0)
    |> InstanceOnPoints(
      instance: MeshCircle(vertices: 48, fill_type: NGON).mesh,
      rotation: AlignRotationToVector(vector: normal),
      scale: NamedAttribute(name: "radius") * 1.5)
    |> SetMaterial(material: Marker)
  return (sphere |> SetShadeSmooth()) + discs
}
