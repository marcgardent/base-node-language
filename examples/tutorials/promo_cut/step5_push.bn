// @module promo_cut_step5
// @title The promo cut, step 5: push
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender
// @offer groups

use mask2d (circle_mask)
use merge (keymix, over)
use transitions

compositor graph title_card() -> Color {
  "The title over a backdrop in the colours of the podium: magenta at its heart, a deep blue at its edges"
  title = Image[image: "promo-cut-plate-c.png"]().image
  heart = circle_mask(title, radius: 0.1, feather: 1.1).mask
  return over(title, b: keymix(a: (0.35, 0.02, 0.25, 1.0), b: (0.01, 0.01, 0.06, 1.0), mask: heart))
}

compositor graph promo_cut() -> Color {
  "The hills push the podium out to the left, the title pushes the hills up, the podium pushes the title out to the right: 12 frames each"
  a = Image[image: "promo-cut-plate-a.png"]().image
  b = Image[image: "promo-cut-plate-b.png"]().image
  c = title_card()
  ab = push(
    a,
    b: b,
    progress: frame_progress(start: 11.0, length: 12.0, ease: true),
    direction: Left).image
  bc = push(
    ab,
    b: c,
    progress: frame_progress(start: 35.0, length: 12.0, ease: true),
    direction: Up).image
  return push(
    bc,
    b: a,
    progress: frame_progress(start: 59.0, length: 12.0, ease: true),
    direction: Right).image
}
