// @module promo_cut_step7
// @title The promo cut, step 7: tape and glitch
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender-compositor
// @offer groups

use stylize (glitch_blocks, scanlines, vhs)
use transitions (frame_progress, push)

compositor graph burst(at: Float, width: Float = 6.0 in 1.0..) -> Float {
  "1 at the frame at, down to 0 width frames before and after"
  return max(1.0 - abs(SceneTime().frame - at) / width, 0.0)
}

compositor graph promo_cut() -> Color {
  "A hard push from the podium to the hills at frame 25, on a video tape, torn by glitch blocks around the cut"
  a = Image(image: "promo-cut-plate-a.png").image
  b = Image(image: "promo-cut-plate-b.png").image
  cut = push(a, b, frame_progress(21.0, 8.0, true), direction: Left).image
  return cut
    |> vhs(shift: 2.0, jitter: 1.0, noise: 0.02, lines: 0.0, seed: 1.0)
    |> scanlines(spacing: 3.0, thickness: 0.4, darkness: 0.3, roll: 0.25).image
    |> glitch_blocks(
      block: (64.0, 10.0),
      amount: 0.6 * burst(25.0),
      shift: 48.0,
      split: 6.0,
      seed: 5.0,
      animated: true).image
}
