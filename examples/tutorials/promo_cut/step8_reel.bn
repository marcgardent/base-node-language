// @module promo_cut_step8
// @title The promo cut, step 8: the reel
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender-compositor
// @offer groups

use grade (exposure_stops, grade)
use mask2d (circle_mask)
use merge (alpha_of, keymix, over)
use stylize
use transitions

compositor graph title_card() -> Color {
  "The title over a backdrop in the colours of the podium: magenta at its heart, a deep blue at its edges"
  title = Image(image: "promo-cut-plate-c.png").image
  heart = circle_mask(title, 0.1, 1.1).mask
  return over(title, keymix((0.35, 0.02, 0.25, 1.0), (0.01, 0.01, 0.06, 1.0), heart))
}

compositor graph comic(image: Color) -> Color {
  "The image printed as a comic: its colours in four levels as the eye sees them, dots of ink in its shadows"
  ink = (0.03, 0.01, 0.06, 1.0)
  seen = grade(image, gamma: (2.2, 2.2, 2.2))
  flat = seen
    |> posterize(4)
    |> grade(gamma: (0.4545, 0.4545, 0.4545))
  dots = halftone(exposure_stops(seen, 1.0), cell: 7.0, ink: ink).mask
  return keymix(ink, flat, dots * 0.85)
}

compositor graph burst(at: Float, width: Float = 6.0 in 1.0..) -> Float {
  "1 at the frame at, down to 0 width frames before and after"
  return max(1.0 - abs(SceneTime().frame - at) / width, 0.0)
}

compositor graph promo_cut() -> Color {
  "A loop of 96 frames: the podium pushed out by the hills in print, developed; an iris to the title, whose neon flickers on; a dip through magenta back to the podium; glitches at the cuts, scanlines, a lens"
  a = Image(image: "promo-cut-plate-a.png").image
  b = Image(image: "promo-cut-plate-b.png").image
  title = Image(image: "promo-cut-plate-c.png").image
  // The hills come in printed, and a wipe develops them
  hills = linear_wipe(comic(b), b, frame_progress(31.0, 14.0, true), softness: 0.05).image
  // The title in a tube of light that comes on, flickers off and on again
  f = SceneTime().frame
  on = frame_progress(57.0, 3.0) * (1.0 - 0.9 * (f > 61.0) * (f < 64.0))
  card = neon_outline(
    title_card(),
    matte: alpha_of(title),
    color: (1.0, 0.25, 0.75, 1.0),
    width: 2,
    glow: 16.0,
    intensity: 1.6 * on).image
  // The cut
  ab = push(a, hills, frame_progress(19.0, 8.0, true), direction: Left).image
  bc = iris_wipe(ab, card, frame_progress(47.0, 10.0, true), softness: 0.03).image
  ca = dip_to_color(bc, a, frame_progress(79.0, 14.0), color: (0.6, 0.02, 0.3, 1.0)).image
  // Torn at the cuts, on a screen, through a lens
  g = burst(23.0) + burst(52.0, 4.0)
  return ca
    |> glitch_blocks(
      block: (64.0, 10.0),
      amount: 0.6 * g,
      shift: 48.0,
      split: 6.0,
      seed: 5.0,
      animated: true).image
    |> scanlines(spacing: 3.0, thickness: 0.4, darkness: 0.2, roll: 0.25).image
    |> chromatic_aberration(amount: 3.0 + 12.0 * g)
    |> vignette(amount: 0.6, radius: 0.55, softness: 0.8).image
}
