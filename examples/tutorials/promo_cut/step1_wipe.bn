// @module promo_cut_step1
// @title The promo cut, step 1: a linear wipe
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender
// @offer groups

use transitions (linear_wipe)

compositor graph wipe_at(progress: Float(subtype: FACTOR) = 0.5 in 0.0..1.0) -> Color {
  "The podium wiped away by the hills, along 30°, a soft edge; progress 0 shows the podium, 1 the hills"
  a = Image(image: "promo-cut-plate-a.png").image
  b = Image(image: "promo-cut-plate-b.png").image
  return linear_wipe(a, b: b, progress: progress, angle: 0.5235988, softness: 0.04).image
}

compositor graph promo_cut() -> Color {
  "The cut, halfway through the wipe"
  return wipe_at(progress: 0.5)
}
