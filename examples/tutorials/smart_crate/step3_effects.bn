// @module smart_crate_step3
// @title Smart crate, step 3: dents, rivets and chips in the mesh
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example smart_crate

use generators
use mesh_effects
use mesh_maps

shader graph crate_steel(
    paint: Color = (0.03, 0.12, 0.16),
    steel: Color = (0.62, 0.62, 0.6),
    grime: Color = (0.05, 0.035, 0.02),
    wear: Float = 0.45 in 0.0..1.0
) -> Shader {
  "Paint, then bare steel in the chips of the mesh and where the edges wear, then grime"
  e = mesh_effects_read()
  "Bare steel" #orange {
    worn = max(
      e.chip,
      metal_edge_wear(wear_level: wear, grunge_amount: 0.7, grunge_scale: 0.05, seed: 1))
    chipped = Mix[RGBA](factor: worn, a: paint, b: steel)
  }
  "Grime" #violet {
    dirty = dirt(dirt_level: 0.45, grime: 0.2, seed: 2)
    color = Mix[RGBA](factor: dirty * 0.85, a: chipped, b: grime)
  }
  return PrincipledBSDF(
    base_color: color,
    metallic: worn * (1.0 - dirty),
    roughness: Mix(factor: worn, a: 0.4, b: 0.3) + dirty * 0.3)
}

shader(material: true) graph CrateSteel() -> (surface: Shader) {
  "The crate's material: crate_steel, whose inputs on its node in the material tune it"
  return (surface: crate_steel())
}

geometry graph smart_crate() -> Geometry {
  "A steel crate, dented, riveted and chipped in its mesh, its maps stored"
  // A box 1 m wide, and a lid that overhangs it by 7.5 cm; vertices 1.5 cm apart, for the wear
  // to have points to work on
  body = Cube(size: (1.0, 1.0, 1.0), vertices_x: 67, vertices_y: 67, vertices_z: 67).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 0.5))
  lid = Cube(size: (1.15, 1.15, 0.08), vertices_x: 77, vertices_y: 77, vertices_z: 11).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 1.04))
  // The rivets stay whole: the effects after them leave them out
  rivet = NamedAttribute(name: "mesh_rivet").attribute
  return body + lid
    |> dents(size: 0.25, depth: 0.015, density: 0.4, seed: 7)
    |> rivets(spacing: 0.07, inset: 0.035, radius: 0.009, height: 0.6, angle: 1.2)
    |> chip_edges(
      depth: 0.006,
      wear: 0.45,
      width: 0.015,
      selection: rivet < 0.5,
      size: 0.04,
      seed: 4)
    |> mesh_maps(radius: 0.04, strength: 1.5, ao_distance: 0.6, ao_samples: 24, sky_distance: 0.6)
    |> SetMaterial(material: CrateSteel)
}
