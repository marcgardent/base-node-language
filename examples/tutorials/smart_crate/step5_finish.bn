// @module smart_crate_step5
// @title Smart crate, step 5: paint runs and dust
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example smart_crate

use generators
use mesh_effects
use mesh_maps

shader graph crate_steel(
    paint: Color = (0.03, 0.12, 0.16),
    steel: Color = (0.62, 0.62, 0.6),
    rust: Color = (0.22, 0.07, 0.02),
    grime: Color = (0.05, 0.035, 0.02),
    dust_color: Color = (0.5, 0.45, 0.37),
    wear: Float = 0.45 in 0.0..1.0
) -> Shader {
  "Paint, then bare steel in the chips and where the edges wear, rust, grime, dust"
  e = mesh_effects_read()
  "Bare steel" #orange {
    // Not on the paint run down over the edges
    worn = max(
        e.chip,
        metal_edge_wear(wear_level: wear, grunge_amount: 0.7, grunge_scale: 0.05, seed: 1))
      * (1.0 - e.drip)
    chipped = Mix(factor: worn, a: paint, b: steel, data_type: RGBA)
  }
  "Rust" #red {
    // A little rust in the cavities, and the streaks the mesh stores
    spread = dripping_rust(rust_spreading: 0.2, drips_intensity: 0.0, seed: 6)
    rusty = Mix(
      factor: max(spread.mask * 0.8, Clamp(value: e.streak * 1.6)),
      a: chipped,
      b: rust,
      data_type: RGBA)
  }
  "Grime" #violet {
    dirty = dirt(dirt_level: 0.45, grime: 0.2, seed: 2)
    soiled = Mix(factor: dirty * 0.85, a: rusty, b: grime, data_type: RGBA)
  }
  "Dust" #yellow {
    // Settled on what faces up, and the specks the mesh scatters
    dusty = max(dust(dust_level: 0.35, grunge_scale: 0.2, seed: 4) * 0.5, e.dust)
    color = Mix(factor: dusty, a: soiled, b: dust_color, data_type: RGBA)
  }
  return PrincipledBSDF(
    base_color: color,
    metallic: worn * (1.0 - dirty) * (1.0 - dusty) * (1.0 - e.streak),
    roughness: Mix(factor: worn, a: 0.4, b: 0.3)
      + dirty * 0.3
      + dusty * 0.4
      + e.streak * 0.3
      - e.drip * 0.15)
}

shader(material: true) graph CrateSteel() -> (surface: Shader) {
  "The crate's material: crate_steel, whose inputs on its node in the material tune it"
  return (surface: crate_steel())
}

geometry graph smart_crate() -> Geometry {
  "A steel crate, dented, riveted, chipped, rust streaked, paint run down, dusty"
  // A box 1 m wide, and a lid that overhangs it by 7.5 cm; vertices 1.5 cm apart, for the wear
  // to have points to work on
  body = Cube(size: (1.0, 1.0, 1.0), vertices_x: 67, vertices_y: 67, vertices_z: 67).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 0.5))
  lid = Cube(size: (1.15, 1.15, 0.08), vertices_x: 77, vertices_y: 77, vertices_z: 11).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 1.04))
  // The rivets stay whole: the effects after them leave them out
  rivet = NamedAttribute(name: "mesh_rivet").attribute
  return body + lid
    |> dents(size: 0.25, depth: 0.015, density: 0.4, seed: 7)
    |> rivets(spacing: 0.07, inset: 0.035, radius: 0.009, height: 0.6, angle: 1.2)
    |> chip_edges(
      depth: 0.006,
      wear: 0.45,
      width: 0.015,
      selection: rivet < 0.5,
      size: 0.04,
      seed: 4)
    |> mesh_maps(radius: 0.04, strength: 1.5, ao_distance: 0.6, ao_samples: 24, sky_distance: 0.6)
    |> streaks(
      density: 80.0,
      length: 0.55,
      width: 0.015,
      seed: 8,
      selection: rivet < 0.5,
      edges: 0.4,
      rivets: 0.35)
    |> drips(density: 60.0, seed: 3, selection: rivet < 0.5, edges: 0.2)
    |> dust_scatter(
      density: 600.0,
      size: 0.003,
      seed: 5,
      selection: rivet + NamedAttribute(name: "mesh_drip").attribute < 0.5)
    |> SetMaterial(material: CrateSteel)
}
