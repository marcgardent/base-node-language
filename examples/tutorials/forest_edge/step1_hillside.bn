// @module forest_edge_step1
// @title Forest edge, step 1: a hillside and a path
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example forest_edge

shader graph meadow(
    grass: Color = (0.1, 0.19, 0.04),
    dry: Color = (0.27, 0.25, 0.1),
    rock: Color = (0.26, 0.21, 0.15)
) -> Shader {
  "Grass, drier in patches, bare rock where the ground is steep"
  g = Geometry()
  patches = NoiseTexture(vector: g.position, scale: 0.06, detail: 4.0).factor
  green = Mix(factor: Clamp(value: (patches - 0.45) * 4.0), a: grass, b: dry, data_type: RGBA)
  // The normal of flat ground is straight up: past 32 degrees the rock shows
  steep = MapRange(value: g.normal.z, from_min: 0.85, from_max: 0.8)
  return PrincipledBSDF(
    base_color: Mix(factor: steep, a: green, b: rock, data_type: RGBA),
    roughness: 0.9)
}

shader(material: true) graph Meadow() -> (surface: Shader) {
  return (surface: meadow())
}

shader(material: true) graph Dirt() -> (surface: Shader) {
  return (surface: PrincipledBSDF(base_color: (0.3, 0.2, 0.11), roughness: 0.95))
}

geometry graph hill_height(p: Vector = Position()) -> Float {
  "A hillside rising to a crest 40 m away, a steep bank across it, hummocks of noise"
  crest = 40.0 + sin(p.x * 0.04) * 8.0
  d = (p.y - crest) / 40.0
  hill = 24.0 * exp(0.0 - d * d)
  // The bank: 5 m higher over 6 m, steeper on the right of the hill than on the left
  foot = -12.0 + sin(p.x * 0.05 + 1.0) * 6.0
  bank = MapRange(value: p.y, from_min: foot, from_max: foot + 6.0, interpolation_type: SMOOTHSTEP)
    * Clamp(value: 0.6 + p.x / 50.0)
    * 5.0
  hummocks = (NoiseTexture(vector: p * 0.02, scale: 1.0, detail: 4.0).factor - 0.5) * 8.0
  return hill + bank + hummocks
}

geometry graph hill_path() -> Geometry {
  "A path that winds up the hillside and over its crest, on its ground"
  line = CurveLine(start: (-6.0, -90.0, 0.0), end: (14.0, 60.0, 0.0))
    |> ResampleCurve(count: 300)
  p = Position()
  xy = CombineXYZ(x: p.x + sin(p.y * 0.06) * 9.0, y: p.y)
  return SetPosition(line, position: xy + CombineXYZ(z: hill_height(xy)))
}

geometry graph forest_edge() -> Geometry {
  "A hillside 180 m wide and a path up it"
  // A point every 50 cm: small hummocks, and a smooth bank
  ground = Grid(size_x: 180.0, size_y: 180.0, vertices_x: 361, vertices_y: 361).mesh
    |> SetPosition(offset: CombineXYZ(z: hill_height()))
    |> SetShadeSmooth()
  path = hill_path()
  // The path, a strip of dirt 2.4 m wide laid on the ground
  strip = CurveToMesh(path, profile_curve: CurveLine(start: (-1.2, 0.0, 0.0), end: (1.2, 0.0, 0.0)))
    |> SetPosition(offset: (0.0, 0.0, 0.08))
    |> SetMaterial(material: Dirt)
  return SetMaterial(ground, material: Meadow) + strip
}
