// @module forest_edge_step5
// @title Forest edge, step 5: no two trees alike
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example forest_edge

use scatter

shader graph meadow(
    grass: Color = (0.1, 0.19, 0.04),
    dry: Color = (0.27, 0.25, 0.1),
    rock: Color = (0.26, 0.21, 0.15)
) -> Shader {
  "Grass, drier in patches, bare rock where the ground is steep"
  g = Geometry()
  patches = NoiseTexture(vector: g.position, scale: 0.06, detail: 4.0).factor
  green = Mix[RGBA](factor: Clamp(value: (patches - 0.45) * 4.0), a: grass, b: dry)
  // The normal of flat ground is straight up: past 32 degrees the rock shows
  steep = MapRange(value: g.normal.z, from_min: 0.85, from_max: 0.8)
  return PrincipledBSDF(base_color: Mix[RGBA](factor: steep, a: green, b: rock), roughness: 0.9)
}

shader(material: true) graph Meadow() -> (surface: Shader) {
  return (surface: meadow())
}

shader(material: true) graph Dirt() -> (surface: Shader) {
  return (surface: PrincipledBSDF(base_color: (0.3, 0.2, 0.11), roughness: 0.95))
}

shader(material: true) graph Needles() -> (surface: Shader) {
  "Dark green, a little lighter or darker from one tree to the next"
  tint = Mix[RGBA](factor: ObjectInfo().random, a: (0.025, 0.07, 0.025), b: (0.06, 0.13, 0.035))
  return (surface: PrincipledBSDF(base_color: tint, roughness: 0.8))
}

shader(material: true) graph Leaves() -> (surface: Shader) {
  "Fresh green, from one tree to the next"
  tint = Mix[RGBA](factor: ObjectInfo().random, a: (0.06, 0.15, 0.03), b: (0.17, 0.24, 0.05))
  return (surface: PrincipledBSDF(base_color: tint, roughness: 0.7))
}

shader(material: true) graph Bark() -> (surface: Shader) {
  return (surface: PrincipledBSDF(base_color: (0.12, 0.08, 0.05), roughness: 0.85))
}

geometry graph hill_height(p: Vector = Position()) -> Float {
  "A hillside rising to a crest 40 m away, a steep bank across it, hummocks of noise"
  crest = 40.0 + sin(p.x * 0.04) * 8.0
  d = (p.y - crest) / 40.0
  hill = 24.0 * exp(0.0 - d * d)
  // The bank: 5 m higher over 6 m, steeper on the right of the hill than on the left
  foot = -12.0 + sin(p.x * 0.05 + 1.0) * 6.0
  bank = MapRange[SMOOTHSTEP](value: p.y, from_min: foot, from_max: foot + 6.0)
    * Clamp(value: 0.6 + p.x / 50.0)
    * 5.0
  hummocks = (NoiseTexture(vector: p * 0.02, scale: 1.0, detail: 4.0).factor - 0.5) * 8.0
  return hill + bank + hummocks
}

geometry graph hill_path() -> Geometry {
  "A path that winds up the hillside and over its crest, on its ground"
  line = CurveLine(start: (-6.0, -90.0, 0.0), end: (14.0, 60.0, 0.0))
    |> ResampleCurve(count: 300)
  p = Position()
  xy = CombineXYZ(x: p.x + sin(p.y * 0.06) * 9.0, y: p.y)
  return SetPosition(line, position: xy + CombineXYZ(z: hill_height(p: xy)))
}

geometry graph trunk(height: Float = 3.0, radius: Float = 0.25) -> Geometry {
  "A trunk standing on the origin"
  return Cylinder(vertices: 8, radius: radius, depth: height).mesh
    |> TransformGeometry(translation: CombineXYZ(z: height * 0.5))
    |> SetMaterial(material: Bark)
}

geometry graph pine() -> Geometry {
  "A pine 10 m tall: three cones of needles on a trunk"
  low = Cone(vertices: 12, radius_bottom: 2.6, depth: 4.5).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 2.2))
  middle = Cone(vertices: 12, radius_bottom: 2.0, depth: 4.0).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 4.2))
  top = Cone(vertices: 12, radius_bottom: 1.3, depth: 3.5).mesh
    |> TransformGeometry(translation: (0.0, 0.0, 6.5))
  return SetMaterial(low + middle + top, material: Needles) + trunk(height: 3.0)
}

geometry graph broadleaf() -> Geometry {
  "A round tree 8 m tall: a lumpy crown on a trunk"
  lumps = NoiseTexture(vector: Position(), scale: 0.6, detail: 2.0).factor - 0.5
  crown = IcoSphere(radius: 2.6, subdivisions: 3).mesh
    |> SetPosition(offset: Normal() * lumps * 2.0)
    |> TransformGeometry(translation: (0.0, 0.0, 5.4), scale: (1.0, 1.0, 1.1))
    |> SetShadeSmooth()
    |> SetMaterial(material: Leaves)
  return crown + trunk(height: 3.6, radius: 0.22)
}

geometry graph forest_edge(seed: Int, tree_line: Float(subtype: DISTANCE) = 17.0) -> Geometry {
  "A hillside 180 m wide, a path up it, and groves of pines and round trees on its gentle slopes below the tree line, off the path"
  // A point every 50 cm: small hummocks, and a smooth bank
  ground = Grid(size_x: 180.0, size_y: 180.0, vertices_x: 361, vertices_y: 361).mesh
    |> SetPosition(offset: CombineXYZ(z: hill_height()))
    |> SetShadeSmooth()
  path = hill_path()
  // The path, a strip of dirt 2.4 m wide laid on the ground
  strip = CurveToMesh(path, profile_curve: CurveLine(start: (-1.2, 0.0, 0.0), end: (1.2, 0.0, 0.0)))
    |> SetPosition(offset: (0.0, 0.0, 0.08))
    |> SetMaterial(material: Dirt)
  // 6 trees per 100 square metres, none closer than 3 m to another, none on the bank
  // (steeper than 27 degrees) nor above the tree line (17 m); fewer toward every edge
  points = scatter(
    ground,
    density: 0.06,
    spacing: 3.0,
    seed: seed,
    thinning: 1.0,
    slope_max: 0.47,
    slope_softness: 0.1,
    altitude_max: tree_line,
    altitude_softness: 4.0,
    // Nothing within 3 m of the path, fewer for 4 m more
    paths: path,
    clearance: 3.0,
    falloff: 4.0,
    // Groves about 25 m wide over 70 % of the ground, glades between them
    noise: 1.0,
    noise_size: 25.0,
    coverage: 0.7)
  // Two pines for a round tree, picked at random; up, whatever the slope; spun, a little
  // tilted, 0.7 to 1.3 times their size, and down to half of it at the edge of a grove
  trees = place_instances(
    points,
    instance: GeometryToInstance(pine(), pine(), broadleaf()),
    seed: seed,
    align: 0.0,
    tilt: 0.06,
    scale_min: 0.7,
    scale_max: 1.3,
    edge_scale: 0.5,
    pick_instance: true)
  return SetMaterial(ground, material: Meadow) + strip + trees
}
