// @module tileable_stone_step2
// @title Tileable stone, step 2: stones laid by a tile sampler
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender-compositor
// @offer groups

use texture_atoms

compositor graph tileable_stone(image: Color) -> (height: Float, id: Float) {
  "Stones laid on a grid of five by five, rounded squares domed, moved, turned and sized at random; pebbles in the gaps"
  t = texture_canvas(image, size: 1024)
  stones = tile_sampler(
    t,
    columns: 5,
    rows: 5,
    shape: Square,
    roundness: 0.5,
    profile: Dome,
    size: 1.1,
    size_random: 0.2,
    offset_random: 0.25,
    rotation_random: 0.1,
    luminance_random: 0.3,
    seed: 3.0)
  pebbles = tile_sampler(
    t,
    columns: 11,
    rows: 11,
    profile: Dome,
    size: 0.7,
    size_random: 0.5,
    offset_random: 0.9,
    luminance_random: 0.5,
    seed: 4.0)
  // The stones over the pebbles: the pebbles, lower, only show in the gaps
  low = pebbles.height * 0.45
  on_stone = stones.height >= low
  return (
    height: max(stones.height, low),
    id: Mix(factor: on_stone, a: pebbles.id * 0.5, b: stones.id))
}
