// @module tileable_stone_step6
// @title Tileable stone, step 6: curvature, occlusion, colour
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender
// @offer groups

use texture_atoms
use texture_filters

compositor graph tileable_stone(
    image: Color
) -> (albedo: Color, roughness: Float, curvature: Float, occlusion: Float) {
  "The maps a material needs besides the height: curvature and ambient occlusion from it, and from those a colour and a roughness"
  t = texture_canvas(image, size: 1024)
  stones = tile_sampler(
    t,
    columns: 5,
    rows: 5,
    shape: Square,
    roundness: 0.5,
    profile: Dome,
    size: 1.1,
    size_random: 0.2,
    offset_random: 0.25,
    rotation_random: 0.1,
    luminance_random: 0.3,
    seed: 3.0)
  pebbles = tile_sampler(
    t,
    columns: 11,
    rows: 11,
    profile: Dome,
    size: 0.7,
    size_random: 0.5,
    offset_random: 0.9,
    luminance_random: 0.5,
    seed: 4.0)
  // The stones over the pebbles, as in step 2
  low = pebbles.height * 0.45
  laid = max(stones.height, low)
  // Warp: each pixel read away along the slope of a broad noise, so that the straight sides bend
  wobble = tileable_noise(t, scale: 4.0, detail: 1.0, seed: 5.0)
  warped = warp(laid, warp: wobble, intensity: 0.008)
    |> SeparateColor().red
  // The random grey of each stone, warped with it: a tone per stone
  id = warp(
      Mix(factor: stones.height >= low, a: pebbles.id * 0.5, b: stones.id),
      warp: wobble,
      intensity: 0.008)
    |> SeparateColor().red
  // Slope blur: the height smeared down the slopes of a finer noise, as water and frost wear it
  grit = tileable_noise(t, scale: 10.0, detail: 2.0, seed: 6.0)
  eroded = slope_blur(warped, slope: grit, intensity: 0.006)
    |> SeparateColor().red
  // Chips: the borders of the stones, found by edge detection, knocked off where the grit is high
  edges = edge_detect(height: warped, strength: 0.025)
  chips = edges * histogram_scan(height: grit, position: 0.54, contrast: 0.6)
  // Cracks: the edges of Voronoi cells, scanned to thin lines, cut into the stones only
  cells = tileable_cells(t, scale: 3, seed: 2.0)
  cracks = 1.0 - histogram_scan(height: cells.edge, position: 0.03, contrast: 0.97)
  on_stone = histogram_scan(height: eroded, position: 0.33, contrast: 0.8)
  grain = tileable_noise(t, scale: 48.0, detail: 4.0, roughness: 0.6, seed: 7.0)
  carved = eroded - chips * 0.08 - cracks * on_stone * 0.06 + (grain - 0.5) * 0.03
  // Levels: the gaps down to 0, the tops up to flat, the mid-tones raised by the gamma
  height = levels(height: carved, in_low: 0.08, in_high: 1.0, gamma: 1.6)
  // Curvature: bright on the edges, dark in the hollows, from the height a little blurred so that
  // the grain does not drown the shapes; occlusion: dark where the heights around stand above
  curvature = height_curvature(
    height: height_blur(height: height, size: 6.0),
    depth: 0.02,
    strength: 0.008)
  occlusion = height_occlusion(height: height, radius: 64.0, strength: 4.0)
  // Colour: two tones of stone mixed by the grey of each, stained by a broad noise and speckled;
  // dirt in the gaps; the edges worn lighter where they stand out
  tone = Mix[RGBA](factor: id, a: (0.08, 0.075, 0.07, 1.0), b: (0.3, 0.25, 0.19, 1.0))
  stain = tileable_noise(t, scale: 5.0, detail: 6.0, roughness: 0.55, seed: 1.0)
  speckle = tileable_noise(t, scale: 32.0, detail: 6.0, roughness: 0.65, seed: 8.0)
  stone = tone
    * (0.5 + levels(height: stain, in_low: 0.3, in_high: 0.7) * 0.7)
    * (0.6 + speckle * 0.8)
  gap = 1.0 - histogram_scan(height: height, position: 0.2, contrast: 0.75)
  dirty = Mix[RGBA](factor: gap, a: stone, b: (0.06, 0.05, 0.04, 1.0))
  worn = max(curvature - 0.5, 0.0) * 2.0
  albedo = Mix[RGBA](factor: worn * 0.6, a: dirty, b: dirty * 1.6)
  // Roughness: rough stone, rougher dirt, polished a little where feet wear the edges
  roughness = 0.62 + gap * 0.3 - worn * 0.25 + speckle * 0.1
  return (albedo: albedo, roughness: roughness, curvature: curvature, occlusion: occlusion)
}
