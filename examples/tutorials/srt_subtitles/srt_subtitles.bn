// SubRip subtitles (.srt): the cue of the scene time, read from the file and drawn as text
//
//   1
//   00:00:01,000 --> 00:00:04,200
//   First cue, one line or more.
//
//   2
//   …
//
// Blocks are parted by a blank line; a block holds an index, a timing line and its text.
// Windows line ends (\r\n), a byte order mark and extra blank lines are read too.

geometry graph srt_seconds(stamp: String) -> Float {
  "Seconds of an SRT time stamp, HH:MM:SS,mmm"
  h = StringToValue(string: SliceString(string: stamp, length: 2))
  m = StringToValue(string: SliceString(string: stamp, position: 3, length: 2))
  s = StringToValue(string: SliceString(string: stamp, position: 6, length: 2))
  ms = StringToValue(string: SliceString(string: stamp, position: 9, length: 3))
  return h.value * 3600.0 + m.value * 60.0 + s.value + ms.value / 1000.0
}

geometry graph srt_cue(srt: String, time: Float) -> (text: String, start: Float, end: Float) {
  "The cue of an SRT text shown at a time in seconds: its text, its start and its end"
  line_break = SpecialCharacters()
  "Line ends" #slategray {
    // A file written on Windows ends its lines with \r\n: the \r goes, whatever is before a break
    first = FindInString(string: srt, search: line_break.line_break)
    before = SliceString(string: srt, position: first.first_found - 1.0, length: 1)
    cr = StringLength(string: TrimString(string: before)) == 0 ? before : ""
    pair = JoinStrings(strings: cr, strings: line_break.line_break)
    text = ReplaceString(string: srt, find: pair, replace: line_break.line_break)
    // Two links from one output to a multi-input are one: the blank line is made by a replace
    blank = ReplaceString(string: "||", find: "|", replace: line_break.line_break)
  }
  "Blocks" #teal {
    blocks = FindInString(string: text, search: blank).count + 1.0
    cues = repeat(blocks, rest: text, shown: "", start: 0.0, end: 0.0) {
      gap = FindInString(string: rest, search: blank)
      size = gap.count > 0 ? gap.first_found : StringLength(string: rest)
      block = SliceString(string: rest, length: size)
      // The timing line: HH:MM:SS,mmm --> HH:MM:SS,mmm, its text on the lines after it
      arrow = FindInString(string: block, search: "-->")
      begin = srt_seconds(
        stamp: SliceString(string: block, position: arrow.first_found - 13.0, length: 12))
      finish = srt_seconds(
        stamp: SliceString(string: block, position: arrow.first_found + 4.0, length: 12))
      timing = SliceString(string: block, position: arrow.first_found, length: size)
      lines = SliceString(
        string: timing,
        position: FindInString(string: timing, search: line_break.line_break).first_found + 1.0,
        length: size)
      now = arrow.count > 0 and time >= begin and time < finish
      return (
        rest: SliceString(string: rest, position: size + 2.0, length: StringLength(string: rest)),
        shown: now ? lines : shown,
        start: now ? begin : start,
        end: now ? finish : end)
    }
  }
  return (text: cues.shown, start: cues.start, end: cues.end)
}

geometry graph "srt subtitles"(
    file: String(subtype: FILE_PATH),
    offset: Float,
    size: Float = 0.5 in 0.0..,
    fill: Bool = true
) -> (geometry: Geometry, text: String) {
  "The subtitle of the scene time, from an .srt file; offset shifts the subtitles, in seconds"
  cue = srt_cue(srt: ImportText(path: file), time: SceneTime().seconds - offset)
  // The tags SRT allows in a text are dropped: italic, bold, underline
  shown = ReplaceString(
    string: ReplaceString(
      string: ReplaceString(
        string: ReplaceString(
          string: ReplaceString(string: ReplaceString(string: cue.text, find: "<i>"), find: "</i>"),
          find: "<b>"),
        find: "</b>"),
      find: "<u>"),
    find: "</u>")
  curves = StringToCurves(
      string: shown,
      size: size,
      align_x: Center,
      align_y: "Bottom Baseline").curve_instances
    |> RealizeInstances()
  return (geometry: fill ? FillCurve(curves) : curves, text: shown)
}
