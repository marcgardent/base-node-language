// @module refuge_step3
// @title The refuge, step 3: a window and a door
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example refuge

use poly_bevel
use poly_extrude

shader graph refuge_paint(
    paint: Color = (0.62, 0.16, 0.05),
    door_color: Color = (0.07, 0.09, 0.1),
    glow: Float = 0.0 in 0.0..10.0
) -> Shader {
  "Painted steel, the door darker, the window dark glass that glows with glow"
  door = Attribute(attribute_name: "door").factor
  glass = Attribute(attribute_name: "glass").factor
  walls = Mix(factor: door, a: paint, b: door_color, data_type: RGBA)
  glazed = Mix(factor: glass, a: walls, b: (0.02, 0.03, 0.04, 1.0), data_type: RGBA)
  return PrincipledBSDF(
    base_color: glazed,
    metallic: 0.3,
    roughness: 0.45 - glass * 0.42,
    emission_color: (1.0, 0.62, 0.28, 1.0),
    emission_strength: glass * glow)
}

shader(material: true) graph RefugePaint() -> (surface: Shader) {
  "The refuge's material: refuge_paint, whose inputs on its node in the material tune it"
  return (surface: refuge_paint())
}

shader(material: true) graph Concrete() -> (surface: Shader) {
  "The plinth, and the mast"
  return (surface: PrincipledBSDF(base_color: (0.42, 0.41, 0.39), roughness: 0.8))
}

geometry graph refuge() -> Geometry {
  "A hut on a plinth: a window, a door"
  // What the tools store, read back as fields; p and n, the position and the normal
  front = NamedAttribute(name: "poly_front", data_type: BOOLEAN).attribute
  p = Position()
  n = Normal().normal
  "Box" #blue {
    // 3 m by 2.2 m, 2.5 m tall, its faces 25 cm apart: the openings are made of them
    box = Cube(size: (3.0, 2.2, 2.5), vertices_x: 13, vertices_y: 9, vertices_z: 11).mesh
      |> TransformGeometry(translation: (0.0, 0.0, 1.5))
      |> poly_bevel(width: 0.06)
    plinth = Cube(size: (3.5, 2.7, 0.25)).mesh
      |> TransformGeometry(translation: (0.0, 0.0, 0.125))
      |> chamfer_corners(width: 0.12)
  }
  "Openings" #teal {
    // On the front wall: a window 1 m square, a door 1 m by 2 m, each a region of faces
    window = n.y < -0.99 and p.x > -1.2 and p.x < -0.3 and p.z > 1.3 and p.z < 2.2
    doorway = n.y < -0.99 and p.x > 0.3 and p.x < 1.2 and p.z < 2.2
    opened = box
      |> poly_extrude(selection: window, distance: -0.12, inset: 0.08, individual: false)
      |> StoreNamedAttribute(name: "glass", value: front, domain: FACE)
      // Marks pile up: take the window's away, so that front is the door's alone
      |> RemoveNamedAttribute(pattern_mode: Wildcard, name: "poly_*")
      |> poly_extrude(selection: doorway, distance: -0.08, inset: 0.06, individual: false)
      |> StoreNamedAttribute(name: "door", value: front, domain: FACE)
  }
  hut = opened
    |> SetMaterial(material: RefugePaint)
  base = plinth
    |> SetMaterial(material: Concrete)
  return hut + base
}
