// @module refuge_step6
// @title The refuge, step 6: a boolean hatch
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example refuge

use modeling
use poly_bevel
use poly_extrude

shader graph refuge_paint(
    paint: Color = (0.62, 0.16, 0.05),
    door_color: Color = (0.07, 0.09, 0.1),
    steel: Color = (0.06, 0.065, 0.07),
    trim: Color = (0.75, 0.74, 0.7),
    glow: Float = 0.0 in 0.0..10.0
) -> Shader {
  "Painted steel, from what the tools stored: the door darker, the vents and the roof bare steel, the fascia and the hatch pale, the window dark glass that glows with glow"
  door = Attribute(attribute_name: "door").factor
  glass = Attribute(attribute_name: "glass").factor
  louvre = Attribute(attribute_name: "louvre").factor
  roof = Attribute(attribute_name: "roof").factor
  fascia = Attribute(attribute_name: "fascia").factor
  hatch = Attribute(attribute_name: "bool_cut").factor
  walls = Mix(factor: door, a: paint, b: door_color, data_type: RGBA)
  vents = Mix(factor: louvre, a: walls, b: steel, data_type: RGBA)
  roofed = Mix(factor: roof, a: vents, b: steel, data_type: RGBA)
  trimmed = Mix(factor: max(fascia, hatch), a: roofed, b: trim, data_type: RGBA)
  glazed = Mix(factor: glass, a: trimmed, b: (0.02, 0.03, 0.04, 1.0), data_type: RGBA)
  return PrincipledBSDF(
    base_color: glazed,
    metallic: 0.3 + roof * 0.5,
    roughness: 0.45 - glass * 0.42 - roof * 0.1,
    emission_color: (1.0, 0.62, 0.28, 1.0),
    emission_strength: glass * glow)
}

shader(material: true) graph RefugePaint() -> (surface: Shader) {
  "The refuge's material: refuge_paint, whose inputs on its node in the material tune it"
  return (surface: refuge_paint())
}

shader(material: true) graph Concrete() -> (surface: Shader) {
  "The plinth, and the mast"
  return (surface: PrincipledBSDF(base_color: (0.42, 0.41, 0.39), roughness: 0.8))
}

geometry graph refuge() -> Geometry {
  "A hut on a plinth: a window, a door, vents, a roof and a mast, a round hatch"
  // What the tools store, read back as fields; p and n, the position and the normal
  front = NamedAttribute(name: "poly_front", data_type: BOOLEAN).attribute
  side = NamedAttribute(name: "poly_side", data_type: BOOLEAN).attribute
  cell = NamedAttribute(name: "bevel_face", data_type: BOOLEAN).attribute
  p = Position()
  n = Normal().normal
  "Box" #blue {
    // 3 m by 2.2 m, 2.5 m tall, its faces 25 cm apart: the openings are made of them
    box = Cube(size: (3.0, 2.2, 2.5), vertices_x: 13, vertices_y: 9, vertices_z: 11).mesh
      |> TransformGeometry(translation: (0.0, 0.0, 1.5))
      |> poly_bevel(width: 0.06)
    plinth = Cube(size: (3.5, 2.7, 0.25)).mesh
      |> TransformGeometry(translation: (0.0, 0.0, 0.125))
      |> chamfer_corners(width: 0.12)
  }
  "Openings" #teal {
    // On the front wall: a window 1 m square, a door 1 m by 2 m, each a region of faces
    window = n.y < -0.99 and p.x > -1.2 and p.x < -0.3 and p.z > 1.3 and p.z < 2.2
    doorway = n.y < -0.99 and p.x > 0.3 and p.x < 1.2 and p.z < 2.2
    opened = box
      |> poly_extrude(selection: window, distance: -0.12, inset: 0.08, individual: false)
      |> StoreNamedAttribute(name: "glass", value: front, domain: FACE)
      // Marks pile up: take the window's away, so that front is the door's alone
      |> RemoveNamedAttribute(pattern_mode: Wildcard, name: "poly_*")
      |> poly_extrude(selection: doorway, distance: -0.08, inset: 0.06, individual: false)
      |> StoreNamedAttribute(name: "door", value: front, domain: FACE)
  }
  "Vents" #violet {
    // On the right wall, nine faces of the box, each pushed in on its own
    grille = cell and n.x > 0.99 and p.y > -1.0 and p.y < -0.3 and p.z > 0.55 and p.z < 1.2
    vented = opened
      |> RemoveNamedAttribute(pattern_mode: Wildcard, name: "poly_*")
      |> poly_extrude(selection: grille, distance: -0.04, inset: 0.03)
      |> StoreNamedAttribute(name: "louvre", value: front or side, domain: FACE)
  }
  "Roof" #orange {
    // The top grown out flat (the soffit), pushed up (the fascia), then up and in (the roof)
    roofed = vented
      |> RemoveNamedAttribute(pattern_mode: Wildcard, name: "poly_*")
      |> poly_extrude(
        selection: n.z > 0.99 and p.z > 2.7,
        distance: 0.0,
        taper: 1.1,
        individual: false)
      // Drop the sides so far: the front stays to be pushed, and side is the next one's alone
      |> RemoveNamedAttribute(name: "poly_side")
      |> poly_extrude(selection: front, distance: 0.16, individual: false)
      |> StoreNamedAttribute(name: "fascia", value: side, domain: FACE)
      |> RemoveNamedAttribute(name: "poly_side")
      |> poly_extrude(selection: front, distance: 0.55, taper: 0.4, individual: false)
      |> StoreNamedAttribute(name: "roof", value: front or side, domain: FACE)
    mast = Cylinder(vertices: 16, radius: 0.05, depth: 1.5).mesh
      |> TransformGeometry(translation: (0.3, 0.2, 4.0))
  }
  "Hatch" #red {
    // A disc 64 cm across sunk 15 cm into the right wall
    cutter = Cylinder(vertices: 48, radius: 0.32, depth: 0.3).mesh
      |> TransformGeometry(translation: (1.5, 0.42, 1.88), rotation: (0.0, 1.5707964, 0.0))
    holed = roofed
      |> boolean_cut(cutter)
  }
  hut = holed
    |> SetMaterial(material: RefugePaint)
  base = plinth + mast
    |> SetMaterial(material: Concrete)
  return hut + base
}
