// @module engraved_map_step3
// @title Engraved map, step 3: cross-hatching in the shade
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example engraved_map

use hachures2d (hatch_cross, lehmann_hachures)
use sdf2d (sdf_segment_2d)

geometry graph summit(p: Vector, centre: Vector, height: Float, width: Float) -> Float {
  "A round hill: height at its centre, falling off over about width"
  d = distance(p, centre) / width
  return height * exp(-d * d)
}

geometry graph river_course(x: Float) -> Float {
  "Where the river runs: its y at x, a slow bend from west to east"
  return 0.3 * sin(x * 1.3 + 0.6) - 0.12 * x
}

geometry graph valley_height(p: Vector = Position()) -> Float {
  "Height of the ground at p: a gorge between two shoulders, two summits, a side stream, some noise"
  // d: how far north of the river; the gorge is steep, the shoulders above it gentle
  d = p.y - river_course(x: p.x)
  gorge = 0.6 * (1.0 - exp(-d * d * 8.0)) + 0.2 * max(abs(d) - 0.4, 0.0)
  north = summit(p: p, centre: (-0.75, 0.85, 0.0), height: 0.85, width: 0.45)
  south = summit(p: p, centre: (1.0, -0.8, 0.0), height: 0.65, width: 0.4)
  stream = sdf_segment_2d(p: p, a: (1.0, 1.4, 0.0), b: (0.35, 0.15, 0.0), thickness: 0.0)
  side = 0.3 * exp(-stream * stream * 30.0)
  // Rough ground, but not on the floor of the gorge: the river keeps it smooth
  noise = NoiseTexture(vector: p, scale: 1.4, detail: 3.0).factor - 0.5
  rough = noise * 0.3 * Clamp(value: abs(d) * 4.0)
  return gorge + north + south - side + rough
}

geometry graph valley_slope(p: Vector = Position()) -> Vector {
  "The gradient of valley_height: it points uphill, and its length is the slope"
  e = 0.005
  h = valley_height(p: p)
  dx = valley_height(p: p + CombineXYZ(x: e)) - h
  dy = valley_height(p: p + CombineXYZ(y: e)) - h
  return CombineXYZ(x: dx / e, y: dy / e, z: 0.0)
}

geometry graph contours(
    width: Float = 3.6 in 0.1..,
    height: Float = 2.6 in 0.1..,
    interval: Float = 0.1 in 0.01..,
    levels: Int = 16 in 1..64,
    radius: Float = 0.004 in 0.0..
) -> Geometry {
  "One curve per level of valley_height, every interval; every fifth one twice as thick"
  ground = Grid(size_x: width, size_y: height, vertices_x: 361, vertices_y: 261).mesh
  r = repeat(levels, lines: JoinGeometry()) -> {
    level = interval * (iteration + 1)
    // The faces above the level; their edge, but not the edge of the map, is the contour
    p = Position()
    inside = abs(p.x) < width * 0.5 - 0.001 and abs(p.y) < height * 0.5 - 0.001
    above = ground
      |> DeleteGeometry[FACE](selection: valley_height() < level)
      |> MeshToCurve(selection: EdgeNeighbors().face_count == 1 and inside)
    // Each point moves onto the level, along the slope: one step of Newton's method
    g = valley_slope()
    onto = p - g * ((valley_height() - level) / max(g ⋅ g, 0.0001))
    thick = mod(iteration + 1, 5) == 0
    line = above
      |> SetPosition(position: onto)
      |> SetCurveRadius(radius: thick ? radius * 2.0 : radius)
    return (lines: lines + line)
  }
  return r.lines
}

geometry graph ink(strokes: Geometry, color: Color = (0.06, 0.045, 0.035)) -> Geometry {
  "Curves to Grease Pencil strokes, all of one ink"
  return strokes
    |> CurvesToGreasePencil(instances_as_layers: false)
    |> SetGreasePencilColor(color: color)
}

shader(material: true) graph Ink() -> (surface: Shader) {
  "The ink of the meshes: unlit, like a print, and of the colour of the strokes"
  return (surface: Emission(color: (0.06, 0.045, 0.035), strength: 1.0))
}

geometry graph hachures(
    lines: Geometry,
    interval: Float = 0.1 in 0.01..,
    spacing: Float = 0.028 in 0.001..,
    weight: Float = 0.016 in 0.0..,
    steepest: Float = 2.0 in 0.01..,
    flat: Float = 0.45 in 0.0..
) -> Geometry {
  "Lehmann's hachures: from each contour down to the next, along the slope; the steeper, the thicker"
  stroke = lehmann_hachures(gradient_dir: (1.0, 0.0, 0.0), slope: 1.0, length: 1.0, width: weight)
  g = valley_slope()
  steep = length(g)
  // Down to the next contour, interval lower: interval / steep away; a gap is left before it
  reach = min(interval / steep, 0.12) * 0.8
  tip = Position() - g / steep * reach
  return lines
    |> ResampleCurve(mode: "Length", length: spacing)
    |> InstanceOnPoints(
      selection: steep > flat and abs(tip.x) < 1.8 and abs(tip.y) < 1.3,
      instance: stroke,
      rotation: CombineXYZ(z: atan2(-g.y, -g.x)),
      scale: CombineXYZ(x: reach, y: min(steep / steepest, 1.0), z: 1.0))
    |> RealizeInstances()
    |> SetMaterial(material: Ink)
}

geometry graph shade(
    p: Vector = Position(),
    light: Vector = (-1.0, 1.0, 1.2),
    flat: Float = 0.55
) -> Float {
  "How much the ground at p turns away from a light from the north-west: 0 on the flat, 1 in deep shade"
  g = valley_slope(p: p)
  facing = normalize(CombineXYZ(x: -g.x, y: -g.y, z: 1.0)) ⋅ normalize(light)
  return Clamp(value: (flat - facing) * 2.0, min: 0.0, max: 1.0)
}

geometry graph ruling(
    angle: Float = 30.0,
    spacing: Float = 0.03 in 0.001..,
    size: Float = 4.6 in 0.1..
) -> Geometry {
  "Parallel lines across a square of size, spacing apart, at angle: where hatch_cross puts its lines"
  // One line of 460 segments, copied every spacing; hatch_cross inks around its whole steps
  line = MeshLine(
    count: 461,
    start_location: CombineXYZ(y: size * -0.5),
    offset: CombineXYZ(y: size / 460.0))
  count = ceil(size / spacing)
  first = floor(count * -0.5) * spacing
  return MeshLine(
      count: count,
      start_location: CombineXYZ(x: first),
      offset: CombineXYZ(x: spacing))
    |> InstanceOnPoints(instance: line)
    |> RealizeInstances()
    |> TransformGeometry(rotation: CombineXYZ(z: radians(-angle)))
}

geometry graph engrave(
    lines: Geometry,
    amount: Float,
    weight: Float = 0.0045 in 0.0..,
    width: Float = 3.6 in 0.1..,
    height: Float = 2.6 in 0.1..
) -> Geometry {
  "Cuts lines where amount, the ink they hold, is low or off the map; elsewhere amount sets their width"
  p = Position()
  off = amount < 0.05 or abs(p.x) > width * 0.5 or abs(p.y) > height * 0.5
  return lines
    |> DeleteGeometry(selection: off)
    |> MeshToCurve()
    |> SetCurveRadius(radius: amount * weight)
}

geometry graph cross_hatching(spacing: Float = 0.03 in 0.001.., angle: Float = 30.0) -> Geometry {
  "Engraved lines over the slopes in shade, and a second pass across them where the shade is deepest"
  s = shade()
  first = engrave(
    ruling(angle: angle, spacing: spacing),
    amount: hatch_cross(angle: angle, spacing: spacing, cross_angle: 0.0, shade: s)
      * Clamp(value: s * 2.0))
  across = angle + 90.0
  second = engrave(
    ruling(angle: across, spacing: spacing),
    amount: hatch_cross(angle: across, spacing: spacing, cross_angle: 0.0, shade: s * 2.0 - 1.0)
      * Clamp(value: s * 4.0 - 2.0))
  return first + second
}

geometry graph engraved_map() -> Geometry {
  "An engraved relief map of a small valley"
  lines = contours()
  return ink(lines + cross_hatching()) + hachures(lines)
}
