// @module engraved_map_step5
// @title Engraved map, step 5: a river and a path, along their curves
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example engraved_map

use curves2d (wave_curve_2d)
use deform2d (arrow_head, flow_along_curve, ribbon_outline)
use hachures2d (guilloche, hatch_cross, lehmann_hachures)
use sdf2d (sdf_segment_2d)

geometry graph summit(p: Vector, centre: Vector, height: Float, width: Float) -> Float {
  "A round hill: height at its centre, falling off over about width"
  d = distance(p, centre) / width
  return height * exp(-d * d)
}

geometry graph river_course(x: Float) -> Float {
  "Where the river runs: its y at x, a slow bend from west to east"
  return 0.3 * sin(x * 1.3 + 0.6) - 0.12 * x
}

geometry graph valley_height(p: Vector = Position()) -> Float {
  "Height of the ground at p: a gorge between two shoulders, two summits, a side stream, some noise"
  // d: how far north of the river; the gorge is steep, the shoulders above it gentle
  d = p.y - river_course(x: p.x)
  gorge = 0.6 * (1.0 - exp(-d * d * 8.0)) + 0.2 * max(abs(d) - 0.4, 0.0)
  north = summit(p: p, centre: (-0.75, 0.85, 0.0), height: 0.85, width: 0.45)
  south = summit(p: p, centre: (1.0, -0.8, 0.0), height: 0.65, width: 0.4)
  stream = sdf_segment_2d(p: p, a: (1.0, 1.4, 0.0), b: (0.35, 0.15, 0.0), thickness: 0.0)
  side = 0.3 * exp(-stream * stream * 30.0)
  // Rough ground, but not on the floor of the gorge: the river keeps it smooth
  noise = NoiseTexture(vector: p, scale: 1.4, detail: 3.0).factor - 0.5
  rough = noise * 0.3 * Clamp(value: abs(d) * 4.0)
  return gorge + north + south - side + rough
}

geometry graph valley_slope(p: Vector = Position()) -> Vector {
  "The gradient of valley_height: it points uphill, and its length is the slope"
  e = 0.005
  h = valley_height(p: p)
  dx = valley_height(p: p + CombineXYZ(x: e)) - h
  dy = valley_height(p: p + CombineXYZ(y: e)) - h
  return CombineXYZ(x: dx / e, y: dy / e, z: 0.0)
}

geometry graph contours(
    width: Float = 3.6 in 0.1..,
    height: Float = 2.6 in 0.1..,
    interval: Float = 0.1 in 0.01..,
    levels: Int = 16 in 1..64,
    radius: Float = 0.004 in 0.0..
) -> Geometry {
  "One curve per level of valley_height, every interval; every fifth one twice as thick"
  ground = Grid(size_x: width, size_y: height, vertices_x: 361, vertices_y: 261).mesh
  r = repeat(levels, lines: JoinGeometry()) -> {
    level = interval * (iteration + 1)
    // The faces above the level; their edge, but not the edge of the map, is the contour
    p = Position()
    inside = abs(p.x) < width * 0.5 - 0.001 and abs(p.y) < height * 0.5 - 0.001
    above = ground
      |> DeleteGeometry[FACE](selection: valley_height() < level)
      |> MeshToCurve(selection: EdgeNeighbors().face_count == 1 and inside)
    // Each point moves onto the level, along the slope: one step of Newton's method
    g = valley_slope()
    onto = p - g * ((valley_height() - level) / max(g ⋅ g, 0.0001))
    thick = mod(iteration + 1, 5) == 0
    line = above
      |> SetPosition(position: onto)
      |> SetCurveRadius(radius: thick ? radius * 2.0 : radius)
    return (lines: lines + line)
  }
  return r.lines
}

geometry graph ink(strokes: Geometry, color: Color = (0.06, 0.045, 0.035)) -> Geometry {
  "Curves to Grease Pencil strokes, all of one ink"
  return strokes
    |> CurvesToGreasePencil(instances_as_layers: false)
    |> SetGreasePencilColor(color: color)
}

shader(material: true) graph Ink() -> (surface: Shader) {
  "The ink of the meshes: unlit, like a print, and of the colour of the strokes"
  return (surface: Emission(color: (0.06, 0.045, 0.035), strength: 1.0))
}

geometry graph hachures(
    lines: Geometry,
    interval: Float = 0.1 in 0.01..,
    spacing: Float = 0.028 in 0.001..,
    weight: Float = 0.016 in 0.0..,
    steepest: Float = 2.0 in 0.01..,
    flat: Float = 0.45 in 0.0..
) -> Geometry {
  "Lehmann's hachures: from each contour down to the next, along the slope; the steeper, the thicker"
  stroke = lehmann_hachures(gradient_dir: (1.0, 0.0, 0.0), slope: 1.0, length: 1.0, width: weight)
  g = valley_slope()
  steep = length(g)
  // Down to the next contour, interval lower: interval / steep away; a gap is left before it
  reach = min(interval / steep, 0.12) * 0.8
  tip = Position() - g / steep * reach
  return lines
    |> ResampleCurve(mode: "Length", length: spacing)
    |> InstanceOnPoints(
      selection: steep > flat and abs(tip.x) < 1.8 and abs(tip.y) < 1.3,
      instance: stroke,
      rotation: CombineXYZ(z: atan2(-g.y, -g.x)),
      scale: CombineXYZ(x: reach, y: min(steep / steepest, 1.0), z: 1.0))
    |> RealizeInstances()
    |> SetMaterial(material: Ink)
}

geometry graph shade(
    p: Vector = Position(),
    light: Vector = (-1.0, 1.0, 1.2),
    flat: Float = 0.55
) -> Float {
  "How much the ground at p turns away from a light from the north-west: 0 on the flat, 1 in deep shade"
  g = valley_slope(p: p)
  facing = normalize(CombineXYZ(x: -g.x, y: -g.y, z: 1.0)) ⋅ normalize(light)
  return Clamp(value: (flat - facing) * 2.0, min: 0.0, max: 1.0)
}

geometry graph ruling(
    angle: Float = 30.0,
    spacing: Float = 0.03 in 0.001..,
    size: Float = 4.6 in 0.1..
) -> Geometry {
  "Parallel lines across a square of size, spacing apart, at angle: where hatch_cross puts its lines"
  // One line of 460 segments, copied every spacing; hatch_cross inks around its whole steps
  line = MeshLine(
    count: 461,
    start_location: CombineXYZ(y: size * -0.5),
    offset: CombineXYZ(y: size / 460.0))
  count = ceil(size / spacing)
  first = floor(count * -0.5) * spacing
  return MeshLine(
      count: count,
      start_location: CombineXYZ(x: first),
      offset: CombineXYZ(x: spacing))
    |> InstanceOnPoints(instance: line)
    |> RealizeInstances()
    |> TransformGeometry(rotation: CombineXYZ(z: radians(-angle)))
}

geometry graph engrave(
    lines: Geometry,
    amount: Float,
    weight: Float = 0.0045 in 0.0..,
    width: Float = 3.6 in 0.1..,
    height: Float = 2.6 in 0.1..
) -> Geometry {
  "Cuts lines where amount, the ink they hold, is low or off the map; elsewhere amount sets their width"
  p = Position()
  off = amount < 0.05 or abs(p.x) > width * 0.5 or abs(p.y) > height * 0.5
  return lines
    |> DeleteGeometry(selection: off)
    |> MeshToCurve()
    |> SetCurveRadius(radius: amount * weight)
}

geometry graph cross_hatching(spacing: Float = 0.03 in 0.001.., angle: Float = 30.0) -> Geometry {
  "Engraved lines over the slopes in shade, and a second pass across them where the shade is deepest"
  s = shade()
  first = engrave(
    ruling(angle: angle, spacing: spacing),
    amount: hatch_cross(angle: angle, spacing: spacing, cross_angle: 0.0, shade: s)
      * Clamp(value: s * 2.0))
  across = angle + 90.0
  second = engrave(
    ruling(angle: across, spacing: spacing),
    amount: hatch_cross(angle: across, spacing: spacing, cross_angle: 0.0, shade: s * 2.0 - 1.0)
      * Clamp(value: s * 4.0 - 2.0))
  return first + second
}

geometry graph frame(
    width: Float = 3.6 in 0.1..,
    height: Float = 2.6 in 0.1..,
    band: Float = 0.1 in 0.0..,
    waves: Float = 150.0 in 1.0..,
    radius: Float = 0.003 in 0.0..
) -> Geometry {
  "The neat line around the map, a guilloché band, and a thick outer line"
  inner = Quadrilateral(width: width, height: height).curve
  outer = Quadrilateral(width: width + band * 2.0, height: height + band * 2.0).curve
  // Three waves along the middle of the band, a third of a wave apart, braid into a guilloché
  middle = Quadrilateral(width: width + band, height: height + band).curve
    |> FilletCurve(radius: band * 0.5, mode: "Poly", count: 8)
  braid = wave_curve_2d(middle, amplitude: band * 0.3, periods: waves, resolution: 2048)
    + wave_curve_2d(middle, amplitude: band * 0.3, periods: waves, phase: 0.333, resolution: 2048)
    + wave_curve_2d(middle, amplitude: band * 0.3, periods: waves, phase: 0.667, resolution: 2048)
  return SetCurveRadius(inner + braid, radius: radius) + SetCurveRadius(outer, radius: radius * 2.5)
}

geometry graph rosette(
    centre: Vector,
    size: Float = 0.2 in 0.0..,
    waves: Float = 16.0 in 1.0..
) -> Geometry {
  "A guilloché rosette: four of the curves guilloche traces, one inside the other"
  r = repeat(4, curves: JoinGeometry()) -> {
    t = SplineParameter().factor
    k = iteration / 3.0
    // r2 at 0 keeps the loops round; r1 and p change from one curve to the next
    shape = guilloche(t: t, r1: 0.95 - k * 0.45, r2: 0.0, p: 0.12 + k * 0.06, waves: waves)
    ring = CurveCircle(resolution: 900).curve
      |> SetPosition(position: centre + shape * size)
    return (curves: curves + ring)
  }
  return r.curves
}

geometry graph cartouche(
    centre: Vector = (-1.12, -0.95, 0.0),
    width: Float = 1.2 in 0.1..,
    height: Float = 0.52 in 0.1..,
    title: String = "THE LITTLE VALLEY",
    radius: Float = 0.003 in 0.0..
) -> Geometry {
  "A framed label in a corner of the map: a rosette and the title"
  box = Quadrilateral(width: width, height: height).curve
    |> FilletCurve(radius: 0.05, mode: "Poly", count: 6)
    |> TransformGeometry(translation: centre)
  inner = Quadrilateral(width: width - 0.05, height: height - 0.05).curve
    |> FilletCurve(radius: 0.03, mode: "Poly", count: 6)
    |> TransformGeometry(translation: centre)
  rose = rosette(centre: centre + CombineXYZ(x: width * -0.31), size: height * 0.34)
  words = StringToCurves(
      string: title,
      size: 0.07,
      align_x: "Center",
      align_y: "Middle").curve_instances
    |> RealizeInstances()
    |> FillCurve()
    |> TransformGeometry(translation: centre + CombineXYZ(x: width * 0.15, y: 0.04))
    |> SetMaterial(material: Ink)
  subtitle = StringToCurves(
      string: "engraved relief",
      size: 0.05,
      align_x: "Center",
      align_y: "Middle").curve_instances
    |> RealizeInstances()
    |> FillCurve()
    |> TransformGeometry(translation: centre + CombineXYZ(x: width * 0.15, y: -0.07))
    |> SetMaterial(material: Ink)
  lines = SetCurveRadius(box + inner, radius: radius) + SetCurveRadius(rose, radius: radius * 0.6)
  return ink(lines) + words + subtitle
}

geometry graph clear(strokes: Geometry, under: Bool) -> Geometry {
  "Strokes and meshes cut away where under is true: where something else is drawn"
  // A curve whose middle points are deleted would join its ends: as edges of a mesh, it splits.
  // The mesh has no radius: it keeps it as an attribute of its own
  parts = SeparateComponents(strokes)
  curves = parts.curve
    |> StoreNamedAttribute(name: "width", value: Radius())
    |> CurveToMesh()
    |> DeleteGeometry(selection: under)
    |> MeshToCurve()
    |> SetCurveRadius(radius: NamedAttribute[FLOAT](name: "width"))
  return curves + DeleteGeometry[FACE](parts.mesh, selection: under)
}

geometry graph river(width: Float = 0.045 in 0.0.., spring: Float = 0.6 in 0.0..1.0) -> Geometry {
  "The river on the valley floor: a ribbon that widens from its spring, in the west, as it flows east"
  p = Position()
  spine = CurveLine(start: (-1.8, 0.0, 0.0), end: (1.8, 0.0, 0.0))
    |> ResampleCurve(count: 200)
    |> SetPosition(position: CombineXYZ(x: p.x, y: river_course(x: p.x)))
  return ribbon_outline(spine, width: width, taper_start: spring, resolution: 400)
    |> SetMaterial(material: Ink)
}

geometry graph path_line() -> Geometry {
  "The course of a path: from the river, south, up to the summit"
  return BezierSegment(
    resolution: 64,
    start: (-0.05, 0.12, 0.0),
    start_handle: (0.0, -0.55, 0.0),
    end_handle: (0.3, -0.95, 0.0),
    end: (0.82, -0.76, 0.0))
}

geometry graph path(spine: Geometry, gap: Float = 0.035 in 0.001..) -> Geometry {
  "A dashed path along spine: a row of dashes, drawn straight, then bent along it"
  dash = ResampleCurve(CurveLine(start: (0.0, 0.0, 0.0), end: CombineXYZ(x: gap * 0.6)), count: 4)
  dashes = MeshLine(count: 50, offset: CombineXYZ(x: gap))
    |> InstanceOnPoints(instance: dash)
    |> RealizeInstances()
  return flow_along_curve(dashes, spine: spine, resolution: 1024)
}

geometry graph engraved_map() -> Geometry {
  "An engraved relief map of a small valley"
  lines = contours()
  label = (-1.12, -0.95, 0.0)
  way = path_line()
  // The relief stops a little before the cartouche's box, at the banks, and on each side of the path
  p = Position()
  box = abs(p.x - label.x) < 0.63 and abs(p.y - label.y) < 0.29
  banks = abs(p.y - river_course(x: p.x)) < 0.05
  gap = GeometryProximity[EDGES](CurveToMesh(way), sample_position: p).distance
  near = gap < 0.045
  under = box or banks or near
  strokes = clear(lines + cross_hatching(), under: under)
  // arrow_head with fill: false is an outline, a curve: ink makes it a stroke like the path
  route = path(way) + arrow_head(way, size: 0.07, angle: 28.0, fill: false)
  meshes = clear(hachures(lines), under: under) + river()
  return ink(strokes + frame() + SetCurveRadius(route, radius: 0.004))
    + meshes
    + cartouche(centre: label)
}
