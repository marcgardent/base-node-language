// @module rover_hull_step2
// @title Rover hull, step 2: a texture without UVs
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example rover_hull

use material_layers
use projections

shader graph hull_paint(paint: Color = (0.55, 0.12, 0.012)) -> Shader {
  "Painted metal, its tone and its gloss smeared by a texture projected along three axes"
  surface = projection_frame(space: Object).normal
  "Paint" #orange {
    // A 2D texture, as an image would be: it reads x and y of the coordinates it is given
    smears = closure(vector: Vector) -> (color: Color) {
      return (color: NoiseTexture(vector: vector * (1.0, 2.5, 0.0), scale: 3.0, detail: 8.0).color)
    }
    tone = triplanar(texture: smears, sharpness: 8.0).color.x
    painted = layer(
      base_color: paint * (tone * 0.4 + 0.8),
      roughness: tone * 0.4 + 0.2,
      normal: surface,
      coat: 0.25)
  }
  return layer_bsdf(layer: painted, normal_space: Object).bsdf
}

shader(material: true) graph HullPaint() -> (surface: Shader) {
  "The hull's material: hull_paint, whose inputs on its node in the material tune it"
  return (surface: hull_paint())
}

geometry graph rover_hull() -> Geometry {
  "A rover's hull, without UVs: a body with a sloped nose, fenders, a deck, a mast and its head"
  // 1.8 m long, 1.1 m wide; the top of its front slides back 35 cm, a sloped nose
  p = Position()
  body = Cube(size: (1.8, 1.1, 0.4)).mesh
    |> SetPosition(selection: p.x > 0.0 and p.z > 0.0, offset: (-0.35, 0.0, 0.0))
    |> TransformGeometry(translation: (0.0, 0.0, 0.55))
  fender = Cube(size: (1.9, 0.24, 0.04)).mesh
  fenders = TransformGeometry(fender, translation: (0.0, 0.66, 0.6))
    + TransformGeometry(fender, translation: (0.0, -0.66, 0.6))
  deck = Cube(size: (0.75, 0.85, 0.2)).mesh
    |> TransformGeometry(translation: (-0.4, 0.0, 0.85))
  pole = Cylinder(vertices: 24, radius: 0.035, depth: 0.55)
  mast = pole.mesh
    |> SetShadeSmooth(selection: pole.side)
    |> TransformGeometry(translation: (0.2, 0.32, 1.02))
  head = Cube(size: (0.16, 0.36, 0.14)).mesh
    |> TransformGeometry(translation: (0.2, 0.32, 1.36))
  return body + fenders + deck + mast + head
    |> SetMaterial(material: HullPaint)
}
