// Hydraulic erosion of a grid terrain, after the virtual pipe model of Mei, Decaudin & Hu,
// "Fast Hydraulic Erosion Simulation and Visualization on GPU" (Pacific Graphics 2007),
// with eight pipes per cell: the four sides and the four diagonals.
// The sediment travels with the water through the same pipes, so that none is lost.
// The outflows are kept in two colors: "flux" to the left, right, down and up neighbours
// (r, g, b, a), "diagonal flux" to the down-left, up-right, down-right and up-left ones.

// The value of a field v at the neighbour (di, dj) of each vertex of an n x n Grid
geometry graph neighbour(grid: Geometry, v: Float, di: Int, dj: Int, n: Int, edge: Float) -> Float {
  i = floor(Index() / n) + di
  j = mod(Index(), n) + dj
  inside = i >= 0 and i < n and j >= 0 and j < n
  return inside ? SampleIndex(grid, v, i * n + j) : edge
}

// What the eight pipes of each cell bring in and take out, each times `scale` where it starts,
// and the flow they make along x and y
geometry graph pipes(
    grid: Geometry,
    n: Int,
    scale: Float
) -> (in_: Float, out: Float, x: Float, y: Float) {
  a = SeparateColor(NamedAttribute(name: "flux", data_type: FLOAT_COLOR).attribute)
  d = SeparateColor(NamedAttribute(name: "diagonal flux", data_type: FLOAT_COLOR).attribute)
  w = neighbour(grid, a.green * scale, -1, 0, n, 0.0)
  e = neighbour(grid, a.red * scale, 1, 0, n, 0.0)
  s = neighbour(grid, a.alpha * scale, 0, -1, n, 0.0)
  north = neighbour(grid, a.blue * scale, 0, 1, n, 0.0)
  sw = neighbour(grid, d.green * scale, -1, -1, n, 0.0)
  ne = neighbour(grid, d.red * scale, 1, 1, n, 0.0)
  se = neighbour(grid, d.alpha * scale, 1, -1, n, 0.0)
  nw = neighbour(grid, d.blue * scale, -1, 1, n, 0.0)
  // Along x and y: what comes in from one side and goes out to the other
  ox = (a.green - a.red + d.green + d.blue - d.red - d.alpha) * scale
  oy = (a.alpha - a.blue + d.green + d.alpha - d.red - d.blue) * scale
  return (
    in_: w + e + s + north + sw + ne + se + nw,
    out: (a.red + a.green + a.blue + a.alpha + d.red + d.green + d.blue + d.alpha) * scale,
    x: w + sw + nw - e - ne - se + ox,
    y: s + sw + se - north - ne - nw + oy)
}

// What a column gets from its neighbour (di, dj), or gives it, past the steepest slope it holds
geometry graph slide(grid: Geometry, di: Int, dj: Int, n: Int, talus: Float) -> Float {
  z = Position().z
  other = neighbour(grid, z, di, dj, n, z)
  drop = talus * length(CombineXYZ(di, dj))
  return max(other - z - drop, 0.0) - max(z - other - drop, 0.0)
}

geometry graph erode(
    terrain: Geometry,
    iterations: Int = 50 in 0..,
    rain: Float = 0.01 in 0.0..,
    evaporation: Float = 0.5 in 0.0..,
    capacity: Float = 10.0 in 0.0..,
    erosion: Float = 0.02 in 0.0..1.0,
    deposition: Float = 0.02 in 0.0..1.0,
    courant: Float = 0.25 in 0.0..0.6,
    "Thermal" {
        slope: Float = 1.0 in 0.0..,
        thermal: Float = 0.05 in 0.0..0.1
    }
) -> Geometry {
  "Erodes a square Grid: rain, flow through pipes, sediment"
  n = floor(sqrt(DomainSize(terrain).point_count) + 0.5)
  box = BoundingBox(terrain)
  l = (box.max.x - box.min.x) / (n - 1)
  // The pipes carry gravity waves: past a time step of 0.64 * sqrt(l / g) with eight pipes,
  // the shortest ones (two cells long) grow at each step into stripes along the grid
  dt = courant * sqrt(l / 9.81)
  out = repeat(iterations, ground: terrain) -> {
    water = NamedAttribute(name: "water").attribute
    sediment = NamedAttribute(name: "sediment").attribute
    a = SeparateColor(NamedAttribute(name: "flux", data_type: FLOAT_COLOR).attribute)
    d = SeparateColor(NamedAttribute(name: "diagonal flux", data_type: FLOAT_COLOR).attribute)

    wet = StoreNamedAttribute(ground, name: "water", value: water + rain * dt)

    "Flow" #teal {
      // Each pipe speeds up with the drop of the water surface to its neighbour, and with
      // its cross-section l * l over its length: l, or l * sqrt(2) for a diagonal
      surface = Position().z + water
      side = dt * 9.81 * l
      diagonal = side / sqrt(2.0)
      fl = max(a.red + side * (surface - neighbour(wet, surface, -1, 0, n, surface)), 0.0)
      fr = max(a.green + side * (surface - neighbour(wet, surface, 1, 0, n, surface)), 0.0)
      fd = max(a.blue + side * (surface - neighbour(wet, surface, 0, -1, n, surface)), 0.0)
      fu = max(a.alpha + side * (surface - neighbour(wet, surface, 0, 1, n, surface)), 0.0)
      fdl = max(d.red + diagonal * (surface - neighbour(wet, surface, -1, -1, n, surface)), 0.0)
      fur = max(d.green + diagonal * (surface - neighbour(wet, surface, 1, 1, n, surface)), 0.0)
      fdr = max(d.blue + diagonal * (surface - neighbour(wet, surface, 1, -1, n, surface)), 0.0)
      ful = max(d.alpha + diagonal * (surface - neighbour(wet, surface, -1, 1, n, surface)), 0.0)
      // No cell gives more water than it holds
      k = min(water * l * l / ((fl + fr + fd + fu + fdl + fur + fdr + ful) * dt + 1e-06), 1.0)
      c = CaptureAttribute(
        wet,
        sides: CombineColor(fl * k, fr * k, fd * k, fu * k),
        diagonals: CombineColor(fdl * k, fur * k, fdr * k, ful * k))
      flowing = c.geometry
        |> StoreNamedAttribute(name: "flux", value: c.sides, data_type: FLOAT_COLOR)
        |> StoreNamedAttribute(name: "diagonal flux", value: c.diagonals, data_type: FLOAT_COLOR)
    }

    "Water, sediment and velocity" #3a7bd5 {
      flow = pipes(flowing, n, 1.0)
      depth = max(water + dt * (flow.in_ - flow.out) / (l * l), 0.0)
      // Each pipe takes the share of the sediment that it takes of the water
      carried = pipes(flowing, n, sediment * dt / max(water * l * l, 1e-09))
      // The water passing through the cell, over its mean depth
      mean = max((water + depth) * 0.5, 0.001)
      moving = flowing
        |> StoreNamedAttribute(name: "sediment", value: sediment + carried.in_ - carried.out)
        |> StoreNamedAttribute(
          name: "speed",
          value: length(CombineXYZ(flow.x, flow.y)) * 0.5 / (l * mean))
        |> StoreNamedAttribute(name: "water", value: depth)
    }

    "Erosion and deposition" #peru {
      // What the water can carry grows with its depth, its speed and the slope under it
      tilt = max(sqrt(1.0 - Normal().z * Normal().z), 0.05)
      carry = capacity * tilt * NamedAttribute(name: "speed").attribute * water
      taken = (carry > sediment ? erosion : deposition) * (carry - sediment)
      e = CaptureAttribute(moving, taken: taken)
      settled = e.geometry
        |> SetPosition(offset: CombineXYZ(z: -e.taken))
        |> StoreNamedAttribute(name: "sediment", value: sediment + e.taken)
        |> StoreNamedAttribute(name: "water", value: water * (1.0 - evaporation * dt))
    }

    "Thermal erosion" #slategray {
      // Slopes steeper than `slope` slide down to their lower neighbours
      t = slope * l
      fall = slide(settled, -1, 0, n, t)
        + slide(settled, 1, 0, n, t)
        + slide(settled, 0, -1, n, t)
        + slide(settled, 0, 1, n, t)
        + slide(settled, -1, -1, n, t)
        + slide(settled, 1, 1, n, t)
        + slide(settled, 1, -1, n, t)
        + slide(settled, -1, 1, n, t)
      slid = SetPosition(settled, offset: CombineXYZ(z: fall * thermal))
    }
    return (ground: slid)
  }
  return out.ground
}

geometry graph "eroded hills"(
    size: Float = 4.0 in 0.1..,
    resolution: Int = 128 in 2..,
    height: Float = 1.2 in 0.0..,
    iterations: Int = 50 in 0..
) -> Geometry {
  "A noise terrain on a Grid, eroded"
  hills = NoiseTexture(vector: Position(), scale: 0.6, detail: 6.0, roughness: 0.55).factor
  return Grid(size, size, resolution, resolution)
    |> SetPosition(offset: CombineXYZ(z: (hills - 0.5) * height * 2.0))
    |> erode(iterations: iterations)
    |> SetShadeSmooth()
}
