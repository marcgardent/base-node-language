use mask2d

compositor graph "mask2d showcase"(image: Color) -> Color {
  "The shapes of mask2d over a gradient, framed by a letterbox"
  sky = Mix(
    factor: ImageCoordinates(image).normalized.y,
    a: (0.05, 0.08, 0.2, 1.0),
    b: (0.6, 0.35, 0.5, 1.0),
    data_type: RGBA)
  disk = circle_mask(image, 0.22, 0.25, (-0.62, 0.0)).mask
  box = box_mask(image, (0.2, 0.14), 0.05, center: (-0.1, 0.05), angle: 0.35)
  hexagon = polygon_mask(image, 0.2, 6, center: (0.3, -0.05)).mask
  star = star_mask(image, 0.22, 5, 0.45, center: (0.72, 0.05), angle: 0.3).mask
  a = Mix(factor: disk, a: sky, b: (1.0, 0.75, 0.3, 1.0), data_type: RGBA)
  b = Mix(factor: box.mask, a: a, b: (0.2, 0.7, 0.9, 1.0), data_type: RGBA)
  c = Mix(factor: outline_mask(image, box.distance - 0.05, 0.015), a: b, b: (1.0, 1.0, 1.0, 1.0), data_type: RGBA)
  d = Mix(factor: hexagon, a: c, b: (0.4, 0.9, 0.5, 1.0), data_type: RGBA)
  e = Mix(factor: star, a: d, b: (1.0, 0.9, 0.2, 1.0), data_type: RGBA)
  return letterbox(e, 2.39).image
}
