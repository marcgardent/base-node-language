use mask2d (circle_mask, box_mask)
use merge

// A, an orange disk, merged with B, a blue square, by twelve operations of merge, over a checker
// that shows their alpha. Row by row: over, under, in, out / atop, exclusive or, stencil, mask /
// plus, screen, multiply, difference. Rendered by examples/render_compositor_showcases.py.

compositor graph "shape a"(image: Color, center: Vector) -> Color {
  "A: an orange disk of alpha 0.8, premultiplied, left of the tile's center"
  m = circle_mask(image, 0.085, center: center + (-0.035, 0.01)).mask * 0.8
  return with_alpha((1.0, 0.22, 0.02) * m, m)
}

compositor graph "shape b"(image: Color, center: Vector) -> Color {
  "B: a blue square of alpha 0.9, premultiplied, right of the tile's center"
  m = box_mask(image, (0.07, 0.07), 0.015, center: center + (0.04, -0.015)).mask * 0.9
  return with_alpha((0.02, 0.18, 1.0) * m, m)
}

compositor graph "merge showcase"(image: Color) -> Color {
  "Twelve operations of merge, A by B, in a grid of 4 by 3"
  c1 = (-0.75, 0.39)
  c2 = (-0.25, 0.39)
  c3 = (0.25, 0.39)
  c4 = (0.75, 0.39)
  c5 = (-0.75, 0.015)
  c6 = (-0.25, 0.015)
  c7 = (0.25, 0.015)
  c8 = (0.75, 0.015)
  c9 = (-0.75, -0.36)
  c10 = (-0.25, -0.36)
  c11 = (0.25, -0.36)
  c12 = (0.75, -0.36)
  t1 = over(shape_a(image, c1), shape_b(image, c1))
  t2 = under(shape_a(image, c2), shape_b(image, c2))
  t3 = in(shape_a(image, c3), shape_b(image, c3))
  t4 = out(shape_a(image, c4), shape_b(image, c4))
  t5 = atop(shape_a(image, c5), shape_b(image, c5))
  t6 = exclusive_or(shape_a(image, c6), shape_b(image, c6))
  t7 = stencil(shape_a(image, c7), shape_b(image, c7))
  t8 = mask(shape_a(image, c8), shape_b(image, c8))
  t9 = plus(shape_a(image, c9), shape_b(image, c9))
  t10 = screen(shape_a(image, c10), shape_b(image, c10))
  t11 = multiply(shape_a(image, c11), shape_b(image, c11))
  t12 = difference(shape_a(image, c12), shape_b(image, c12))
  tiles = plus(
    plus(plus(plus(t1, t2), plus(t3, t4)), plus(plus(t5, t6), plus(t7, t8))),
    plus(plus(t9, t10), plus(t11, t12)))
  checker = CheckerTexture(
    vector: ImageCoordinates(image).uniform,
    color1: (0.16, 0.16, 0.17, 1.0),
    color2: (0.11, 0.11, 0.12, 1.0),
    scale: 24.0).color
  return over(tiles, checker)
}
