geometry graph mask(
    geometry: Geometry,
    t: Float,
    limit: Int,
    center: Vector,
    label: String
) -> Geometry {
  p = Position()
  high = p.z > t
  near = distance(p, center) <= 0.5
  return geometry
    |> SetPosition(selection: high != near, offset: CombineXYZ(z: t))
    |> SetPosition(selection: Index() == limit, position: center)
    |> SetPosition(selection: label == "top", offset: (0.0, 0.0, 1.0))
    |> SetPosition(selection: p == center)
    |> SetPosition(selection: high and not near or (high xor label == "top"))
    |> SetPosition(selection: Compare[EQUAL](a: t, b: 1.0, epsilon: 0.1))
    |> SetPosition(selection: Compare[LESS_THAN, VECTOR, LENGTH](a: p, b: center))
}
