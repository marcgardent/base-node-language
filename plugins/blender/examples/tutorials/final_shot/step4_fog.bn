// @module final_shot_step4
// @title The final shot, step 4: a haze from the depth
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @target blender
// @offer groups

use merge (keymix)
use passes

compositor graph final_shot() -> Color {
  "The render rebuilt from its passes, the sphere painted blue, a warm light added, a haze from the Depth pass"
  l = RenderLayers()
  // The sphere, found in the world by the Position pass; its colour changed, its light kept
  sphere = p_matte(position: l.position, center: (-1.2, 2.2, 0.9), radius: 0.9, falloff: 0.05).matte
  paint = keymix(a: (0.04, 0.16, 0.45, 1.0), b: l.diffuse_color, mask: sphere)
  beauty = rebuild_beauty(
    diffuse_direct: l.diffuse_direct,
    diffuse_indirect: l.diffuse_indirect,
    diffuse_color: paint,
    glossy_direct: l.glossy_direct,
    glossy_indirect: l.glossy_indirect,
    glossy_color: l.glossy_color,
    transmission_direct: l.transmission_direct,
    transmission_indirect: l.transmission_indirect,
    transmission_color: l.transmission_color,
    emission: l.emission,
    environment: l.environment,
    alpha: l.alpha)
  // A point light at the bulb of the lamp post, on the colours of the diffuse surfaces
  lit = beauty
    |> relight(
      albedo: paint,
      normal: l.normal,
      position: l.position,
      light_position: (1.7, 1.2, 3.05),
      light_color: (1.0, 0.6, 0.3, 1.0),
      intensity: 12.0)
  // A haze, thicker with the distance; the sky has no depth, and a matte of the first
  // kilometre keeps the haze off it
  solid = depth_slice(depth: l.depth, near: 0.0, far: 1000.0, softness: 1.0).matte
  hazy = lit
    |> depth_fog(
      depth: l.depth,
      color: (0.09, 0.06, 0.06, 1.0),
      near: 5.0,
      far: 1000.0,
      density: 0.005)
  return keymix(hazy, b: lit, mask: solid)
}
