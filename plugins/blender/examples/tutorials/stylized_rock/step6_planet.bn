// @module stylized_rock_step6
// @title Stylized rock, step 6: a mini planet of rocks, a seed each
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example rock_planet

use generators
use math (fibonacci_point, random_direction)
use mesh_effects
use mesh_maps

shader graph rock_stone(
    stone: Color = (0.26, 0.26, 0.27),
    light: Color = (0.6, 0.6, 0.62),
    dark: Color = (0.12, 0.12, 0.13)
) -> Shader {
  "Grey stone, paler on its edges and its chips, darker in its hollows, its cracks and its pits"
  m = curvature_mask(balance: 0.5, contrast: 0.4)
  e = mesh_effects_read()
  "Edges" #orange {
    lit = Mix[RGBA](factor: max(m.mask, e.chip * 0.5), a: stone, b: light)
  }
  "Hollows" #violet {
    color = Mix[RGBA](
      factor: max(
        max(m.cavities, Attribute[attribute_name: "rock_crack"]().factor * 0.6),
        e.dent * 0.3),
      a: lit,
      b: dark)
  }
  return PrincipledBSDF(base_color: color, roughness: 0.35)
}

shader(material: true) graph RockStone() -> (surface: Shader) {
  "The rock's material: rock_stone, whose inputs on its node in the material tune it"
  return (surface: rock_stone())
}

geometry graph rock_block(
    facets: Int = 50 in 4..,
    jitter: Float = 0.8 in 0.0..1.0,
    size: Vector = (0.8, 0.7, 1.0),
    taper: Float = 0.25 in 0.0..0.8,
    seed: Int
) -> Geometry {
  "A convex block of flat facets, size wide, narrower toward its top by taper: an egg cut by facets planes, each where it touches the unit sphere"
  "Planes" #blue {
    // A point of the unit sphere a facet: spread evenly, then pushed about by the seed
    around = Points(
      count: facets,
      position: normalize(fibonacci_point(count: facets) + random_direction(seed: seed) * jitter))
    hull = ConvexHull(around)
  }
  "Corners" #teal {
    // Three planes meet at a corner of the block: the three points of a face of the hull. The
    // corner lies along that face's normal, at 1 over the distance of the face from the centre
    n = Normal().normal
    corners = StoreNamedAttribute[FLOAT_VECTOR, FACE](
      hull,
      name: "corner",
      value: n / (n ⋅ Position()))
    // The dual mesh has a point a face of the hull, and a face a point: the facets
    block = DualMesh(corners)
      |> SetPosition(position: NamedAttribute[FLOAT_VECTOR](name: "corner").attribute)
      |> RemoveNamedAttribute(name: "corner")
  }
  // Seen in perspective from above, the block is an egg and its facets are still flat: dividing
  // by a distance along an axis keeps a plane a plane
  return block
    |> SetPosition(
      // Brought back to its height and its middle, which the division moved
      position: Position() / (1.0 + Position().z * taper) * (1.0 - taper * taper)
        + CombineXYZ(z: taper))
    |> TransformGeometry(scale: size * 0.5)
}

geometry graph clay(
    mesh: Geometry,
    voxel: Float(subtype: DISTANCE) = 0.006 in 0.001..,
    soften: Int = 5 in 0..
) -> Geometry {
  "The mesh made again of even faces voxel wide, as a sculptor remeshes clay, its edges softened by soften passes of smoothing"
  dense = GridToMesh(grid: MeshToSDFGrid(mesh, voxel_size: voxel), threshold: 0.0)
  return dense
    |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: soften))
    |> SetShadeSmooth()
}

geometry graph cracks(
    mesh: Geometry,
    spacing: Float(subtype: DISTANCE) = 0.8 in 0.001..,
    width: Float(subtype: DISTANCE) = 0.05 in 0.0..,
    depth: Float(subtype: DISTANCE) = 0.025 in 0.0..,
    amount: Float = 0.5 in 0.0..1.0,
    bend: Float(subtype: DISTANCE) = 0.3 in 0.0..,
    seed: Int
) -> Geometry {
  "Cracks cut width wide and depth deep where the walls of Voronoi cells spacing apart cross the mesh, bent, open over amount of their length, a lip raised beside them; stored as rock_crack, 0 to 1"
  p = Position()
  "Lines" #blue {
    // The walls between Voronoi cells are planes: bending the space they are read in bends them
    wobble = NoiseTexture["4D"](vector: p, w: seed, scale: 1.2, detail: 0.0).color
    q = (p + (wobble - (0.5, 0.5, 0.5)) * bend) / spacing + (5.3, 1.7, 9.1) * seed
    wall = VoronoiTexture[DISTANCE_TO_EDGE](vector: q, scale: 1.0).distance * spacing
  }
  "Open" #green {
    // A crack is open in patches of a slow noise, and closes at their border
    patches = NoiseTexture["4D"](vector: p, w: seed + 7.0, scale: 1.0, detail: 0.0).factor
    open = MapRange[SMOOTHSTEP](value: patches, from_min: 0.9 - amount, from_max: 1.1 - amount)
  }
  "Profile" #orange {
    // x is 0 in the middle of the crack and 1 at its border; the lip rises a little past it
    x = wall / max(width * 0.5, 0.0001)
    t = Clamp(value: 1.0 - x)
    groove = t * t * (3.0 - 2.0 * t) * open
    lip = Clamp(value: 1.0 - abs(x - 1.6)) * open
  }
  return mesh
    |> StoreNamedAttribute(name: "rock_crack", value: groove)
    |> SetPosition(offset: Normal().normal * (groove * -depth + lip * depth * 0.12))
}

geometry graph stylized_rock(
    seed: Int,
    size: Vector = (0.8, 0.7, 1.0),
    voxel: Float(subtype: DISTANCE) = 0.006 in 0.001..
) -> Geometry {
  "A stylized rock: facets, cracks, pits and chips, a seed a rock"
  return rock_block(seed: seed, size: size)
    |> clay(voxel: voxel)
    |> cracks(seed: seed)
    |> dents(size: 0.06, depth: 0.007, density: 0.03, seed: seed, stiff_edges: 0.5)
    |> dents(size: 0.03, depth: 0.004, density: 0.03, seed: seed + 3)
    |> chip_edges(depth: 0.006, wear: 0.4, width: 0.02, size: 0.05, seed: seed)
    |> mesh_maps(radius: 0.012, strength: 3.0, ao_distance: 0.3, ao_samples: 16)
    |> SetMaterial(material: RockStone)
}

shader(material: true) graph Ground() -> (surface: Shader) {
  "The ground of the planet"
  return (surface: PrincipledBSDF(base_color: (0.16, 0.2, 0.13), roughness: 0.9))
}

geometry graph rock_planet(
    radius: Float(subtype: DISTANCE) = 1.6 in 0.0..,
    spacing: Float(subtype: DISTANCE) = 0.85 in 0.1..,
    smallest: Float = 0.4 in 0.0..,
    largest: Float = 1.0 in 0.0..,
    voxel: Float(subtype: DISTANCE) = 0.008 in 0.001..,
    seed: Int
) -> Geometry {
  "A mini planet of rocks, spacing apart, no two alike: each is stylized_rock with a seed of its own, its own proportions, size and turn, standing on the ground along its normal"
  "Planet" #green {
    ball = IcoSphere(radius: radius, subdivisions: 5).mesh
    // Low hills, along the normals
    hills = NoiseTexture(vector: Position(), scale: 0.6, detail: 1.0).factor - 0.5
    ground = ball
      |> SetPosition(offset: Normal().normal * (hills * radius * 0.2))
      |> SetShadeSmooth()
    sites = DistributePointsOnFaces[POISSON](
      ground,
      distance_min: spacing,
      density_max: 4.0 / (spacing * spacing),
      seed: seed)
  }
  "Rocks" #orange {
    // A zone turn a rock: what the zone reads from the point is one value, so the seed is one too
    rocks = foreach(sites.points, centre: Position(), up: sites.normal, i: Index()) -> {
      shape = RandomValue[FLOAT_VECTOR](max: (1.0, 1.0, 1.0), id: i, seed: seed)
      turn = RandomValue[FLOAT_VECTOR](max: (1.0, 1.0, 1.0), id: i, seed: seed + 1)
      scale = Mix(factor: turn.z * turn.z, a: smallest, b: largest)
      size = (0.7, 0.6, 0.6) + shape * (0.5, 0.4, 0.5)
      // Its top along the normal of the ground, then leaning a little and turned any way about it
      stand = RotateRotation[LOCAL](
        rotation: AlignRotationToVector(vector: up),
        rotate_by: EulerToRotation(
          euler: CombineXYZ(x: turn.x * 0.8 - 0.4, y: 0.0, z: turn.y * 6.283185)))
      rock = stylized_rock(seed: seed + i, size: size, voxel: voxel / scale)
        |> TransformGeometry(
          // A third sunk in the ground
          translation: centre + up * (size.z * scale * 0.16),
          rotation: stand,
          scale: CombineXYZ(x: scale, y: scale, z: scale))
      return (geometry: rock)
    }
  }
  return rocks.geometry + SetMaterial(ground, material: Ground)
}
