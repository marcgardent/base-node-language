// @module stylized_rock_step3
// @title Stylized rock, step 3: the edges, from the mesh maps
// @author Base Node tutorials
// @license MIT OR Apache-2.0
// @offer groups, example
// @example stylized_rock

use generators
use math (fibonacci_point, random_direction)
use mesh_maps

shader graph rock_stone(
    stone: Color = (0.26, 0.26, 0.27),
    light: Color = (0.6, 0.6, 0.62),
    dark: Color = (0.12, 0.12, 0.13)
) -> Shader {
  "Grey stone, paler on its edges, darker in its hollows"
  m = curvature_mask(balance: 0.5, contrast: 0.4)
  "Edges" #orange {
    lit = Mix[RGBA](factor: m.mask, a: stone, b: light)
  }
  "Hollows" #violet {
    color = Mix[RGBA](factor: m.cavities, a: lit, b: dark)
  }
  return PrincipledBSDF(base_color: color, roughness: 0.35)
}

shader(material: true) graph RockStone() -> (surface: Shader) {
  "The rock's material: rock_stone, whose inputs on its node in the material tune it"
  return (surface: rock_stone())
}

geometry graph rock_block(
    facets: Int = 50 in 4..,
    jitter: Float = 0.8 in 0.0..1.0,
    size: Vector = (0.8, 0.7, 1.0),
    taper: Float = 0.25 in 0.0..0.8,
    seed: Int
) -> Geometry {
  "A convex block of flat facets, size wide, narrower toward its top by taper: an egg cut by facets planes, each where it touches the unit sphere"
  "Planes" #blue {
    // A point of the unit sphere a facet: spread evenly, then pushed about by the seed
    around = Points(
      count: facets,
      position: normalize(fibonacci_point(count: facets) + random_direction(seed: seed) * jitter))
    hull = ConvexHull(around)
  }
  "Corners" #teal {
    // Three planes meet at a corner of the block: the three points of a face of the hull. The
    // corner lies along that face's normal, at 1 over the distance of the face from the centre
    n = Normal().normal
    corners = StoreNamedAttribute[FLOAT_VECTOR, FACE](
      hull,
      name: "corner",
      value: n / (n ⋅ Position()))
    // The dual mesh has a point a face of the hull, and a face a point: the facets
    block = DualMesh(corners)
      |> SetPosition(position: NamedAttribute[FLOAT_VECTOR](name: "corner").attribute)
      |> RemoveNamedAttribute(name: "corner")
  }
  // Seen in perspective from above, the block is an egg and its facets are still flat: dividing
  // by a distance along an axis keeps a plane a plane
  return block
    |> SetPosition(
      // Brought back to its height and its middle, which the division moved
      position: Position() / (1.0 + Position().z * taper) * (1.0 - taper * taper)
        + CombineXYZ(z: taper))
    |> TransformGeometry(scale: size * 0.5)
}

geometry graph clay(
    mesh: Geometry,
    voxel: Float(subtype: DISTANCE) = 0.006 in 0.001..,
    soften: Int = 5 in 0..
) -> Geometry {
  "The mesh made again of even faces voxel wide, as a sculptor remeshes clay, its edges softened by soften passes of smoothing"
  dense = GridToMesh(grid: MeshToSDFGrid(mesh, voxel_size: voxel), threshold: 0.0)
  return dense
    |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: soften))
    |> SetShadeSmooth()
}

geometry graph stylized_rock(seed: Int) -> Geometry {
  "A rock whose material knows its edges"
  return rock_block(seed: seed)
    |> clay()
    |> mesh_maps(radius: 0.012, strength: 3.0, ao_distance: 0.3, ao_samples: 16)
    |> SetMaterial(material: RockStone)
}
