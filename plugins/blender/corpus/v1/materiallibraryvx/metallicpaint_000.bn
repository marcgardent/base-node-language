shader graph "MetallicPaint..000"(
    PaintColor: Color = (0.8, 0.8, 0.8),
    SpecularColor: Color = (0.8, 0.8, 0.8)
) -> Shader {
  hue_saturation_value = HueSaturationValue(color: PaintColor) @ "Repeat Color"
  return MixShader(
    factor: LayerWeight(blend: 0.69998).fresnel * 1.7,
    a: GlossyBSDF[BECKMANN](color: hue_saturation_value, roughness: 0.76418585),
    b: GlossyBSDF[BECKMANN](
      color: Mix[RGBA](factor: 0.15, a: hue_saturation_value, b: SpecularColor),
      roughness: 0.099949986))
}
