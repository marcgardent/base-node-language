shader graph "Coat II.002"(
    Shader: Shader,
    "Gloss Color": Color = (0.8, 0.8, 0.8),
    IOR: Float = 1.45 in 0.0..10000.0,
    "Fresnel/Facing": Float = 0.1 in 0.0..1.0,
    "Facing Strength": Float = 0.5 in 0.0..1.0,
    "Center Gloss": Float(subtype: FACTOR) in 0.0..1.0,
    "Edge Gloss": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    "Center Roughness": Float(subtype: FACTOR) = 0.1 in 0.0..1.0,
    "Edge Roughness": Float(subtype: FACTOR) = 0.005 in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> (Shader: Shader, Control: Shader) {
  fresnel = Fresnel(ior: IOR)
  layer_weight = LayerWeight(blend: facing_strength)
  mix = Mix[RGBA](
    factor: Mix[RGBA](factor: fresnel_facing, a: fresnel, b: layer_weight.facing),
    a: center_gloss,
    b: edge_gloss)
  mix_shader = MixShader(
    factor: mix,
    a: Shader,
    b: GlossyBSDF[GGX](
      color: gloss_color,
      roughness: Math[POWER](
        Value: Mix[RGBA](
          factor: Mix[RGBA](factor: fresnel_facing, a: fresnel, b: layer_weight.facing),
          a: center_roughness,
          b: edge_roughness)),
      normal: Normal))
  emission = Emission(color: mix)
  "bwide.wordpress.com" {
    return (Shader: mix_shader, Control: emission)
  }
}

shader graph "Plastic III.002"(
    Color: Color = (0.8, 0.0, 0.0),
    Translucency: Float in 0.0..1.0,
    "Translucency Mix/Add": Float in 0.0..1.0,
    SSS: Float in 0.0..1.0,
    "SSS Scale": Float = 1.0 in 0.0..1000000.0,
    "Gloss Color": Color = (0.8, 0.8, 0.8),
    "Gloss IOR": Float = 1.45 in 0.0..10000.0,
    "Fresnel/Facing": Float = 0.1 in 0.0..1.0,
    "Facing Strength": Float = 0.5 in 0.0..1.0,
    "Center Gloss": Float(subtype: FACTOR) in 0.0..1.0,
    "Edge Gloss": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Center Roughness": Float(subtype: FACTOR) = 0.006 in 0.0..1.0,
    "Edge Roughness": Float(subtype: FACTOR) = 0.002 in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> Shader {
  layer_weight = LayerWeight(blend: 0.20000002)
  mix = Mix[RGBA](factor: 0.3, a: layer_weight.fresnel, b: layer_weight.facing)
  diffuse_bsdf = DiffuseBSDF(color: Color, normal: Normal)
  translucent_bsdf = TranslucentBSDF(color: Color, normal: Normal) @ hide
  add_shader = AddShader(a: diffuse_bsdf, b: translucent_bsdf) @ hide
  mix_shader = MixShader(factor: Translucency, a: diffuse_bsdf, b: translucent_bsdf) @ hide
  mix_shader_2 = MixShader(factor: translucency_mix_add, a: mix_shader, b: add_shader) @ hide
  group = coat_ii_002(
    shader: MixShader(
      factor: SSS,
      a: mix_shader_2,
      b: SubsurfaceScattering[RANDOM_WALK_LEGACY](
        color: Color,
        scale: sss_scale,
        radius: (1.0, 1.0, 1.0),
        normal: Normal)),
    ior: gloss_ior,
    normal: Normal)
  "bwide.wordpress.com" {
    return group.shader
  }
}
