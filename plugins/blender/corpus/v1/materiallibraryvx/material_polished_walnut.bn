shader(material: true) graph "Polished Walnut"() -> (surface: Shader, displacement: Vector) {
  value = 1.0 @ "Scale" #ff1a1a
  math = value * 5.0
  mapping = Mapping(
    vector: TextureCoordinate().generated,
    rotation: (0.0, 0.0, 1.74532),
    scale: (2.0, 0.4, 10.0))
  wave_texture = WaveTexture[DIAGONAL, SPHERICAL](
    vector: mapping,
    scale: math,
    distortion: 15.0,
    detail: 4.42378,
    detail_scale: math,
    phase_offset: 1.5707964)
  return (
    surface: MixShader(
      factor: LayerWeight(blend: 0.02999).facing,
      a: GlossyBSDF[BECKMANN](
        color: Mix[RGBA, MULTIPLY](
          a: Mix[RGBA](
            factor: WaveTexture[RINGS, DIAGONAL, SPHERICAL](
              vector: mapping,
              scale: value * 0.69998,
              distortion: 350.0,
              detail: 4.0,
              detail_scale: value * 0.25,
              phase_offset: 1.5707964).factor,
            a: (1.0, 1.0, 1.0, 1.0),
            b: (0.23573, 0.23573, 0.23573, 1.0)),
          b: Mix[RGBA](
            factor: wave_texture.factor,
            a: (0.13197, 0.04244, 0.02085, 1.0),
            b: (0.0401, 0.01503, 0.00737, 1.0))),
        roughness: 0.8660254),
      b: GlossyBSDF[BECKMANN](color: (1.0, 0.88691, 0.84328, 1.0), roughness: 0.5915995)),
    displacement: Displacement(height: wave_texture.factor * 0.002, midlevel: 0.0, scale: 0.1))
}
