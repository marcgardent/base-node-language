shader graph "Paper.002"(
    "Color Front": Color = (0.8, 0.0, 0.039479066),
    "Color Back": Color = (0.0, 0.8, 0.03755131),
    Gloss: Color = (0.8, 0.8, 0.8),
    Translucency: Float = 0.4 in 0.0..1.0,
    "Gloss Strength": Float = 0.1 in 0.0..1.0,
    "Gloss Roughness": Float = 0.2 in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> Shader {
  Add = Geometry().backfacing * 0.8
  mix_shader = MixShader(
    factor: LayerWeight(blend: gloss_strength).fresnel,
    a: MixShader(
      factor: Add,
      a: MixShader(
        factor: Translucency,
        a: DiffuseBSDF(color: color_front, normal: Normal),
        b: TranslucentBSDF(color: color_front, normal: Normal)),
      b: MixShader(
        factor: Translucency,
        a: DiffuseBSDF(color: color_back, normal: Normal),
        b: TranslucentBSDF(color: color_back, normal: Normal))),
    b: GlossyBSDF[BECKMANN](color: Gloss, roughness: pow(gloss_roughness, 0.5), normal: Normal))
  "bwide.wordpress.com" {
    return mix_shader
  }
}

shader(material: true) graph "Double  Sided"() -> (surface: Shader) {
  return (surface: paper_002())
}
