shader graph "ME_Contrast_Gloss.001"(
    MixFactor: Float = 0.5,
    BaseColor: Color = (0.5, 0.5, 0.5)
) -> Shader {
  brightness_contrast = BrightnessContrast(color: BaseColor, brightness: -0.2)
  fresnel = Fresnel(ior: 2.0)
  math = 0.1 + fresnel * 0.2
  return MixShader(
    factor: MixFactor,
    a: GlossyBSDF[BECKMANN](
      color: Mix[RGBA](factor: fresnel, a: brightness_contrast, b: BaseColor),
      roughness: pow(math, 0.5)),
    b: GlossyBSDF[BECKMANN](
      color: Mix[RGBA](
        factor: fresnel,
        a: brightness_contrast,
        b: BrightnessContrast(color: BaseColor, brightness: 0.5)),
      roughness: pow(math, 0.5)))
}

shader graph "ME_Spec_Reflection.001"(
    Shader: Shader,
    Fac: Float = 0.02999,
    ColorSpec: Color = (0.8, 0.8, 0.8),
    RoughReflex: Float = 0.00999
) -> Shader {
  return MixShader(
    factor: Fac,
    a: Shader,
    b: GlossyBSDF[BECKMANN](color: ColorSpec, roughness: pow(RoughReflex, 0.5)))
}

shader(material: true) graph Anodized() -> (surface: Shader) {
  return (
    surface: me_spec_reflection_001(
      shader: me_contrast_gloss_001(
        mixfactor: LayerWeight(blend: Fresnel(ior: 1.45)).facing,
        basecolor: ColorRamp[
          color_ramp: Ramp(
            (0.0, (1.0, 0.0, 0.0765, 1.0)),
            (0.87272, (1.0, 0.23997, 0.19693, 1.0)),
            (1.0, (0.06543, 0.02405, 0.02236, 1.0)),
            interpolation: EASE)]().color)))
}
