geometry(is_modifier: false) graph "Tessera · Map"(
    Geometry: Geometry,
    Surface: Geometry,
    Mapping: Int,
    "UV Map": String,
    "UV Scale": Float,
    "Bend to Surface": Bool,
    "Region Min": Vector,
    "Fit Repeats": Bool,
    "Wrap Width": Float
) -> Geometry {
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: uv_map)
  bounding_box = BoundingBox(Surface)
  math = bounding_box.max.z - bounding_box.min.z + 2.0
  boolean_math = fit_repeats and wrap_width > 1e-06
  named_attribute_2 = NamedAttribute[FLOAT_VECTOR](name: "ts_c2")
  named_attribute_3 = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  position = Position()
  math_2 = position.x - named_attribute_2.attribute.x
  math_3 = position.y - named_attribute_2.attribute.y
  normal = Normal()
  raycast = Raycast(
    Surface,
    source_position: CombineXYZ(
      x: named_attribute_2.attribute.x,
      y: named_attribute_2.attribute.y,
      z: bounding_box.max.z + 1.0),
    ray_length: math)
  raycast_2 = Raycast(
    Surface,
    source_position: CombineXYZ(
      x: named_attribute_3.attribute.x,
      y: named_attribute_3.attribute.y,
      z: bounding_box.max.z + 1.0),
    ray_length: math)
  switch = raycast.is_hit ? normalize(raycast.hit_normal) : normalize(raycast_2.hit_normal)
  vector_math = normalize((1.0, 0.0, 0.0) - switch * switch.x)
  vector_math_2 = (raycast.is_hit ? raycast.hit_position : raycast_2.hit_position)
    + vector_math * math_2
    + ((switch × vector_math) * math_3 + switch * position.z)
  vector_math_3 = CombineXYZ(
      x: boolean_math
        ? region_min.x
          + Math[FLOORED_MODULO](
            Value: named_attribute_2.attribute.x - region_min.x,
            Value_001: max(wrap_width, 1e-06))
        : named_attribute_2.attribute.x,
      y: named_attribute_2.attribute.y)
    * (1.0 / uv_scale)
  switch_2 = SampleUVSurface[FLOAT_VECTOR](
      Surface,
      value: Position(),
      uv_map: named_attribute.attribute,
      sample_uv: vector_math_3).is_valid
    ? vector_math_3
    : CombineXYZ(
        x: boolean_math
          ? region_min.x
            + Math[FLOORED_MODULO](
              Value: named_attribute_3.attribute.x - region_min.x,
              Value_001: max(wrap_width, 1e-06))
          : named_attribute_3.attribute.x,
        y: named_attribute_3.attribute.y)
      * (1.0 / uv_scale)
  sample_uvsurface = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2)
  vector_math_4 = normalize(
    SampleUVSurface[FLOAT_VECTOR](
      Surface,
      value: normal.normal,
      uv_map: named_attribute.attribute,
      sample_uv: switch_2).value)
  sample_uvsurface_2 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2 + (0.001, 0.0, 0.0))
  switch_3 = sample_uvsurface_2.is_valid
    ? sample_uvsurface_2.value - sample_uvsurface.value
    : sample_uvsurface.value
      - SampleUVSurface[FLOAT_VECTOR](
        Surface,
        value: Position(),
        uv_map: named_attribute.attribute,
        sample_uv: switch_2 - (0.001, 0.0, 0.0)).value
  sample_uvsurface_3 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2 + (0.0, 0.001, 0.0))
  vector_math_5 = normalize(switch_3 - vector_math_4 * (switch_3 ⋅ vector_math_4))
  vector_math_6 = vector_math_4 × vector_math_5
  vector_math_7 = sample_uvsurface.value
    + vector_math_5 * math_2
    + ((vector_math_6
              ⋅ (sample_uvsurface_3.is_valid
                ? sample_uvsurface_3.value - sample_uvsurface.value
                : sample_uvsurface.value
                  - SampleUVSurface[FLOAT_VECTOR](
                    Surface,
                    value: Position(),
                    uv_map: named_attribute.attribute,
                    sample_uv: switch_2 - (0.0, 0.001, 0.0)).value)
            < 0.0
          ? -vector_math_6
          : vector_math_6)
        * math_3
      + vector_math_4 * position.z)
  vector_math_8 = CombineXYZ(
      x: boolean_math
        ? region_min.x
          + Math[FLOORED_MODULO](
            Value: position.x - region_min.x,
            Value_001: max(wrap_width, 1e-06))
        : position.x,
      y: position.y)
    * (1.0 / uv_scale)
  sample_uvsurface_4 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: vector_math_8)
  raycast_3 = Raycast(
    Surface,
    source_position: CombineXYZ(x: position.x, y: position.y, z: bounding_box.max.z + 1.0),
    ray_length: math)
  return SetPosition(
    Geometry,
    position: IndexSwitch(
      Mapping,
      position,
      bend_to_surface
        ? (raycast_3.is_hit
          ? raycast_3.hit_position + normalize(raycast_3.hit_normal) * position.z
          : vector_math_2)
        : vector_math_2,
      bend_to_surface
        ? (sample_uvsurface_4.is_valid
          ? sample_uvsurface_4.value
            + normalize(
                SampleUVSurface[FLOAT_VECTOR](
                  Surface,
                  value: normal.normal,
                  uv_map: named_attribute.attribute,
                  sample_uv: vector_math_8).value)
              * position.z
          : vector_math_7)
        : vector_math_7))
}
