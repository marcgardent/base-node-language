geometry graph "Separate Spherical"(
    Vector: Vector(hide_value: true) in 0.0..1.0
) -> (
    R: Float(description: "Radius - Length of the vector"),
    Phi: Float(subtype: ANGLE, description: "Azimuth - Angle around the up axis"),
    Theta: Float(subtype: ANGLE, description: "Zenith - Angle from the ground plane")
) {
  vector_math = length(Vector)
  return (R: vector_math, Phi: atan2(Vector.y, Vector.x), Theta: asin(Vector.z / vector_math))
}
