geometry graph ".average_face_corners_for_edge"("Edge Index": Int, Vector: Vector) -> Vector {
  return EvaluateAtIndex[EDGE, INT](value: EdgeNeighbors(), index: edge_index) > 2
    ? FieldAverage[FLOAT_VECTOR, CORNER](
      value: Vector,
      group_id: HashValue(
        value: HashValue(value: edge_index, seed: 137),
        seed: HashValue(value: VertexOfCorner(), seed: 231))).mean
    : Vector
}

geometry graph "Is Edge Boundary"() -> (
    "Is Edge Boundary": Bool(
      description: "Selection of edges that are part of the boundary of a mesh surface")
) {
  return ("Is Edge Boundary": EvaluateOnDomain[EDGE, BOOLEAN](value: EdgeNeighbors() == 1))
}

geometry graph "Is UV Split"(
    "UV Map": Vector(
      description: "Vectors to compare between connected face corners of an edge for differences. (Supports 3D vectors.)",
      hide_value: true)
) -> (
    "Is UV Split": Bool(
      description: "Selection of edges that signify a discontinuity of the input vectors",
      attribute_domain: EDGE)
) {
  vertex_of_corner = VertexOfCorner()
  corners_of_edge = CornersOfEdge(weights: vertex_of_corner)
  corners_of_edge_2 = CornersOfEdge(weights: vertex_of_corner, sort_index: -1)
  offset_corner_in_face = OffsetCornerInFace(
    corner_index: corners_of_edge_2.corner_index,
    offset: 1)
  "Flipped Normals" {
    compare = VertexOfCorner(corner_index: corners_of_edge.corner_index)
      == VertexOfCorner(corner_index: corners_of_edge_2.corner_index)
  }
  switch = compare ? corners_of_edge_2.corner_index : offset_corner_in_face @ hide
  switch_2 = compare ? offset_corner_in_face : corners_of_edge_2.corner_index @ hide
  "Compare averages for face count > 2" {
    edges_of_corner = EdgesOfCorner()
    group = average_face_corners_for_edge(
      edge_index: edges_of_corner.previous_edge_index,
      vector: uv_map)
    group_2 = average_face_corners_for_edge(
      edge_index: edges_of_corner.next_edge_index,
      vector: uv_map)
  }
  value = 1e-05 @ "Threshold"
  boolean_math = Compare[NOT_EQUAL, VECTOR](
      a: EvaluateAtIndex[CORNER, FLOAT_VECTOR](value: group_2, index: corners_of_edge.corner_index),
      b: EvaluateAtIndex[CORNER, FLOAT_VECTOR](value: group, index: switch),
      epsilon: value)
    or Compare[NOT_EQUAL, VECTOR](
      a: EvaluateAtIndex[CORNER, FLOAT_VECTOR](
        value: group,
        index: OffsetCornerInFace(corner_index: corners_of_edge.corner_index, offset: 1)),
      b: EvaluateAtIndex[CORNER, FLOAT_VECTOR](value: group_2, index: switch_2),
      epsilon: value)
  "Edge Boundary" {
    switch_3 = is_edge_boundary() ? false : boolean_math
  }
  return ("Is UV Split": EvaluateOnDomain[EDGE, BOOLEAN](value: switch_3))
}
