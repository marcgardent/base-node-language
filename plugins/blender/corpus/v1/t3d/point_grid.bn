geometry(is_modifier: true) graph "Point Grid"(
    "Count X": Int = 3 in 1..,
    "Count Y": Int = 3 in 1..,
    "Count Z": Int = 3 in 1..,
    Spacing: Vector = (1.0, 1.0, 1.0),
    "Point Radius": Float(subtype: DISTANCE) = 0.25 in 0.0..
) -> (Points: Geometry) {
  "Points X" {
    duplicate_elements = Points(radius: point_radius)
      |> DuplicateElements(amount: count_x)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements.duplicate_index,
        Vector_001: Spacing * (1.0, 0.0, 0.0)))
  }
  "Points Y" {
    duplicate_elements_2 = DuplicateElements(set_position, amount: count_y)
    set_position_2 = SetPosition(
      duplicate_elements_2.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_2.duplicate_index,
        Vector_001: Spacing * (0.0, 1.0, 0.0)))
  }
  "Points Z" {
    duplicate_elements_3 = DuplicateElements(set_position_2, amount: count_z)
    set_position_3 = SetPosition(
      duplicate_elements_3.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_3.duplicate_index,
        Vector_001: Spacing * (0.0, 0.0, 1.0)))
  }
  "Center At Origin" {
    bounding_box = BoundingBox(set_position_3)
    set_position_4 = SetPosition(
      set_position_3,
      offset: -Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max))
  }
  return (Points: set_position_4)
}
