geometry graph "Trace Matrix"(Matrix: Matrix) -> (Value: Float) {
  {
    separate_matrix = SeparateMatrix(matrix: Matrix)
    math = separate_matrix.column_1_row_1
      + separate_matrix.column_2_row_2
      + separate_matrix.column_3_row_3
      + separate_matrix.column_4_row_4
  }
  return (Value: math)
}
