geometry graph "Matrix Viewer"(
    Matrix: Matrix,
    Decimals: Int in 0..,
    Scale: Float = 0.5 in 0.0..,
    "Spacing" {
        X: Float = 1.5 in -10000.0..10000.0,
        Y: Float = 1.5 in -10000.0..10000.0
    }
) -> (Instances: Geometry) {
  {
    separate_matrix = SeparateMatrix(matrix: TransposeMatrix(matrix: Matrix))
    value_to_string = ValueToString(
      value: separate_matrix.column_1_row_1,
      decimals: Decimals) @ hide
    string_to_curves = StringToCurves(
      string: value_to_string,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance = GeometryToInstance(string_to_curves.curve_instances) @ hide
    value_to_string_2 = ValueToString(
      value: separate_matrix.column_1_row_2,
      decimals: Decimals) @ hide
    string_to_curves_2 = StringToCurves(
      string: value_to_string_2,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_2 = GeometryToInstance(string_to_curves_2.curve_instances) @ hide
    value_to_string_3 = ValueToString(
      value: separate_matrix.column_1_row_3,
      decimals: Decimals) @ hide
    string_to_curves_3 = StringToCurves(
      string: value_to_string_3,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_3 = GeometryToInstance(string_to_curves_3.curve_instances) @ hide
    value_to_string_4 = ValueToString(
      value: separate_matrix.column_1_row_4,
      decimals: Decimals) @ hide
    string_to_curves_4 = StringToCurves(
      string: value_to_string_4,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_4 = GeometryToInstance(string_to_curves_4.curve_instances) @ hide
    value_to_string_5 = ValueToString(
      value: separate_matrix.column_2_row_1,
      decimals: Decimals) @ hide
    string_to_curves_5 = StringToCurves(
      string: value_to_string_5,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_5 = GeometryToInstance(string_to_curves_5.curve_instances) @ hide
    value_to_string_6 = ValueToString(
      value: separate_matrix.column_2_row_2,
      decimals: Decimals) @ hide
    string_to_curves_6 = StringToCurves(
      string: value_to_string_6,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_6 = GeometryToInstance(string_to_curves_6.curve_instances) @ hide
    value_to_string_7 = ValueToString(
      value: separate_matrix.column_2_row_3,
      decimals: Decimals) @ hide
    string_to_curves_7 = StringToCurves(
      string: value_to_string_7,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_7 = GeometryToInstance(string_to_curves_7.curve_instances) @ hide
    value_to_string_8 = ValueToString(
      value: separate_matrix.column_2_row_4,
      decimals: Decimals) @ hide
    string_to_curves_8 = StringToCurves(
      string: value_to_string_8,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_8 = GeometryToInstance(string_to_curves_8.curve_instances) @ hide
    value_to_string_9 = ValueToString(
      value: separate_matrix.column_3_row_1,
      decimals: Decimals) @ hide
    string_to_curves_9 = StringToCurves(
      string: value_to_string_9,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_9 = GeometryToInstance(string_to_curves_9.curve_instances) @ hide
    value_to_string_10 = ValueToString(
      value: separate_matrix.column_3_row_2,
      decimals: Decimals) @ hide
    string_to_curves_10 = StringToCurves(
      string: value_to_string_10,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_10 = GeometryToInstance(string_to_curves_10.curve_instances) @ hide
    value_to_string_11 = ValueToString(
      value: separate_matrix.column_3_row_3,
      decimals: Decimals) @ hide
    string_to_curves_11 = StringToCurves(
      string: value_to_string_11,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_11 = GeometryToInstance(string_to_curves_11.curve_instances) @ hide
    value_to_string_12 = ValueToString(
      value: separate_matrix.column_3_row_4,
      decimals: Decimals) @ hide
    string_to_curves_12 = StringToCurves(
      string: value_to_string_12,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_12 = GeometryToInstance(string_to_curves_12.curve_instances) @ hide
    value_to_string_13 = ValueToString(
      value: separate_matrix.column_4_row_1,
      decimals: Decimals) @ hide
    string_to_curves_13 = StringToCurves(
      string: value_to_string_13,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_13 = GeometryToInstance(string_to_curves_13.curve_instances) @ hide
    value_to_string_14 = ValueToString(
      value: separate_matrix.column_4_row_2,
      decimals: Decimals) @ hide
    string_to_curves_14 = StringToCurves(
      string: value_to_string_14,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_14 = GeometryToInstance(string_to_curves_14.curve_instances) @ hide
    value_to_string_15 = ValueToString(
      value: separate_matrix.column_4_row_3,
      decimals: Decimals) @ hide
    string_to_curves_15 = StringToCurves(
      string: value_to_string_15,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_15 = GeometryToInstance(string_to_curves_15.curve_instances) @ hide
    value_to_string_16 = ValueToString(
      value: separate_matrix.column_4_row_4,
      decimals: Decimals) @ hide
    string_to_curves_16 = StringToCurves(
      string: value_to_string_16,
      align_x: Center,
      align_y: Middle) @ hide
    geometry_to_instance_16 = GeometryToInstance(string_to_curves_16.curve_instances) @ hide
  }
  {
    combine_xyz = CombineXYZ(x: X, y: Y) @ hide
    vector_math = Position() * combine_xyz @ hide
    rotate_vector = RotateVector(vector: vector_math, rotation: (0.0, 0.0, -1.5707964)) @ hide
    set_position = Grid(size_x: 1.5, size_y: 1.5, vertices_x: 4, vertices_y: 4).mesh
      |> SetPosition(position: rotate_vector)
  }
  {
    instance_on_points = InstanceOnPoints(
      set_position,
      instance: geometry_to_instance
        + geometry_to_instance_2
        + geometry_to_instance_3
        + geometry_to_instance_4
        + geometry_to_instance_5
        + geometry_to_instance_6
        + geometry_to_instance_7
        + geometry_to_instance_8
        + geometry_to_instance_9
        + geometry_to_instance_10
        + geometry_to_instance_11
        + geometry_to_instance_12
        + geometry_to_instance_13
        + geometry_to_instance_14
        + geometry_to_instance_15
        + geometry_to_instance_16,
      pick_instance: true,
      scale: Scale)
  }
  return (Instances: instance_on_points)
}
