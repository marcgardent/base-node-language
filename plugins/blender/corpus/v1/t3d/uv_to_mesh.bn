geometry graph "UV To Mesh"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "UV Map": Vector(description: "By default uses UVMap", hide_value: true),
    Strength: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Preserve Area": Bool = true,
    "Center At Origin": Bool = true
) -> (Mesh: Geometry, "UV Map": Vector(attribute_domain: CORNER)) {
  "Preserve Face Area" {
    face_area = FaceArea()
  }
  "Edge Split" {
    capture_attribute = Mesh
      |> SplitEdges(selection: Selection)
      |> CaptureAttribute[CORNER](Value: uv_map)
  }
  "Preserve Face Area" .. {
    vector_math_2 = capture_attribute.value
      * sqrt(
        AttributeStatistic(capture_attribute.geometry, attribute: face_area).sum
          / (capture_attribute.geometry
            |> SetPosition(position: capture_attribute.value)
            |> AttributeStatistic(attribute: face_area).sum))
  }
  {
    set_position_2 = SetPosition(
      capture_attribute.geometry,
      position: preserve_area ? vector_math_2 : capture_attribute.value)
  }
  {
    bounding_box = BoundingBox(set_position_2)
    vector_math = Position()
      + Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max) * -center_at_origin
  }
  {
    sample_index = SampleIndex[FLOAT_VECTOR, clamp: true](
      capture_attribute.geometry,
      value: Position(),
      index: Index())
  }
  {
    set_position = SetPosition(
      set_position_2,
      position: Mix[VECTOR](factor: Strength, a: sample_index, b: vector_math))
  }
  return (Mesh: set_position, "UV Map": capture_attribute.value)
}
