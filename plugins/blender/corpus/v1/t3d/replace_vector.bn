geometry graph "Replace Vector"(
    Menu: Menu(force_non_field: true, optional_label: true, structure_type: SINGLE) = X,
    Vector: Vector(hide_value: true),
    Value: Float
) -> Vector {
  {
    menu_switch = MenuSwitch(
      menu: Menu,
      X: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (0.0, 1.0, 1.0),
        Vector_002: CombineXYZ(x: Value)),
      Y: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (1.0, 0.0, 1.0),
        Vector_002: CombineXYZ(y: Value)),
      Z: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (1.0, 1.0, 0.0),
        Vector_002: CombineXYZ(z: Value)))
  }
  return menu_switch.output
}
