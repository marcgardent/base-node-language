geometry graph "Cylinder Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION),
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0)
) -> (Factor: Float) {
  "Transformation" {
    vector_math = RotateVector(vector: Position() - Location, rotation: Rotation) / (Scale * 0.5)
  }
  "Parameters" {
    math = abs(vector_math.z) - 1.0
    math_2 = length(vector_math * (1.0, 1.0, 0.0)) - 1.0
  }
  "Cylinderical Field" {
    combine_xyz = CombineXYZ(x: math_2, y: math)
    math_3 = -(length(max(combine_xyz, 0.0)) + min(max(combine_xyz.x, combine_xyz.y), 0.0))
    switch = Clamp ? Clamp(value: math_3) : math_3
  }
  return (Factor: switch)
}
