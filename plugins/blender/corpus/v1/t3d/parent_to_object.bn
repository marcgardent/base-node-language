geometry graph "Parent To Object"(
    Children: Geometry,
    Parent: Object,
    Location: Bool = true,
    Rotation: Bool = true,
    Scale: Bool = true
) -> Geometry {
  {
    object_info = ObjectInfo[RELATIVE](object: Parent)
  }
  {
    vector_math = object_info.location * Location
    vector_math_2 = VectorMath[SCALE](vector: object_info.rotation, scale: Rotation)
    vector_math_3 = object_info.scale * Scale
  }
  "Transformation" {
    set_position = SetPosition(
      Children,
      position: VectorRotate[EULER_XYZ](
          vector: Position() + vector_math,
          center: object_info.location,
          rotation: vector_math_2)
        * vector_math_3)
  }
  return set_position
}
