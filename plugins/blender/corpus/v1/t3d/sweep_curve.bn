geometry graph "Sweep Curve"(
    Curve: Geometry,
    "Profile Curve": Geometry,
    "Fill Caps": Bool = true
) -> (Mesh: Geometry, UV: Vector(attribute_domain: CORNER)) {
  {
    position = Position()
    spline_parameter = SplineParameter()
    spline_parameter_2 = SplineParameter()
    capture_attribute_2 = CaptureAttribute(
      profile_curve,
      Factor: spline_parameter_2.factor,
      Index: spline_parameter_2.index)
    named_attribute = NamedAttribute(name: "radius")
  }
  {
    position_2 = Position()
    vector_math = normalize(
      EvaluateAtIndex[FLOAT_VECTOR](
          value: position_2,
          index: OffsetPointInCurve(offset: -1).point_index)
        - position_2)
    vector_math_2 = normalize(
      EvaluateAtIndex[FLOAT_VECTOR](
          value: position_2,
          index: OffsetPointInCurve(offset: 1).point_index)
        - position_2)
    vector_math_3 = normalize(vector_math + vector_math_2)
    math = 2.0 / distance(vector_math, vector_math_2) - 1.0
  }
  {
    capture_attribute = CaptureAttribute(
      Curve,
      Position: position,
      Direction: vector_math_3,
      "Scale Factor": math,
      Factor: spline_parameter.factor,
      Index: spline_parameter.index)
  }
  {
    evaluate_on_domain = EvaluateOnDomain[FACE, INT](value: capture_attribute_2.index)
    evaluate_on_domain_2 = EvaluateOnDomain[FACE, INT](value: capture_attribute.index)
    combine_xyz = CombineXYZ(
      x: evaluate_on_domain_2 > 1 and evaluate_on_domain_2 == 0 ? 1.0 : capture_attribute.factor,
      y: evaluate_on_domain > 1 and evaluate_on_domain == 0 ? 1.0 : capture_attribute_2.factor)
  }
  {
    capture_attribute_3 = capture_attribute.geometry
      |> CurveToMesh(
        profile_curve: capture_attribute_2.geometry,
        scale: named_attribute.exists ? named_attribute.attribute : 1.0,
        fill_caps: fill_caps)
      |> SetPosition(
        offset: capture_attribute.direction
          * (((position - capture_attribute.position) ⋅ capture_attribute.direction)
            * capture_attribute.scale_factor))
      |> SetShadeSmooth(shade_smooth: false)
      |> CaptureAttribute[CORNER](Vector: combine_xyz)
  }
  return (Mesh: capture_attribute_3.geometry, UV: capture_attribute_3.vector)
}
