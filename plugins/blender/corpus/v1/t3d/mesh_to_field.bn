geometry graph "Mesh To Field"(Mesh: Geometry) -> (Factor: Float) {
  {
    boolean_math = Raycast(Mesh).is_hit
      and Raycast(Mesh, ray_direction: (0.0, 0.0, 1.0)).is_hit
      and (Raycast(Mesh, ray_direction: (0.0, -1.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (0.0, 1.0, 0.0)).is_hit)
      and (Raycast(Mesh, ray_direction: (-1.0, 0.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (1.0, 0.0, 0.0)).is_hit)
  }
  "Field" {
    math = -((boolean_math ? -1.0 : 1.0) * GeometryProximity(Mesh).distance)
  }
  return (Factor: math)
}
