geometry graph "Curve Root"() -> (
    "Root Selection": Bool(description: "Boolean selection of curve root points"),
    "Root Position": Vector(
      description: "Position of the root point of a curve",
      attribute_domain: CURVE),
    "Root Direction": Vector(
      description: "Direction of the root segment of a curve",
      attribute_domain: CURVE),
    "Root Index": Int(description: "Index of the root point of a curve", attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](value: PointsOfCurve().point_index)
  return (
    "Root Selection": EndpointSelection(end_size: 0),
    "Root Position": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: evaluate_on_domain)),
    "Root Direction": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: CurveTangent(), index: evaluate_on_domain)),
    "Root Index": evaluate_on_domain)
}

geometry graph "Curve Tip"() -> (
    "Tip Selection": Bool(description: "Boolean selection of curve tip points"),
    "Tip Position": Vector(
      description: "Position of the tip point of a curve",
      attribute_domain: CURVE),
    "Tip Direction": Vector(
      description: "Direction of the tip segment of a curve",
      attribute_domain: CURVE),
    "Tip Index": Int(description: "Index of the tip point of a curve", attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](
    value: PointsOfCurve(sort_index: -1).point_index)
  return (
    "Tip Selection": EndpointSelection(start_size: 0),
    "Tip Position": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: evaluate_on_domain)),
    "Tip Direction": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: CurveTangent(), index: evaluate_on_domain)),
    "Tip Index": evaluate_on_domain)
}

geometry graph "Curve Info"() -> (
    "Curve Index": Int(description: "Index of each curve", attribute_domain: CURVE),
    "Curve ID": Int(description: "ID of each curve", attribute_domain: CURVE),
    Length: Float(description: "Length of each curve", attribute_domain: CURVE),
    Direction: Vector(
      description: "Direction from root to tip of each curve",
      attribute_domain: CURVE),
    Random: Float(description: "Random vector for each curve", attribute_domain: CURVE),
    "Surface UV": Vector(
      description: "Attachment surface UV coordinates of each curve",
      attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](value: Index()) @ hide
  "ID per Curve" {
    evaluate_on_domain_2 = EvaluateOnDomain[CURVE, INT](
      value: EvaluateAtIndex[INT](value: ID(), index: curve_root().root_index))
  }
  return (
    "Curve Index": evaluate_on_domain,
    "Curve ID": evaluate_on_domain_2,
    Length: SplineLength().length,
    Direction: normalize(curve_tip().tip_position - curve_root().root_position),
    Random: EvaluateOnDomain[CURVE](
      value: EvaluateAtIndex(
        value: RandomValue(id: evaluate_on_domain_2),
        index: curve_root().root_index)),
    "Surface UV": NamedAttribute[FLOAT_VECTOR](name: "surface_uv_coordinate").attribute)
}
