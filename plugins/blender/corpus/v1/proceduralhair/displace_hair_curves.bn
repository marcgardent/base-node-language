geometry graph ".shape_range"(
    Value: Float(hide_value: true) in 0.0..1.0,
    Min: Float(description: "rdghrhd") in -10000.0..10000.0,
    Max: Float = 1.0 in -10000.0..10000.0,
    Shape: Float in -1.0..1.0,
    Base: Float = 2.0 in 1.0..10000.0
) -> (Value: Float) {
  map_range = MapRange[clamp: false](value: Value, from_min: Min, from_max: Max) @ hide
  math_2 = 1.0 - map_range @ hide
  compare = Shape < 0.0 @ hide
  boolean_math = not compare @ hide
  math_7 = max(Base, 1.00001) @ hide
  math_3 = 1.0 / math_7 @ hide
  math_4 = 1.0 - math_3 @ hide
  math_5 = math_4 * 2.0 @ hide
  math_10 = max(math_7, 1.000001) @ hide
  math_15 = min(abs(Shape), 0.999999)
  compare_2 = math_15 > 0.5 @ hide
  switch_2 = compare_2 ? boolean_math : compare @ hide
  switch = switch_2 ? math_2 : map_range @ hide
  math_14 = Math[PINGPONG](Value: math_15) @ hide
  math_6 = math_14 * math_5 @ hide
  math_9 = 1.0 - math_6 @ hide
  math_11 = max(math_9, 1e-05) @ hide
  math_13 = log(math_11, math_10) @ hide
  math_8 = -math_13 @ hide
  math_12 = pow(switch, math_8)
  math = 1.0 - math_12 @ hide
  switch_3 = compare_2 ? math : math_12 @ hide
  return (
    Value: Compare[EQUAL](a: Shape, epsilon: 1e-05)
      ? 1.0
      : MapRange(value: switch_3, to_min: Min, to_max: Max))
}

geometry graph "Get Attachment Surface"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> ("Surface Geometry": Geometry, "Surface UV Map": Vector, Exists: Bool) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  separate_bundle = SeparateBundle(
    get_geometry_bundle.bundle) -> (surface_geometry: Geometry, surface_uv_map: Vector)
  compare = DomainSize(separate_bundle.surface_geometry).point_count == 0
  separate_bundle_2 = SeparateBundle(
    get_geometry_bundle.bundle) -> (surface_object: Object, surface_uv_map_name: String)
  switch = compare
    ? ObjectInfo[RELATIVE](object: separate_bundle_2.surface_object).geometry
    : separate_bundle.surface_geometry
  return (
    "Surface Geometry": switch,
    "Surface UV Map": compare
      ? NamedAttribute[FLOAT_VECTOR](name: separate_bundle_2.surface_uv_map_name).attribute
      : separate_bundle.surface_uv_map,
    Exists: not Warning(
      show: DomainSize(switch).point_count == 0,
      message: "Missing surface geometry"))
}

geometry graph "Attachment Info"(
    "Hair Curves": Geometry(description: "Surface geometry of the curve attachment")
) -> (
    "Surface Geometry": Geometry,
    "Surface Exists": Bool,
    "Attachment UV": Vector(description: "Surface attachment UV coordinates stored on each curve"),
    "Attachment Is Valid": Bool(
      description: "Whether the stored attachment UV coordinate is valid"),
    "Surface Normal": Vector(
      description: "Normal direction of the surface mesh at the attachment point")
) {
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: "surface_normal")
  group = get_attachment_surface(hair_curves)
  "Smooth Normals" {
    capture_attribute = CaptureAttribute(
      group.surface_geometry,
      Value: Normal[legacy_corner_normals: true]().normal) @ hide
  }
  sample_uvsurface = SampleUVSurface[FLOAT_VECTOR](
    capture_attribute.geometry,
    value: capture_attribute.value,
    uv_map: group.surface_uv_map,
    sample_uv: NamedAttribute[FLOAT_VECTOR](name: "surface_uv_coordinate").attribute)
  switch = Switch[GEOMETRY](
    switch: Warning[WARNING](show: not group.exists, message: "Missing hair surface geometry."),
    false_: group.surface_geometry) @ hide
  return (
    "Surface Geometry": switch,
    "Surface Exists": group.exists,
    "Attachment UV": NamedAttribute[FLOAT_VECTOR](name: "surface_uv_coordinate").attribute,
    "Attachment Is Valid": sample_uvsurface.is_valid,
    "Surface Normal": EvaluateOnDomain[FLOAT_VECTOR](
      value: named_attribute.exists ? named_attribute.attribute : sample_uvsurface.value))
}

geometry(show_modifier_manage_panel: false) graph "Displace Hair Curves"(
    Geometry: Geometry(description: "Input geometry (may include geometry other than curves)"),
    Factor: Float(
      subtype: FACTOR,
      description: "Factor to scale overall displacement") = 1.0 in 0.0..1.0,
    Shape: Float(
      description: "Shape of the influence along curves (0 = constant, 0.5 = linear)") = 0.5 in -1.0..1.0,
    "Object Space": Object(
      description: "Object used to define the displacement space",
      optional_label: true),
    "Displace Vector": Vector(subtype: TRANSLATION, description: "Vector for displacement"),
    "Surface Normal"(default_closed: true) {
        "Surface Normal": Bool(is_panel_toggle: true),
        "Surface Input Type": Menu(
          description: "Select the input type for the surface geometry.",
          hide_in_modifier: true,
          menu_expanded: true,
          optional_label: true) = Object,
        Surface: Geometry(
          description: "Surface geometry used to sample the normal for displacement"),
        Surface as surface_object: Object(
          description: "Surface object used to sample the normal for displacement",
          optional_label: true),
        "Surface UV Map": Vector(
          description: "Surface UV map used to sample the normal for displacement",
          hide_value: true,
          default_attribute_name: "UVMap"),
        "Surface Normal Distance": Float(
          subtype: DISTANCE,
          description: "Amount of displacemement along the surface normal")
    }
) -> Geometry {
  "Vector Displacement" {
    object_info = ObjectInfo[RELATIVE](object: object_space, as_instance: true)
    switch = DomainSize[INSTANCES](object_info.geometry) != 0
      ? VectorRotate[EULER_XYZ](
        vector: displace_vector * object_info.scale,
        rotation: object_info.rotation)
      : displace_vector
  }
  "Surface Normal Displacement" {
    switch_2 = surface_normal
      ? (MenuSwitch(
            menu: surface_input_type,
            Object: ObjectInfo(object: surface_object).geometry,
            Geometry: Surface).output
          |> attachment_info().surface_normal)
        * surface_normal_distance
      : (0.0, 0.0, 0.0)
  }
  "Displacement Vector" {
    vector_math = (switch + switch_2)
      * shape_range(value: SplineParameter().factor, shape: Shape)
      * Factor
  }
  get_geometry_component = GetGeometryComponent(Geometry, type: Curve)
  "Optimization" {
    capture_attribute = CaptureAttribute[CURVE](
      get_geometry_component.component,
      Value: SplineResolution())
    set_spline_type = SetSplineType(capture_attribute.geometry)
  }
  set_position = SetPosition(set_spline_type, offset: vector_math)
  "Optimization" {
    set_spline_resolution = set_position
      |> SetSplineType[CATMULL_ROM]()
      |> SetSplineResolution(
        resolution: capture_attribute.value == 0 ? 12 : capture_attribute.value)
  }
  return get_geometry_component.geometry + set_spline_resolution
}
