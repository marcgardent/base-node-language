geometry graph ".Is Extra Bonds"() -> (
    "Is Extra Bonds": Bool,
    "Is Double Bond": Bool,
    "Is Triple Bond": Bool
) {
  named_attribute = NamedAttribute[INT](name: "bond_type")
  compare = named_attribute.attribute == 2
  compare_2 = named_attribute.attribute == 3
  return (
    "Is Extra Bonds": compare or compare_2 or named_attribute.attribute == 6,
    "Is Double Bond": compare,
    "Is Triple Bond": compare_2)
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph ".Sample Atomic Attributes to Face Corner"(
    Geometry: Geometry,
    "Sample Atoms": Geometry,
    Index: Int = Index()
) -> Geometry {
  repeat_output = repeat(9, Geometry: Geometry) -> {
    index_switch = IndexSwitch(
      iteration,
      "atomic_number",
      "atom_id",
      "atom_name",
      "res_id",
      "res_name",
      "chain_id",
      "entity_id",
      "sec_struct",
      "ures_id")
    return StoreNamedAttribute[INT, CORNER](
      Geometry,
      name: index_switch,
      value: SampleIndex[INT](
        sample_atoms,
        value: NamedAttribute[INT](name: index_switch).attribute,
        index: Index))
  }
  repeat_output_2 = repeat(3, Geometry: repeat_output) -> {
    index_switch_2 = IndexSwitch(iteration, "vdw_radii", "mass", "b_factor")
    return StoreNamedAttribute[CORNER](
      Geometry,
      name: index_switch_2,
      value: SampleIndex(
        sample_atoms,
        value: NamedAttribute(name: index_switch_2).attribute,
        index: Index))
  }
  repeat_output_3 = repeat(6, Geometry: repeat_output_2) -> {
    index_switch_3 = IndexSwitch(
      iteration,
      "is_alpha_carbon",
      "is_side_chain",
      "is_backbone",
      "is_solvent",
      "is_nucleic",
      "is_peptide")
    return StoreNamedAttribute[BOOLEAN, CORNER](
      Geometry,
      name: index_switch_3,
      value: SampleIndex[BOOLEAN](
        sample_atoms,
        value: NamedAttribute[BOOLEAN](name: index_switch_3).attribute,
        index: Index))
  }
  return StoreNamedAttribute[FLOAT_COLOR, CORNER](
    repeat_output_3,
    name: "Color",
    value: SampleIndex[FLOAT_COLOR](sample_atoms, value: Color(), index: Index))
}

geometry graph ".map_bond_type"() -> ("Bond Count": Int) {
  return (
    "Bond Count": IndexSwitch(
      NamedAttribute[INT](name: "bond_type").attribute,
      1,
      1,
      2,
      3,
      1,
      1,
      2))
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "MN Units"(
    Value: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (Angstrom: Float, Nanometre: Float) {
  math = Value * mn_world_scale()
  return (Angstrom: math, Nanometre: math * 10.0)
}

geometry(is_modifier: false) graph ".MN_utils_style_sticks"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Radius: Float(description: "Radius of the bond mesh.") = 0.3 in 0.0..1.0,
    Resolution: Int(description: "Resolution of the created bond cylinders.") = 6 in 3..512,
    "Scale Extra Bond Radius": Float = 0.65 in -10000.0..10000.0,
    "Extra Bond Offset": Float = 0.4 in -10000.0..10000.0,
    "Extra Bond Rotate": Float in -10000.0..10000.0,
    Menu: Menu(optional_label: true) = Single,
    "Material" {
        "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
        Material: Material(description: "Material to apply to the resulting geometry")
    }
) -> Geometry {
  separate_geometry = SeparateGeometry(Atoms, selection: Selection)
  "Offset Vector" {
    "Vector for Extra Bond Offsetting" {
      edge_vertices = EdgeVertices()
      edge_vertices_2 = EdgeVertices()
      vector_math = edge_vertices.position_1 - edge_vertices.position_2
      vector_math_2 = normalize(
          normalize(
              EvaluateAtIndex[EDGE, FLOAT_VECTOR](
                value: vector_math,
                index: EdgesOfVertex(vertex_index: edge_vertices_2.vertex_index_1).edge_index))
            × normalize(
              EvaluateAtIndex[EDGE, FLOAT_VECTOR](
                value: vector_math,
                index: EdgesOfVertex(
                  vertex_index: edge_vertices_2.vertex_index_2,
                  sort_index: 2).edge_index)))
        * mn_units(value: extra_bond_offset).angstrom
    }
    capture_attribute = CaptureAttribute[EDGE](separate_geometry.selection, Vector: vector_math_2)
  }
  split_edges = SplitEdges(capture_attribute.geometry)
  "Rotate and offset Extra Bonds" {
    group = map_bond_type()
    edge_vertices_3 = EdgeVertices()
    capture_attribute_2 = CaptureAttribute(split_edges, selection: group > 1)
    duplicate_elements = DuplicateElements[EDGE](capture_attribute_2.geometry, amount: group)
    set_position = SetPosition(
      duplicate_elements.geometry,
      selection: capture_attribute_2.selection,
      offset: VectorRotate(
          vector: capture_attribute.vector,
          axis: edge_vertices_3.position_1 - edge_vertices_3.position_2,
          angle: Math[MULTIPLY_ADD](
            Value: duplicate_elements.duplicate_index,
            Value_001: 6.2831855 / map_bond_type(),
            Value_002: 3.1415927 / 2.0 + extra_bond_rotate))
        * 1.0)
  }
  menu_switch = MenuSwitch(menu: Menu, Single: split_edges, Double: set_position)
  "Compute Radius" {
    capture_attribute_3 = CaptureAttribute[EDGE](
      menu_switch.output,
      Output: menu_switch.double and is_extra_bonds().is_extra_bonds
        ? scale_extra_bond_radius
        : 1.0)
  }
  set_curve_radius = capture_attribute_3.geometry
    |> MeshToCurve()
    |> SetCurveRadius(radius: capture_attribute_3.output)
  "Get correct index to sample from" {
    capture_attribute_4 = CaptureAttribute[CURVE](
      set_curve_radius,
      "First Point": PointsOfCurve().point_index,
      "Last Point": PointsOfCurve(sort_index: 1).point_index,
      "Curve Index": Index())
    switch = Resolution
        < AccumulateField[INT, FACE](group_id: capture_attribute_4.curve_index).leading
      ? capture_attribute_4.last_point
      : capture_attribute_4.first_point
  }
  "curve to mesh" {
    group_2 = capture_attribute_4.geometry
      |> SubdivideCurve()
      |> CurveToMesh(
        profile_curve: CurveCircle(resolution: Resolution, radius: mn_units(value: 1.0).angstrom),
        scale: Radius() * Radius)
      |> sample_atomic_attributes_to_face_corner(
        sample_atoms: capture_attribute_4.geometry,
        index: switch)
  }
  "Set up materials" {
    set_shade_smooth = group_2
      |> SetMaterial(material: Material)
      |> SetShadeSmooth(shade_smooth: shade_smooth)
  }
  return set_shade_smooth
}
