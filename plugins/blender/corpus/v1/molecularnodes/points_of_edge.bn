geometry graph "Edge Info"(
    "Vertex Index": Int(hide_value: true) = Index(),
    "Edge Index": Int(
      description: "Index within the gorup of edges that are connected to this point") in 0..3
) -> (
    "Is Valid": Bool(description: "Whether there is a valid edge corresponding to the given index"),
    "Point Index": Int(
      description: "The index for the other point involved in this edge, -1 if not connected"),
    "Point Position": Vector(
      description: "The position for the other point involved in this edge, (0, 0, 0) if not connected"),
    "Edge Index": Int(
      description: "The index on the edge domain for the selected edge. -1 if not connected"),
    "Edge Vector": Vector(
      subtype: EULER,
      description: "The vector along the selected edge. (0, 0, 0) if not connected"),
    "Edge Length": Float(description: "Length of the selected edge, -1 if not connected")
) {
  edge_vertices = EdgeVertices()
  edges_of_vertex = EdgesOfVertex(vertex_index: vertex_index, sort_index: edge_index)
  "Check edge exists, or return index -1 and (0, 0, 0) vector" {
    compare = edge_index < edges_of_vertex.total
  }
  math = EvaluateAtIndex[EDGE, INT](
      value: edge_vertices.vertex_index_1 + edge_vertices.vertex_index_2,
      index: edges_of_vertex.edge_index)
    - Index()
  position = Position()
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](value: position, index: math)
  vector_math = evaluate_at_index - position
  return (
    "Is Valid": compare,
    "Point Index": Switch[INT](switch: compare, false_: -1, true_: math),
    "Point Position": evaluate_at_index,
    "Edge Index": compare ? edges_of_vertex.edge_index : -1,
    "Edge Vector": compare ? vector_math : (0.0, 0.0, 0.0),
    "Edge Length": compare ? length(vector_math) : -1.0)
}

geometry graph "Points of Edge"(
    "Vertex Index": Int(hide_value: true) = Index(),
    "Edge Index": Int(
      description: "Index within the gorup of edges that are connected to this point") in 0..3
) -> (
    "0": Int(
      description: "Index for the 0th point, connected to the point at the end of the selected edge. Returns -1 if not connected or self"),
    "1": Int(
      description: "Index for the 1th point, connected to the point at the end of the selected edge. Returns -1 if not connected or self"),
    "2": Int(
      description: "Index for the 2th point, connected to the point at the end of the selected edge. Returns -1 if not connected or self"),
    "3": Int(
      description: "Index for the 3th point, connected to the point at the end of the selected edge. Returns -1 if not connected or self"),
    Total: Int(description: "Number of edges conncted to the connected point, including this edge")
) {
  group = edge_info(vertex_index: vertex_index, edge_index: edge_index)
  evaluate_at_index = EvaluateAtIndex[INT](
    value: edge_info(vertex_index: edge_index, edge_index: 3).point_index,
    index: group.point_index)
  evaluate_at_index_2 = EvaluateAtIndex[INT](
    value: edge_info(vertex_index: vertex_index).point_index,
    index: group.point_index)
  evaluate_at_index_3 = EvaluateAtIndex[INT](
    value: edge_info(vertex_index: vertex_index, edge_index: 1).point_index,
    index: group.point_index)
  evaluate_at_index_4 = EvaluateAtIndex[INT](
    value: edge_info(vertex_index: vertex_index, edge_index: 2).point_index,
    index: group.point_index)
  index = Index()
  "check if selecting self, return -1 if so" {
    switch = evaluate_at_index == index ? -1 : evaluate_at_index
    switch_2 = evaluate_at_index_2 == index ? -1 : evaluate_at_index_2
    switch_3 = evaluate_at_index_3 == index ? -1 : evaluate_at_index_3
    switch_4 = evaluate_at_index_4 == index ? -1 : evaluate_at_index_4
  }
  return (
    "0": switch_2,
    "1": switch_3,
    "2": switch_4,
    "3": switch,
    Total: EvaluateAtIndex[INT](value: EdgesOfVertex().total, index: group.point_index))
}
