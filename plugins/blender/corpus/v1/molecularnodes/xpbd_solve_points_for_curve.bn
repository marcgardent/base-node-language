geometry graph "Constraint Distance"(
    Target: Vector in -10000.0..10000.0,
    Self: Vector = Position() in -10000.0..10000.0,
    Distance: Float = 0.5 in -10000.0..10000.0,
    W1: Float = 0.5 in 0.0..10000.0,
    W2: Float = 0.5 in 0.0..10000.0,
    alpha: Float in -10000.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> (Correction: Vector, Value: Float) {
  vector_math = Target - Self
  vector_math_2 = length(vector_math)
  return (
    Correction: normalize(vector_math)
      * ((vector_math_2 - Distance) * (W1 / (W1 + W2 + alpha / (deltaT * deltaT)))),
    Value: vector_math_2)
}

geometry(is_modifier: false) graph "XPBD Solve Points for Curve"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Radius: Float,
    alpha: Float in -10000.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> Geometry {
  capture_attribute = CaptureAttribute(
    Geometry,
    Vector: Position() + RandomValue[FLOAT_VECTOR](min: (-1.0, -1.0, -1.0)) * 0.001)
  capture_attribute_2 = CaptureAttribute(
    capture_attribute.geometry,
    Index: IndexOfNearest(position: capture_attribute.vector).index)
  math = EvaluateAtIndex(value: Radius, index: capture_attribute_2.index) + Radius
  group = constraint_distance(
    target: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: capture_attribute_2.index),
    distance: math,
    w1: 1.0,
    w2: 1.0,
    alpha: alpha,
    deltat: deltaT)
  return SetPosition(
    capture_attribute_2.geometry,
    selection: Selection and math > group.value,
    offset: group.correction)
}
