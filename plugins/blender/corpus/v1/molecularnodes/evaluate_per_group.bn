geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry(is_modifier: false) graph "Evaluate Per Group"(
    Geometry: Geometry(description: "Geometry to split into two parts"),
    Closure: Closure,
    Group: Menu(menu_expanded: true, optional_label: true) = chain_id,
    "Group ID": Int(hide_value: true)
) -> (Geometry: Geometry, Instances: Geometry) {
  "Count number of chains" {
    menu_switch = MenuSwitch(menu: Group, chain_id: chain_id(), "Group ID": group_id)
    separate_geometry = SeparateGeometry(
      Geometry,
      selection: not AccumulateField[INT](group_id: menu_switch.output).trailing)
    domain_size = DomainSize(separate_geometry.selection)
  }
  repeat_output = repeat(
    domain_size.point_count,
    Geometry as Geometry_2: Geometry = _,
    Instances: Geometry = _) -> {
    sample_index = SampleIndex[INT](
      separate_geometry.selection,
      value: menu_switch.output,
      index: iteration)
    store_named_attribute = EvaluateClosure(
        Closure,
        Geometry: SeparateGeometry(
          Geometry,
          selection: sample_index == menu_switch.output).selection,
        group_id: sample_index) -> Geometry
      |> StoreNamedAttribute[INT](name: "group_id", value: iteration)
    return (
      Geometry_2: Geometry_2 + store_named_attribute,
      Instances: Instances + GeometryToInstance(store_named_attribute))
  }
  return (Geometry: repeat_output.Geometry_2, Instances: repeat_output.instances)
}
