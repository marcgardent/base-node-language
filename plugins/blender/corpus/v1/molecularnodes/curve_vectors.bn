geometry graph "Curve Vectors"() -> (
    Normal: Vector(
      description: "The normal of the control point. Used for calculating the rotation for the point and when calculating `Curve to Mesh`"),
    Tangent: Vector(
      description: "The tangent of the point, which is calculated as the direction from the previous point to the next point"),
    Bitangent: Vector(description: "The cross product of the Normal and the Tangent")
) {
  curve_tangent = CurveTangent()
  normal = Normal[legacy_corner_normals: true]()
  return (Normal: normal.normal, Tangent: curve_tangent, Bitangent: curve_tangent × normal.normal)
}
