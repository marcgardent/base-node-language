geometry graph "Between Integer"(
    Value: Int(description: "The value to test if it exists within the bounds"),
    Lower: Int(description: "The lower bounds for the test"),
    Upper: Int(description: "The upper bounds for the test") = 19
) -> (
    Boolean: Bool(
      description: "Whether the input `Value` is between (and including) the lower and upper bounds")
) {
  return (Boolean: Value >= Lower and Value <= Upper)
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph "Color Res Name"(
