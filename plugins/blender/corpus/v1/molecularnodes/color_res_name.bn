      PHE,
      PRO,
      SER,
      THR,
      TRP,
      TYR,
      VAL,
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      A,
      C,
      G,
      T,
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      rA,
      rC,
      rG,
      rU)
    : Color()
}
