        C: Color(description: "Set the color for the residue C") = (0.294582, 0.8, 0.187789),
        G: Color(description: "Set the color for the residue G") = (0.85, 0.2514024, 0.17788057),
        T: Color(description: "Set the color for the residue T") = (0.8, 0.269803, 0.526898),
        rA: Color(description: "Set the color for the residue rA") = (0.273778, 0.547823, 0.8),
        rC: Color(description: "Set the color for the residue rC") = (0.294582, 0.8, 0.187789),
