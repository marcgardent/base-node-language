geometry graph "Fractionate Float"(
    Menu: Menu(menu_expanded: true, optional_label: true) = Linear,
    Value: Float(description: "The value to fractionate")
) -> (
    Fraction: Float(description: "Fractional component of the value, between 0 and 1"),
    Floor: Int(description: "The floor of the value; the integer rounded down"),
    Ceiling: Int(description: "The ceiling of the value, the integer rounded up")
) {
  math = fract(Value)
  return (
    Fraction: MenuSwitch(
      menu: Menu,
      Linear: math,
      Smoother: MapRange[SMOOTHERSTEP](value: math)).output,
    Floor: FloatToInteger[FLOOR](float: Value),
    Ceiling: FloatToInteger[CEILING](float: Value))
}

geometry graph "Index Mix Rotation"(
    Rotation: Rotation(description: "The field to interpolate based on the input `Index`"),
    Index: Float(
      description: "The floor and ceiling of this Index value is taken and used for sampling, the fraction of this value is then used to mix between the sampled values")
) -> (
    Rotation: Rotation(
      description: "The mixed value of the field, first evaluating the field at the `From` and `To` Indices then mixing between them based on the fraction of the input `Index`"),
    From: Int(
      description: "The mixed value of the field, first evaluating the field at the `From` and `To` Indices then mixing between them based on the fraction of the input `Index`"),
    To: Int(
      description: "The mixed value of the field, first evaluating the field at the `From` and `To` Indices then mixing between them based on the fraction of the input `Index`")
) {
  group = fractionate_float(value: Index)
  return (
    Rotation: Mix[ROTATION](
      factor: group.fraction,
      a: EvaluateAtIndex[QUATERNION](value: Rotation, index: group.floor),
      b: EvaluateAtIndex[QUATERNION](value: Rotation, index: group.ceiling)),
    From: group.floor,
    To: group.ceiling)
}

geometry graph "Sample Mixed Rotation"(
    Geometry: Geometry(description: "The geometry to sample the values from"),
    Rotation: Rotation(
      description: "The field to mix and evaluate on the sample geometry",
      hide_value: true),
    Index: Float(
      description: "The index to sample the value from. The fractional component of the index is used to mix between values using `Index Mix ...` nodes")
) -> (
    Rotation: Rotation(
      description: "The evaluated and mixed field, sampled from the sample geometry at the given `Index`")
) {
  group = index_mix_rotation(rotation: Rotation, index: Index)
  return (
    Rotation: SampleIndex[QUATERNION, clamp: true](
      Geometry,
      value: group.rotation,
      index: group.from))
}
