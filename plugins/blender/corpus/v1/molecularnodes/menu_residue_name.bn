geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph "Menu Residue Name"(
    "Residue Name": Menu(optional_label: true) = ALA
) -> (res_name: Int, Selection: Bool) {
  menu_switch = MenuSwitch(
    menu: residue_name,
    UNK: -1,
    ALA: 0,
    ARG: 1,
    ASN: 2,
    ASP: 3,
    CYS: 4,
    GLU: 5,
    GLN: 6,
    GLY: 7,
    HIS: 8,
    ILE: 9,
    LEU: 10,
    LYS: 11,
    MET: 12,
    PHE: 13,
    PRO: 14,
    SER: 15,
    THR: 16,
    TRP: 17,
    TYR: 18,
    VAL: 19,
    SNC: 15,
    MSE: 12,
    ASH: 3,
    CYM: 4,
    CYX: 4,
    GLH: 5,
    HID: 8,
    HIE: 8,
    HIP: 8,
    HYP: 8,
    LYN: 11,
    DA: 30,
    DC: 31,
    DG: 32,
    DT: 33,
    PST: 33,
    rA: 40,
    rC: 41,
    rG: 42,
    rU: 43)
  return (res_name: menu_switch.output, Selection: menu_switch.output == residue_name())
}
