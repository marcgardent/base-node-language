geometry graph "DNA Sequence to ID"(
    String: String(optional_label: true)
) -> (Length: Int, res_id: Int(description: "Output list with evaluated field values")) {
  special_characters = SpecialCharacters()
  string = " "
  trim_string = TrimString(
    string: TrimString(
      string: ReplaceString(
        string: ReplaceString(
          string: ReplaceString(string: SetStringCase(string: String), find: string),
          find: special_characters.line_break),
        find: special_characters.tab)))
  replace_string = ReplaceString(
    string: ReplaceString(
      string: ReplaceString(string: ReplaceString(string: trim_string, find: "A"), find: "C"),
      find: "G"),
    find: "T")
  string_2 = "Non-standard base letters detected: {s}"
  slice_string = SliceString(string: trim_string, position: Index(), length: 1)
  warning = Warning[WARNING](
    show: StringLength(string: replace_string) > 0,
    message: FormatString(format: string_2, s: replace_string))
  return (
    Length: StringLength(string: trim_string),
    res_id: slice_string == "T"
      ? 3
      : slice_string == "G" ? 2 : slice_string == "C" ? 1 : slice_string == "A" ? 0 : -1)
}
