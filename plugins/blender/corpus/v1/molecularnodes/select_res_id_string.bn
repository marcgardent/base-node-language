geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Select Res ID String"(String: String(optional_label: true)) -> (Selection: Bool) {
  closure_output = graph(String: String) -> (Selection: Bool) {
    return StringToValue[INT](string: String).value == residue_id()
  }
  group = residue_id()
  string = "-"
  closure_output_2 = graph(String: String) -> (Selection: Bool) {
    trim_string_2 = TrimString(string: SplitString(string: String, separator: string))
    return group >= StringToValue[INT](string: GetListItem[STRING](list: trim_string_2)).value
      and group
        <= StringToValue[INT](string: GetListItem[STRING](list: trim_string_2, index: 1)).value
  }
  trim_string = TrimString(string: SplitString(string: String, separator: ","))
  repeat_output = repeat(ListLength[STRING](list: trim_string), Boolean: false) -> {
    get_list_item = GetListItem[STRING](list: trim_string, index: iteration)
    return Boolean
      or EvaluateClosure(
        MatchString(string: get_list_item, operation: Contains, key: string)
          ? closure_output_2
          : closure_output,
        String: get_list_item) -> (Selection: Bool)
  }
  return (Selection: repeat_output)
}
