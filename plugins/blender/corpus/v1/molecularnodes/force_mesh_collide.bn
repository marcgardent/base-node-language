geometry graph "Force Mesh Collide"(
    Add: Vector(hide_value: true) in -10000.0..10000.0,
    Geometry: Geometry,
    "Geometry Bounds": Menu(optional_label: true) = Original,
    "Collision Distance": Float = 0.1 in -10000.0..10000.0
) -> (Force: Vector) {
  menu_switch = MenuSwitch(
    menu: geometry_bounds,
    Original: Geometry,
    "Convex Hull": ConvexHull(Geometry))
  geometry_proximity = GeometryProximity(menu_switch.output)
  vector_math = Position() - geometry_proximity.position
  vector_math_2 = normalize(vector_math)
  return (
    Force: Add
      + vector_math_2
        * (Raycast[FLOAT_VECTOR](menu_switch.output, ray_direction: -vector_math).hit_normal
              ⋅ vector_math_2
            > -0.1
          ? MapRange(
            value: geometry_proximity.distance,
            from_max: collision_distance,
            to_min: 1.0,
            to_max: 0.0)
          : -1.0))
}
