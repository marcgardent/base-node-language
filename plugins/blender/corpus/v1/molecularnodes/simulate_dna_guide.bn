geometry graph "Object Effector"(Object: Object(optional_label: true)) -> (Effector: Bundle) {
  return (
    Effector: GetBundleItem[BUNDLE](
      bundle: ObjectInfo(object: Object).geometry |> GetGeometryBundle().bundle,
      path: "effectors").item)
}

geometry graph "Collection Effector"(
    Collection: Collection(optional_label: true),
    "Naming"(default_closed: true) {
        "Name Pattern": String(optional_label: true) = "effector_{}"
    }
) -> (Effectors: Bundle) {
  collection_children = CollectionChildren(collection: Collection, recursive: true)
  repeat_output = repeat(ListLength[OBJECT](list: collection_children.objects), Bundle: Bundle) -> {
    return StoreBundleItem[BUNDLE](
      bundle: Bundle,
      path: FormatString(format: name_pattern, i: iteration),
      item: object_effector(
        object: GetListItem[OBJECT](list: collection_children.objects, index: iteration)))
  }
  return (Effectors: repeat_output)
}

geometry graph "Set Effector"(
    Geometry: Geometry(
      description: "Geometry to add the effector to.",
      force_non_field: true,
      structure_type: SINGLE),
    Effector: Bundle(
      description: "The actual bundle containing one more multiple effectors.",
      force_non_field: true,
      structure_type: SINGLE),
    Name: String(
      description: "Name of the effector in the geometry bundle.",
      force_non_field: true,
      optional_label: true,
      structure_type: SINGLE)
) -> (
    Geometry: Geometry(description: "The same geometry but with additional effector information.")
) {
  "Add effector information to the geometry bundle."
  get_geometry_bundle = GetGeometryBundle(Geometry, remove: true)
  string = "effectors"
  return (
    Geometry: SetGeometryBundle(
      get_geometry_bundle.geometry,
      bundle: StoreBundleItem[BUNDLE](
        bundle: get_geometry_bundle.bundle,
        path: JoinStrings("/", string, Name == "" ? "default" : Name),
        item: Effector)))
}

geometry graph "Softness to Compliance"(
    Softness: Float(subtype: FACTOR) in 0.0..1.0
) -> (Compliance: Float) {
  return (Compliance: pow(max(Softness, 0.0), 5.0))
}

geometry(is_modifier: true, show_modifier_manage_panel: false) graph Collider(
    Geometry: Geometry(
      description: "The collider geometry.",
      force_non_field: true,
      structure_type: SINGLE),
    Deforming: Bool(
      description: "Whether the collider geometry is changing.",
      force_non_field: true,
      structure_type: SINGLE),
    Boundary: Bool(
      description: "If true, the simulated geometry should stay within the mesh instead of it being pushed out of it.",
      force_non_field: true,
      structure_type: SINGLE),
    "Edge Contacts": Bool(
      description: "Increased collision accuracy (only for collisions with curves/hair currently).",
      force_non_field: true,
      structure_type: SINGLE),
    Margin: Float(
      subtype: DISTANCE,
      description: "Additional margin around the collider to prevent penetration.",
      force_non_field: true,
      structure_type: SINGLE) in 0.0..,
    Friction: Float(
      subtype: FACTOR,
      description: "Friction coefficient for this collider.",
      force_non_field: true,
      structure_type: SINGLE) = 0.2 in 0.0..1.0,
    Softness: Float(
      subtype: FACTOR,
      description: "Increasing softness allows some penetration.",
      force_non_field: true,
      structure_type: SINGLE) in 0.0..1.0,
    "Filter"(description: "Filter settings.", default_closed: true) {
        Filter: String(
          description: "Comma-separated list of tags this collider should apply to.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE)
    },
    "Debug"(description: "Debug settings.", default_closed: true) {
        "Error Threshold": Float(
          subtype: DISTANCE,
          description: "Used to compute a relative error of this constraint to determine solve quality.",
          force_non_field: true,
          structure_type: SINGLE) = 0.001 in 1e-05..
    }
) -> (
    Geometry: Geometry(
      description: "The input geometry with additional collider information attached."),
    Collider: Bundle(
      description: "The collider effector bundle that can be passed into a simulation.")
) {
  "Turn a geometry into a collider."
  "Prepare collider geometry" {
    string = "By convention, collider geometries are always in world space."
    transform_geometry = GeometryToInstance(Geometry)
      |> TransformGeometry(mode: Matrix, transform: ObjectInfo(object: SelfObject()).transform)
  }
  combine_bundle = CombineBundle(
    Type: "Blender.Collider.Mesh",
    filter: Filter,
    geometry: transform_geometry,
    margin: Margin,
    friction: Friction,
    compliance: softness_to_compliance(softness: Softness),
    deforming: Deforming,
    use_edge_contacts: edge_contacts,
    is_boundary: Boundary,
    error_threshold: error_threshold)
  return (
    Geometry: set_effector(Geometry, effector: combine_bundle, name: "collider"),
    Collider: combine_bundle)
}

geometry graph "Custom/World/Object Space"(
    Space: Menu(optional_label: true) = "Custom Space"
) -> (
    "Custom = 0,World = 1, Object = 2": Int,
    "Is Custom Space": Bool(description: "True if this item is chosen by the menu input"),
    "Is World Space": Bool(description: "True if this item is chosen by the menu input"),
    "Is Object Space": Bool(description: "True if this item is chosen by the menu input")
) {
  menu_switch = MenuSwitch(
    menu: Space,
    "Custom Space"(description: "Use a user-defined space."): 0,
    "World Space"(description: "Use world-space coordinates."): 1,
    "Object Space"(description: "Use the coordinates in object space of the provided object."): 2)
  return (
    "Custom = 0,World = 1, Object = 2": menu_switch.output,
    "Is Custom Space": menu_switch.custom_space,
    "Is World Space": menu_switch.world_space,
    "Is Object Space": menu_switch.object_space)
}

geometry graph "Convert Space Transform"(
    "From Space": Menu(optional_label: true) = "World Space",
    "From Object": Object(optional_label: true),
    "To Space": Menu(optional_label: true) = "World Space",
    "To Object": Object(optional_label: true),
    "Custom to World": Matrix
) -> (
    Transform: Matrix,
    Inverted: Matrix(
      description: "The inverted matrix or the identity matrix if the input is not invertible")
) {
  "\"From\" to world space" {
    index_switch = IndexSwitch(
      custom_world_object_space(space: from_space).custom_0_world_1_object_2,
      custom_to_world,
      _,
      ObjectInfo(object: from_object).transform)
  }
  "World to \"To\" space" {
    index_switch_2 = IndexSwitch(
      custom_world_object_space(space: to_space).custom_0_world_1_object_2,
      InvertMatrix(matrix: custom_to_world).matrix,
      _,
      InvertMatrix(matrix: ObjectInfo(object: to_object).transform).matrix)
  }
  multiply_matrices = MultiplyMatrices(Matrix: index_switch_2, Matrix_001: index_switch)
  return (Transform: multiply_matrices, Inverted: InvertMatrix(matrix: multiply_matrices).matrix)
}

