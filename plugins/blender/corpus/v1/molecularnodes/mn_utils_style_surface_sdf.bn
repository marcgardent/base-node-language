geometry graph ".MN_constants_atom_name_nucleic"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Side Chain Joint Carbon": Int
) {
  integer = 61
  integer_2 = 77
  integer_3 = 50
  integer_4 = 61
  integer_5 = 54
  return (
    "Backbone Lower": integer_3,
    "Backbone Upper": integer_4,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Side Chain Joint Carbon": integer_5)
}

geometry graph ".MN_surface_smooth_bumps"(Geometry: Geometry) -> Geometry {
  "Smoothen out weird bumps from meshing" {
    edge_vertices = EdgeVertices()
    compare = VertexNeighbors().vertex_count == 3
    face_group_boundaries = FaceGroupBoundaries(
      face_group_id: EdgesToFaceGroups(
        boundary_edges: EvaluateAtIndex[BOOLEAN](
            value: compare,
            index: edge_vertices.vertex_index_1)
          and EvaluateAtIndex[BOOLEAN](value: compare, index: edge_vertices.vertex_index_2)))
  }
  return SetPosition(
    Geometry,
    selection: face_group_boundaries,
    position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: 4))
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "VDW Radii"(
    Index: Int = Index() in 0..
) -> (vdw_radii: Float(description: "Read the `vdw_radii` attribute from the geometry")) {
  return (
    vdw_radii: EvaluateAtIndex(
      value: fallback_float(name: "vdw_radii", fallback: mn_world_scale()),
      index: Index))
}

geometry graph ".surface_compute_density_from_points"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    "Scale Radius": Float = 1.0 in -10000.0..10000.0,
    "Probe Size": Float in 0.0..10000.0
) -> (Result: Bool, Distance: Float) {
  position = Position()
  sample_nearest = SampleNearest(Atoms)
  math = probe_size
    + SampleIndex(Atoms, value: vdw_radii() * scale_radius, index: sample_nearest)
    - distance(SampleIndex[FLOAT_VECTOR](Atoms, value: position, index: sample_nearest), position)
  return (Result: math > 0.0, Distance: math)
}

geometry graph ".utils_bounding_box"(
    Geometry: Geometry,
    Subdivisions: Float = 16.7 in -10000.0..10000.0
) -> (Min: Vector, Max: Vector, X: Int, Y: Int, Z: Int) {
  group = mn_world_scale()
  bounding_box = BoundingBox(Geometry)
  math = group * 2.0
  vector_math = VectorMath[SNAP](Vector: bounding_box.min, Vector_001: group) - math
  vector_math_2 = VectorMath[SNAP](Vector: bounding_box.max, Vector_001: group) + math
  vector_math_3 = (vector_math_2 - vector_math) * Subdivisions
  return (
    Min: vector_math,
    Max: vector_math_2,
    X: max(vector_math_3.x, 2.0),
    Y: max(vector_math_3.y, 2.0),
    Z: max(vector_math_3.z, 2.0))
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph ".MN_constants_atom_name_peptide"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Alpha Carbon": Int
) {
  integer = 5
  integer_2 = 49
  integer_3 = 4
  integer_4 = 1
  integer_5 = 2
  return (
    "Backbone Lower": integer_4,
    "Backbone Upper": integer_3,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Alpha Carbon": integer_5)
}

geometry graph ".MN_select_peptide"() -> (
    "Is Backbone": Bool,
    "Is Side Chain": Bool,
    "Is Peptide": Bool,
    "Is Alpha Carbon": Bool
) {
  group = mn_constants_atom_name_peptide()
  group_2 = atom_name()
  compare = group_2 == group.alpha_carbon
  return (
    "Is Backbone": group_2 >= group.backbone_lower and group_2 <= group.backbone_upper,
    "Is Side Chain": group_2 >= group.side_chain_lower and group_2 <= group.side_chain_upper
      or compare,
    "Is Peptide": group_2 >= group.backbone_lower and group_2 <= group.side_chain_upper,
    "Is Alpha Carbon": compare)
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Alpha Carbon"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(
      name: "is_alpha_carbon",
      fallback: mn_select_peptide().is_alpha_carbon))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Set Color"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Color: Color(
      description: "Color to apply to the selected atoms") = (0.161517, 0.623961, 0.195602)
) -> (Atoms: Geometry(description: "Atomic geometry with an updated `Color` attribute")) {
  return (
    Atoms: StoreNamedAttribute[FLOAT_COLOR](
      Atoms,
      selection: Selection,
      name: "Color",
      value: Color))
}

geometry(is_modifier: false) graph ".MN_utils_style_surface_sdf"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Quality: Int = 12 in 1..15,
    "Scale Radii": Float = 1.0 in 0.0..10.0,
    "Probe Size": Float = 0.6 in 0.0..10000.0,
    "Color Source": Menu(optional_label: true) = "Alpha Carbon",
    "Color Blur": Int(
      description: "Interpolate between colors when enabled. When disabled the faces will take their color from their corresponding atom without interpolating") = 1 in 0..20,
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    "Relaxation Steps": Int = 30 in 0..
) -> ("Surface Geometry": Geometry) {
  separate_geometry = SeparateGeometry(Atoms, selection: Selection)
  group = surface_compute_density_from_points(
    separate_geometry.selection,
    scale_radius: scale_radii,
    probe_size: probe_size)
  group_2 = utils_bounding_box(separate_geometry.selection, subdivisions: Quality * 5.0)
  separate_geometry_2 = SeparateGeometry(
    separate_geometry.selection,
    selection: is_alpha_carbon().selection
      or mn_constants_atom_name_nucleic().side_chain_joint_carbon == atom_name())
  menu_switch = MenuSwitch(
    menu: color_source,
    "Alpha Carbon": DomainSize(separate_geometry_2.selection).point_count == 0
      ? separate_geometry_2.inverted
      : separate_geometry_2.selection,
    Nearest: separate_geometry.selection)
  "Generate Surface from Measurements" {
    volume_to_mesh = VolumeCube(
        density: group.result,
        min: group_2.min,
        max: group_2.max,
        resolution_x: group_2.x,
        resolution_y: group_2.y,
        resolution_z: group_2.z)
      |> VolumeToMesh(voxel_size: 0.01)
  }
  "Pull in surface towards atoms" {
    position = Position()
    capture_attribute = CaptureAttribute(
      volume_to_mesh,
      Value: SampleNearest(separate_geometry.selection))
    sample_index = SampleIndex[FLOAT_VECTOR](
      separate_geometry.selection,
      value: position,
      index: capture_attribute.value)
    set_position = SetPosition(
      capture_attribute.geometry,
      position: sample_index
        + normalize(position - sample_index)
          * SampleIndex(
            separate_geometry.selection,
            value: scale_radii * vdw_radii(),
            index: capture_attribute.value))
  }
  "smoothing of tightened surface" {
    position_2 = Position()
    capture_attribute_2 = CaptureAttribute(set_position, Value: position_2)
    group_3 = capture_attribute_2.geometry
      |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: position_2, iterations: 2))
      |> SetPosition(
        offset: Normal[legacy_corner_normals: true]().normal
          * (distance(capture_attribute_2.value, position_2) * -1.8))
      |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: 2))
      |> SetPosition(
        position: BlurAttribute[FLOAT_VECTOR](
          value: Position(),
          iterations: relaxation_steps,
          weight: BlurAttribute(
            value: EvaluateOnDomain[FACE](
              value: MapRange(value: EdgeAngle().signed_angle, from_min: -0.2, from_max: -1.0)),
            iterations: 2)))
      |> mn_surface_smooth_bumps()
  }
  triangulate = Triangulate(group_3, quad_method: Beauty)
  "Sample colors of nearest atom" {
    group_4 = set_color(
      triangulate,
      color: BlurAttribute[FLOAT_COLOR](
        value: SampleIndex[FLOAT_COLOR](
          menu_switch.output,
          value: Color(),
          index: SampleNearest(menu_switch.output)),
        iterations: color_blur))
  }
  return (
    "Surface Geometry": group_4
      |> SetShadeSmooth(shade_smooth: shade_smooth)
      |> SetMaterial(material: Material))
}
