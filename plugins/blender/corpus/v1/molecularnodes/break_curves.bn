geometry graph "Edge Length"() -> (Length: Float) {
  edge_vertices = EdgeVertices()
  return (
    Length: EvaluateOnDomain[EDGE](
      value: distance(edge_vertices.position_1, edge_vertices.position_2)))
}

geometry(is_modifier: false) graph "Break Curves"(
    Curves: Geometry(description: "Geometry to delete elements from"),
    Threshold: Float = 0.5
) -> (
    Curves: Geometry,
    "Original Index": Int(description: "Index of Spline before segments removed")
) {
  capture_attribute = CaptureAttribute[CURVE](Curves, Index: Index())
  return (
    Curves: capture_attribute.geometry
      |> CurveToMesh()
      |> DeleteGeometry[EDGE](selection: edge_length() > Threshold)
      |> MeshToCurve(),
    "Original Index": capture_attribute.index)
}
