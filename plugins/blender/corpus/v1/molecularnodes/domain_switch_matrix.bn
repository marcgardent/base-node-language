geometry graph "Domain Switch Matrix"(
    Menu: Menu(optional_label: true) = Point,
    Point: Matrix,
    Edge: Matrix,
    Face: Matrix,
    "Face Corner": Matrix,
    Spline: Matrix,
    Instance: Matrix
) -> (Output: Matrix) {
  return (
    Output: MenuSwitch(
      menu: Menu,
      Point: Point,
      Edge: Edge,
      Face: Face,
      "Face Corner": face_corner,
      Spline: Spline,
      Instance: Instance).output)
}
