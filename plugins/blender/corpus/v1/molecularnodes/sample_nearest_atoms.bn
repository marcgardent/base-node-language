geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atomic Number"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atomic_number: Int(
      description: "Read the `atomic_number` attribute from the geometry corresponding to elements")
) {
  return (atomic_number: attribute_at_index(index: Index, name: "atomic_number"))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph "Sample Nearest Atoms"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (
    Color: Color,
    b_factor: Float,
    atomic_number: Int,
    chain_id: Int,
    res_id: Int,
    res_name: Int
) {
  sample_nearest = SampleNearest(Atoms)
  return (
    Color: SampleIndex[FLOAT_COLOR](Atoms, value: Color(), index: sample_nearest),
    b_factor: SampleIndex(
      Atoms,
      value: NamedAttribute(name: "b_factor").attribute,
      index: sample_nearest),
    atomic_number: SampleIndex[INT](Atoms, value: atomic_number(), index: sample_nearest),
    chain_id: SampleIndex[INT](Atoms, value: chain_id(), index: sample_nearest),
    res_id: SampleIndex[INT](Atoms, value: residue_id(), index: sample_nearest),
    res_name: SampleIndex[INT](Atoms, value: residue_name(), index: sample_nearest))
}
