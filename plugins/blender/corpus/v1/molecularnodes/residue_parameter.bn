geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph "Index to Factor"(
    Index: Int(description: "The index starting at 0 within the overall group of size `Size`"),
    Size: Int(description: "The size of the group that will be used to compute the factor.")
) -> (Factor: Float(subtype: FACTOR)) {
  return (
    Factor: MapRange(value: Index, from_max: IntegerMath[SUBTRACT](Value: Size, Value_001: 1)))
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Group Info"(
    "Group ID": Int(hide_value: true)
) -> (Size: Int, "Index in Group": Int, "Index of First": Int, "Index of Last": Int) {
  index = Index()
  integer = 1
  accumulate_field = AccumulateField[INT](value: integer, group_id: group_id)
  return (
    Size: accumulate_field.total,
    "Index in Group": accumulate_field.trailing,
    "Index of First": AccumulateField[INT](
      value: accumulate_field.trailing == 0 ? index : 0,
      group_id: group_id).total,
    "Index of Last": AccumulateField[INT](
      value: accumulate_field.leading == accumulate_field.total ? index : 0,
      group_id: group_id).total)
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Sub Group Info"(
    "Sub Group ID": Int(hide_value: true),
    "Group ID": Int(hide_value: true)
) -> (
    Size: Int(description: "Size of each comptued `Group ID`"),
    "Group ID": Int(
      description: "A unique `Group ID` that increases whenever `Sub Group ID` or `Group ID` change"),
    "Index of First": Int(
      description: "The absolute `Index` of the _first_ point in each computed `Group ID`"),
    "Index of Last": Int(
      description: "The absolute `Index` of the _last_ point in each computed `Group ID`"),
    "Index in Group ID": Int(description: "Index within each computed `Group ID`, starting at 0"),
    "Sub Group ID": Int,
    "Sub Group Total": Int
) {
  group = integer_run(value: sub_group_id, group_id: group_id)
  group_2 = group_info(group_id: group.group_id)
  accumulate_field = AccumulateField[INT](
    value: group.group_id != offset_integer(integer: group.group_id, offset: 1),
    group_id: group_id)
  return (
    Size: group_2.size,
    "Group ID": group.group_id,
    "Index of First": group_2.index_of_first,
    "Index of Last": group_2.index_of_last,
    "Index in Group ID": group_2.index_in_group,
    "Sub Group ID": accumulate_field.trailing,
    "Sub Group Total": accumulate_field.total)
}

geometry graph "Residue Parameter"() -> (
    Factor: Float(
      subtype: FACTOR,
      description: "An atom's relative position in a residue, with the first atom being 0 and the last atom being 1"),
    "Atom Count": Int(description: "Number of  atoms in a residue"),
    "Atom Index": Int(description: "Index of an atom in a residue when counting from 0"),
    "First atom_name": Int(description: "the atom_name for the first atom in a residue"),
    "Last atom_name": Int(description: "The atom_name for the last atom in a residue"),
    "Index of First": Int(
      description: "Index (in the whole structure) for the first atom in a  residue"),
    "Index of Last": Int(
      description: "Index (in the whole structure) for the last atom in a  residue")
) {
  group = sub_group_info(sub_group_id: residue_id(), group_id: chain_id())
  return (
    Factor: index_to_factor(index: group.index_in_group_id, size: group.size),
    "Atom Count": group.size,
    "Atom Index": group.index_in_group_id,
    "First atom_name": atom_name(index: group.index_of_first),
    "Last atom_name": atom_name(index: group.index_of_last),
    "Index of First": group.index_of_first,
    "Index of Last": group.index_of_last)
}
