geometry graph "Animate Collection Pick"(
    Collection: Collection(optional_label: true),
    "Realize Instances": Bool = true,
    Item: Float = 1.0 in 0.0..10000.0
) -> (Current: Geometry, Next: Geometry) {
  "Pick items from a collection based on the index given. The current and next items in the collection are given for interpolation"
  collection_info = CollectionInfo[RELATIVE](collection: Collection, separate_children: true)
  float_to_integer = FloatToInteger[FLOOR](float: Item)
  integer_math = IntegerMath[SUBTRACT](Value: DomainSize[INSTANCES](collection_info), Value_001: 1)
  return (
    Current: collection_info
      |> SeparateGeometry[INSTANCE](
        selection: Index()
          == IntegerMath[MINIMUM](Value: float_to_integer, Value_001: integer_math)).selection
      |> RealizeInstances[realize_to_point_domain: true](realize_all: realize_instances),
    Next: collection_info
      |> SeparateGeometry[INSTANCE](
        selection: IntegerMath[MINIMUM](
            Value: IntegerMath[ADD](Value: float_to_integer, Value_001: 1),
            Value_001: integer_math)
          == Index()).selection
      |> RealizeInstances[realize_to_point_domain: true](realize_all: realize_instances))
}

geometry graph "Animate Fraction"(Interpolate: Bool, "Smoother Step": Bool, Float: Float) -> Float {
  "Interpolate the fraction component of a float"
  math = fract(Float)
  return Interpolate ? (smoother_step ? MapRange[SMOOTHERSTEP](value: math) : math) : floor(Float)
}

geometry graph "Sample Mix Float"(
    A: Geometry(description: "Geometry A to sample and mix from"),
    B: Geometry(description: "Geometry B to sample and mix to"),
    Value: Float(description: "Float field to sample and mix", hide_value: true),
    Factor: Float(subtype: FACTOR, description: "Amount to mix from A to B") = 0.5 in 0.0..1.0,
    Index: Int(description: "`Index` on the geometries to sample from") = Index()
) -> (Value: Float(description: "The final mixed float")) {
  "Sample a float value from two different geometries and mix from A to B"
  sample_index = SampleIndex(A, value: Value, index: Index)
  sample_index_2 = SampleIndex(B, value: Value, index: Index)
  vector = (0.0, 0.0, 1.0)
  rotation_to_axis_angle = RotationToAxisAngle(
    rotation: Mix[ROTATION](
      factor: Factor,
      a: AxisAngleToRotation(axis: vector, angle: sample_index),
      b: AxisAngleToRotation(axis: vector, angle: sample_index_2)))
  return (Value: Mix(factor: Factor, a: sample_index, b: sample_index_2))
}

geometry graph "Sample Mix Vector"(
    A: Geometry(description: "Geometry A to sample and mix from"),
    B: Geometry(description: "Geometry B to sample and mix to"),
    Position: Vector(
      description: "The field to sample from each geometry, defaulting to `Position`",
      hide_value: true) = Position(),
    Factor: Float(subtype: FACTOR, description: "The amount to mix from A to B") = 0.5 in 0.0..1.0,
    Index: Int(description: "`Index` on the geometries to sample from") = Index()
) -> (Vector: Vector(description: "The final mixed vector")) {
  return (
    Vector: Mix[VECTOR](
      factor: Factor,
      a: SampleIndex[FLOAT_VECTOR](A, value: Position, index: Index),
      b: SampleIndex[FLOAT_VECTOR](B, value: Position, index: Index)))
}

geometry graph "Sample Position"(
    Geometry: Geometry(description: "The geometry to sample the `Position` from"),
    Position: Vector(
      description: "The `Position` field to sample the values from",
      hide_value: true) = Position(),
    Index: Int(description: "The `Index` at which to sample the `Position` field from") = Index()
) -> (Position: Vector(description: "The sampled `Position` field")) {
  "A convenience wrapper around the `Sample Index` and `Position` nodes"
  return (Position: SampleIndex[FLOAT_VECTOR, clamp: true](Geometry, value: Position, index: Index))
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry(is_modifier: false) graph "Animate Frames"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Frames: Collection(
      description: "Collection which holds the frames of the trajectory",
      optional_label: true),
    "Smoother Step": Bool(description: "Ease in and out of the individual frames if interpolating"),
    Interpolate: Bool(
      description: "Whether to interpolate between frames of a trajectory or snap") = true,
    Frame: Float(
      description: "Which frame to select from the collection. The fraction component of the float is how much to interpolate between the current and next frame") in 0.0..10000.0
) -> (
    Atoms: Geometry(description: "Atomic geometry with new positions based on the trajectory"),
    "All Frames": Geometry(
      description: "Each frame from the collection of coordinates is output in the a single mesh. They now contain an additional attribute `frame_id` to specify which structure they are from")
) {
  "Interpolation position based on frames from collection" {
    group = animate_collection_pick(collection: Frames, item: Frame)
    group_2 = animate_fraction(interpolate: Interpolate, smoother_step: smoother_step, float: Frame)
    store_named_attribute = Atoms
      |> SetPosition(
        selection: Selection,
        position: sample_mix_vector(group.current, b: group.next, factor: group_2))
      |> StoreNamedAttribute(
        name: "b_factor",
        value: sample_mix_float(
          group.current,
          b: group.next,
          value: NamedAttribute(name: "b_factor").attribute,
          factor: group_2))
  }
  "Have to copy original structure as frames only contain position" {
    collection_info = CollectionInfo(collection: Frames, separate_children: true)
    duplicate_elements = GeometryToInstance(Atoms)
      |> DuplicateElements[INSTANCE](amount: DomainSize[INSTANCES](collection_info))
    group_3 = duplicate_elements.geometry
      |> RealizeInstances[realize_to_point_domain: true]()
      |> StoreNamedAttribute[INT](name: "frame_id", value: duplicate_elements.duplicate_index)
      |> SetPosition(
        position: collection_info
          |> RealizeInstances[realize_to_point_domain: true]()
          |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index()))
      |> set_ures_id()
  }
  group_4 = sample_position()
  "Set Transform to align with structure" {
    object_info = ObjectInfo(object: SelfObject())
    transform_geometry = TransformGeometry(group_3, mode: Matrix, transform: object_info.transform)
    transform_geometry_2 = TransformGeometry(
      store_named_attribute,
      mode: Matrix,
      transform: object_info.transform)
  }
  return (Atoms: transform_geometry_2, "All Frames": transform_geometry)
}
