geometry graph "Set Instancer"(
    Geometry: Geometry(description: "Atomic geometry that contains vertices and edges"),
    is_instanced: Bool = true
) -> Geometry {
  return StoreNamedAttribute[BOOLEAN](Geometry, name: "is_instanced", value: is_instanced)
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "VDW Radii"(
    Index: Int = Index() in 0..
) -> (vdw_radii: Float(description: "Read the `vdw_radii` attribute from the geometry")) {
  return (
    vdw_radii: EvaluateAtIndex(
      value: fallback_float(name: "vdw_radii", fallback: mn_world_scale()),
      index: Index))
}

geometry(is_modifier: false) graph ".MN_utils_style_spheres_icosphere"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Scale: Float(description: "Scale the VDW radii of the atoms.") = 0.8 in 0.0..10000.0,
    Subdivisions: Int = 2 in 0..5,
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry")
) -> (Instances: Geometry) {
  return (
    Instances: Atoms
      |> set_instancer()
      |> InstanceOnPoints(
        selection: Selection,
        instance: Subdivisions
          ? IcoSphere(subdivisions: Subdivisions).mesh
          : Cube().mesh |> TransformGeometry(rotation: (0.7853982, 0.7853982, 0.7853982)),
        scale: vdw_radii() * Scale)
      |> SetShadeSmooth(shade_smooth: shade_smooth)
      |> SetMaterial(material: Material))
}
