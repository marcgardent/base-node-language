geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph ".MN_select_res_name_peptide"(
    ALA: Bool(description: "Select the AA residue ALA"),
    ARG: Bool(description: "Select the AA residue ARG"),
    ASN: Bool(description: "Select the AA residue ASN"),
    ASP: Bool(description: "Select the AA residue ASP"),
    CYS: Bool(description: "Select the AA residue CYS"),
    GLU: Bool(description: "Select the AA residue GLU"),
    GLN: Bool(description: "Select the AA residue GLN"),
    GLY: Bool(description: "Select the AA residue GLY"),
    HIS: Bool(description: "Select the AA residue HIS"),
    ILE: Bool(description: "Select the AA residue ILE"),
    LEU: Bool(description: "Select the AA residue LEU"),
    LYS: Bool(description: "Select the AA residue LYS"),
    MET: Bool(description: "Select the AA residue MET"),
    PHE: Bool(description: "Select the AA residue PHE"),
    PRO: Bool(description: "Select the AA residue PRO"),
    SER: Bool(description: "Select the AA residue SER"),
    THR: Bool(description: "Select the AA residue THR"),
    TRP: Bool(description: "Select the AA residue TRP"),
    TYR: Bool(description: "Select the AA residue TYR"),
    VAL: Bool(description: "Select the AA residue VAL")
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  index_switch = IndexSwitch(
    residue_name(),
    ALA,
    ARG,
    ASN,
    ASP,
    CYS,
    GLU,
    GLN,
    GLY,
    HIS,
    ILE,
    LEU,
    LYS,
    MET,
    PHE,
    PRO,
    SER,
    THR,
    TRP,
    TYR,
    VAL)
  return (Selection: index_switch, Inverted: not index_switch)
}
