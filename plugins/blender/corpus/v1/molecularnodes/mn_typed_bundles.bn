geometry graph "MN Typed Bundles"(
    Type: Menu(optional_label: true) = "MN.MeshProcess",
    Closure: Closure,
    step: Int = 1,
    Path: String(optional_label: true)
) -> Bundle {
  return StoreBundleItem[BUNDLE](
    path: Path,
    item: CombineBundle(
      Type: MenuSwitch(menu: Type, "MN.MeshProcess": "MN.MeshProcess").output,
      closure: Closure,
      step: step))
}
