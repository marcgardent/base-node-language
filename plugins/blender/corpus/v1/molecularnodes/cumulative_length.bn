geometry graph "Cumulative Length"() -> (
    Length: Float(
      description: "The length along the current spline added to all previous spline lengths")
) {
  spline_parameter = SplineParameter()
  return (
    Length: EvaluateOnDomain(
      value: AccumulateField[CURVE](value: spline_parameter.length).trailing
        + spline_parameter.length))
}
