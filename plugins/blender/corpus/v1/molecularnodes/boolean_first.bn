geometry graph "Boolean First"(
    Boolean: Bool(description: "The `Boolean` field to test", hide_value: true),
    "Group ID": Int(
      description: "Each `Group ID` to find the first `True` element for",
      hide_value: true)
) -> ("Is First": Bool(description: "`True` for the first true element in each `Group ID`")) {
  "Only the first `True` in each `Group ID` remains `True`, all others become `False`"
  return (
    "Is First": AccumulateField[INT](
        value: AccumulateField[INT](value: Boolean, group_id: group_id).leading,
        group_id: group_id).leading
      == 1)
}
