geometry graph "Menu Residue Mask"(
    "Atom Name": Menu(optional_label: true) = N
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(
    pick: menu_atom_name(atom_name: atom_name).selection,
    group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph ".MN_topo_assign_backbone"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (Atoms: Geometry, "CA Atoms": Geometry, "Sample Index": Int) {
  "Compute only on backbone atoms, but capture their idx first" {
    group = is_alpha_carbon()
    capture_attribute = CaptureAttribute(
      Atoms,
      Selection as selection_2: group.selection,
      Index: AccumulateField[INT](value: group.selection).trailing)
    separate_geometry = SeparateGeometry(
      capture_attribute.geometry,
      selection: is_backbone().selection)
  }
  string = "backbone"
  repeat_output = repeat(4, Geometry: separate_geometry.selection) -> {
    group_2 = menu_residue_mask(atom_name: IndexSwitch[MENU](iteration, N, CA, C, O))
    return StoreNamedAttribute[FLOAT_VECTOR](
      Geometry,
      selection: group_2.is_valid,
      name: JoinStrings("_", string, IndexSwitch(iteration, "N", "CA", "C", "O")),
      value: group_2.position)
  }
  return (
    Atoms: repeat_output,
    "CA Atoms": repeat_output
      |> SeparateGeometry(selection: capture_attribute.selection_2).selection
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "backbone_NH", value: backbone_nh()),
    "Sample Index": SampleIndex[INT](
      capture_attribute.geometry,
      value: capture_attribute.index,
      index: Index()))
}

geometry graph "Backbone O"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (O: Vector) {
  return (O: backbone_position(method: Method, menu: backbone_O))
}

geometry graph "World to Angstrom"(World: Float = 0.5 in -10000.0..10000.0) -> (Angstrom: Float) {
  return (Angstrom: World / mn_world_scale())
}

geometry graph "Recip. Ang. Dis"(
    A: Vector in -10000.0..10000.0,
    B: Vector in -10000.0..10000.0
) -> (Value: Float) {
  return (Value: 1.0 / world_to_angstrom(world: distance(A, B)))
}

geometry graph "HBond Energy"(
    O: Vector,
    C: Vector,
    N: Vector,
    H: Vector
) -> ("Is Bonded": Bool, "Bond Energy": Float, "Bond Vector": Vector) {
  "1 / r(ON)" {
    group = recip_ang_dis(a: O, b: N)
  }
  "1 / r(CH)" {
    group_2 = recip_ang_dis(a: C, b: H)
  }
  "1 / r(OH)" {
    group_3 = recip_ang_dis(a: O, b: H)
  }
  "1 / r(CN)" {
    group_4 = recip_ang_dis(a: C, b: N)
  }
  math = -(group + group_2 - group_3 - group_4) @ mute
  math_2 = math * 0.084 * 332.0
  return ("Is Bonded": math_2 < -0.5, "Bond Energy": math_2, "Bond Vector": O - H)
}

geometry graph "Integer Distance"(
    A: Int,
    B: Int,
    Distance: Int = 2
) -> (Cutoff: Bool, Distance: Int) {
  integer_math = IntegerMath[ABSOLUTE](value: IntegerMath[SUBTRACT](Value: A, Value_001: B))
  return (Cutoff: integer_math >= Distance, Distance: integer_math)
}

geometry graph ".Check HBond"(
    "CO Index": Int = Index() in 0..,
    "NH Index": Int = Index() in 0..,
    Distance: Int = 2
) -> ("Is Bonded": Bool, "Bond Energy": Float, "Bond Vector": Vector) {
  group = hbond_energy(
    o: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_o(method: Read), index: co_index),
    c: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_c(method: Read), index: co_index),
    n: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_n(method: Read), index: nh_index),
    h: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_nh(menu: Read), index: nh_index))
  return (
    "Is Bonded": group.is_bonded
      and integer_distance(
        a: ures_id(index: co_index).ures_id,
        b: ures_id(index: nh_index).ures_id,
        distance: Distance).cutoff,
    "Bond Energy": group.bond_energy,
    "Bond Vector": group.bond_vector)
}

geometry graph ".HBond Backbone Check"(
    "CO (i)" {
        "CO Index": Int = Index() in 0..,
        "CO Offset": Int
    },
    "NH (j)" {
        "NH Index": Int = Index() in 0..,
        "NH Offset": Int
    }
) -> ("Is Bonded": Bool, "Bond Energy": Float, "H->O": Vector) {
  group = check_hbond(
    co_index: IntegerMath[ADD](Value: co_index, Value_001: co_offset),
    nh_index: IntegerMath[ADD](Value: nh_index, Value_001: nh_offset),
    distance: 1)
  return ("Is Bonded": group.is_bonded, "Bond Energy": group.bond_energy, "H->O": group.bond_vector)
}

geometry graph "Offset Boolean"(
    Boolean: Bool(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field") in -2147483647..
) -> (Boolean: Bool(description: "The field evaluated at the offset `Index` value")) {
  return (
    Boolean: EvaluateAtIndex[BOOLEAN](
      value: Boolean,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Vector from Point"(
    Target: Vector(description: "Vector that is the target") in -10000.0..10000.0,
    Position: Vector(
      description: "Position of the current point") = Position() in -10000.0..10000.0
) -> (
    Vector: Vector(description: "Vector from the current point's position to the given vector"),
    Direction: Vector(description: "Normalized output vector"),
    Length: Float(description: "Length of the output vector"),
    Rotation: Rotation
) {
  vector_math = Target - Position
  return (
    Vector: vector_math,
    Direction: normalize(vector_math),
    Length: length(vector_math),
    Rotation: AlignRotationToVector(vector: vector_math))
}

geometry graph "Index Distance"(
    Index: Int = Index() in 0..,
    "Target Index": Int(description: "Index for the selected point to measure to") = 100 in 0..,
    Position: Vector = Position()
) -> (
    Vector: Vector(description: "Vector from the current point to the indexed point"),
    Direction: Vector(description: "Normalized vector from the current point to the indexed point"),
    Distance: Float(description: "Distance from the current point to the indexed point"),
    Rotation: Rotation
) {
  group = vector_from_point(
    target: EvaluateAtIndex[FLOAT_VECTOR](
      value: Position,
      index: EvaluateAtIndex[INT](value: target_index, index: Index)),
    position: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: Index))
  return (
    Vector: group.vector,
    Direction: group.direction,
    Distance: group.length,
    Rotation: group.rotation)
}

geometry graph "Primitive Arrow"(
    Vertices: Int = 6 in 3..16,
    Height: Float(subtype: DISTANCE) = 1.0 in 0.0..10000.0,
    Ratio: Float(subtype: FACTOR) = 0.7 in 0.0..1.0,
    Value: Color = (0.8, 0.8, 0.8),
    Material: Material(description: "Material to apply to the resulting geometry")
) -> Geometry {
  math = Height * Ratio
  math_2 = Height - math
  return (Cone(vertices: Vertices, radius_bottom: 0.2, depth: math_2).mesh
        |> TransformGeometry(translation: CombineXYZ(z: Height - math_2)))
      + (Cylinder(vertices: Vertices, radius: 0.08, depth: math).mesh
        |> TransformGeometry(translation: CombineXYZ(z: math / 2.0)))
    |> StoreNamedAttribute[FLOAT_COLOR](name: "Color", value: Value)
    |> SetMaterial(material: Material)
}

geometry graph "Visualize Relative Atoms"(
    Atoms: Geometry,
    Selection: Bool(hide_value: true) = true,
    Scale: Float = 1.0 in -10000.0..10000.0,
    Position: Vector(hide_value: true) = Position(),
    "Target Index": Int(description: "Index for the selected point to measure to") = 100 in 0..,
    "Target Position": Vector(hide_value: true) = Position()
) -> (Instances: Geometry) {
  group = index_distance(target_index: target_index, position: target_position)
  return (
    Instances: Atoms
      |> SetPosition(position: Position)
      |> InstanceOnPoints(
        selection: Selection,
        instance: primitive_arrow(vertices: 3, ratio: 0.5625, value: (0.0, 0.0, 0.0, 1.0)),
        rotation: group.rotation,
        scale: CombineXYZ(x: 0.02, y: 0.02, z: group.distance * Scale)))
}

geometry graph ".MN_topo_calc_helix"(
    "CA Mesh": Geometry
) -> ("Is Helix": Bool, Instances: Geometry) {
  group = backbone_nh(menu: Read)
  capture_attribute = CaptureAttribute(
    ca_mesh,
    "3-helix": hbond_backbone_check(nh_offset: 3).is_bonded,
    "4-helix": hbond_backbone_check(nh_offset: 4).is_bonded,
    "5-helix": hbond_backbone_check(nh_offset: 6).is_bonded)
  {
    boolean_math = capture_attribute._4_helix
      and offset_boolean(boolean: capture_attribute._4_helix, offset: 1)
    boolean_math_2 = boolean_math
      or offset_boolean(boolean: boolean_math, offset: -1)
      or offset_boolean(boolean: boolean_math, offset: -2)
      or offset_boolean(boolean: boolean_math, offset: -3)
      or offset_boolean(boolean: boolean_math, offset: -4)
      or offset_boolean(boolean: boolean_math, offset: -5)
  }
  {
    boolean_math_3 = capture_attribute._5_helix
      and offset_boolean(boolean: capture_attribute._5_helix, offset: 1)
    boolean_math_4 = boolean_math_3
      or offset_boolean(boolean: boolean_math_3, offset: -1)
      or offset_boolean(boolean: boolean_math_3, offset: -2)
      or offset_boolean(boolean: boolean_math_3, offset: -3)
      or offset_boolean(boolean: boolean_math_3, offset: -4)
      or offset_boolean(boolean: boolean_math_3, offset: -5)
      or offset_boolean(boolean: boolean_math_3, offset: -6)
  }
  {
    boolean_math_5 = capture_attribute._3_helix
      and offset_boolean(boolean: capture_attribute._3_helix, offset: 1)
    boolean_math_6 = boolean_math_5
      or offset_boolean(boolean: boolean_math_5, offset: -1)
      or offset_boolean(boolean: boolean_math_5, offset: -2)
      or offset_boolean(boolean: boolean_math_5, offset: -3)
      or offset_boolean(boolean: boolean_math_5, offset: -4)
  }
  group_2 = offset_index(offset: 4)
  group_3 = offset_vector(vector: group, index: group_2)
  return (
    "Is Helix": SampleIndex[BOOLEAN](
      capture_attribute.geometry,
      value: boolean_math_6 or boolean_math_2 or boolean_math_4,
      index: Index()),
    Instances: visualize_relative_atoms(
      capture_attribute.geometry,
      selection: capture_attribute._4_helix,
      position: backbone_o(method: Read),
      target_index: group_2,
      target_position: group))
}

geometry graph "Boolean Run Fill"(
    Boolean: Bool(
      description: "The `Boolean` field to potentially fill gaps of `False` with",
      hide_value: true) = true,
    "Fill Size": Int(
      description: "A run of `False` values equal to or less than this size will become `True`") = 3
) -> (Boolean: Bool(description: "The `Boolean` array with gaps potentially filled")) {
  "Moving down the points, fill in `False` values that are equal to or less than the `Fill Size`"
  accumulate_field = AccumulateField[INT](group_id: AccumulateField[INT](value: Boolean).leading)
  return (
    Boolean: Boolean
      or accumulate_field.trailing <= fill_size and accumulate_field.total <= fill_size)
}

geometry graph ".MN_topo_calc_sheet"(
    "CA Mesh": Geometry
) -> ("Is Sheet": Bool, Instances: Geometry) {
  "Find Residues that we might be HBonding to" {
    group = backbone_nh(menu: Read)
    group_2 = backbone_o(method: Read)
    capture_attribute = CaptureAttribute(
      ca_mesh,
      "O -> NH": ca_mesh |> SetPosition(position: group) |> SampleNearest(sample_position: group_2),
      "NH -> O": ca_mesh |> SetPosition(position: group_2) |> SampleNearest(sample_position: group))
  }
  "Check if they are actually bonded to to the relevant atom" {
    capture_attribute_2 = CaptureAttribute(
      capture_attribute.geometry,
      "CO:NH": check_hbond(nh_index: capture_attribute.o_nh, distance: 3).is_bonded,
      "NH:CO": check_hbond(co_index: capture_attribute.nh_o, distance: 4).is_bonded)
  }
  "Debug arrows for HBonds" {
    value = 1.0
    join_geometry = visualize_relative_atoms(
        capture_attribute_2.geometry,
        selection: capture_attribute_2.co_nh,
        scale: value,
        position: backbone_o(method: Read),
        target_index: capture_attribute.o_nh,
        target_position: backbone_nh(menu: Read))
      + visualize_relative_atoms(
        capture_attribute_2.geometry,
        selection: capture_attribute_2.nh_co,
        scale: value,
        position: backbone_nh(menu: Read),
        target_index: capture_attribute.nh_o,
        target_position: backbone_o(method: Read))
  }
  "Not 100% correct but best I can do without Lists" {
    group_3 = boolean_run_fill(
      boolean: capture_attribute_2.co_nh
          and offset_boolean(boolean: capture_attribute_2.nh_co, index: capture_attribute.o_nh)
        or offset_boolean(boolean: capture_attribute_2.co_nh, offset: -1)
          and offset_boolean(boolean: capture_attribute_2.nh_co, offset: 1),
      fill_size: 2)
  }
  capture_attribute_3 = CaptureAttribute(capture_attribute_2.geometry, Boolean: group_3)
  return (
    "Is Sheet": SampleIndex[BOOLEAN](
      capture_attribute_3.geometry,
      value: capture_attribute_3.boolean,
      index: Index()),
    Instances: join_geometry)
}

geometry graph "Boolean Run Trim"(
    Boolean: Bool(
      description: "The `Boolean` field to check for continuous runs of `True` values",
      hide_value: true) = true,
    Start: Int(
      description: "The first `n` values of a run of `True` values are made to be `False`") in 0..,
    End: Int(description: "Ther last `n` values of a run of `True` values become `False`"),
    Size: Int(
      description: "A run of `True` values becomes `False` if shorter than this minimum length") = 10 in 0..
) -> (Boolean: Bool(description: "The `Boolean` field that has been trimmed")) {
  accumulate_field = AccumulateField[INT](
    group_id: AccumulateField[INT](value: not Boolean).trailing)
  return (
    Boolean: Boolean
      and accumulate_field.leading > Start
      and accumulate_field.total > Size
      and IntegerMath[SUBTRACT](Value: accumulate_field.total, Value_001: accumulate_field.leading)
        > End)
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph ".MN_ensure_ures_id"(Input: Geometry) -> (Output: Geometry) {
  "If the `ures_id` attribute doesn't exist, create it"
  "Check if `ures_id` exists" {
    get_attribute_names = GetAttributeNames(
      Input,
      filter_data_type: true,
      data_type: Integer,
      filter_domain: true)
    list_length = ListLength[STRING](
      list: FilterList[STRING](
        list: get_attribute_names,
        selection: get_attribute_names == "ures_id").selection)
  }
  return (Output: list_length ? Input : set_ures_id(Input))
}

geometry graph "Contains Geometry"(
    Geometry: Geometry
) -> (
    "Not Empty": Bool(description: "True when the input contains some geometry"),
    Empty: Bool(description: "True when the input contains no geometry")
) {
  boolean_math = DomainSize(Geometry).point_count == 0
    and DomainSize[POINTCLOUD](Geometry) == 0
    and DomainSize[CURVE](Geometry).point_count == 0
    and DomainSize[INSTANCES](Geometry) == 0
    and DomainSize[GREASEPENCIL](Geometry) == 0
  return ("Not Empty": not boolean_math, Empty: boolean_math)
}

geometry graph "Check Geometry"(
    Geometry: Geometry,
    Message: String(
      optional_label: true) = "Input contains no geometry, check your node connections."
) -> Geometry {
  warning = Warning(show: contains_geometry(Geometry).empty, message: Message)
  return Geometry
}

geometry graph "Get Geometry Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> (Geometry: Geometry, Bundle: Bundle, Atoms: Geometry) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  string = "MN/Atoms"
  get_bundle_item = GetBundleItem[GEOMETRY](
    bundle: get_geometry_bundle.bundle,
    path: string,
    remove: true)
  return (
    Geometry: Switch[GEOMETRY](switch: get_bundle_item.exists, true_: get_geometry_bundle.geometry),
    Bundle: get_bundle_item.bundle,
    Atoms: get_bundle_item.exists ? get_bundle_item.item : get_geometry_bundle.geometry)
}

geometry graph "Evaluate on Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Closure: Closure,
    Result: Menu(
      description: "Where to store the result of the closure. Bundle overwrite the existing `MN/Atoms` bundle. Geometry passes along the bundle and joins the resulting geometry into the output.",
      menu_expanded: true,
      optional_label: true) = Geometry
) -> Geometry {
  group = get_geometry_atoms(Geometry)
  "Evaluate the closure on the 'Atoms'" {
    evaluate_closure = EvaluateClosure(
      Closure,
      Atoms: group.atoms
        |> check_geometry(message: "'Atoms' contains no geometry, check your node connections.")
        |> mn_ensure_ures_id()
        |> SeparateGeometry(selection: Selection).selection) -> Geometry
  }
  menu_switch = MenuSwitch(menu: Result, Geometry: 0, Bundle: 1)
  string = "Evaluate the 'Closure' on the 'Atoms' geometry, join the resulting geometry with the input geometry.\n\nIf the input 'Geometry' doesn't contain a 'MN/Atoms' bundle then we treat the input geometry as the 'Atoms'."
  return SetGeometryBundle(
    group.geometry + IndexSwitch(menu_switch.output, evaluate_closure, _),
    bundle: StoreBundleItem[GEOMETRY](
      bundle: group.bundle,
      path: "MN/Atoms",
      item: IndexSwitch(menu_switch.output, group.atoms, evaluate_closure)))
}

geometry graph "Secondary Structure"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (sec_struct: Int) {
  return (sec_struct: attribute_at_index(index: Index, name: "sec_struct"))
}

geometry(is_modifier: false) graph "Topology DSSP"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (
    Atoms: Geometry(
      description: "The input `Atoms` with updated `sec_struct` attributes based on the DSSP algorithm")
) {
  "Calculate the secondary structure attributes for the protein chains, based on the 1983 Kabsch algorithm"
  closure_output = graph(Atoms: Geometry) -> Geometry {
    group = mn_topo_assign_backbone(Atoms)
    capture_attribute = CaptureAttribute(
      group.ca_atoms,
      "Is Sheet": mn_topo_calc_sheet(group.ca_atoms).is_sheet,
      "Is Helix": mn_topo_calc_helix(group.ca_atoms).is_helix)
    return Atoms
      |> StoreNamedAttribute[INT](
        selection: is_alpha_carbon().selection,
        name: "sec_struct",
        value: SampleIndex[INT](
          capture_attribute.geometry,
          value: capture_attribute.is_helix
            ? 1
            : boolean_run_trim(
                boolean: nimply(capture_attribute.is_sheet, capture_attribute.is_helix),
                size: 3)
              ? 2
              : 3,
          index: group.sample_index))
      |> StoreNamedAttribute[INT](
        name: "sec_struct",
        value: EvaluateAtIndex[INT](
          value: secondary_structure(),
          index: menu_residue_mask(atom_name: CA).index))
  }
  return (Atoms: evaluate_on_atoms(Atoms, closure: closure_output, result: Bundle))
}
