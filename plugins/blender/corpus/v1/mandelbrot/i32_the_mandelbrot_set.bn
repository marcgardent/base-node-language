geometry graph "i32 mBeB"() -> (mBits: Int, eBias: Int) {
  mBits = 32 @ "mBits" #83314a
  eBias = 65536 @ "eBias" #83314a
  return (mBits: mBits, eBias: eBias)
}

geometry graph "i32 2f"(
    "i32" {
        Value: Bundle
    }
) -> (Value: Float) {
  group = i32_mbeb() @ #3b5d3d
  math = (SeparateBundle(Value) -> (m: Int, e: Int, s: Bool)).m
    * pow(
      2.0,
      IntegerMath[SUBTRACT](
        Value: (SeparateBundle(Value) -> (m: Int, e: Int, s: Bool)).e,
        Value_001: IntegerMath[ADD](Value: group.mbits, Value_001: group.ebias)))
  return (Value: (SeparateBundle(Value) -> (m: Int, e: Int, s: Bool)).s ? 0.0 - math : math)
}

geometry graph "i32 4f"(
    Value: Float
) -> (
    "i32" {
        Value: Bundle
    }
) {
  math = abs(Value)
  math_2 = floor(log(math, 2.0) + 1.0)
  group = i32_mbeb() @ #3b5d3d
  math_3 = math / pow(2.0, math_2) * pow(2.0, group.mbits)
  compare = math_3 >= 2147483600.0 @ #83314a
  group_2 = i32_mbeb() @ #3b5d3d
  compare_2 = Compare[NOT_EQUAL](a: Value, epsilon: 0.0)
  return (
    Value: CombineBundle(
      m: compare_2 ? Switch[INT](switch: compare, false_: math_3, true_: math_3 / 2.0) : 0,
      e: compare_2
        ? IntegerMath[ADD](
          Value: Switch[INT](
            switch: compare,
            false_: math_2,
            true_: IntegerMath[ADD](Value: math_2, Value_001: 1)),
          Value_001: group_2.ebias)
        : 0,
      s: Value < 0.0))
}

geometry graph "i32 mBits"(
    Menu: Menu(optional_label: true) = "Bit Length",
    Value: Int
) -> (Result: Int) {
  compare = Value >= 65536 @ #3b5d3d
  bit_math = BitMath[SHIFT](a: Value, shift: -16) @ #83314a
  switch = compare ? bit_math : Value
  switch_2 = compare ? 16 : 0
  compare_2 = switch >= 256 @ #3b5d3d
  bit_math_2 = BitMath[SHIFT](a: switch, shift: -8) @ #83314a
  switch_3 = compare_2 ? bit_math_2 : switch
  switch_4 = compare_2 ? IntegerMath[ADD](Value: switch_2, Value_001: 8) : switch_2
  compare_3 = switch_3 >= 16 @ #3b5d3d
  bit_math_3 = BitMath[SHIFT](a: switch_3, shift: -4) @ #83314a
  switch_5 = compare_3 ? bit_math_3 : switch_3
  switch_6 = compare_3 ? IntegerMath[ADD](Value: switch_4, Value_001: 4) : switch_4
  compare_4 = switch_5 >= 4 @ #3b5d3d
  bit_math_4 = BitMath[SHIFT](a: switch_5, shift: -2) @ #83314a
  switch_7 = compare_4 ? IntegerMath[ADD](Value: switch_6, Value_001: 2) : switch_6
  compare_5 = (compare_4 ? bit_math_4 : switch_5) >= 2 @ #3b5d3d
  switch_8 = Value < 0 ? 31 : compare_5 ? IntegerMath[ADD](Value: switch_7, Value_001: 1) : switch_7
  return (
    Result: Value != 0
      ? MenuSwitch(
        menu: Menu,
        "Bit Length": IntegerMath[ADD](Value: switch_8, Value_001: 1),
        "Log Base 2": switch_8).output
      : 0)
}

geometry graph "i32 4p"(
    "Position" {},
    "Parameters" {
        Resolution: Int(force_non_field: true, structure_type: SINGLE) = 128 in 32..16384
    }
) -> (
    "Position" {
        Real: Bundle,
        Imaginary: Bundle
    }
) {
  integer_math = IntegerMath[SUBTRACT](Value: Resolution, Value_001: 1)
  integer_math_2 = IntegerMath[SUBTRACT](
    Value: IntegerMath[MULTIPLY](
      Value: IntegerMath[DIVIDE](Value: Index(), Value_001: Resolution),
      Value_001: 2),
    Value_001: integer_math)
  integer_math_3 = IntegerMath[SUBTRACT](
    Value: IntegerMath[MULTIPLY](
      Value: IntegerMath[MODULO](Value: Index(), Value_001: Resolution),
      Value_001: 2),
    Value_001: integer_math)
  integer_math_4 = IntegerMath[ABSOLUTE](value: integer_math_2)
  group = i32_mbeb() @ #3b5d3d
  group_2 = i32_mbits(menu: "Log Base 2", value: Resolution) @ #3b5d3d
  integer_math_6 = IntegerMath[SUBTRACT](Value: 31, Value_001: group_2)
  group_3 = i32_mbits(value: integer_math_4) @ #3b5d3d
  integer_math_5 = IntegerMath[SUBTRACT](Value: group_2, Value_001: group_3)
  bit_math = BitMath[SHIFT](a: integer_math_4, shift: integer_math_5) @ #83314a
  integer_math_7 = IntegerMath[ABSOLUTE](value: integer_math_3)
  bit_math_3 = BitMath[SHIFT](a: bit_math, shift: integer_math_6) @ #83314a
  group_4 = i32_mbeb() @ #3b5d3d
  group_5 = i32_mbits(value: integer_math_7) @ #3b5d3d
  integer_math_8 = IntegerMath[SUBTRACT](Value: group_2, Value_001: group_5)
  bit_math_2 = BitMath[SHIFT](a: integer_math_7, shift: integer_math_8) @ #83314a
  bit_math_4 = BitMath[SHIFT](a: bit_math_2, shift: integer_math_6) @ #83314a
  return (
    Real: CombineBundle(
      m: bit_math_3,
      e: IntegerMath[ADD](
        Value: group.ebias,
        Value_001: IntegerMath[SUBTRACT](Value: 2, Value_001: integer_math_5)),
      s: integer_math_2 < 0),
    Imaginary: CombineBundle(
      m: bit_math_4,
      e: IntegerMath[ADD](
        Value: group_4.ebias,
        Value_001: IntegerMath[SUBTRACT](Value: 2, Value_001: integer_math_8)),
      s: integer_math_3 < 0))
}

geometry graph "i32 dAddSub"(
    Menu: Menu(optional_label: true) = Add,
    "c" {},
    "a" {
        "a Value": Bundle
    },
    "b" {
        "b Value": Bundle
    }
) -> (
    "c" {
        "c Value": Bundle
    }
) {
  integer_math_2 = IntegerMath[SUBTRACT](
    Value: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).e,
    Value_001: (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).e)
  compare_2 = integer_math_2 >= 0
  bit_math_2 = BitMath[SHIFT](
    a: (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).m,
    shift: IntegerMath[NEGATE](value: integer_math_2)) @ #83314a
  switch_3 = integer_math_2 > 0
    ? bit_math_2
    : (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).m
  bit_math_3 = BitMath[SHIFT](
    a: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m,
    shift: integer_math_2) @ #83314a
  switch = compare_2 ? (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m : bit_math_3
  separate_bundle = SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)
  switch_2 = compare_2
    ? separate_bundle.e
    : (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).e
  integer_math = IntegerMath[ADD](Value: switch_2, Value_001: 1) @ #3b5d3d
  separate_bundle_2 = SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)
  compare_3 = switch < switch_3
  boolean_math = separate_bundle.s
    xor (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).s
    xor MenuSwitch(menu: Menu, Add: false, Subtract: true).output
  switch_4 = boolean_math
    ? (compare_3
      ? IntegerMath[SUBTRACT](Value: switch_3, Value_001: switch)
      : IntegerMath[SUBTRACT](Value: switch, Value_001: switch_3))
    : IntegerMath[ADD](Value: switch, Value_001: switch_3)
  compare = switch_4 < 0
  bit_math = BitMath[SHIFT](a: switch_4, shift: -1) @ #83314a
  return (
    "c Value": CombineBundle(
      m: compare ? bit_math : switch_4,
      e: compare ? integer_math : switch_2,
      s: compare_3 and boolean_math ? nimply(true, separate_bundle_2.s) : separate_bundle_2.s))
}

geometry graph "i32 dMulPow2"(
    Menu: Menu(optional_label: true) = Multiply,
    "c" {},
    "a" {
        "a Value": Bundle
    },
    "b" {
        "b Value": Bundle
    }
) -> (
    "c" {
        "c Value": Bundle
    }
) {
  menu_switch = MenuSwitch(menu: Menu, Multiply: false, Power2: true)
  bit_math = BitMath[SHIFT](
    a: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m,
    shift: -16) @ #83314a
  bit_math_2 = BitMath[AND](
    a: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m,
    b: 65535) @ #83314a
  bit_math_3 = BitMath[SHIFT](
    a: (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).m,
    shift: -16) @ #83314a
  bit_math_4 = BitMath[AND](
    a: (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).m,
    b: 65535) @ #83314a
  integer_math = IntegerMath[MULTIPLY](Value: bit_math_2, Value_001: bit_math_3)
  integer_math_2 = IntegerMath[MULTIPLY](Value: bit_math, Value_001: bit_math_4)
  bit_math_5 = BitMath[SHIFT](a: integer_math, shift: -16) @ #83314a
  bit_math_6 = BitMath[AND](a: integer_math, b: 65535) @ #83314a
  bit_math_7 = BitMath[SHIFT](
    a: IntegerMath[MULTIPLY](Value: bit_math_2, Value_001: bit_math_4),
    shift: -16) @ #83314a
  bit_math_8 = BitMath[SHIFT](a: integer_math_2, shift: -16) @ #83314a
  bit_math_9 = BitMath[AND](a: integer_math_2, b: 65535) @ #83314a
  bit_math_10 = BitMath[SHIFT](
    a: IntegerMath[ADD](
      Value: bit_math_9,
      Value_001: IntegerMath[ADD](Value: bit_math_6, Value_001: bit_math_7)),
    shift: -16) @ #83314a
  group = i32_mbeb() @ #3b5d3d
  group_3 = i32_mbeb() @ #3b5d3d
  integer_math_3 = IntegerMath[SUBTRACT](
    Value: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).e,
    Value_001: group_3.ebias)
  group_4 = i32_mbeb() @ #3b5d3d
  bit_math_12 = BitMath[SHIFT](
    a: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m,
    shift: -16) @ #83314a
  bit_math_13 = BitMath[AND](
    a: (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).m,
    b: 65535) @ #83314a
  integer_math_5 = IntegerMath[MULTIPLY](Value: bit_math_12, Value_001: bit_math_13)
  bit_math_14 = BitMath[SHIFT](a: integer_math_5, shift: -16) @ #83314a
  bit_math_15 = BitMath[AND](a: integer_math_5, b: 65535) @ #83314a
  bit_math_16 = BitMath[SHIFT](
    a: IntegerMath[MULTIPLY](Value: bit_math_13, Value_001: bit_math_13),
    shift: -16) @ #83314a
  bit_math_17 = BitMath[SHIFT](
    a: IntegerMath[ADD](
      Value: bit_math_15,
      Value_001: IntegerMath[ADD](Value: bit_math_15, Value_001: bit_math_16)),
    shift: -16) @ #83314a
  switch = menu_switch.output
    ? IntegerMath[ADD](
      Value: IntegerMath[ADD](
        Value: IntegerMath[ADD](
          Value: bit_math_14,
          Value_001: IntegerMath[MULTIPLY](Value: bit_math_12, Value_001: bit_math_12)),
        Value_001: bit_math_14),
      Value_001: bit_math_17)
    : IntegerMath[ADD](
      Value: IntegerMath[ADD](
        Value: IntegerMath[ADD](
          Value: bit_math_5,
          Value_001: IntegerMath[MULTIPLY](Value: bit_math, Value_001: bit_math_3)),
        Value_001: bit_math_8),
      Value_001: bit_math_10)
  group_2 = i32_mbits(value: switch) @ #3b5d3d
  integer_math_4 = IntegerMath[SUBTRACT](Value: 31, Value_001: group_2) @ #3b5d3d
  bit_math_11 = BitMath[SHIFT](a: switch, shift: integer_math_4) @ #83314a
  compare = (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).e <= 0
  switch_2 = menu_switch.output
    ? compare
    : (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).e <= 0 or compare
  return (
    "c Value": CombineBundle(
      m: switch_2 ? 0 : bit_math_11,
      e: switch_2
        ? 0
        : IntegerMath[SUBTRACT](
          Value: IntegerMath[ADD](
            Value: menu_switch.output
              ? IntegerMath[MULTIPLY](Value: integer_math_3, Value_001: 2)
              : IntegerMath[ADD](
                Value: IntegerMath[SUBTRACT](
                  Value: (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).e,
                  Value_001: group.ebias),
                Value_001: integer_math_3),
            Value_001: group_4.ebias),
          Value_001: integer_math_4),
      s: menu_switch.output
        ? false
        : (SeparateBundle(a_value) -> (m: Int, e: Int, s: Bool)).s
          xor (SeparateBundle(b_value) -> (m: Int, e: Int, s: Bool)).s))
}

geometry graph "i32 cMc"(
    Iteration: Int,
    Real: Bundle,
    Imaginary: Bundle,
    "Parameters" {
        Bailout: Float(force_non_field: true, structure_type: SINGLE) = 4.0 in 4.0..,
        "Center X": Float(force_non_field: true, structure_type: SINGLE),
        "Center Y": Float(force_non_field: true, structure_type: SINGLE),
        Scale: Float(force_non_field: true, structure_type: SINGLE),
        Resoulion: Int(force_non_field: true, structure_type: SINGLE) = 128 in 32..16384
    }
) -> (Iteration: Int, Real: Bundle, Imaginary: Bundle) {
  group = i32_dmulpow2(menu: Power2, a_value: Real) @ #3b5d3d
  group_2 = i32_dmulpow2(menu: Power2, a_value: Imaginary) @ #3b5d3d
  group_3 = i32_dmulpow2(a_value: Real, b_value: Imaginary) @ #3b5d3d
  group_4 = i32_daddsub(menu: Subtract, a_value: group, b_value: group_2) @ #3b5d3d
  group_7 = i32_4p(resolution: Resoulion) @ #3b5d3d
  group_10 = i32_4f(value: center_x) @ #3b5d3d
  group_11 = i32_4f(value: center_y) @ #3b5d3d
  group_12 = i32_daddsub(a_value: group, b_value: group_2) @ #3b5d3d
  group_13 = i32_2f(value: group_12) @ #3b5d3d
  compare = group_13 > Bailout
  group_16 = i32_4f(value: Scale) @ #3b5d3d
  group_14 = i32_dmulpow2(a_value: group_7.real, b_value: group_16) @ #3b5d3d
  group_8 = i32_daddsub(a_value: group_14, b_value: group_10) @ #3b5d3d
  group_5 = i32_daddsub(a_value: group_8, b_value: group_4) @ #3b5d3d
  group_15 = i32_dmulpow2(a_value: group_16, b_value: group_7.imaginary) @ #3b5d3d
  group_9 = i32_daddsub(a_value: group_15, b_value: group_11) @ #3b5d3d
  separate_bundle = SeparateBundle(group_3) -> (m: Int, e: Int, s: Bool)
  group_6 = i32_daddsub(
    a_value: group_9,
    b_value: CombineBundle(
      m: separate_bundle.m,
      e: IntegerMath[ADD](Value: separate_bundle.e, Value_001: 1),
      s: (SeparateBundle(group_3) -> (m: Int, e: Int, s: Bool)).s)) @ #3b5d3d
  return (
    Iteration: compare ? Iteration : IntegerMath[ADD](Value: Iteration, Value_001: 1),
    Real: CombineBundle(
      m: compare
        ? (SeparateBundle(Real) -> (m: Int, e: Int, s: Bool)).m
        : (SeparateBundle(group_5) -> (m: Int, e: Int, s: Bool)).m,
      e: compare
        ? (SeparateBundle(Real) -> (m: Int, e: Int, s: Bool)).e
        : (SeparateBundle(group_5) -> (m: Int, e: Int, s: Bool)).e,
      s: compare
        ? (SeparateBundle(Real) -> (m: Int, e: Int, s: Bool)).s
        : (SeparateBundle(group_5) -> (m: Int, e: Int, s: Bool)).s),
    Imaginary: CombineBundle(
      m: compare
        ? (SeparateBundle(Imaginary) -> (m: Int, e: Int, s: Bool)).m
        : (SeparateBundle(group_6) -> (m: Int, e: Int, s: Bool)).m,
      e: compare
        ? (SeparateBundle(Imaginary) -> (m: Int, e: Int, s: Bool)).e
        : (SeparateBundle(group_6) -> (m: Int, e: Int, s: Bool)).e,
      s: compare
        ? (SeparateBundle(Imaginary) -> (m: Int, e: Int, s: Bool)).s
        : (SeparateBundle(group_6) -> (m: Int, e: Int, s: Bool)).s))
}

geometry(is_modifier: true) graph "i32 the Mandelbrot Set"(
    Resolution: Menu(force_non_field: true, structure_type: SINGLE) = "128x128",
    Mode: Menu(force_non_field: true, structure_type: SINGLE) = Mesh,
    "Last Iteration Only": Bool(force_non_field: true, structure_type: SINGLE),
    Iterations: Int(force_non_field: true, structure_type: SINGLE) = 16 in 1..32768,
    Bailout: Float(force_non_field: true, structure_type: SINGLE) = 4.0 in 4.0..,
    "Center X": Float(force_non_field: true, structure_type: SINGLE) in -2.0..2.0,
    "Center Y": Float(force_non_field: true, structure_type: SINGLE) in -2.0..2.0,
    Scale: Float(force_non_field: true, structure_type: SINGLE) = 1.0 in 0.0..20.0
) -> Geometry {
  menu_switch = MenuSwitch(
    menu: Resolution,
    "128x128": 128,
    "256x256": 256,
    "512x512": 512,
    "1024x1024": 1024,
    "2048x2048": 2048,
    "4096x4096": 4096,
    "8192x8192": 8192,
    "16384x16384": 16384)
  extrude_mesh = Cube(size: (2.0, 2.0, 2.0)).mesh
    |> ExtrudeMesh(selection: Index() == 2, offset_scale: 0.25)
  repeat_output = repeat(Iterations, Iteration: 0, Real: Bundle, Imaginary: Bundle) -> {
    group = i32_cmc(
      iteration: Iteration,
      real: Real,
      imaginary: Imaginary,
      bailout: Bailout,
      center_x: center_x,
      center_y: center_y,
      scale: pow(2.0, 1.0 - Scale),
      resoulion: menu_switch.output) @ #3b5d3d
    return (Iteration: group.iteration, Real: group.real, Imaginary: group.imaginary)
  }
  store_named_attribute = Grid(
      size_x: 4.0,
      size_y: 4.0,
      vertices_x: menu_switch.output,
      vertices_y: menu_switch.output).mesh
    |> StoreNamedAttribute(name: "dp", value: sqrt(FaceArea()) * 0.499)
    |> StoreNamedAttribute[INT](name: "it", value: repeat_output.iteration)
  set_position = SetPosition(
    last_iteration_only
      ? DeleteGeometry(
        store_named_attribute,
        selection: NamedAttribute[INT](name: "it").attribute != Iterations)
      : store_named_attribute,
    offset: CombineXYZ(z: -(NamedAttribute[INT](name: "it").attribute / Iterations)))
  return MenuSwitch(
    menu: Mode,
    Mesh: set_position,
    Points: MeshToPoints(set_position, radius: NamedAttribute(name: "dp").attribute),
    Pixels: InstanceOnPoints(
      set_position,
      instance: ScaleElements(extrude_mesh.mesh, selection: extrude_mesh.top, scale: 0.75),
      scale: NamedAttribute(name: "dp").attribute)).output
}
