geometry graph "Unravel Thread Mesh"(
    Geometry: Geometry,
    Threads: Object(description: "The threads object to turn into mesh tubes"),
    Sides: Int(description: "Sides around each thread tube. 3 is lightest") = 3 in 3..8,
    Detail: Float(
      subtype: FACTOR,
      description: "Share of points kept along each thread. Lower is lighter") = 1.0 in 0.1..1.0,
    "UV Map": String(
      description: "UV map name to store on the tubes, so the cloth colour carries over") = "UVMap"
) -> Geometry {
  object_info = ObjectInfo[RELATIVE](object: Threads) @ "Threads Info"
  points_of_curve = PointsOfCurve() @ "Points per Thread"
  math = points_of_curve.total * Detail @ "Times Detail"
  float_to_integer = FloatToInteger(float: math) @ "Round"
  math_2 = max(float_to_integer, 2.0) @ "At Least 2"
  resample_curve = ResampleCurve(object_info.geometry, count: math_2) @ "Fewer Points"
  curve_circle = CurveCircle(resolution: Sides) @ "Tube Profile"
  curve_to_mesh = CurveToMesh(
    resample_curve,
    profile_curve: curve_circle,
    scale: Radius()) @ "Make Tubes"
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: uv_map) @ "Root UV"
  store_named_attribute = StoreNamedAttribute[FLOAT2, CORNER](
    curve_to_mesh,
    name: uv_map,
    value: named_attribute.attribute) @ "Store UV Map"
  set_shade_smooth = SetShadeSmooth(store_named_attribute) @ "Smooth Tubes"
  return set_shade_smooth
}
