geometry graph "String to List"(
    String: String(optional_label: true),
    Separator: String(optional_label: true) = ","
) -> (List: String) {
  return (List: TrimString(string: SplitString(string: String, separator: Separator)))
}

geometry(is_modifier: false) graph "Set Geometry Tags"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Tags: String(optional_label: true)
) -> Geometry {
  get_geometry_bundle = GetGeometryBundle(Geometry, remove: true)
  return SetGeometryBundle(
    get_geometry_bundle.geometry,
    bundle: StoreBundleItem[STRING](
      bundle: get_geometry_bundle.bundle,
      path: "tags",
      item: string_to_list(string: Tags)))
}
