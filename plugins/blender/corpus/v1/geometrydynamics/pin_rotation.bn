geometry graph "Pin Rotation"(
    Selection: Bool(structure_type: FIELD) = true,
    Rotation: Rotation(structure_type: FIELD),
    Compliance: Float(structure_type: FIELD) in 0.0..,
    "Filter"(default_closed: true) {
        Filter: String(force_non_field: true, optional_label: true, structure_type: SINGLE)
    },
    "Debug"(default_closed: true) {
        "Error Threshold": Float(subtype: ANGLE) = 0.01 in 1e-05..
    }
) -> (Constraint: Bundle) {
  return (
    Constraint: CombineBundle(
      Type: "Blender.Constraint.PinRotation",
      filter: Filter,
      selection: Selection,
      rotation: Rotation,
      compliance: Compliance,
      error_threshold: error_threshold))
}
