geometry(is_modifier: false) graph "Apply Geo Cache - Topology Changing"(
    "New Geometry": Geometry,
    "Cached Geometry": Geometry,
    "Sim Attributes": String(
      description: "List of attribute names (not) to transfer. A wildcard (*) at the end is allowed",
      optional_label: true),
    "Point ID": Int(hide_value: true) = Index(),
    "Edge ID": Int(hide_value: true) = Index(),
    "Face ID": Int(hide_value: true) = Index(),
    "Corner ID": Int(hide_value: true) = Index(),
    "Curve ID": Int(hide_value: true) = Index(),
    "Instance ID": Int(hide_value: true) = Index()
) -> ("Mixed Geometry": Geometry) {
  get_geometry_bundle = cached_geometry
    |> TransferAttributes(
      target_point_id: point_id,
      target_edge_id: edge_id,
      target_face_id: face_id,
      target_corner_id: corner_id,
      target_curve_id: curve_id,
      target_instance_id: instance_id,
      source: new_geometry,
      source_point_id: point_id,
      source_edge_id: edge_id,
      source_face_id: face_id,
      source_corner_id: corner_id,
      source_curve_id: curve_id,
      source_instance_id: instance_id,
      attribute_names: sim_attributes,
      exclude_names: true).target
    |> GetGeometryBundle(remove: true)
  return (
    "Mixed Geometry": SetGeometryBundle(
      get_geometry_bundle.geometry,
      bundle: JoinBundle(GetGeometryBundle(new_geometry).bundle, get_geometry_bundle.bundle)))
}
