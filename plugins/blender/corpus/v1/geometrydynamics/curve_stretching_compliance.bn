geometry graph "Curve Stretching Compliance"(
    Softness: Float(subtype: FACTOR) in 0.0..1.0
) -> ("Constraint Compliance": Float) {
  "Parameters from longest Curve" {
    named_attribute = NamedAttribute(name: "rest_length")
    curve_of_point = CurveOfPoint()
    accumulate_field = AccumulateField(
      value: NamedAttribute(name: "mass").attribute,
      group_id: curve_of_point.curve_index)
    accumulate_field_2 = AccumulateField(
      value: named_attribute.attribute,
      group_id: curve_of_point.curve_index)
  }
  "Clamp Softness to valid range" {
    clamp = Clamp(value: Softness)
  }
  "Edge length factor for discrete constraints" {
    integer_math = IntegerMath[ADD](Value: Index(), Value_001: 1) @ "+1" hide
    math_4 = EvaluateAtIndex(value: named_attribute.attribute, index: integer_math)
      * 0.5 @ "x/2" hide mute
  }
  "Map softness to Elongation" {
    math_6 = 1.0 - clamp @ "1-x" hide
    value = -2.0 @ "Slope"
    math_8 = max(math_6, 1e-09) @ "max(x, epsilon)" hide
    math_5 = log(math_8, 2.7182817) @ "ln(x)" hide
    math_7 = math_5 / value @ hide
  }
  "Hooke's Law" {
    math_10 = math_7 * 2.0 @ "2x" hide
  }
  "Total Curve Weight" {
    value_2 = -9.81 @ "Gravity"
    math_9 = abs(value_2) @ hide
    math = accumulate_field.total * math_9 @ hide
  }
  "Hooke's Law" .. {
    math_2 = math_10 / math @ hide
  }
  "Edge length factor for discrete constraints" .. {
    math_3 = math_2 * math_4 @ hide
  }
  string = "Parameterization of constraint compliance using \"Softness\", based on Hooke's law.\n\nA representative curve (longest curve) is stretched by some factor based on the total weight of the curve and the stiffness of the material. The inverse of this relationship yields the stiffness based on a desired maximum geometric stretch factor, computed from the softness parameter.\n\nConstraint stiffness includes the length of adjacent segments."
  return ("Constraint Compliance": math_3)
}
