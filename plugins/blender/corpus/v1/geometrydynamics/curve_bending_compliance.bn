geometry graph "Curve Bending Compliance"(
    Softness: Float(subtype: FACTOR) in 0.0..1.0
) -> ("Constraint Compliance": Float) {
  "Parameters from longest Curve" {
    named_attribute = NamedAttribute(name: "rest_length")
    curve_of_point = CurveOfPoint()
    accumulate_field = AccumulateField(
      value: NamedAttribute(name: "mass").attribute,
      group_id: curve_of_point.curve_index)
    accumulate_field_2 = AccumulateField(
      value: named_attribute.attribute,
      group_id: curve_of_point.curve_index)
  }
  "Clamp softness to valid range" {
    clamp = Clamp(value: Softness)
  }
  "Map to Beam Deflection" {
    math_3 = clamp * -1.5708 @ "-x*pi/2"
    math = tan(math_3) @ hide
    math_2 = math * accumulate_field_2.total @ hide
  }
  "Static Cantilever Beam Stiffness from Deflection" {
    math_6 = pow(accumulate_field_2.total, 3.0) @ "L^3" hide
    math_7 = math_2 * 8.0 @ "8*x" hide
  }
  "Edge length factor for discrete constraints" {
    integer_math = IntegerMath[ADD](Value: Index(), Value_001: 1) @ "+1" hide
    math_10 = EvaluateAtIndex(value: named_attribute.attribute, index: integer_math)
      * 0.5 @ "x/2" hide
  }
  "Total Curve Weight" {
    value = -9.81 @ "Gravity"
    math_4 = accumulate_field.total * value @ hide
  }
  "Static Cantilever Beam Stiffness from Deflection" .. {
    math_5 = math_4 * math_6 @ hide
    math_8 = math_7 / math_5 @ hide
  }
  "Edge length factor for discrete constraints" .. {
    math_9 = math_8 * math_10 @ hide
  }
  string = "Stiffness model based on static beam deflection:\n\nA representative hair curve is described by a cantilever beam, fixed at one end, with a uniform load. The maximum deflection at the other end can be computed based on the material stiffness (Bernoulli model). Inverting this relationship yields a formula for stiffness based on a simple geometric parameter (maximum deflection, expressed as an angle).\n\nThe stiffness of each constraint is dependent on the length of the adjacent segments.\n\nTechnically the Bernoulli model is only accurate for small deflections, but it works well enough to provide a simple parameterization of \"softness\" to constraint compliance."
  return ("Constraint Compliance": math_9)
}
