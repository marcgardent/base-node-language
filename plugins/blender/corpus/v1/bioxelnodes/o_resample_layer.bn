geometry graph "O Resample Layer"(
    Grid: Float(structure_type: GRID),
    "Old Shape": Vector(
      description: "Maximum boundary of volume",
      hide_value: true) = (100.0, 100.0, 100.0) in 1.0..512.0,
    "New Shape": Vector(hide_value: true) = (100.0, 100.0, 100.0) in 1.0..512.0
) -> (Topology: Float) {
  grid_info = GridInfo(grid: Grid)
  separate_xyz = SeparateXYZ(vector: new_shape) @ hide
  return (
    Topology: VoxelizeGrid(
      grid: VolumeCube(
          background: grid_info.background_value,
          min: (0.0, 0.0, 0.0),
          max: old_shape,
          resolution_x: separate_xyz.x,
          resolution_y: separate_xyz.y,
          resolution_z: separate_xyz.z)
        |> TransformGeometry(mode: Matrix, transform: grid_info.transform)
        |> GetNamedGrid(name: "density").grid))
}
