geometry graph "O Grid Info"(
    Grid: Float(hide_value: true),
    Shape: Vector(
      subtype: TRANSLATION,
      description: "Side length along each axis",
      hide_value: true) = (100.0, 100.0, 100.0) in 1.0..512.0
) -> ("Voxel Size": Vector(subtype: XYZ), "Median Point": Vector) {
  grid_info = GridInfo(grid: Grid) @ hide
  cube = Cube(size: Shape) @ hide
  vector_math_3 = Shape * 0.5 @ hide
  transform_geometry_2 = TransformGeometry(cube.mesh, translation: vector_math_3) @ hide
  transform_geometry = TransformGeometry(
    transform_geometry_2,
    mode: Matrix,
    transform: grid_info.transform) @ hide
  bounding_box = BoundingBox(transform_geometry) @ hide
  vector_math_2 = bounding_box.min + bounding_box.max @ hide
  vector_math = vector_math_2 * 0.5 @ hide
  combine_transform = CombineTransform(translation: vector_math) @ hide
  return (
    "Voxel Size": SeparateTransform(transform: grid_info.transform).scale,
    "Median Point": vector_math)
}

geometry graph "O Crop Layer"(
    Menu: Menu(optional_label: true) = Scalar,
    Scalar: Bundle,
    Label: Bundle,
    Color: Bundle,
    "Bioxel Size": Float = 2.0 in 1.0..10.0,
    Menu as menu_menu: Menu(menu_expanded: true, optional_label: true) = Custom,
    "Bounding Box": Geometry(
      description: "Geometry to compute the bounding box of. Instances have to be realized before the full bounding box can be computed"),
    Min: Vector(
      subtype: TRANSLATION,
      description: "Minimum boundary of volume") = (-1.0, -1.0, -1.0),
    Max: Vector(subtype: TRANSLATION, description: "Maximum boundary of volume") = (1.0, 1.0, 1.0)
) -> (Layer: Bundle) {
  separate_bundle = SeparateBundle[define_signature: true](
    Scalar) -> (
    Data: Float(structure_type: GRID),
    Name: String(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    Shape: Vector(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE),
    Min: Float(structure_type: SINGLE),
    Max: Float(structure_type: SINGLE))
  separate_bundle_2 = SeparateBundle[define_signature: true](
    Label) -> (
    Data: Bool(structure_type: GRID),
    Name: String(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    Shape: Vector(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE))
  separate_bundle_3 = SeparateBundle[define_signature: true](
    Color) -> (
    Data: Vector(structure_type: GRID),
    Name: String(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    Shape: Vector(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE))
  menu_switch = MenuSwitch(menu: menu_menu, "Bounding Box": 0, Custom: 1)
  bounding_box_2 = BoundingBox(bounding_box)
  index_switch = IndexSwitch(menu_switch.output, bounding_box_2.min, Min)
  math = bioxel_size * 0.01
  vector_math = ceil(
    (IndexSwitch(menu_switch.output, bounding_box_2.max, Max) - index_switch) * (1.0 / math))
  vector_math_3 = vector_math * math @ hide
  vector_math_2 = index_switch + vector_math_3 @ hide
  get_named_grid = VolumeCube(
      min: index_switch,
      max: vector_math_2,
      resolution_x: vector_math.x,
      resolution_y: vector_math.y,
      resolution_z: vector_math.z)
    |> GetNamedGrid(name: "density")
  voxelize_grid = VoxelizeGrid(grid: get_named_grid.grid)
  prune_grid = PruneGrid(
    grid: SetGridBackground(
      grid: FieldToGrid(topology: voxelize_grid, Grid: SampleGrid(grid: separate_bundle.data)),
      background: GridInfo(grid: separate_bundle.data).background_value)) @ mute
  group = o_grid_info(grid: get_named_grid.grid)
  prune_grid_2 = PruneGrid[BOOLEAN](
    grid: SetGridBackground[BOOLEAN](
      grid: FieldToGrid(
        topology: voxelize_grid,
        Grid: SampleGrid[BOOLEAN](grid: separate_bundle_2.data)))) @ mute
  prune_grid_3 = PruneGrid[VECTOR](
    grid: SetGridBackground[VECTOR](
      grid: FieldToGrid(
        topology: voxelize_grid,
        Grid: SampleGrid[VECTOR](grid: separate_bundle_3.data)))) @ mute
  return (
    Layer: IndexSwitch(
      MenuSwitch(menu: Menu, Scalar: 0, Label: 1, Color: 2).output,
      CombineBundle[define_signature: true](
        Data(structure_type: GRID): prune_grid,
        Name: separate_bundle.name,
        Kind(structure_type: SINGLE): "scalar",
        Shape(structure_type: SINGLE): vector_math,
        ID(structure_type: SINGLE): separate_bundle.id,
        Min(structure_type: SINGLE): separate_bundle.min,
        Max(structure_type: SINGLE): separate_bundle.max),
      CombineBundle(
        Data(structure_type: GRID): prune_grid_2,
        Name: separate_bundle_2.name,
        Kind(structure_type: SINGLE): "label",
        Shape(structure_type: SINGLE): vector_math,
        ID(structure_type: SINGLE): separate_bundle_2.id),
      CombineBundle(
        Data(structure_type: GRID): prune_grid_3,
        Name: separate_bundle_3.name,
        Kind(structure_type: SINGLE): "color",
        Shape(structure_type: SINGLE): vector_math,
        ID(structure_type: SINGLE): separate_bundle_3.id)))
}
