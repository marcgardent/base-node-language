shader graph PT_RoseBoards(
    Vector: Vector(hide_value: true),
    Scale: Float = 2.0,
    Split: Bool = true
) -> (Position: Vector, UV: Vector, "UV oriented": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  vector_math_4 = normalize((1.0, 1.7320508, 0.0)) @ hide
  vector_math_6 = normalize((-1.0, 1.7320508, 0.0)) @ hide
  vector_math_8 = normalize((-1.0, -1.73205, 0.0)) @ hide
  vector_math_11 = normalize((1.0, -1.73205, 0.0)) @ hide
  "p6(16)" #311b4e {
    vector_math_13 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_15 = vector_math_13 / combine_xyz @ hide
    vector_math_14 = fract(vector_math_15) @ hide
    vector_math_12 = vector_math_14 - (0.5, 0.5, 0.0) @ hide
    vector_math_16 = vector_math_12 * combine_xyz @ hide
    vector_math_19 = combine_xyz * 0.5 @ hide
    vector_math_17 = vector_math_13 - vector_math_19 @ hide
    vector_math_18 = vector_math_17 / combine_xyz @ hide
    vector_math_20 = floor(vector_math_15) @ hide
    vector_math_21 = vector_math_20 * combine_xyz @ hide
    vector_math_22 = floor(vector_math_18) @ hide
    vector_math_23 = vector_math_22 * combine_xyz @ hide
    vector_math_24 = vector_math_23 + combine_xyz @ hide
    vector_math_26 = combine_xyz * 0.5 @ hide
    vector_math_25 = vector_math_21 + vector_math_26 @ hide
    vector_math_27 = abs(vector_math_16) @ hide
    vector_math_29 = vector_math_27 - (1.0, 0.0, 0.0) @ hide
    vector_math_28 = vector_math_29 ⋅ combine_xyz @ hide
    math_13 = vector_math_28 > 0.0 @ hide
    mix_2 = math_13 ? vector_math_24 : vector_math_25
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_13 - mix_2, angle: 1.0471976) @ hide
    math_14 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_16 = vector_rotate.y < 0.0 @ hide
    math_18 = math_16 * 6.2831855 @ hide
    math_17 = math_14 + math_18 @ hide
    math_15 = floor(MapRange(value: math_17, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_19 = math_15 * 5.2359877
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_19)
    math_20 = math_19 + 1.0471976
    math_21 = cos(math_20) @ hide
    math_22 = sin(math_20) @ hide
    combine_xyz_3 = CombineXYZ(x: math_22, y: math_21) @ hide
    math_23 = -math_22 @ hide
    combine_xyz_2 = CombineXYZ(x: math_21, y: math_23) @ hide
  }
  vector_math = vector_rotate_2 - (0.333333, 0.0, 0.0) @ hide
  math = vector_rotate_2.x - 0.16666667
  math_2 = vector_rotate_2.x - 0.33333334
  vector_math_2 = vector_rotate_2 - (0.5, 0.096225046, 0.0) @ hide
  vector_math_3 = vector_math ⋅ vector_math_4 @ hide
  vector_math_5 = vector_math ⋅ vector_math_6 @ hide
  vector_math_7 = vector_math_2 ⋅ vector_math_8 @ hide
  math_3 = min(vector_math_3, vector_math_5) @ hide
  math_4 = min(math_3, vector_math_7) @ hide
  vector_math_9 = vector_rotate_2 - (0.16666667, 0.28867513, 0.0) @ hide
  vector_math_10 = vector_math_9 ⋅ vector_math_11 @ hide
  math_7 = min(math_4, vector_math_10) @ hide
  math_5 = -math_7
  math_6 = abs(min(min(min(abs(math), abs(math_2)), math_5), 0.5))
  math_8 = math_5 < 0.0 @ hide
  math_9 = math < 0.0 @ hide
  math_10 = math_2 > 0.0 @ hide
  math_11 = vector_math_7 < 0.0 @ hide
  math_12 = vector_math_7 < 0.0 @ hide
  mix = math_8
    ? (0.25, 0.14433756, 0.0)
    : math_10
      ? (math_11 ? (0.5, 0.288675, 0.0) : (0.5, 0.0, 0.0))
      : Mix[VECTOR, clamp_factor: false](
        factor: math_9,
        a: math_12 ? (0.25, 0.4330127, 0.0) : (0.25, -0.144338, 0.0))
  math_24 = math_3 < 0.0 @ hide
  math_25 = max(min(math_9, math_24), min(math_10, math_11))
  vector_math_34 = normalize((1.0, -1.73205, 0.0)) @ hide
  vector_math_33 = Vector ⋅ vector_math_34 @ hide
  vector_math_36 = normalize((1.0, 1.7320508, 0.0)) @ hide
  vector_math_35 = Vector ⋅ vector_math_36 @ hide
  math_27 = 0.25 / Scale
  math_26 = Math[PINGPONG](Value: vector_math_33 + math_27, Value_001: math_27)
  math_28 = 0.083333336 / Scale
  math_30 = Vector.x + math_27
  vector_math_30 = combine_xyz_2 * mix.x
    + combine_xyz_3 * mix.y
    + CombineXYZ(
      x: math_25 * ((mod(math_30, math_27 / 0.5) > math_27 ? 1.0 : -1.0) * 0.074074075 * Split))
    + mix_2
  vector_math_32 = vector_math_30 / Scale
  vector_math_31 = Vector - vector_math_32
  math_29 = Math[PINGPONG](Value: math_30, Value_001: math_27)
  math_31 = Math[PINGPONG](Value: vector_math_35 + math_27, Value_001: math_27) > math_28 @ hide
  math_32 = math_26 > math_28 @ hide
  math_34 = math_26 < math_28 @ hide
  math_33 = max(math_31, math_34)
  math_35 = max(math_32, math_29 < math_28)
  vector_math_37 = vector_math_30 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_32,
    UV: vector_math_31,
    "UV oriented": VectorRotate(
      vector: vector_math_31,
      angle: Mix(factor: math_33, a: 0.5235988, b: Mix(factor: math_35, a: 1.0471976))),
    Color: WhiteNoiseTexture(vector: vector_math_37).color,
    Edge: (Split
        ? min(
          math_6,
          MapRange(value: math_29, from_max: math_27, to_min: math_27, to_max: 0.0) * Scale
            + Mix(factor: math_25, a: 1.0))
        : math_6)
      / Scale,
    Masks: Mix(
      factor: math_25,
      a: Mix(factor: math_33, a: 1.0, b: Mix(factor: math_35, a: 3.0, b: 2.0))))
}
