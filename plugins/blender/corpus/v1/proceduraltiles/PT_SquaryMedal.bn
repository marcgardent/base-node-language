shader graph PT_SquaryMedal(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0,
    "Outer thickness": Float(subtype: FACTOR) = 0.125 in 0.0..1.0,
    "Inner thickness": Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Position: Vector, UV: Vector, "UV center": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p4m(11)" #7b2a1b {
    vector_math = Vector * Scale
    vector_math_2 = fract(vector_math) - (0.5, 0.5, 0.0)
    vector_math_3 = abs(vector_math_2)
    vector_math_4 = floor(vector_math) + (0.5, 0.5, 0.0) @ hide
    math_25 = sign(vector_math_2.x) @ hide
    math_26 = sign(vector_math_2.y) @ hide
    vector_math_5 = (1.0, 0.0, 0.0) * math_25 @ hide
    vector_math_6 = (0.0, 1.0, 0.0) * math_26 @ hide
    math_27 = vector_math_3.x - vector_math_3.y < 0.0
    mix_2 = math_27 ? vector_math_6 : vector_math_5 @ hide
    mix_3 = math_27 ? vector_math_5 : vector_math_6 @ hide
    mix_4 = math_27 ? CombineXYZ(x: vector_math_3.y, y: vector_math_3.x) : vector_math_3
  }
  separate_xyz = SeparateXYZ(vector: mix_4) @ hide
  math = separate_xyz.x - separate_xyz.y @ hide
  math_5 = math / 1.41421 @ hide
  math_30 = outer_thickness - 0.5 @ hide
  math_29 = abs(math_30) @ hide
  math_31 = 0.5 - math_29 @ hide
  math_21 = math_31 - 0.5 @ hide
  math_16 = separate_xyz.x + math_21 @ hide
  math_11 = -math_16 @ #752828 hide
  math_22 = 0.5 - math_31 @ hide
  map_range = MapRange(value: inner_thickness, from_min: 1.0, from_max: 0.0, to_max: math_22)
  math_3 = separate_xyz.y - map_range @ #752828 hide
  math_6 = max(math_5, math_3) @ hide
  math_8 = abs(math_3) @ hide
  math_18 = 0.5 - map_range @ hide
  math_2 = math - math_18 @ hide
  math_17 = math_2 + math_31 @ hide
  math_4 = math_17 / 1.41421 @ #752828 hide
  math_7 = abs(math_4) @ hide
  math_9 = min(math_7, math_8) @ hide
  math_10 = min(math_9, math_6) @ hide
  math_12 = min(math_10, math_11) @ hide
  math_13 = abs(math_12) @ hide
  math_14 = max(separate_xyz.y, math_4) @ hide
  math_15 = min(math_13, math_14) @ hide
  math_19 = math_4 < 0.0 @ hide
  math_20 = math_3 > 0.0 @ hide
  math_23 = Math[MULTIPLY_ADD](Value: map_range - math_31, Value_002: 0.25)
  math_24 = 0.5 - math_31
  mix = math_20
    ? CombineXYZ(x: math_23, y: math_23)
    : math_19
      ? CombineXYZ(x: math_24, y: map_range) * 0.5
      : CombineXYZ(x: math_24 - map_range * 0.33333334)
  math_28 = math_11 < 0.0 @ hide
  math_32 = 0.5 > outer_thickness @ hide
  math_45 = 0.5 - math_31 @ hide
  math_49 = math_31 / 2.0 @ hide
  math_50 = 0.5 - math_49 @ hide
  combine_xyz = CombineXYZ(x: math_49, y: math_50) @ hide
  math_51 = -math_49 @ "-1" hide
  combine_xyz_2 = CombineXYZ(x: math_50, y: math_51) @ hide
  combine_xyz_3 = CombineXYZ(x: math_50, y: math_49) @ hide
  combine_xyz_4 = CombineXYZ(x: math_51, y: math_50) @ hide
  "p4(10)" #7b2a1b {
    vector_math_7 = Vector * Scale
    vector_math_8 = fract(vector_math_7) - (0.5, 0.5, 0.0)
    vector_math_9 = abs(vector_math_8)
    math_53 = sign(vector_math_8.x * vector_math_8.y)
    separate_xyz_2 = SeparateXYZ(vector: vector_math_9) @ hide
    combine_xyz_5 = CombineXYZ(x: separate_xyz_2.y, y: separate_xyz_2.x) @ hide
    mix_9 = Mix[VECTOR](factor: math_53, a: combine_xyz_5, b: vector_math_9)
    vector_math_10 = floor(vector_math_7) + (0.5, 0.5, 0.0) @ hide
    math_54 = sign(vector_math_8.x) @ hide
    math_55 = sign(vector_math_8.y) @ hide
    vector_math_11 = (1.0, 0.0, 0.0) * math_54 @ hide
    vector_math_12 = (0.0, 1.0, 0.0) * math_55 @ hide
    mix_10 = Mix[VECTOR](factor: math_53, a: vector_math_12, b: vector_math_11) @ hide
    mix_11 = Mix[VECTOR](factor: math_53, a: vector_math_11, b: vector_math_12) @ hide
  }
  map_range_2 = MapRange[FLOAT_VECTOR](
    vector: mix_9,
    from_max: (0.5, 0.5, 0.0),
    to_min: (0.5, 0.5, 0.0),
    to_max: (0.0, 0.0, 0.0)) @ hide
  math_33 = map_range_2.x - math_31 @ hide
  math_34 = map_range_2.y - math_31 @ hide
  math_35 = abs(math_33) @ hide
  math_36 = min(math_35, math_34) @ hide
  math_38 = abs(math_36) @ hide
  math_39 = abs(math_34) @ hide
  math_37 = min(math_39, math_33) @ hide
  math_40 = abs(math_37) @ hide
  math_41 = mix_9.x + math_45 @ hide
  math_42 = min(math_38, math_41) @ hide
  math_44 = mix_9.y + math_45 @ hide
  math_43 = min(math_40, math_44) @ hide
  mix_5 = math_32 ? math_43 : math_42 @ hide
  math_46 = min(map_range_2.x, map_range_2.y) @ hide
  math_47 = min(math_46, mix_5) @ hide
  math_48 = math_34 < 0.0 @ hide
  mix_6 = math_48 ? combine_xyz : combine_xyz_2 @ hide
  math_52 = math_33 < 0.0 @ hide
  mix_8 = math_52 ? combine_xyz_3 : combine_xyz_4 @ hide
  mix_7 = Mix[VECTOR, clamp_factor: false](factor: math_32, a: mix_6, b: mix_8)
  vector_math_13 = (math_28 ? mix_10 * mix_7.x + mix_11 * mix_7.y : mix_2 * mix.x + mix_3 * mix.y)
    + vector_math_4
  vector_math_14 = vector_math_13 / Scale
  vector_math_15 = Vector - vector_math_14
  math_56 = math_4 > 0.0 @ hide
  math_57 = math_3 > 0.0 @ hide
  math_58 = separate_xyz.x + separate_xyz.y @ hide
  math_59 = math_58 / 1.4142135 @ hide
  combine_xyz_6 = CombineXYZ(x: math_59, y: math_7) @ hide
  math_60 = math_4 < 0.0 @ hide
  math_61 = math_3 > 0.0 @ hide
  separate_xyz_3 = SeparateXYZ(vector: map_range_2) @ hide
  math_62 = -separate_xyz_3.y @ hide
  combine_xyz_7 = CombineXYZ(x: math_62, y: separate_xyz_3.x) @ hide
  return (
    Position: vector_math_14,
    UV: math_28
      ? Mix[VECTOR, clamp_factor: false](
          factor: math_32,
          a: math_48 ? map_range_2 : combine_xyz_7 - (-1.0, 0.0, 0.0),
          b: math_52 ? map_range_2 : -combine_xyz_7 - (0.0, -1.0, 0.0))
        / Scale
      : Mix[VECTOR](factor: max(math_56, math_57), a: combine_xyz_6 / Scale, b: vector_math_15),
    "UV center": vector_math_15,
    Color: WhiteNoiseTexture(vector: vector_math_13 + (1000.0, 1000.0, 0.0)).color,
    Edge: (math_28 ? math_47 : math_15) / Scale,
    Masks: math_28 ? 3.0 : math_61 ? 2.0 : math_60 ? 0.0 : 1.0)
}
