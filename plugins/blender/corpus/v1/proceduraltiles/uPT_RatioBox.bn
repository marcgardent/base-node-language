shader graph uPT_RatioBox(
    Vector: Vector(hide_value: true),
    Width: Float = 4.0,
    Height: Float = 3.0
) -> (Vector: Vector, Vector as vector_vector: Vector) {
  "PT Utils"
  vector_math_2 = CombineXYZ(x: Height, y: Width) / min(Width, Height)
  vector_math = Vector * vector_math_2
  return (
    Vector: fract(vector_math) / vector_math_2,
    vector_vector: floor(vector_math) / vector_math_2)
}
