shader graph PT_SquaryFlower(
    Vector: Vector(hide_value: true),
    Scale: Float = 5.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  value = 0.653265
  "p4m(11)" #7b2a1b {
    vector_math = Vector * Scale
    vector_math_2 = fract(vector_math) - (0.5, 0.5, 0.0)
    vector_math_3 = abs(vector_math_2)
    vector_math_4 = floor(vector_math) + (0.5, 0.5, 0.0) @ hide
    math_7 = sign(vector_math_2.x) @ hide
    math_8 = sign(vector_math_2.y) @ hide
    vector_math_5 = (1.0, 0.0, 0.0) * math_7 @ hide
    vector_math_6 = (0.0, 1.0, 0.0) * math_8 @ hide
    math_9 = vector_math_3.x - vector_math_3.y < 0.0
    mix_2 = math_9 ? vector_math_6 : vector_math_5 @ hide
    mix_3 = math_9 ? vector_math_5 : vector_math_6 @ hide
    mix_4 = math_9 ? CombineXYZ(x: vector_math_3.y, y: vector_math_3.x) : vector_math_3
  }
  math = length(mix_4 - (1.10353, 0.25, 0.0)) - value
  math_2 = length(mix_4 - (0.25, -0.603553, 0.0)) - value
  math_3 = length(mix_4 - (-0.353553, 0.853553, 0.0)) - 0.92388
  math_4 = math < 0.0 @ hide
  math_5 = math_2 < 0.0 @ hide
  math_6 = math_3 < 0.0 @ hide
  mix = math_4
    ? (0.5, 0.25, 0.0)
    : math_5 ? (0.25, 0.0, 0.0) : math_6 ? (0.25, 0.25, 0.0) : (0.351533, 0.14846635, 0.0)
  vector_math_7 = mix_2 * mix.x + mix_3 * mix.y + vector_math_4
  vector_math_8 = vector_math_7 / Scale
  math_10 = math < 0.0 @ hide
  math_11 = math_2 < 0.0 @ hide
  math_12 = math_3 < 0.0 @ hide
  return (
    Position: vector_math_8,
    UV: Vector - vector_math_8,
    Color: WhiteNoiseTexture(vector: vector_math_7).color,
    Edge: abs(min(min(math, math_2), math_3)) / Scale,
    Masks: math_10 ? 3.0 : math_11 ? 2.0 : math_12 ? 1.0 : 0.0)
}
