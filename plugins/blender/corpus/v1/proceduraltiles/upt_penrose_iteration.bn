shader graph ".matmul2x2"(
    Vector: Vector in -10000.0..10000.0,
    "Vector x": Vector in -10000.0..10000.0,
    "Vector y": Vector in -10000.0..10000.0
) -> Vector {
  separate_xyz = SeparateXYZ(vector: Vector) @ hide
  vector_math = vector_x * separate_xyz.x @ hide
  vector_math_2 = vector_y * separate_xyz.y @ hide
  vector_math_3 = vector_math + vector_math_2 @ hide
  return vector_math_3
}

shader graph ".uPT_Penrose_iteration"(
    useIter: Bool,
    q: Vector(hide_value: true),
    type: Float(hide_value: true),
    "final_m" {
        x: Vector(hide_value: true),
        y: Vector(hide_value: true)
    }
) -> (
    q: Vector,
    type: Float,
    "final_m" {
        x: Vector,
        y: Vector
    }
) {
  {
    "consts" {
      value = 1.3763819 @ "d1" hide
      value_2 = 0.32492 @ "d2" hide
      value_3 = 0.618034 @ "a1" hide
      value_4 = 0.809017 @ "a2" hide
      value_5 = 0.58778524 @ "a3" hide
    }
    {
      math_2 = 1.0 - value * q.y - q.x
      math_5 = 1.0 - value_2 * q.y - q.x
    }
    "if (1.0 - d1*q.y - q.x > 0.0)" #9b9b9b {
      math_3 = math_2 > 0.0 @ hide
    }
    "else if (1.0 - d2*q.y - q.x > 0.0)" #9b9b9b {
      math_4 = math_5 > 0.0 @ hide
    }
    {
      vector_math = q - (1.0, 0.0, 0.0)
      vector_math_2 = q - CombineXYZ(x: value_4, y: value_5)
      vector_math_3 = q - CombineXYZ(x: value_3 + 1.0)
    }
    "else if (1.0 - d2*q.y - q.x > 0.0)" .. {
      mix_9 = math_4 ? vector_math_2 : vector_math_3 @ "q"
    }
    "if (1.0 - d1*q.y - q.x > 0.0)" .. {
      mix_8 = math_3 ? vector_math : mix_9 @ "q"
    }
    {
      math_6 = 1.0 - type
      math_7 = 3.0 - type
    }
    "else if (1.0 - d2*q.y - q.x > 0.0)" .. {
      mix_3 = math_4 ? math_7 : type @ "type"
    }
    "if (1.0 - d1*q.y - q.x > 0.0)" .. {
      mix_2 = math_3 ? math_6 : mix_3 @ "type"
    }
    "consts" {
      value_6 = -0.809017 @ "cos1" hide
      value_7 = 0.58778524 @ "sin1" hide
    }
    "else" {
      combine_xyz_2 = CombineXYZ(x: value_7, y: value_6)
    }
    "else if (1.0 - d2*q.y - q.x > 0.0)" .. {
      math_8 = -value_7 @ hide
      mix_7 = math_4 ? CombineXYZ(x: math_8, y: value_6) : combine_xyz_2 @ "m.y"
    }
    "if (1.0 - d1*q.y - q.x > 0.0)" .. {
      mix_5 = math_3 ? (0.0, 1.0, 0.0) : mix_7 @ "m.y"
    }
    "else" .. {
      combine_xyz = CombineXYZ(x: value_6, y: math_8)
    }
    "else if (1.0 - d2*q.y - q.x > 0.0)" .. {
      mix_6 = math_4 ? CombineXYZ(x: value_6, y: value_7) : combine_xyz @ "m.x"
    }
    "if (1.0 - d1*q.y - q.x > 0.0)" .. {
      mix_4 = math_3 ? (-1.0, 0.0, 0.0) : mix_6 @ "m.x"
    }
  }
  {
    math = type < 2.0 @ hide
  }
  {
    "consts" {
      value_8 = 1.3763819 @ "d1" hide
      value_11 = 0.618034 @ "a1" hide
    }
    separate_xyz = SeparateXYZ(vector: q)
    math_9 = value_8 * separate_xyz.y - separate_xyz.x
    #9b9b9b {
      math_10 = math_9 > 0.0 @ hide
      "consts" {
        value_9 = -0.309017 @ "cos2" hide
        value_10 = 0.95105654 @ "sin2" hide
      }
      mix_12 = math_10
        ? CombineXYZ(x: value_10, y: value_9)
        : CombineXYZ(x: value_10, y: value_9) @ "m.y"
      math_12 = -value_10 @ hide
      math_13 = -value_9 @ hide
      mix_11 = math_10
        ? CombineXYZ(x: math_13, y: value_10)
        : CombineXYZ(x: value_9, y: math_12) @ "m.x"
    }
    {
      math_11 = type - 2.0
    }
    #9b9b9b {
      mix_10 = math_10 ? math_11 : type @ "type"
    }
    vector_math_4 = q - CombineXYZ(x: value_11)
    .. {
      mix_13 = math_10 ? q : vector_math_4 @ "q"
    }
  }
  {
    mix = math ? mix_2 : mix_10 @ "if (0)"
    mix_14 = math ? mix_4 : mix_11 @ "m.x"
    mix_15 = math ? mix_5 : mix_12 @ "m.y"
    mix_16 = math ? mix_8 : mix_13 @ "q"
  }
  "consts" {
    value_12 = 1.618034 @ "sc" hide
  }
  mix_17 = useIter ? mix : type @ "if (0)"
  mix_18 = useIter ? matmul2x2(vector: x, vector_x: mix_14, vector_y: mix_15) : x @ "m.x"
  mix_19 = useIter ? matmul2x2(vector: y, vector_x: mix_14, vector_y: mix_15) : y @ "m.y"
  mix_20 = useIter
    ? matmul2x2(vector: mix_16, vector_x: mix_14, vector_y: mix_15) * value_12
    : q @ "q"
  return (q: mix_20, type: mix_17, x: mix_18, y: mix_19)
}
