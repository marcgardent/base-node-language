shader graph "WPG_12(p4g)"(
    Vector: Vector(hide_value: true),
    scale: Float = 5.0
) -> (UV: Vector, position: Vector, mx: Vector, my: Vector) {
  "Wallpaper group tile pattern more on :https://en.wikipedia.org/wiki/Wallpaper_group"
  "p4g(12)" #7b2a1b {
    vector_math = Vector * scale
    vector_math_2 = fract(vector_math) - (0.5, 0.5, 0.0)
    vector_math_3 = abs(vector_math_2)
    vector_math_4 = floor(vector_math) @ hide
    vector_math_5 = vector_math_4 + (0.5, 0.5, 0.0) @ hide
    math = sign(vector_math_2.x) @ hide
    math_2 = sign(vector_math_2.y) @ hide
    vector_math_6 = (1.0, 0.0, 0.0) * math @ hide
    vector_math_7 = (0.0, 1.0, 0.0) * math_2 @ hide
    math_3 = vector_math_3.x + vector_math_3.y > 0.5
    mix = math_3 ? vector_math_7 : vector_math_6 @ hide
    mix_2 = math_3 ? vector_math_6 : vector_math_7 @ hide
    map_range = MapRange[FLOAT_VECTOR](
      vector: vector_math_3,
      from_max: (0.5, 0.5, 0.0),
      to_min: (0.5, 0.5, 0.0),
      to_max: (0.0, 0.0, 0.0)) @ hide
    separate_xyz = SeparateXYZ(vector: map_range) @ hide
    combine_xyz = CombineXYZ(x: separate_xyz.y, y: separate_xyz.x) @ hide
    mix_3 = math_3 ? combine_xyz : vector_math_3
    vector_math_9 = vector_math + (0.5, 0.5, 0.0) @ hide
    vector_math_8 = floor(vector_math_9) @ hide
    mix_4 = math_3 ? vector_math_8 : vector_math_5
    map_range_2 = MapRange(value: math_3, from_min: 1.0, from_max: 0.0, to_min: -1.0) @ hide
    vector_math_10 = mix * map_range_2 @ hide
    vector_math_11 = mix_2 * map_range_2 @ hide
  }
  return (UV: mix_3, position: mix_4, mx: vector_math_10, my: vector_math_11)
}
