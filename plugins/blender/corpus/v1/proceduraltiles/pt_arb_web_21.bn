shader graph "PT_ARB_Web(21)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p6m(17)" #311b4e {
    vector_math_8 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_10 = vector_math_8 / combine_xyz @ hide
    vector_math_9 = fract(vector_math_10) @ hide
    vector_math_7 = vector_math_9 - (0.5, 0.5, 0.0) @ hide
    vector_math_11 = vector_math_7 * combine_xyz @ hide
    vector_math_14 = combine_xyz * 0.5 @ hide
    vector_math_12 = vector_math_8 - vector_math_14 @ hide
    vector_math_13 = vector_math_12 / combine_xyz @ hide
    vector_math_15 = floor(vector_math_10) @ hide
    vector_math_16 = vector_math_15 * combine_xyz @ hide
    vector_math_17 = floor(vector_math_13) @ hide
    vector_math_18 = vector_math_17 * combine_xyz @ hide
    vector_math_19 = vector_math_18 + combine_xyz @ hide
    vector_math_21 = combine_xyz * 0.5 @ hide
    vector_math_20 = vector_math_16 + vector_math_21 @ hide
    vector_math_22 = abs(vector_math_11) @ hide
    vector_math_24 = vector_math_22 - (1.0, 0.0, 0.0) @ hide
    vector_math_23 = vector_math_24 ⋅ combine_xyz @ hide
    math_2 = vector_math_23 > 0.0 @ hide
    mix = math_2 ? vector_math_19 : vector_math_20
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_8 - mix, angle: 1.0471976) @ hide
    math_3 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_5 = vector_rotate.y < 0.0 @ hide
    math_7 = math_5 * 6.2831855 @ hide
    math_6 = math_3 + math_7 @ hide
    map_range = MapRange(value: math_6, from_max: 6.2831855, to_max: 6.0)
    math_4 = floor(map_range) @ hide
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_4 * 5.2359877)
    separate_xyz = SeparateXYZ(
      vector: VectorRotate[Z_AXIS](vector: vector_rotate_2, angle: 0.5235988)) @ hide
    math_11 = map_range * 2.0 @ hide
    math_12 = floor(math_11) @ hide
    math_13 = Math[FLOORED_MODULO](Value: math_12, Value_001: 2.0)
    combine_xyz_4 = CombineXYZ(
      x: Mix(factor: math_13, a: vector_rotate_2.x, b: separate_xyz.y),
      y: Mix(factor: math_13, a: vector_rotate_2.y, b: separate_xyz.x))
    math_14 = math_6 - 0.5235988 @ hide
    math_15 = Math[FLOORED_MODULO](Value: math_14, Value_001: 6.2831855) @ hide
    math_16 = floor(MapRange(value: math_15, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_17 = math_16 * 5.2359877
    math_8 = cos(math_17) @ hide
    math_9 = sin(math_17) @ hide
    combine_xyz_3 = CombineXYZ(x: math_9, y: math_8) @ hide
    math_10 = -math_9 @ hide
    combine_xyz_2 = CombineXYZ(x: math_8, y: math_10) @ hide
    vector_math_25 = combine_xyz_3 * MapRange(value: math_13, to_min: 1.0, to_max: -1.0)
  }
  vector_math = combine_xyz_4 - (0.16666667, 0.0, 0.0)
  vector_math_2 = combine_xyz_4 - (0.33333334, 0.096225046, 0.0)
  vector_math_3 = combine_xyz_4 - (0.3888889, 0.19245009, 0.0)
  vector_math_4 = vector_math ⋅ normalize(CombineXYZ(x: 1.0, y: 1.7320508))
  vector_math_5 = vector_math_2 ⋅ normalize(CombineXYZ(x: 1.0, y: 1.7320508))
  vector_math_6 = vector_math_2 ⋅ normalize(CombineXYZ(x: -1.7320508, y: 1.0))
  math = max(
    max(-(vector_math ⋅ normalize(CombineXYZ(x: -1.0, y: 1.7320508))), -vector_math_4),
    combine_xyz_4.x - 0.25)
  math_18 = vector_math_6 < 0.0 @ hide
  math_19 = vector_math_3.y > 0.0 @ hide
  math_20 = vector_math_5 < 0.0 @ hide
  math_21 = vector_math_4 < 0.0 @ hide
  math_22 = math < 0.0 @ hide
  mix_2 = math_18
    ? (math_19
      ? (0.5, 0.28867513, 0.0)
      : math_20 ? (0.37037036, 0.0, 0.0) : (0.5, 0.112262554, 0.0))
    : math_19
      ? (0.375, 0.21650635, 0.0)
      : math_20
        ? (math_22
          ? (0.16666667, 0.096225046, 0.0)
          : math_21 ? (0.0, 0.0, 0.0) : (0.26719576, 0.0, 0.0))
        : (0.29166666, 0.16839384, 0.0)
  vector_math_26 = combine_xyz_2 * mix_2.x + vector_math_25 * mix_2.y + mix
  vector_math_27 = vector_math_26 / Scale
  return (
    Position: vector_math_27,
    UV: Vector - vector_math_27,
    Color: WhiteNoiseTexture(vector: vector_math_26 + (1000.0, 1000.0, 0.0)).color,
    Edge: abs(min(math, min(min(abs(vector_math_5), abs(vector_math_6)), abs(vector_math_3.y))))
      / Scale,
    Masks: math_18
      ? (math_19 ? 7.0 : math_20 ? 4.0 : 5.0)
      : math_19 ? 6.0 : math_20 ? (math_22 ? 1.0 : math_21 ? 0.0 : 2.0) : 3.0)
}
