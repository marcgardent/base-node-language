shader graph PT_SquaryOctstar(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p4m(11)" #7b2a1b {
    vector_math_2 = Vector * Scale
    vector_math_3 = fract(vector_math_2) - (0.5, 0.5, 0.0)
    vector_math_4 = abs(vector_math_3)
    vector_math_5 = floor(vector_math_2) + (0.5, 0.5, 0.0) @ hide
    math_2 = sign(vector_math_3.x) @ hide
    math_3 = sign(vector_math_3.y) @ hide
    vector_math_6 = (1.0, 0.0, 0.0) * math_2 @ hide
    vector_math_7 = (0.0, 1.0, 0.0) * math_3 @ hide
    math_4 = vector_math_4.x - vector_math_4.y < 0.0
    mix = math_4 ? vector_math_7 : vector_math_6 @ hide
    mix_2 = math_4 ? vector_math_6 : vector_math_7 @ hide
    mix_3 = math_4 ? CombineXYZ(x: vector_math_4.y, y: vector_math_4.x) : vector_math_4
  }
  vector_math = mix_3 ⋅ (-0.382683, 0.92388, 0.0)
  math = -min(mix_3.x - 0.35355338, (mix_3.x + mix_3.y - 0.5) / 1.4142135)
  math_5 = math < 0.0 @ hide
  math_6 = vector_math < 0.0 @ hide
  mix_4 = math_5
    ? (0.437111, 0.25016984, 0.0)
    : math_6 ? (0.28470352, 0.04889247, 0.0) : (0.23607375, 0.16692933, 0.0)
  vector_math_8 = mix * mix_4.x + mix_2 * mix_4.y + vector_math_5
  vector_math_9 = vector_math_8 / Scale
  math_7 = math < 0.0 @ hide
  math_8 = vector_math < 0.0 @ hide
  return (
    Position: vector_math_9,
    UV: Vector - vector_math_9,
    Color: WhiteNoiseTexture(vector: vector_math_8).color,
    Edge: min(
        min((mix_3.x - mix_3.y) / 1.4142135, mix_3.y),
        min(
          MapRange(value: mix_3.x, from_max: 0.5, to_min: 0.5, to_max: 0.0),
          abs(min(math, abs(vector_math)))))
      / Scale,
    Masks: math_7 ? 0.0 : math_8 ? 2.0 : 1.0)
}
