shader graph PT_TCH_QuarterDisk(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    Seed: Int
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  {
    vector_math = Vector * Scale
    vector_math_2 = fract(vector_math)
    vector_math_3 = floor(vector_math)
    math = Math[SNAP](Value: WhiteNoiseTexture(vector: vector_math_3 + Seed).value, Value_001: 0.25)
      * 6.2831855
    vector_rotate = VectorRotate[invert: true](
      vector: vector_math_2,
      center: (0.5, 0.5, 0.0),
      angle: math)
  }
  math_2 = length(vector_rotate) - 1.0
  math_3 = math_2 > 0.0
  {
    math_4 = Math[PINGPONG](Value: vector_math_2.x) @ hide
    math_5 = Math[PINGPONG](Value: vector_math_2.y) @ hide
    math_6 = min(math_4, math_5)
  }
  value = 0.223
  vector_math_4 = VectorRotate(
      vector: math_3 ? (0.776632, 0.776632, 0.0) : (0.42441317, 0.42441317, 0.0),
      center: (0.5, 0.5, 0.0),
      angle: math)
    + vector_math_3
  vector_math_5 = vector_math_4 / Scale
  vector_math_6 = vector_math_4 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_5,
    UV: Vector - vector_math_5,
    Color: WhiteNoiseTexture(vector: vector_math_6).color,
    Edge: min(abs(math_2), math_6) / Scale,
    Masks: math_3)
}
