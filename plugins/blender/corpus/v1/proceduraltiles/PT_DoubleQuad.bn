shader graph PT_DoubleQuad(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    "Quad ratio": Float(subtype: FACTOR) = 0.33 in 0.0..1.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  math_5 = quad_ratio / 2.0
  math_6 = Math[MULTIPLY_ADD](Value: quad_ratio)
  vector_math = Vector * Scale
  vector_math_2 = fract(vector_math)
  map_range = MapRange[FLOAT_VECTOR](
    vector: vector_math_2,
    from_max: (1.0, 1.0, 0.0),
    to_min: (1.0, 1.0, 0.0),
    to_max: (0.0, 0.0, 0.0))
  math = vector_math_2.x - quad_ratio
  math_2 = vector_math_2.y - quad_ratio
  math_3 = math > 0.0
  math_4 = math_2 > 0.0
  vector_math_3 = CombineXYZ(x: math_3 ? math_6 : math_5, y: math_4 ? math_6 : math_5)
    + floor(vector_math)
  vector_math_4 = vector_math_3 / Scale
  vector_math_5 = vector_math_3 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_4,
    UV: Vector - vector_math_4,
    Color: WhiteNoiseTexture(vector: vector_math_5).color,
    Edge: min(
        min(abs(math), abs(math_2)),
        min(min(vector_math_2.x, vector_math_2.y), min(map_range.x, map_range.y)))
      / Scale,
    Masks: Math[ADD](
      Value: Mix[RGBA, DIFFERENCE, clamp_result: true](a: math_3, b: math_4),
      Value_001: min(math_3, math_4) * 2.0))
}
