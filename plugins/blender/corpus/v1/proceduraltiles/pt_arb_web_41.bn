shader graph "PT_ARB_Web(41)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  vector_math_4 = normalize((0.18301271, 0.5, 0.0)) @ hide
  "p6m(17)" #311b4e {
    vector_math_9 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_11 = vector_math_9 / combine_xyz @ hide
    vector_math_10 = fract(vector_math_11) @ hide
    vector_math_8 = vector_math_10 - (0.5, 0.5, 0.0) @ hide
    vector_math_12 = vector_math_8 * combine_xyz @ hide
    vector_math_15 = combine_xyz * 0.5 @ hide
    vector_math_13 = vector_math_9 - vector_math_15 @ hide
    vector_math_14 = vector_math_13 / combine_xyz @ hide
    vector_math_16 = floor(vector_math_11) @ hide
    vector_math_17 = vector_math_16 * combine_xyz @ hide
    vector_math_18 = floor(vector_math_14) @ hide
    vector_math_19 = vector_math_18 * combine_xyz @ hide
    vector_math_20 = vector_math_19 + combine_xyz @ hide
    vector_math_22 = combine_xyz * 0.5 @ hide
    vector_math_21 = vector_math_17 + vector_math_22 @ hide
    vector_math_23 = abs(vector_math_12) @ hide
    vector_math_25 = vector_math_23 - (1.0, 0.0, 0.0) @ hide
    vector_math_24 = vector_math_25 ⋅ combine_xyz @ hide
    math_3 = vector_math_24 > 0.0 @ hide
    mix = math_3 ? vector_math_20 : vector_math_21
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_9 - mix, angle: 1.0471976) @ hide
    math_4 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_6 = vector_rotate.y < 0.0 @ hide
    math_8 = math_6 * 6.2831855 @ hide
    math_7 = math_4 + math_8 @ hide
    map_range = MapRange(value: math_7, from_max: 6.2831855, to_max: 6.0)
    math_5 = floor(map_range) @ hide
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_5 * 5.2359877)
    separate_xyz = SeparateXYZ(
      vector: VectorRotate[Z_AXIS](vector: vector_rotate_2, angle: 0.5235988)) @ hide
    math_12 = map_range * 2.0 @ hide
    math_13 = floor(math_12) @ hide
    math_14 = Math[FLOORED_MODULO](Value: math_13, Value_001: 2.0)
    combine_xyz_4 = CombineXYZ(
      x: Mix(factor: math_14, a: vector_rotate_2.x, b: separate_xyz.y),
      y: Mix(factor: math_14, a: vector_rotate_2.y, b: separate_xyz.x))
    math_15 = math_7 - 0.5235988 @ hide
    math_16 = Math[FLOORED_MODULO](Value: math_15, Value_001: 6.2831855) @ hide
    math_17 = floor(MapRange(value: math_16, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_18 = math_17 * 5.2359877
    math_9 = cos(math_18) @ hide
    math_10 = sin(math_18) @ hide
    combine_xyz_3 = CombineXYZ(x: math_10, y: math_9) @ hide
    math_11 = -math_10 @ hide
    combine_xyz_2 = CombineXYZ(x: math_9, y: math_11) @ hide
    vector_math_26 = combine_xyz_3 * MapRange(value: math_14, to_min: 1.0, to_max: -1.0)
  }
  vector_math = combine_xyz_4 - (0.39433756, 0.105662435, 0.0)
  vector_math_2 = combine_xyz_4 - (0.28867513, 0.07735027, 0.0)
  vector_math_3 = combine_xyz_4 - (0.45534182, 0.21132487, 0.0)
  vector_math_5 = vector_math ⋅ normalize((1.0, 1.7320508, 0.0))
  vector_math_6 = vector_math ⋅ normalize((1.7320508, -1.0, 0.0))
  math = max(vector_math_2 ⋅ (0.707107, -0.70710677, 0.0), vector_math_2 ⋅ vector_math_4)
  math_2 = max(vector_math_3 ⋅ normalize((1.7320508, 1.0, 0.0)), vector_math_3.y)
  vector_math_7 = combine_xyz_4 ⋅ normalize((-1.0, 3.732051, 0.0))
  math_19 = vector_math_5 < 0.0 @ hide
  math_20 = vector_math_6 < 0.0 @ hide
  math_21 = math_2 < 0.0 @ hide
  math_22 = math < 0.0 @ hide
  math_23 = vector_math_7 < 0.0 @ hide
  mix_2 = math_19
