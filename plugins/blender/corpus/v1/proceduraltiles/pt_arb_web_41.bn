      : math_21 ? (0.45733616, 0.12254285, 0.0) : (0.5, 0.21132487, 0.0)
  vector_math_27 = combine_xyz_2 * mix_2.x + vector_math_26 * mix_2.y + mix
  vector_math_28 = vector_math_27 / Scale
  vector_math_29 = vector_math_27 + (1000.0, 1000.0, 0.0) @ hide
  return (
