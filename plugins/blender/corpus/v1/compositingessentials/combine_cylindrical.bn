compositor graph "Combine Cylindrical"(
    R: Float(description: "Radius - Length of the vector") in 0.0..10000.0,
    Phi: Float(
      subtype: ANGLE,
      description: "Azimuth - Angle around the up axis") in -3.1415927..3.1415927,
    Z: Float(description: "Offset from the ground plane") in -10000.0..10000.0
) -> Vector {
  return VectorRotate[Z_AXIS](vector: (1.0, 0.0, 0.0) * R, angle: Phi) + CombineXYZ(z: Z)
}
