compositor graph ".Noise Maschine 3.022"(
    "Image Coordinates": Vector(hide_value: true),
    "Image lemght": Float,
    "X Image Dimensions ": Float,
    "X Image Dimensions " as x_image_dimensions_float: Float,
    "L1 Scale": Float = 200.0 in -1000.0..1000.0,
    "L2 Scale": Float = 0.1 in -1000.0..1000.0,
    "L3 Scale": Float(description: "Scale of the base noise octave") = 0.0005 in -1000.0..1000.0
) -> ("Lvl 1": Color, "Lvl 1" as lvl_1_float: Float, "Lvl 2": Float, llvl3: Float) {
  voronoi_texture = VoronoiTexture(vector: image_coordinates, scale: l1_scale) @ "Level 1"
  "lvl 1 noise, small scale, base grain, " {
    hue_correct = HueCorrect[
      mapping: Curves(
        h: Curve(
          (0.083333336, 0.495),
          (0.25000033, 0.52),
          (0.41666633, 0.495),
          (0.5833333, 0.525),
          (0.75000036, 0.475),
          (0.91182435, 0.525)),
        s: Curve(
          (0.0, 0.6212966),
          (0.16666667, 0.55),
          (0.32849002, 0.4768518),
          (0.49757832, 0.46666676),
          (0.6545601, 0.6972219),
          (0.81396276, 0.45),
          (0.87651324, 0.45)),
        v: Curve(
          (0.25, 0.48),
          (0.33383757, 0.480741),
          (0.5024213, 0.39351824),
          (0.6153147, 0.5046296),
          (0.72154963, 0.50000024),
          (0.83232486, 0.3194441),
          (0.9588378, 0.47537),
          (1.0, 0.48)))](voronoi_texture.color)
    "Change the color profile without changing the withepoint" {}
    "color corection is very specific to the type/ brand of film" {}
    "This here looks a bit like codac gold or color plus " {}
  }
  "lvl2 Noise, med scale, Coarsness 170ms" {
    voronoi_texture_2 = VoronoiTexture(
      vector: image_coordinates,
      scale: l2_scale,
      roughness: 0.0,
      lacunarity: 0.0) @ "Level 2"
    mix = Mix[clamp_factor: false](
      factor: 0.5,
      a: voronoi_texture_2.distance,
      b: voronoi_texture_2.color)
    mix_2 = Mix(
      factor: 0.2,
      a: DilateErode(
        mask: mix,
        size: pow(
          RelativeToPixel[Smaller](value: 1.4 / l2_scale, image: voronoi_texture_2.color),
          0.9),
        type: Feather),
      b: mix)
    mix_3 = Mix(factor: 0.29090908, a: mix_2, b: pow(mix_2, 0.5) * 0.70000005 * 0.8)
  }
  "lvl 3 noise, large scale, low Unifomity" {
    "10ms" {
      math = Math[DIVIDE, use_clamp: true](Value: 1000.0, Value_001: image_lemght)
      noise_texture = NoiseTexture(
        vector: Scale(
          image_coordinates,
          x: math,
          y: math,
          extension_x: Extend,
          extension_y: Extend),
        scale: l3_scale,
        detail: 6.0,
        roughness: 0.95,
        lacunarity: 2.7182817,
        distortion: 0.1) @ "Level 3"
      math_2 = 1.0 / math
      float_curve = FloatCurve[
        mapping: Curve(
          (-10.0, 0.0, VECTOR),
          (-0.4, -1.1569, VECTOR),
          (-0.019272543, 0.22275017),
          (0.16753119, 0.29069427),
          (0.334201, 0.7338322),
          (0.52230465, 1.3137378, VECTOR),
          (0.66431254, 2.3632963, VECTOR),
          (0.92447007, 2.97963),
          (2.0, 3.70024, VECTOR),
          (10.0, 1.0, VECTOR),
          use_clip: false)](
        value: Scale(
          noise_texture.factor,
          x: math_2,
          y: math_2,
          extension_x: Repeat,
          extension_y: Repeat))
    }
  }
  "not affected by text scale " {}
  return (
    lvl_1: hue_correct,
    lvl_1_float: voronoi_texture.distance,
    "Lvl 2": mix_3,
    llvl3: float_curve)
}
