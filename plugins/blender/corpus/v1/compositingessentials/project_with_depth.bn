compositor graph "Project with Depth"(
    Normalized: Vector(subtype: FACTOR) = (0.5, 0.5) in -10000.0..10000.0,
    Depth: Float = 1.0 in -10000.0..10000.0,
    Projection: Matrix,
    Transform: Matrix,
    "Clip Start": Float(subtype: DISTANCE) = 0.1 in -10000.0..10000.0,
    "Clip End": Float(subtype: DISTANCE) = 100.0 in -10000.0..10000.0
) -> (Vector: Vector(subtype: XYZ)) {
  "Project Depth" {
    "(f + n) / (f - n)" {
      math = (clip_start + clip_end) / (clip_end - clip_start)
    }
    "2fn / Z*(f - n)" {
      math_3 = clip_start * clip_end * 2.0 / (Depth * (clip_end - clip_start))
    }
    math_2 = math - math_3
  }
  {
    vector_math = VectorMath[MULTIPLY_ADD](
      Vector: Normalized,
      Vector_001: (2.0, 2.0, 2.0),
      Vector_002: (-1.0, -1.0, -1.0)) @ "[0, 1] to [-1, 1] unclamped"
    transform_point = TransformPoint(
      vector: ProjectPoint(
        vector: CombineXYZ(x: vector_math.x, y: vector_math.y, z: math_2),
        transform: Projection),
      transform: Transform)
  }
  return (Vector: transform_point)
}
