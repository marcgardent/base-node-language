geometry graph ".deform curves"(
    Curves: Geometry,
    "Deform Surface": Geometry
) -> (Curves: Geometry) {
  "deformation" {
    position = Position() @ hide
    separate_components = SeparateComponents(Curves)
    domain_size = DomainSize[CURVE](separate_components.curve)
    boolean_math = not domain_size.point_count @ hide
    warning = Warning(show: boolean_math, message: "No Curves in Geometry")
  }
  "curve sample position" {
    position_2 = Position() @ hide
    evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
      value: position_2,
      index: PointsOfCurve().point_index) @ hide
    evaluate_on_domain = EvaluateOnDomain[CURVE, FLOAT_VECTOR](value: evaluate_at_index)
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rp").attribute,
      sample_position: evaluate_on_domain) @ hide
    sample_nearest_surface_2 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rn").attribute,
      sample_position: evaluate_on_domain) @ hide
    sample_nearest_surface_3 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rt").attribute,
      sample_position: evaluate_on_domain) @ hide
    axes_to_rotation = AxesToRotation(
      primary_axis: sample_nearest_surface_2.value,
      secondary_axis: sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(
      translation: sample_nearest_surface.value,
      rotation: axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dp").attribute,
      sample_position: evaluate_on_domain) @ hide
    sample_nearest_surface_5 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dn").attribute,
      sample_position: evaluate_on_domain) @ hide
    sample_nearest_surface_6 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dt").attribute,
      sample_position: evaluate_on_domain) @ hide
    axes_to_rotation_2 = AxesToRotation(
      primary_axis: sample_nearest_surface_5.value,
      secondary_axis: sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(
      translation: sample_nearest_surface_4.value,
      rotation: axes_to_rotation_2) @ hide
  }
  "deformation" .. {
    invert_matrix = InvertMatrix(matrix: combine_transform) @ hide
    multiply_matrices = MultiplyMatrices(
      Matrix: combine_transform_2,
      Matrix_001: invert_matrix.matrix) @ hide
    transform_point = TransformPoint(
      vector: position,
      transform: EvaluateOnDomain[CURVE, FLOAT4X4](value: multiply_matrices)) @ hide
    switch = Switch[GEOMETRY](
      switch: domain_size.point_count,
      true_: SetPosition(separate_components.curve, position: transform_point)) @ hide
  }
  return (Curves: switch)
}

geometry graph ".deform instances"(
    Instances: Geometry,
    "Deform Surface": Geometry
) -> (Instances: Geometry) {
  "deformation" {
    instance_transform = InstanceTransform() @ hide
    separate_components = SeparateComponents(Instances)
    domain_size = DomainSize[INSTANCES](separate_components.instances)
    boolean_math = not domain_size @ hide
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rp").attribute) @ hide
    sample_nearest_surface_2 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rn").attribute) @ hide
    sample_nearest_surface_3 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rt").attribute) @ hide
    axes_to_rotation = AxesToRotation(
      primary_axis: sample_nearest_surface_2.value,
      secondary_axis: sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(
      translation: sample_nearest_surface.value,
      rotation: axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dp").attribute) @ hide
    sample_nearest_surface_5 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dn").attribute) @ hide
    sample_nearest_surface_6 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dt").attribute) @ hide
    axes_to_rotation_2 = AxesToRotation(
      primary_axis: sample_nearest_surface_5.value,
      secondary_axis: sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(
      translation: sample_nearest_surface_4.value,
      rotation: axes_to_rotation_2) @ hide
  }
  "deformation" .. {
    invert_matrix = InvertMatrix(matrix: combine_transform) @ hide
    multiply_matrices_2 = MultiplyMatrices(
      Matrix: combine_transform_2,
      Matrix_001: invert_matrix.matrix) @ hide
    multiply_matrices = MultiplyMatrices(
      Matrix: multiply_matrices_2,
      Matrix_001: instance_transform) @ hide
    switch = Switch[GEOMETRY](
      switch: domain_size,
      true_: SetInstanceTransform(
        separate_components.instances,
        transform: multiply_matrices)) @ hide
  }
  warning = Warning(show: boolean_math, message: "No Instances in Geometry")
  return (Instances: switch)
}

geometry graph ".deform points"(Geometry: Geometry, "Deform Surface": Geometry) -> Geometry {
  "Surface Deformation" {
    position = Position() @ hide
    separate_components = SeparateComponents(Geometry)
  }
  "rest" {
    sample_nearest_surface = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rp").attribute) @ hide
    sample_nearest_surface_2 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rn").attribute) @ hide
    sample_nearest_surface_3 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "rt").attribute) @ hide
    axes_to_rotation = AxesToRotation(
      primary_axis: sample_nearest_surface_2.value,
      secondary_axis: sample_nearest_surface_3.value) @ hide
    combine_transform = CombineTransform(
      translation: sample_nearest_surface.value,
      rotation: axes_to_rotation) @ hide
  }
  "deform" {
    sample_nearest_surface_4 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dp").attribute) @ hide
    sample_nearest_surface_5 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dn").attribute) @ hide
    sample_nearest_surface_6 = SampleNearestSurface[FLOAT_VECTOR](
      deform_surface,
      value: NamedAttribute[FLOAT_VECTOR](name: "dt").attribute) @ hide
    axes_to_rotation_2 = AxesToRotation(
      primary_axis: sample_nearest_surface_5.value,
      secondary_axis: sample_nearest_surface_6.value) @ hide
    combine_transform_2 = CombineTransform(
      translation: sample_nearest_surface_4.value,
      rotation: axes_to_rotation_2) @ hide
  }
  "Surface Deformation" .. {
    invert_matrix = InvertMatrix(matrix: combine_transform) @ hide
    multiply_matrices = MultiplyMatrices(
      Matrix: combine_transform_2,
      Matrix_001: invert_matrix.matrix) @ hide
    transform_point = TransformPoint(vector: position, transform: multiply_matrices) @ hide
    set_position = SetPosition(
      separate_components.mesh
        + separate_components.curve
        + separate_components.grease_pencil
        + separate_components.point_cloud,
      position: transform_point)
  }
  return set_position
}

geometry graph "Surface Deform Basic"(
    Geometry: Geometry,
    Mode: Menu(
      description: "Which geometry the modifier will operate on",
      optional_label: true) = "Mesh/Points",
    "Surface Object": Object(optional_label: true),
    "Surface rest_position": String(optional_label: true) = "rest_position",
    UVMap: String(optional_label: true) = "UVMap",
    "Show Surface rest_position": Bool
) -> Geometry {
  "Deform geometry by mesh surface"
  "rest position" {
    named_attribute = NamedAttribute[FLOAT_VECTOR](name: surface_rest_position)
  }
  "deform object" {
    object_info = ObjectInfo[RELATIVE](object: surface_object)
  }
  "deform loc,nrm,tan" {
    position = Position() @ hide
    normal = Normal[legacy_corner_normals: true]() @ hide
  }
  "rest loc,nrm,tan" {
    position_2 = Position() @ hide
    normal_2 = Normal[legacy_corner_normals: true]() @ hide
  }
  "smooth tangent" {
    uvtangent = UVTangent(uv: NamedAttribute[FLOAT_VECTOR](name: UVMap).attribute)
  }
  "deform loc,nrm,tan" .. {
    store_named_attribute = object_info.geometry
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "dp", value: position)
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "dn", value: normal.normal)
      |> StoreNamedAttribute[FLOAT_VECTOR, CORNER](name: "dt", value: uvtangent)
  }
  "rest position" .. {
    set_position = SetPosition(store_named_attribute, position: named_attribute.attribute) @ hide
    vector_math = length(
      AttributeStatistic[FLOAT_VECTOR](
        store_named_attribute,
        attribute: named_attribute.attribute).range) @ hide
    compare = vector_math == 0.0 @ hide
    switch = Switch[GEOMETRY](switch: compare, false_: set_position) @ hide
  }
  "rest loc,nrm,tan" .. {
    store_named_attribute_2 = switch
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "rp", value: position_2)
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "rn", value: normal_2.normal)
      |> StoreNamedAttribute[FLOAT_VECTOR, CORNER](name: "rt", value: uvtangent)
  }
  warning = Warning(show: compare, message: "Invalid rest_position on surface object")
  "debug" {
    geometry_to_instance = GeometryToInstance(switch) @ hide
    join_geometry = Geometry + geometry_to_instance
  }
  switch_2 = show_surface_rest_position
    ? join_geometry
    : MenuSwitch(
      menu: Mode,
      "Mesh/Points": deform_points(Geometry, deform_surface: store_named_attribute_2),
      Curves: deform_curves(Geometry, deform_surface: store_named_attribute_2),
      Instances: deform_instances(Geometry, deform_surface: store_named_attribute_2)).output @ hide
  return switch_2
}
