// Curve to Mesh UV, from Cartesian Caramel's Everyday Nodes
// Author: Cartesian Caramel
// Source: https://github.com/cartesiancaramel/blender-remote-asset-library-test-v1 (6c078f7)
// License: CC0-1.0, https://creativecommons.org/publicdomain/zero/1.0/
// Written by Base Node from tests/fixtures/everyday_geometry_nodes.blend;
// to write it again: BASE_NODE_UPDATE_FIXTURES=1, see tests/fixtures/README.md

geometry(is_modifier: false) graph "Curve to Mesh UV"(
    Curve: Geometry,
    "Profile Curve": Geometry,
    "Fill Caps": Bool,
    "UV"(default_closed: true) {
        Name: String(optional_label: true) = "UVMap",
        "Use Length X": Bool,
        "Use Length Y": Bool
    }
) -> (Mesh: Geometry, UV: Vector) {
  spline_length = SplineLength()
  spline_parameter = SplineParameter()
  endpoint_selection = EndpointSelection(start_size: 0, end_size: IsSplineCyclic())
  "Capture on Point" {
    capture_attribute_2 = CaptureAttribute(Curve, Value: Float = endpoint_selection) @ hide
    capture_attribute = CaptureAttribute(
      capture_attribute_2.geometry,
      Value: spline_parameter.factor) @ hide
    capture_attribute_5 = CaptureAttribute(
      capture_attribute.geometry,
      Value: spline_length.length) @ hide
  }
  "Capture on Point" {
    capture_attribute_4 = CaptureAttribute(profile_curve, Value: Float = endpoint_selection) @ hide
    capture_attribute_3 = CaptureAttribute(
      capture_attribute_4.geometry,
      Value: spline_parameter.factor) @ hide
    capture_attribute_6 = CaptureAttribute(
      capture_attribute_3.geometry,
      Value: spline_length.length) @ hide
  }
  "End Seam Selection" {
    compare = capture_attribute_3.value <= 0.0 @ hide
    boolean_math = compare
      and EvaluateOnDomain(
        value: capture_attribute_4.value,
        domain: FACE,
        data_type: BOOLEAN) @ hide
    switch = boolean_math ? 1.0 : capture_attribute_3.value
    math_2 = switch * capture_attribute_6.value @ hide
    switch_4 = use_length_y ? math_2 : switch @ hide
  }
  "End Seam Selection" {
    compare_2 = capture_attribute.value <= 0.0 @ hide
    boolean_math_2 = compare_2
      and EvaluateOnDomain(
        value: capture_attribute_2.value,
        domain: FACE,
        data_type: BOOLEAN) @ hide
    switch_2 = boolean_math_2 ? 1.0 : capture_attribute.value
    math = switch_2 * capture_attribute_5.value @ hide
    switch_3 = use_length_x ? math : switch_2 @ hide
  }
  "UV" {
    combine_xyz = CombineXYZ(x: switch_3, y: switch_4) @ hide
    named_attribute = NamedAttribute(name: "radius")
    return (
      Mesh: capture_attribute_5.geometry
        |> CurveToMesh(
          profile_curve: capture_attribute_6.geometry,
          scale: named_attribute.exists ? named_attribute.attribute : 1.0,
          fill_caps: fill_caps)
        |> StoreNamedAttribute(name: Name, value: combine_xyz, data_type: FLOAT2, domain: CORNER),
      UV: NamedAttribute(name: Name, data_type: FLOAT_VECTOR).attribute)
  }
}
