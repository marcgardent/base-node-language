geometry(is_modifier: false) graph "Set Curve Vectors"(
    Curve: Geometry,
    Selection: Bool(hide_value: true) = true,
    Vectors: Vector = (0.0, 0.0, 1.0)
) -> (Curve: Geometry) {
  vector_math = AccumulateField[FLOAT_VECTOR](
      value: Vectors,
      group_id: CurveOfPoint().curve_index).trailing
    + EvaluateAtIndex[FLOAT_VECTOR](
      value: Position(),
      index: EvaluateOnDomain[CURVE, INT](value: PointsOfCurve().point_index)) @ hide
  set_position = SetPosition(Curve, selection: Selection, position: vector_math) @ hide
  return (Curve: set_position)
}
