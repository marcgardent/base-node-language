geometry graph poignées(
    geometry: Geometry,
    hauteur: Float = 1.0,
    centre: Vector,
    angle: Float
) -> Geometry {
  flèche = LinearGizmo[BOX](hauteur, position: centre)
  cadran = DialGizmo(angle, radius: 0.8)
  repère = TransformGizmo(CombineTransform(centre), position: centre)
  choix = IndexSwitch(0, LinearGizmo(2.0), _)
  return SetPosition(geometry, offset: CombineXYZ(z: hauteur)) + flèche + cadran + repère + choix
}
