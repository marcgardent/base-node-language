// Every structure spreads when its line passes 100 characters, the outermost first
geometry graph widths(
    geometry: Geometry,
    o: Vector(
      subtype: TRANSLATION,
      description: "How far each point moves, along each axis of the object") = (1.0, 1.0, 1.0),
    "Rough"(
      description: "Settings for the roughness of the surface, all in one panel",
      default_closed: true) {
        r: Float = 0.5
    }
) -> (a: Geometry, b: Geometry, c: Vector) {
  short = CombineXYZ(x: 1.0, y: 1.0, z: 1.0) + (1.0, 2.0, 3.0) * 2.0
  nested = JoinGeometry(
    geometry
      |> SetPosition(offset: CombineXYZ(x: 1.0, y: 2.0, z: 3.0))  // a nested step
      // before the last step
      |> SetPosition(offset: CombineXYZ(x: 1.0, y: 2.0, z: 3.0)),
    geometry)  // after the call
  tuple = Points(
    position: (
      (0.0, 0.5, 0.25),
      (1.0, 1.5, 1.25),
      (2.0, 2.5, 2.25),
      (3.0, 3.5, 3.25),
      (4.0, 4.5, 4.25)))
  chain = Switch[GEOMETRY](switch: o.x > 0.0, true_: SetPosition(geometry, offset: o))
    + Switch[GEOMETRY](switch: o.y > 0.0, true_: nested)  // an operand
    - tuple
  picked = SeparateGeometry[FACE](
    geometry,
    selection: Position().z > 0.0 and Position().x < o.x,
    mode: EDGE).selection
  operand = (geometry |> SetPosition(offset: CombineXYZ(x: 1.0, y: 2.0, z: 3.0))).geometry
    + (geometry |> SetPosition(offset: CombineXYZ(x: 1.0, y: 2.0, z: 3.0)) |> SetShadeSmooth())
  deep = SetPosition(
    SetPosition(
      SetPosition(geometry, offset: CombineXYZ(x: 1.0, y: o.y * 2.5, z: o.z - 3.25)),
      offset: CombineXYZ(x: 2.0, y: o.y * 3.5, z: o.z - 4.25)),
    offset: -o * 2.0) @ "Deep" mute
  return (
    a: chain |> SetShadeSmooth() |> SubdivideMesh(level: 2),
    b: picked + operand + deep,
    c: CombineXYZ(x: o.x * 2.0 + o.y * 3.0 - o.z, y: o.y * 2.0 + o.z * 3.0 - o.x, z: o.z))
}
