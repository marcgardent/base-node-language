geometry graph sélection(geometry: Geometry, centre: Vector, taille: Float = 1.0) -> Geometry {
  alerte = Warning(show: taille < 0.0, message: "La taille est négative")
  "Poignée" {
    repère = TransformGizmo(CombineTransform(translation: centre), position: centre)
  }
  plus = SetPosition(geometry, offset: centre) @ mute
  return SubdivideMesh(plus, level: 2)
}
