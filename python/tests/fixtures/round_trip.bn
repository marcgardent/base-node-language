geometry graph "Smooth Mesh"(Mesh: Geometry, Level: Int) -> Geometry {
  return Mesh
    |> SubdivideMesh(level: Level)
    |> SetShadeSmooth()
}

geometry graph scatter(geometry: Geometry, "Point Count": Int) -> (Geometry: Geometry, Count: Int) {
  grid = Grid(size_x: 2.0, size_y: 2.0, vertices_x: point_count, vertices_y: point_count)
  smooth = smooth_mesh(grid.mesh, 2)
  return (
    Geometry: geometry
      + SetPosition(smooth, offset: (0.0, 0.0, 0.5))
      + SetMaterial(smooth, material: "Rust"),
    Count: point_count)
}
