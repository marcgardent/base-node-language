// The canonical layout of a pipe, printed alike by every formatter
geometry graph pipes(geometry: Geometry, o: Vector) -> (a: Geometry, b: Geometry) {
  one = geometry
    |> SetShadeSmooth()
  several = Cube(size: CombineXYZ(x: 2.0))
    |> TransformGeometry(translation: CombineXYZ(), scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0))
    |> SetShadeSmooth()  // after its step
  long = geometry
    // before a step
    |> TransformGeometry(
      translation: CombineXYZ(x: 1.0, y: 1.0, z: 1.0),
      rotation: CombineXYZ(x: 1.0, y: 1.0, z: 1.0),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0))
    |> SubdivideMesh(level: 2)
  head = JoinGeometry(
      one,
      several,
      long,
      MeshToPoints(CurveToMesh(CurveCircle(resolution: 32, radius: 1.0).curve), radius: 0.05))
    |> MergeByDistance(distance: 0.001)
  argument = SetPosition(geometry |> SubdivideMesh(level: 2), offset: o)
  operands = (geometry |> SubdivideMesh(level: 1)) + (geometry |> SetShadeSmooth())
  picked = (geometry |> SeparateGeometry(selection: true)).selection
    |> SetPosition(offset: o)
  return (a: head |> SetShadeSmooth(), b: argument |> SubdivideMesh(level: 1))
}
