    "Tangent": ["tangent"],
    "TextureCoordinate": ["generated", "normal", "uv", "object", "camera", "window", "reflection"],
    "UVMap": ["uv"],
    "VectorMath": ["vector"]
  },
  "settings": {
    "Attribute": {"attribute_type": "GEOMETRY"},
    "ImageTexture": {"image": null, "projection": "FLAT", "interpolation": "Linear", "extension": "REPEAT"},
    "Mapping": {"vector_type": "POINT"},
    "Math": {"operation": "ADD"},
    "Mix": {"data_type": "FLOAT", "blend_type": "MIX"},
    "NormalMap": {"space": "TANGENT", "convention": "OPENGL"},
    "Tangent": {"direction_type": "RADIAL"},
    "VectorMath": {"operation": "ADD"}
  },
  "folded": ["Math", "Mix", "VectorMath"],
  "once": ["PrincipledBSDF"],
  "vectors": ["Background.color", "Emission.color", "PrincipledBSDF.base_color", "PrincipledBSDF.coat_tint", "PrincipledBSDF.emission_color", "PrincipledBSDF.sheen_tint", "PrincipledBSDF.specular_tint", "UnlitBlend.color", "UnlitBlendVertex.color", "UnlitEmission.color", "VertexColor.color", "Attribute.color", "Attribute.vector", "ColorAttribute.color", "ImageTexture.color", "Mapping.vector", "NormalMap.normal", "Tangent.tangent", "TextureCoordinate.generated", "TextureCoordinate.normal", "TextureCoordinate.uv", "TextureCoordinate.object", "TextureCoordinate.camera", "TextureCoordinate.window", "TextureCoordinate.reflection", "UVMap.uv", "VectorMath.vector"],
  "patterns": {
    "AlphaClip": ["round(value)", "Math(value, threshold, operation: GREATER_THAN)", "Math(threshold, value, operation: LESS_THAN)", "1.0 - Math(value, threshold, operation: LESS_THAN)", "1.0 - Math(threshold, value, operation: GREATER_THAN)"],
    "VertexAlphaClip": ["round(value)", "Math(value, threshold, operation: GREATER_THAN)", "Math(threshold, value, operation: LESS_THAN)", "1.0 - Math(value, threshold, operation: LESS_THAN)", "1.0 - Math(threshold, value, operation: GREATER_THAN)"],
    "VertexColor": ["(color, alpha)"],
    "Unlit": ["MixShader(LightPath().is_camera_ray, shader, emission)"],
    "UnlitEmission": ["Emission(color: color, strength: strength)"],
    "UnlitBlend": ["MixShader(alpha, TransparentBSDF(color: transparent), MixShader(LightPath().is_camera_ray, shader, Emission(color: color, strength: strength)))"],
    "UnlitBlendVertex": ["MixShader(alpha, TransparentBSDF(color: transparent), MixShader(LightPath().is_camera_ray, shader, Emission(color: color, strength: strength)))"],
    "Anisotropy": ["(s.z * strength, (atan2(s.y, s.x) + rotation) / 6.283185, Tangent(direction_type: UV_MAP))"],
    "AnisotropyVector": ["SeparateXYZ(VectorMath(texture, (2.0, 2.0, 1.0), (-1.0, -1.0, 0.0), operation: MULTIPLY_ADD))"],
    "Hidden": ["TransparentBSDF(color: hidden)"],
    "Volume": ["(volume, thickness)"],
    "Dispersion": ["(dispersion, volume_thickness)"],
    "Occlusion": ["Mix(strength, (1.0, 1.0, 1.0, 1.0), occlusion, blend_type: MIX)"],
    "Iridescence": ["(film_thickness, film_ior, factor, minimum)"],
    "IridescenceTexture": ["Mix(SeparateColor(film_texture).red, minimum, maximum)"],
    "NoCoat": ["(coat_tint, coat_ior, coat_weight)"]
  },
