    "SeparateColor": ["color"],
    "SeparateXYZ": ["vector"],
    "TransparentBSDF": ["color"],
    "VectorMath": ["Vector", "Vector_001", "Vector_002"],
    "VolumeAbsorption": ["color", "density"],
    "glTFMaterialOutput": ["Occlusion", "Thickness", "Iridescence Factor", "Iridescence Thickness Minimum", "Dispersion"],
