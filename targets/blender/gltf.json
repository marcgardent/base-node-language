{
  "name": "gltf",
  "description": "The shader nodes Blender's glTF exporter turns into a glTF material: Principled BSDF and its extensions, Emission and unlit, image textures and their channels, normal maps, UVs, color attributes, alpha clip, anisotropy, and the glTF Material Output group: occlusion, volume, iridescence, dispersion",
  "kinds": [
    "shader"
  ],
  "types": [
    "Bool",
    "Color",
    "Float",
    "Int",
    "Shader",
    "Vector"
  ],
  "zones": [],
  "implicit": [],
