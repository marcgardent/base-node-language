    "VertexColor.alpha": ["ColorAttribute.alpha", "Attribute.alpha", "ColorAttribute.alpha × constant", "Attribute.alpha × constant", "ImageTexture × ColorAttribute.alpha", "ImageTexture × Attribute.alpha", "ImageTexture × ColorAttribute.alpha × constant", "ImageTexture × Attribute.alpha × constant", "VertexAlphaClip"],
