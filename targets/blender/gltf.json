    "Dispersion": ["dispersion", "volume_thickness"],
    "Hidden": ["hidden"],
    "Iridescence": ["film_thickness", "film_ior", "factor", "minimum"],
    "IridescenceTexture": ["film_texture", "minimum", "maximum"],
    "NoCoat": ["coat_tint", "coat_ior", "coat_weight"],
    "Occlusion": ["strength", "occlusion"],
    "Unlit": ["shader", "emission"],
    "UnlitBlend": ["alpha", "transparent", "shader", "color", "strength"],
    "UnlitBlendVertex": ["alpha", "transparent", "shader", "color", "strength"],
    "UnlitEmission": ["color", "strength"],
    "VertexAlphaClip": ["value", "threshold"],
    "VertexColor": ["color", "alpha"],
    "Volume": ["volume", "thickness"]
  },
  "outputs": {
    "Attribute": ["color", "vector", "factor", "alpha"],
    "ColorAttribute": ["color", "alpha"],
    "ImageTexture": ["color", "alpha"],
    "Mapping": ["vector"],
    "NormalMap": ["normal"],
    "SeparateColor": ["red", "green", "blue"],
