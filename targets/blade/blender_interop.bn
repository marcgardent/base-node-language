// Bridges of the blade target — Module blender_interop
// @module blender_interop
// @target blade
// @edition 2026

// The compositor nodes Blade has no node for, made of Blade's nodes. Blade's translator from
// blender calls them in a compositor graph: `Kuwahara(image, size: 6.0)` becomes
// `blender_interop::kuwahara(image, size: 6.0)`, and the text uses this module.
//
// The inputs of Blade's nodes are those of blenderFramework, crates/bf-raster/src/filters/types.rs:
// Median has `radius`, Bilateral `radius` and `tolerance`.

pixel graph kuwahara(image: Color, size: Float = 6.0) -> Color {
  "Kuwahara: a smoothing that keeps the edges, for a painterly look"
  // A median flattens the regions, a bilateral blur evens them out up to their edges
  flat = Median(image, radius: size)
  return Bilateral(flat, radius: size, tolerance: 0.1)
}
