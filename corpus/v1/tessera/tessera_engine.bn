              offset: (0.0, 0.0, 1.0),
              offset_scale: NamedAttribute(name: "ts_zlo").attribute).mesh
            |> StoreNamedAttribute[FACE](name: "ts_bevel", value: 1.0)
            |> StoreNamedAttribute[BOOLEAN, FACE](name: "ts_top")
            |> StoreNamedAttribute(name: "ts_ed", value: 1.0)
            |> StoreNamedAttribute(name: "ts_ed2", value: 1.0)
            |> StoreNamedAttribute(name: "ts_frac", value: Position().z > 1e-06 ? 1.0 : 0.0))
          + switch_6
        : switch_6)
      |> SetPosition(
        offset: CombineXYZ(
          z: NamedAttribute(name: "ts_wz").attribute
            * weave_depth
            * min(max(Position().z / max(Thickness, 1e-06), 0.0), 1.0)))
      |> SetPosition(
        selection: EvaluateOnDomain[FACE](
            value: NamedAttribute[BOOLEAN](name: "ts_strap").attribute ? 1.0 : 0.0)
          < 0.5,
        position: VectorRotate(
            vector: Position(),
            center: CombineXYZ(x: named_attribute_6.attribute.x, y: named_attribute_6.attribute.y),
            axis: CombineXYZ(x: cos(math_27), y: sin(math_27)),
            angle: math_30)
          + CombineXYZ(
            z: min(
              max((separate_color_9.green * 2.0 - 1.0) * height_jitter, math_32),
              max(grout_depth * 0.6 + 0.0008 - math_31, math_32))))
      |> StoreNamedAttribute[FLOAT_VECTOR](
        name: "ts_tile_uv",
        value: CombineXYZ(x: vector_rotate.x / math_33 + 0.5, y: vector_rotate.y / math_33 + 0.5))
      |> StoreNamedAttribute[FLOAT2, CORNER](
        name: "TesseraTileUV",
        value: NamedAttribute[FLOAT_VECTOR](name: "ts_tile_uv").attribute)
      |> StoreNamedAttribute[FLOAT2, CORNER](
        name: "TesseraPanelUV",
        value: NamedAttribute[FLOAT_VECTOR](name: "ts_panel_uv").attribute)
      |> DeleteGeometry[FACE](
        selection: Openwork
          and not (NamedAttribute(name: "ts_band").attribute > 0.5
            or NamedAttribute[BOOLEAN](name: "ts_strap").attribute))
      |> RemoveNamedAttribute(name: "ts_zlo")
      |> RemoveNamedAttribute(name: "ts_zmid")
      |> RemoveNamedAttribute(name: "ts_q2"),
    Holes: Switch[GEOMETRY](
      switch: Mapping == 0,
      true_: SetPosition(
        Switch[GEOMETRY](
            switch: compare_5,
            true_: separate_geometry_2.selection
              |> DeleteGeometry[FACE](selection: NamedAttribute(name: "ts_zlo").attribute > 1e-06)
              |> tessera_inset(distance: 5e-05))
          + tessera_inset(Gone, distance: math),
        position: CombineXYZ(x: position_8.x, y: position_8.y))))
}

geometry graph "Tessera Engine"(
    Geometry: Geometry,
    "Pattern" {
        Motif: Object(
          description: "Hidden mesh holding one repeat of the pattern (made by the add-on)"),
        Scale: Float(
          subtype: DISTANCE,
          description: "Size of one pattern unit (tile edge or repeat) in metres") = 0.1 in 0.0005..100.0,
        Rotation: Float(subtype: ANGLE, description: "Rotate the whole pattern"),
        Offset: Vector(subtype: TRANSLATION, description: "Slide the pattern"),
        "Center Pattern": Bool(
          description: "Put a motif centre (e.g. a star) in the middle of the panel") = true,
        Seed: Int(description: "Random seed for colours and irregularities") in 0..100000,
        "Fit Repeats": Bool(
          description: "Adjust the scale so a whole number of repeats fits the width: seamless wraps around columns / rooms and clean panel ends"),
        "Wrap Width": Float(
          subtype: DISTANCE,
          description: "Width to fit (circumference / room perimeter). 0 = panel or UV width") in 0.0..10000.0
    },
    "Layout" {
        Mapping: Menu(
          description: "Flat panel, project onto a mesh from above, or wrap any UV-mapped surface") = "Flat Panel",
        Target: Object(description: "Optional surface object (otherwise the modifier's own mesh)"),
        "UV Map": String(description: "UV map used by Wrap UV") = "UVMap",
        "UV Scale": Float(
          subtype: DISTANCE,
          description: "Metres per UV unit (use 'Measure UV Scale' in the panel)") = 1.0 in 0.001..1000.0,
        Shape: Menu(description: "Outline of a flat panel") = Rectangle,
        Width: Float(subtype: DISTANCE, description: "Panel width") = 1.0 in 0.001..1000.0,
        Height: Float(subtype: DISTANCE, description: "Panel height") = 1.0 in 0.001..1000.0,
        Sides: Int(description: "Sides of the polygon shape") = 8 in 3..64,
        "Shape Offset": Vector(
          subtype: TRANSLATION,
          description: "Move the shape (e.g. place a band on a column)"),
        "Clip to Shape": Bool(
          description: "Also clip Project / Wrap UV layouts to the Shape: bands, dados, friezes on walls and columns"),
        Region: Menu(
          description: "Fill the whole shape, only the inner field, or only the border band") = Full,
        "Border Width": Float(
          subtype: DISTANCE,
          description: "Width of the border band") = 0.1 in 0.0..100.0,
        Edge: Menu(
          description: "Keep whole tiles, only fully-inside tiles, or cut tiles at the edge") = "Cut to Edge",
        "Bend to Surface": Bool(
          description: "Bend every tile to follow curved surfaces (otherwise tiles stay flat and rigid)"),
        "Single Cell": Bool(description: "Show one repeat only (a single tile or rosette)"),
        Piece: Int(description: "Only this piece of the motif (-1 = all)") = -1 in -1..9999,
        "Max Cells": Int(
          description: "Safety limit on the number of repeats") = 150000 in 1..2000000
    },
    "Tiles" {
        "Grout Width": Float(
          subtype: DISTANCE,
          description: "Joint width between tiles") = 0.003 in 0.0..1.0,
        Thickness: Float(subtype: DISTANCE, description: "Tile thickness") = 0.01 in 0.0001..1.0,
        Bevel: Float(subtype: DISTANCE, description: "Rounded edge size") = 0.0012 in 0.0..0.5,
        "Bevel Segments": Int(description: "Steps of the rounded edge (0 = sharp)") = 2 in 0..8,
        "Grout Depth": Float(
          subtype: DISTANCE,
          description: "How far the grout sits below the tile top") = 0.002 in 0.0..1.0,
        "Grout Bed": Bool(description: "Generate the grout / mortar bed") = true,
        Strapwork: Bool(
          description: "Turn the joints into raised straps in the grout material: carved plaster (gebs), brass inlay, leaded glass"),
        "Strap Height": Float(
          subtype: DISTANCE,
          description: "How far the straps stand above the tiles") = 0.004 in -1.0..1.0,
        "Weave Depth": Float(
          subtype: DISTANCE,
          description: "Interlaced bands rise over and dip under each other by this much (patterns with Band Width)") in -0.5..0.5,
        "Band Joints": Float(
          subtype: FACTOR,
          description: "Joint between pieces of the same band, relative to the other joints (0 = touching, 1 = same width)") = 0.05 in 0.0..1.0,
        Openwork: Bool(
          description: "Keep only the bands / straps: pierced screens, jali, mashrabiya, lattice windows (no fill pieces, no bed)"),
        "Relief Class": Int(
          description: "Raise (or sink) every piece of this shape class: inlay / carved relief (-1 = off)") = -1 in -1..64,
        "Relief Height": Float(
          subtype: DISTANCE,
          description: "Extra height of the relief class (negative = recessed)") = 0.004 in -1.0..1.0,
        "Viewport Simplify": Bool(
          description: "Use a single bevel step in the viewport (full quality in renders)") = true,
        "Keep Original": Bool(description: "Also output the original mesh"),
        "Tile Material": Material(description: "Material for tiles"),
        "Grout Material": Material(description: "Material for grout bed")
    },
    "Irregularity"(default_closed: true) {
        "Position Jitter": Float(
          subtype: DISTANCE,
          description: "Random shift of each piece") = 0.0003 in 0.0..1.0,
        "Rotation Jitter": Float(
          subtype: ANGLE,
          description: "Random spin of each piece") = 0.010471975 in 0.0..3.1415927,
        "Scale Jitter": Float(
          subtype: FACTOR,
          description: "Random size of each piece") in 0.0..0.9,
        "Stretch Jitter": Float(
          subtype: FACTOR,
          description: "Random squash/stretch (pebbles, chips)") in 0.0..0.9,
        "Edge Wobble": Float(
          subtype: DISTANCE,
          description: "Hand-cut irregular edges") in 0.0..1.0,
        "Height Jitter": Float(
          subtype: DISTANCE,
          description: "Random height of each piece") = 0.0004 in 0.0..1.0,
        "Tilt Jitter": Float(
          subtype: ANGLE,
          description: "Random tilt (glints like handmade zellige / smalti)") = 0.013962634 in 0.0..0.5,
        Missing: Float(
          subtype: FACTOR,
          description: "Fraction of missing pieces (ruins, ancient floors)") in 0.0..1.0,
        Cobwebs: Float(
          subtype: FACTOR,
          description: "Dusty cobwebs fanned from corners into the joints (aged wood, abandoned rooms)") in 0.0..1.0,
        Debris: Float(
          subtype: FACTOR,
          description: "Straw and scraps of faded cloth caught on the carving (barns, ruins, abandoned rooms)") in 0.0..1.0,
        Splinters: Float(
          subtype: FACTOR,
          description: "Slivers peeling up from the edges of old wood") in 0.0..1.0,
        Hairs: Float(
          description: "Stray hairs and lint fibres lying on the surface (super close-ups): 1 = a lived-in floor, 3+ = neglected") in 0.0..5.0,
        "Broken Tiles": Float(
          subtype: FACTOR,
          description: "Fraction of tiles with a chunk broken off (the plaster bed shows where it is missing)") in 0.0..1.0,
        "Chip Rim": Float(
          subtype: DISTANCE,
          description: "Rim along every tile edge where the glaze can chip off (Glaze › Chipping); 0 = chips only on the bevel") in 0.0..0.05,
        "Chip Depth": Float(
          subtype: DISTANCE,
          description: "How far chips can bite into the face of a tile (Glaze › Chipping), independent of the Chip Rim") = 0.004 in 0.0..0.05,
        "Joint Guard": Float(
          subtype: FACTOR,
          description: "Keep the joints: big pieces shift, turn and grow less, so they never ride over their neighbours (0 = free jitter: pebbles, terrazzo chips)") = 1.0 in 0.0..1.0,
        Bites: Float(
          subtype: FACTOR,
          description: "Fraction of pieces with chips or chunks knocked out of an edge or a corner: real geometry, the body shows (or the mortar when a bite goes right through)") in 0.0..1.0,
        "Bite Size": Float(
          subtype: DISTANCE,
          description: "Typical radius of a bite; a few are up to twice as big") = 0.006 in 0.0005..0.1,
        "Bite Depth": Float(
          subtype: FACTOR,
          description: "How deep bites go: 0 = just under the glaze, 0.5 = half the tile, 1 = right through to the mortar bed") = 0.35 in 0.0..1.0,
        "Quarter Turns": Bool(description: "Random 90° turns of per-tile images (Truchet)")
    },
    "Color"(default_closed: true) {
        "Color Mode": Menu(description: "How pieces pick palette colours") = "By Shape",
        Colors: Int(description: "Number of palette colours used") = 5 in 1..8,
        "Class Shift": Int(description: "Rotate which shape gets which colour") in -16..16,
        "Accent Chance": Float(
          subtype: FACTOR,
          description: "Chance of a random accent colour (Shape + Accents)") = 0.08 in 0.0..1.0,
        "Gradient Angle": Float(
          subtype: ANGLE,
          description: "Direction of the colour gradient") = 1.5707964,
        "Band Size": Float(
          subtype: DISTANCE,
          description: "Ring width (Rings mode)") = 0.12 in 0.0001..100.0,
        "Cluster Scale": Float(
          subtype: DISTANCE,
          description: "Size of colour clusters") = 0.35 in 0.0001..100.0,
        Dither: Float(
          subtype: FACTOR,
          description: "Blend between bands / clusters") = 0.25 in 0.0..1.0,
        "Rhythm Class": Int(
          description: "Rhythm: which shape class cycles colours (-1 = all shapes)") in -1..63,
        "Rhythm Period": Int(
          description: "Rhythm: how many colours alternate (2 = checker, 3 = three-colouring)") = 2 in 1..8,
        "Rhythm Start": Int(
          description: "Rhythm: first palette slot used by the alternating colours") = 4 in 1..8,
        Symmetry: Menu(description: "Make random colours symmetric around the panel centre") = None,
        Folds: Int(description: "Rotational symmetry order") = 8 in 1..64,
        "Hue Jitter": Float(
          subtype: FACTOR,
          description: "Per-piece hue variation") = 0.006 in 0.0..0.5,
        "Saturation Jitter": Float(
          subtype: FACTOR,
          description: "Per-piece saturation variation") = 0.05 in 0.0..1.0,
        "Value Jitter": Float(
          subtype: FACTOR,
          description: "Per-piece brightness variation (glaze depth)") = 0.08 in 0.0..1.0
    },
    "Palette"(default_closed: true) {
        "Color 1": Color = (0.02, 0.1, 0.04),
        "Color 2": Color = (0.88, 0.85, 0.77),
        "Color 3": Color = (0.01, 0.05, 0.2),
        "Color 4": Color = (0.58, 0.27, 0.02),
        "Color 5": Color = (0.01, 0.01, 0.01),
        "Color 6": Color = (0.02, 0.26, 0.22),
        "Color 7": Color = (0.33, 0.04, 0.02),
        "Color 8": Color = (0.1, 0.04, 0.03),
        "Weight 1": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 2": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 3": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 4": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 5": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 6": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 7": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Weight 8": Float(description: "Random-pick weight") = 1.0 in 0.0..100.0,
        "Metal 1": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 2": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 3": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 4": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 5": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 6": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 7": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0,
        "Metal 8": Float(
          subtype: FACTOR,
          description: "Metallic (gold / silver smalti)") in 0.0..1.0
    },
    "Image"(default_closed: true) {
        Image: Image(description: "Picture to turn into tiles"),
        "Image Fit": Menu(description: "How the picture fits the panel") = Cover,
        "Image Mix": Float(
          subtype: FACTOR,
          description: "Blend palette colour → picture colour") = 1.0 in 0.0..1.0,
        "Flow Align": Float(
          subtype: FACTOR,
          description: "Turn tesserae along image edges (opus vermiculatum)") in 0.0..1.0
    }
) -> Geometry {
  "Tessera mosaic & tile engine (generated by the Tessera add-on)"
  menu_switch = MenuSwitch(menu: Mapping, "Flat Panel": 0, "Project Down": 1, "Wrap UV": 2)
  menu_switch_2 = MenuSwitch(menu: Shape, Rectangle: 0, Ellipse: 1, Arch: 2, Polygon: 3)
  menu_switch_3 = MenuSwitch(
    menu: color_mode,
    "By Shape": 0,
    Random: 1,
    "Shape + Accents": 2,
    Gradient: 3,
    Clusters: 4,
    Rings: 5,
    "Cell Checker": 6,
    Image: 7,
    "Image → Palette": 8,
    Rhythm: 9)
  object_info = ObjectInfo[RELATIVE](object: Target)
  switch = DomainSize(object_info.geometry).face_count > 0 ? object_info.geometry : Geometry
  object_info_2 = ObjectInfo(object: Motif)
  group = tessera_pieces(
    switch,
    motif: object_info_2.geometry,
    scale: Scale,
    rotation: Rotation,
    offset: Offset,
    center_pattern: center_pattern,
    mapping: menu_switch.output,
    shape: menu_switch_2.output,
    width: Width,
    height: Height,
    sides: Sides,
    region: MenuSwitch(menu: Region, Full: 0, Field: 1, Border: 2).output,
    border_width: border_width,
    edge: MenuSwitch(menu: Edge, "Whole Tiles": 0, "Inside Only": 1, "Cut to Edge": 2).output,
    single_cell: single_cell,
    piece: Piece,
    max_cells: max_cells,
    uv_map: uv_map,
    uv_scale: uv_scale,
    seed: Seed,
    missing: Missing,
    shape_offset: shape_offset,
    clip_to_shape: clip_to_shape,
    fit_repeats: fit_repeats,
    wrap_width: wrap_width,
    fit_multiple: round(
      menu_switch_3.output == 9
        ? rhythm_period
        : Switch[FLOAT](switch: menu_switch_3.output == 6, false_: 1.0, true_: Colors)))
  group_2 = group.geometry
    |> tessera_color(
      motif: object_info_2.geometry,
      region_min: group.region_min,
      region_max: group.region_max,
      scale: group.scale_out,
      rotation: Rotation,
      seed: Seed,
      mapping: menu_switch.output,
      uv_scale: uv_scale,
      color_mode: menu_switch_3.output,
      colors: Colors,
      class_shift: class_shift,
      accent_chance: accent_chance,
      gradient_angle: gradient_angle,
      band_size: band_size,
      cluster_scale: cluster_scale,
      dither: Dither,
      symmetry: MenuSwitch(
        menu: Symmetry,
        None: 0,
        "Mirror X": 1,
        "Mirror XY": 2,
        Rotational: 3).output,
      folds: Folds,
      hue_jitter: hue_jitter,
      saturation_jitter: saturation_jitter,
      value_jitter: value_jitter,
      color_1: color_1,
      color_2: color_2,
      color_3: color_3,
      color_4: color_4,
      color_5: color_5,
      color_6: color_6,
      color_7: color_7,
      color_8: color_8,
      weight_1: weight_1,
      weight_2: weight_2,
      weight_3: weight_3,
      weight_4: weight_4,
      weight_5: weight_5,
      weight_6: weight_6,
      weight_7: weight_7,
      weight_8: weight_8,
      metal_1: metal_1,
      metal_2: metal_2,
      metal_3: metal_3,
      metal_4: metal_4,
      metal_5: metal_5,
      metal_6: metal_6,
      metal_7: metal_7,
      metal_8: metal_8,
      image: Image,
      image_fit: MenuSwitch(menu: image_fit, Stretch: 0, Contain: 1, Cover: 2).output,
      image_mix: image_mix,
      flow_align: flow_align,
      rhythm_class: rhythm_class,
      rhythm_period: rhythm_period,
      rhythm_start: rhythm_start)
    |> tessera_solidify(
      region_min: group.region_min,
      region_max: group.region_max,
      scale: group.scale_out,
      rotation: Rotation,
      seed: Seed,
      mapping: menu_switch.output,
      uv_scale: uv_scale,
      grout_width: grout_width,
      thickness: Thickness,
      bevel: Bevel,
      bevel_segments: bevel_segments,
      position_jitter: position_jitter,
      rotation_jitter: rotation_jitter,
      scale_jitter: scale_jitter,
      stretch_jitter: stretch_jitter,
      edge_wobble: edge_wobble,
      height_jitter: height_jitter,
      tilt_jitter: tilt_jitter,
      quarter_turns: quarter_turns,
      relief_class: relief_class,
      relief_height: relief_height,
      viewport_simplify: viewport_simplify,
      strapwork: Strapwork,
      strap_height: strap_height,
      weave_depth: weave_depth,
      chip_rim: chip_rim,
      openwork: Openwork,
      band_joints: band_joints,
      broken_tiles: broken_tiles,
      grout_depth: grout_depth,
      chip_depth: chip_depth,
      joint_guard: joint_guard,
      bites: Bites,
      bite_size: bite_size,
      bite_depth: bite_depth,
      gone: group.gone)
  group_3 = tessera_map(
    group_2.geometry,
    surface: switch,
    mapping: menu_switch.output,
    uv_map: uv_map,
    uv_scale: uv_scale,
    bend_to_surface: bend_to_surface,
    region_min: group.region_min,
    fit_repeats: fit_repeats,
    wrap_width: wrap_width)
  named_attribute = NamedAttribute[BOOLEAN](name: "ts_top")
  index = Index()
  store_named_attribute = group_3
    |> StoreNamedAttribute[FLOAT_VECTOR, FACE](name: "ts_fn", value: Normal().normal)
    |> StoreNamedAttribute[FLOAT_VECTOR, FACE](name: "ts_fc", value: Position())
    |> StoreNamedAttribute[FLOAT_VECTOR, CORNER](
      name: "ts_pn",
      value: EvaluateAtIndex[FLOAT_VECTOR](
        value: Position(),
        index: VertexOfCorner(corner_index: OffsetCornerInFace(corner_index: index, offset: 1))))
    |> StoreNamedAttribute[FLOAT_VECTOR, CORNER](
      name: "ts_pp",
      value: EvaluateAtIndex[FLOAT_VECTOR](
        value: Position(),
        index: VertexOfCorner(corner_index: OffsetCornerInFace(corner_index: index, offset: -1))))
  position = Position()
  vector_math = length(CombineXYZ(x: position.x, y: position.y))
  random_value = RandomValue(min: -1.05, max: 1.05, seed: 3)
  math = sqrt(RandomValue(min: 0.005, seed: 4))
  position_2 = Position()
  vector_math_2 = length(CombineXYZ(x: position_2.x, y: position_2.y))
  position_3 = Position()
  vector_math_3 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_fn").attribute)
  vector_math_4 = position_3 - NamedAttribute[FLOAT_VECTOR](name: "ts_fc").attribute
  compare = (normalize(position_3 - NamedAttribute[FLOAT_VECTOR](name: "ts_pp").attribute)
        × normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_pn").attribute - position_3))
      ⋅ vector_math_3
    > 0.0
  store_named_attribute_2 = store_named_attribute
    |> MeshToPoints[CORNERS](
      selection: named_attribute.attribute
        and RandomValue[BOOLEAN](probability: Cobwebs * 0.02, seed: Seed + 77.0))
    |> StoreNamedAttribute[FLOAT_VECTOR](name: "ts_wrot_n", value: vector_math_3)
  align_rotation_to_vector = AlignRotationToVector[axis: X, pivot_axis: Z](
    rotation: AlignRotationToVector(
      vector: NamedAttribute[FLOAT_VECTOR](name: "ts_wrot_n").attribute),
    vector: normalize(vector_math_4 - vector_math_3 * (vector_math_4 ⋅ vector_math_3)))
  random_value_2 = RandomValue(min: 0.02, max: 0.06, seed: Seed + 91.0)
  combine_xyz = CombineXYZ(
    x: random_value_2,
    y: random_value_2 * RandomValue(min: 0.7, max: 1.1, seed: Seed + 92.0),
    z: Thickness * 1.05 + 0.001)
  vector_math_5 = Position() * 70.0
  vector_math_6 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_wrot_n").attribute)
  raycast = Raycast(
    group_3,
    source_position: Position() + vector_math_6 * 0.03,
    ray_direction: -vector_math_6,
    ray_length: 0.06)
  vector_math_7 = Position() * 70.0
  vector_math_8 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_wrot_n").attribute)
  raycast_2 = Raycast(
    group_3,
    source_position: Position() + vector_math_8 * 0.03,
    ray_direction: -vector_math_8,
    ray_length: 0.06)
  boolean_math = named_attribute.attribute
    and Compare[GREATER_THAN](a: NamedAttribute[FLOAT_VECTOR](name: "ts_fn").attribute, b: -2.0)
  distribute_points_on_faces = DistributePointsOnFaces(
    store_named_attribute,
    selection: named_attribute.attribute,
    density: Debris * 26.0,
    seed: Seed + 31.0)
  position_4 = Position()
  random_value_3 = RandomValue(max: 6.2831855, seed: Seed + 35.0)
  random_value_4 = RandomValue(min: 0.03, max: 0.085, seed: Seed + 36.0)
  noise_texture = NoiseTexture(vector: Position() * 60.0, scale: 1.0)
  vector_math_9 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute)
  distribute_points_on_faces_2 = DistributePointsOnFaces(
    store_named_attribute,
    selection: named_attribute.attribute,
    density: Debris * 7.0,
    seed: Seed + 41.0)
  position_5 = Position()
  math_2 = atan2(position_5.y, position_5.x)
  random_value_5 = RandomValue(min: 0.03, max: 0.075, seed: Seed + 45.0)
  vector_math_10 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute)
  raycast_3 = Raycast(
    group_3,
    source_position: Position() + vector_math_10 * 0.03,
    ray_direction: -vector_math_10,
    ray_length: 0.08)
  distribute_points_on_faces_3 = DistributePointsOnFaces(
    store_named_attribute,
    selection: named_attribute.attribute,
    density: Hairs * 60.0,
    seed: Seed + 61.0)
  random_value_6 = RandomValue(max: 6.2831855, seed: Seed + 62.0)
  random_value_7 = RandomValue(min: 0.025, max: 0.07, seed: Seed + 63.0)
  vector_math_11 = Position() * 45.0
  vector_math_12 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute)
  combine_xyz_2 = CombineXYZ(
    x: NoiseTexture(vector: vector_math_11, scale: 1.0).factor - 0.5,
    y: NoiseTexture(vector: vector_math_11 + (13.0, 7.0, 3.0), scale: 1.0).factor - 0.5)
  raycast_4 = Raycast(
    group_3,
    source_position: Position() + vector_math_12 * 0.02,
    ray_direction: -vector_math_12,
    ray_length: 0.05)
  distribute_points_on_faces_4 = DistributePointsOnFaces(
    store_named_attribute,
    selection: named_attribute.attribute,
    density: Hairs * 250.0,
    seed: Seed + 71.0)
  random_value_8 = RandomValue(max: 6.2831855, seed: Seed + 72.0)
  random_value_9 = RandomValue(min: 0.004, max: 0.018, seed: Seed + 73.0)
  vector_math_13 = Position() * 160.0
  vector_math_14 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute)
  combine_xyz_3 = CombineXYZ(
    x: NoiseTexture(vector: vector_math_13, scale: 1.0).factor - 0.5,
    y: NoiseTexture(vector: vector_math_13 + (13.0, 7.0, 3.0), scale: 1.0).factor - 0.5)
  raycast_5 = Raycast(
    group_3,
    source_position: Position() + vector_math_14 * 0.02,
    ray_direction: -vector_math_14,
    ray_length: 0.05)
  join_geometry = Switch[GEOMETRY](
      switch: Debris > 0.0,
      true_: distribute_points_on_faces_2.points
        |> StoreNamedAttribute[FLOAT_VECTOR](
          name: "ts_snrm",
          value: distribute_points_on_faces_2.normal)
        |> StoreNamedAttribute(name: "ts_drand", value: RandomValue(seed: Seed + 43.0))
        |> InstanceOnPoints(
          instance: Grid(vertices_x: 14, vertices_y: 14).mesh
            |> StoreNamedAttribute[FLOAT_VECTOR](name: "ts_duv", value: Position() * 1.0)
            |> DeleteGeometry(
              selection: length(CombineXYZ(x: position_5.x, y: position_5.y))
                > 0.36
                  + NoiseTexture(
                      vector: CombineXYZ(x: cos(math_2), y: sin(math_2)),
                      scale: 2.5,
                      roughness: 0.6).factor
                    * 0.22),
          rotation: AlignRotationToVector[axis: X, pivot_axis: Z](
            rotation: AlignRotationToVector(
              vector: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute),
            vector: CombineXYZ(x: cos(random_value_5 * 400.0), y: sin(random_value_5 * 400.0))),
          scale: CombineXYZ(x: random_value_5, y: random_value_5, z: random_value_5))
        |> RealizeInstances()
        |> SetPosition(
          offset: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute
            * (0.0008
              + NoiseTexture(
                  vector: Position() * 70.0,
                  scale: 1.0,
                  detail: 3.0,
                  roughness: 0.6).factor
                * 0.005))
        |> SetPosition(
          offset: vector_math_10
            * (max((raycast_3.hit_position - Position()) ⋅ vector_math_10 + 0.0006, 0.0)
              * raycast_3.is_hit))
        |> DeleteGeometry(selection: not raycast_3.is_hit)
        |> SetMaterial(material: "Tessera Rag"))
    + Switch[GEOMETRY](
      switch: Debris > 0.0,
      true_: distribute_points_on_faces.points
        |> StoreNamedAttribute[FLOAT_VECTOR](
          name: "ts_snrm",
          value: distribute_points_on_faces.normal)
        |> StoreNamedAttribute(name: "ts_drand", value: RandomValue(seed: Seed + 33.0))
        |> InstanceOnPoints(
          instance: CurveLine(start: (-0.5, 0.0, 0.0), end: (0.5, 0.0, 0.0))
            |> ResampleCurve(count: 7)
            |> SetPosition(
              position: CombineXYZ(
                x: position_4.x,
                y: (position_4.x * position_4.x * 4.0 - 1.0) * 0.05)),
          rotation: AlignRotationToVector[axis: X, pivot_axis: Z](
            rotation: AlignRotationToVector(
              vector: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute),
            vector: CombineXYZ(
              x: cos(random_value_3),
              y: sin(random_value_3),
              z: sin(random_value_3 * 3.1) * 0.3)),
          scale: CombineXYZ(x: random_value_4, y: random_value_4, z: random_value_4))
        |> RealizeInstances()
        |> SetPosition(
          offset: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute * 0.0009
            + CombineXYZ(x: noise_texture.factor - 0.5, y: noise_texture.factor - 0.5) * 0.004)
        |> DeleteGeometry[CURVE](
          selection: EvaluateOnDomain[CURVE](
              value: EndpointSelection()
                  and not Raycast(
                    group_3,
                    source_position: Position() + vector_math_9 * 0.03,
                    ray_direction: -vector_math_9,
                    ray_length: 0.08).is_hit
                ? 1.0
                : 0.0)
            > 0.0)
        |> CurveToMesh(profile_curve: CurveCircle(resolution: 6, radius: 0.0007))
        |> SetMaterial(material: "Tessera Straw"))
    + Switch[GEOMETRY](
      switch: Cobwebs > 0.0,
      true_: (store_named_attribute_2
          |> InstanceOnPoints(
            instance: MeshCircle[TRIANGLE_FAN](vertices: 72, radius: 0.95)
              |> DeleteGeometry(
                selection: abs(atan2(position_2.y, position_2.x)) > 1.06
                  and length(CombineXYZ(x: position_2.x, y: position_2.y)) > 0.01)
              |> SetPosition(
                position: CombineXYZ(
                  x: position_2.x,
                  y: position_2.y,
                  z: -vector_math_2 - vector_math_2 * 0.08)),
            rotation: align_rotation_to_vector,
            scale: combine_xyz)
          |> RealizeInstances()
          |> SetPosition(
            offset: CombineXYZ(
                x: NoiseTexture(vector: vector_math_7, scale: 1.0).factor - 0.5,
                y: NoiseTexture(vector: vector_math_7 + (17.0, 3.0, 5.0), scale: 1.0).factor - 0.5,
                z: NoiseTexture(vector: vector_math_7 + (4.0, 29.0, 11.0), scale: 1.0).factor - 0.5)
              * 0.014)
          |> SetPosition(
            offset: vector_math_8
              * (max((raycast_2.hit_position - Position()) ⋅ vector_math_8 + 0.0004, 0.0)
                * raycast_2.is_hit))
          |> SetMaterial(material: "Tessera Cobweb Gauze"))
        + (store_named_attribute_2
          |> InstanceOnPoints(
            instance: (Points(
                  count: 44,
                  position: CombineXYZ(
                    x: math * cos(random_value),
                    y: math * sin(random_value),
                    z: -math))
                |> PointsToCurves(curve_group_id: floor(Index() / 2.0), weight: Index())
                |> ResampleCurve(count: 6)
                |> SetPosition(
                  offset: CombineXYZ(
                    z: SplineLength().length * -0.12 * sin(SplineParameter().factor * 3.1415927))))
              + (Points(count: 3)
                |> InstanceOnPoints(
                  instance: Arc(resolution: 14, start_angle: -1.05, sweep_angle: 2.1),
                  scale: 0.3 + Index() * 0.27)
                |> RealizeInstances()
                |> SetPosition(
                  position: CombineXYZ(
                    x: position.x,
                    y: position.y,
                    z: -vector_math
                      - vector_math * 0.18 * sin(SplineParameter().factor * 3.1415927))))
              + (Points(count: 5)
                |> InstanceOnPoints(
                  instance: CurveLine(end: (1.0, 0.0, -1.0)) |> ResampleCurve(count: 6),
                  rotation: CombineXYZ(z: -0.95 + Index() * 0.475),
                  scale: RandomValue(min: 0.75, seed: Seed + 5.0))
                |> RealizeInstances()),
            rotation: align_rotation_to_vector,
            scale: combine_xyz)
          |> RealizeInstances()
          |> SetPosition(
            offset: CombineXYZ(
                x: NoiseTexture(vector: vector_math_5, scale: 1.0).factor - 0.5,
                y: NoiseTexture(vector: vector_math_5 + (17.0, 3.0, 5.0), scale: 1.0).factor - 0.5,
                z: NoiseTexture(vector: vector_math_5 + (4.0, 29.0, 11.0), scale: 1.0).factor - 0.5)
              * 0.012)
          |> SetPosition(
            offset: vector_math_6
              * (max((raycast.hit_position - Position()) ⋅ vector_math_6 + 0.0004, 0.0)
                * raycast.is_hit))
          |> CurveToMesh(profile_curve: CurveCircle(resolution: 3, radius: 0.00011))
          |> SetMaterial(material: "Tessera Cobweb")))
    + Switch[GEOMETRY](
      switch: Hairs > 0.0,
      true_: (distribute_points_on_faces_4.points
          |> StoreNamedAttribute[FLOAT_VECTOR](
            name: "ts_snrm",
            value: distribute_points_on_faces_4.normal)
          |> InstanceOnPoints(
            instance: CurveLine(start: (-0.5, 0.0, 0.0), end: (0.5, 0.0, 0.0))
              |> ResampleCurve(count: 24),
            rotation: AlignRotationToVector[axis: X, pivot_axis: Z](
              rotation: AlignRotationToVector(
                vector: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute),
              vector: CombineXYZ(x: cos(random_value_8), y: sin(random_value_8))),
            scale: CombineXYZ(x: random_value_9, y: random_value_9, z: random_value_9))
          |> RealizeInstances()
          |> SetPosition(
            offset: (combine_xyz_3 - vector_math_14 * (combine_xyz_3 ⋅ vector_math_14)) * 0.012)
          |> SetPosition(
            offset: vector_math_14
              * (((raycast_5.hit_position - Position()) ⋅ vector_math_14 + 5.4e-05)
                * raycast_5.is_hit))
          |> CurveToMesh(profile_curve: CurveCircle(resolution: 3, radius: 4.5e-05))
          |> SetMaterial(material: "Tessera Lint"))
        + (distribute_points_on_faces_3.points
          |> StoreNamedAttribute[FLOAT_VECTOR](
            name: "ts_snrm",
            value: distribute_points_on_faces_3.normal)
          |> InstanceOnPoints(
            instance: CurveLine(start: (-0.5, 0.0, 0.0), end: (0.5, 0.0, 0.0))
              |> ResampleCurve(count: 24),
            rotation: AlignRotationToVector[axis: X, pivot_axis: Z](
              rotation: AlignRotationToVector(
                vector: NamedAttribute[FLOAT_VECTOR](name: "ts_snrm").attribute),
              vector: CombineXYZ(x: cos(random_value_6), y: sin(random_value_6))),
            scale: CombineXYZ(x: random_value_7, y: random_value_7, z: random_value_7))
          |> RealizeInstances()
          |> SetPosition(
            offset: (combine_xyz_2 - vector_math_12 * (combine_xyz_2 ⋅ vector_math_12)) * 0.012)
          |> SetPosition(
            offset: vector_math_12
              * (((raycast_4.hit_position - Position()) ⋅ vector_math_12 + 4.8e-05)
                * raycast_4.is_hit))
          |> CurveToMesh(profile_curve: CurveCircle(resolution: 3, radius: 4e-05))
          |> SetMaterial(material: "Tessera Hair")))
  position_6 = Position()
  vector_math_15 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_fn").attribute)
  vector_math_16 = position_6 - NamedAttribute[FLOAT_VECTOR](name: "ts_fc").attribute
  vector_math_17 = normalize(NamedAttribute[FLOAT_VECTOR](name: "ts_pn").attribute - position_6)
  random_value_10 = RandomValue(min: 0.015, max: 0.045, seed: Seed + 53.0)
  random_value_11 = RandomValue(min: 0.0025, max: 0.0055, seed: Seed + 55.0)
  named_attribute_2 = NamedAttribute(name: "ts_spt")
  return join_geometry
    + (Switch[GEOMETRY](
          switch: Splinters > 0.0,
          true_: store_named_attribute
            |> MeshToPoints[CORNERS](
              selection: named_attribute.attribute
                and RandomValue[BOOLEAN](probability: Splinters * 0.08, seed: Seed + 51.0))
            |> DeleteGeometry(
              selection: not (normalize(
                      position_6 - NamedAttribute[FLOAT_VECTOR](name: "ts_pp").attribute)
                    × vector_math_17)
                  ⋅ vector_math_15
                > 0.0)
            |> StoreNamedAttribute[FLOAT_VECTOR](name: "ts_spn", value: vector_math_15)
            |> StoreNamedAttribute[FLOAT_VECTOR](name: "ts_spe", value: vector_math_17)
            |> StoreNamedAttribute[FLOAT_VECTOR](
              name: "ts_spo",
              value: normalize(vector_math_16 - vector_math_15 * (vector_math_16 ⋅ vector_math_15)))
            |> StoreNamedAttribute(name: "ts_spl", value: random_value_10)
            |> StoreNamedAttribute(
              name: "ts_sptan",
              value: RandomValue(min: 0.15, max: 0.55, seed: Seed + 54.0))
            |> SetPosition(
              offset: NamedAttribute[FLOAT_VECTOR](name: "ts_spo").attribute * -0.0012
                + NamedAttribute[FLOAT_VECTOR](name: "ts_spn").attribute * -0.0006)
            |> InstanceOnPoints(
              instance: Cone(vertices: 4, side_segments: 4, depth: 1.0).mesh
                |> TransformGeometry(translation: (0.5, 0.0, 0.0), rotation: (0.0, 1.5707964, 0.0))
                |> StoreNamedAttribute(name: "ts_spt", value: Position().x),
              rotation: AlignRotationToVector[axis: X, pivot_axis: Z](
                rotation: AlignRotationToVector(
                  vector: NamedAttribute[FLOAT_VECTOR](name: "ts_spn").attribute),
                vector: NamedAttribute[FLOAT_VECTOR](name: "ts_spe").attribute),
              scale: CombineXYZ(x: random_value_10, y: random_value_11, z: random_value_11 * 0.45))
            |> RealizeInstances()
            |> SetPosition(
              offset: NamedAttribute[FLOAT_VECTOR](name: "ts_spn").attribute
                * (named_attribute_2.attribute
                  * named_attribute_2.attribute
                  * NamedAttribute(name: "ts_spl").attribute
                  * NamedAttribute(name: "ts_sptan").attribute))
            |> StoreNamedAttribute(name: "ts_frac", value: named_attribute_2.attribute * 0.55)
            |> StoreNamedAttribute[FACE](name: "ts_bevel", value: 1.0)
            |> RemoveNamedAttribute(name: "ts_spn")
            |> RemoveNamedAttribute(name: "ts_spe")
            |> RemoveNamedAttribute(name: "ts_spo")
            |> RemoveNamedAttribute(name: "ts_spl")
            |> RemoveNamedAttribute(name: "ts_sptan")
            |> RemoveNamedAttribute(name: "ts_spt")
            |> RemoveNamedAttribute(name: "ts_fn")
            |> RemoveNamedAttribute(name: "ts_fc")
            |> RemoveNamedAttribute(name: "ts_pn")
            |> RemoveNamedAttribute(name: "ts_pp"))
        + group_3
      |> RemoveNamedAttribute(name: "ts_cp")
      |> RemoveNamedAttribute(name: "ts_k")
      |> RemoveNamedAttribute(name: "ts_lc")
      |> RemoveNamedAttribute(name: "ts_psize")
      |> RemoveNamedAttribute(name: "ts_la")
      |> RemoveNamedAttribute(name: "ts_lb")
      |> RemoveNamedAttribute(name: "ts_cc")
      |> RemoveNamedAttribute(name: "ts_top")
      |> RemoveNamedAttribute(name: "ts_flow")
      |> RemoveNamedAttribute(name: "ts_c2")
      |> RemoveNamedAttribute(name: "ts_alpha")
      |> SetMaterial(material: tile_material)
      |> SetMaterial(
        selection: NamedAttribute[BOOLEAN](name: "ts_strap").attribute,
        material: grout_material))
    + (Switch[GEOMETRY](
        switch: grout_bed and not single_cell and not Openwork,
        true_: tessera_bed(
          switch,
          mapping: menu_switch.output,
          shape: menu_switch_2.output,
          width: Width,
          height: Height,
          sides: Sides,
          thickness: Thickness,
          grout_depth: grout_depth,
          shape_offset: shape_offset,
          clip_to_shape: clip_to_shape,
          region_min: group.region_min,
          region_max: group.region_max,
          uv_map: uv_map,
          uv_scale: uv_scale,
          holes: group_2.holes))
      |> SetMaterial(material: grout_material))
    + Switch[GEOMETRY](switch: keep_original, true_: Geometry)
}
