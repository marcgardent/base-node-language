geometry graph "Tessera · Region"(
    Position: Vector,
    Shape: Int,
    "Half Size": Vector,
    Margin: Float,
    Region: Int,
    Sides: Int = 8
) -> (Inside: Bool, Clamped: Vector) {
  math = max(half_size.x - Margin, 1e-05)
  math_2 = max(half_size.y - Margin, 1e-05)
  math_3 = 6.2831855 / max(Sides, 3.0)
  math_4 = abs(Position.x)
  math_5 = abs(Position.y)
  math_6 = length(CombineXYZ(x: Position.x, y: Position.y))
    * cos(
      Math[FLOORED_MODULO](
          Value: atan2(Position.y, Position.x) + 1.5707964 + math_3 * 0.5,
          Value_001: math_3)
        - math_3 * 0.5)
  math_7 = half_size.y - half_size.x
  index_switch = IndexSwitch(
    Shape,
    math_4 <= half_size.x and math_5 <= half_size.y,
    pow(Position.x / half_size.x, 2.0) + pow(Position.y / half_size.y, 2.0) <= 1.0,
    math_4 <= half_size.x and Position.y >= -half_size.y and Position.y <= math_7
      or Position.y > math_7
        and length(CombineXYZ(x: Position.x, y: Position.y - math_7)) <= half_size.x,
    math_6 <= min(half_size.x, half_size.y))
  math_8 = math_2 - math
  index_switch_2 = IndexSwitch(
    Shape,
    math_4 <= math and math_5 <= math_2,
    pow(Position.x / math, 2.0) + pow(Position.y / math_2, 2.0) <= 1.0,
    math_4 <= math and Position.y >= -math_2 and Position.y <= math_8
      or Position.y > math_8 and length(CombineXYZ(x: Position.x, y: Position.y - math_8)) <= math,
    math_6 <= min(math, math_2))
  compare = Region == 1
  switch = compare ? math : half_size.x
  switch_2 = compare ? math_2 : half_size.y
  math_9 = switch_2 - switch
  combine_xyz = CombineXYZ(x: Position.x, y: Position.y - math_9)
  switch_3 = Position.y > math_9
    ? CombineXYZ(y: math_9) + combine_xyz * min(1.0, switch / max(length(combine_xyz), 1e-09))
    : CombineXYZ(x: Position.x, y: Position.y)
  return (
    Inside: IndexSwitch(Region, index_switch, index_switch_2, index_switch and not index_switch_2),
    Clamped: IndexSwitch(
      Shape,
      CombineXYZ(
        x: min(max(Position.x, -switch), switch),
        y: min(max(Position.y, -switch_2), switch_2)),
      CombineXYZ(x: Position.x, y: Position.y)
        * (1.0 / max(sqrt(pow(Position.x / switch, 2.0) + pow(Position.y / switch_2, 2.0)), 1.0)),
      CombineXYZ(x: min(max(switch_3.x, -switch), switch), y: max(switch_3.y, -switch_2)),
      CombineXYZ(x: Position.x, y: Position.y) * (1.0 / max(math_6 / min(switch, switch_2), 1.0))))
}

geometry graph "Tessera · Bed"(
    Surface: Geometry,
    Mapping: Int,
    Shape: Int,
    Width: Float,
    Height: Float,
    Sides: Int,
    Thickness: Float,
    "Grout Depth": Float,
    "Shape Offset": Vector,
    "Clip to Shape": Bool,
    "Region Min": Vector,
    "Region Max": Vector,
    "UV Map": String,
    "UV Scale": Float,
    Holes: Geometry
) -> Geometry {
  math = Width * 0.5
  math_2 = Height * 0.5
  math_3 = max(Thickness - grout_depth, 1e-05)
  math_4 = (math + math_2) * 4.0
  math_5 = Index() / 256.0 * 6.2831855
  vector_math = shape_offset * (1.0, 1.0, 0.0)
  merge_by_distance = Points(
      count: 256,
      position: tessera_region(
          position: CombineXYZ(x: math_4 * cos(math_5), y: math_4 * sin(math_5)),
          shape: Shape,
          half_size: CombineXYZ(x: math, y: math_2),
          sides: Sides).clamped
        + vector_math)
    |> PointsToCurves(weight: Index())
    |> SetSplineCyclic(cyclic: true)
    |> FillCurve(mode: "N-gons")
    |> MergeByDistance(distance: 1e-05)
  extrude_mesh = ExtrudeMesh(
    merge_by_distance,
    offset: (0.0, 0.0, 1.0),
    offset_scale: math_3,
    individual: false)
  set_position = SetPosition(Holes, offset: (0.0, 0.0, -0.001))
  delete_geometry = Surface
    |> SetPosition(offset: Normal().normal * math_3)
    |> DeleteGeometry[FACE](
      selection: clip_to_shape
        and not tessera_region(
          position: EvaluateOnDomain[FACE, FLOAT_VECTOR](
              value: Mapping == 2
                ? NamedAttribute[FLOAT_VECTOR](name: uv_map).attribute * uv_scale
                : Position())
            - CombineXYZ(
              x: (region_min.x + region_max.x) * 0.5,
              y: (region_min.y + region_max.y) * 0.5)
            - vector_math,
          shape: Shape,
          half_size: CombineXYZ(x: math, y: math_2),
          sides: Sides).inside)
  return IndexSwitch(
    Mapping,
    DomainSize(Holes).face_count > 0
      ? (Holes
          |> SetPosition(offset: CombineXYZ(z: Thickness * 0.08))
          |> StoreNamedAttribute[FACE](name: "ts_socket", value: 1.0))
        + (FlipFaces(merge_by_distance) + extrude_mesh.mesh
          |> MergeByDistance(distance: 1e-07)
          |> MeshBoolean[DIFFERENCE, EXACT](
            MergeByDistance(
              FlipFaces(set_position)
                + ExtrudeMesh(
                  set_position,
                  offset: (0.0, 0.0, 1.0),
                  offset_scale: math_3 + 0.002,
                  individual: false).mesh,
              distance: 1e-07)).mesh)
      : extrude_mesh.mesh,
    delete_geometry,
    delete_geometry)
}

geometry graph "Tessera · Color"(
    Geometry: Geometry,
    Motif: Geometry,
    "Region Min": Vector,
    "Region Max": Vector,
    Scale: Float,
    Rotation: Float,
    Seed: Int,
    Mapping: Int,
    "UV Scale": Float,
    "Color Mode": Int,
    Colors: Int,
    "Class Shift": Int,
    "Accent Chance": Float,
    "Gradient Angle": Float,
    "Band Size": Float,
    "Cluster Scale": Float,
    Dither: Float,
    Symmetry: Int,
    Folds: Int,
    "Hue Jitter": Float,
    "Saturation Jitter": Float,
    "Value Jitter": Float,
    "Color 1": Color,
    "Color 2": Color,
    "Color 3": Color,
    "Color 4": Color,
    "Color 5": Color,
    "Color 6": Color,
    "Color 7": Color,
    "Color 8": Color,
    "Weight 1": Float,
    "Weight 2": Float,
    "Weight 3": Float,
    "Weight 4": Float,
    "Weight 5": Float,
    "Weight 6": Float,
    "Weight 7": Float,
    "Weight 8": Float,
    "Metal 1": Float,
    "Metal 2": Float,
    "Metal 3": Float,
    "Metal 4": Float,
    "Metal 5": Float,
    "Metal 6": Float,
    "Metal 7": Float,
    "Metal 8": Float,
    Image: Image,
    "Image Fit": Int,
    "Image Mix": Float,
    "Flow Align": Float,
    "Rhythm Class": Int,
    "Rhythm Period": Int,
    "Rhythm Start": Int
) -> Geometry {
  math = max(region_max.x - region_min.x, 1e-06)
  math_2 = max(region_max.y - region_min.y, 1e-06)
  compare = Mapping == 2
  sample_index = SampleIndex[FLOAT_VECTOR](
    Motif,
    value: NamedAttribute[FLOAT_VECTOR](name: "ts_la").attribute)
  sample_index_2 = SampleIndex[FLOAT_VECTOR](
    Motif,
    value: NamedAttribute[FLOAT_VECTOR](name: "ts_lb").attribute)
  sample_index_3 = SampleIndex[FLOAT_VECTOR](
    Motif,
    value: NamedAttribute[FLOAT_VECTOR](name: "ts_cc").attribute)
  math_3 = sample_index.x * sample_index_2.y - sample_index.y * sample_index_2.x
  switch = abs(math_3) > 1e-09 ? math_3 : 1.0
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  vector_math = named_attribute.attribute
    - CombineXYZ(x: (region_min.x + region_max.x) * 0.5, y: (region_min.y + region_max.y) * 0.5)
  math_4 = abs(vector_math.x)
  vector_math_2 = length(CombineXYZ(x: vector_math.x, y: vector_math.y))
  math_5 = 6.2831855 / max(Folds, 1.0)
  math_6 = Math[FLOORED_MODULO](Value: atan2(vector_math.y, vector_math.x), Value_001: math_5)
  math_7 = min(math_6, math_5 - math_6)
  index_switch = IndexSwitch(
    Symmetry,
    CombineXYZ(x: vector_math.x, y: vector_math.y),
    CombineXYZ(x: math_4, y: vector_math.y),
    CombineXYZ(x: math_4, y: abs(vector_math.y)),
    CombineXYZ(x: vector_math_2 * cos(math_7), y: vector_math_2 * sin(math_7)))
  white_noise_texture = WhiteNoiseTexture["4D"](
    vector: VectorMath[SNAP](
      Vector: index_switch * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
      Vector_001: (0.0625, 0.0625, 1.0)),
    w: Seed + 0.531)
  separate_color = SeparateColor(color: white_noise_texture.color)
  separate_color_2 = SeparateColor(
    color: WhiteNoiseTexture["4D"](
      vector: VectorMath[SNAP](
        Vector: index_switch * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
        Vector_001: (0.0625, 0.0625, 1.0)),
      w: Seed + 0.917).color)
  math_8 = min(max(Colors, 1.0), 8.0)
  math_9 = NamedAttribute[INT](name: "ts_class").attribute + class_shift
  math_10 = Math[FLOORED_MODULO](Value: math_9, Value_001: math_8)
  math_11 = max(weight_1, 0.0) * (0.0 < math_8)
  math_12 = math_11 + max(weight_2, 0.0) * (1.0 < math_8)
  math_13 = math_12 + max(weight_3, 0.0) * (2.0 < math_8)
  math_14 = math_13 + max(weight_4, 0.0) * (3.0 < math_8)
  math_15 = math_14 + max(weight_5, 0.0) * (4.0 < math_8)
  math_16 = math_15 + max(weight_6, 0.0) * (5.0 < math_8)
  math_17 = math_16 + max(weight_7, 0.0) * (6.0 < math_8)
  math_18 = max(math_17 + max(weight_8, 0.0) * (7.0 < math_8), 1e-06)
  math_19 = separate_color.red * math_18
  math_20 = min(
    (math_19 > math_11 ? 1.0 : 0.0)
      + (math_19 > math_12 ? 1.0 : 0.0)
      + (math_19 > math_13 ? 1.0 : 0.0)
      + (math_19 > math_14 ? 1.0 : 0.0)
      + (math_19 > math_15 ? 1.0 : 0.0)
      + (math_19 > math_16 ? 1.0 : 0.0)
      + (math_19 > math_17 ? 1.0 : 0.0),
    math_8 - 1.0)
  math_21 = (separate_color.blue - 0.5) * Dither
  math_22 = cos(gradient_angle)
  math_23 = sin(gradient_angle)
  math_24 = min(
      max(
        (vector_math.x * math_22 + vector_math.y * math_23)
            / (0.5 * (math * abs(math_22) + math_2 * abs(math_23)) + 1e-06)
            * 0.5
          + 0.5
          + math_21,
        0.0),
      0.9999)
    * math_18
  math_25 = min(
      max(
        (NoiseTexture["4D"](
                vector: named_attribute.attribute * (1.0 / max(cluster_scale, 1e-05)),
                w: Seed * 1.37,
                scale: 1.0).factor
              - 0.5)
            * 2.6
          + 0.5
          + math_21,
        0.0),
      0.9999)
    * math_18
  math_26 = min(
    (math_25 > math_11 ? 1.0 : 0.0)
      + (math_25 > math_12 ? 1.0 : 0.0)
      + (math_25 > math_13 ? 1.0 : 0.0)
      + (math_25 > math_14 ? 1.0 : 0.0)
      + (math_25 > math_15 ? 1.0 : 0.0)
      + (math_25 > math_16 ? 1.0 : 0.0)
      + (math_25 > math_17 ? 1.0 : 0.0),
    math_8 - 1.0)
  vector_math_3 = NamedAttribute[FLOAT_VECTOR](name: "ts_cp").attribute
    - NamedAttribute[FLOAT_VECTOR](name: "ts_lc").attribute
  math_27 = sample_index_3.x
      * round((vector_math_3.x * sample_index_2.y - vector_math_3.y * sample_index_2.x) / switch)
    + sample_index_3.y
      * round((sample_index.x * vector_math_3.y - sample_index.y * vector_math_3.x) / switch)
  switch_2 = compare
    ? named_attribute.attribute * (1.0 / uv_scale)
    : CombineXYZ(
      x: (named_attribute.attribute.x - region_min.x) / math,
      y: (named_attribute.attribute.y - region_min.y) / math_2)
  image_info = ImageInfo(image: Image)
  math_28 = max(image_info.width, 1.0) / max(image_info.height, 1.0)
  switch_3 = compare ? 1.0 : math / math_2
  compare_2 = switch_3 > math_28
  math_29 = (switch_2.x - 0.5) * (switch_3 / math_28) + 0.5
  math_30 = (switch_2.y - 0.5) * (math_28 / switch_3) + 0.5
  index_switch_2 = IndexSwitch(
    image_fit,
    switch_2,
    compare_2 ? CombineXYZ(x: math_29, y: switch_2.y) : CombineXYZ(x: switch_2.x, y: math_30),
    compare_2 ? CombineXYZ(x: switch_2.x, y: math_30) : CombineXYZ(x: math_29, y: switch_2.y))
  image_texture = ImageTexture[CLIP](image: Image, vector: index_switch_2)
  math_31 = distance(image_texture.color, color_1) + (0.0 >= math_8) * 1000.0
  math_32 = distance(image_texture.color, color_2) + (1.0 >= math_8) * 1000.0
  math_33 = min(math_32, math_31)
  math_34 = distance(image_texture.color, color_3) + (2.0 >= math_8) * 1000.0
  math_35 = min(math_34, math_33)
  math_36 = distance(image_texture.color, color_4) + (3.0 >= math_8) * 1000.0
  math_37 = min(math_36, math_35)
  math_38 = distance(image_texture.color, color_5) + (4.0 >= math_8) * 1000.0
  math_39 = min(math_38, math_37)
  math_40 = distance(image_texture.color, color_6) + (5.0 >= math_8) * 1000.0
  math_41 = min(math_40, math_39)
  math_42 = distance(image_texture.color, color_7) + (6.0 >= math_8) * 1000.0
  math_43 = min(math_42, math_41)
  math_44 = distance(image_texture.color, color_8) + (7.0 >= math_8) * 1000.0
  math_45 = min(math_44, math_43)
  math_46 = round(
    IndexSwitch(
      color_mode,
      math_10,
      math_20,
      separate_color.green < accent_chance ? math_20 : math_10,
      min(
        (math_24 > math_11 ? 1.0 : 0.0)
          + (math_24 > math_12 ? 1.0 : 0.0)
          + (math_24 > math_13 ? 1.0 : 0.0)
          + (math_24 > math_14 ? 1.0 : 0.0)
          + (math_24 > math_15 ? 1.0 : 0.0)
          + (math_24 > math_16 ? 1.0 : 0.0)
          + (math_24 > math_17 ? 1.0 : 0.0),
        math_8 - 1.0),
      math_26,
      Math[FLOORED_MODULO](
        Value: floor(vector_math_2 / max(band_size, 1e-06) + math_21),
        Value_001: math_8),
      Math[FLOORED_MODULO](Value: math_27 + math_9, Value_001: math_8),
      math_10,
      image_info.width > 0
        ? (math_44 < math_43
          ? 7.0
          : math_42 < math_41
            ? 6.0
            : math_40 < math_39
              ? 5.0
              : math_38 < math_37
                ? 4.0
                : math_36 < math_35 ? 3.0 : math_34 < math_33 ? 2.0 : math_32 < math_31 ? 1.0 : 0.0)
        : math_26,
      Math[FLOORED_MODULO](
        Value: rhythm_class < 0 or NamedAttribute[INT](name: "ts_class").attribute == rhythm_class
          ? rhythm_start
            - 1.0
            + Math[FLOORED_MODULO](Value: math_27, Value_001: max(rhythm_period, 1.0))
          : math_10,
        Value_001: math_8)))
  index_switch_3 = IndexSwitch(
    math_46,
    color_1,
    color_2,
    color_3,
    color_4,
    color_5,
    color_6,
    color_7,
    color_8)
  separate_color_3 = SeparateColor[HSV](
    color: color_mode == 7
      ? Mix[RGBA](
        factor: image_texture.alpha * image_mix,
        a: index_switch_3,
        b: image_texture.color)
      : index_switch_3)
  math_47 = Scale / max(math, math_2) * 0.6
  math_48 = -math_47
  math_49 = ImageTexture[CLIP](image: Image, vector: index_switch_2 + CombineXYZ(x: math_47)).color
      ⋅ (0.2126, 0.7152, 0.0722)
    - ImageTexture[CLIP](image: Image, vector: index_switch_2 + CombineXYZ(x: math_48)).color
      ⋅ (0.2126, 0.7152, 0.0722)
  math_50 = ImageTexture[CLIP](image: Image, vector: index_switch_2 + CombineXYZ(y: math_47)).color
      ⋅ (0.2126, 0.7152, 0.0722)
    - ImageTexture[CLIP](image: Image, vector: index_switch_2 + CombineXYZ(y: math_48)).color
      ⋅ (0.2126, 0.7152, 0.0722)
  return Geometry
    |> StoreNamedAttribute[FLOAT_COLOR, FACE](
      name: "ts_color",
      value: CombineColor[HSV](
        red: fract(separate_color_3.red + (separate_color_2.red * 2.0 - 1.0) * hue_jitter),
        green: min(
          max(
            separate_color_3.green
              * (1.0 + (separate_color_2.green * 2.0 - 1.0) * saturation_jitter),
            0.0),
          1.0),
        blue: max(
          separate_color_3.blue * (1.0 + (separate_color_2.blue * 2.0 - 1.0) * value_jitter),
          0.0)))
    |> StoreNamedAttribute[FACE](
      name: "ts_metal",
      value: IndexSwitch(
        math_46,
        metal_1,
        metal_2,
        metal_3,
        metal_4,
        metal_5,
        metal_6,
        metal_7,
        metal_8))
    |> StoreNamedAttribute[FACE](name: "ts_rand", value: white_noise_texture.value)
    |> StoreNamedAttribute[FACE](
      name: "ts_flow",
      value: flow_align > 0.0
        ? (Math[FLOORED_MODULO](
              Value: atan2(math_50, math_49) - Rotation + 0.7853982,
              Value_001: 1.5707964)
            - 0.7853982)
          * (min(length(CombineXYZ(x: math_49, y: math_50)) * 12.0, 1.0) * flow_align)
        : 0.0)
}

geometry graph "Tessera · Map"(
    Geometry: Geometry,
    Surface: Geometry,
    Mapping: Int,
    "UV Map": String,
    "UV Scale": Float,
    "Bend to Surface": Bool,
    "Region Min": Vector,
    "Fit Repeats": Bool,
    "Wrap Width": Float
) -> Geometry {
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: uv_map)
  bounding_box = BoundingBox(Surface)
  math = bounding_box.max.z - bounding_box.min.z + 2.0
  boolean_math = fit_repeats and wrap_width > 1e-06
  named_attribute_2 = NamedAttribute[FLOAT_VECTOR](name: "ts_c2")
  named_attribute_3 = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  position = Position()
  math_2 = position.x - named_attribute_2.attribute.x
  math_3 = position.y - named_attribute_2.attribute.y
  normal = Normal()
  raycast = Raycast(
    Surface,
    source_position: CombineXYZ(
      x: named_attribute_2.attribute.x,
      y: named_attribute_2.attribute.y,
      z: bounding_box.max.z + 1.0),
    ray_length: math)
  raycast_2 = Raycast(
    Surface,
    source_position: CombineXYZ(
      x: named_attribute_3.attribute.x,
      y: named_attribute_3.attribute.y,
      z: bounding_box.max.z + 1.0),
    ray_length: math)
  switch = raycast.is_hit ? normalize(raycast.hit_normal) : normalize(raycast_2.hit_normal)
  vector_math = normalize((1.0, 0.0, 0.0) - switch * switch.x)
  vector_math_2 = (raycast.is_hit ? raycast.hit_position : raycast_2.hit_position)
    + vector_math * math_2
    + ((switch × vector_math) * math_3 + switch * position.z)
  vector_math_3 = CombineXYZ(
      x: boolean_math
        ? region_min.x
          + Math[FLOORED_MODULO](
            Value: named_attribute_2.attribute.x - region_min.x,
            Value_001: max(wrap_width, 1e-06))
        : named_attribute_2.attribute.x,
      y: named_attribute_2.attribute.y)
    * (1.0 / uv_scale)
  switch_2 = SampleUVSurface[FLOAT_VECTOR](
      Surface,
      value: Position(),
      uv_map: named_attribute.attribute,
      sample_uv: vector_math_3).is_valid
    ? vector_math_3
    : CombineXYZ(
        x: boolean_math
          ? region_min.x
            + Math[FLOORED_MODULO](
              Value: named_attribute_3.attribute.x - region_min.x,
              Value_001: max(wrap_width, 1e-06))
          : named_attribute_3.attribute.x,
        y: named_attribute_3.attribute.y)
      * (1.0 / uv_scale)
  sample_uvsurface = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2)
  vector_math_4 = normalize(
    SampleUVSurface[FLOAT_VECTOR](
      Surface,
      value: normal.normal,
      uv_map: named_attribute.attribute,
      sample_uv: switch_2).value)
  sample_uvsurface_2 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2 + (0.001, 0.0, 0.0))
  switch_3 = sample_uvsurface_2.is_valid
    ? sample_uvsurface_2.value - sample_uvsurface.value
    : sample_uvsurface.value
      - SampleUVSurface[FLOAT_VECTOR](
        Surface,
        value: Position(),
        uv_map: named_attribute.attribute,
        sample_uv: switch_2 - (0.001, 0.0, 0.0)).value
  sample_uvsurface_3 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: switch_2 + (0.0, 0.001, 0.0))
  vector_math_5 = normalize(switch_3 - vector_math_4 * (switch_3 ⋅ vector_math_4))
  vector_math_6 = vector_math_4 × vector_math_5
  vector_math_7 = sample_uvsurface.value
    + vector_math_5 * math_2
    + ((vector_math_6
              ⋅ (sample_uvsurface_3.is_valid
                ? sample_uvsurface_3.value - sample_uvsurface.value
                : sample_uvsurface.value
                  - SampleUVSurface[FLOAT_VECTOR](
                    Surface,
                    value: Position(),
                    uv_map: named_attribute.attribute,
                    sample_uv: switch_2 - (0.0, 0.001, 0.0)).value)
            < 0.0
          ? -vector_math_6
          : vector_math_6)
        * math_3
      + vector_math_4 * position.z)
  vector_math_8 = CombineXYZ(
      x: boolean_math
        ? region_min.x
          + Math[FLOORED_MODULO](
            Value: position.x - region_min.x,
            Value_001: max(wrap_width, 1e-06))
        : position.x,
      y: position.y)
    * (1.0 / uv_scale)
  sample_uvsurface_4 = SampleUVSurface[FLOAT_VECTOR](
    Surface,
    value: Position(),
    uv_map: named_attribute.attribute,
    sample_uv: vector_math_8)
  raycast_3 = Raycast(
    Surface,
    source_position: CombineXYZ(x: position.x, y: position.y, z: bounding_box.max.z + 1.0),
    ray_length: math)
  return SetPosition(
    Geometry,
    position: IndexSwitch(
      Mapping,
      position,
      bend_to_surface
        ? (raycast_3.is_hit
          ? raycast_3.hit_position + normalize(raycast_3.hit_normal) * position.z
          : vector_math_2)
        : vector_math_2,
      bend_to_surface
        ? (sample_uvsurface_4.is_valid
          ? sample_uvsurface_4.value
            + normalize(
                SampleUVSurface[FLOAT_VECTOR](
                  Surface,
                  value: normal.normal,
                  uv_map: named_attribute.attribute,
                  sample_uv: vector_math_8).value)
              * position.z
          : vector_math_7)
        : vector_math_7))
}

geometry graph "Tessera · Pieces"(
    Surface: Geometry,
    Motif: Geometry,
    Scale: Float,
    Rotation: Float,
    Offset: Vector,
    "Center Pattern": Bool,
    Mapping: Int,
    Shape: Int,
    Width: Float,
    Height: Float,
    Sides: Int,
    Region: Int,
    "Border Width": Float,
    Edge: Int,
    "Single Cell": Bool,
    Piece: Int,
    "Max Cells": Int,
    "UV Map": String,
    "UV Scale": Float,
    Seed: Int,
    Missing: Float,
    "Shape Offset": Vector,
    "Clip to Shape": Bool,
    "Fit Repeats": Bool,
    "Wrap Width": Float,
    "Fit Multiple": Int
) -> (
    Geometry: Geometry,
    "Region Min": Vector,
    "Region Max": Vector,
    "Scale Out": Float,
    Gone: Geometry
) {
  sample_index = SampleIndex[FLOAT_VECTOR](
    Motif,
    value: NamedAttribute[FLOAT_VECTOR](name: "ts_la").attribute)
  sample_index_2 = SampleIndex[FLOAT_VECTOR](
    Motif,
    value: NamedAttribute[FLOAT_VECTOR](name: "ts_lb").attribute)
  math = sample_index.x * sample_index_2.y - sample_index.y * sample_index_2.x
  switch = abs(math) > 1e-09 ? math : 1.0
  math_2 = Width * 0.5
  math_3 = Height * 0.5
  bounding_box = BoundingBox(Surface)
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: uv_map)
  attribute_statistic = AttributeStatistic[FLOAT_VECTOR, CORNER](
    Surface,
    attribute: named_attribute.attribute)
  index_switch = IndexSwitch(
    Mapping,
    CombineXYZ(x: -math_2, y: -math_3),
    bounding_box.min,
    attribute_statistic.min * uv_scale)
  index_switch_2 = IndexSwitch(
    Mapping,
    CombineXYZ(x: math_2, y: math_3),
    bounding_box.max,
    attribute_statistic.max * uv_scale)
  combine_xyz = CombineXYZ(
    x: (index_switch.x + index_switch_2.x) * 0.5,
    y: (index_switch.y + index_switch_2.y) * 0.5)
  sample_index_3 = SampleIndex(Motif, value: NamedAttribute(name: "ts_hp").attribute)
  switch_2 = wrap_width > 1e-06 ? wrap_width : max(index_switch_2.x - index_switch.x, 1e-06)
  math_4 = max(fit_multiple, 1.0)
  switch_3 = fit_repeats and sample_index_3 > 1e-06
    ? switch_2
      / (max(round(switch_2 / max(sample_index_3 * Scale * math_4, 1e-09)), 1.0)
        * math_4
        * max(sample_index_3, 1e-09))
    : Scale
  vector_math = (center_pattern ? combine_xyz : (0.0, 0.0, 0.0)) + Offset
  math_5 = cos(Rotation)
  math_6 = sin(Rotation)
  math_7 = index_switch.x - vector_math.x
  math_8 = index_switch.y - vector_math.y
  math_9 = (math_5 * math_7 + math_6 * math_8) / switch_3
  math_10 = (math_5 * math_8 - math_6 * math_7) / switch_3
  math_11 = (math_9 * sample_index_2.y - math_10 * sample_index_2.x) / switch
  math_12 = (sample_index.x * math_10 - sample_index.y * math_9) / switch
  math_13 = index_switch_2.x - vector_math.x
  math_14 = index_switch.y - vector_math.y
  math_15 = (math_5 * math_13 + math_6 * math_14) / switch_3
  math_16 = (math_5 * math_14 - math_6 * math_13) / switch_3
  math_17 = (math_15 * sample_index_2.y - math_16 * sample_index_2.x) / switch
  math_18 = (sample_index.x * math_16 - sample_index.y * math_15) / switch
  math_19 = index_switch_2.x - vector_math.x
  math_20 = index_switch_2.y - vector_math.y
  math_21 = (math_5 * math_19 + math_6 * math_20) / switch_3
  math_22 = (math_5 * math_20 - math_6 * math_19) / switch_3
  math_23 = (math_21 * sample_index_2.y - math_22 * sample_index_2.x) / switch
  math_24 = (sample_index.x * math_22 - sample_index.y * math_21) / switch
  math_25 = index_switch.x - vector_math.x
  math_26 = index_switch_2.y - vector_math.y
  math_27 = (math_5 * math_25 + math_6 * math_26) / switch_3
  math_28 = (math_5 * math_26 - math_6 * math_25) / switch_3
  math_29 = (math_27 * sample_index_2.y - math_28 * sample_index_2.x) / switch
  math_30 = (sample_index.x * math_28 - sample_index.y * math_27) / switch
  math_31 = floor(min(min(math_11, math_17), min(math_23, math_29))) - 2.0
  math_32 = floor(min(min(math_12, math_18), min(math_24, math_30))) - 2.0
  math_33 = max(ceil(max(max(math_11, math_17), max(math_23, math_29))) + 2.0 - math_31 + 1.0, 1.0)
  boolean_math = single_cell
    or not SampleIndex[FLOAT_VECTOR](
        Motif,
        value: NamedAttribute[FLOAT_VECTOR](name: "ts_cc").attribute).z
      > 0.5
  index = Index()
  named_attribute_2 = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  combine_xyz_2 = CombineXYZ(x: math_2, y: math_3)
  vector_math_2 = combine_xyz + shape_offset * (1.0, 1.0, 0.0)
  math_34 = bounding_box.max.z - bounding_box.min.z + 2.0
  group = tessera_region(
    position: named_attribute_2.attribute - vector_math_2,
    shape: Shape,
    half_size: combine_xyz_2,
    margin: border_width,
    region: Region,
    sides: Sides)
  vector_math_3 = group.clamped + vector_math_2
  boolean_math_2 = group.inside or not clip_to_shape
  index_switch_3 = IndexSwitch(
    Mapping,
    group.inside,
    Raycast(
        Surface,
        source_position: CombineXYZ(
          x: named_attribute_2.attribute.x,
          y: named_attribute_2.attribute.y,
          z: bounding_box.max.z + 1.0),
        ray_length: math_34).is_hit
      and boolean_math_2,
    SampleUVSurface[FLOAT_VECTOR](
        Surface,
        value: Position(),
        uv_map: named_attribute.attribute,
        sample_uv: named_attribute_2.attribute * (1.0 / uv_scale)).is_valid
      and boolean_math_2)
  position = Position()
  group_2 = tessera_region(
    position: position - vector_math_2,
    shape: Shape,
    half_size: combine_xyz_2,
    margin: border_width,
    region: Region,
    sides: Sides)
  vector_math_4 = group_2.clamped + vector_math_2
  boolean_math_3 = group_2.inside or not clip_to_shape
  evaluate_on_domain = EvaluateOnDomain[FACE](
    value: EvaluateOnDomain(
      value: IndexSwitch(
          Mapping,
          group_2.inside,
          Raycast(
              Surface,
              source_position: CombineXYZ(
                x: position.x,
                y: position.y,
                z: bounding_box.max.z + 1.0),
              ray_length: math_34).is_hit
            and boolean_math_3,
          SampleUVSurface[FLOAT_VECTOR](
              Surface,
              value: Position(),
              uv_map: named_attribute.attribute,
              sample_uv: position * (1.0 / uv_scale)).is_valid
            and boolean_math_3)
        ? 1.0
        : 0.0))
  math_35 = max(math_2 - border_width, 1e-05)
  math_36 = max(math_3 - border_width, 1e-05)
  transform_geometry = Cube(size: CombineXYZ(x: math_35 * 2.0, y: math_36 * 2.0, z: 8.0)).mesh
    |> TransformGeometry(
      translation: CombineXYZ(),
      rotation: CombineXYZ(),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0))
  math_37 = max(Sides, 3.0)
  math_38 = 6.2831855 / math_37
  math_39 = math_36 - math_35
  math_40 = max(math_39 + math_36, 0.0001)
  transform_geometry_2 = IndexSwitch(
      Shape,
      transform_geometry,
      Cylinder(vertices: 160, depth: 8.0).mesh
        |> TransformGeometry(
          translation: CombineXYZ(),
          rotation: CombineXYZ(),
          scale: CombineXYZ(x: math_35, y: math_36, z: 1.0)),
      MeshBoolean[INTERSECT, EXACT](
        transform_geometry,
        MeshBoolean[UNION, EXACT](
          Cylinder(vertices: 160, radius: math_35, depth: 8.0).mesh
            |> TransformGeometry(
              translation: CombineXYZ(y: math_39),
              rotation: CombineXYZ(),
              scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
          Cube(size: CombineXYZ(x: math_35 * 2.0, y: math_40, z: 8.0)).mesh
            |> TransformGeometry(
              translation: CombineXYZ(y: -math_36 + math_40 * 0.5),
              rotation: CombineXYZ(),
              scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
          hole_tolerant: true).mesh,
        hole_tolerant: true).mesh,
      Cylinder(
          vertices: round(math_37),
          radius: min(math_35, math_36) / cos(math_38 * 0.5),
          depth: 8.0).mesh
        |> TransformGeometry(
          translation: CombineXYZ(),
          rotation: CombineXYZ(z: -1.5707964 + math_38 * 0.5),
          scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)))
    |> TransformGeometry(
      translation: vector_math_2,
      rotation: CombineXYZ(),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0))
  transform_geometry_3 = Cube(size: CombineXYZ(x: math_2 * 2.0, y: math_3 * 2.0, z: 8.0)).mesh
    |> TransformGeometry(
      translation: CombineXYZ(),
      rotation: CombineXYZ(),
      scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0))
  math_41 = max(Sides, 3.0)
  math_42 = 6.2831855 / math_41
  math_43 = math_3 - math_2
  math_44 = max(math_43 + math_3, 0.0001)
  separate_geometry = Points(
      count: round(
        boolean_math
          ? 1.0
          : min(
            math_33
              * max(
                ceil(max(max(math_12, math_18), max(math_24, math_30))) + 2.0 - math_32 + 1.0,
                1.0),
            max_cells)),
      position: sample_index
          * (boolean_math ? 0.0 : math_31 + Math[FLOORED_MODULO](Value: index, Value_001: math_33))
        + sample_index_2 * (boolean_math ? 0.0 : math_32 + floor(index / math_33)))
    |> InstanceOnPoints(instance: Motif)
    |> RealizeInstances()
    |> DeleteGeometry[FACE](
      selection: Piece >= 0 and NamedAttribute[INT](name: "ts_k").attribute != Piece)
    |> StoreNamedAttribute[FLOAT_VECTOR, FACE](name: "ts_cp", value: Position())
    |> TransformGeometry(
      translation: vector_math,
      rotation: CombineXYZ(z: Rotation),
      scale: CombineXYZ(x: switch_3, y: switch_3, z: switch_3))
    |> StoreNamedAttribute[FLOAT_VECTOR, FACE](name: "ts_c", value: Position())
    |> DeleteGeometry[FACE](
      selection: not (IndexSwitch(
          Edge,
          index_switch_3,
          evaluate_on_domain > 0.999,
          index_switch_3 or evaluate_on_domain > 0.001)
        or single_cell))
    |> SeparateGeometry[FACE](
      selection: Edge == 2
        and (Mapping == 0 or clip_to_shape)
        and not single_cell
        and EvaluateOnDomain[FACE](value: EvaluateOnDomain(value: group_2.inside ? 0.0 : 1.0))
          > 1e-06)
  mesh_boolean = MeshBoolean[INTERSECT, EXACT](
    Region == 1
      ? transform_geometry_2
      : IndexSwitch(
          Shape,
          transform_geometry_3,
          Cylinder(vertices: 160, depth: 8.0).mesh
            |> TransformGeometry(
              translation: CombineXYZ(),
              rotation: CombineXYZ(),
              scale: CombineXYZ(x: math_2, y: math_3, z: 1.0)),
          MeshBoolean[INTERSECT, EXACT](
            transform_geometry_3,
            MeshBoolean[UNION, EXACT](
              Cylinder(vertices: 160, radius: math_2, depth: 8.0).mesh
                |> TransformGeometry(
                  translation: CombineXYZ(y: math_43),
                  rotation: CombineXYZ(),
                  scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
              Cube(size: CombineXYZ(x: math_2 * 2.0, y: math_44, z: 8.0)).mesh
                |> TransformGeometry(
                  translation: CombineXYZ(y: -math_3 + math_44 * 0.5),
                  rotation: CombineXYZ(),
                  scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
              hole_tolerant: true).mesh,
            hole_tolerant: true).mesh,
          Cylinder(
              vertices: round(math_41),
              radius: min(math_2, math_3) / cos(math_42 * 0.5),
              depth: 8.0).mesh
            |> TransformGeometry(
              translation: CombineXYZ(),
              rotation: CombineXYZ(z: -1.5707964 + math_42 * 0.5),
              scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)))
        |> TransformGeometry(
          translation: vector_math_2,
          rotation: CombineXYZ(),
          scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
    separate_geometry.selection,
    hole_tolerant: true)
  boolean_math_4 = fit_repeats and wrap_width > 1e-06
  position_2 = Position()
  separate_geometry_2 = SeparateGeometry[FACE](
    Switch[GEOMETRY](
        switch: DomainSize(separate_geometry.selection).face_count > 0,
        true_: SplitEdges(
          Region == 2
            ? MeshBoolean[DIFFERENCE, EXACT](
              mesh_boolean.mesh,
              transform_geometry_2,
              hole_tolerant: true).mesh
            : mesh_boolean.mesh))
      + separate_geometry.inverted,
    selection: Edge == 2
      and Mapping == 2
      and not clip_to_shape
      and not single_cell
      and EvaluateOnDomain[FACE](
          value: EvaluateOnDomain(
            value: position_2.y < index_switch.y - 1e-06
                or position_2.y > index_switch_2.y + 1e-06
                or (position_2.x < index_switch.x - 1e-06
                    or position_2.x > index_switch_2.x + 1e-06)
                  and not boolean_math_4
              ? 1.0
              : 0.0))
        > 1e-06)
  named_attribute_3 = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  separate_geometry_3 = Switch[GEOMETRY](
        switch: DomainSize(separate_geometry_2.selection).face_count > 0,
        true_: MeshBoolean[INTERSECT, EXACT](
            Cube(
                size: CombineXYZ(
                  x: boolean_math_4 ? 10000.0 : index_switch_2.x - index_switch.x,
                  y: index_switch_2.y - index_switch.y,
                  z: 8.0)).mesh
              |> TransformGeometry(
                translation: CombineXYZ(
                  x: (index_switch.x + index_switch_2.x) * 0.5,
                  y: (index_switch.y + index_switch_2.y) * 0.5),
                rotation: CombineXYZ(),
                scale: CombineXYZ(x: 1.0, y: 1.0, z: 1.0)),
            separate_geometry_2.selection,
            hole_tolerant: true).mesh
          |> SplitEdges())
      + separate_geometry_2.inverted
    |> StoreNamedAttribute[FLOAT_VECTOR, FACE](name: "ts_c", value: Position())
    |> DeleteGeometry[FACE](
      selection: not IndexSwitch(
          Mapping,
          true,
          Raycast(
            Surface,
            source_position: CombineXYZ(
              x: named_attribute_3.attribute.x,
              y: named_attribute_3.attribute.y,
              z: bounding_box.max.z + 1.0),
            ray_length: math_34).is_hit,
          SampleUVSurface[FLOAT_VECTOR](
            Surface,
            value: Position(),
            uv_map: named_attribute.attribute,
            sample_uv: named_attribute_3.attribute * (1.0 / uv_scale)).is_valid)
        and not single_cell)
    |> SeparateGeometry[FACE](
      selection: SeparateColor(
          color: WhiteNoiseTexture["4D"](
            vector: VectorMath[SNAP](
              Vector: named_attribute_2.attribute * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
              Vector_001: (0.0625, 0.0625, 1.0)),
            w: Seed + 0.713).color).blue
        < Missing)
  return (
    Geometry: separate_geometry_3.inverted,
    "Region Min": index_switch,
    "Region Max": index_switch_2,
    "Scale Out": switch_3,
    Gone: separate_geometry_3.selection)
}

geometry graph "Tessera · Inset"(
    Geometry: Geometry,
    Distance: Float,
    Selection: Bool(hide_value: true) = true
) -> Geometry {
  index = Index()
  position = Position()
  evaluate_at_index = EvaluateAtIndex[CORNER, FLOAT_VECTOR](
    value: position,
    index: OffsetCornerInFace(corner_index: index, offset: -1))
  evaluate_at_index_2 = EvaluateAtIndex[CORNER, FLOAT_VECTOR](
    value: position,
    index: OffsetCornerInFace(corner_index: index, offset: 1))
  vector_math = normalize((position - evaluate_at_index) * (1.0, 1.0, 0.0))
  vector_math_2 = normalize((evaluate_at_index_2 - position) * (1.0, 1.0, 0.0))
  combine_xyz = CombineXYZ(x: -vector_math.y, y: vector_math.x)
  combine_xyz_2 = CombineXYZ(x: -vector_math_2.y, y: vector_math_2.x)
  vector_math_3 = (combine_xyz + combine_xyz_2)
    * (Distance / max(combine_xyz ⋅ combine_xyz_2 + 1.0, 0.08))
  return SetPosition(
    Geometry,
    offset: EvaluateOnDomain[CORNER, FLOAT_VECTOR](
        value: Selection
          ? vector_math_3
            * min(
              1.0,
              min(
                  length((position - evaluate_at_index) * (1.0, 1.0, 0.0)),
                  length((evaluate_at_index_2 - position) * (1.0, 1.0, 0.0)))
                * 0.45
                / max(length(vector_math_3), 1e-12))
          : (0.0, 0.0, 0.0))
      * VertexNeighbors().face_count)
}

geometry graph "Tessera · Solidify"(
    Geometry: Geometry,
    "Region Min": Vector,
    "Region Max": Vector,
    Scale: Float,
    Rotation: Float,
    Seed: Int,
    Mapping: Int,
    "UV Scale": Float,
    "Grout Width": Float,
    Thickness: Float,
    Bevel: Float,
    "Bevel Segments": Int,
    "Position Jitter": Float,
    "Rotation Jitter": Float,
    "Scale Jitter": Float,
    "Stretch Jitter": Float,
    "Edge Wobble": Float,
    "Height Jitter": Float,
    "Tilt Jitter": Float,
    "Quarter Turns": Bool,
    "Relief Class": Int,
    "Relief Height": Float,
    "Viewport Simplify": Bool,
    Strapwork: Bool,
    "Strap Height": Float,
    "Weave Depth": Float,
    "Chip Rim": Float,
    Openwork: Bool,
    "Band Joints": Float,
    "Broken Tiles": Float,
    "Grout Depth": Float,
    "Chip Depth": Float,
    "Joint Guard": Float,
    Bites: Float,
    "Bite Size": Float,
    "Bite Depth": Float,
    Gone: Geometry
) -> (Geometry: Geometry, Holes: Geometry) {
  combine_xyz = CombineXYZ(
    x: (region_min.x + region_max.x) * 0.5,
    y: (region_min.y + region_max.y) * 0.5)
  math = grout_width
    * 0.5
    * (AttributeStatistic[FACE](Geometry, attribute: NamedAttribute(name: "ts_band").attribute).max
        > 0.5
      ? (NamedAttribute(name: "ts_band").attribute > 0.5 ? band_joints : 2.0 - band_joints)
      : 1.0)
  edge_vertices = EdgeVertices()
  delete_geometry = DeleteGeometry[FACE](
    Geometry,
    selection: FaceArea()
        * 2.0
        / max(
          EvaluateOnDomain[FACE](
              value: EvaluateOnDomain[EDGE](
                value: length(edge_vertices.position_1 - edge_vertices.position_2)))
            * FaceNeighbors().vertex_count,
          1e-09)
      < (math + Bevel + chip_rim) * 1.15 + 1e-05)
  extrude_mesh = ExtrudeMesh(
    delete_geometry,
    offset: (0.0, 0.0, 1.0),
    offset_scale: 0.0,
    individual: false)
  compare = EvaluateOnDomain(
      value: EvaluateOnDomain[FACE](
        value: NamedAttribute[BOOLEAN](name: "ts_strap").attribute ? 1.0 : 0.0))
    < 0.999
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: "ts_c")
  white_noise_texture = WhiteNoiseTexture["4D"](
    vector: VectorMath[SNAP](
      Vector: named_attribute.attribute * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
      Vector_001: (0.0625, 0.0625, 1.0)),
    w: Seed + 0.131)
  separate_color = SeparateColor(color: white_noise_texture.color)
  white_noise_texture_2 = WhiteNoiseTexture["4D"](
    vector: VectorMath[SNAP](
      Vector: named_attribute.attribute * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
      Vector_001: (0.0625, 0.0625, 1.0)),
    w: Seed + 0.713)
  separate_color_2 = SeparateColor(color: white_noise_texture_2.color)
  math_2 = (separate_color_2.red * 2.0 - 1.0) * stretch_jitter
  math_3 = (white_noise_texture.value * 2.0 - 1.0) * scale_jitter
  math_4 = (separate_color.blue * 2.0 - 1.0) * rotation_jitter
  math_5 = (separate_color.red * 2.0 - 1.0) * position_jitter
  math_6 = (separate_color.green * 2.0 - 1.0) * position_jitter
  math_7 = min(
        max(math * 0.9, 0.0005)
          / max(
            length(CombineXYZ(x: math_5, y: math_6))
              + max(NamedAttribute(name: "ts_psize").attribute * (Scale * 0.72), 1e-06)
                * (abs(math_2) + abs(math_3) + abs(math_4)),
            1e-09),
        1.0)
      * joint_guard
    + (1.0 - joint_guard)
  math_8 = math_2 * math_7
  math_9 = separate_color_2.green * 3.1415927
  math_10 = math_4 * math_7 + NamedAttribute(name: "ts_flow").attribute
  vector_math = CombineXYZ(x: math_5, y: math_6) * math_7
  separate_color_3 = SeparateColor(
    color: WhiteNoiseTexture["4D"](
      vector: VectorMath[SNAP](
        Vector: Position() * (1.0 / Scale),
        Vector_001: (0.0078125, 0.0078125, 1.0)),
      w: Seed + 0.29).color)
  position = Position()
  separate_color_4 = SeparateColor(
    color: WhiteNoiseTexture["4D"](
      vector: VectorMath[SNAP](
        Vector: named_attribute.attribute * (1.0 / Scale) + (0.03125, 0.03125, 0.0),
        Vector_001: (0.0625, 0.0625, 1.0)),
      w: Seed + 0.913).color)
  compare_2 = separate_color_4.red < broken_tiles
  store_named_attribute = (Strapwork
      ? extrude_mesh.mesh
        |> StoreNamedAttribute[BOOLEAN, FACE](name: "ts_strap", value: extrude_mesh.side)
        |> tessera_inset(
