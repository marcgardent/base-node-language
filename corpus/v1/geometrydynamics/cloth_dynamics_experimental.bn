geometry graph "Object Effector"(Object: Object(optional_label: true)) -> (Effector: Bundle) {
  return (
    Effector: GetBundleItem[BUNDLE](
      bundle: ObjectInfo(object: Object).geometry |> GetGeometryBundle().bundle,
      path: "effectors").item)
}

geometry graph "Collection Effector"(
    Collection: Collection(optional_label: true),
    "Naming"(default_closed: true) {
        "Name Pattern": String(optional_label: true) = "effector_{}"
    }
) -> (Effectors: Bundle) {
  collection_children = CollectionChildren(collection: Collection, recursive: true)
  repeat_output = repeat(ListLength[OBJECT](list: collection_children.objects), Bundle: Bundle) -> {
    return StoreBundleItem[BUNDLE](
      bundle: Bundle,
      path: FormatString(format: name_pattern, i: iteration),
      item: object_effector(
        object: GetListItem[OBJECT](list: collection_children.objects, index: iteration)))
  }
  return (Effectors: repeat_output)
}

geometry graph "Custom/World/Object Space"(
    Space: Menu(optional_label: true) = "Custom Space"
) -> (
    "Custom = 0,World = 1, Object = 2": Int,
    "Is Custom Space": Bool(description: "True if this item is chosen by the menu input"),
    "Is World Space": Bool(description: "True if this item is chosen by the menu input"),
    "Is Object Space": Bool(description: "True if this item is chosen by the menu input")
) {
  menu_switch = MenuSwitch(
    menu: Space,
    "Custom Space"(description: "Use a user-defined space."): 0,
    "World Space"(description: "Use world-space coordinates."): 1,
    "Object Space"(description: "Use the coordinates in object space of the provided object."): 2)
  return (
    "Custom = 0,World = 1, Object = 2": menu_switch.output,
    "Is Custom Space": menu_switch.custom_space,
    "Is World Space": menu_switch.world_space,
    "Is Object Space": menu_switch.object_space)
}

geometry graph "Convert Space Transform"(
    "From Space": Menu(optional_label: true) = "World Space",
    "From Object": Object(optional_label: true),
    "To Space": Menu(optional_label: true) = "World Space",
    "To Object": Object(optional_label: true),
    "Custom to World": Matrix
) -> (
    Transform: Matrix,
    Inverted: Matrix(
      description: "The inverted matrix or the identity matrix if the input is not invertible")
) {
  "'From' to world space" {
    index_switch = IndexSwitch(
      custom_world_object_space(space: from_space).custom_0_world_1_object_2,
      custom_to_world,
      _,
      ObjectInfo(object: from_object).transform)
  }
  "World to 'To' space" {
    index_switch_2 = IndexSwitch(
      custom_world_object_space(space: to_space).custom_0_world_1_object_2,
      InvertMatrix(matrix: custom_to_world).matrix,
      _,
      InvertMatrix(matrix: ObjectInfo(object: to_object).transform).matrix)
  }
  multiply_matrices = MultiplyMatrices(Matrix: index_switch_2, Matrix_001: index_switch)
  return (Transform: multiply_matrices, Inverted: InvertMatrix(matrix: multiply_matrices).matrix)
}

geometry graph "Softness to Compliance"(
    Softness: Float(subtype: FACTOR) in 0.0..1.0
) -> (Compliance: Float) {
  return (Compliance: pow(max(Softness, 0.0), 5.0))
}

geometry graph "Cross Edge Length Constraint"(
    Softness: Float(subtype: FACTOR, structure_type: FIELD) in 0.0..1.0,
    "Rest Position": Vector(structure_type: FIELD),
    "Filter"(default_closed: true) {
        Filter: String(force_non_field: true, optional_label: true, structure_type: SINGLE)
    },
    "Debug"(default_closed: true) {
        "Error Threshold": Float(
          subtype: DISTANCE,
          force_non_field: true,
          structure_type: SINGLE) = 0.001 in 1e-05..
    }
) -> (Constraint: Bundle) {
  return (
    Constraint: CombineBundle(
      Type: "Blender.Constraint.CrossEdgeLength",
      filter: Filter,
      rest_position: rest_position,
      compliance: softness_to_compliance(softness: Softness),
      error_threshold: error_threshold))
}

geometry graph Damping(
