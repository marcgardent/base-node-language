    Damping: CombineBundle(
      Type: "Blender.Damping",
      filter: Filter,
      linear_damping: Linear,
      angular_damping: Angular))
}

geometry graph "Edge Length Constraint"(
    Softness: Float(subtype: FACTOR, structure_type: FIELD) in 0.0..1.0,
    "Custom Length"(default_closed: true) {
        "Custom Length": Bool(is_panel_toggle: true, structure_type: FIELD),
