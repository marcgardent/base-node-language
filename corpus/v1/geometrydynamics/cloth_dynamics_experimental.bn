) -> (Constraint: Bundle) {
  return (
    Constraint: CombineBundle(
      Type: "Blender.Constraint.PinPosition",
      filter: Filter,
      selection: Selection,
      position: Position,
      compliance: Compliance,
      error_threshold: error_threshold,
      lambda_attribute: Lambda))
}

geometry graph "Set Friction"(
    Geometry: Geometry(description: "Geometry to store a new attribute with the given name on"),
    Static: Float = 0.5 in 0.0..,
    Dynamic: Float = 0.5 in 0.0..
) -> Geometry {
  return Geometry
    |> StoreNamedAttribute(name: "static_friction", value: Static)
    |> StoreNamedAttribute(name: "dynamic_friction", value: Dynamic)
}

geometry graph "Apply Geo Cache - Deform Only"(
    "New Geometry": Geometry,
    "Cache Geometry": Geometry,
    "Sim Attributes": String(
      description: "List of attribute names (not) to transfer. A wildcard (*) at the end is allowed",
      optional_label: true),
    "Post Sim": Bool
) -> ("Mixed Geometry": Geometry) {
  return (
    "Mixed Geometry": post_sim
      ? TransferAttributes(
        new_geometry,
        source: cache_geometry,
        attribute_names: FieldToList(Value: "*")).target
      : TransferAttributes(
        new_geometry,
        source: cache_geometry,
        attribute_names: sim_attributes).target)
}

geometry graph "String to List"(
    String: String(optional_label: true),
    Separator: String(optional_label: true) = ","
) -> (List: String) {
  return (List: TrimString(string: SplitString(string: String, separator: Separator)))
}

geometry graph "Sim Attributes"(Extra: String) -> ("Sim Attributes": String) {
  string = "position, rotation, velocity, angular_velocity, sim:*"
  return ("Sim Attributes": string_to_list(string: JoinStrings(",", string, Extra)))
}

geometry graph "Set Geo Updater - Deform Only"(
    Geometry: Geometry,
    "Extra Sim Attributes": String(optional_label: true)
) -> Geometry {
  get_geometry_bundle = GetGeometryBundle(Geometry, remove: true)
  closure_output = graph(Geometry: Geometry, Cache: Geometry, "Post Sim": Bool) -> Geometry {
    return apply_geo_cache_deform_only(
      Geometry,
      cache_geometry: Cache,
      sim_attributes: sim_attributes(extra: extra_sim_attributes),
      post_sim: post_sim)
  }
  return SetGeometryBundle(
    get_geometry_bundle.geometry,
    bundle: StoreBundleItem[CLOSURE, SINGLE](
      bundle: get_geometry_bundle.bundle,
      path: "sim_apply_cache",
      item: closure_output))
}

geometry graph "Apply Geo Cache - Topology Changing"(
    "New Geometry": Geometry,
    "Cached Geometry": Geometry,
    "Sim Attributes": String(
      description: "List of attribute names (not) to transfer. A wildcard (*) at the end is allowed",
      optional_label: true),
    "Point ID": Int(hide_value: true) = Index(),
    "Edge ID": Int(hide_value: true) = Index(),
    "Face ID": Int(hide_value: true) = Index(),
    "Corner ID": Int(hide_value: true) = Index(),
    "Curve ID": Int(hide_value: true) = Index(),
    "Instance ID": Int(hide_value: true) = Index()
) -> ("Mixed Geometry": Geometry) {
  get_geometry_bundle = cached_geometry
    |> TransferAttributes(
      target_point_id: point_id,
      target_edge_id: edge_id,
      target_face_id: face_id,
      target_corner_id: corner_id,
      target_curve_id: curve_id,
      target_instance_id: instance_id,
      source: new_geometry,
      source_point_id: point_id,
      source_edge_id: edge_id,
      source_face_id: face_id,
      source_corner_id: corner_id,
      source_curve_id: curve_id,
      source_instance_id: instance_id,
      attribute_names: sim_attributes,
      exclude_names: true).target
    |> GetGeometryBundle(remove: true)
  return (
    "Mixed Geometry": SetGeometryBundle(
      get_geometry_bundle.geometry,
      bundle: JoinBundle(GetGeometryBundle(new_geometry).bundle, get_geometry_bundle.bundle)))
}

geometry graph "Set Geo Updater - Simulated Topology"(
    Geometry: Geometry,
    "Extra Sim Attributes": String(optional_label: true)
) -> Geometry {
  closure_output = graph(Geometry: Geometry, Cache: Geometry, "Post Sim": Bool) -> Geometry {
    return apply_geo_cache_topology_changing(
      Geometry,
      cached_geometry: Cache,
      sim_attributes: sim_attributes(extra: extra_sim_attributes),
      point_id: NamedAttribute[INT](name: "original_point_index").attribute,
      edge_id: NamedAttribute[INT](name: "original_edge_index").attribute,
      face_id: NamedAttribute[INT](name: "original_face_index").attribute,
      corner_id: NamedAttribute[INT](name: "original_corner_index").attribute,
      curve_id: NamedAttribute[INT](name: "original_curve_index").attribute,
      instance_id: NamedAttribute[INT](name: "original_instance_index").attribute)
  }
  "Initialize original id attributes" {
    index = Index()
    store_named_attribute = Geometry
      |> StoreNamedAttribute[INT](name: "original_point_index", value: index)
      |> StoreNamedAttribute[INT, EDGE](name: "original_edge_index", value: index)
      |> StoreNamedAttribute[INT, FACE](name: "original_face_index", value: index)
      |> StoreNamedAttribute[INT, CORNER](name: "original_corner_index", value: index)
      |> StoreNamedAttribute[INT, CURVE](name: "original_curve_index", value: index)
      |> StoreNamedAttribute[INT, INSTANCE](name: "original_instance_index", value: index)
  }
  get_geometry_bundle = GetGeometryBundle(store_named_attribute, remove: true)
  set_geometry_bundle = SetGeometryBundle(
    get_geometry_bundle.geometry,
    bundle: StoreBundleItem[CLOSURE, SINGLE](
      bundle: get_geometry_bundle.bundle,
      path: "sim_apply_cache",
      item: closure_output))
  viewer = Viewer(Geometry(auto_remove: true): set_geometry_bundle)
  return set_geometry_bundle
}

geometry graph "Set Geometry Tags"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Tags: String(optional_label: true)
) -> Geometry {
  get_geometry_bundle = GetGeometryBundle(Geometry, remove: true)
  return SetGeometryBundle(
    get_geometry_bundle.geometry,
    bundle: StoreBundleItem[STRING](
      bundle: get_geometry_bundle.bundle,
      path: "tags",
      item: string_to_list(string: Tags)))
}

geometry graph "Thin Rod Moment of Inertia"(
    Mass: Float(hide_value: true)
) -> ("Moment of Inertia": Vector) {
  position = Position()
  offset_point_in_curve = OffsetPointInCurve(offset: 1)
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: position,
    index: offset_point_in_curve.point_index) @ hide
  vector_math = evaluate_at_index - position @ hide
  vector_math_2 = vector_math ⋅ vector_math @ hide
  evaluate_at_index_2 = EvaluateAtIndex(
    value: Mass,
    index: offset_point_in_curve.point_index) @ hide
  math = Mass + evaluate_at_index_2 @ hide
  math_2 = math * vector_math_2 @ hide
  math_3 = math_2 * 0.083333336 @ "1/12" hide
  return ("Moment of Inertia": CombineXYZ(x: math_3, y: math_3))
}

geometry graph "Set Mass"(
    Geometry: Geometry,
    Mass: Float(subtype: MASS, structure_type: FIELD) = 1.0 in 0.0..,
    "Moment of Inertia"(default_closed: true) {
        "Moment of Inertia": Bool(
          is_panel_toggle: true,
          force_non_field: true,
          structure_type: SINGLE),
        "Moment of Inertia Mode": Menu(optional_label: true) = Custom,
        "Moment of Inertia" as moment_of_inertia_vector: Vector(
          optional_label: true) = (1.0, 1.0, 1.0)
    }
) -> Geometry {
  store_named_attribute = StoreNamedAttribute(Geometry, name: "mass", value: Mass)
  "Simple Rod Model for Moments of Inertia" {
    named_attribute = NamedAttribute(name: "mass")
  }
  return moment_of_inertia
    ? StoreNamedAttribute[FLOAT_VECTOR](
      store_named_attribute,
      name: "moment_of_inertia",
      value: MenuSwitch(
        menu: moment_of_inertia_mode,
        Custom: moment_of_inertia_vector,
        "Thin Rod": thin_rod_moment_of_inertia(
          mass: NamedAttribute(name: "mass").attribute)).output)
    : store_named_attribute
}

geometry graph "Store Bend Rotation"(
    Curves: Geometry,
    "Bend Rotation Name": String(optional_label: true) = "rest_bend_rotation",
    "Rotation Name": String(optional_label: true) = "rest_rotation"
) -> (Curves: Geometry) {
  named_attribute = NamedAttribute[QUATERNION](name: rotation_name)
  return (
    Curves: StoreNamedAttribute[QUATERNION](
      Curves,
      name: bend_rotation_name,
      value: RotateRotation[LOCAL](
        rotation: InvertRotation(rotation: named_attribute.attribute),
        rotate_by: EvaluateAtIndex[QUATERNION](
          value: named_attribute.attribute,
          index: OffsetPointInCurve(offset: 1).point_index))))
}

geometry graph "Edge Length"() -> (Length: Float) {
  edge_vertices = EdgeVertices()
  return (
    Length: EvaluateOnDomain[EDGE](
      value: distance(edge_vertices.position_1, edge_vertices.position_2)))
}

geometry graph "Store Edge Length"(
    Curves: Geometry,
    Name: String(optional_label: true) = "rest_length"
) -> (Curves: Geometry) {
  return (Curves: StoreNamedAttribute[EDGE](Curves, name: Name, value: edge_length()))
}

geometry graph "Curve Segment"() -> (
    "Segment Length": Float(description: "Distance to the previous point on the curve"),
    "Segment Direction": Vector(
      description: "Direction from the previous neighboring point on the segment"),
    "Neighbor Index": Int(description: "Index of the previous neighboring point on the segment")
) {
  boolean = true
  evaluate_on_domain_2 = EvaluateOnDomain[CURVE, BOOLEAN](value: boolean)
  offset_point_in_curve = OffsetPointInCurve(offset: -1)
  switch_4 = offset_point_in_curve.is_valid_offset ? offset_point_in_curve.point_index : Index()
  switch_3 = evaluate_on_domain_2 ? EvaluateOnDomain[INT](value: switch_4) : 0 @ hide
  position = Position()
  evaluate_on_domain = EvaluateOnDomain[FLOAT_VECTOR](
    value: position - EvaluateAtIndex[FLOAT_VECTOR](value: position, index: switch_4))
  switch = evaluate_on_domain_2 ? normalize(evaluate_on_domain) : (0.0, 0.0, 0.0) @ hide
  switch_2 = evaluate_on_domain_2 ? length(evaluate_on_domain) : 0.0 @ hide
  return ("Segment Length": switch_2, "Segment Direction": switch, "Neighbor Index": switch_3)
}

geometry graph "Store Segment Length"(
    Curves: Geometry,
    Name: String(optional_label: true) = "rest_length"
) -> (Curves: Geometry) {
  return (Curves: StoreNamedAttribute(Curves, name: Name, value: curve_segment().segment_length))
}

geometry graph "Store Segment Rotation"(
    Curves: Geometry,
    Name: String(optional_label: true) = "rest_rotation"
) -> (Curves: Geometry) {
  position = Position()
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: position,
    index: OffsetPointInCurve(offset: 1).point_index) @ hide
  vector_math = evaluate_at_index - position @ hide
  return (
    Curves: StoreNamedAttribute[QUATERNION](
      Curves,
      name: Name,
      value: AxesToRotation(primary_axis: vector_math, secondary_axis: Normal().normal)))
}

geometry graph "Setup Structural Rest Data"(Geometry: Geometry) -> Geometry {
  get_geometry_component = GetGeometryComponent(Geometry, type: Curve)
  get_geometry_component_2 = GetGeometryComponent(
    get_geometry_component.geometry,
    type: "Grease Pencil")
  get_geometry_component_3 = GetGeometryComponent(get_geometry_component_2.geometry)
  return get_geometry_component_3.geometry
    + store_edge_length(get_geometry_component_3.component)
    + (get_geometry_component_2.component
      |> store_segment_length()
      |> store_segment_rotation()
      |> store_bend_rotation())
    + (get_geometry_component.component
      |> store_segment_length()
      |> store_segment_rotation()
      |> store_bend_rotation())
}

geometry graph "Custom Effector"(
    Type: Menu(
      description: "The type of effector to create.",
      force_non_field: true,
      optional_label: true,
      structure_type: SINGLE) = Geometry,
    Stage: Menu(
      description: "At which stage the custom effector should be evaluated.",
      force_non_field: true,
      optional_label: true,
      structure_type: SINGLE) = Default,
    Stage as stage_string: String(
      description: "Custom stage name.",
      force_non_field: true,
      optional_label: true,
      structure_type: SINGLE),
    "Geometry Effector": Closure(
      description: "Closure effecting one geometry at a time.",
      force_non_field: true,
      structure_type: SINGLE),
    "World Effector": Closure(
      description: "Closure modifying an entire (simulation) world at once.",
      force_non_field: true,
      structure_type: SINGLE),
    "Filter"(description: "Filter settings.", default_closed: true) {
        Filter: String(
          description: "Comma-separated list of tags this effector should apply to.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE)
    }
) -> (Effector: Bundle(description: "A bundle containing all information about this effector.")) {
  "Create a custom effector that can be injected into e.g. simulations."
  menu_switch = MenuSwitch(
    menu: Stage,
    Default(description: "Evaluate the effector at the default stage."): "DEFAULT",
    "Pre-Simulation"(
      description: "Evaluate the effector on the geometry before it is simulated."): "PRE_SIMULATION",
    "Pre-Solve"(description: "Evaluate the effector before the actual solver runs."): "PRE_SOLVE",
    "Post-Solve"(description: "Evaluate the effector after the solver ran."): "POST_SOLVE",
    Custom(
      description: "Evaluate the effector at a custom stage supported by the solver."): stage_string)
  "Helps with closure type inferencing" {
    evaluate_closure = EvaluateClosure[define_signature: true](
      geometry_effector,
      Geometry(structure_type: SINGLE): Geometry,
      "To World Transform"(
        structure_type: SINGLE): Matrix) -> (Geometry: Geometry(structure_type: SINGLE))
    evaluate_closure_2 = EvaluateClosure[define_signature: true](
      world_effector,
      World(structure_type: SINGLE): Bundle,
      "To World Transform"(
        structure_type: SINGLE): Matrix) -> (World: Bundle(structure_type: SINGLE))
  }
  return (
    Effector: MenuSwitch(
      menu: Type,
      Geometry(
        description: "A geometry effector evaluates a closure on each geometry individually, while taking some filter into account."): CombineBundle(
          Type: "Blender.CustomEffector.Geometry",
          filter: Filter,
          stage: menu_switch.output,
          closure: geometry_effector),
      World(
        description: "A world effector evaluates a closure on world bundle."): CombineBundle(
          Type: "Blender.CustomEffector.World",
          stage: menu_switch.output,
          closure: world_effector)).output)
}

geometry graph "Tearing Effector"(
    Threshold: Float(structure_type: FIELD) = 1.8 in -10000.0..10000.0,
    Mode: Menu(force_non_field: true, optional_label: true, structure_type: SINGLE) = All,
    "Tearing Edges": Bool(hide_value: true, structure_type: FIELD) = true,
    "Voronoi"(default_closed: true) {
        "Voronoi Rest Position": Vector(hide_value: true, structure_type: FIELD) = Position(),
        "Voronoi Scale": Float(structure_type: FIELD) = 5.0 in -1000.0..1000.0
    },
    "Filter"(default_closed: true) {
        Filter: String(force_non_field: true, structure_type: SINGLE)
    }
) -> (Effector: Bundle) {
  math = edge_length() / NamedAttribute(name: "rest_length").attribute
  closure_output = graph(
    Geometry: Geometry(structure_type: SINGLE),
    "To World Transform": Matrix(structure_type: SINGLE)
  ) -> (Geometry: Geometry(structure_type: SINGLE)) {
    "Todo: Figure out a better way to process mesh for tearing" {
      capture_attribute = CaptureAttribute[EDGE](Geometry, Value: math)
      capture_attribute_2 = CaptureAttribute(
        capture_attribute.geometry,
        Value: capture_attribute.value)
      capture_attribute_3 = CaptureAttribute[EDGE](
        capture_attribute_2.geometry,
        Value: capture_attribute_2.value)
    }
    capture_attribute_4 = CaptureAttribute(
      capture_attribute_3.geometry,
      Hash: HashValue[VECTOR](
        value: VoronoiTexture(vector: voronoi_rest_position, scale: voronoi_scale).position))
    return SplitEdges(
      capture_attribute_4.geometry,
      selection: capture_attribute_3.value > Threshold
        and MenuSwitch(
          menu: Mode,
          All(description: "All edges can tear."): true,
          Custom(description: "All edges in a custom edge selection can tear."): tearing_edges,
          Voronoi(
            description: "Tearable edges are computed based on voronoi noise cells."): FaceGroupBoundaries(
              face_group_id: capture_attribute_4.hash)).output)
  }
  return (
    Effector: custom_effector(
      Stage: "Post-Solve",
      geometry_effector: closure_output,
      filter: Filter))
}

geometry graph "For Each Sim Geometry"(World: Bundle, Closure: Closure) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Data Type",
    data_type: Geometry)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration) @ hide
    get_bundle_item = GetBundleItem[GEOMETRY](bundle: World, path: get_list_item, remove: true)
    evaluate_closure = EvaluateClosure[define_signature: true](
      Closure,
      World(structure_type: SINGLE): get_bundle_item.bundle,
      Geometry(structure_type: SINGLE): get_bundle_item.item,
      Path(structure_type: SINGLE): get_list_item) -> (
      World: Bundle(structure_type: SINGLE),
      Geometry: Geometry(structure_type: SINGLE))
    return StoreBundleItem[GEOMETRY](
      bundle: evaluate_closure.world,
      path: get_list_item,
      item: evaluate_closure.geometry)
  }
  return (World: repeat_output)
}

geometry graph "Apply Each Geometry Cache"(
    World: Bundle,
    Cache: Bundle,
    "Post Sim": Bool
) -> (World: Bundle) {
  closure_output = graph(
    World: Bundle(structure_type: SINGLE),
    Geometry: Geometry(structure_type: SINGLE),
    Path: String(structure_type: SINGLE)
  ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
    get_bundle_item = GetBundleItem[GEOMETRY](bundle: Cache, path: Path)
    get_geometry_bundle = GetGeometryBundle(Geometry)
    return (
      World: World,
      Geometry: get_bundle_item.exists
        ? EvaluateClosure(
          GetBundleItem[CLOSURE](bundle: get_geometry_bundle.bundle, path: "sim_apply_cache").item,
          Geometry: get_geometry_bundle.geometry,
          Cache: get_bundle_item.item,
          "Post Sim": post_sim) -> Geometry
        : get_geometry_bundle.geometry)
  }
  return (World: for_each_sim_geometry(world: World, closure: closure_output))
}

geometry graph "Clear Previous World Items"(World: Bundle) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    pattern_mode: Wildcard,
    bundle_type: "*",
    data_type: Bundle)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  string = "previous"
  repeat_output = repeat(list_length, World: World) -> {
    return GetBundleItem[BUNDLE](
      bundle: World,
      path: JoinStrings(
        "/",
        GetListItem[STRING](list: get_nested_bundle_paths, index: iteration),
        string),
      remove: true).bundle
  }
  return (World: repeat_output)
}

geometry graph "Copy Solver Data"(World: Bundle, Cache: Bundle) -> (World: Bundle) {
  "Copy solver output data bundle from simulation cache into a world bundle"
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: Cache,
    mode: "Bundle Type",
    bundle_type: "Blender.XPBDSolverData")
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration) @ hide
    return StoreBundleItem[BUNDLE](
      bundle: World,
      path: get_list_item,
      item: GetBundleItem[BUNDLE](bundle: Cache, path: get_list_item).item)
  }
  return (World: repeat_output)
}

geometry graph "Is Effector for Geometry"(
    Effector: Bundle,
    "Effector Path": String(force_non_field: true, optional_label: true, structure_type: SINGLE),
    Geometry: Geometry,
    "Geometry Path": String(force_non_field: true, optional_label: true, structure_type: SINGLE)
) -> ("Affects Geometry": Bool) {
  return (
    "Affects Geometry": TagFilter(
      tag_filter: SeparateBundle(Effector) -> (filter: String),
      tags: GetBundleItem[STRING](bundle: GetGeometryBundle(Geometry).bundle, path: "tags").item))
}

geometry graph "Evaluate Custom Effectors"(
    World: Bundle(force_non_field: true, structure_type: SINGLE),
    Stage: String(force_non_field: true, optional_label: true, structure_type: SINGLE),
    "To World Transform": Matrix(force_non_field: true, structure_type: SINGLE)
) -> (World: Bundle) {
  "Evaluate Geometry Effectors" {
    get_nested_bundle_paths = GetNestedBundlePaths(
      bundle: World,
      mode: "Bundle Type",
      bundle_type: "Blender.CustomEffector.Geometry")
    list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
    repeat_output_2 = repeat(list_length, World: World) -> {
      get_list_item_2 = GetListItem[STRING, SINGLE](list: get_nested_bundle_paths, index: iteration)
      get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item_2)
      separate_bundle_2 = SeparateBundle(get_bundle_item.item) -> (closure: Closure, stage: String)
      closure_output = graph(
        World: Bundle(structure_type: SINGLE),
        Geometry: Geometry(structure_type: SINGLE),
        Path: String(structure_type: SINGLE)
      ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
        return (
          World: World,
          Geometry: is_effector_for_geometry(
              effector: get_bundle_item.item,
              effector_path: get_list_item_2,
              geometry: Geometry,
              geometry_path: Path)
            ? EvaluateClosure(
              separate_bundle_2.closure,
              Geometry(structure_type: SINGLE): Geometry,
              "To World Transform"(structure_type: SINGLE): to_world_transform) -> (
              Geometry: Geometry(structure_type: SINGLE))
            : Geometry)
      }
      return separate_bundle_2.stage == Stage
        ? for_each_sim_geometry(world: World, closure: closure_output)
        : World
    }
  }
  "Evaluate World Effectors" {
    get_nested_bundle_paths_2 = GetNestedBundlePaths(
      bundle: repeat_output_2,
      mode: "Bundle Type",
      bundle_type: "Blender.CustomEffector.World")
    list_length_2 = ListLength[STRING](list: get_nested_bundle_paths_2) @ hide
    repeat_output = repeat(list_length_2, World: repeat_output_2) -> {
      get_list_item = GetListItem[STRING, SINGLE](
        list: get_nested_bundle_paths_2,
        index: iteration) @ hide
      separate_bundle = SeparateBundle(
        GetBundleItem[BUNDLE](
          bundle: World,
          path: get_list_item).item) -> (stage: String(structure_type: SINGLE), closure: Closure)
      return Stage == separate_bundle.stage
        ? EvaluateClosure(
          separate_bundle.closure,
          World(structure_type: SINGLE): World,
          "To World Transform": to_world_transform) -> (World: Bundle(structure_type: SINGLE))
        : World
    }
  }
  return (World: repeat_output)
}

geometry graph "Evaluate Effector Attributes"(World: Bundle) -> (World: Bundle) {
  "Pin Position Constraint" {
    string = "Blender.Constraint.PinPosition"
    closure_output = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle = SeparateBundle(
        Effector) -> (selection: Bool, position: Vector, compliance: Float)
      capture_attribute = CaptureAttribute(
        Geometry,
        selection: separate_bundle.selection,
        position: separate_bundle.position,
        compliance: separate_bundle.compliance)
      return capture_attribute.geometry
        |> StoreNamedAttribute[BOOLEAN](
          name: FormatString(format: "sim:prop:{}:selection", p: effector_path),
          value: capture_attribute.selection)
        |> StoreNamedAttribute[FLOAT_VECTOR](
          name: FormatString(format: "sim:prop:{}:position", p: effector_path),
          value: capture_attribute.position)
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute.compliance)
    }
    combine_bundle = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string,
      closure: closure_output)
  }
  "Pin Rotation Constraint" {
    string_2 = "Blender.Constraint.PinRotation"
    closure_output_3 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_3 = SeparateBundle(
        Effector) -> (selection: Bool, rotation: Rotation, compliance: Float)
      capture_attribute_2 = CaptureAttribute(
        Geometry,
        selection: separate_bundle_3.selection,
        position: separate_bundle_3.rotation,
        compliance: separate_bundle_3.compliance)
      return capture_attribute_2.geometry
        |> StoreNamedAttribute[BOOLEAN](
          name: FormatString(format: "sim:prop:{}:selection", p: effector_path),
          value: capture_attribute_2.selection)
        |> StoreNamedAttribute[QUATERNION](
          name: FormatString(format: "sim:prop:{}:rotation", p: effector_path),
          value: capture_attribute_2.position)
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute_2.compliance)
    }
    combine_bundle_3 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_2,
      closure: closure_output_3)
  }
  "Damping" {
    string_3 = "Blender.Damping"
    closure_output_4 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_4 = SeparateBundle(
        Effector) -> (linear_damping: Float, angular_damping: Float)
      capture_attribute_3 = CaptureAttribute(
        Geometry,
        linear_damping: separate_bundle_4.linear_damping,
        angular_damping: separate_bundle_4.angular_damping)
      return capture_attribute_3.geometry
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:linear", p: effector_path),
          value: capture_attribute_3.linear_damping)
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:angular", p: effector_path),
          value: capture_attribute_3.angular_damping)
    }
    combine_bundle_4 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_3,
      closure: closure_output_4)
  }
  "Edge Length Constraint" {
    string_4 = "Blender.Constraint.EdgeLength"
    closure_output_5 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_5 = SeparateBundle(Effector) -> (rest_length: Float, compliance: Float)
      capture_attribute_4 = CaptureAttribute[EDGE](
        Geometry,
        rest_length: separate_bundle_5.rest_length,
        compliance: separate_bundle_5.compliance)
      return capture_attribute_4.geometry
        |> StoreNamedAttribute[EDGE](
          name: FormatString(format: "sim:prop:{}:rest_length", p: effector_path),
          value: capture_attribute_4.rest_length)
        |> StoreNamedAttribute[EDGE](
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute_4.compliance)
    }
    combine_bundle_5 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_4,
      closure: closure_output_5)
  }
  "Rod Stretch Shear Constraint" {
    string_5 = "Blender.Constraint.RodStretchShear"
    closure_output_6 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_6 = SeparateBundle(Effector) -> (rest_length: Float, compliance: Float)
      capture_attribute_5 = CaptureAttribute(
        Geometry,
        rest_length: separate_bundle_6.rest_length,
        compliance: separate_bundle_6.compliance)
      return capture_attribute_5.geometry
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:rest_length", p: effector_path),
          value: capture_attribute_5.rest_length)
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute_5.compliance)
    }
    combine_bundle_6 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_5,
      closure: closure_output_6)
  }
  "Rod Bend Twist Constraint" {
    string_6 = "Blender.Constraint.RodBendTwist"
    closure_output_7 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_7 = SeparateBundle(
        Effector) -> (rest_bend_rotation: Rotation, compliance: Float)
      capture_attribute_6 = CaptureAttribute(
        Geometry,
        rest_bend_rotation: separate_bundle_7.rest_bend_rotation,
        compliance: separate_bundle_7.compliance)
      return capture_attribute_6.geometry
        |> StoreNamedAttribute[QUATERNION](
          name: FormatString(format: "sim:prop:{}:rest_bend_rotation", p: effector_path),
          value: capture_attribute_6.rest_bend_rotation)
        |> StoreNamedAttribute(
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute_6.compliance)
    }
    combine_bundle_7 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_6,
      closure: closure_output_7)
  }
  "Cross Edge Length Constraint" {
    string_7 = "Blender.Constraint.CrossEdgeLength"
    closure_output_8 = graph(
      Geometry: Geometry,
      Effector: Bundle,
      "Effector Path": String
    ) -> Geometry {
      separate_bundle_8 = SeparateBundle(Effector) -> (rest_position: Vector, compliance: Float)
      capture_attribute_7 = CaptureAttribute(
        Geometry,
        rest_position: separate_bundle_8.rest_position,
        compliance: separate_bundle_8.compliance)
      return capture_attribute_7.geometry
        |> StoreNamedAttribute[FLOAT_VECTOR](
          name: FormatString(format: "sim:prop:{}:rest_position", p: effector_path),
          value: capture_attribute_7.rest_position)
        |> StoreNamedAttribute[EDGE](
          name: FormatString(format: "sim:prop:{}:compliance", p: effector_path),
          value: capture_attribute_7.compliance)
    }
    combine_bundle_8 = CombineBundle(
      Type: "Blender.FieldPreEvaluation",
      effector_type: string_7,
      closure: closure_output_8)
  }
  combine_bundle_2 = CombineBundle(
    "Pin Position": combine_bundle,
    "Pin Rotation": combine_bundle_3,
    Damping: combine_bundle_4,
    "Edge Length": combine_bundle_5,
    "Rod Stretch Shear": combine_bundle_6,
    "Rod Bend Twist": combine_bundle_7,
    "Cross Edge Length": combine_bundle_8)
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: combine_bundle_2,
    mode: "Bundle Type",
    bundle_type: "Blender.FieldPreEvaluation")
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  "For each geomery > for each effector type > for each effector" {
    closure_output_2 = graph(
      World: Bundle(structure_type: SINGLE),
      Geometry: Geometry(structure_type: SINGLE),
      Path: String(structure_type: SINGLE)
    ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
      repeat_output = repeat(list_length, Geometry: Geometry) -> {
        separate_bundle_2 = SeparateBundle(
          GetBundleItem[BUNDLE](
            bundle: combine_bundle_2,
            path: GetListItem[STRING](
              list: get_nested_bundle_paths,
              index: iteration)).item) -> (effector_type: String, closure: Closure)
        get_nested_bundle_paths_2 = GetNestedBundlePaths(
          bundle: World,
          mode: "Bundle Type",
          bundle_type: separate_bundle_2.effector_type)
        list_length_2 = ListLength[STRING](list: get_nested_bundle_paths_2) @ hide
        repeat_output_2 = repeat(list_length_2, Geometry: Geometry) -> {
          get_list_item = GetListItem[STRING](list: get_nested_bundle_paths_2, index: iteration)
          get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item)
          return is_effector_for_geometry(
              effector: get_bundle_item.item,
              effector_path: get_list_item,
              geometry: Geometry,
              geometry_path: Path)
            ? EvaluateClosure(
              separate_bundle_2.closure,
              Geometry: Geometry,
              Effector: get_bundle_item.item,
              "Effector Path": get_list_item) -> Geometry
            : Geometry
        }
        return repeat_output_2
      }
      return (World: World, Geometry: repeat_output)
    }
  }
  return (World: for_each_sim_geometry(world: World, closure: closure_output_2))
}

geometry graph "Evaluate Forces"(
    World: Bundle,
    "To World Transform": Matrix,
    Name: String(optional_label: true) = "external_force"
) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    bundle_type: "Blender.Force")
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  closure_output = graph(
    World: Bundle(structure_type: SINGLE),
    Geometry: Geometry(structure_type: SINGLE),
    Path: String(structure_type: SINGLE)
  ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
    repeat_output = repeat(list_length, "Total Force": (0.0, 0.0, 0.0)) -> {
      get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration)
      get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item)
      evaluate_closure = EvaluateClosure(
        SeparateBundle(get_bundle_item.item) -> (closure: Closure),
        Geometry: Geometry,
        "To World Transform": to_world_transform) -> (
        Geometry: Geometry,
        Selection: Bool,
        Force: Vector)
      capture_attribute = CaptureAttribute(
        evaluate_closure.geometry,
        selection: evaluate_closure.selection,
        Force: evaluate_closure.force)
      return is_effector_for_geometry(
          effector: get_bundle_item.item,
          effector_path: get_list_item,
          geometry: Geometry,
          geometry_path: Path)
        ? total_force
          + SampleIndex[FLOAT_VECTOR](
            capture_attribute.geometry,
            value: capture_attribute.force,
            index: Index())
        : total_force
    }
    return (
      World: World,
      Geometry: StoreNamedAttribute[FLOAT_VECTOR](Geometry, name: Name, value: repeat_output))
  }
  return (World: for_each_sim_geometry(world: World, closure: closure_output))
}

geometry graph "Remove Sim Attributes"(
    World: Bundle,
    Mode: Menu(optional_label: true) = Exact,
    Name: String(optional_label: true)
) -> (World: Bundle) {
  closure_output = graph(
    World: Bundle(structure_type: SINGLE),
    Geometry: Geometry(structure_type: SINGLE),
    Path: String(structure_type: SINGLE)
  ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
    return (World: World, Geometry: RemoveNamedAttribute(Geometry, pattern_mode: Mode, name: Name))
  }
  return (World: for_each_sim_geometry(world: World, closure: closure_output))
}

geometry graph "Rename Sim Attributes"(
    World: Bundle,
    Mode: Menu(optional_label: true) = Single,
    Old: String(optional_label: true),
    New: String(optional_label: true)
) -> (World: Bundle) {
  closure_output = graph(
    World: Bundle(structure_type: SINGLE),
    Geometry: Geometry(structure_type: SINGLE),
    Path: String(structure_type: SINGLE)
  ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
    return (
      World: World,
      Geometry: RenameAttribute(Geometry, mode: Mode, old: Old, new: New, overwrite: true))
  }
  return (World: for_each_sim_geometry(world: World, closure: closure_output))
}

geometry graph "Set Previous World Items"(World: Bundle, Cache: Bundle) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    pattern_mode: Wildcard,
    bundle_type: "*",
    data_type: Bundle)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration)
    get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item, remove: true)
    get_bundle_item_2 = GetBundleItem[BUNDLE](bundle: Cache, path: get_list_item)
    boolean_math = get_bundle_item.exists and get_bundle_item_2.exists @ hide
    return boolean_math
      ? StoreBundleItem[BUNDLE](
        bundle: World,
        path: get_list_item,
        item: StoreBundleItem[BUNDLE](
          bundle: get_bundle_item.item,
          path: "previous",
          item: get_bundle_item_2.item))
      : World
  }
  return (World: repeat_output)
}

geometry graph "For Each Typed Bundle"(
    World: Bundle,
    Type: String(optional_label: true),
    Closure: Closure
) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    bundle_type: Type)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration) @ hide
    get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item, remove: true)
    evaluate_closure = EvaluateClosure(
      Closure,
      World: get_bundle_item.bundle,
      Item: get_bundle_item.item,
      Path: get_list_item) -> (World: Bundle, Item: Bundle)
    return StoreBundleItem[BUNDLE](
      bundle: evaluate_closure.world,
      path: get_list_item,
      item: evaluate_closure.item)
  }
  return (World: repeat_output)
}

geometry graph "Simplify Cached Collider Info"(World: Bundle) -> (World: Bundle) {
  "Delete points when the collider doens't deform" {
    closure_output = graph(
      World: Bundle,
      Item: Bundle,
      Path: String
    ) -> (World: Bundle, Item: Bundle) {
      separate_bundle = SeparateBundle(Item) -> (deforming: Bool, geometry: Geometry)
      return (
        World: World,
        Item: CombineBundle(
          geometry: RemoveNamedAttribute(
            separate_bundle.deforming
              ? DeleteGeometry[EDGE_FACE](separate_bundle.geometry)
              : DeleteGeometry(separate_bundle.geometry),
            pattern_mode: Wildcard,
            name: "*")))
    }
    group = for_each_typed_bundle(
      world: World,
      type: "Blender.Collider.Mesh",
      closure: closure_output)
  }
  return (World: group)
}

geometry graph "XPBD Solver"(
    World: Bundle(description: "World state that is updated by the solver"),
    "Delta Time": Float(subtype: TIME_ABSOLUTE) = 0.04 in 0.0..,
    Filter: String(
      description: "Filters the geometry sets to process based on their tags",
      optional_label: true),
    "Simulation to World": Matrix,
    "Solver"(default_closed: true) {
        Substeps: Int = 10 in 1..,
        "Constraint Iterations": Int = 1 in 1..,
        "Solver Output Path": String(
          description: "Optional output path in the world bundle for solver data",
          optional_label: true)
    }
) -> (World: Bundle) {
  "Evaluate all substeps at once" {
    xpbdsolver = XPBDSolver(
      world: World,
      delta_time: delta_time,
      filter: Filter,
      simulation_to_world: simulation_to_world,
      substeps: Substeps,
      constraint_iterations: constraint_iterations,
      solver_path: solver_output_path)
  }
  "Evaluate substeps one at a time" {
    math = delta_time / Substeps @ hide
    math_2 = 1.0 / Substeps
    repeat_output = repeat(Substeps, World: World) -> {
      math_3 = iteration * math_2 @ hide
      math_4 = math_3 + math_2 @ hide
      return XPBDSolver(
        world: World,
        delta_time: math,
        filter: Filter,
        simulation_to_world: simulation_to_world,
        substeps: 1,
        constraint_iterations: constraint_iterations,
        solver_path: solver_output_path,
        begin: math_3,
        end: math_4)
    }
  }
  "The result of approaches should be equal" {
    switch = Switch[BUNDLE](false_: xpbdsolver, true_: repeat_output)
  }
  return (World: switch)
}

geometry graph "XPBD Simulation"(
    World: Bundle,
    Substeps: Int = 10 in 1..,
    "Constraint Steps": Int = 1 in 1..,
    "Simulation to World": Matrix,
    "Time Scale": Float = 1.0 in 0.0..10.0,
    "Solver Output Path": String(
      description: "Optional output path in the world bundle for solver data",
      optional_label: true)
) -> (World: Bundle) {
  simulation_output = simulate(Cache: Bundle) -> {
    group = rename_sim_attributes(
      world: Cache,
      mode: Prefix,
      old: "sim:prop:",
      new: "sim:prop_prev:")
    return remove_sim_attributes(
      world: clear_previous_world_items(
        world: simplify_cached_collider_info(
          world: evaluate_custom_effectors(
            world: evaluate_custom_effectors(
              world: xpbd_solver(
                world: evaluate_forces(
                  world: evaluate_effector_attributes(
                    world: evaluate_custom_effectors(
                      world: apply_each_geometry_cache(
                        world: set_previous_world_items(
                          world: evaluate_custom_effectors(
                            world: World,
                            stage: "PRE_SIMULATION",
                            to_world_transform: simulation_to_world),
                          cache: group),
                        cache: group),
                      stage: "PRE_SOLVE",
                      to_world_transform: simulation_to_world)),
                  to_world_transform: simulation_to_world),
                delta_time: delta_time * time_scale,
                simulation_to_world: simulation_to_world,
                substeps: Substeps,
                constraint_iterations: constraint_steps,
                solver_output_path: solver_output_path),
              stage: "POST_SOLVE",
              to_world_transform: simulation_to_world),
            stage: "DEFAULT",
            to_world_transform: simulation_to_world))),
      mode: Wildcard,
      name: "sim:prop_prev:*")
  }
  group_2 = remove_sim_attributes(world: simulation_output, mode: Wildcard, name: "sim:prop:*")
  return (
    World: copy_solver_data(
      world: apply_each_geometry_cache(world: World, cache: group_2, post_sim: true),
      cache: group_2))
}

geometry graph "Cloth Dynamics (Experimental)"(
    Geometry: Geometry(
      description: "The static cloth mesh.",
      force_non_field: true,
      structure_type: SINGLE),
    "Pin Group": Float(
      description: "How strong each vertex is pinned to its input position.",
      hide_value: true,
      default_attribute_name: "Group",
      structure_type: FIELD) in 0.0..1.0,
    "Invert Pin Group": Bool(
      description: "Invert which vertices are pinned and which are not.",
      structure_type: FIELD),
    Stretchiness: Float(
      subtype: FACTOR,
      description: "Higher values make the cloth more elastic.",
      structure_type: FIELD) in 0.0..1.0,
    Bendiness: Float(
      subtype: FACTOR,
      description: "Higher values increase how much the cloth bends.",
      structure_type: FIELD) in 0.0..1.0,
    "Solver"(
      description: "Settings affecting the solver speed and quality.",
      default_closed: true) {
        Substeps: Int(
          description: "Number of simulation steps per frame.",
          force_non_field: true,
          structure_type: SINGLE) = 5 in 1..,
        "Constraint Steps": Int(
          description: "Number of steps done to solve constraints in each substep.",
          force_non_field: true,
          structure_type: SINGLE) = 15 in 1..,
        "Simulation to World": Matrix(
          description: "Custom simulation space (by default, simulation space is world space).",
          force_non_field: true,
          structure_type: SINGLE)
    },
    "Structure"(
      description: "Settings for structural constraints like bendiness and stretchiness.",
      default_closed: true) {
        Mass: Float(
          subtype: MASS,
          description: "Mass assigned to each vertex in the solver.",
          structure_type: FIELD) = 1.0 in 0.0..,
        Friction: Float(
          description: "Friction coefficient for each vertex.",
          structure_type: FIELD) = 0.5 in 0.0..,
        "Collision Radius": Float(
          subtype: DISTANCE,
          description: "Collision radius for each vertex.",
          structure_type: FIELD) = 0.01
    },
    "Damping"(
      description: "Damping settings for increased simulation stability.",
      default_closed: true) {
        "Linear Damping": Float(
          description: "Damping increases the stability of the simulation while also slowing it down.",
          structure_type: FIELD) = 1.0 in 0.0..
    },
    "Gravity"(description: "Optional gravity force.", default_closed: true) {
        Gravity: Bool(
          is_panel_toggle: true,
          description: "Add gravity to the simulation.",
          structure_type: FIELD) = true,
        Gravity as gravity_vector: Vector(
          subtype: ACCELERATION,
          description: "Direction and strength of the gravity.",
          optional_label: true,
          structure_type: FIELD) = (0.0, 0.0, -9.81)
    },
    "Tearing"(description: "Optional tearing.", default_closed: true) {
        Tearing: Bool(
          is_panel_toggle: true,
          description: "Enable dynamic tearing of the mesh.",
          force_non_field: true,
          structure_type: SINGLE),
        "Tearing Mode": Menu(
          description: "How to choose which edges are allowed to tear.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE) = All,
        "Tearing Edge Group": Bool(
          description: "Selection of edges which are allowed to tear.",
          hide_value: true,
          default_attribute_name: "tear",
          structure_type: FIELD) = true,
        "Tearing Threshold": Float(
          description: "The higher the value, the stronger the stress required to tear an edge.",
          structure_type: FIELD) = 1.2 in -10000.0..10000.0,
        "Tearing Voronoi Scale": Float(
          description: "Scale of Voronoi patches whose boundaries can tear.",
          structure_type: FIELD) = 0.5 in -1000.0..1000.0
    },
    "Effectors"(description: "Optional additional simulation effectors.", default_closed: true) {
        "Effectors Collection": Collection(
          description: "A collection containing effectors for the simulation. This includes e.g. forces, colliders and custom effectors.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE),
        "Cloth Tags": String(
          description: "Comma-separated list of tags which can be used to apply only a subset of effectors to this cloth.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE),
        "Extra Sim Attributes": String(
          description: "Comma-separated list of custom attributes which should be persisted between simulation steps.",
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE),
        Effectors: Bundle(
          description: "Additional effectors for the simulation.",
          force_non_field: true,
          structure_type: SINGLE)
    }
) -> (
    Geometry: Geometry(description: "The simulated cloth mesh."),
    "Residual Error": Float(
      description: "Average relative constraint error. 1 is good, higher is worse.")
) {
  "Simulate cloth while taking into account effectors like colliders and forces."
  "Collection Effectors" {
    group_3 = collection_effector(collection: effectors_collection)
  }
  "Damping" {
    Damping = Damping(linear: linear_damping, angular: 1.0)
    combine_bundle_4 = CombineBundle(Damping: Damping)
  }
  "Transform to simulation space" {
    transform_geometry = TransformGeometry(
      Geometry,
      mode: Matrix,
      transform: convert_space_transform(
        from_space: "Object Space",
        from_object: SelfObject(),
        to_space: "Custom Space",
        custom_to_world: simulation_to_world).transform)
  }
  "Setup rest data" {
    group = setup_structural_rest_data(transform_geometry)
  }
  "Gravity" {
    switch = Switch[BUNDLE](
      switch: Gravity,
      true_: CombineBundle(Gravity: Gravity(gravity: gravity_vector)))
  }
  "Edge Length Constraint" {
    combine_bundle_3 = CombineBundle("Edge Length": edge_length_constraint(softness: Stretchiness))
  }
  "Pin Positions" {
    math = 1.0 - pin_group @ hide
    switch_3 = invert_pin_group ? math : pin_group
    math_2 = 1.0 - switch_3 @ hide
  }
  store_named_attribute = StoreNamedAttribute(group, name: "radius", value: collision_radius)
  "Capture original" {
    capture_attribute = CaptureAttribute(store_named_attribute, Position: Position())
  }
  "Pin Positions" .. {
    combine_bundle_2 = CombineBundle(
      "Pin Positions": pin_positions(
        selection: switch_3,
        position: capture_attribute.position,
        compliance: softness_to_compliance(softness: math_2)))
  }
  "Tearing" {
    switch_2 = Switch[BUNDLE](
      switch: Tearing,
      true_: CombineBundle(
        Tearing: tearing_effector(
          threshold: tearing_threshold,
          mode: tearing_mode,
          tearing_edges: tearing_edge_group,
          voronoi_rest_position: capture_attribute.position,
          voronoi_scale: tearing_voronoi_scale)))
  }
  "Setup Sim Geometry" {
    group_4 = capture_attribute.geometry
      |> set_mass(mass: Mass)
      |> set_geometry_tags(tags: cloth_tags)
      |> set_friction(static: Friction, dynamic: Friction)
    combine_bundle = CombineBundle(
      Geometry: Tearing
        ? set_geo_updater_simulated_topology(group_4, extra_sim_attributes: extra_sim_attributes)
        : set_geo_updater_deform_only(group_4, extra_sim_attributes: extra_sim_attributes))
  }
  "Bending Constraint" {
    math_3 = max(Stretchiness, Bendiness) @ hide
    combine_bundle_5 = CombineBundle(
      "Cross Edge Length": cross_edge_length_constraint(
        softness: math_3,
        rest_position: capture_attribute.position))
    string = "The 'Cross Edge Length' constraint implicitly adds distance constraints too. If these are stronger than the normal edge length constraints, there are visual artifacts. So for now do not allow this.  Properly separating stretchiness and bendiness can be done once a better bending constraint has been implemented."
  }
  group_2 = xpbd_simulation(
    world: CombineBundle(
      Cloth: JoinBundle(
        combine_bundle,
        switch,
        combine_bundle_2,
        combine_bundle_3,
        group_3,
        combine_bundle_4,
        switch_2,
        combine_bundle_5),
      Effectors: Effectors),
    substeps: Substeps,
    constraint_steps: constraint_steps,
    simulation_to_world: simulation_to_world,
    solver_output_path: "SolverData")
  get_bundle_item = GetBundleItem[GEOMETRY](bundle: group_2, path: "Cloth/Geometry")
  "Transform back to object space" {
    transform_geometry_2 = TransformGeometry(
      get_bundle_item.item,
      mode: Matrix,
      transform: convert_space_transform(
        from_space: "Custom Space",
        to_space: "Object Space",
        to_object: SelfObject(),
        custom_to_world: simulation_to_world).transform)
  }
  return (
    Geometry: transform_geometry_2,
    "Residual Error": GetBundleItem[SINGLE](
      bundle: group_2,
      path: "SolverData/residual_error").item)
}
