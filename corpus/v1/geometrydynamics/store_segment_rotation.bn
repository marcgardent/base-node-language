geometry(is_modifier: false) graph "Store Segment Rotation"(
    Curves: Geometry,
    Name: String(optional_label: true) = "rest_rotation"
) -> (Curves: Geometry) {
  position = Position()
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: position,
    index: OffsetPointInCurve(offset: 1).point_index) @ hide
  vector_math = evaluate_at_index - position @ hide
  return (
    Curves: StoreNamedAttribute[QUATERNION](
      Curves,
      name: Name,
      value: AxesToRotation(primary_axis: vector_math, secondary_axis: Normal().normal)))
}
