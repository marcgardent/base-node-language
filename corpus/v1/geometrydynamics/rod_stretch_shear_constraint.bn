geometry graph "Rod Stretch/Shear Constraint"(
    Compliance: Float(structure_type: FIELD) = 0.0001 in 0.0..,
    "Custom Length"(default_closed: true) {
        "Custom Length": Bool(is_panel_toggle: true),
        Length: Float(structure_type: FIELD)
    },
    "Filter"(default_closed: true) {
        Filter: String(force_non_field: true, optional_label: true, structure_type: SINGLE)
    },
    "Debug"(default_closed: true) {
        "Error Threshold": Float(
          subtype: DISTANCE,
          force_non_field: true,
          structure_type: SINGLE) = 0.001 in 1e-05..,
        "Position Lambda": String(
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE),
        "Rotation Lambda": String(
          force_non_field: true,
          optional_label: true,
          structure_type: SINGLE)
    }
) -> (Constraint: Bundle) {
  "Rest length" {
    switch = custom_length ? Length : NamedAttribute(name: "rest_length").attribute
  }
  return (
    Constraint: CombineBundle(
      Type: "Blender.Constraint.RodStretchShear",
      filter: Filter,
      rest_length: switch,
      compliance: Compliance,
      error_threshold: error_threshold,
      lambda_position_attribute: position_lambda,
      lambda_rotation_attribute: rotation_lambda))
}
