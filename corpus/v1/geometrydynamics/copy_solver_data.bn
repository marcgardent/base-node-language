geometry graph "Copy Solver Data"(World: Bundle, Cache: Bundle) -> (World: Bundle) {
  "Copy solver output data bundle from simulation cache into a world bundle"
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: Cache,
    mode: "Bundle Type",
    bundle_type: "Blender.XPBDSolverData")
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration) @ hide
    return StoreBundleItem[BUNDLE](
      bundle: World,
      path: get_list_item,
      item: GetBundleItem[BUNDLE](bundle: Cache, path: get_list_item).item)
  }
  return (World: repeat_output)
}
