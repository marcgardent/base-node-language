geometry graph "String to List"(
    String: String(optional_label: true),
    Separator: String(optional_label: true) = ","
) -> (List: String) {
  return (List: TrimString(string: SplitString(string: String, separator: Separator)))
}

geometry graph "Sim Attributes"(Extra: String) -> ("Sim Attributes": String) {
  string = "position, rotation, velocity, angular_velocity, sim:*"
  return ("Sim Attributes": string_to_list(string: JoinStrings(",", string, Extra)))
}
