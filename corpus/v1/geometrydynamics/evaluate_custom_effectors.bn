geometry graph "For Each Sim Geometry"(World: Bundle, Closure: Closure) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Data Type",
    data_type: Geometry)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration) @ hide
    get_bundle_item = GetBundleItem[GEOMETRY](bundle: World, path: get_list_item, remove: true)
    evaluate_closure = EvaluateClosure[define_signature: true](
      Closure,
      World(structure_type: SINGLE): get_bundle_item.bundle,
      Geometry(structure_type: SINGLE): get_bundle_item.item,
      Path(structure_type: SINGLE): get_list_item) -> (
      World: Bundle(structure_type: SINGLE),
      Geometry: Geometry(structure_type: SINGLE))
    return StoreBundleItem[GEOMETRY](
      bundle: evaluate_closure.world,
      path: get_list_item,
      item: evaluate_closure.geometry)
  }
  return (World: repeat_output)
}

geometry graph "Is Effector for Geometry"(
    Effector: Bundle,
    "Effector Path": String(force_non_field: true, optional_label: true, structure_type: SINGLE),
    Geometry: Geometry,
    "Geometry Path": String(force_non_field: true, optional_label: true, structure_type: SINGLE)
) -> ("Affects Geometry": Bool) {
  return (
    "Affects Geometry": TagFilter(
      tag_filter: SeparateBundle(Effector) -> (filter: String),
      tags: GetBundleItem[STRING](bundle: GetGeometryBundle(Geometry).bundle, path: "tags").item))
}

geometry graph "Evaluate Custom Effectors"(
    World: Bundle(force_non_field: true, structure_type: SINGLE),
    Stage: String(force_non_field: true, optional_label: true, structure_type: SINGLE),
    "To World Transform": Matrix(force_non_field: true, structure_type: SINGLE)
) -> (World: Bundle) {
  "Evaluate Geometry Effectors" {
    get_nested_bundle_paths = GetNestedBundlePaths(
      bundle: World,
      mode: "Bundle Type",
      bundle_type: "Blender.CustomEffector.Geometry")
    list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
    repeat_output_2 = repeat(list_length, World: World) -> {
      get_list_item_2 = GetListItem[STRING, SINGLE](list: get_nested_bundle_paths, index: iteration)
      get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item_2)
      separate_bundle_2 = SeparateBundle(get_bundle_item.item) -> (closure: Closure, stage: String)
      closure_output = graph(
        World: Bundle(structure_type: SINGLE),
        Geometry: Geometry(structure_type: SINGLE),
        Path: String(structure_type: SINGLE)
      ) -> (World: Bundle(structure_type: SINGLE), Geometry: Geometry(structure_type: SINGLE)) {
        return (
          World: World,
          Geometry: is_effector_for_geometry(
              effector: get_bundle_item.item,
              effector_path: get_list_item_2,
              geometry: Geometry,
              geometry_path: Path)
            ? EvaluateClosure(
              separate_bundle_2.closure,
              Geometry(structure_type: SINGLE): Geometry,
              "To World Transform"(structure_type: SINGLE): to_world_transform) -> (
              Geometry: Geometry(structure_type: SINGLE))
            : Geometry)
      }
      return separate_bundle_2.stage == Stage
        ? for_each_sim_geometry(world: World, closure: closure_output)
        : World
    }
  }
  "Evaluate World Effectors" {
    get_nested_bundle_paths_2 = GetNestedBundlePaths(
      bundle: repeat_output_2,
      mode: "Bundle Type",
      bundle_type: "Blender.CustomEffector.World")
    list_length_2 = ListLength[STRING](list: get_nested_bundle_paths_2) @ hide
    repeat_output = repeat(list_length_2, World: repeat_output_2) -> {
      get_list_item = GetListItem[STRING, SINGLE](
        list: get_nested_bundle_paths_2,
        index: iteration) @ hide
      separate_bundle = SeparateBundle(
        GetBundleItem[BUNDLE](
          bundle: World,
          path: get_list_item).item) -> (stage: String(structure_type: SINGLE), closure: Closure)
      return Stage == separate_bundle.stage
        ? EvaluateClosure(
          separate_bundle.closure,
          World(structure_type: SINGLE): World,
          "To World Transform": to_world_transform) -> (World: Bundle(structure_type: SINGLE))
        : World
    }
  }
  return (World: repeat_output)
}
