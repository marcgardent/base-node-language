geometry graph "XPBD Solver"(
    World: Bundle(description: "World state that is updated by the solver"),
    "Delta Time": Float(subtype: TIME_ABSOLUTE) = 0.04 in 0.0..,
    Filter: String(
      description: "Filters the geometry sets to process based on their tags",
      optional_label: true),
    "Simulation to World": Matrix,
    "Solver"(default_closed: true) {
        Substeps: Int = 10 in 1..,
        "Constraint Iterations": Int = 1 in 1..,
        "Solver Output Path": String(
          description: "Optional output path in the world bundle for solver data",
          optional_label: true)
    }
) -> (World: Bundle) {
  "Evaluate all substeps at once" {
    xpbdsolver = XPBDSolver(
      world: World,
      delta_time: delta_time,
      filter: Filter,
      simulation_to_world: simulation_to_world,
      substeps: Substeps,
      constraint_iterations: constraint_iterations,
      solver_path: solver_output_path)
  }
  "Evaluate substeps one at a time" {
    math = delta_time / Substeps @ hide
    math_2 = 1.0 / Substeps
    repeat_output = repeat(Substeps, World: World) -> {
      math_3 = iteration * math_2 @ hide
      math_4 = math_3 + math_2 @ hide
      return XPBDSolver(
        world: World,
        delta_time: math,
        filter: Filter,
        simulation_to_world: simulation_to_world,
        substeps: 1,
        constraint_iterations: constraint_iterations,
        solver_path: solver_output_path,
        begin: math_3,
        end: math_4)
    }
  }
  "The result of approaches should be equal" {
    switch = Switch[BUNDLE](false_: xpbdsolver, true_: repeat_output)
  }
  return (World: switch)
}
