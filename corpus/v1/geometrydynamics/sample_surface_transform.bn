geometry graph "Sample Surface Transform"(
    Mesh: Geometry,
    "UV Map": Vector(hide_value: true),
    "Sample UV": Vector = (0.0, 0.0)
) -> (Translation: Vector, Rotation: Rotation, Normal: Vector, Tangent: Vector, Valid: Bool) {
  "Sample Position" {
    sample_uvsurface = SampleUVSurface[FLOAT_VECTOR](
      Mesh,
      value: Position(),
      uv_map: uv_map,
      sample_uv: sample_uv)
  }
  "Sample UV Tangent" {
    sample_uvsurface_2 = SampleUVSurface[FLOAT_VECTOR](
      Mesh,
      value: UVTangent(uv: uv_map),
      uv_map: uv_map,
      sample_uv: sample_uv)
  }
  "Sample Normal" {
    sample_uvsurface_3 = SampleUVSurface[FLOAT_VECTOR](
      Mesh,
      value: Normal().normal,
      uv_map: uv_map,
      sample_uv: sample_uv)
  }
  return (
    Translation: sample_uvsurface.value,
    Rotation: AxesToRotation(
      primary_axis: sample_uvsurface_3.value,
      secondary_axis: sample_uvsurface_2.value),
    Normal: sample_uvsurface_3.value,
    Tangent: sample_uvsurface_2.value,
    Valid: sample_uvsurface.is_valid)
}
