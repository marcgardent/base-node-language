geometry graph "Set Previous World Items"(World: Bundle, Cache: Bundle) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    pattern_mode: Wildcard,
    bundle_type: "*",
    data_type: Bundle)
  list_length = ListLength[STRING](list: get_nested_bundle_paths) @ hide
  repeat_output = repeat(list_length, World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration)
    get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item, remove: true)
    get_bundle_item_2 = GetBundleItem[BUNDLE](bundle: Cache, path: get_list_item)
    boolean_math = get_bundle_item.exists and get_bundle_item_2.exists @ hide
    return boolean_math
      ? StoreBundleItem[BUNDLE](
        bundle: World,
        path: get_list_item,
        item: StoreBundleItem[BUNDLE](
          bundle: get_bundle_item.item,
          path: "previous",
          item: get_bundle_item_2.item))
      : World
  }
  return (World: repeat_output)
}
