geometry graph "Rod Bend/Twist Constraint"(
    Compliance: Float(structure_type: FIELD) = 0.0001 in 0.0..,
    "Custom Bend Rotation"(default_closed: true) {
        "Custom Bend Rotation": Bool(is_panel_toggle: true, structure_type: FIELD),
        "Bend Rotation": Rotation(structure_type: FIELD)
    },
    "Filter"(default_closed: true) {
        Filter: String(force_non_field: true, optional_label: true, structure_type: SINGLE)
    },
    "Debug"(default_closed: true) {
        "Error Threshold": Float(
          subtype: ANGLE,
          force_non_field: true,
          structure_type: SINGLE) = 0.01 in 1e-05..
    }
) -> (Constraint: Bundle) {
  "Rest rotation" {
    switch = custom_bend_rotation
      ? bend_rotation
      : NamedAttribute[QUATERNION](name: "rest_bend_rotation").attribute
  }
  return (
    Constraint: CombineBundle(
      Type: "Blender.Constraint.RodBendTwist",
      filter: Filter,
      rest_bend_rotation: switch,
      compliance: Compliance,
      error_threshold: error_threshold))
}
