        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        boolean,
        false,
        boolean,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        boolean,
        false,
        boolean)).boolean)
}

geometry graph ".MN_pivot_nucleic"() -> (
    "Accumulate Backbone": Bool,
    "Pivot Backbone": Bool,
    "Accumulate Base": Bool,
    "Pivot Base": Bool
) {
  group = atom_name()
  group_2 = atom_name()
  boolean_math = group == 50 or group == 53 or group == 54 or group == 55 or group == 58
  return (
    "Accumulate Backbone": boolean_math,
    "Pivot Backbone": boolean_math or group == 57,
    "Accumulate Base": (select_nucleic_type().is_pyrimidine ? 62 : 63) == group_2,
    "Pivot Base": group_2 == 61)
}

geometry graph "Group Info"(
    "Group ID": Int(hide_value: true)
) -> (Size: Int, "Index in Group": Int, "Index of First": Int, "Index of Last": Int) {
  index = Index()
  integer = 1
  accumulate_field = AccumulateField[INT](value: integer, group_id: group_id)
  return (
    Size: accumulate_field.total,
    "Index in Group": accumulate_field.trailing,
    "Index of First": AccumulateField[INT](
      value: accumulate_field.trailing == 0 ? index : 0,
      group_id: group_id).total,
    "Index of Last": AccumulateField[INT](
      value: accumulate_field.leading == accumulate_field.total ? index : 0,
      group_id: group_id).total)
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Boolean Last"(
    Boolean: Bool(
      description: "Value to test for True when tracking `Index` locations",
      hide_value: true) = true
) -> (
    "Index of Last": Int(
      description: "Accumulating in the point domain, this is the index where the `Boolean` was last `True`. For a point where the `Boolean` is `True`, the index will be of the _previous_ time this was true, but the next point will then reference this point")
) {
  "Index of last time the `Boolean` is true for each `Group ID` (not including the current point). "
  accumulate_field = AccumulateField[INT](value: Boolean)
  group = offset_integer(
    integer: AccumulateField[INT](
      value: AccumulateField[INT](group_id: accumulate_field.leading).trailing == 0 ? Index() : 0,
      group_id: accumulate_field.trailing).total)
  return (
    "Index of Last": accumulate_field.leading > 0
      ? offset_integer(
        integer: group_info(group_id: accumulate_field.leading).index_of_first,
        offset: -1)
      : -1)
}

geometry graph "Domain Switch Matrix"(
    Menu: Menu(optional_label: true) = Point,
    Point: Matrix,
    Edge: Matrix,
    Face: Matrix,
    "Face Corner": Matrix,
    Spline: Matrix,
    Instance: Matrix
) -> (Output: Matrix) {
  return (
    Output: MenuSwitch(
      menu: Menu,
      Point: Point,
      Edge: Edge,
      Face: Face,
      "Face Corner": face_corner,
      Spline: Spline,
      Instance: Instance).output)
}

geometry graph ".Accumulate Domain Transform"(
    Domain: Menu(hide_value: true, optional_label: true) = Point,
    Transform: Matrix(hide_value: true),
    "Group ID": Int(hide_value: true)
) -> (Leading: Matrix, Trailling: Matrix) {
  accumulate_field = AccumulateField[TRANSFORM](value: Transform, group_id: group_id)
  accumulate_field_2 = AccumulateField[TRANSFORM, EDGE](value: Transform, group_id: group_id)
  accumulate_field_3 = AccumulateField[TRANSFORM, FACE](value: Transform, group_id: group_id)
  accumulate_field_4 = AccumulateField[TRANSFORM, CORNER](value: Transform, group_id: group_id)
  accumulate_field_5 = AccumulateField[TRANSFORM, CURVE](value: Transform, group_id: group_id)
  accumulate_field_6 = AccumulateField[TRANSFORM, INSTANCE](value: Transform, group_id: group_id)
  return (
    Leading: domain_switch_matrix(
      menu: Domain,
      point: accumulate_field.leading,
      edge: accumulate_field_2.leading,
      face: accumulate_field_3.leading,
      face_corner: accumulate_field_4.leading,
      spline: accumulate_field_5.leading,
      instance: accumulate_field_6.leading),
    Trailling: domain_switch_matrix(
      menu: Domain,
      point: accumulate_field.trailing,
      edge: accumulate_field_2.trailing,
      face: accumulate_field_3.trailing,
      face_corner: accumulate_field_4.trailing,
      spline: accumulate_field_5.trailing,
      instance: accumulate_field_6.trailing))
}

geometry graph "Transform Accumulate"(
    Domain: Menu(
      description: "Domain on which to accumulate transforms",
      optional_label: true) = Point,
    Accumulate: Bool(
      description: "Selected transforms are included in the accumulation, non-selected transforms become identity matrices",
      hide_value: true) = true,
    Transform: Matrix(description: "Transform field to accumulate", hide_value: true),
    "Group ID": Int(
      description: "Transform field is accumulated individually for each `Group ID`",
      hide_value: true)
) -> (Transform: Matrix(description: "The accumulating Transform field")) {
  return (
    Transform: accumulate_domain_transform(
      domain: Domain,
      transform: Switch[MATRIX](switch: Accumulate, true_: Transform),
      group_id: group_id).leading)
}

geometry graph "Transform Local Axis"(
    Origin: Vector(
      subtype: TRANSLATION,
      description: "The vector defining the local space. Defaults to `Position`",
      hide_value: true) = Position(),
    Axis: Vector(description: "The axis to rotate around") = (0.0, 0.0, 1.0),
    Angle: Float(subtype: ANGLE, description: "Amount to rotate around the axis")
) -> (Transform: Matrix(description: "The Transform around the axis")) {
  "Create a transform around an axis in local space defined by the `Origin` point"
  return (
    Transform: MultiplyMatrices(
      Matrix: CombineTransform(
        translation: Origin,
        rotation: AxisAngleToRotation(axis: Axis, angle: Angle)),
      Matrix_001: CombineTransform(translation: -Origin)))
}

geometry graph "Accumulate Axis Rotation"(
    Position: Vector(description: "Position vector to transform") = Position(),
    Selection: Bool(hide_value: true) = true,
    Pivot: Bool(
      description: "The points at which points where `Accumulate` is true will look to for their axis of transformation.",
      hide_value: true),
    Angle: Float(subtype: ANGLE, description: "Amount to rotate around the axis"),
    "Group ID": Int(
      description: "Transform field is accumulated individually for each `Group ID`",
      hide_value: true),
    "Transform Index": Int(
      description: "Index at which to evaluate the final transform for the positon. For most cases this will be `Index`, but it might be that some points need to use the accumulated transform from another point instead",
      hide_value: true) = Index() in 0..
) -> (
    Position: Vector(subtype: XYZ, description: "Transformed vector"),
    Trasnform: Matrix(
      description: "The accumlated transform, not yet applied to the `Position` vector")
) {
  evaluate_at_index = EvaluateAtIndex[FLOAT4X4](
    value: transform_accumulate(
      accumulate: Selection,
      transform: transform_local_axis(
        origin: Position,
        axis: EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: boolean_last(boolean: Pivot))
          - Position,
        angle: Angle),
      group_id: group_id),
    index: transform_index)
  return (
    Position: TransformPoint(vector: Position, transform: evaluate_at_index),
    Trasnform: evaluate_at_index)
}

geometry graph "Bond Count"(
    Index: Int = Index() in 0..
) -> (
    "Is Bonded": Bool(description: "If the point has an edge / bond to another point"),
    Bonds: Int(description: "The number of bonds or edges that a point has")
) {
  edges_of_vertex = EdgesOfVertex(vertex_index: Index)
  return ("Is Bonded": edges_of_vertex.total > 0, Bonds: edges_of_vertex.total)
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph "Index to Factor"(
    Index: Int(description: "The index starting at 0 within the overall group of size `Size`"),
    Size: Int(description: "The size of the group that will be used to compute the factor.")
) -> (Factor: Float(subtype: FACTOR)) {
  return (
    Factor: MapRange(value: Index, from_max: IntegerMath[SUBTRACT](Value: Size, Value_001: 1)))
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Sub Group Info"(
    "Sub Group ID": Int(hide_value: true),
    "Group ID": Int(hide_value: true)
) -> (
    Size: Int(description: "Size of each comptued `Group ID`"),
    "Group ID": Int(
      description: "A unique `Group ID` that increases whenever `Sub Group ID` or `Group ID` change"),
    "Index of First": Int(
      description: "The absolute `Index` of the _first_ point in each computed `Group ID`"),
    "Index of Last": Int(
      description: "The absolute `Index` of the _last_ point in each computed `Group ID`"),
    "Index in Group ID": Int(description: "Index within each computed `Group ID`, starting at 0"),
    "Sub Group ID": Int,
    "Sub Group Total": Int
) {
  group = integer_run(value: sub_group_id, group_id: group_id)
  group_2 = group_info(group_id: group.group_id)
  accumulate_field = AccumulateField[INT](
    value: group.group_id != offset_integer(integer: group.group_id, offset: 1),
    group_id: group_id)
  return (
    Size: group_2.size,
    "Group ID": group.group_id,
    "Index of First": group_2.index_of_first,
    "Index of Last": group_2.index_of_last,
    "Index in Group ID": group_2.index_in_group,
    "Sub Group ID": accumulate_field.trailing,
    "Sub Group Total": accumulate_field.total)
}

geometry graph "Chain Parameter"() -> (
    Factor: Float(
      subtype: FACTOR,
      description: "A residues relative position along a chain. 0 being the first residue in a chain, 1 being the last"),
    "Residue Count": Int(description: "Number of residues in the chain"),
    "Residue Index": Int(description: "Res ID along the chain if counting from 1"),
    "First res_id": Int(
      description: "The first Res ID in a chain (truncated chains start above 1)"),
    "Last res_id": Int(
      description: "The Res ID of the last residue in chain (not equal to Length if chain is truncated)"),
    "Index of First": Int(description: "Index in whole structure of the first atom in the chain"),
    "Index of Last": Int(description: "Index in the whole structure the last atom in the chain")
) {
  "Information for each residue within the context of the chain"
  group = chain_id()
  group_2 = group_info(group_id: group)
  group_3 = sub_group_info(sub_group_id: residue_id(), group_id: group)
  return (
    Factor: index_to_factor(index: group_3.sub_group_id, size: group_3.sub_group_total),
    "Residue Count": group_3.sub_group_total,
    "Residue Index": group_3.sub_group_id,
    "First res_id": residue_id(index: group_3.index_of_first),
    "Last res_id": residue_id(index: group_3.index_of_last),
    "Index of First": group_2.index_of_first,
    "Index of Last": group_2.index_of_last)
}

geometry graph ".MN_constants_atom_name_nucleic"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Side Chain Joint Carbon": Int
) {
  integer = 61
  integer_2 = 77
  integer_3 = 50
  integer_4 = 61
  integer_5 = 54
  return (
    "Backbone Lower": integer_3,
    "Backbone Upper": integer_4,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Side Chain Joint Carbon": integer_5)
}

geometry graph ".MN_select_nucleic"() -> (
    "Is Backbone": Bool(
      description: "True for atoms that are part of the sugar-phosphate backbone for the nucleotides"),
    "Is Side Chain": Bool(
      description: "True for atoms that are part of the bases for nucleotides."),
    "Is Nucleic": Bool(description: "True if the atoms are part of a nucleic acid")
) {
  group = mn_constants_atom_name_nucleic()
  named_attribute = NamedAttribute[INT](name: "atom_name")
  return (
    "Is Backbone": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.backbone_upper,
    "Is Side Chain": named_attribute.attribute >= group.side_chain_lower
      and named_attribute.attribute <= group.side_chain_upper,
    "Is Nucleic": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.side_chain_upper)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Nucleic"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_nucleic", fallback: mn_select_nucleic().is_nucleic))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Override Index"(
    Selection: Bool(hide_value: true) = true,
    Index: Int(hide_value: true) = Index(),
    Override: Int
) -> (Output: Int) {
  return (Output: Selection ? Override : Index)
}

geometry graph "Group Pick"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true)
) -> (
    "Is Valid": Bool(
      description: "Valid for the point only if there is 1 single `True` for the `Pick` field in the point's group in the `Group ID`"),
    Index: Int(description: "Index of picked item. Returns -1 if not a valid pick")
) {
  "Get the item of the `True` in each `Group ID`, but only if there is a single `True` in each group"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total == 1
  return (
    "Is Valid": compare,
    Index: compare ? AccumulateField[INT](value: Pick ? Index() : 0, group_id: group_id).total : -1)
}

geometry graph "Group Pick Vector"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true),
    Position: Vector(
      description: "Vector field to pick vlaue for, defaults to `Position`",
      hide_value: true) = Position()
) -> (
    "Is Valid": Bool(description: "Whether the pick for the point's `Group ID` is valid"),
    Index: Int(description: "Picked Index for the Group, -1 if not valid"),
    Vector: Vector(description: "Picked vector for the group, `(0, 0, 0)` if not valid")
) {
  group = group_pick(pick: Pick, group_id: group_id)
  return (
    "Is Valid": group.is_valid,
    Index: group.index,
    Vector: group.is_valid
      ? EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: group.index)
      : (0.0, 0.0, 0.0))
}

geometry graph "URes ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    ures_id: Int,
    Size: Int(description: "The total of all of the values in the corresponding group")
) {
  group = attribute_at_index(index: Index, name: "ures_id")
  return (ures_id: group, Size: AccumulateField[INT](group_id: group).total)
}

geometry graph "Residue Mask"(
    atom_name: Int(description: "Atom to pick from the group") = 1 in 2..
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(pick: atom_name() == atom_name, group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph "Nucleic Dihedral"(
    Position: Vector(hide_value: true) = Position(),
    Selection: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Alpha: Float(subtype: ANGLE),
    Beta: Float(subtype: ANGLE),
    Gamma: Float(subtype: ANGLE),
    Epsilon: Float(subtype: ANGLE),
    Zeta: Float(subtype: ANGLE, description: "Amount to rotate around the axis")
) -> (Position: Vector(subtype: XYZ, description: "Transformed vector")) {
  group = atom_name()
  group_2 = is_nucleic(and_: Selection)
  return (
    Position: group_2.selection
      ? accumulate_axis_rotation(
        position: Position,
        selection: group_2.selection,
        pivot: mn_pivot_nucleic().pivot_backbone,
        angle: bond_count().bonds > 1
          ? IndexSwitch(
            IntegerMath[SUBTRACT](Value: group, Value_001: 50),
            Zeta,
            0.0,
            0.0,
            Alpha,
            chain_parameter().residue_index ? Beta : 0.0,
            Gamma,
            0.0,
            0.0,
            Epsilon,
            0.0,
            0.0)
          : 0.0,
        group_id: chain_id(),
        transform_index: override_index(
          selection: group > 58 and group <= 115 or group == 56,
          override: residue_mask(atom_name: 55).index)).position
      : Position)
}
