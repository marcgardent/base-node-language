geometry(is_modifier: false) graph "Lag Geometry"(
    Input: Geometry,
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Count: Int(description: "Number of frames to lag.") = 5,
    "Realize All": Bool(
      description: "Realize all levels of nested instances for a top-level instances. Overrides the value of the Depth input") = true
) -> (Geometry: Geometry, "Lag Index": Int, Index: Int) {
  index = Index()
  simulation_output = simulate(Geometry: Geometry) -> {
    return SeparateGeometry[INSTANCE](
      GeometryToInstance(SeparateGeometry(Input, selection: Selection).selection) + Geometry,
      selection: Index() < Count).selection
  }
  capture_attribute = CaptureAttribute(simulation_output, Index: index)
  capture_attribute_2 = CaptureAttribute[INSTANCE](capture_attribute.geometry, Index: index)
  return (
    Geometry: RealizeInstances(capture_attribute_2.geometry, realize_all: realize_all),
    "Lag Index": capture_attribute_2.index,
    Index: capture_attribute.index)
}
