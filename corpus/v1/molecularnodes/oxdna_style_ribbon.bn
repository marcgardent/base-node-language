      (0.8, 0.8, 0.8, 1.0),
      (0.8, 0.8, 0.8, 1.0),
      rA,
      rC,
      rG,
      rU)
    : Color()
}

geometry graph "Contains Geometry"(
    Geometry: Geometry
) -> (
    "Not Empty": Bool(description: "True when the input contains some geometry"),
    Empty: Bool(description: "True when the input contains no geometry")
) {
  boolean_math = DomainSize(Geometry).point_count == 0
    and DomainSize[POINTCLOUD](Geometry) == 0
    and DomainSize[CURVE](Geometry).point_count == 0
    and DomainSize[INSTANCES](Geometry) == 0
    and DomainSize[GREASEPENCIL](Geometry) == 0
  return ("Not Empty": not boolean_math, Empty: boolean_math)
}

geometry graph "Fallback Geometry"(Geometry: Geometry, Fallback: Geometry) -> Geometry {
  return contains_geometry(Geometry).not_empty ? Geometry : Fallback
}

geometry graph "Integer Distance"(
    A: Int,
    B: Int,
    Distance: Int = 2
) -> (Cutoff: Bool, Distance: Int) {
  integer_math = IntegerMath[ABSOLUTE](value: IntegerMath[SUBTRACT](Value: A, Value_001: B))
  return (Cutoff: integer_math >= Distance, Distance: integer_math)
}

geometry graph "Set Color"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Color: Color(
      description: "Color to apply to the selected atoms") = (0.161517, 0.623961, 0.195602)
) -> (Atoms: Geometry(description: "Atomic geometry with an updated `Color` attribute")) {
  return (
    Atoms: StoreNamedAttribute[FLOAT_COLOR](
      Atoms,
      selection: Selection,
      name: "Color",
      value: Color))
}

geometry graph "Set Instancer"(
    Geometry: Geometry(description: "Atomic geometry that contains vertices and edges"),
    is_instanced: Bool = true
) -> Geometry {
  return StoreNamedAttribute[BOOLEAN](Geometry, name: "is_instanced", value: is_instanced)
}

geometry(is_modifier: true) graph "Smooth by Angle"(
    Mesh: Geometry,
    Angle: Float(
      subtype: ANGLE,
      description: "Maximum face angle for smooth edges") = 0.5235988 in 0.0..3.1415927,
    "Ignore Sharpness": Bool(force_non_field: true, structure_type: SINGLE)
) -> (Mesh: Geometry) {
  "Set the sharpness of mesh edges based on the angle between the neighboring faces"
  return (
    Mesh: Mesh
      |> SetShadeSmooth[EDGE](
        selection: IsEdgeSmooth() or ignore_sharpness,
        shade_smooth: EdgeAngle().unsigned_angle <= Angle and (IsFaceSmooth() or ignore_sharpness))
      |> SetShadeSmooth())
}

geometry graph "oxDNA Vectors"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    base_vector: Vector,
    base_normal: Vector,
    "Backbone Offset": Vector,
    "Base Offset": Vector,
    Rotation: Rotation
) {
  group = angstrom_to_world(angstrom: 3.4)
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_vector").attribute,
    index: Index)
  evaluate_at_index_2 = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_normal").attribute,
    index: Index)
  return (
    base_vector: evaluate_at_index,
    base_normal: evaluate_at_index_2,
    "Backbone Offset": evaluate_at_index * -group
      + (evaluate_at_index × evaluate_at_index_2) * group,
    "Base Offset": evaluate_at_index * group,
    Rotation: AxesToRotation(primary_axis: evaluate_at_index, secondary_axis: evaluate_at_index_2))
}

geometry(is_modifier: false) graph "oxDNA Style Ribbon"(
    Atoms: Geometry,
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Quality: Int = 2 in 1..,
    "Backbone" {
        "Backbone Shape": Menu(menu_expanded: true, optional_label: true) = Arrows,
        "Backbone Radius": Float = 0.8 in 0.0..,
        "Ball Radius": Float = 2.0 in 0.0..,
        "Arrow Taper": Float(subtype: FACTOR) = 0.3 in 0.0..1.0
    },
    "Bases" {
        "Base Shape": Menu(menu_expanded: true, optional_label: true) = Sphere,
        "Base Geometry": Geometry,
        "Base Scale": Vector(subtype: XYZ) = (0.1, 0.3, 0.2) in 0.0..,
        "Stem Scale": Vector = (0.7, 0.7, 0.7)
    },
    "Colors" {
        "Base Colors": Menu(menu_expanded: true, optional_label: true) = Uniform,
        Bases: Color = (0.0, 1.0, 1.0),
        A: Color = (0.033104, 0.03310406, 1.0),
        C: Color = (0.033104, 1.0, 0.033104),
        G: Color = (1.0, 1.0, 0.033104),
        "T / U": Color = (1.0, 0.033104, 0.033104),
        "Strand Color": Menu(menu_expanded: true, optional_label: true) = Color,
        Strands: Color(
          description: "Becomes the output value if it is chosen by the menu input") = (0.8, 0.8, 0.8),
        "Strand 1": Color = (1.0, 0.0, 0.0),
        "Strand 2": Color = (0.0, 0.0, 1.0),
        "Strand 3": Color = (0.0, 1.0, 0.0),
        "Strand 4": Color = (1.0, 1.0, 0.0)
    },
    "Material" {
        "Shade Smooth": Bool = true,
        Material: Material(description: "Material to apply to the resulting geometry")
    }
) -> Geometry {
  separate_geometry = SeparateGeometry(Atoms, selection: Selection)
  "Color strands if Auto-color is False" {
    integer_math = IntegerMath[MODULO](Value: chain_id(), Value_001: 4)
    group = set_color(
      separate_geometry.selection,
      selection: integer_math,
      color: MenuSwitch(
        menu: strand_color,
        Uniform(description: "Single uniform color"): Strands,
        Strand(
          description: "Set custom colors for the bases"): IndexSwitch(
            integer_math,
            strand_1,
            strand_2,
            strand_3,
            strand_4),
        Color(description: "Use the existing `Color` attribute"): Color()).output)
  }
  group_2 = oxdna_vectors()
  capture_attribute = CaptureAttribute(group, Rotation: group_2.rotation)
  "Colored bases" {
    instance_on_points = capture_attribute.geometry
      |> set_instancer()
      |> set_color(
        color: MenuSwitch(
          menu: base_colors,
          Uniform: Bases,
          Base: color_res_name(a: A, c: C, g: G, t: t_u, ra: A, rc: C, rg: G, ru: t_u),
          Color: Color()).output)
      |> SetPosition(offset: group_2.base_offset)
      |> InstanceOnPoints(
        instance: fallback_geometry(base_geometry, fallback: IcoSphere(subdivisions: Quality).mesh),
        rotation: capture_attribute.rotation,
        scale: base_scale)
  }
  group_3 = oxdna_vectors()
  {
    set_position = SetPosition(capture_attribute.geometry, offset: group_3.backbone_offset)
    "Backbone Stick" {
      group_4 = angstrom_to_world(angstrom: backbone_radius)
      "Each segment is it's own mesh, flipping the circular endpoints" {
        edge_vertices = EdgeVertices()
        capture_attribute_2 = CaptureAttribute[EDGE](
          set_position,
          selection: integer_distance(
            a: edge_vertices.vertex_index_1,
            b: edge_vertices.vertex_index_2).cutoff)
        reverse_curve = capture_attribute_2.geometry
          |> SplitEdges()
          |> MeshToCurve()
          |> ReverseCurve(selection: capture_attribute_2.selection)
      }
      curve_circle = CurveCircle(
        resolution: IntegerMath[MULTIPLY](Value: Quality, Value_001: 4),
        radius: ball_radius)
      curve_to_mesh = set_position
        |> MeshToCurve()
        |> SetCurveNormal(mode: Free, normal: group_3.base_normal)
        |> SetSplineType[BEZIER]()
        |> SetSplineResolution(resolution: IntegerMath[MULTIPLY](Value: Quality, Value_001: 2))
        |> SetHandleType()
        |> CurveToMesh(profile_curve: curve_circle, scale: group_4)
      curve_to_mesh_2 = CurveToMesh(
        reverse_curve,
        profile_curve: curve_circle,
        scale: EndpointSelection(start_size: 0) ? group_4 * arrow_taper : group_4)
    }
    "Backbone ball" {
      instance_on_points_2 = set_position
        |> set_instancer()
        |> InstanceOnPoints(
          instance: IcoSphere(
            radius: angstrom_to_world(angstrom: ball_radius),
            subdivisions: Quality).mesh)
    }
  }
  "Base stem" {
    instance_on_points_3 = set_position
      |> set_instancer()
      |> InstanceOnPoints(
        instance: Cylinder(
            vertices: IntegerMath[MULTIPLY](Value: Quality, Value_001: 5),
            side_segments: Quality,
            radius: angstrom_to_world(angstrom: 1.0),
            depth: 1.0).mesh
          |> TransformGeometry(translation: (0.0, 0.0, 0.5)),
        rotation: RotateRotation[LOCAL](
          rotation: capture_attribute.rotation,
          rotate_by: (0.34906584, 0.0, 0.0)),
        scale: stem_scale)
  }
  return MenuSwitch(
        menu: backbone_shape,
        Arrows: instance_on_points_2 + curve_to_mesh_2,
        Curve: curve_to_mesh).output
      + MenuSwitch(
        menu: base_shape,
        Sphere: instance_on_points + instance_on_points_3,
        Cylinder: instance_on_points_3,
        None: _).output
    |> SetShadeSmooth(shade_smooth: shade_smooth)
    |> smooth_by_angle(angle: 1.0471976)
    |> SetMaterial(material: Material)
}
