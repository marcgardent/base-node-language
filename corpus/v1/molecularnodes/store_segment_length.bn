geometry graph "Curve Segment"() -> (
    "Segment Length": Float(description: "Distance to previous point on curve"),
    "Segment Direction": Vector(
      description: "Direction from previous neighboring point on segment"),
    "Neighbor Index": Int(description: "Index of previous neighboring point on segment")
) {
  boolean = true
  evaluate_on_domain = EvaluateOnDomain[CURVE, BOOLEAN](value: boolean)
  offset_point_in_curve = OffsetPointInCurve(offset: -1)
  position = Position()
  switch = offset_point_in_curve.is_valid_offset ? offset_point_in_curve.point_index : Index()
  evaluate_on_domain_2 = EvaluateOnDomain[FLOAT_VECTOR](
    value: position - EvaluateAtIndex[FLOAT_VECTOR](value: position, index: switch))
  return (
    "Segment Length": evaluate_on_domain ? length(evaluate_on_domain_2) : 0.0,
    "Segment Direction": evaluate_on_domain ? normalize(evaluate_on_domain_2) : (0.0, 0.0, 0.0),
    "Neighbor Index": evaluate_on_domain ? EvaluateOnDomain[INT](value: switch) : 0)
}

geometry(is_modifier: false) graph "Store Segment Length"(
    Curves: Geometry,
    Name: String(optional_label: true) = "rest_length"
) -> (Curves: Geometry) {
  return (Curves: StoreNamedAttribute(Curves, name: Name, value: curve_segment().segment_length))
}
