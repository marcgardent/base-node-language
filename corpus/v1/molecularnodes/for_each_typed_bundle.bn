geometry graph "For Each Typed Bundle"(
    World: Bundle,
    Type: String(optional_label: true),
    Closure: Closure
) -> (World: Bundle) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: World,
    mode: "Bundle Type",
    bundle_type: Type)
  repeat_output = repeat(ListLength[STRING](list: get_nested_bundle_paths), World: World) -> {
    get_list_item = GetListItem[STRING](list: get_nested_bundle_paths, index: iteration)
    get_bundle_item = GetBundleItem[BUNDLE](bundle: World, path: get_list_item, remove: true)
    evaluate_closure = EvaluateClosure(
      Closure,
      World: get_bundle_item.bundle,
      Item: get_bundle_item.item,
      Path: get_list_item) -> (World: Bundle, Item: Bundle)
    return StoreBundleItem[BUNDLE](
      bundle: evaluate_closure.world,
      path: get_list_item,
      item: evaluate_closure.item)
  }
  return (World: repeat_output)
}
