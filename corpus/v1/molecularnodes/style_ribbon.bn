geometry graph "Menu Residue Mask"(
    "Atom Name": Menu(optional_label: true) = N
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(
    pick: menu_atom_name(atom_name: atom_name).selection,
    group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph ".MN_topo_assign_backbone"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (Atoms: Geometry, "CA Atoms": Geometry, "Sample Index": Int) {
  "Compute only on backbone atoms, but capture their idx first" {
    group = is_alpha_carbon()
    capture_attribute = CaptureAttribute(
      Atoms,
      Selection as selection_2: group.selection,
      Index: AccumulateField[INT](value: group.selection).trailing)
    separate_geometry = SeparateGeometry(
      capture_attribute.geometry,
      selection: is_backbone().selection)
  }
  string = "backbone"
  repeat_output = repeat(4, Geometry: separate_geometry.selection) -> {
    group_2 = menu_residue_mask(atom_name: IndexSwitch[MENU](iteration, N, CA, C, O))
    return StoreNamedAttribute[FLOAT_VECTOR](
      Geometry,
      selection: group_2.is_valid,
      name: JoinStrings("_", string, IndexSwitch(iteration, "N", "CA", "C", "O")),
      value: group_2.position)
  }
  return (
    Atoms: repeat_output,
    "CA Atoms": repeat_output
      |> SeparateGeometry(selection: capture_attribute.selection_2).selection
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "backbone_NH", value: backbone_nh()),
    "Sample Index": SampleIndex[INT](
      capture_attribute.geometry,
      value: capture_attribute.index,
      index: Index()))
}

geometry graph "Atom ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_id: Int(
      description: "The `atom_id` attribute, read from geometry. Corresponds to the order of the atoms when they were read from the file")
) {
  return (atom_id: attribute_at_index(index: Index, name: "atom_id"))
}

geometry graph "Unique Chain ID"(
    Cutoff: Float(
      subtype: DISTANCE,
      description: "Threshold distance over which the next points are considered to be part of a new chain") = 4.5 in 0.0..10000.0
) -> ("Group ID": Int(description: "Calculated `Group ID` attribute")) {
  "Compute a unique Group ID based on the `chain_id` attribute, but also incrememnting if subsequent points are over a cutoff distance from each other"
  position = Position()
  return (
    "Group ID": IntegerMath[ADD](
      Value: integer_run(value: chain_id()).group_id,
      Value_001: AccumulateField[INT](
        value: distance(offset_vector(vector: position, offset: -1), position)
          > angstrom_to_world(angstrom: Cutoff)).leading))
}

geometry graph "Atoms to Curves"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Points to maintain and use for splines, non-selected points are removed",
      hide_value: true) = true,
    "Sort Points": Bool(
      description: "Sort points first by atom_id and chain_id before splitting to curves"),
    Cutoff: Float(subtype: DISTANCE) = 6.0 in -10000.0..10000.0
) -> (Curves: Geometry) {
  group = chain_id()
  separate_components = SeparateComponents(Atoms)
  mesh_to_points = MeshToPoints(
    CurveToMesh(separate_components.curve) + separate_components.mesh,
    selection: Selection)
  return (
    Curves: PointsToCurves(
      sort_points
        ? mesh_to_points
          |> SortElements(sort_weight: group)
          |> SortElements(group_id: group, sort_weight: atom_id())
        : mesh_to_points,
      curve_group_id: unique_chain_id(cutoff: Cutoff)))
}

geometry graph "Backbone O"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (O: Vector) {
  return (O: backbone_position(method: Method, menu: backbone_O))
}

geometry graph "Backbone Positions"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (
    O: Vector(description: "The position of the backbone _O_ atom for the residue"),
    C: Vector(description: "The position of the backbone _C_ atom for the residue"),
    CA: Vector(description: "The position of the backbone _CA_ atom for the residue"),
    N: Vector(description: "The position of the backbone _N_ atom for the residue"),
    NH: Vector
) {
  menu_switch = MenuSwitch(menu: Method, Read: 0, Compute: 1)
  return (
    O: backbone_o(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    C: backbone_c(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    CA: backbone_ca(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    N: backbone_n(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    NH: backbone_nh(menu: IndexSwitch[MENU](menu_switch.output, Read, Compute)))
}

geometry graph "Backbone Vectors"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (
    Normal: Vector(
      description: "The vector used for the `Normal` of a curve when reading positions from a peptide backbone"),
    Tangent: Vector(
      description: "The vector used as the `Tangent` for a curve when reading values from a peptide backbone"),
    Bitangent: Vector(description: "Cross product of the Normal and Tangent")
) {
  "The `Vectors` that are useful for a curve when reading from a peptide backbone"
  group = backbone_positions(method: Method)
  vector_math = normalize(group.c - group.n)
  vector_math_2 = normalize(Mix[VECTOR](factor: 0.45, a: group.c, b: group.n) - group.ca)
  return (
    Normal: vector_math_2,
    Tangent: vector_math,
    Bitangent: normalize(vector_math × vector_math_2))
}

geometry graph "Atoms to CA Curves"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    "BS Smoothing": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Threshold: Float(
      description: "Distance (Angstroms) over which subsequent CA points are treated as a new chain") = 4.5 in 0.0..10000.0
) -> (Curves: Geometry) {
  "Turn backbone points to curves" {
    group = Atoms
      |> mn_topo_assign_backbone().atoms
      |> atoms_to_curves(selection: is_alpha_carbon(and_: Selection).selection, cutoff: Threshold)
  }
  position = Position()
  return (
    Curves: group
      |> StoreNamedAttribute[INT](name: "tmp_idx", value: Index())
      |> mn_init_tmp_attributes()
      |> SetCurveNormal(mode: Free, normal: backbone_vectors(method: Read).normal)
      |> mn_bs_smooth(factor: bs_smoothing, iterations: 1)
      |> SeparateGeometry[CURVE](selection: SplineLength().point_count > 1).selection
      |> SetSplineCyclic(
        cyclic: distance(
            EvaluateAtIndex[FLOAT_VECTOR](value: position, index: PointsOfCurve().point_index),
            EvaluateAtIndex[FLOAT_VECTOR](
              value: position,
              index: PointsOfCurve(sort_index: -1).point_index))
          < angstrom_to_world(angstrom: 4.0)))
}

geometry graph ".MN_utils_style_ribbon_peptide"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Quality: Int = 3 in 0..6,
    "BS Smoothing": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Radius: Float = 1.6 in 0.0..,
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    "UV Map": Bool,
    "U Component": Menu(optional_label: true) = Factor,
    Threshold: Float = 4.5 in 0.0..10000.0
) -> (Geometry: Geometry, Curve: Geometry) {
  group = atoms_to_ca_curves(
    Atoms,
    selection: Selection,
    bs_smoothing: bs_smoothing,
    threshold: Threshold)
  set_curve_radius = group
    |> SetCurveNormal()
    |> SetCurveRadius(radius: Radius)
  fillet_curve = FilletCurve(
    set_curve_radius,
    radius: MapRange(
      value: _2_index_angle(index_a: offset_index(offset: -1), index_c: offset_index(offset: 1)),
      from_min: 1.6899998,
      from_max: 2.861593,
      to_max: 0.25)) @ mute
  integer = 2
  integer_2 = 3
  return (
    Geometry: fillet_curve
      |> SetSplineType[BEZIER]()
      |> SetHandleType()
      |> curve_custom_profile(
        subdivisions: IntegerMath[MULTIPLY](Value: Quality, Value_001: integer),
        profile_type: "Default Profile",
        uv_map: uv_map,
        u_component: u_component,
        profile_rotation: curve_rotation(),
        profile_resolution: IntegerMath[MULTIPLY](Value: Quality, Value_001: integer_2),
        profile_rotation_float: 0.0)
      |> cleanup(color_source: group, material: Material, shade_smooth: shade_smooth),
    Curve: set_curve_radius)
}

geometry graph "Check Geometry"(
    Geometry: Geometry,
    Message: String(
      optional_label: true) = "Input contains no geometry, check your node connections."
) -> Geometry {
  warning = Warning(show: contains_geometry(Geometry).empty, message: Message)
  return Geometry
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph ".MN_ensure_ures_id"(Input: Geometry) -> (Output: Geometry) {
  "If the `ures_id` attribute doesn't exist, create it"
  "Check if `ures_id` exists" {
    get_attribute_names = GetAttributeNames(
      Input,
      filter_data_type: true,
      data_type: Integer,
      filter_domain: true)
    list_length = ListLength[STRING](
      list: FilterList[STRING](
        list: get_attribute_names,
        selection: get_attribute_names == "ures_id").selection)
  }
  return (Output: list_length ? Input : set_ures_id(Input))
}

geometry graph "Get Geometry Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> (Geometry: Geometry, Bundle: Bundle, Atoms: Geometry) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  string = "MN/Atoms"
  get_bundle_item = GetBundleItem[GEOMETRY](
    bundle: get_geometry_bundle.bundle,
    path: string,
    remove: true)
  return (
    Geometry: Switch[GEOMETRY](switch: get_bundle_item.exists, true_: get_geometry_bundle.geometry),
    Bundle: get_bundle_item.bundle,
    Atoms: get_bundle_item.exists ? get_bundle_item.item : get_geometry_bundle.geometry)
}

geometry graph "Evaluate on Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Closure: Closure,
    Result: Menu(
      description: "Where to store the result of the closure. Bundle overwrite the existing `MN/Atoms` bundle. Geometry passes along the bundle and joins the resulting geometry into the output.",
      menu_expanded: true,
      optional_label: true) = Geometry
) -> Geometry {
  group = get_geometry_atoms(Geometry)
  "Evaluate the closure on the 'Atoms'" {
    evaluate_closure = EvaluateClosure(
      Closure,
      Atoms: group.atoms
        |> check_geometry(message: "'Atoms' contains no geometry, check your node connections.")
        |> mn_ensure_ures_id()
        |> SeparateGeometry(selection: Selection).selection) -> Geometry
  }
  menu_switch = MenuSwitch(menu: Result, Geometry: 0, Bundle: 1)
  string = "Evaluate the 'Closure' on the 'Atoms' geometry, join the resulting geometry with the input geometry.  If the input 'Geometry' doesn't contain a 'MN/Atoms' bundle then we treat the input geometry as the 'Atoms'."
  return SetGeometryBundle(
    group.geometry + IndexSwitch(menu_switch.output, evaluate_closure, _),
    bundle: StoreBundleItem[GEOMETRY](
      bundle: group.bundle,
      path: "MN/Atoms",
      item: IndexSwitch(menu_switch.output, group.atoms, evaluate_closure)))
}

geometry graph "Is Peptide"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_peptide", fallback: mn_select_peptide().is_peptide))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Separate Polymers"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (Peptide: Geometry, Nucleic: Geometry, Other: Geometry) {
  separate_geometry = SeparateGeometry(Atoms, selection: is_peptide().selection)
  separate_geometry_2 = SeparateGeometry(
    separate_geometry.inverted,
    selection: is_nucleic().selection)
  return (
    Peptide: separate_geometry.selection,
    Nucleic: separate_geometry_2.selection,
    Other: separate_geometry_2.inverted)
}

geometry(show_modifier_manage_panel: false) graph "Style Ribbon"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this style to, discarding unselected points",
      hide_value: true) = true,
    Quality: Int(
      description: "A lower value results in less geometry, with a higher value meaning better looking but more dense geometry") = 3 in 0..6,
    "Peptide"(default_closed: true) {
        "Peptide Radius": Float = 1.6 in 0.0..,
        "Backbone" {
            "Backbone Smoothing": Float(
              subtype: FACTOR,
              description: "Smoothen the sheet ribbons such as beta-sheets") = 0.5 in 0.0..1.0,
            "Backbone Threshold": Float(
              description: "Distance (Angstroms) over which subsequent CA points are treated as a new chain") = 4.5 in 0.0..10000.0
        },
        "UV Map"(
          description: "Create a UV map for the generated mesh ribbon.",
          default_closed: true) {
            "UV Map": Bool(
              is_panel_toggle: true,
              description: "Compute and store the `uv_map` for the final protein ribbon geometry"),
            "U Component": Menu(
              description: "Store either the 'Length' or the 'Factor' of the curve as the U component.",
              menu_expanded: true,
              optional_label: true) = Factor
        }
    },
    "Nucleic"(default_closed: true) {
        "Nucleic Backbone" {
            "Nucleic Backbone Shape": Menu(menu_expanded: true, optional_label: true) = Cicular,
            "Nucleic Backbone Radius": Float = 2.0 in 0.0..,
            "Nucleic Backbone Width": Float = 4.0 in 0.0..10000.0,
            "Nucleic Backbone Thickness": Float = 1.0 in 0.0..10000.0
        },
        "Nucleic Base"(default_closed: true) {
            "Base Geometry": Geometry,
            "Base Scale": Vector = (2.5, 0.5, 7.0) in -10000.0..10000.0,
            "Base Resolution": Int = 4 in 3..512,
            "Base Realize": Bool
        }
    },
    "Material"(default_closed: true) {
        "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
        Material: Material(
          description: "Material to apply to the resulting geometry",
          optional_label: true)
    }
) -> (Geometry: Geometry(description: "The generated geometry for the style node group")) {
  menu_switch = MenuSwitch(menu: nucleic_backbone_shape, Cicular: 0, Rectangular: 1)
  closure_output = graph(Atoms: Geometry) -> Geometry {
    group = Atoms
      |> check_geometry()
      |> separate_polymers()
    group_2 = mn_utils_style_ribbon_nucleic(
      group.nucleic,
      selection: Selection,
      material: Material,
      switch: IndexSwitch(menu_switch.output, true, false),
      backbone_subdivisions: IntegerMath[MULTIPLY](Value: Quality, Value_001: 2),
      backbone_resolution: IntegerMath[MULTIPLY](Value: Quality, Value_001: 4),
      backbone_radius: IndexSwitch(menu_switch.output, nucleic_backbone_radius, 0.0),
      backbone_shade_smooth: shade_smooth,
      backbone_scale: IndexSwitch(
        menu_switch.output,
        (0.0, 0.0, 0.0),
        CombineXYZ(x: 1.0, y: nucleic_backbone_width, z: nucleic_backbone_thickness)),
      base_geometry: base_geometry,
      base_scale: base_scale,
      base_resolution: base_resolution)
    group_3 = mn_utils_style_ribbon_peptide(
      group.peptide,
      selection: Selection,
      quality: Quality,
      bs_smoothing: backbone_smoothing,
      radius: peptide_radius,
      shade_smooth: shade_smooth,
      material: Material,
      uv_map: uv_map,
      u_component: u_component,
      threshold: backbone_threshold)
    join_geometry = group_3.curve + group_2.curve
    return group_3.geometry + group_2.geometry
  }
  return (Geometry: evaluate_on_atoms(Atoms, closure: closure_output))
}
