geometry graph "Edge Length"() -> (Length: Float) {
  edge_vertices = EdgeVertices()
  return (
    Length: EvaluateOnDomain[EDGE](
      value: distance(edge_vertices.position_1, edge_vertices.position_2)))
}

geometry graph "Break Curves"(
    Curves: Geometry(description: "Geometry to delete elements from"),
    Threshold: Float = 0.5
) -> (
    Curves: Geometry,
    "Original Index": Int(description: "Index of Spline before segments removed")
) {
  capture_attribute = CaptureAttribute[CURVE](Curves, Index: Index())
  return (
    Curves: capture_attribute.geometry
      |> CurveToMesh()
      |> DeleteGeometry[EDGE](selection: edge_length() > Threshold)
      |> MeshToCurve(),
    "Original Index": capture_attribute.index)
}

geometry graph "Lag Geometry"(
    Input: Geometry,
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Count: Int(description: "Number of frames to lag.") = 5,
    "Realize All": Bool(
      description: "Realize all levels of nested instances for a top-level instances. Overrides the value of the Depth input") = true
) -> (Geometry: Geometry, "Lag Index": Int, Index: Int) {
  index = Index()
  simulation_output = simulate(Geometry: Geometry) -> {
    return SeparateGeometry[INSTANCE](
      GeometryToInstance(SeparateGeometry(Input, selection: Selection).selection) + Geometry,
      selection: Index() < Count).selection
  }
  capture_attribute = CaptureAttribute(simulation_output, Index: index)
  capture_attribute_2 = CaptureAttribute[INSTANCE](capture_attribute.geometry, Index: index)
  return (
    Geometry: RealizeInstances(capture_attribute_2.geometry, realize_all: realize_all),
    "Lag Index": capture_attribute_2.index,
    Index: capture_attribute.index)
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "VDW Radii"(
    Index: Int = Index() in 0..
) -> (vdw_radii: Float(description: "Read the `vdw_radii` attribute from the geometry")) {
  return (
    vdw_radii: EvaluateAtIndex(
      value: fallback_float(name: "vdw_radii", fallback: mn_world_scale()),
      index: Index))
}

geometry(is_modifier: false) graph "Animate Trails"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    "Trail" {
        "Trail Threshold": Menu(menu_expanded: true, optional_label: true) = Unlimited,
        "Trail Curve Type": Menu(menu_expanded: true, optional_label: true) = Poly,
        "Trail Frames": Int(
          description: "Number of previous frames from the trajectory to display") = 5 in 1..100000,
        "Trail Radius": Float = 1.0 in 0.0..10000.0,
        "Trail Resolution": Int(description: "Tail radial resolution") = 6 in 3..32,
        "Trail Subdivisions": Int = 6 in 1..16,
        "Trail Cutoff": Float(
          subtype: DISTANCE,
          description: "Threshold over which the spline is broken up") = 10.0 in 0.0..10000.0
    },
    "Material" {
        "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
        Material: Material(
          description: "Material to apply to the resulting geometry",
          optional_label: true)
    }
) -> Geometry {
  group = lag_geometry(Atoms, selection: Selection, count: trail_frames)
  capture_attribute = group.geometry
    |> MeshToPoints()
    |> PointsToCurves(curve_group_id: group.index, weight: group.lag_index)
    |> ReverseCurve()
    |> CaptureAttribute(Factor: SplineParameter().factor)
  menu_switch = MenuSwitch(
    menu: trail_threshold,
    Unlimited: capture_attribute.geometry,
    Threshold: break_curves(capture_attribute.geometry, threshold: trail_cutoff).curves)
  return MenuSwitch(
      menu: trail_curve_type,
      Poly: menu_switch.output,
      Bezier: menu_switch.output
        |> SetSplineType[BEZIER]()
        |> SetHandleType()
        |> SetSplineResolution(resolution: trail_subdivisions)).output
    |> CurveToMesh(
      profile_curve: CurveCircle(resolution: trail_resolution),
      scale: capture_attribute.factor * (vdw_radii() * trail_radius),
      fill_caps: true)
    |> SetShadeSmooth(shade_smooth: shade_smooth)
    |> SetMaterial(material: Material)
}
