geometry graph ".MN_constants_atom_name_nucleic"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Side Chain Joint Carbon": Int
) {
  integer = 61
  integer_2 = 77
  integer_3 = 50
  integer_4 = 61
  integer_5 = 54
  return (
    "Backbone Lower": integer_3,
    "Backbone Upper": integer_4,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Side Chain Joint Carbon": integer_5)
}

geometry graph ".MN_select_nucleic"() -> (
    "Is Backbone": Bool(
      description: "True for atoms that are part of the sugar-phosphate backbone for the nucleotides"),
    "Is Side Chain": Bool(
      description: "True for atoms that are part of the bases for nucleotides."),
    "Is Nucleic": Bool(description: "True if the atoms are part of a nucleic acid")
) {
  group = mn_constants_atom_name_nucleic()
  named_attribute = NamedAttribute[INT](name: "atom_name")
  return (
    "Is Backbone": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.backbone_upper,
    "Is Side Chain": named_attribute.attribute >= group.side_chain_lower
      and named_attribute.attribute <= group.side_chain_upper,
    "Is Nucleic": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.side_chain_upper)
}
