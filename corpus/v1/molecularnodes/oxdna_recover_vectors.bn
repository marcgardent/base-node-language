geometry graph "oxDNA Recover Vectors"(Geometry: Geometry) -> (Atoms: Geometry) {
  "Isolate verts pointing toward normals, get positions" {
    sample_index = Geometry
      |> DeleteGeometry(selection: NamedAttribute[INT](name: "attribute_ID").attribute != 2)
      |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index())
  }
  "Isolate verts pointing toward base vecs, get positions" {
    sample_index_2 = Geometry
      |> DeleteGeometry(selection: NamedAttribute[INT](name: "attribute_ID").attribute != 1)
      |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index())
  }
  "Isolate verts containing bbone positions, get positions & geom" {
    delete_geometry = DeleteGeometry(
      Geometry,
      selection: NamedAttribute[INT](name: "attribute_ID").attribute != 0)
    sample_index_3 = SampleIndex[FLOAT_VECTOR](delete_geometry, value: Position(), index: Index())
  }
  "Recover base & normal vectors from vert positions, store" {
    remove_named_attribute = delete_geometry
      |> StoreNamedAttribute[FLOAT_VECTOR](
        name: "base_vector",
        value: normalize(sample_index_2 - sample_index_3))
      |> StoreNamedAttribute[FLOAT_VECTOR](
        name: "base_normal",
        value: normalize(sample_index - sample_index_3))
      |> RemoveNamedAttribute(name: "attribute_ID")
  }
  return (Atoms: remove_named_attribute)
}
