geometry graph "Color Secondary Structure"(
    Helix: Color(
      description: "Color to set for alpha helices") = (0.16202937, 0.6239606, 0.19461784),
    Sheet: Color(description: "Color to set for beta-sheets") = (1.0, 0.1499598, 0.1499598),
    Loop: Color(
      description: "Color to set for loops in the structure") = (0.17144114, 0.3662526, 0.799103),
    Other: Color = (0.8, 0.8, 0.8)
) -> (Color: Color(description: "The colors based on secondary structure")) {
  return (
    Color: is_loop().selection
      ? Loop
      : is_sheet().selection ? Sheet : is_helix().selection ? Helix : Other)
}
