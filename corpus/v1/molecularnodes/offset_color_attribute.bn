geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Color Attribute"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index(),
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Color: Color(description: "The field evaluated at the offset `Index` value")) {
  return (Color: Color(index: offset_index(index: Index, offset: Offset)))
}
