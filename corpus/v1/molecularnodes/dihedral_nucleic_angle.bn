geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Vector Angle"(
    A: Vector(description: "The first vector for angle calculation") in -10000.0..10000.0,
    B: Vector(description: "The second vector for the angle calculation") in -10000.0..10000.0
) -> (
    Angle: Float(subtype: ANGLE, description: "The angle between the two vectors in radians"),
    "A×B": Vector(description: "Axis around which the angle rotates (cross product of A and B)")
) {
  "The angle between two vectors, in radians"
  vector_math = normalize(A)
  vector_math_2 = normalize(B)
  return (Angle: acos(vector_math ⋅ vector_math_2), "A×B": vector_math × vector_math_2)
}

geometry graph "Dihedral Angle"(
    A: Vector(description: "First vector for the calculation, which draws a line to B"),
    B: Vector(
      description: "Second vector for the calculation, which receives a line from A and draws a line to C"),
    C: Vector(
      description: "Third vector for the calculation, which receives a line from B and draws a line to D"),
    D: Vector(
      description: "Last vector for the calculation, which is the end point of the line from D")
) -> (
    Angle: Float(
      subtype: ANGLE,
      description: "The angle between the vectors AB and CD, when made perpendicular to BC."),
    "BA⟂(BC)": Vector(description: "The vector BA when made perpendicular to  the axis BC"),
    "CD⟂(BC)": Vector(description: "The Vector CD when makde perpendicular to the axis BC"),
    BC: Vector(description: "The axis vector BC")
) {
  vector_math = D - C
  vector_math_2 = A - B
  vector_math_3 = C - B
  vector_math_4 = vector_math_2
    - VectorMath[PROJECT](Vector: vector_math_2, Vector_001: vector_math_3)
  vector_math_5 = vector_math - VectorMath[PROJECT](Vector: vector_math, Vector_001: vector_math_3)
  return (
    Angle: vector_angle(a: vector_math_4, b: vector_math_5).angle
      * sign((vector_math_4 × vector_math_5) ⋅ vector_math_3),
    "BA⟂(BC)": vector_math_4,
    "CD⟂(BC)": vector_math_5,
    BC: vector_math_3)
}

geometry graph "Find Connected"(
    Value: Int(hide_value: true),
    Match: Int = 2,
    Distance: Int = 2 in 1..3,
    Method: Menu(optional_label: true) = Any
) -> ("Is Valid": Bool, Length: Int, Index: Int) {
  shortest_edge_paths = ShortestEdgePaths(end_vertex: Value == Match)
  compare = Compare[EQUAL, INT](a: shortest_edge_paths.total_cost, b: 2)
  compare_2 = Compare[EQUAL, INT](a: shortest_edge_paths.total_cost, b: 3)
  evaluate_at_index = EvaluateAtIndex[INT](
    value: shortest_edge_paths.next_vertex_index,
    index: shortest_edge_paths.next_vertex_index)
  evaluate_at_index_2 = EvaluateAtIndex[INT](
    value: shortest_edge_paths.next_vertex_index,
    index: evaluate_at_index)
  switch = Compare[EQUAL, INT](a: shortest_edge_paths.total_cost, b: 1)
    ? shortest_edge_paths.next_vertex_index
    : -1
  switch_2 = compare ? evaluate_at_index : switch
  menu_switch = MenuSwitch(
    menu: Method,
    Any: IndexSwitch(Distance, 0, switch, switch_2, compare_2 ? evaluate_at_index_2 : switch_2),
    Exact: IndexSwitch(
      Distance,
      0,
      switch,
      compare ? evaluate_at_index : -1,
      compare_2 ? evaluate_at_index_2 : -1))
  return (
    "Is Valid": menu_switch.output != -1,
    Length: FloatToInteger(float: shortest_edge_paths.total_cost),
    Index: menu_switch.output)
}

