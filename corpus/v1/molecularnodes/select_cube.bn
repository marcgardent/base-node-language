geometry graph "Between Vector"(
    Value: Vector(description: "The value to test element-wise"),
    Lower: Vector(description: "The lower bounds (including) for the comparison"),
    Upper: Vector(description: "The upper bounds (including) for the comparison")
) -> (
    Boolean: Bool(
      description: "If the value is between (and including) the lower the upper bounds")
) {
  return (Boolean: Value >= Lower and Value <= Upper)
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Select Cube"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Object: Object(
      description: "The position, rotation and scale from this Object will be used for the distance calculation for the selection. By default an Empty object is used, but any object can be used in principle",
      optional_label: true) = "select_cube"
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: between_vector(
      value: ProjectPoint(
        vector: Position(),
        transform: InvertMatrix(
          matrix: ObjectInfo[RELATIVE](object: Object, as_instance: true).transform).matrix),
      lower: (-1.0, -1.0, -1.0),
      upper: (1.0, 1.0, 1.0)))
  return (Selection: group.boolean, Inverted: group.inverted)
}
