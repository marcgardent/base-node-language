geometry graph "Group Parameter"(
    "Group ID": Int(
      description: "The identifier specifying groupings of the points",
      hide_value: true)
) -> (
    "Is First": Bool(description: "If the point is the first point in the `Group ID`"),
    "Is Last": Bool(description: "If the point is the last item in the `Group ID`"),
    "Group Size": Int,
    "Relative Index": Int(
      description: "The relative index  of the point within the `Group ID`. Starts at `0` for the first point counting up to `Group Size - 1`")
) {
  accumulate_field = AccumulateField[INT](group_id: group_id)
  return (
    "Is First": not accumulate_field.trailing,
    "Is Last": accumulate_field.leading == accumulate_field.total,
    "Group Size": accumulate_field.total,
    "Relative Index": accumulate_field.trailing)
}

geometry graph "Group Pick"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true)
) -> (
    "Is Valid": Bool(
      description: "Valid for the point only if there is 1 single `True` for the `Pick` field in the point's group in the `Group ID`"),
    Index: Int(description: "Index of picked item. Returns -1 if not a valid pick")
) {
  "Get the item of the `True` in each `Group ID`, but only if there is a single `True` in each group"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total == 1
  return (
    "Is Valid": compare,
    Index: compare ? AccumulateField[INT](value: Pick ? Index() : 0, group_id: group_id).total : -1)
}

geometry graph "Boolean First"(
    Boolean: Bool(description: "The `Boolean` field to test", hide_value: true),
    "Group ID": Int(
      description: "Each `Group ID` to find the first `True` element for",
      hide_value: true)
) -> ("Is First": Bool(description: "`True` for the first true element in each `Group ID`")) {
  "Only the first `True` in each `Group ID` remains `True`, all others become `False`"
  return (
    "Is First": AccumulateField[INT](
        value: AccumulateField[INT](value: Boolean, group_id: group_id).leading,
        group_id: group_id).leading
      == 1)
}

geometry graph "Group Pick First"(
    Pick: Bool(
      description: "Index of the first `True` item in this field will be returned",
      hide_value: true),
    "Group ID": Int(
      description: "The first `True` item for each `Group ID` will be returned",
      hide_value: true)
) -> (
    "Is Valid": Bool(description: "Valid if as least 1 `True` for the `Group ID`"),
    Index: Int(description: "Index of first picked item, returns `-1` if nothing picked")
) {
  "Get the `Index` of the first `True` item for each `Group ID`"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total >= 1
  return (
    "Is Valid": compare,
    Index: compare
      ? AccumulateField[INT](
        value: boolean_first(boolean: Pick, group_id: group_id) ? Index() : 0,
        group_id: group_id).total
      : -1)
}

geometry graph "Relative Index"(
    "Group ID": Int(description: "Define the groups to get information about", hide_value: true)
) -> (
    "Group Size": Int(description: "The number of points in each `Group ID`"),
    "Relative Index": Int(
      description: "The relative index of each point within each `Group ID`, starting from 0"),
    "First Index": Int(description: "The `Index` of the first point in each `Group ID`"),
    "Last Index": Int(description: "The `Index` of the last point in each `Group ID`")
) {
  "Get information about the points in a `Group ID` such as size and the start and end Indices"
  group = group_parameter(group_id: group_id)
  group_2 = group_pick(pick: group.is_last, group_id: group_id)
  group_3 = group_pick(pick: group.is_first, group_id: group_id)
  return (
    "Group Size": group.group_size,
    "Relative Index": group.relative_index,
    "First Index": group_pick_first(pick: group.is_first, group_id: group_id).index,
    "Last Index": group_pick_first(pick: group.is_last, group_id: group_id).index)
}
