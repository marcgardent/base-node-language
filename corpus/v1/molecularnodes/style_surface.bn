geometry graph "Sorted Bundle Paths"(
    Bundle: Bundle,
    "Bundle Type": String(optional_label: true) = "MN*"
) -> (List: String) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: Bundle,
    mode: "Bundle Type",
    pattern_mode: Wildcard,
    bundle_type: bundle_type)
  format_string = FormatString(format: "{v}/step", v: get_nested_bundle_paths)
  closure_output = graph(
    Index: Int(structure_type: SINGLE)
  ) -> (Item: Int(structure_type: DYNAMIC)) {
    return GetBundleItem[INT](
      bundle: Bundle,
      path: GetListItem[STRING](list: format_string, index: Index)).item
  }
  return (
    List: SortList[STRING](
      list: get_nested_bundle_paths,
      sort_weight: ClosureToList(
        ListLength[STRING](list: format_string),
        closure_output) -> (Item: Int(structure_type: DYNAMIC))))
}

geometry graph "Evaluate Ordered Bundles"(
    Geometry: Geometry,
    Bundles: Bundle,
    Prefix: String(optional_label: true) = "MN*"
) -> Geometry {
  group = sorted_bundle_paths(bundle: Bundles, bundle_type: Prefix)
  string = "closure"
  repeat_output = repeat(ListLength[STRING](list: group), Geometry: Geometry) -> {
    return EvaluateClosure(
      GetBundleItem[CLOSURE](
        bundle: Bundles,
        path: JoinStrings("/", GetListItem[STRING](list: group, index: iteration), string)).item,
      Geometry: Geometry) -> Geometry
  }
  return repeat_output
}

geometry graph ".MN_utils_style_surface_new"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    "Relaxation Steps": Int = 30 in 0..,
    "Grid Create": Closure,
    "Mesh Processing": Bundle,
    Threshold: Float(description: "Values larger than the threshold are inside the generated mesh")
) -> Geometry {
  field_to_list = FieldToList(count: ListLength[STRING]())
  sort_list = SortList()
  return EvaluateClosure[define_signature: true](
      grid_create,
      Atoms: Atoms) -> (Grid: Geometry(structure_type: SINGLE))
    |> evaluate_ordered_bundles(bundles: mesh_processing)
    |> SetShadeSmooth(shade_smooth: shade_smooth)
    |> SetMaterial(material: Material)
}

geometry graph ".MN_constants_atom_name_nucleic"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Side Chain Joint Carbon": Int
) {
  integer = 61
  integer_2 = 77
  integer_3 = 50
  integer_4 = 61
  integer_5 = 54
  return (
    "Backbone Lower": integer_3,
    "Backbone Upper": integer_4,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Side Chain Joint Carbon": integer_5)
}

geometry graph ".MN_surface_smooth_bumps"(Geometry: Geometry) -> Geometry {
  "Smoothen out weird bumps from meshing" {
    edge_vertices = EdgeVertices()
    compare = VertexNeighbors().vertex_count == 3
    face_group_boundaries = FaceGroupBoundaries(
      face_group_id: EdgesToFaceGroups(
        boundary_edges: EvaluateAtIndex[BOOLEAN](
            value: compare,
            index: edge_vertices.vertex_index_1)
          and EvaluateAtIndex[BOOLEAN](value: compare, index: edge_vertices.vertex_index_2)))
  }
  return SetPosition(
    Geometry,
    selection: face_group_boundaries,
    position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: 4))
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "VDW Radii"(
    Index: Int = Index() in 0..
) -> (vdw_radii: Float(description: "Read the `vdw_radii` attribute from the geometry")) {
  return (
    vdw_radii: EvaluateAtIndex(
      value: fallback_float(name: "vdw_radii", fallback: mn_world_scale()),
      index: Index))
}

geometry graph ".surface_compute_density_from_points"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    "Scale Radius": Float = 1.0 in -10000.0..10000.0,
    "Probe Size": Float in 0.0..10000.0
) -> (Result: Bool, Distance: Float) {
  position = Position()
  sample_nearest = SampleNearest(Atoms)
  math = probe_size
    + SampleIndex(Atoms, value: vdw_radii() * scale_radius, index: sample_nearest)
    - distance(SampleIndex[FLOAT_VECTOR](Atoms, value: position, index: sample_nearest), position)
  return (Result: math > 0.0, Distance: math)
}

geometry graph ".utils_bounding_box"(
    Geometry: Geometry,
    Subdivisions: Float = 16.7 in -10000.0..10000.0
) -> (Min: Vector, Max: Vector, X: Int, Y: Int, Z: Int) {
  group = mn_world_scale()
  bounding_box = BoundingBox(Geometry)
  math = group * 2.0
  vector_math = VectorMath[SNAP](Vector: bounding_box.min, Vector_001: group) - math
  vector_math_2 = VectorMath[SNAP](Vector: bounding_box.max, Vector_001: group) + math
  vector_math_3 = (vector_math_2 - vector_math) * Subdivisions
  return (
    Min: vector_math,
    Max: vector_math_2,
    X: max(vector_math_3.x, 2.0),
    Y: max(vector_math_3.y, 2.0),
    Z: max(vector_math_3.z, 2.0))
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph ".MN_constants_atom_name_peptide"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Alpha Carbon": Int
) {
  integer = 5
  integer_2 = 49
  integer_3 = 4
  integer_4 = 1
  integer_5 = 2
  return (
    "Backbone Lower": integer_4,
    "Backbone Upper": integer_3,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Alpha Carbon": integer_5)
}

geometry graph ".MN_select_peptide"() -> (
    "Is Backbone": Bool,
    "Is Side Chain": Bool,
    "Is Peptide": Bool,
    "Is Alpha Carbon": Bool
) {
  group = mn_constants_atom_name_peptide()
  group_2 = atom_name()
  compare = group_2 == group.alpha_carbon
  return (
    "Is Backbone": group_2 >= group.backbone_lower and group_2 <= group.backbone_upper,
    "Is Side Chain": group_2 >= group.side_chain_lower and group_2 <= group.side_chain_upper
      or compare,
    "Is Peptide": group_2 >= group.backbone_lower and group_2 <= group.side_chain_upper,
    "Is Alpha Carbon": compare)
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Alpha Carbon"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(
      name: "is_alpha_carbon",
      fallback: mn_select_peptide().is_alpha_carbon))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Set Color"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Color: Color(
      description: "Color to apply to the selected atoms") = (0.161517, 0.623961, 0.195602)
) -> (Atoms: Geometry(description: "Atomic geometry with an updated `Color` attribute")) {
  return (
    Atoms: StoreNamedAttribute[FLOAT_COLOR](
      Atoms,
      selection: Selection,
      name: "Color",
      value: Color))
}

geometry graph ".MN_utils_style_surface_sdf"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Quality: Int = 12 in 1..15,
    "Scale Radii": Float = 1.0 in 0.0..10.0,
    "Probe Size": Float = 0.6 in 0.0..10000.0,
    "Color Source": Menu(optional_label: true) = "Alpha Carbon",
    "Color Blur": Int(
      description: "Interpolate between colors when enabled. When disabled the faces will take their color from their corresponding atom without interpolating") = 1 in 0..20,
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    "Relaxation Steps": Int = 30 in 0..
) -> ("Surface Geometry": Geometry) {
  separate_geometry = SeparateGeometry(Atoms, selection: Selection)
  group = surface_compute_density_from_points(
    separate_geometry.selection,
    scale_radius: scale_radii,
    probe_size: probe_size)
  group_2 = utils_bounding_box(separate_geometry.selection, subdivisions: Quality * 5.0)
  separate_geometry_2 = SeparateGeometry(
    separate_geometry.selection,
    selection: is_alpha_carbon().selection
      or mn_constants_atom_name_nucleic().side_chain_joint_carbon == atom_name())
  menu_switch = MenuSwitch(
    menu: color_source,
    "Alpha Carbon": DomainSize(separate_geometry_2.selection).point_count == 0
      ? separate_geometry_2.inverted
      : separate_geometry_2.selection,
    Nearest: separate_geometry.selection)
  "Generate Surface from Measurements" {
    volume_to_mesh = VolumeCube(
        density: group.result,
        min: group_2.min,
        max: group_2.max,
        resolution_x: group_2.x,
        resolution_y: group_2.y,
        resolution_z: group_2.z)
      |> VolumeToMesh(voxel_size: 0.01)
  }
  "Pull in surface towards atoms" {
    position = Position()
    capture_attribute = CaptureAttribute(
      volume_to_mesh,
      Value: SampleNearest(separate_geometry.selection))
    sample_index = SampleIndex[FLOAT_VECTOR](
      separate_geometry.selection,
      value: position,
      index: capture_attribute.value)
    set_position = SetPosition(
      capture_attribute.geometry,
      position: sample_index
        + normalize(position - sample_index)
          * SampleIndex(
            separate_geometry.selection,
            value: scale_radii * vdw_radii(),
            index: capture_attribute.value))
  }
  "smoothing of tightened surface" {
    position_2 = Position()
    capture_attribute_2 = CaptureAttribute(set_position, Value: position_2)
    group_3 = capture_attribute_2.geometry
      |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: position_2, iterations: 2))
      |> SetPosition(
        offset: Normal[legacy_corner_normals: true]().normal
          * (distance(capture_attribute_2.value, position_2) * -1.8))
      |> SetPosition(position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: 2))
      |> SetPosition(
        position: BlurAttribute[FLOAT_VECTOR](
          value: Position(),
          iterations: relaxation_steps,
          weight: BlurAttribute(
            value: EvaluateOnDomain[FACE](
              value: MapRange(value: EdgeAngle().signed_angle, from_min: -0.2, from_max: -1.0)),
            iterations: 2)))
      |> mn_surface_smooth_bumps()
  }
  triangulate = Triangulate(group_3, quad_method: Beauty)
  "Sample colors of nearest atom" {
    group_4 = set_color(
      triangulate,
      color: BlurAttribute[FLOAT_COLOR](
        value: SampleIndex[FLOAT_COLOR](
          menu_switch.output,
          value: Color(),
          index: SampleNearest(menu_switch.output)),
        iterations: color_blur))
  }
  return (
    "Surface Geometry": group_4
      |> SetShadeSmooth(shade_smooth: shade_smooth)
      |> SetMaterial(material: Material))
}

geometry graph "Edge Length"() -> (Length: Float) {
  edge_vertices = EdgeVertices()
  return (
    Length: EvaluateOnDomain[EDGE](
      value: distance(edge_vertices.position_1, edge_vertices.position_2)))
}

geometry graph "MN Typed Bundles"(
    Type: Menu(optional_label: true) = "MN.MeshProcess",
    Closure: Closure,
    step: Int = 1,
    Path: String(optional_label: true)
) -> Bundle {
  return StoreBundleItem[BUNDLE](
    path: Path,
    item: CombineBundle(
      Type: MenuSwitch(menu: Type, "MN.MeshProcess": "MN.MeshProcess").output,
      closure: Closure,
      step: step))
}

geometry graph ".Relax Surface"("Relaxation Steps": Int = 30 in 0.., step: Int = 3) -> Bundle {
  closure_output = graph(Geometry: Geometry) -> Geometry {
    return Geometry
      |> SetPosition(
        position: BlurAttribute[FLOAT_VECTOR](
          value: Position(),
          iterations: relaxation_steps,
          weight: BlurAttribute(
            value: MapRange(
              value: EdgeAngle().signed_angle,
              from_min: -0.2,
              from_max: 0.3,
              to_min: 1.0,
              to_max: 0.0))))
      |> mn_surface_smooth_bumps()
  }
  group = edge_length()
  field_min_and_max = FieldMinAndMax(value: group)
  map_range = MapRange(
    value: group,
    from_min: field_min_and_max.min,
    from_max: field_min_and_max.max)
  return mn_typed_bundles(closure: closure_output, step: step, path: "Relax Surface")
}

geometry graph ".Sample Colors"(
    "Color Source": Menu(optional_label: true) = "Alpha Carbon",
    Atoms: Geometry,
    step: Int = 1,
    Blur: Int(description: "How many times to blur the values for all elements") = 1 in 0..
) -> Bundle {
  "Don't transfer these attributes" {
    field_to_list = FieldToList(
      count: 2,
      "Attribute Names": IndexSwitch(Index(), "bond_type", "position"))
  }
  separate_geometry = SeparateGeometry(
    Atoms,
    selection: is_alpha_carbon().selection
      or mn_constants_atom_name_nucleic().side_chain_joint_carbon == atom_name())
  menu_switch = MenuSwitch(
    menu: color_source,
    "Alpha Carbon": DomainSize(separate_geometry.selection).point_count == 0
      ? separate_geometry.inverted
      : separate_geometry.selection,
    Nearest: Atoms)
  closure_output = graph(Geometry: Geometry) -> Geometry {
    capture_attribute = CaptureAttribute(Geometry, Index: SampleNearest(menu_switch.output))
    return capture_attribute.geometry
      |> TransferAttributes(
        target_point_id: capture_attribute.index,
        source: menu_switch.output,
        pattern_mode: Exact,
        attribute_names: field_to_list,
        exclude_names: true).target
      |> set_color(color: BlurAttribute[FLOAT_COLOR](value: Color(), iterations: Blur))
  }
  return mn_typed_bundles(closure: closure_output, step: step, path: "Sample Colors")
}

geometry graph ".Surface to Radius"(
    "Scale Radii": Float = 1.47 in 0.0..10.0,
    Atoms: Geometry,
    step: Int
) -> Bundle {
  position = Position()
  closure_output = graph(Geometry: Geometry) -> Geometry {
    capture_attribute = CaptureAttribute(Geometry, Value: SampleNearest(Atoms))
    capture_attribute_2 = CaptureAttribute(
      capture_attribute.geometry,
      "Value.001": SampleIndex[FLOAT_VECTOR](
        Atoms,
        value: position,
        index: capture_attribute.value))
    return SetPosition(
      capture_attribute_2.geometry,
      position: Mix[VECTOR](
        factor: 0.0,
        a: capture_attribute_2.value_001
          + normalize(position - capture_attribute_2.value_001)
            * SampleIndex(Atoms, value: scale_radii * vdw_radii(), index: capture_attribute.value),
        b: Position()))
  }
  return mn_typed_bundles(closure: closure_output, step: step, path: "Surface to Radius")
}

geometry graph ".Triangulate Mesh"(step: Int = 4) -> Bundle {
  closure_output = graph(Geometry: Geometry) -> Geometry {
    group = mn_surface_smooth_bumps(Geometry) @ mute
    triangulate = Triangulate(group, quad_method: Beauty) @ mute
    return triangulate
  }
  return mn_typed_bundles(closure: closure_output, step: step, path: "Triangulate Mesh")
}

geometry graph "Unit Convert"(
    "Distance Type": Menu(
      description: "What unit to scale the value to",
      optional_label: true) = Angstrom,
    From: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (
    World: Float(description: "The value that has been scaled appropriately for the world space")
) {
  math = From * mn_world_scale()
  math_2 = math * 10.0
  return (
    World: MenuSwitch(
      menu: distance_type,
      Angstrom: math,
      Nanometre: math_2,
      Micrometre: math_2 * 1000.0).output)
}

geometry graph "Angstrom to World"(Angstrom: Float = 3.0 in -10000.0..10000.0) -> (World: Float) {
  return (World: unit_convert(from: Angstrom))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph "Evaluate Per Group"(
    Geometry: Geometry(description: "Geometry to split into two parts"),
    Closure: Closure,
    Group: Menu(menu_expanded: true, optional_label: true) = chain_id,
    "Group ID": Int(hide_value: true)
) -> (Geometry: Geometry, Instances: Geometry) {
  "Count number of chains" {
    menu_switch = MenuSwitch(menu: Group, chain_id: chain_id(), "Group ID": group_id)
    separate_geometry = SeparateGeometry(
      Geometry,
      selection: not AccumulateField[INT](group_id: menu_switch.output).trailing)
    domain_size = DomainSize(separate_geometry.selection)
  }
  repeat_output = repeat(
    domain_size.point_count,
    Geometry as Geometry_2: Geometry = _,
    Instances: Geometry = _) -> {
    sample_index = SampleIndex[INT](
      separate_geometry.selection,
      value: menu_switch.output,
      index: iteration)
    store_named_attribute = EvaluateClosure(
        Closure,
        Geometry: SeparateGeometry(
          Geometry,
          selection: sample_index == menu_switch.output).selection,
        group_id: sample_index) -> Geometry
      |> StoreNamedAttribute[INT](name: "group_id", value: iteration)
    return (
      Geometry_2: Geometry_2 + store_named_attribute,
      Instances: Instances + GeometryToInstance(store_named_attribute))
  }
  return (Geometry: repeat_output.Geometry_2, Instances: repeat_output.instances)
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph ".MN_ensure_ures_id"(Input: Geometry) -> (Output: Geometry) {
  "If the `ures_id` attribute doesn't exist, create it"
  "Check if `ures_id` exists" {
    get_attribute_names = GetAttributeNames(
      Input,
      filter_data_type: true,
      data_type: Integer,
      filter_domain: true)
    list_length = ListLength[STRING](
      list: FilterList[STRING](
        list: get_attribute_names,
        selection: get_attribute_names == "ures_id").selection)
  }
  return (Output: list_length ? Input : set_ures_id(Input))
}

geometry graph "Contains Geometry"(
    Geometry: Geometry
) -> (
    "Not Empty": Bool(description: "True when the input contains some geometry"),
    Empty: Bool(description: "True when the input contains no geometry")
) {
  boolean_math = DomainSize(Geometry).point_count == 0
    and DomainSize[POINTCLOUD](Geometry) == 0
    and DomainSize[CURVE](Geometry).point_count == 0
    and DomainSize[INSTANCES](Geometry) == 0
    and DomainSize[GREASEPENCIL](Geometry) == 0
  return ("Not Empty": not boolean_math, Empty: boolean_math)
}

geometry graph "Check Geometry"(
    Geometry: Geometry,
    Message: String(
      optional_label: true) = "Input contains no geometry, check your node connections."
) -> Geometry {
  warning = Warning(show: contains_geometry(Geometry).empty, message: Message)
  return Geometry
}

geometry graph "Get Geometry Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> (Geometry: Geometry, Bundle: Bundle, Atoms: Geometry) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  string = "MN/Atoms"
  get_bundle_item = GetBundleItem[GEOMETRY](
    bundle: get_geometry_bundle.bundle,
    path: string,
    remove: true)
  return (
    Geometry: Switch[GEOMETRY](switch: get_bundle_item.exists, true_: get_geometry_bundle.geometry),
    Bundle: get_bundle_item.bundle,
    Atoms: get_bundle_item.exists ? get_bundle_item.item : get_geometry_bundle.geometry)
}

geometry graph "Evaluate on Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Closure: Closure,
    Result: Menu(
      description: "Where to store the result of the closure. Bundle overwrite the existing `MN/Atoms` bundle. Geometry passes along the bundle and joins the resulting geometry into the output.",
      menu_expanded: true,
      optional_label: true) = Geometry
) -> Geometry {
  group = get_geometry_atoms(Geometry)
  "Evaluate the closure on the 'Atoms'" {
    evaluate_closure = EvaluateClosure(
      Closure,
      Atoms: group.atoms
        |> check_geometry(message: "'Atoms' contains no geometry, check your node connections.")
        |> mn_ensure_ures_id()
        |> SeparateGeometry(selection: Selection).selection) -> Geometry
  }
  menu_switch = MenuSwitch(menu: Result, Geometry: 0, Bundle: 1)
  string = "Evaluate the 'Closure' on the 'Atoms' geometry, join the resulting geometry with the input geometry.\n\nIf the input 'Geometry' doesn't contain a 'MN/Atoms' bundle then we treat the input geometry as the 'Atoms'."
  return SetGeometryBundle(
    group.geometry + IndexSwitch(menu_switch.output, evaluate_closure, _),
    bundle: StoreBundleItem[GEOMETRY](
      bundle: group.bundle,
      path: "MN/Atoms",
      item: IndexSwitch(menu_switch.output, group.atoms, evaluate_closure)))
}

geometry graph "Principal Components"(
    Position: Vector(subtype: TRANSLATION) = Position(),
    "Group ID": Int(
      description: "An index used to group values together for multiple separate operations",
      hide_value: true)
) -> (
    "Group Center": Vector,
    Rotation: Rotation(description: "Rotation that defines the principal component basis"),
    "Principal Components": Vector(description: "Variance of the data along each principal axis"),
    "Principal Axes" {
        "Longest Axis": Vector(description: "Axis along the most variance"),
        "Intermediate Axis": Vector(
          description: "Axis completing a right handed orthogonal basis with the longest and shortest axis"),
        "Shortest Axis": Vector(description: "Axis along the least variance")
    }
) {
  "Principal Component Analysis (PCA) of a vector field"
  "Centroid" {
    field_average = FieldAverage[FLOAT_VECTOR](value: Position, group_id: group_id)
  }
  "Covariance matrix" {
    vector_math = Position - field_average.mean
    field_average_2 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.x,
      group_id: group_id)
    field_average_3 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.y,
      group_id: group_id)
    field_average_4 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.z,
      group_id: group_id)
    combine_matrix = CombineMatrix(
      column_1_row_1: field_average_2.mean.x,
      column_1_row_2: field_average_2.mean.y,
      column_1_row_3: field_average_2.mean.z,
      column_2_row_1: field_average_3.mean.x,
      column_2_row_2: field_average_3.mean.y,
      column_2_row_3: field_average_3.mean.z,
      column_3_row_1: field_average_4.mean.x,
      column_3_row_2: field_average_4.mean.y,
      column_3_row_3: field_average_4.mean.z)
  }
  "SVD of Covariance to find principal components" {
    matrix_svd = MatrixSVD(matrix: combine_matrix)
    matrix_determinant = MatrixDeterminant(matrix: matrix_svd.u)
  }
  separate_matrix = SeparateMatrix(matrix: matrix_svd.u)
  combine_xyz = CombineXYZ(
    x: separate_matrix.column_1_row_1,
    y: separate_matrix.column_1_row_2,
    z: separate_matrix.column_1_row_3)
  combine_xyz_2 = CombineXYZ(
    x: separate_matrix.column_3_row_1,
    y: separate_matrix.column_3_row_2,
    z: separate_matrix.column_3_row_3)
  return (
    "Group Center": field_average.mean,
    Rotation: AxesToRotation[primary_axis: X, secondary_axis: Z](
      primary_axis: combine_xyz,
      secondary_axis: combine_xyz_2),
    "Principal Components": matrix_svd.s,
    "Longest Axis": combine_xyz,
    "Intermediate Axis": CombineXYZ(
        x: separate_matrix.column_2_row_1,
        y: separate_matrix.column_2_row_2,
        z: separate_matrix.column_2_row_3)
      * sign(matrix_determinant),
    "Shortest Axis": combine_xyz_2)
}

geometry graph "Geometry Principal Components"(
    Geometry: Geometry(
      description: "Geometry to evaluate the given fields and store the resulting attributes on. All geometry types except volumes are supported"),
    Position: Vector(subtype: TRANSLATION) = Position()
) -> (
    "Group Center": Vector,
    Rotation: Rotation(description: "Rotation that defines the principal component basis"),
    "Principal Components": Vector(description: "Variance of the data along each principal axis"),
    "Principal Axes" {
        "Longest Axis": Vector(description: "Axis along the most variance"),
        "Intermediate Axis": Vector(
          description: "Axis completing a right handed orthogonal basis with the longest and shortest axis"),
        "Shortest Axis": Vector(description: "Axis along the least variance")
    }
) {
  "Principal Component Analysis (PCA) of a the positions of points"
  capture_attribute = CaptureAttribute(Geometry, Position: Position)
  group = principal_components(position: capture_attribute.position)
  return (
    "Group Center": SampleIndex[FLOAT_VECTOR](
      capture_attribute.geometry,
      value: group.group_center),
    Rotation: SampleIndex[QUATERNION](capture_attribute.geometry, value: group.rotation),
    "Principal Components": SampleIndex[FLOAT_VECTOR](
      capture_attribute.geometry,
      value: group.principal_components),
    "Longest Axis": SampleIndex[FLOAT_VECTOR](
      capture_attribute.geometry,
      value: group.longest_axis),
    "Intermediate Axis": SampleIndex[FLOAT_VECTOR](
      capture_attribute.geometry,
      value: group.intermediate_axis),
    "Shortest Axis": SampleIndex[FLOAT_VECTOR](
      capture_attribute.geometry,
      value: group.shortest_axis))
}

geometry graph "Geoemtry to Planar"(
    Geometry: Geometry(description: "Geometry to transform"),
    Selection: Bool(
      description: "The parts of the geometry that contibute to the planar calculation",
      hide_value: true) = true
) -> (Geometry: Geometry, Transform: Matrix) {
  group = Geometry
    |> SeparateGeometry(selection: Selection).selection
    |> geometry_principal_components()
  "Transform to Planar" {
    combine_transform = CombineTransform(
      translation: -group.group_center,
      rotation: InvertRotation(rotation: group.rotation))
  }
  return (
    Geometry: TransformGeometry(Geometry, mode: Matrix, transform: combine_transform),
    Transform: combine_transform)
}

geometry graph "Evluate While Planar"(
    Geometry: Geometry(description: "Geometry to transform"),
    Selection: Bool(
      description: "The parts of the geometry that contibute to the planar calculation",
      hide_value: true) = true,
    Closure: Closure
) -> Geometry {
  group = geoemtry_to_planar(Geometry, selection: Selection)
  return EvaluateClosure(Closure, Geometry: group.geometry) -> Geometry
    |> TransformGeometry(mode: Matrix, transform: InvertMatrix(matrix: group.transform).matrix)
}

geometry(show_modifier_manage_panel: false) graph "Style Surface"(
    Atoms: Geometry(
      description: "Atomic geometry that contains vertices and edges",
      hide_value: true),
    Selection: Bool(
      description: "Selection of atoms to apply this style to, discarding unselected points",
      hide_value: true) = true,
    Quality: Int(
      description: "A lower value results in less geometry, with a higher value meaning better looking but more dense geometry") = 3 in 0..6,
    "Surface"(default_closed: true) {
        Scale: Float(
          description: "Scale the VDW radii of the atoms when creating the surface") = 1.25 in 0.0..10.0,
        Relax: Int = 5 in 0..,
        "SDF"(default_closed: true) {
            Offset: Float(
              subtype: DISTANCE,
              description: "Object-space distance to offset the SDF surface") = 0.15 in 0.0..,
            Fillet: Int(description: "Number of iterations to apply the filter") in 0..,
            "Mean"(default_closed: true) {
                "Mean Width": Int(description: "Filter kernel radius in voxels") = 1 in 0..,
                "Mean Iterations": Int(
                  description: "Number of iterations to apply the filter") = 1 in 0..
            }
        },
        "Separate"(default_closed: true) {
            "Separate By": Menu(menu_expanded: true, optional_label: true) = chain_id,
            "Group ID": Int(hide_value: true)
        }
    },
    "Material"(default_closed: true) {
        "Color Source": Menu(menu_expanded: true, optional_label: true) = "Alpha Carbon",
        "Color Blur": Int(
          description: "Interpolate between colors when enabled. When disabled the faces will take their color from their corresponding atom without interpolating") = 2 in 0..20,
        "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
        Material: Material(
          description: "Material to apply to the resulting geometry",
          optional_label: true)
    }
) -> (Geometry: Geometry(description: "The generated geometry for the style node group")) {
  group = mn_utils_style_surface_new()
  "Create grid and turn into mesh" {
    "Old-style 'manual SDF creation" {
      closure_output = graph(Atoms: Geometry) -> (Geometry: Geometry(structure_type: SINGLE)) {
        group_2 = utils_bounding_box(Atoms, subdivisions: Quality * 5.0)
        grid_mean = GridMean(
          grid: SetGridBackground(
            grid: FieldToGrid[BOOLEAN](
              topology: CubeGridTopology(
                bounds_min: group_2.min,
                bounds_max: group_2.max,
                resolution_x: group_2.x,
                resolution_y: group_2.y,
                resolution_z: group_2.z),
              Density: surface_compute_density_from_points(
                Atoms,
                scale_radius: Scale).distance))) @ mute
        return GridToMesh(
            grid: GridMedian(grid: grid_mean),
            threshold: angstrom_to_world(angstrom: 4.3))
          |> SubdivisionSurface(limit_surface: false, quality: 1)
      }
    }
    "New SDF Node" {
      closure_output_2 = graph(Atoms: Geometry) -> Geometry {
        return GridToMesh(
          grid: SDFGridFillet(
            grid: SDFGridMean(
              grid: SDFGridOffset(
                grid: PointsToSDFGrid(
                  Atoms,
                  radius: Scale * vdw_radii(),
                  voxel_size: angstrom_to_world(
                    angstrom: 2.0 / Switch[FLOAT](switch: Quality, false_: 0.5, true_: Quality))),
                distance: Offset),
              width: mean_width,
              iterations: mean_iterations),
            iterations: Fillet),
          threshold: 0.0)
      }
    }
  }
  closure_output_4 = graph(Geometry: Geometry) -> Geometry {
    return mn_utils_style_surface_sdf(
      Geometry,
      selection: Selection,
      quality: Quality,
      scale_radii: Scale,
      color_blur: color_blur,
      shade_smooth: shade_smooth,
      material: Material)
  }
  menu_switch = MenuSwitch(menu: SDF, Current: closure_output, SDF: closure_output_2)
  "Mesh processing" {
    group_3 = triangulate_mesh() @ mute
    closure_output_5 = graph(Geometry: Geometry) -> Geometry {
      return EvaluateClosure[define_signature: true](
          menu_switch.output,
          Atoms: Geometry) -> (Geometry: Geometry(structure_type: SINGLE))
        |> evaluate_ordered_bundles(
          bundles: JoinBundle(
            surface_to_radius(scale_radii: Scale, atoms: Geometry),
            sample_colors(color_source: color_source, atoms: Geometry, blur: color_blur),
            relax_surface(relaxation_steps: Relax),
            group_3))
        |> SetShadeSmooth(shade_smooth: shade_smooth)
        |> SetMaterial(material: Material)
    }
  }
  "Create surface while points are as \"flat\" as possible" {
    closure_output_6 = graph(Geometry: Geometry, group_id: Int) -> Geometry {
      return Geometry
        |> evluate_while_planar(closure: closure_output_5)
        |> StoreNamedAttribute[INT](name: "chain_id", value: group_id)
    }
    string = "We get better performance if we first orient the structure better inside of a bounding box for more efficient use of grid space & voxels!"
  }
  closure_output_3 = graph(Atoms: Geometry) -> Geometry {
    return evaluate_per_group(
      Atoms,
      closure: closure_output_6,
      group: separate_by,
      group_id: group_id).geometry
  }
  return (Geometry: evaluate_on_atoms(Atoms, selection: Selection, closure: closure_output_3))
}
