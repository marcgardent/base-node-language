geometry graph "Constraint Distance"(
    Target: Vector in -10000.0..10000.0,
    Self: Vector = Position() in -10000.0..10000.0,
    Distance: Float = 0.5 in -10000.0..10000.0,
    W1: Float = 0.5 in 0.0..10000.0,
    W2: Float = 0.5 in 0.0..10000.0,
    alpha: Float in -10000.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> (Correction: Vector, Value: Float) {
  vector_math = Target - Self
  vector_math_2 = length(vector_math)
  return (
    Correction: normalize(vector_math)
      * ((vector_math_2 - Distance) * (W1 / (W1 + W2 + alpha / (deltaT * deltaT)))),
    Value: vector_math_2)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Inverse Mass"() -> (Exists: Bool, w: Float, mass: Float) {
  group = fallback_float(name: "mass", fallback: 1.0)
  string = "inverse_mass"
  return (
    Exists: NamedAttribute(name: string).exists,
    w: fallback_float(name: string, fallback: 1.0 / group),
    mass: group)
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Float"(
    Value: Float(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field") in -2147483647..
) -> (Value: Float(description: "The field evaluated at the offset `Index` value")) {
  return (Value: EvaluateAtIndex(value: Value, index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Offset Vector"(
    Vector: Vector(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true) = Position(),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field") in -2147483647..
) -> (Value: Vector(description: "The field evaluated at the offset `Index` value")) {
  return (
    Value: EvaluateAtIndex[FLOAT_VECTOR](
      value: Vector,
      index: offset_index(index: Index, offset: Offset)))
}

geometry(is_modifier: false) graph "XPBD Solve Curve"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Points: Int = 2 in 0..5,
    Straightness: Float(subtype: FACTOR) = 0.9 in 0.0..1.0,
    Length: Float,
    alpha: Float in 0.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> Geometry {
  group = inverse_mass()
  separate_components = SeparateComponents(Geometry)
  repeat_output = repeat(Points, Geometry: separate_components.curve) -> {
    iteration_2 = iteration
    integer_math = IntegerMath[ADD](Value: iteration_2, Value_001: 1)
    repeat_output_2 = repeat(2, Geometry: Geometry) -> {
      index_switch = IndexSwitch(iteration, integer_math, IntegerMath[NEGATE](value: integer_math))
      return SetPosition(
        Geometry,
        selection: nimply(
          Selection,
          IndexSwitch(
            iteration,
            EndpointSelection(start_size: 0, end_size: integer_math),
            EndpointSelection(start_size: integer_math, end_size: 0))),
        offset: constraint_distance(
          target: offset_vector(offset: index_switch),
          distance: Switch[FLOAT](
              switch: iteration_2 > 0,
              false_: integer_math,
              true_: integer_math * Mix(factor: Straightness, a: 0.5, b: 1.0))
            * Length,
          w1: group.w,
          w2: offset_float(value: group.w, offset: index_switch),
          alpha: alpha,
          deltat: deltaT).correction)
    }
    return repeat_output_2
  }
  return separate_components.mesh
    + repeat_output
    + separate_components.grease_pencil
    + separate_components.point_cloud
    + separate_components.volume
    + separate_components.instances
}
