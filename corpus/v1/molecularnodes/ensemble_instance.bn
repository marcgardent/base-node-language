geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph "Group Parameter"(
    "Group ID": Int(
      description: "The identifier specifying groupings of the points",
      hide_value: true)
) -> (
    "Is First": Bool(description: "If the point is the first point in the `Group ID`"),
    "Is Last": Bool(description: "If the point is the last item in the `Group ID`"),
    "Group Size": Int,
    "Relative Index": Int(
      description: "The relative index  of the point within the `Group ID`. Starts at `0` for the first point counting up to `Group Size - 1`")
) {
  accumulate_field = AccumulateField[INT](group_id: group_id)
  return (
    "Is First": not accumulate_field.trailing,
    "Is Last": accumulate_field.leading == accumulate_field.total,
    "Group Size": accumulate_field.total,
    "Relative Index": accumulate_field.trailing)
}

geometry graph "Separate First Point"(
    Geometry: Geometry(hide_value: true),
    Sort: Bool(
      description: "Sort by `Group ID` after separating",
      force_non_field: true,
      structure_type: SINGLE) = true,
    "Group ID": Int(hide_value: true)
) -> Geometry {
  "Separate the first point for each `Group ID` and return only those points. Optionally sort by the `Group ID` as well"
  separate_geometry = SeparateGeometry(
    Geometry,
    selection: group_parameter(group_id: group_id).is_first)
  return Sort
    ? SortElements(separate_geometry.selection, sort_weight: group_id)
    : separate_geometry.selection
}

geometry graph "Selected Instances"(
    Instances: Geometry(
      description: "Geometry containing instances to check if they are selected or not"),
    Selection: Bool(
      description: "The selection to apply to the bounding boxes of the Instances",
      hide_value: true)
) -> (
    "Entirely Selected": Bool(description: "All points of the instances bounding box are selected"),
    "Partially Selected": Bool(
      description: "Some points of the Instance's bounding box are selected"),
    "Not Selected": Bool(description: "No points of the Instance's bounding box are selected")
) {
  capture_attribute = Instances
    |> BoundingBox().bounding_box
    |> CaptureAttribute[INSTANCE](Index: Index())
  accumulate_field = AccumulateField[INT](value: Selection, group_id: capture_attribute.index)
  index = Index()
  capture_attribute_2 = capture_attribute.geometry
    |> RealizeInstances[realize_to_point_domain: true]()
    |> CaptureAttribute(
      "All Points Select": accumulate_field.total == 8,
      "Some Points Selected": accumulate_field.total < 8 and accumulate_field.total > 0,
      "No points selected": accumulate_field.total == 0)
  group = separate_first_point(
    capture_attribute_2.geometry,
    sort: false,
    group_id: capture_attribute.index)
  return (
    "Entirely Selected": SampleIndex[BOOLEAN](
      group,
      value: capture_attribute_2.all_points_select,
      index: index),
    "Partially Selected": SampleIndex[BOOLEAN](
      group,
      value: capture_attribute_2.some_points_selected,
      index: index),
    "Not Selected": SampleIndex[BOOLEAN](
      group,
      value: capture_attribute_2.no_points_selected,
      index: index))
}

geometry graph "Slice Edge Instances"(
    Instances: Geometry,
    Selection: Bool(hide_value: true) = true
) -> (Instances: Geometry, "Realized Points": Geometry) {
  group = selected_instances(Instances, selection: Selection)
  return (
    Instances: SeparateGeometry[INSTANCE](Instances, selection: group.entirely_selected).selection,
    "Realized Points": Instances
      |> SeparateGeometry[INSTANCE](selection: group.partially_selected).selection
      |> RealizeInstances[realize_to_point_domain: true]()
      |> SeparateGeometry(selection: Selection).selection)
}

geometry(is_modifier: false) graph "Ensemble Instance"(
    Points: Geometry,
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    "Selection Type": Menu(menu_expanded: true, optional_label: true) = Simple,
    Instances: Collection(optional_label: true),
    Fraction: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "As Points": Bool = true,
    "Point"(description: "Points") {
        "Point Radius": Float(subtype: DISTANCE) = 0.1 in 0.0..,
        "Point Material": Material(optional_label: true)
    }
) -> (Instances: Geometry) {
  menu_switch = MenuSwitch(menu: selection_type, Simple: 0, Precise: 1)
  boolean_math = Selection and RandomValue[BOOLEAN](probability: Fraction)
  "Simple Selection" {
    separate_geometry = IndexSwitch(
        menu_switch.output,
        SeparateGeometry(Points, selection: boolean_math).selection,
        Points)
      |> SeparateGeometry(selection: as_points)
    instance_on_points = InstanceOnPoints(
      separate_geometry.inverted,
      instance: CollectionInfo(collection: Instances, separate_children: true),
      pick_instance: true,
      instance_index: chain_id(),
      rotation: NamedAttribute[FLOAT4X4](name: "transform").attribute)
    set_material = separate_geometry.selection
      |> MeshToPoints(radius: point_radius)
      |> SetMaterial(material: point_material)
    join_geometry = set_material + instance_on_points
  }
  "Precise Selection" {
    group = slice_edge_instances(instance_on_points, selection: Selection)
    join_geometry_2 = group.instances
      + SetMaterial(group.realized_points + set_material, material: point_material)
  }
  return (Instances: IndexSwitch(menu_switch.output, join_geometry, join_geometry_2))
}
