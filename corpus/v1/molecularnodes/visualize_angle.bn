geometry(is_modifier: false) graph "Visualize Angle"(
    Points: Geometry,
    Selection: Bool(hide_value: true) = true,
    Position: Vector(hide_value: true) = Position(),
    Angle: Float = 0.5 in -10000.0..10000.0,
    Length: Float = 0.005 in -10000.0..10000.0,
    Up: Vector in -10000.0..10000.0,
    Axis: Vector = (0.0, 0.0, 1.0),
    Radius: Float(subtype: DISTANCE) = 0.2 in 0.0..
) -> (Mesh: Geometry, Curve: Geometry) {
  named_attribute = NamedAttribute(name: "radius")
  capture_attribute = Points
    |> InstanceOnPoints(
      selection: Selection,
      instance: CurveLine(end: (0.0, 0.0, 0.0)) |> ResampleCurve())
    |> RealizeInstances[realize_to_point_domain: true]()
    |> StoreNamedAttribute(name: "angle", value: -(Angle * SplineParameter().factor))
    |> CaptureAttribute(
      Vector: RotateVector(
        vector: normalize(Up) * Length,
        rotation: AxisAngleToRotation(axis: Axis, angle: NamedAttribute(name: "angle").attribute)))
  set_curve_radius = capture_attribute.geometry
    |> SetCurveNormal(mode: Free, normal: capture_attribute.vector)
    |> SetPosition(position: Position, offset: capture_attribute.vector)
    |> SetCurveRadius(radius: Radius)
  return (
    Mesh: CurveToMesh(
      set_curve_radius,
      profile_curve: CurveCircle(resolution: 6, radius: 0.01),
      scale: named_attribute.exists ? named_attribute.attribute : 1.0,
      fill_caps: true),
    Curve: set_curve_radius)
}
