geometry graph "Edge Info"(
    "Vertex Index": Int(hide_value: true) = Index(),
    "Edge Index": Int(
      description: "Index within the gorup of edges that are connected to this point") in 0..3
) -> (
    "Is Valid": Bool(description: "Whether there is a valid edge corresponding to the given index"),
    "Point Index": Int(
      description: "The index for the other point involved in this edge, -1 if not connected"),
    "Point Position": Vector(
      description: "The position for the other point involved in this edge, (0, 0, 0) if not connected"),
    "Edge Index": Int(
      description: "The index on the edge domain for the selected edge. -1 if not connected"),
    "Edge Vector": Vector(
      subtype: EULER,
      description: "The vector along the selected edge. (0, 0, 0) if not connected"),
    "Edge Length": Float(description: "Length of the selected edge, -1 if not connected")
) {
  edge_vertices = EdgeVertices()
  edges_of_vertex = EdgesOfVertex(vertex_index: vertex_index, sort_index: edge_index)
  "Check edge exists, or return index -1 and (0, 0, 0) vector" {
    compare = edge_index < edges_of_vertex.total
  }
  math = EvaluateAtIndex[EDGE, INT](
      value: edge_vertices.vertex_index_1 + edge_vertices.vertex_index_2,
      index: edges_of_vertex.edge_index)
    - Index()
  position = Position()
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](value: position, index: math)
  vector_math = evaluate_at_index - position
  return (
    "Is Valid": compare,
    "Point Index": Switch[INT](switch: compare, false_: -1, true_: math),
    "Point Position": evaluate_at_index,
    "Edge Index": compare ? edges_of_vertex.edge_index : -1,
    "Edge Vector": compare ? vector_math : (0.0, 0.0, 0.0),
    "Edge Length": compare ? length(vector_math) : -1.0)
}

geometry graph "Vector Angle"(
    A: Vector(description: "The first vector for angle calculation") in -10000.0..10000.0,
    B: Vector(description: "The second vector for the angle calculation") in -10000.0..10000.0
) -> (
    Angle: Float(subtype: ANGLE, description: "The angle between the two vectors in radians"),
    "A×B": Vector(description: "Axis around which the angle rotates (cross product of A and B)")
) {
  "The angle between two vectors, in radians"
  vector_math = normalize(A)
  vector_math_2 = normalize(B)
  return (Angle: acos(vector_math ⋅ vector_math_2), "A×B": vector_math × vector_math_2)
}

geometry graph "Point Edge Angle"(
    "Vertex Index": Int(
      description: "The index of the point at which to evaluate this node",
      hide_value: true) = Index(),
    "Edge A": Int(description: "The index of the edges of this point to select") in 0..3,
    "Edge B": Int(description: "The index of the edges of this point to select") = 1 in 0..3
) -> (
    "Is Valid": Bool(description: "Both of the selected edges are valid"),
    Angle: Float(
      description: "Angle between the two selected edges in radians. Returns 0 if not valid"),
    "Edge Index A": Int(
      description: "Index for 'Edge A' in the Edge domain of the geometry. Returns -1 if not valid"),
    "Edge Index B": Int(
      description: "Index for 'Edge B' in the Edge domain of the geometry. Returns -1 if not valid"),
    "Edge Vector A": Vector(
      description: "Vector from the current point to the other point in Edge A. Returns (0, 0, 0) if not valid."),
    "Edge Vector B": Vector(
      description: "Vector from the current point to the other point in Edge B. Returns (0, 0, 0) if not valid.")
) {
  group = edge_info(vertex_index: vertex_index, edge_index: edge_a)
  group_2 = edge_info(vertex_index: vertex_index, edge_index: edge_b)
  boolean_math = edge_a != edge_b and (group.is_valid and group_2.is_valid)
  return (
    "Is Valid": boolean_math,
    Angle: boolean_math ? vector_angle(a: group.edge_vector, b: group_2.edge_vector).angle : 0.0,
    "Edge Index A": group.edge_index,
    "Edge Index B": group_2.edge_index,
    "Edge Vector A": group.edge_vector,
    "Edge Vector B": group_2.edge_vector)
}
