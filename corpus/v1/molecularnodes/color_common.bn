geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atomic Number"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atomic_number: Int(
      description: "Read the `atomic_number` attribute from the geometry corresponding to elements")
) {
  return (atomic_number: attribute_at_index(index: Index, name: "atomic_number"))
}

geometry graph "Between Integer"(
    Value: Int(description: "The value to test if it exists within the bounds"),
    Lower: Int(description: "The lower bounds for the test"),
    Upper: Int(description: "The upper bounds for the test") = 19
) -> (
    Boolean: Bool(
      description: "Whether the input `Value` is between (and including) the lower and upper bounds")
) {
  return (Boolean: Value >= Lower and Value <= Upper)
}

geometry graph Color(
    Index: Int = Index() in 0..
) -> (Color: Color(description: "Read the `Color` attribute from the geometry")) {
  return (
    Color: EvaluateAtIndex[FLOAT_COLOR](
      value: NamedAttribute[FLOAT_COLOR](name: "Color").attribute,
      index: Index))
}

geometry graph "Color Common"(
    Hydrogen: Color(description: "Color to set for the element Hydrogen") = (1.0, 1.0, 1.0),
    Carbon: Color(
      description: "Color to set for the element Carbon") = (0.20190106, 0.20190106, 0.20190106),
    Nitrogen: Color(description: "Color to set for the element Nitrogen") = (0.16, 0.23333497, 0.8),
    Oxygen: Color(description: "Color to set for the element Oxygen") = (0.8, 0.1610207, 0.16),
    Phosphorous: Color(
      description: "Color to set for the element Phosphorous") = (0.8, 0.17181273, 0.5252497),
    Sulfur: Color(description: "Color to set for the element Sulfur") = (0.8, 0.722058, 0.05199071)
) -> (Color: Color(description: "The output colors for the common elements")) {
  group = atomic_number()
  group_2 = Color()
  return (
    Color: between_integer(value: group, upper: 16)
      ? IndexSwitch(
        group,
        group_2,
        Hydrogen,
        group_2,
        group_2,
        group_2,
        group_2,
        Carbon,
        Nitrogen,
        Oxygen,
        group_2,
        group_2,
        group_2,
        group_2,
        group_2,
        group_2,
        Phosphorous,
        Sulfur)
      : group_2)
}
