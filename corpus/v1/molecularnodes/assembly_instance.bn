geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Assembly ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (assembly_id: Int(description: "Read the `frame_id` attribute from the geometry")) {
  "Read the `frame_id` attribute, created when multiple frames from a trajectory are merged into a single structure"
  return (assembly_id: attribute_at_index(index: Index, name: "assembly_id"))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph Centroid(
    Position: Vector(
      description: "The `Position` vector to use for the centroid calculation",
      hide_value: true) = Position(),
    Selection: Bool(
      description: "Selected points contribute to the computation of the centroid, unselected points do not contribute but still return the centroid for their `Group ID`",
      hide_value: true) = true,
    "Group ID": Int(
      description: "Compute the centroid on for each unique `Group ID`",
      hide_value: true)
) -> (Centroid: Vector(description: "The computed average vector for each `Group ID`")) {
  return (
    Centroid: AccumulateField[FLOAT_VECTOR](
        value: Selection ? Position : (0.0, 0.0, 0.0),
        group_id: group_id).total
      / AccumulateField[INT](value: Selection, group_id: group_id).total)
}

geometry graph "Group Parameter"(
    "Group ID": Int(
      description: "The identifier specifying groupings of the points",
      hide_value: true)
) -> (
    "Is First": Bool(description: "If the point is the first point in the `Group ID`"),
    "Is Last": Bool(description: "If the point is the last item in the `Group ID`"),
    "Group Size": Int,
    "Relative Index": Int(
      description: "The relative index  of the point within the `Group ID`. Starts at `0` for the first point counting up to `Group Size - 1`")
) {
  accumulate_field = AccumulateField[INT](group_id: group_id)
  return (
    "Is First": not accumulate_field.trailing,
    "Is Last": accumulate_field.leading == accumulate_field.total,
    "Group Size": accumulate_field.total,
    "Relative Index": accumulate_field.trailing)
}

geometry graph "Separate First Point"(
    Geometry: Geometry(hide_value: true),
    Sort: Bool(
      description: "Sort by `Group ID` after separating",
      force_non_field: true,
      structure_type: SINGLE) = true,
    "Group ID": Int(hide_value: true)
) -> Geometry {
  "Separate the first point for each `Group ID` and return only those points. Optionally sort by the `Group ID` as well"
  separate_geometry = SeparateGeometry(
    Geometry,
    selection: group_parameter(group_id: group_id).is_first)
  return Sort
    ? SortElements(separate_geometry.selection, sort_weight: group_id)
    : separate_geometry.selection
}

geometry graph "Split to Centred Instances"(
    Geometry: Geometry(description: "The input geometry containing points", hide_value: true),
    Selection: Bool(
      description: "Selected points will be used to calculate centre point for Instance",
      hide_value: true) = true,
    "Group ID": Int(
      description: "The `Group ID` which will determine how the points are split into their different instances",
      hide_value: true)
) -> (Instances: Geometry(description: "The points that have been split into their instances")) {
  Centroid = Centroid(selection: Selection, group_id: group_id)
  capture_attribute = CaptureAttribute(Geometry, Centroid: Centroid)
  "Get first point in each group, to be sampled by instance" {
    sample_index = capture_attribute.geometry
      |> separate_first_point(group_id: group_id)
      |> SampleIndex[FLOAT_VECTOR](value: capture_attribute.centroid, index: Index())
  }
  "Centres each group on world origin" {
    set_position = SetPosition(capture_attribute.geometry, offset: -capture_attribute.centroid)
  }
  "Split to Instances and return to original positon" {
    set_position_2 = set_position
      |> SplitToInstances(group_id: group_id).instances
      |> SetPosition(offset: sample_index)
  }
  return (Instances: set_position_2)
}

geometry graph "Symmetry ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (sym_id: Int(description: "Read the `frame_id` attribute from the geometry")) {
  "Read the `frame_id` attribute, created when multiple frames from a trajectory are merged into a single structure"
  return (sym_id: attribute_at_index(index: Index, name: "sym_id"))
}

geometry(is_modifier: false) graph "Assembly Instance"(
    Geometry: Geometry(description: "Geometry that is instanced on the points"),
    Selection: Bool(hide_value: true) = true,
    "Data Object": Object(optional_label: true),
    "Assembly ID": Int = 1 in 1..,
    "Realize All": Bool(
      description: "Realize all levels of nested instances for a top-level instances. Overrides the value of the Depth input"),
    "Scale Transform"(default_closed: true) {
        Position: Float(
          subtype: FACTOR,
          description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
        Rotation: Float(
          subtype: FACTOR,
          description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0
    }
) -> (Instances: Geometry, chain_id: Int) {
  "Select required assemblies" {
    separate_geometry = ObjectInfo(object: data_object).geometry
      |> SeparateGeometry(selection: assembly_id == assembly_id() and Selection)
  }
  {
    group = chain_id()
    group_2 = split_to_centred_instances(Geometry, group_id: group)
  }
  "Mix Transform values" {
    separate_transform = SeparateTransform(
      transform: NamedAttribute[FLOAT4X4](name: "transform").attribute)
    mix = Mix[ROTATION](factor: Rotation, b: separate_transform.rotation)
    mix_2 = Mix[VECTOR](factor: Position, b: separate_transform.translation)
  }
  capture_attribute = CaptureAttribute(
    separate_geometry.selection,
    Position: mix_2,
    Rotation: mix,
    sym_id: symmetry_id())
  capture_attribute_2 = capture_attribute.geometry
    |> SetPosition(position: capture_attribute.position)
    |> InstanceOnPoints(
      instance: group_2,
      pick_instance: true,
      instance_index: group,
      rotation: capture_attribute.rotation)
    |> CaptureAttribute[INSTANCE](new_chain_id: Index())
  return (
    Instances: capture_attribute_2.geometry
      |> RealizeInstances(realize_all: realize_all)
      |> StoreNamedAttribute[INT](name: "sym_id", value: capture_attribute.sym_id),
    chain_id: capture_attribute_2.new_chain_id)
}
