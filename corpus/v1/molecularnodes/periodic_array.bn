geometry graph "Lattice Grid"(
    A: Vector(subtype: XYZ) = (0.0, 0.0, 1.0),
    B: Vector(subtype: XYZ) = (0.0, 0.0, 1.0),
    C: Vector(subtype: XYZ) = (0.0, 0.0, 1.0),
    "Count" {
        X: Int(description: "Number of images along the a vector") = 3 in 1..10000,
        Y: Int(description: "Number of images along the b vector") = 3 in 1..10000,
        Z: Int(description: "Number of images along the c vector") = 3 in 1..10000
    }
) -> (Grid: Geometry) {
  return (
    Grid: MeshLine(count: X, offset: A)
      |> InstanceOnPoints(instance: MeshLine(count: Y, offset: B))
      |> InstanceOnPoints(instance: MeshLine(count: Z, offset: C))
      |> RealizeInstances[realize_to_point_domain: true]())
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Unit Convert"(
    "Distance Type": Menu(
      description: "What unit to scale the value to",
      optional_label: true) = Angstrom,
    From: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (
    World: Float(description: "The value that has been scaled appropriately for the world space")
) {
  math = From * mn_world_scale()
  math_2 = math * 10.0
  return (
    World: MenuSwitch(
      menu: distance_type,
      Angstrom: math,
      Nanometre: math_2,
      Micrometre: math_2 * 1000.0).output)
}

geometry graph "Angstrom to World"(Angstrom: Float = 3.0 in -10000.0..10000.0) -> (World: Float) {
  return (World: unit_convert(from: Angstrom))
}

geometry graph "Periodic Box"(
    Update: Bool(
      description: "Update the box lengths and angles with the simulation. This does not change anything directly inside of the node tree, but the mda.Universe that updates the positions will also update this node.",
      default_attribute_name: "True") = true,
    "Lengths" {
        a: Float,
        b: Float,
        c: Float
    },
    "Angles" {
        alpha: Float,
        beta: Float,
        gamma: Float
    }
) -> (A: Vector, B: Vector, C: Vector) {
  "A Vector" {
    combine_xyz = CombineXYZ(x: angstrom_to_world(angstrom: a))
  }
  "Angles To Radians" {
    math = radians(alpha)
    math_2 = radians(beta)
    math_3 = radians(gamma)
  }
  "Trig Ops" {
    math_4 = cos(math)
    math_5 = cos(math_2)
    math_6 = cos(math_3)
    math_7 = sin(math_3)
  }
  "B Vector" {
    group = angstrom_to_world(angstrom: b)
    "B Y Component" {
      math_8 = group * math_7
    }
    "B X Component" {
      math_9 = group * math_6
    }
    combine_xyz_2 = CombineXYZ(x: math_9, y: math_8)
  }
  "C Vector" {
    group_2 = angstrom_to_world(angstrom: c)
    "C X Component" {
      math_10 = group_2 * math_5
    }
    "C Y Component" {
      math_11 = group_2 * ((math_4 - math_5 * math_6) / math_7)
    }
    "C Z Component" {
      math_12 = sqrt(pow(group_2, 2.0) - pow(math_10, 2.0) - pow(math_11, 2.0))
    }
    combine_xyz_3 = CombineXYZ(x: math_10, y: math_11, z: math_12)
  }
  return (A: combine_xyz, B: combine_xyz_2, C: combine_xyz_3)
}

geometry(is_modifier: false) graph "Periodic Array"(
    Geometry: Geometry,
    "Periodic Box"(default_closed: true) {
        Update: Bool(
          description: "Update the box lengths and angles with the simulation",
          default_attribute_name: "True") = true,
        "Lengths" {
            a: Float,
            b: Float,
            c: Float
        },
        "Angles" {
            alpha: Float,
            beta: Float,
            gamma: Float
        }
    },
    "Count" {
        X: Int(description: "Number of images along the a vector") = 3 in 1..10000,
        Y: Int(description: "Number of images along the b vector") = 3 in 1..10000,
        Z: Int(description: "Number of images along the c vector") = 3 in 1..10000
    }
) -> (Instances: Geometry) {
  group = periodic_box(update: Update, a: a, b: b, c: c, alpha: alpha, beta: beta, gamma: gamma)
  return (
    Instances: lattice_grid(a: group.a, b: group.b, c: group.c, x: X, y: Y, z: Z)
      |> InstanceOnPoints(instance: Geometry))
}
