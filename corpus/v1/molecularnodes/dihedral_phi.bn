geometry graph "Find Bonded Atom"(
    Index: Int = Index() in 0..,
    Method: Menu(optional_label: true) = Exact,
    "Atom Name": Menu(optional_label: true) = N,
    Distance: Int = 2 in 1..3
) -> ("Is Valid": Bool, Index: Int, Position: Vector) {
  group = find_connected(
    value: atom_name(),
    match: menu_atom_name(atom_name: atom_name).atom_name,
    distance: Distance,
    method: Method)
  evaluate_at_index = EvaluateAtIndex[INT](value: group.index, index: Index)
  return (
    "Is Valid": group.is_valid,
    Index: evaluate_at_index,
    Position: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: evaluate_at_index))
}

geometry graph "Menu Residue Mask"(
    "Atom Name": Menu(optional_label: true) = N
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(
    pick: menu_atom_name(atom_name: atom_name).selection,
    group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph "Dihedral Phi"(
    Menu: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (
    Phi: Float(
      subtype: ANGLE,
      description: "The calculated `Phi` angle for the residue, in the range of `(-pi, pi)`"),
    Up: Vector(description: "The perpendicular vector from the line of BC to the point A"),
    Axis: Vector(
      description: "The vector BC corresponding to the backbone vector around which the angle is calculated")
) {
  menu_switch = MenuSwitch(menu: Menu, Read: 0, Compute: 1)
  group = dihedral_angle(
    a: backbone_c(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    b: backbone_ca(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    c: backbone_n(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    d: find_bonded_atom(index: menu_residue_mask().index, atom_name: C, distance: 1).position)
  return (
    Phi: -(chain_parameter().residue_index
      ? ca_value_float(value: fallback_float(name: "Phi", fallback: group.angle))
      : 0.0),
    Up: ca_value_vector(vector: group.ba_bc),
    Axis: ca_value_vector(vector: group.bc))
}
