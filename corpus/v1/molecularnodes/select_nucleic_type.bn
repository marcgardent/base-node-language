        false,
        false,
        false,
        boolean,
        false,
        boolean,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        boolean,
        false,
        boolean,
        false)).boolean,
    is_pyrimidine: boolean_andor(
      and_: And,
      or_: Or,
      boolean: IndexSwitch(
        group,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
