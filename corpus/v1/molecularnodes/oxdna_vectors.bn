geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Unit Convert"(
    "Distance Type": Menu(
      description: "What unit to scale the value to",
      optional_label: true) = Angstrom,
    From: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (
    World: Float(description: "The value that has been scaled appropriately for the world space")
) {
  math = From * mn_world_scale()
  math_2 = math * 10.0
  return (
    World: MenuSwitch(
      menu: distance_type,
      Angstrom: math,
      Nanometre: math_2,
      Micrometre: math_2 * 1000.0).output)
}

geometry graph "Angstrom to World"(Angstrom: Float = 3.0 in -10000.0..10000.0) -> (World: Float) {
  return (World: unit_convert(from: Angstrom))
}

geometry graph "oxDNA Vectors"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    base_vector: Vector,
    base_normal: Vector,
    "Backbone Offset": Vector,
    "Base Offset": Vector,
    Rotation: Rotation
) {
  group = angstrom_to_world(angstrom: 3.4)
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_vector").attribute,
    index: Index)
  evaluate_at_index_2 = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_normal").attribute,
    index: Index)
  return (
    base_vector: evaluate_at_index,
    base_normal: evaluate_at_index_2,
    "Backbone Offset": evaluate_at_index * -group
      + (evaluate_at_index × evaluate_at_index_2) * group,
    "Base Offset": evaluate_at_index * group,
    Rotation: AxesToRotation(primary_axis: evaluate_at_index, secondary_axis: evaluate_at_index_2))
}
