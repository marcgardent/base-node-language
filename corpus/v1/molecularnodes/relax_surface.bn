geometry graph ".MN_surface_smooth_bumps"(Geometry: Geometry) -> Geometry {
  "Smoothen out weird bumps from meshing" {
    edge_vertices = EdgeVertices()
    compare = VertexNeighbors().vertex_count == 3
    face_group_boundaries = FaceGroupBoundaries(
      face_group_id: EdgesToFaceGroups(
        boundary_edges: EvaluateAtIndex[BOOLEAN](
            value: compare,
            index: edge_vertices.vertex_index_1)
          and EvaluateAtIndex[BOOLEAN](value: compare, index: edge_vertices.vertex_index_2)))
  }
  return SetPosition(
    Geometry,
    selection: face_group_boundaries,
    position: BlurAttribute[FLOAT_VECTOR](value: Position(), iterations: 4))
}

geometry graph "Edge Length"() -> (Length: Float) {
  edge_vertices = EdgeVertices()
  return (
    Length: EvaluateOnDomain[EDGE](
      value: distance(edge_vertices.position_1, edge_vertices.position_2)))
}

geometry graph "MN Typed Bundles"(
    Type: Menu(optional_label: true) = "MN.MeshProcess",
    Closure: Closure,
    step: Int = 1,
    Path: String(optional_label: true)
) -> Bundle {
  return StoreBundleItem[BUNDLE](
    path: Path,
    item: CombineBundle(
      Type: MenuSwitch(menu: Type, "MN.MeshProcess": "MN.MeshProcess").output,
      closure: Closure,
      step: step))
}

geometry graph ".Relax Surface"("Relaxation Steps": Int = 30 in 0.., step: Int = 3) -> Bundle {
  closure_output = graph(Geometry: Geometry) -> Geometry {
    return Geometry
      |> SetPosition(
        position: BlurAttribute[FLOAT_VECTOR](
          value: Position(),
          iterations: relaxation_steps,
          weight: BlurAttribute(
            value: MapRange(
              value: EdgeAngle().signed_angle,
              from_min: -0.2,
              from_max: 0.3,
              to_min: 1.0,
              to_max: 0.0))))
      |> mn_surface_smooth_bumps()
  }
  group = edge_length()
  field_min_and_max = FieldMinAndMax(value: group)
  map_range = MapRange(
    value: group,
    from_min: field_min_and_max.min,
    from_max: field_min_and_max.max)
  return mn_typed_bundles(closure: closure_output, step: step, path: "Relax Surface")
}
