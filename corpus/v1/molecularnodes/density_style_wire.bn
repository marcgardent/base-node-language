geometry(is_modifier: false) graph "Density Style Wire"(
    Volume: Geometry,
    Threshold: Float = 0.8,
    "Hide Dust": Float = 20.0 in -10000.0..10000.0,
    "Wire" {
        "Wire Radius": Float(
          description: "Radius of the created wire (in relative nm)") = 1.0 in 0.0..,
        "Wire Resolution": Int = 3 in 3..32
    },
    "Material" {
        Color: Color = (0.10174983, 0.3931146, 0.10474136),
        Material: Material(description: "Material to apply to the resulting geometry")
    }
) -> (Geometry: Geometry(description: "The generated geometry for the style node group")) {
  named_attribute = NamedAttribute(name: "radius")
  return (
    Geometry: Volume
      |> VolumeToMesh(threshold: Threshold)
      |> DeleteGeometry(
        selection: AccumulateField(value: FaceArea(), group_id: MeshIsland().island_index).total
          < hide_dust)
      |> StoreNamedAttribute[FLOAT_COLOR](name: "Color", value: Color)
      |> MeshToCurve()
      |> CurveToMesh(
        profile_curve: CurveCircle(resolution: wire_resolution, radius: wire_radius / 1000.0),
        scale: named_attribute.exists ? named_attribute.attribute : 1.0,
        fill_caps: true)
      |> SetMaterial(material: Material))
}
