geometry graph ".Sample Atomic Attributes"(
    Atoms: Geometry,
    "Sample Atoms": Geometry,
    Index: Int = Index()
) -> (Atoms: Geometry) {
  return (
    Atoms: TransferAttributes(
      Atoms,
      source: sample_atoms,
      source_point_id: Index,
      attribute_names: FieldToList(String: "bond_type"),
      exclude_names: true).target)
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Integer"(
    Integer: Int(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field")
) -> (Integer: Int(description: "The field evaluated at the offset `Index` value")) {
  return (
    Integer: EvaluateAtIndex[INT](
      value: Integer,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Integer Run"(
    Value: Int(description: "The field to check for changes in value", hide_value: true),
    "Group ID": Int(
      description: "Does not restart counting for each Group ID, but does increment by 1 when the Group ID changes",
      hide_value: true)
) -> (
    "Is Different": Bool(description: "The current value is different from the previous"),
    "Group ID": Int(
      description: "The new `Group ID`, which increases by 1 whenever the `Value` or `Group ID` values change")
) {
  "A unique value for each grouping of a value. Accumulating along the field, the output Group Mask increments by 1 whenever the value or Group ID changes"
  boolean_math = offset_integer(integer: Value, offset: -1) != Value
    or group_id != offset_integer(integer: group_id, offset: -1)
  return (
    "Is Different": boolean_math,
    "Group ID": AccumulateField[INT](value: boolean_math).leading)
}

geometry graph "Residue ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_id: Int(description: "Read the `res_id` attribute from the geometry")) {
  return (res_id: attribute_at_index(index: Index))
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph ".MN_ensure_ures_id"(Input: Geometry) -> (Output: Geometry) {
  "If the `ures_id` attribute doesn't exist, create it"
  "Check if `ures_id` exists" {
    get_attribute_names = GetAttributeNames(
      Input,
      filter_data_type: true,
      data_type: Integer,
      filter_domain: true)
    list_length = ListLength[STRING](
      list: FilterList[STRING](
        list: get_attribute_names,
        selection: get_attribute_names == "ures_id").selection)
  }
  return (Output: list_length ? Input : set_ures_id(Input))
}

geometry graph "Contains Geometry"(
    Geometry: Geometry
) -> (
    "Not Empty": Bool(description: "True when the input contains some geometry"),
    Empty: Bool(description: "True when the input contains no geometry")
) {
  boolean_math = DomainSize(Geometry).point_count == 0
    and DomainSize[POINTCLOUD](Geometry) == 0
    and DomainSize[CURVE](Geometry).point_count == 0
    and DomainSize[INSTANCES](Geometry) == 0
    and DomainSize[GREASEPENCIL](Geometry) == 0
  return ("Not Empty": not boolean_math, Empty: boolean_math)
}

geometry graph "Check Geometry"(
    Geometry: Geometry,
    Message: String(
      optional_label: true) = "Input contains no geometry, check your node connections."
) -> Geometry {
  warning = Warning(show: contains_geometry(Geometry).empty, message: Message)
  return Geometry
}

geometry graph "Get Geometry Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> (Geometry: Geometry, Bundle: Bundle, Atoms: Geometry) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  string = "MN/Atoms"
  get_bundle_item = GetBundleItem[GEOMETRY](
    bundle: get_geometry_bundle.bundle,
    path: string,
    remove: true)
  return (
    Geometry: Switch[GEOMETRY](switch: get_bundle_item.exists, true_: get_geometry_bundle.geometry),
    Bundle: get_bundle_item.bundle,
    Atoms: get_bundle_item.exists ? get_bundle_item.item : get_geometry_bundle.geometry)
}

geometry graph "Evaluate on Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Closure: Closure,
    Result: Menu(
      description: "Where to store the result of the closure. Bundle overwrite the existing `MN/Atoms` bundle. Geometry passes along the bundle and joins the resulting geometry into the output.",
      menu_expanded: true,
      optional_label: true) = Geometry
) -> Geometry {
  group = get_geometry_atoms(Geometry)
  "Evaluate the closure on the 'Atoms'" {
    evaluate_closure = EvaluateClosure(
      Closure,
      Atoms: group.atoms
        |> check_geometry(message: "'Atoms' contains no geometry, check your node connections.")
        |> mn_ensure_ures_id()
        |> SeparateGeometry(selection: Selection).selection) -> Geometry
  }
  menu_switch = MenuSwitch(menu: Result, Geometry: 0, Bundle: 1)
  string = "Evaluate the 'Closure' on the 'Atoms' geometry, join the resulting geometry with the input geometry.\n\nIf the input 'Geometry' doesn't contain a 'MN/Atoms' bundle then we treat the input geometry as the 'Atoms'."
  return SetGeometryBundle(
    group.geometry + IndexSwitch(menu_switch.output, evaluate_closure, _),
    bundle: StoreBundleItem[GEOMETRY](
      bundle: group.bundle,
      path: "MN/Atoms",
      item: IndexSwitch(menu_switch.output, group.atoms, evaluate_closure)))
}

geometry graph "Sample Position"(
    Geometry: Geometry(description: "The geometry to sample the `Position` from"),
    Position: Vector(
      description: "The `Position` field to sample the values from",
      hide_value: true) = Position(),
    Index: Int(description: "The `Index` at which to sample the `Position` field from") = Index()
) -> (Position: Vector(description: "The sampled `Position` field")) {
  "A convenience wrapper around the `Sample Index` and `Position` nodes"
  return (Position: SampleIndex[FLOAT_VECTOR, clamp: true](Geometry, value: Position, index: Index))
}

geometry graph Plexus(
    Points: Geometry,
    Sort: Bool(
      description: "Sort the resulting points so their `Index` matches the input geometry") = true,
    Distance: Float(subtype: DISTANCE) = 0.5 in -10000.0..10000.0,
    Radius: Float = 1.0
) -> Geometry {
  "Create a clean set of points for instancing on" {
    index = Index()
    points = Points(
      count: DomainSize(Points).point_count,
      position: SampleIndex[FLOAT_VECTOR](Points, value: Position(), index: index),
      radius: SampleIndex(Points, value: Distance, index: index)
        * SampleIndex(Points, value: Radius, index: index))
  }
  "Create Distance Probe" {
    ico_sphere = IcoSphere()
    merge_by_distance = ico_sphere.mesh
      |> InstanceOnPoints(
        instance: MeshLine(count: 2),
        rotation: AxesToRotation(
          primary_axis: SampleIndex[FLOAT_VECTOR](
            ico_sphere.mesh,
            value: -Position(),
            index: Index())))
      |> RealizeInstances[realize_to_point_domain: true]()
      |> MergeByDistance()
  }
  "Apply the distance probe" {
    capture_attribute = points
      |> InstanceOnPoints(instance: merge_by_distance, scale: Radius())
      |> RealizeInstances[realize_to_point_domain: true]()
      |> CaptureAttribute(Index: SampleNearest(points))
    merge_points = capture_attribute.geometry
      |> SetPosition(position: sample_position(points, index: capture_attribute.index))
      |> MergePoints(merge_id: capture_attribute.index)
  }
  "Potentially sort the results into same order" {
    switch = Sort ? SortElements(merge_points, sort_weight: SampleNearest(Points)) : merge_points
  }
  return switch
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "VDW Radii"(
    Index: Int = Index() in 0..
) -> (vdw_radii: Float(description: "Read the `vdw_radii` attribute from the geometry")) {
  return (
    vdw_radii: EvaluateAtIndex(
      value: fallback_float(name: "vdw_radii", fallback: mn_world_scale()),
      index: Index))
}

geometry(is_modifier: false) graph "Find Bonds"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Scale: Float(
      description: "Scale the VDW radii of the atoms when searching for bonds") = 1.0 in 0.0..10000.0
) -> (Atoms: Geometry) {
  closure_output = graph(Atoms: Geometry) -> Geometry {
    separate_geometry = SeparateGeometry(Atoms, selection: Selection)
    Plexus = Plexus(separate_geometry.selection, distance: Scale, radius: vdw_radii() * 0.58)
    return sample_atomic_attributes(Plexus, sample_atoms: separate_geometry.selection)
  }
  return (Atoms: evaluate_on_atoms(Atoms, closure: closure_output))
}
