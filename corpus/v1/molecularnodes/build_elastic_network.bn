geometry graph ".Sample Atomic Attributes"(
    Atoms: Geometry,
    "Sample Atoms": Geometry,
    Index: Int = Index()
) -> (Atoms: Geometry) {
  return (
    Atoms: TransferAttributes(
      Atoms,
      source: sample_atoms,
      source_point_id: Index,
      attribute_names: FieldToList(String: "bond_type"),
      exclude_names: true).target)
}

geometry graph ".MN_constants_atom_name_peptide"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Alpha Carbon": Int
) {
  integer = 5
  integer_2 = 49
  integer_3 = 4
  integer_4 = 1
  integer_5 = 2
  return (
    "Backbone Lower": integer_4,
    "Backbone Upper": integer_3,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Alpha Carbon": integer_5)
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph ".MN_select_peptide"() -> (
    "Is Backbone": Bool,
    "Is Side Chain": Bool,
    "Is Peptide": Bool,
    "Is Alpha Carbon": Bool
) {
  group = mn_constants_atom_name_peptide()
  group_2 = atom_name()
  compare = group_2 == group.alpha_carbon
  return (
    "Is Backbone": group_2 >= group.backbone_lower and group_2 <= group.backbone_upper,
    "Is Side Chain": group_2 >= group.side_chain_lower and group_2 <= group.side_chain_upper
      or compare,
    "Is Peptide": group_2 >= group.backbone_lower and group_2 <= group.side_chain_upper,
    "Is Alpha Carbon": compare)
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Alpha Carbon"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(
      name: "is_alpha_carbon",
      fallback: mn_select_peptide().is_alpha_carbon))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Sample Position"(
    Geometry: Geometry(description: "The geometry to sample the `Position` from"),
    Position: Vector(
      description: "The `Position` field to sample the values from",
      hide_value: true) = Position(),
    Index: Int(description: "The `Index` at which to sample the `Position` field from") = Index()
) -> (Position: Vector(description: "The sampled `Position` field")) {
  "A convenience wrapper around the `Sample Index` and `Position` nodes"
  return (Position: SampleIndex[FLOAT_VECTOR, clamp: true](Geometry, value: Position, index: Index))
}

geometry graph Plexus(
    Points: Geometry,
    Sort: Bool(
      description: "Sort the resulting points so their `Index` matches the input geometry") = true,
    Distance: Float(subtype: DISTANCE) = 0.5 in -10000.0..10000.0,
    Radius: Float = 1.0
) -> Geometry {
  "Create a clean set of points for instancing on" {
    index = Index()
    points = Points(
      count: DomainSize(Points).point_count,
      position: SampleIndex[FLOAT_VECTOR](Points, value: Position(), index: index),
      radius: SampleIndex(Points, value: Distance, index: index)
        * SampleIndex(Points, value: Radius, index: index))
  }
  "Create Distance Probe" {
    ico_sphere = IcoSphere()
    merge_by_distance = ico_sphere.mesh
      |> InstanceOnPoints(
        instance: MeshLine(count: 2),
        rotation: AxesToRotation(
          primary_axis: SampleIndex[FLOAT_VECTOR](
            ico_sphere.mesh,
            value: -Position(),
            index: Index())))
      |> RealizeInstances[realize_to_point_domain: true]()
      |> MergeByDistance()
  }
  "Apply the distance probe" {
    capture_attribute = points
      |> InstanceOnPoints(instance: merge_by_distance, scale: Radius())
      |> RealizeInstances[realize_to_point_domain: true]()
      |> CaptureAttribute(Index: SampleNearest(points))
    merge_points = capture_attribute.geometry
      |> SetPosition(position: sample_position(points, index: capture_attribute.index))
      |> MergePoints(merge_id: capture_attribute.index)
  }
  "Potentially sort the results into same order" {
    switch = Sort ? SortElements(merge_points, sort_weight: SampleNearest(Points)) : merge_points
  }
  return switch
}

geometry(is_modifier: false) graph "Build Elastic Network"(
    Atoms: Geometry(
      description: "Atomic mesh which inculdes vertices and edges to generate an elastic network on"),
    Selection: Bool(
      description: "Atoms which aren't selected will not be included in the final output mesh",
      hide_value: true) = true,
    Menu: Menu(
      description: "Output a network between just alpha carbons, or one that includes all atoms",
      optional_label: true) = "Alpha Carbon",
    "Alpha Carbon": Float(
      description: "Scale the distance for edge creation between just alpha carbon atoms, ignoring all other atoms.") = 4.0 in 0.0..10000.0,
    "All Atom": Float(
      description: "Scale the distance for edge creation, looking for all selected atoms") = 2.0 in 0.0..10000.0
) -> (
    Mesh: Geometry(
      description: "The generated elastic network. Edges are formed between atoms within the cutoff distance for use as constraints in a simulation")
) {
  separate_geometry = SeparateGeometry(Atoms, selection: Selection)
  Plexus = separate_geometry.selection
    |> SeparateGeometry(selection: is_alpha_carbon().selection).selection
    |> Plexus(distance: alpha_carbon, radius: 0.0)
  capture_attribute = MenuSwitch(
      menu: Menu,
      "Alpha Carbon": Plexus,
      "All Atom": Plexus
        + (separate_geometry.selection
          |> SeparateGeometry().selection
          |> Plexus(distance: all_atom, radius: 0.0))).output
    |> MergeByDistance(distance: 0.0001)
    |> CaptureAttribute(Index: SampleNearest(separate_geometry.selection))
  return (
    Mesh: capture_attribute.geometry
      |> sample_atomic_attributes(
        sample_atoms: separate_geometry.selection,
        index: capture_attribute.index)
      |> SortElements(sort_weight: capture_attribute.index))
}
