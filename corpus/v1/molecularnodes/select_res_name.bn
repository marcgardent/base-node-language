geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph "Select Res Name"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    "Protein" {
        ALA: Bool(description: "Select the residue ALA"),
        ARG: Bool(description: "Select the residue ARG"),
        ASN: Bool(description: "Select the residue ASN"),
        ASP: Bool(description: "Select the residue ASP"),
        CYS: Bool(description: "Select the residue CYS"),
        GLU: Bool(description: "Select the residue GLU"),
        GLN: Bool(description: "Select the residue GLN"),
        GLY: Bool(description: "Select the residue GLY"),
        HIS: Bool(description: "Select the residue HIS"),
        ILE: Bool(description: "Select the residue ILE"),
        LEU: Bool(description: "Select the residue LEU"),
        LYS: Bool(description: "Select the residue LYS"),
        MET: Bool(description: "Select the residue MET"),
        PHE: Bool(description: "Select the residue PHE"),
        PRO: Bool(description: "Select the residue PRO"),
        SER: Bool(description: "Select the residue SER"),
        THR: Bool(description: "Select the residue THR"),
        TRP: Bool(description: "Select the residue TRP"),
        TYR: Bool(description: "Select the residue TYR"),
        VAL: Bool(description: "Select the residue VAL")
    },
    "DNA" {
        A: Bool(description: "Select the residue A"),
        C: Bool(description: "Select the residue C"),
        G: Bool(description: "Select the residue G"),
        T: Bool(description: "Select the residue T")
    },
    "RNA" {
        rA: Bool(description: "Select the residue rA"),
        rC: Bool(description: "Select the residue rC"),
        rG: Bool(description: "Select the residue rG"),
        rU: Bool(description: "Select the residue rU")
    }
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: IndexSwitch(
      residue_name(),
      ALA,
      ARG,
      ASN,
      ASP,
      CYS,
      GLU,
      GLN,
      GLY,
      HIS,
      ILE,
      LEU,
      LYS,
      MET,
      PHE,
      PRO,
      SER,
      THR,
      TRP,
      TYR,
      VAL,
      false,
      false,
      false,
      false,
      false,
      false,
      false,
      false,
      false,
      false,
      A,
      C,
      G,
      T,
      false,
      false,
      false,
      false,
      false,
      false,
      rA,
      rC,
      rG,
      rU))
  return (Selection: group.boolean, Inverted: group.inverted)
}
