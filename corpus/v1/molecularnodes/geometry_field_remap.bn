geometry graph "Geometry Field Remap"(
    Geometry: Geometry(description: "Geometry to get the statistics from"),
    Field: Float(description: "The field to summarise and remap", hide_value: true),
    "Value Min": Float(description: "The new minimum value of the field") in -10000.0..10000.0,
    "Value Max": Float(
      description: "The new maximum value of the field") = 1.0 in -10000.0..10000.0
) -> (Value: Float(description: "The remapped values between the new min and max")) {
  "Maps the range of values of the attribute on from the target atoms, to the range from min to max"
  attribute_statistic = AttributeStatistic(Geometry, attribute: Field)
  return (
    Value: MapRange(
      value: Field,
      from_min: attribute_statistic.min,
      from_max: attribute_statistic.max,
      to_min: value_min,
      to_max: value_max))
}
