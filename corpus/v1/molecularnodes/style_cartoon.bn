geometry graph ".Sample Nucleic Base Values"(
    Input: Int
) -> (
    base_valid: Bool,
    "base_pivot'": Vector,
    base_Z: Vector,
    base_Y: Vector,
    base_position: Vector,
    "Base Color": Color
) {
  "Sample relevant base positions for orientations" {
    group = residue_mask(atom_name: 61)
    group_2 = Color(index: residue_mask(atom_name: 67).index)
    mix = Mix[VECTOR](
      a: residue_mask(atom_name: 55).position,
      b: residue_mask(atom_name: 57).position)
    group_3 = select_nucleic_type()
    group_4 = residue_mask(atom_name: group_3.is_pyrimidine ? 68 : 65)
    group_5 = residue_mask(atom_name: group_3.is_pyrimidine ? 64 : 62)
    boolean_math = group.is_valid and group_4.is_valid and group_5.is_valid
    vector_math = group_5.position - group.position
    vector_math_2 = group_4.position - group_5.position
  }
  return (
    base_valid: boolean_math,
    "base_pivot'": group.position,
    base_Z: vector_math,
    base_Y: vector_math_2,
    base_position: mix,
    "Base Color": group_2)
}

geometry graph "Curve to Mesh with UVMap"(
    Curve: Geometry,
    "U Component": Menu(optional_label: true) = Factor,
    "Profile Resolution": Int = 12 in 3..512,
    "Fill Caps": Bool
) -> (Mesh: Geometry, uv_map: Vector) {
  group = fallback_geometry()
  menu_switch = MenuSwitch(menu: u_component, Factor: 0, Length: 1)
  named_attribute = NamedAttribute(name: "radius")
  spline_length = SplineLength()
  spline_parameter = SplineParameter()
  capture_attribute = CurveCircle(resolution: profile_resolution)
    |> CaptureAttribute(Factor: SplineParameter().factor, Index: SplineParameter().index)
  capture_attribute_2 = CaptureAttribute(
    Curve,
    Factor: IndexSwitch(menu_switch.output, spline_parameter.factor, spline_parameter.length),
    Index: SplineParameter().index,
    Length: SplineLength().length)
  return (
    Mesh: CurveToMesh(
      capture_attribute_2.geometry,
      profile_curve: capture_attribute.geometry,
      scale: named_attribute.exists ? named_attribute.attribute : 1.0,
      fill_caps: fill_caps),
    uv_map: CombineXYZ(
      x: check_end_face_corner(captured_index: capture_attribute_2.index)
        ? IndexSwitch(menu_switch.output, 1.0, capture_attribute_2.length)
        : capture_attribute_2.factor,
      y: check_end_face_corner(captured_index: capture_attribute.index)
        ? 1.0
        : capture_attribute.factor))
}

geometry graph "Is Nucleic"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_nucleic", fallback: mn_select_nucleic().is_nucleic))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Set Instancer"(
    Geometry: Geometry(description: "Atomic geometry that contains vertices and edges"),
    is_instanced: Bool = true
) -> Geometry {
  return StoreNamedAttribute[BOOLEAN](Geometry, name: "is_instanced", value: is_instanced)
}

geometry(is_modifier: true) graph "Smooth by Angle"(
    Mesh: Geometry,
    Angle: Float(
      subtype: ANGLE,
      description: "Maximum face angle for smooth edges") = 0.5235988 in 0.0..3.1415927,
    "Ignore Sharpness": Bool(force_non_field: true, structure_type: SINGLE)
) -> (Mesh: Geometry) {
  "Set the sharpness of mesh edges based on the angle between the neighboring faces"
  return (
    Mesh: Mesh
      |> SetShadeSmooth[EDGE](
        selection: IsEdgeSmooth() or ignore_sharpness,
        shade_smooth: EdgeAngle().unsigned_angle <= Angle and (IsFaceSmooth() or ignore_sharpness))
      |> SetShadeSmooth())
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph ".MN_utils_style_ribbon_nucleic"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    Switch: Bool,
    "Backbone" {
        "Backbone Subdivisions": Int = 3 in 1..10,
        "Backbone Resolution": Int = 8 in 3..50,
        "Backbone Radius": Float(subtype: DISTANCE) = 2.0 in 0.0..,
        "Backbone Shade Smooth": Bool = true,
        "Backbone Scale": Vector(subtype: XYZ) = (1.0, 1.0, 1.0)
    },
    "Base" {
        "Base Geometry": Geometry,
        "Base Scale": Vector = (2.5, 0.5, 7.0) in -10000.0..10000.0,
        "Base Resolution": Int = 6 in 3..512
    }
) -> (Geometry: Geometry, Curve: Geometry) {
  "Slightly Extend Curve Ends" {
    group = curve_endpoint_values()
    endpoint_selection = EndpointSelection()
    group_2 = vector_in_angstroms(
      vector: offset_vector(vector: CurveTangent(), offset: group.value),
      normalize: false,
      angstrom: group.value * -2.0)
  }
  group_3 = curve_to_mesh_with_uvmap()
  capture_attribute = Atoms
    |> RemoveNamedAttribute(name: "bond_type")
    |> CaptureAttribute(
      Selection as selection_2: is_nucleic(and_: Selection).selection,
      "Backbone Radius": backbone_radius)
  capture_attribute_2 = capture_attribute.geometry
    |> SeparateGeometry(selection: capture_attribute.selection_2).selection
    |> CaptureAttribute("Unique Group ID": unique_residue_id())
  group_4 = sample_nucleic_base_values(input: capture_attribute_2.unique_group_id)
  capture_attribute_3 = CaptureAttribute(
    capture_attribute_2.geometry,
    base_valid: group_4.base_valid,
    base_pivot: group_4.base_pivot,
    base_Z: group_4.base_z,
    base_Y: group_4.base_y,
    base_position: group_4.base_position,
    "Base Color": group_4.base_color)
  "Delete between chains and distance too large" {
    group_5 = capture_attribute_3.geometry
      |> MeshToPoints(selection: atom_name() == 55, position: capture_attribute_3.base_position)
      |> StoreNamedAttribute[INT](name: "tmp_idx", value: Index())
      |> PointsToCurves(curve_group_id: chain_id())
      |> curve_split_splines(curve_normal: "Minimum Twist", distance_cutoff: 0.1)
  }
  set_curve_radius = SetCurveRadius(group_5.curve, radius: capture_attribute.backbone_radius)
  "Instance simple base cylinder" {
    axes_to_rotation = AxesToRotation(
      primary_axis: capture_attribute_3.base_z,
      secondary_axis: capture_attribute_3.base_y)
    value = 1.0
    cylinder = Cylinder(vertices: base_resolution, radius: value, depth: value)
    instance_on_points = set_curve_radius
      |> SetCurveNormal(mode: Free, normal: capture_attribute_3.base_y)
      |> StoreNamedAttribute[FLOAT_COLOR](
        name: "vertex_color",
        value: capture_attribute_3.base_color)
      |> StoreNamedAttribute[BOOLEAN](name: "is_side_chain", value: true)
      |> set_instancer()
      |> InstanceOnPoints(
        selection: capture_attribute_3.base_valid,
        instance: fallback_geometry(
          base_geometry,
          fallback: cylinder.mesh
            |> TransformGeometry(
              translation: CombineXYZ(z: value / 2.0),
              rotation: (0.0, 0.0, 0.7853982))
            |> StoreNamedAttribute[FLOAT_VECTOR, CORNER](name: "uv_map", value: cylinder.uv_map)
            |> TransformGeometry(
              scale: vector_in_angstroms(vector: base_scale, normalize: false, angstrom: 1.0))),
        rotation: axes_to_rotation)
  }
  store_named_attribute = set_curve_radius
    |> SetCurveNormal()
    |> StoreNamedAttribute[BOOLEAN](name: "is_backbone", value: true)
  return (
    Geometry: (store_named_attribute
        |> SetPosition(selection: endpoint_selection, offset: group_2)
        |> curve_custom_profile(
          subdivisions: backbone_subdivisions,
          profile_type: Switch[MENU](
            switch: Switch,
            false_: "Custom Profile",
            true_: "Default Profile"),
          profile_rotation: RotateRotation[LOCAL](
            rotation: axes_to_rotation,
            rotate_by: (0.0, 0.0, -0.7853982)),
          profile_scale: backbone_scale / mn_world_scale(),
          profile_curve: Switch[GEOMETRY](
            switch: Switch,
            false_: CurveCircle(resolution: 4, radius: 0.01)
              |> TransformGeometry(rotation: (1.5707964, 0.7853982, -1.5707964))),
          profile_resolution: backbone_resolution,
          profile_rotation_float: 58.48539)
        |> smooth_by_angle(angle: 1.0471976)
        |> cleanup(
          color_source: store_named_attribute,
          material: Material,
          shade_smooth: backbone_shade_smooth))
      + (instance_on_points
        |> smooth_by_angle(angle: 1.3089969, ignore_sharpness: true)
        |> SetMaterial(material: Material)
        |> RemoveNamedAttribute(pattern_mode: Wildcard, name: "tmp_*")),
    Curve: store_named_attribute)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph ".MN_ensure_ures_id"(Input: Geometry) -> (Output: Geometry) {
  "If the `ures_id` attribute doesn't exist, create it"
  "Check if `ures_id` exists" {
    get_attribute_names = GetAttributeNames(
      Input,
      filter_data_type: true,
      data_type: Integer,
      filter_domain: true)
    list_length = ListLength[STRING](
      list: FilterList[STRING](
        list: get_attribute_names,
        selection: get_attribute_names == "ures_id").selection)
  }
  return (Output: list_length ? Input : set_ures_id(Input))
}

geometry graph "Check Geometry"(
    Geometry: Geometry,
    Message: String(
      optional_label: true) = "Input contains no geometry, check your node connections."
) -> Geometry {
  warning = Warning(show: contains_geometry(Geometry).empty, message: Message)
  return Geometry
}

geometry graph "Get Geometry Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of")
) -> (Geometry: Geometry, Bundle: Bundle, Atoms: Geometry) {
  get_geometry_bundle = GetGeometryBundle(Geometry)
  string = "MN/Atoms"
  get_bundle_item = GetBundleItem[GEOMETRY](
    bundle: get_geometry_bundle.bundle,
    path: string,
    remove: true)
  return (
    Geometry: Switch[GEOMETRY](switch: get_bundle_item.exists, true_: get_geometry_bundle.geometry),
    Bundle: get_bundle_item.bundle,
    Atoms: get_bundle_item.exists ? get_bundle_item.item : get_geometry_bundle.geometry)
}

geometry graph "Evaluate on Atoms"(
    Geometry: Geometry(description: "Geometry to get the bundle of"),
    Selection: Bool(
      description: "The parts of the geometry that go into the first output",
      hide_value: true) = true,
    Closure: Closure,
    Result: Menu(
      description: "Where to store the result of the closure. Bundle overwrite the existing `MN/Atoms` bundle. Geometry passes along the bundle and joins the resulting geometry into the output.",
      menu_expanded: true,
      optional_label: true) = Geometry
) -> Geometry {
  group = get_geometry_atoms(Geometry)
  "Evaluate the closure on the 'Atoms'" {
    evaluate_closure = EvaluateClosure(
      Closure,
      Atoms: group.atoms
        |> check_geometry(message: "'Atoms' contains no geometry, check your node connections.")
        |> mn_ensure_ures_id()
        |> SeparateGeometry(selection: Selection).selection) -> Geometry
  }
  menu_switch = MenuSwitch(menu: Result, Geometry: 0, Bundle: 1)
  string = "Evaluate the 'Closure' on the 'Atoms' geometry, join the resulting geometry with the input geometry.\n\nIf the input 'Geometry' doesn't contain a 'MN/Atoms' bundle then we treat the input geometry as the 'Atoms'."
  return SetGeometryBundle(
    group.geometry + IndexSwitch(menu_switch.output, evaluate_closure, _),
    bundle: StoreBundleItem[GEOMETRY](
      bundle: group.bundle,
      path: "MN/Atoms",
      item: IndexSwitch(menu_switch.output, group.atoms, evaluate_closure)))
}

geometry graph "Is Peptide"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_peptide", fallback: mn_select_peptide().is_peptide))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Separate Polymers"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (Peptide: Geometry, Nucleic: Geometry, Other: Geometry) {
  separate_geometry = SeparateGeometry(Atoms, selection: is_peptide().selection)
  separate_geometry_2 = SeparateGeometry(
    separate_geometry.inverted,
    selection: is_nucleic().selection)
  return (
    Peptide: separate_geometry.selection,
    Nucleic: separate_geometry_2.selection,
    Other: separate_geometry_2.inverted)
}

geometry(show_modifier_manage_panel: false) graph "Style Cartoon"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this style to, discarding unselected points",
      hide_value: true) = true,
    Quality: Int(
      description: "A lower value results in less geometry, with a higher value meaning better looking but more dense geometry") = 2 in 0..8,
    "Peptide"(default_closed: true) {
        "Peptide Shape": Menu(
          description: "Create rounded sheets and helices",
          menu_expanded: true,
          optional_label: true) = Sharp,
        "Helix"(default_closed: true) {
            "Helix Shape": Menu(
              description: "Use cylinders for helices instead of ribbons",
              menu_expanded: true,
              optional_label: true) = Spiral,
            "Helix Thickness": Float(
              description: "Thickness for the sheets and helices") = 0.6 in 0.0..,
            "Helix Width": Float(description: "Width for the sheets and helices") = 2.2 in 0.0..
        },
        "Sheet"(default_closed: true) {
            "Sheet Arrows": Menu(
              description: "User arrows for sheets",
              menu_expanded: true,
              optional_label: true) = Arrow,
            "Sheet Thickness": Float = 0.5 in 0.0..,
            "Sheet Width": Float = 2.5 in 0.0..10000.0,
            "Sheet Smoothing": Float(
              subtype: FACTOR,
              description: "Smoothing to apply to sheets") = 0.5 in 0.0..1.0
        },
        "Loop"(default_closed: true) {
            "Loop Radius": Float(
              description: "Radius of the loops for unstructure regions") = 0.4 in 0.0..3.0
        }
    },
    "Nucleic"(default_closed: true) {
        "Backbone Shape": Menu(menu_expanded: true, optional_label: true) = Cylinder,
        "Nucleic Width": Float = 3.0 in 0.0..10000.0,
        "Nucleic Thickness": Float = 1.0 in 0.0..10000.0,
        "Nucleic Radius": Float(subtype: DISTANCE) = 1.5 in 0.0..,
        "Base"(default_closed: true) {
            "Base Shape": Menu(menu_expanded: true, optional_label: true) = Rectangle,
            "Base Scale Cylinder": Vector = (1.0, 1.0, 7.0),
            "Base Scale Rectangle": Vector = (2.5, 0.8, 7.0)
        }
    },
    "Material"(default_closed: true) {
        "Color Blur": Bool(
          description: "Interpolate between colors when enabled. When disabled the faces will take their color from their corresponding atom without interpolating"),
        "Shade Smooth": Bool(
          description: "Apply smooth shading to the created geometry",
          force_non_field: true,
          structure_type: SINGLE) = true,
        Material: Material(
          description: "Material to apply to the resulting geometry",
          optional_label: true)
    }
) -> (Geometry: Geometry(description: "The generated geometry for the style node group")) {
  capture_attribute = CaptureAttribute()
  math = Quality * 3.0
  math_2 = Quality * 5.0
  menu_switch = MenuSwitch(menu: base_shape, Cylinder: 0, Rectangle: 1)
  menu_switch_2 = MenuSwitch(menu: backbone_shape, Cylinder: 0, Rectangle: 1)
  closure_output = graph(Atoms: Geometry) -> Geometry {
    capture_attribute_2 = CaptureAttribute(Atoms, selection: Selection)
    group = separate_polymers(capture_attribute_2.geometry)
    return mn_utils_style_cartoon(
        group.peptide,
        selection: capture_attribute_2.selection,
        shade_smooth: shade_smooth,
        interpolate_color: color_blur,
        material: Material,
        profile_resolution: Quality * 4.0,
        as_cylinders: MenuSwitch(menu: helix_shape, Spiral: false, Cylinder: true).output,
        cylinder_radius: helix_width,
        cylinder_resolution: math_2,
        cylinder_subdivisions: math,
        helix_thickness: helix_thickness,
        helix_width: helix_width,
        helix_subdivisions: math,
        as_arrows: MenuSwitch(menu: sheet_arrows, Arrow: true, Flat: false).output,
        arrows_sharp: peptide_shape,
        arrow_thickness_scale: 1.31,
        arrow_width_scale: 1.03,
        sheet_thickness: sheet_thickness,
        sheet_width: sheet_width,
        sheet_smoothing: sheet_smoothing,
        sheet_subdivision: math,
        loop_radius: loop_radius,
        loop_subdivisions: math,
        loop_resolution: math_2).cartoon_mesh
      + mn_utils_style_ribbon_nucleic(
        group.nucleic,
        selection: capture_attribute_2.selection,
        material: Material,
        switch: IndexSwitch(menu_switch_2.output, true, false),
        backbone_subdivisions: Quality * 2.0,
        backbone_resolution: Quality * 4.0,
        backbone_radius: IndexSwitch(menu_switch_2.output, nucleic_radius, 0.0),
        backbone_shade_smooth: shade_smooth,
        backbone_scale: IndexSwitch(
          menu_switch_2.output,
          (0.0, 0.0, 0.0),
          CombineXYZ(x: 1.0, y: nucleic_width, z: nucleic_thickness)),
        base_scale: IndexSwitch(menu_switch.output, base_scale_cylinder, base_scale_rectangle),
        base_resolution: IndexSwitch(menu_switch.output, 12, 4)).geometry
  }
  return (Geometry: evaluate_on_atoms(Atoms, closure: closure_output))
}
