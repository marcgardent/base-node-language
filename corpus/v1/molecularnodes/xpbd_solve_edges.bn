geometry graph "Constraint Distance"(
    Target: Vector in -10000.0..10000.0,
    Self: Vector = Position() in -10000.0..10000.0,
    Distance: Float = 0.5 in -10000.0..10000.0,
    W1: Float = 0.5 in 0.0..10000.0,
    W2: Float = 0.5 in 0.0..10000.0,
    alpha: Float in -10000.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> (Correction: Vector, Value: Float) {
  vector_math = Target - Self
  vector_math_2 = length(vector_math)
  return (
    Correction: normalize(vector_math)
      * ((vector_math_2 - Distance) * (W1 / (W1 + W2 + alpha / (deltaT * deltaT)))),
    Value: vector_math_2)
}

geometry graph "Edge Info"(
    "Vertex Index": Int(hide_value: true) = Index(),
    "Edge Index": Int(
      description: "Index within the gorup of edges that are connected to this point") in 0..3
) -> (
    "Is Valid": Bool(description: "Whether there is a valid edge corresponding to the given index"),
    "Point Index": Int(
      description: "The index for the other point involved in this edge, -1 if not connected"),
    "Point Position": Vector(
      description: "The position for the other point involved in this edge, (0, 0, 0) if not connected"),
    "Edge Index": Int(
      description: "The index on the edge domain for the selected edge. -1 if not connected"),
    "Edge Vector": Vector(
      subtype: EULER,
      description: "The vector along the selected edge. (0, 0, 0) if not connected"),
    "Edge Length": Float(description: "Length of the selected edge, -1 if not connected")
) {
  edge_vertices = EdgeVertices()
  edges_of_vertex = EdgesOfVertex(vertex_index: vertex_index, sort_index: edge_index)
  "Check edge exists, or return index -1 and (0, 0, 0) vector" {
    compare = edge_index < edges_of_vertex.total
  }
  math = EvaluateAtIndex[EDGE, INT](
      value: edge_vertices.vertex_index_1 + edge_vertices.vertex_index_2,
      index: edges_of_vertex.edge_index)
    - Index()
  position = Position()
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](value: position, index: math)
  vector_math = evaluate_at_index - position
  return (
    "Is Valid": compare,
    "Point Index": Switch[INT](switch: compare, false_: -1, true_: math),
    "Point Position": evaluate_at_index,
    "Edge Index": compare ? edges_of_vertex.edge_index : -1,
    "Edge Vector": compare ? vector_math : (0.0, 0.0, 0.0),
    "Edge Length": compare ? length(vector_math) : -1.0)
}

geometry graph "Fallback Float"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Float(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Value: Float(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute(name: Name)
  return (Value: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Inverse Mass"() -> (Exists: Bool, w: Float, mass: Float) {
  group = fallback_float(name: "mass", fallback: 1.0)
  string = "inverse_mass"
  return (
    Exists: NamedAttribute(name: string).exists,
    w: fallback_float(name: string, fallback: 1.0 / group),
    mass: group)
}

geometry(is_modifier: false) graph "XPBD Solve Edges"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Distance: Float = 0.27 in 0.0..10000.0,
    alpha: Float in -10000.0..10000.0,
    deltaT: Float(force_non_field: true, structure_type: SINGLE) in -10000.0..10000.0
) -> Geometry {
  group = inverse_mass()
  repeat_output = repeat(
    AttributeStatistic(Geometry, attribute: EdgesOfVertex().total).max,
    Geometry: Geometry,
    Correction: (0.0, 0.0, 0.0),
    Value: 0) -> {
    group_2 = edge_info(edge_index: iteration)
    boolean_math = Selection and group_2.is_valid
    return (
      Correction: Correction
        + (boolean_math
          ? constraint_distance(
            target: group_2.point_position,
            distance: EvaluateAtIndex[EDGE](value: Distance, index: group_2.edge_index),
            w1: group.w,
            w2: EvaluateAtIndex(value: group.w, index: group_2.edge_index),
            alpha: EvaluateAtIndex[EDGE](value: alpha, index: group_2.edge_index),
            deltat: deltaT).correction
          : (0.0, 0.0, 0.0)),
      Value: IntegerMath[ADD](Value: Value, Value_001: boolean_math))
  }
  return SetPosition(repeat_output.geometry, offset: repeat_output.correction / repeat_output.value)
}
