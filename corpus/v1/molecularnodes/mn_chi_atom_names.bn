geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph "Menu Residue Name"(
    "Residue Name": Menu(optional_label: true) = ALA
) -> (res_name: Int, Selection: Bool) {
  menu_switch = MenuSwitch(
    menu: residue_name,
    UNK: -1,
    ALA: 0,
    ARG: 1,
    ASN: 2,
    ASP: 3,
    CYS: 4,
    GLU: 5,
    GLN: 6,
    GLY: 7,
    HIS: 8,
    ILE: 9,
    LEU: 10,
    LYS: 11,
    MET: 12,
    PHE: 13,
    PRO: 14,
    SER: 15,
    THR: 16,
    TRP: 17,
    TYR: 18,
    VAL: 19,
    SNC: 15,
    MSE: 12,
    ASH: 3,
    CYM: 4,
    CYX: 4,
    GLH: 5,
    HID: 8,
    HIE: 8,
    HIP: 8,
    HYP: 8,
    LYN: 11,
    DA: 30,
    DC: 31,
    DG: 32,
    DT: 33,
    PST: 33,
    rA: 40,
    rC: 41,
    rG: 42,
    rU: 43)
  return (res_name: menu_switch.output, Selection: menu_switch.output == residue_name())
}

geometry graph "Switch Residue Name"(
    ALA: Int = 6,
    ARG: Int = 6,
    ASN: Int = 6,
    ASP: Int = 6,
    CYS: Int = 6,
    GLU: Int = 6,
    GLN: Int = 6,
    GLY: Int = 6,
    HIS: Int = 6,
    ILE: Int = 6,
    LEU: Int = 6,
    LYS: Int = 6,
    MET: Int = 6,
    PHE: Int = 6,
    PRO: Int = 6,
    SER: Int = 6,
    THR: Int = 6,
    TRP: Int = 6,
    TYR: Int = 6,
    VAL: Int = 6
) -> (Output: Int) {
  return (
    Output: IndexSwitch(
      residue_name(),
      ALA,
      ARG,
      ASN,
      ASP,
      CYS,
      GLU,
      GLN,
      GLY,
      HIS,
      ILE,
      LEU,
      LYS,
      MET,
      PHE,
      PRO,
      SER,
      THR,
      TRP,
      TYR,
      VAL))
}

geometry graph ".MN_chi_atom_names"() -> (X1: Int, X2: Int, X3: Int, X4: Int, X5: Int) {
  group = menu_atom_name(atom_name: CG)
  group_2 = menu_atom_name(atom_name: CG1)
  group_3 = menu_atom_name(atom_name: CD)
  group_4 = menu_atom_name(atom_name: OD1)
  group_5 = menu_atom_name(atom_name: CD1)
  group_6 = menu_atom_name(atom_name: OE1)
  group_7 = menu_atom_name(atom_name: CE)
  group_8 = menu_residue_name()
  group_9 = residue_name()
  return (
    X1: switch_residue_name(
      ala: group.atom_name,
      arg: group.atom_name,
      asn: group.atom_name,
      asp: group.atom_name,
      cys: menu_atom_name(atom_name: SG).atom_name,
      glu: group.atom_name,
      gln: group.atom_name,
      gly: group.atom_name,
      his: group.atom_name,
      ile: group_2.atom_name,
      leu: group.atom_name,
      lys: group.atom_name,
      met: group.atom_name,
      phe: group.atom_name,
      pro: group.atom_name,
      ser: menu_atom_name(atom_name: OG).atom_name,
      thr: menu_atom_name(atom_name: CG2).atom_name,
      trp: group.atom_name,
      tyr: group.atom_name,
      val: group_2.atom_name),
    X2: switch_residue_name(
      ala: group_3.atom_name,
      arg: group_3.atom_name,
      asn: group_4.atom_name,
      asp: group_4.atom_name,
      cys: group_3.atom_name,
      glu: group_3.atom_name,
      gln: group_3.atom_name,
      gly: group_3.atom_name,
      his: menu_atom_name(atom_name: CD2).atom_name,
      ile: group_3.atom_name,
      leu: group_5.atom_name,
      lys: group_3.atom_name,
      met: menu_atom_name(atom_name: SD).atom_name,
      phe: group_5.atom_name,
      pro: group_3.atom_name,
      ser: group_3.atom_name,
      thr: group_3.atom_name,
      trp: group_5.atom_name,
      tyr: group_5.atom_name,
      val: group_3.atom_name),
    X3: switch_residue_name(
      ala: 0,
      arg: menu_atom_name(atom_name: NE).atom_name,
      asn: 0,
      asp: 0,
      cys: 0,
      glu: group_6.atom_name,
      gln: group_6.atom_name,
      gly: 0,
      his: 0,
      ile: 0,
      leu: 0,
      lys: group_7.atom_name,
      met: group_7.atom_name,
      phe: 0,
      pro: 0,
      ser: 0,
      thr: 0,
      trp: 0,
      tyr: 0,
      val: 0),
    X4: switch_residue_name(
      arg: menu_atom_name(atom_name: CZ).atom_name,
      lys: menu_atom_name(atom_name: NZ).atom_name),
    X5: switch_residue_name(lys: menu_atom_name(atom_name: NH1).atom_name))
}
