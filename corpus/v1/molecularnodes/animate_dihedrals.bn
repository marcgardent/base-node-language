      lys: menu_atom_name(atom_name: NZ).atom_name),
    X5: switch_residue_name(lys: menu_atom_name(atom_name: NH1).atom_name))
}

geometry graph "Vector Angle"(
    A: Vector(description: "The first vector for angle calculation") in -10000.0..10000.0,
    B: Vector(description: "The second vector for the angle calculation") in -10000.0..10000.0
) -> (
    Angle: Float(subtype: ANGLE, description: "The angle between the two vectors in radians"),
    "A×B": Vector(description: "Axis around which the angle rotates (cross product of A and B)")
) {
  "The angle between two vectors, in radians"
  vector_math = normalize(A)
  vector_math_2 = normalize(B)
  return (Angle: acos(vector_math ⋅ vector_math_2), "A×B": vector_math × vector_math_2)
}

geometry graph "Dihedral Angle"(
    A: Vector(description: "First vector for the calculation, which draws a line to B"),
    B: Vector(
      description: "Second vector for the calculation, which receives a line from A and draws a line to C"),
    C: Vector(
      description: "Third vector for the calculation, which receives a line from B and draws a line to D"),
    D: Vector(
      description: "Last vector for the calculation, which is the end point of the line from D")
) -> (
    Angle: Float(
      subtype: ANGLE,
      description: "The angle between the vectors AB and CD, when made perpendicular to BC."),
    "BA⟂(BC)": Vector(description: "The vector BA when made perpendicular to  the axis BC"),
    "CD⟂(BC)": Vector(description: "The Vector CD when makde perpendicular to the axis BC"),
    BC: Vector(description: "The axis vector BC")
) {
  vector_math = D - C
  vector_math_2 = A - B
  vector_math_3 = C - B
  vector_math_4 = vector_math_2
    - VectorMath[PROJECT](Vector: vector_math_2, Vector_001: vector_math_3)
  vector_math_5 = vector_math - VectorMath[PROJECT](Vector: vector_math, Vector_001: vector_math_3)
  return (
    Angle: vector_angle(a: vector_math_4, b: vector_math_5).angle
      * sign((vector_math_4 × vector_math_5) ⋅ vector_math_3),
    "BA⟂(BC)": vector_math_4,
    "CD⟂(BC)": vector_math_5,
    BC: vector_math_3)
}

geometry graph "Group Pick"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true)
) -> (
    "Is Valid": Bool(
      description: "Valid for the point only if there is 1 single `True` for the `Pick` field in the point's group in the `Group ID`"),
    Index: Int(description: "Index of picked item. Returns -1 if not a valid pick")
) {
  "Get the item of the `True` in each `Group ID`, but only if there is a single `True` in each group"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total == 1
  return (
    "Is Valid": compare,
    Index: compare ? AccumulateField[INT](value: Pick ? Index() : 0, group_id: group_id).total : -1)
}

geometry graph "Group Pick Vector"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true),
    Position: Vector(
      description: "Vector field to pick vlaue for, defaults to `Position`",
      hide_value: true) = Position()
) -> (
    "Is Valid": Bool(description: "Whether the pick for the point's `Group ID` is valid"),
    Index: Int(description: "Picked Index for the Group, -1 if not valid"),
    Vector: Vector(description: "Picked vector for the group, `(0, 0, 0)` if not valid")
) {
  group = group_pick(pick: Pick, group_id: group_id)
  return (
    "Is Valid": group.is_valid,
    Index: group.index,
    Vector: group.is_valid
      ? EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: group.index)
      : (0.0, 0.0, 0.0))
}

geometry graph "URes ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    ures_id: Int,
    Size: Int(description: "The total of all of the values in the corresponding group")
) {
  group = attribute_at_index(index: Index, name: "ures_id")
  return (ures_id: group, Size: AccumulateField[INT](group_id: group).total)
}

geometry graph "Menu Residue Mask"(
    "Atom Name": Menu(optional_label: true) = N
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(
    pick: menu_atom_name(atom_name: atom_name).selection,
    group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph "Residue Mask"(
    atom_name: Int(description: "Atom to pick from the group") = 1 in 2..
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(pick: atom_name() == atom_name, group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

