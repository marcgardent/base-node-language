geometry graph "Animate Collection Pick"(
    Collection: Collection(optional_label: true),
    "Realize Instances": Bool = true,
    Item: Float = 1.0 in 0.0..10000.0
) -> (Current: Geometry, Next: Geometry) {
  "Pick items from a collection based on the index given. The current and next items in the collection are given for interpolation"
  collection_info = CollectionInfo[RELATIVE](collection: Collection, separate_children: true)
  float_to_integer = FloatToInteger[FLOOR](float: Item)
  integer_math = IntegerMath[SUBTRACT](Value: DomainSize[INSTANCES](collection_info), Value_001: 1)
  return (
    Current: collection_info
      |> SeparateGeometry[INSTANCE](
        selection: Index()
          == IntegerMath[MINIMUM](Value: float_to_integer, Value_001: integer_math)).selection
      |> RealizeInstances[realize_to_point_domain: true](realize_all: realize_instances),
    Next: collection_info
      |> SeparateGeometry[INSTANCE](
        selection: IntegerMath[MINIMUM](
            Value: IntegerMath[ADD](Value: float_to_integer, Value_001: 1),
            Value_001: integer_math)
          == Index()).selection
      |> RealizeInstances[realize_to_point_domain: true](realize_all: realize_instances))
}

geometry graph "Animate Fraction"(Interpolate: Bool, "Smoother Step": Bool, Float: Float) -> Float {
  "Interpolate the fraction component of a float"
  math = fract(Float)
  return Interpolate ? (smoother_step ? MapRange[SMOOTHERSTEP](value: math) : math) : floor(Float)
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

