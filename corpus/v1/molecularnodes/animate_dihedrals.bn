geometry graph "Boolean Last"(
    Boolean: Bool(
      description: "Value to test for True when tracking `Index` locations",
      hide_value: true) = true
) -> (
    "Index of Last": Int(
      description: "Accumulating in the point domain, this is the index where the `Boolean` was last `True`. For a point where the `Boolean` is `True`, the index will be of the _previous_ time this was true, but the next point will then reference this point")
) {
  "Index of last time the `Boolean` is true for each `Group ID` (not including the current point). "
  accumulate_field = AccumulateField[INT](value: Boolean)
  group = offset_integer(
    integer: AccumulateField[INT](
      value: AccumulateField[INT](group_id: accumulate_field.leading).trailing == 0 ? Index() : 0,
      group_id: accumulate_field.trailing).total)
  return (
    "Index of Last": accumulate_field.leading > 0
      ? offset_integer(
        integer: group_info(group_id: accumulate_field.leading).index_of_first,
        offset: -1)
      : -1)
}

geometry graph "Domain Switch Matrix"(
    Menu: Menu(optional_label: true) = Point,
    Point: Matrix,
    Edge: Matrix,
    Face: Matrix,
    "Face Corner": Matrix,
    Spline: Matrix,
    Instance: Matrix
) -> (Output: Matrix) {
  return (
    Output: MenuSwitch(
      menu: Menu,
      Point: Point,
      Edge: Edge,
      Face: Face,
      "Face Corner": face_corner,
      Spline: Spline,
      Instance: Instance).output)
}

geometry graph ".Accumulate Domain Transform"(
    Domain: Menu(hide_value: true, optional_label: true) = Point,
    Transform: Matrix(hide_value: true),
    "Group ID": Int(hide_value: true)
) -> (Leading: Matrix, Trailling: Matrix) {
  accumulate_field = AccumulateField[TRANSFORM](value: Transform, group_id: group_id)
  accumulate_field_2 = AccumulateField[TRANSFORM, EDGE](value: Transform, group_id: group_id)
  accumulate_field_3 = AccumulateField[TRANSFORM, FACE](value: Transform, group_id: group_id)
  accumulate_field_4 = AccumulateField[TRANSFORM, CORNER](value: Transform, group_id: group_id)
  accumulate_field_5 = AccumulateField[TRANSFORM, CURVE](value: Transform, group_id: group_id)
  accumulate_field_6 = AccumulateField[TRANSFORM, INSTANCE](value: Transform, group_id: group_id)
  return (
    Leading: domain_switch_matrix(
      menu: Domain,
      point: accumulate_field.leading,
      edge: accumulate_field_2.leading,
      face: accumulate_field_3.leading,
      face_corner: accumulate_field_4.leading,
      spline: accumulate_field_5.leading,
      instance: accumulate_field_6.leading),
    Trailling: domain_switch_matrix(
      menu: Domain,
      point: accumulate_field.trailing,
      edge: accumulate_field_2.trailing,
      face: accumulate_field_3.trailing,
      face_corner: accumulate_field_4.trailing,
      spline: accumulate_field_5.trailing,
      instance: accumulate_field_6.trailing))
}

geometry graph "Transform Accumulate"(
    Domain: Menu(
      description: "Domain on which to accumulate transforms",
      optional_label: true) = Point,
    Accumulate: Bool(
      description: "Selected transforms are included in the accumulation, non-selected transforms become identity matrices",
      hide_value: true) = true,
    Transform: Matrix(description: "Transform field to accumulate", hide_value: true),
    "Group ID": Int(
      description: "Transform field is accumulated individually for each `Group ID`",
      hide_value: true)
) -> (Transform: Matrix(description: "The accumulating Transform field")) {
  return (
    Transform: accumulate_domain_transform(
      domain: Domain,
      transform: Switch[MATRIX](switch: Accumulate, true_: Transform),
      group_id: group_id).leading)
}

geometry graph "Transform Local Axis"(
    Origin: Vector(
      subtype: TRANSLATION,
      description: "The vector defining the local space. Defaults to `Position`",
      hide_value: true) = Position(),
    Axis: Vector(description: "The axis to rotate around") = (0.0, 0.0, 1.0),
    Angle: Float(subtype: ANGLE, description: "Amount to rotate around the axis")
) -> (Transform: Matrix(description: "The Transform around the axis")) {
  "Create a transform around an axis in local space defined by the `Origin` point"
  return (
    Transform: MultiplyMatrices(
      Matrix: CombineTransform(
        translation: Origin,
        rotation: AxisAngleToRotation(axis: Axis, angle: Angle)),
      Matrix_001: CombineTransform(translation: -Origin)))
}

geometry graph "Accumulate Axis Rotation"(
    Position: Vector(description: "Position vector to transform") = Position(),
    Selection: Bool(hide_value: true) = true,
    Pivot: Bool(
      description: "The points at which points where `Accumulate` is true will look to for their axis of transformation.",
      hide_value: true),
    Angle: Float(subtype: ANGLE, description: "Amount to rotate around the axis"),
    "Group ID": Int(
      description: "Transform field is accumulated individually for each `Group ID`",
      hide_value: true),
    "Transform Index": Int(
      description: "Index at which to evaluate the final transform for the positon. For most cases this will be `Index`, but it might be that some points need to use the accumulated transform from another point instead",
      hide_value: true) = Index() in 0..
) -> (
    Position: Vector(subtype: XYZ, description: "Transformed vector"),
    Trasnform: Matrix(
      description: "The accumlated transform, not yet applied to the `Position` vector")
) {
  evaluate_at_index = EvaluateAtIndex[FLOAT4X4](
    value: transform_accumulate(
      accumulate: Selection,
      transform: transform_local_axis(
        origin: Position,
        axis: EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: boolean_last(boolean: Pivot))
          - Position,
        angle: Angle),
      group_id: group_id),
    index: transform_index)
  return (
    Position: TransformPoint(vector: Position, transform: evaluate_at_index),
    Trasnform: evaluate_at_index)
}

geometry graph "Atomic Number"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atomic_number: Int(
      description: "Read the `atomic_number` attribute from the geometry corresponding to elements")
) {
  return (atomic_number: attribute_at_index(index: Index, name: "atomic_number"))
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Is Hydrogen"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "Computed selection that includes Hydrogen atoms"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(and_: And, or_: Or, boolean: atomic_number() == 1)
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Hydrogen Bonding Partner"() -> (Index: Int) {
  edge_vertices = EdgeVertices()
  edges_of_vertex = EdgesOfVertex()
  evaluate_at_index = EvaluateAtIndex[EDGE, INT](
    value: edge_vertices.vertex_index_1,
    index: edges_of_vertex.edge_index)
  return (
    Index: is_hydrogen(and_: EdgesOfVertex().total == 1).selection
      ? (evaluate_at_index == Index()
        ? EvaluateAtIndex[EDGE, INT](
          value: edge_vertices.vertex_index_2,
          index: edges_of_vertex.edge_index)
        : evaluate_at_index)
      : Index())
}

geometry graph ".MN_constants_atom_name_peptide"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Alpha Carbon": Int
) {
  integer = 5
  integer_2 = 49
  integer_3 = 4
  integer_4 = 1
  integer_5 = 2
  return (
    "Backbone Lower": integer_4,
    "Backbone Upper": integer_3,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Alpha Carbon": integer_5)
}

geometry graph ".MN_select_peptide"() -> (
    "Is Backbone": Bool,
    "Is Side Chain": Bool,
    "Is Peptide": Bool,
    "Is Alpha Carbon": Bool
) {
  group = mn_constants_atom_name_peptide()
  group_2 = atom_name()
  compare = group_2 == group.alpha_carbon
  return (
    "Is Backbone": group_2 >= group.backbone_lower and group_2 <= group.backbone_upper,
    "Is Side Chain": group_2 >= group.side_chain_lower and group_2 <= group.side_chain_upper
      or compare,
    "Is Peptide": group_2 >= group.backbone_lower and group_2 <= group.side_chain_upper,
    "Is Alpha Carbon": compare)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Peptide"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_peptide", fallback: mn_select_peptide().is_peptide))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Override Index"(
    Selection: Bool(hide_value: true) = true,
    Index: Int(hide_value: true) = Index(),
    Override: Int
) -> (Output: Int) {
  return (Output: Selection ? Override : Index)
}

geometry graph "Peptide Chi"(
    Position: Vector(subtype: XYZ) = Position(),
    Selection: Bool(hide_value: true) = true,
    X1: Float(subtype: ANGLE),
    X2: Float(subtype: ANGLE),
    X3: Float(subtype: ANGLE),
    X4: Float(subtype: ANGLE),
    X5: Float(subtype: ANGLE)
) -> (Position: Vector(subtype: XYZ)) {
  group = mn_pivot_peptide()
  return (
    Position: not menu_atom_name(atom_name: OXT).selection and Selection
      ? accumulate_axis_rotation(
        position: Position,
        selection: is_peptide(and_: Selection).selection and group,
        pivot: group,
        angle: mn_peptide_chi_values(x1: X1, x2: X2, x3: X3, x4: X4, x5: X5).value,
        group_id: ures_id().ures_id,
        transform_index: EvaluateAtIndex[INT](
          value: override_index(
            selection: menu_atom_name(atom_name: CG2).selection,
            override: menu_residue_mask(atom_name: CB).index),
          index: hydrogen_bonding_partner())).position
      : Position)
}

geometry graph "Unique Residue ID"() -> (
    "Group ID": Int(description: "A unique Group ID for eash residue")
) {
  group = atom_name()
  accumulate_field = AccumulateField[INT](
    value: group == 1 or group == 50 or integer_run(value: residue_id()).is_different)
  {
    integer_math = IntegerMath[SUBTRACT](Value: accumulate_field.leading, Value_001: 1)
  }
  return ("Group ID": integer_math)
}

geometry graph "Set URes ID"(Geometry: Geometry) -> Geometry {
  return StoreNamedAttribute[INT](Geometry, name: "ures_id", value: unique_residue_id())
}

geometry graph "Set Chi Angle"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    X1: Float(subtype: ANGLE) in -10000.0..10000.0,
    X2: Float(subtype: ANGLE) in -10000.0..10000.0,
    X3: Float(subtype: ANGLE) in -10000.0..10000.0,
    X4: Float(subtype: ANGLE) in -10000.0..10000.0,
    X5: Float(subtype: ANGLE) in -10000.0..10000.0
) -> Geometry {
  math = -dihedral_chi_angle().angle
  return Geometry
    |> set_ures_id()
    |> SetPosition(
      position: peptide_chi(
        selection: Selection,
        x1: X1 + math,
        x2: X2 + math,
        x3: X3 + math,
        x4: X4 + math,
        x5: X5 + math))
}

geometry graph ".MN_constants_atom_name_nucleic"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Side Chain Joint Carbon": Int
) {
  integer = 61
  integer_2 = 77
  integer_3 = 50
  integer_4 = 61
  integer_5 = 54
  return (
    "Backbone Lower": integer_3,
    "Backbone Upper": integer_4,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Side Chain Joint Carbon": integer_5)
}

geometry graph ".MN_select_nucleic"() -> (
    "Is Backbone": Bool(
      description: "True for atoms that are part of the sugar-phosphate backbone for the nucleotides"),
    "Is Side Chain": Bool(
      description: "True for atoms that are part of the bases for nucleotides."),
    "Is Nucleic": Bool(description: "True if the atoms are part of a nucleic acid")
) {
  group = mn_constants_atom_name_nucleic()
  named_attribute = NamedAttribute[INT](name: "atom_name")
  return (
    "Is Backbone": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.backbone_upper,
    "Is Side Chain": named_attribute.attribute >= group.side_chain_lower
      and named_attribute.attribute <= group.side_chain_upper,
    "Is Nucleic": named_attribute.attribute >= group.backbone_lower
      and named_attribute.attribute <= group.side_chain_upper)
}

geometry graph "Is Alpha Carbon"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(
      name: "is_alpha_carbon",
      fallback: mn_select_peptide().is_alpha_carbon))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph "Is Side Chain"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    "Include CA": Bool(description: "Include the alpha carbon as part of the side chain") = true
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = fallback_boolean(
    name: "is_side_chain",
    fallback: mn_select_nucleic().is_side_chain or mn_select_peptide().is_side_chain)
  group_2 = boolean_andor(
    and_: And,
    or_: Or,
    boolean: include_ca ? group : nimply(group, is_alpha_carbon().selection))
  return (Selection: group_2.boolean, Inverted: group_2.inverted)
}

geometry graph "Peptide Dihedral"(
    Position: Vector(hide_value: true) = Position(),
    Selection: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Phi: Float(subtype: ANGLE),
    Psi: Float(subtype: ANGLE)
) -> (Position: Vector(subtype: XYZ, description: "Transformed vector")) {
  group = atom_name()
  boolean = true
  group_2 = is_peptide(and_: Selection)
  return (
    Position: group_2.selection
      ? accumulate_axis_rotation(
        position: Position,
        selection: group_2.selection,
        pivot: IndexSwitch(group, false, boolean, boolean, boolean),
        angle: IndexSwitch(
          group,
          0.0,
          0.0,
          chain_parameter().residue_index ? Phi : 0.0,
          EvaluateAtIndex(value: Psi, index: menu_residue_mask(atom_name: CA).index),
          0.0),
        group_id: chain_id(),
        transform_index: override_index(
          selection: is_side_chain(include_ca: false).selection,
          index: hydrogen_bonding_partner(),
          override: residue_mask(atom_name: 2).index)).position
      : Position)
}

geometry graph "Set Phi Psi Angle"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Phi: Float(subtype: ANGLE) in -10000.0..10000.0,
    Psi: Float(subtype: ANGLE) in -10000.0..10000.0
) -> Geometry {
  return SetPosition(
    Geometry,
    position: peptide_dihedral(
      selection: Selection,
      phi: Math[MULTIPLY_ADD](Value: dihedral_phi().phi, Value_001: -1.0, Value_002: Phi),
      psi: Math[MULTIPLY_ADD](Value: dihedral_psi().psi, Value_001: -1.0, Value_002: Psi)))
}

geometry(is_modifier: false) graph "Animate Dihedrals"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    Frames: Collection(
      description: "Collection which holds the frames of the trajectory",
      optional_label: true),
    "Smoother Step": Bool(description: "Ease in and out of the individual frames if interpolating"),
    Interpolate: Bool(
      description: "Whether to interpolate between frames of a trajectory or snap") = true,
    Frame: Float(
      description: "Which frame to select from the collection. The fraction component of the float is how much to interpolate between the current and next frame") in 0.0..10000.0
) -> (Atoms: Geometry(description: "Atomic geometry with new positions based on the trajectory")) {
  group = animate_collection_pick(collection: Frames, item: Frame)
  group_2 = animate_fraction(interpolate: Interpolate, smoother_step: smoother_step, float: Frame)
  object_info = ObjectInfo(object: SelfObject())
  set_position = SetPosition(Atoms, position: sample_position(group.current))
  set_position_2 = SetPosition(Atoms, position: sample_position(group.next))
  group_3 = sample_mix_angle(
    set_position,
    b: set_position_2,
    angle: dihedral_chi_angle().angle,
    factor: group_2)
  group_4 = Atoms
    |> set_chi_angle(
      selection: Selection,
      x1: group_3,
      x2: group_3,
      x3: group_3,
      x4: group_3,
      x5: group_3)
    |> set_phi_psi_angle(
      phi: sample_mix_angle(
        set_position,
        b: set_position_2,
        angle: dihedral_phi(menu: Read).phi,
        factor: group_2),
      psi: sample_mix_angle(
        set_position,
        b: set_position_2,
        angle: dihedral_psi(method: Read).psi,
        factor: group_2)) @ mute
  return (
    Atoms: TransformGeometry(
      group_4,
      translation: object_info.location,
      rotation: object_info.rotation,
      scale: abs(object_info.scale)))
}
