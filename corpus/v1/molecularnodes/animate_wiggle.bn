geometry graph ".MN_animate_wiggle_mask_length"(A: Int) -> (Result: Int) {
  return (Result: IndexSwitch(A, 2, 5, 6, 12, 20))
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Residue Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (res_name: Int(description: "Read the `res_name` attribute from the geometry")) {
  return (res_name: attribute_at_index(index: Index, name: "res_name"))
}

geometry graph ".MN_select_res_name_peptide"(
    ALA: Bool(description: "Select the AA residue ALA"),
    ARG: Bool(description: "Select the AA residue ARG"),
    ASN: Bool(description: "Select the AA residue ASN"),
    ASP: Bool(description: "Select the AA residue ASP"),
    CYS: Bool(description: "Select the AA residue CYS"),
    GLU: Bool(description: "Select the AA residue GLU"),
    GLN: Bool(description: "Select the AA residue GLN"),
    GLY: Bool(description: "Select the AA residue GLY"),
    HIS: Bool(description: "Select the AA residue HIS"),
    ILE: Bool(description: "Select the AA residue ILE"),
    LEU: Bool(description: "Select the AA residue LEU"),
    LYS: Bool(description: "Select the AA residue LYS"),
    MET: Bool(description: "Select the AA residue MET"),
    PHE: Bool(description: "Select the AA residue PHE"),
    PRO: Bool(description: "Select the AA residue PRO"),
    SER: Bool(description: "Select the AA residue SER"),
    THR: Bool(description: "Select the AA residue THR"),
    TRP: Bool(description: "Select the AA residue TRP"),
    TYR: Bool(description: "Select the AA residue TYR"),
    VAL: Bool(description: "Select the AA residue VAL")
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  index_switch = IndexSwitch(
    residue_name(),
    ALA,
    ARG,
    ASN,
    ASP,
    CYS,
    GLU,
    GLN,
    GLY,
    HIS,
    ILE,
    LEU,
    LYS,
    MET,
    PHE,
    PRO,
    SER,
    THR,
    TRP,
    TYR,
    VAL)
  return (Selection: index_switch, Inverted: not index_switch)
}

geometry graph ".MN_animate_wiggle_mask_res"(A: Int) -> (Result: Bool) {
  return (
    Result: IndexSwitch(
      A,
      mn_select_res_name_peptide(
        ala: true,
        arg: true,
        asn: true,
        asp: true,
        cys: true,
        glu: true,
        gln: true,
        his: true,
        ile: true,
        leu: true,
        lys: true,
        met: true,
        phe: true,
        ser: true,
        thr: true,
        trp: true,
        tyr: true,
        val: true).selection,
      mn_select_res_name_peptide(
        ala: true,
        arg: true,
        asn: true,
        asp: true,
        cys: true,
        glu: true,
        gln: true,
        his: true,
        ile: true,
        leu: true,
        lys: true,
        met: true,
        phe: true,
        ser: true,
        thr: true,
        trp: true,
        tyr: true,
        val: true).selection,
      mn_select_res_name_peptide(
        ala: true,
        arg: true,
        asn: true,
        asp: true,
        glu: true,
        gln: true,
        his: true,
        leu: true,
        lys: true,
        met: true,
        phe: true,
        trp: true).selection,
      mn_select_res_name_peptide(arg: true, gln: true, lys: true).selection,
      mn_select_res_name_peptide(ile: true, lys: true).selection))
}

geometry graph ".utils_group_field_at_selection"(
    Selection: Bool(description: "Selection of atoms to apply this node to"),
    "Group Index": Int,
    Float: Float(hide_value: true),
    Vector: Vector(hide_value: true),
    Boolean: Bool(hide_value: true),
    Color: Color(hide_value: true) = (0.0, 0.0, 0.0, 0.0),
    Integer: Int(hide_value: true)
) -> ("Group Index": Int, Float: Float, Vector: Vector, Boolean: Bool, Color: Color, Integer: Int) {
  accumulate_field = AccumulateField[INT](value: Selection ? Index() : 0, group_id: group_index)
  return (
    "Group Index": accumulate_field.total,
    Float: EvaluateAtIndex(value: Float, index: accumulate_field.total),
    Vector: EvaluateAtIndex[FLOAT_VECTOR](value: Vector, index: accumulate_field.total),
    Boolean: EvaluateAtIndex[BOOLEAN](value: Boolean, index: accumulate_field.total),
    Color: EvaluateAtIndex[FLOAT_COLOR](value: Color, index: accumulate_field.total),
    Integer: EvaluateAtIndex[INT](value: Integer, index: accumulate_field.total))
}

geometry graph ".MN_utils_aa_atom_pos"(
    atom_name: Int = 5
) -> (Position: Vector, "Group Index": Int, b_factor: Float, Integer: Int) {
  named_attribute = NamedAttribute[INT](name: "atom_name")
  accumulate_field = AccumulateField[INT](value: named_attribute.attribute == 1)
  group = utils_group_field_at_selection(
    selection: named_attribute.attribute == atom_name,
    group_index: accumulate_field.leading,
    float: NamedAttribute(name: "b_factor").attribute,
    vector: Position(),
    integer: EdgesOfVertex(vertex_index: Index()).total)
  "If atom_name is 0, return midpoint of backbone N and C" {
    position = Position()
    switch = atom_name != 0
      ? group.vector
      : Mix[VECTOR](
        factor: 0.5,
        a: utils_group_field_at_selection(
          selection: named_attribute.attribute == 1,
          group_index: accumulate_field.leading,
          vector: position).vector,
        b: utils_group_field_at_selection(
          selection: named_attribute.attribute == 3,
          group_index: accumulate_field.leading,
          vector: position).vector)
  }
  return (
    Position: switch,
    "Group Index": accumulate_field.leading,
    b_factor: group.float,
    Integer: group.integer)
}

geometry graph ".MN_constants_atom_name_peptide"() -> (
    "Backbone Lower": Int,
    "Backbone Upper": Int,
    "Side Chain Lower": Int,
    "Side Chain Upper": Int,
    "Alpha Carbon": Int
) {
  integer = 5
  integer_2 = 49
  integer_3 = 4
  integer_4 = 1
  integer_5 = 2
  return (
    "Backbone Lower": integer_4,
    "Backbone Upper": integer_3,
    "Side Chain Lower": integer,
    "Side Chain Upper": integer_2,
    "Alpha Carbon": integer_5)
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph ".MN_select_peptide"() -> (
    "Is Backbone": Bool,
    "Is Side Chain": Bool,
    "Is Peptide": Bool,
    "Is Alpha Carbon": Bool
) {
  group = mn_constants_atom_name_peptide()
  group_2 = atom_name()
  compare = group_2 == group.alpha_carbon
  return (
    "Is Backbone": group_2 >= group.backbone_lower and group_2 <= group.backbone_upper,
    "Is Side Chain": group_2 >= group.side_chain_lower and group_2 <= group.side_chain_upper
      or compare,
    "Is Peptide": group_2 >= group.backbone_lower and group_2 <= group.side_chain_upper,
    "Is Alpha Carbon": compare)
}

geometry graph "Boolean AndOr"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true),
    Boolean: Bool = true
) -> (Boolean: Bool, Inverted: Bool(description: "The inverse of the calculated selection")) {
  boolean_math = And and Boolean or Or
  return (Boolean: boolean_math, Inverted: not boolean_math)
}

geometry graph "Fallback Boolean"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Bool(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Boolean: Bool(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  "Computes the boolean field if the given attribute doesn't exist. If it doesn't exist it just uses the attribute instead"
  named_attribute = NamedAttribute[BOOLEAN](name: Name)
  return (Boolean: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Is Peptide"(
    And: Bool(
      description: "The resulting selection must overlap with this input selection",
      hide_value: true) = true,
    Or: Bool(
      description: "The resulting selection can be calculated from this node or be from this input selection",
      hide_value: true)
) -> (
    Selection: Bool(description: "The calculated selection"),
    Inverted: Bool(description: "The inverse of the calculated selection")
) {
  group = boolean_andor(
    and_: And,
    or_: Or,
    boolean: fallback_boolean(name: "is_peptide", fallback: mn_select_peptide().is_peptide))
  return (Selection: group.boolean, Inverted: group.inverted)
}

geometry graph MN_animate_noise_repeat(
    Amplitude: Float = 1.0 in -10000.0..10000.0,
    Detail: Float = 0.5 in 0.0..15.0,
    Roughness: Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Distortion: Float in -1000.0..1000.0,
    Vector: Vector(hide_value: true, default_attribute_name: "position") in -10000.0..10000.0,
    Speed: Float = 0.5 in -10000.0..10000.0,
    "Animate 0..1": Float = 0.5 in -10000.0..10000.0
) -> ("Noise Float": Float, "Noise Vector": Vector) {
  value = 4.0
  vector_math = (Vector
      + CombineXYZ(x: animate_0_1 * Speed)
      + RandomValue[FLOAT_VECTOR](min: (-10.0, -10.0, -10.0), max: (-1.0, 10.0, 10.0), id: Vector))
    * (6.2831855 / Speed)
  value_2 = 0.2
  noise_texture = NoiseTexture["4D"](
    vector: CombineXYZ(x: sin(vector_math.x), y: cos(vector_math.x), z: sin(vector_math.y)),
    w: cos(vector_math.y),
    scale: Speed * value_2,
    detail: Detail,
    roughness: Clamp(value: Roughness),
    distortion: Distortion)
  return (
    "Noise Float": MapRange(value: noise_texture.factor, to_min: -1.0) * Amplitude,
    "Noise Vector": MapRange[FLOAT_VECTOR](vector: noise_texture.color, to_min: (-1.0, -1.0, -1.0))
      * Amplitude)
}

geometry graph ".MN_utils_rotate_res"(
    Selection: Bool(description: "Selection of atoms to apply this node to"),
    "atom_name rotation": Int,
    "atom_name axis": Int = 2,
    "Scale b_factor": Float(subtype: FACTOR),
    Amplitude: Float = 1.0 in 0.0..10.0,
    "Amp. Axis": Float = 1.0 in -10000.0..10000.0,
    "Amp. Euler": Float = 1.0 in -10000.0..10000.0,
    Speed: Float = 10.0 in -10000.0..10000.0,
    "Animate 0..1": Float = 0.5 in -10000.0..10000.0
) -> (Selection: Bool(description: "The calculated selection"), Position: Vector) {
  group = mn_utils_aa_atom_pos(atom_name: atom_name_rotation)
  math = Mix(
      factor: scale_b_factor,
      a: 1.0,
      b: MapRange[SMOOTHERSTEP](value: group.b_factor, from_min: 1.0, from_max: 100.0))
    * Amplitude
  named_attribute = NamedAttribute[INT](name: "atom_name")
  random_value = RandomValue[FLOAT_VECTOR](
    min: (-13.0, -13.0, -13.0),
    max: (13.9, 13.9, 13.9),
    id: group.group_index,
    seed: atom_name_rotation)
  MN_animate_noise_repeat = MN_animate_noise_repeat(
    detail: 2.0,
    roughness: 1.0,
    distortion: 1.98,
    vector: random_value,
    speed: Speed,
    animate_0_1: animate_0_1)
  vector_math = MN_animate_noise_repeat(
      amplitude: amp_euler,
      detail: 1.0,
      roughness: 1.0,
      distortion: 1.98,
      vector: random_value,
      speed: Speed,
      animate_0_1: animate_0_1).noise_vector
    * math
    * (group.integer == 3) @ mute
  return (
    Selection: named_attribute.attribute != 38
      and (named_attribute.attribute > 4
        and (named_attribute.attribute > atom_name_rotation and is_peptide().selection))
      and Selection,
    Position: VectorRotate[EULER_XYZ](
      vector: VectorRotate(
        vector: Position(),
        center: group.position,
        axis: group.position - mn_utils_aa_atom_pos(atom_name: atom_name_axis).position,
        angle: math * amp_axis * MN_animate_noise_repeat.noise_float),
      center: group.position,
      rotation: vector_math))
}

geometry(is_modifier: false) graph "Animate Wiggle"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    b_factor: Float(
      subtype: FACTOR,
      description: "Amount that `b_factor` changeds the amplitude of wiggling") = 1.0 in 0.0..1.0,
    Amplitude: Float(description: "Overall amplitude of the wiggling") = 1.0 in 0.0..10.0,
    "Amp. Axis": Float(
      description: "Aplitude for the rotation around the bond axes") = 1.0 in -10000.0..10000.0,
    "Amp. Euler": Float(
      description: "Amplitude for applying euler rotations separate to the axis") = 0.4 in -10000.0..10000.0,
    Speed: Float(
      description: "Speed at which the wiggle is applied, 3 will repeat 3 times") = 3.0 in -10000.0..10000.0,
    Animate: Float(
      description: "Controls the animation of the wiggle, repeating every `1.00`") in -10000.0..10000.0
) -> (Atoms: Geometry(description: "The animated atomic geometry")) {
  repeat_output = repeat(5, Geometry: Atoms, Integer: 0) -> {
    group = mn_utils_rotate_res(
      selection: mn_animate_wiggle_mask_res(a: Integer) and Selection,
      atom_name_rotation: mn_animate_wiggle_mask_length(a: Integer),
      atom_name_axis: mn_animate_wiggle_mask_length(a: Integer - 1.0),
      scale_b_factor: b_factor,
      amplitude: Amplitude,
      amp_axis: amp_axis,
      amp_euler: amp_euler,
      speed: Speed,
      animate_0_1: Animate)
    return (
      Geometry: SetPosition(Geometry, selection: group.selection, position: group.position),
      Integer: Int = Integer + 1.0)
  }
  return (Atoms: repeat_output.geometry)
}
