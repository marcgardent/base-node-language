geometry graph "Principal Components"(
    Position: Vector(subtype: TRANSLATION) = Position(),
    "Group ID": Int(
      description: "An index used to group values together for multiple separate operations",
      hide_value: true)
) -> (
    "Group Center": Vector,
    Rotation: Rotation(description: "Rotation that defines the principal component basis"),
    "Principal Components": Vector(description: "Variance of the data along each principal axis"),
    "Principal Axes" {
        "Longest Axis": Vector(description: "Axis along the most variance"),
        "Intermediate Axis": Vector(
          description: "Axis completing a right handed orthogonal basis with the longest and shortest axis"),
        "Shortest Axis": Vector(description: "Axis along the least variance")
    }
) {
  "Principal Component Analysis (PCA) of a vector field"
  "Centroid" {
    field_average = FieldAverage[FLOAT_VECTOR](value: Position, group_id: group_id)
  }
  "Covariance matrix" {
    vector_math = Position - field_average.mean
    field_average_2 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.x,
      group_id: group_id)
    field_average_3 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.y,
      group_id: group_id)
    field_average_4 = FieldAverage[FLOAT_VECTOR](
      value: vector_math * vector_math.z,
      group_id: group_id)
    combine_matrix = CombineMatrix(
      column_1_row_1: field_average_2.mean.x,
      column_1_row_2: field_average_2.mean.y,
      column_1_row_3: field_average_2.mean.z,
      column_2_row_1: field_average_3.mean.x,
      column_2_row_2: field_average_3.mean.y,
      column_2_row_3: field_average_3.mean.z,
      column_3_row_1: field_average_4.mean.x,
      column_3_row_2: field_average_4.mean.y,
      column_3_row_3: field_average_4.mean.z)
  }
  "SVD of Covariance to find principal components" {
    matrix_svd = MatrixSVD(matrix: combine_matrix)
    matrix_determinant = MatrixDeterminant(matrix: matrix_svd.u)
  }
  separate_matrix = SeparateMatrix(matrix: matrix_svd.u)
  combine_xyz = CombineXYZ(
    x: separate_matrix.column_1_row_1,
    y: separate_matrix.column_1_row_2,
    z: separate_matrix.column_1_row_3)
  combine_xyz_2 = CombineXYZ(
    x: separate_matrix.column_3_row_1,
    y: separate_matrix.column_3_row_2,
    z: separate_matrix.column_3_row_3)
  return (
    "Group Center": field_average.mean,
    Rotation: AxesToRotation[primary_axis: X, secondary_axis: Z](
      primary_axis: combine_xyz,
      secondary_axis: combine_xyz_2),
    "Principal Components": matrix_svd.s,
    "Longest Axis": combine_xyz,
    "Intermediate Axis": CombineXYZ(
        x: separate_matrix.column_2_row_1,
        y: separate_matrix.column_2_row_2,
        z: separate_matrix.column_2_row_3)
      * sign(matrix_determinant),
    "Shortest Axis": combine_xyz_2)
}
