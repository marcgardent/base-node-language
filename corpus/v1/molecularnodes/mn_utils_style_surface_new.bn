geometry graph "Sorted Bundle Paths"(
    Bundle: Bundle,
    "Bundle Type": String(optional_label: true) = "MN*"
) -> (List: String) {
  get_nested_bundle_paths = GetNestedBundlePaths(
    bundle: Bundle,
    mode: "Bundle Type",
    pattern_mode: Wildcard,
    bundle_type: bundle_type)
  format_string = FormatString(format: "{v}/step", v: get_nested_bundle_paths)
  closure_output = graph(
    Index: Int(structure_type: SINGLE)
  ) -> (Item: Int(structure_type: DYNAMIC)) {
    return GetBundleItem[INT](
      bundle: Bundle,
      path: GetListItem[STRING](list: format_string, index: Index)).item
  }
  return (
    List: SortList[STRING](
      list: get_nested_bundle_paths,
      sort_weight: ClosureToList(
        ListLength[STRING](list: format_string),
        closure_output) -> (Item: Int(structure_type: DYNAMIC))))
}

geometry graph "Evaluate Ordered Bundles"(
    Geometry: Geometry,
    Bundles: Bundle,
    Prefix: String(optional_label: true) = "MN*"
) -> Geometry {
  group = sorted_bundle_paths(bundle: Bundles, bundle_type: Prefix)
  string = "closure"
  repeat_output = repeat(ListLength[STRING](list: group), Geometry: Geometry) -> {
    return EvaluateClosure(
      GetBundleItem[CLOSURE](
        bundle: Bundles,
        path: JoinStrings("/", GetListItem[STRING](list: group, index: iteration), string)).item,
      Geometry: Geometry) -> Geometry
  }
  return repeat_output
}

geometry(is_modifier: false) graph ".MN_utils_style_surface_new"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    "Shade Smooth": Bool(description: "Apply smooth shading to the created geometry") = true,
    Material: Material(description: "Material to apply to the resulting geometry"),
    "Relaxation Steps": Int = 30 in 0..,
    "Grid Create": Closure,
    "Mesh Processing": Bundle,
    Threshold: Float(description: "Values larger than the threshold are inside the generated mesh")
) -> Geometry {
  field_to_list = FieldToList(count: ListLength[STRING]())
  sort_list = SortList()
  return EvaluateClosure[define_signature: true](
      grid_create,
      Atoms: Atoms) -> (Grid: Geometry(structure_type: SINGLE))
    |> evaluate_ordered_bundles(bundles: mesh_processing)
    |> SetShadeSmooth(shade_smooth: shade_smooth)
    |> SetMaterial(material: Material)
}
