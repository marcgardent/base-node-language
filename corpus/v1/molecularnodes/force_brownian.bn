geometry graph "Force Brownian"(
    Add: Vector(hide_value: true) in -10000.0..10000.0,
    Small: Float = 0.1 in 0.0..10000.0,
    Large: Float in 0.0..10000.0
) -> (Force: Vector) {
  scene_time = SceneTime()
  return (
    Force: NoiseTexture["4D", normalize: false](
          w: scene_time.seconds,
          scale: 20.0,
          detail: 15.0,
          roughness: 1.0).color
        * (Small / 10.0)
      + (Add
        + NoiseTexture["4D", normalize: false](
            w: scene_time.seconds,
            scale: 0.1,
            detail: 15.0,
            roughness: 1.0,
            distortion: 10.0).color
          * (Large / 50.0)))
}
