geometry graph "Periodic Image"(
    A: Vector(subtype: XYZ) in -10000.0..10000.0,
    B: Vector(subtype: XYZ) in -10000.0..10000.0,
    C: Vector(subtype: XYZ) in -10000.0..10000.0,
    "Image" {
        "Image A": Int,
        "Image B": Int,
        "Image C": Int
    }
) -> (Points: Geometry) {
  return (Points: Points(position: A * image_a + B * image_b + C * image_c))
}
