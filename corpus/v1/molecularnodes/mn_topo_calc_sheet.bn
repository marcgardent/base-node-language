geometry graph "Fallback Vector"(
    Name: String(
      description: "Name of the attribute to attempt to read from the geometry",
      optional_label: true),
    Fallback: Vector(
      description: "Value to use instead if the named attribute doesn't exist on the geometry")
) -> (
    Output: Vector(
      description: "The named attribute read from the geometry if it exists, or the fallback value if it doesn't")
) {
  named_attribute = NamedAttribute[FLOAT_VECTOR](name: Name)
  return (Output: named_attribute.exists ? named_attribute.attribute : Fallback)
}

geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Group Pick"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true)
) -> (
    "Is Valid": Bool(
      description: "Valid for the point only if there is 1 single `True` for the `Pick` field in the point's group in the `Group ID`"),
    Index: Int(description: "Index of picked item. Returns -1 if not a valid pick")
) {
  "Get the item of the `True` in each `Group ID`, but only if there is a single `True` in each group"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total == 1
  return (
    "Is Valid": compare,
    Index: compare ? AccumulateField[INT](value: Pick ? Index() : 0, group_id: group_id).total : -1)
}

geometry graph "Group Pick Vector"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true),
    Position: Vector(
      description: "Vector field to pick vlaue for, defaults to `Position`",
      hide_value: true) = Position()
) -> (
    "Is Valid": Bool(description: "Whether the pick for the point's `Group ID` is valid"),
    Index: Int(description: "Picked Index for the Group, -1 if not valid"),
    Vector: Vector(description: "Picked vector for the group, `(0, 0, 0)` if not valid")
) {
  group = group_pick(pick: Pick, group_id: group_id)
  return (
    "Is Valid": group.is_valid,
    Index: group.index,
    Vector: group.is_valid
      ? EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: group.index)
      : (0.0, 0.0, 0.0))
}

geometry graph "URes ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    ures_id: Int,
    Size: Int(description: "The total of all of the values in the corresponding group")
) {
  group = attribute_at_index(index: Index, name: "ures_id")
  return (ures_id: group, Size: AccumulateField[INT](group_id: group).total)
}

geometry graph "Residue Mask"(
    atom_name: Int(description: "Atom to pick from the group") = 1 in 2..
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(pick: atom_name() == atom_name, group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph ".Backbone Position"(
    Method: Menu(menu_expanded: true, optional_label: true) = Read,
    Menu: Menu(
      description: "the particular backbone residue to read the value from",
      optional_label: true) = backbone_N
) -> (Position: Vector) {
  menu_switch = MenuSwitch(menu: Menu, backbone_N: 1, backbone_CA: 2, backbone_C: 3, backbone_O: 4)
  index_switch = IndexSwitch(
    menu_switch.output,
    "",
    "backbone_N",
    "backbone_CA",
    "backbone_C",
    "backbone_O")
  return (
    Position: MenuSwitch(
      menu: Method,
      Read: NamedAttribute[FLOAT_VECTOR](name: index_switch).attribute,
      Compute: EvaluateAtIndex[FLOAT_VECTOR](
        value: fallback_vector(
          name: index_switch,
          fallback: residue_mask(atom_name: menu_switch.output).position),
        index: residue_mask(atom_name: 2).index)).output)
}

geometry graph "Backbone C"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (C: Vector) {
  return (C: backbone_position(method: Method, menu: backbone_C))
}

geometry graph "Backbone N"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (N: Vector) {
  return (N: backbone_position(method: Method))
}

geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Unit Convert"(
    "Distance Type": Menu(
      description: "What unit to scale the value to",
      optional_label: true) = Angstrom,
    From: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (
    World: Float(description: "The value that has been scaled appropriately for the world space")
) {
  math = From * mn_world_scale()
  math_2 = math * 10.0
  return (
    World: MenuSwitch(
      menu: distance_type,
      Angstrom: math,
      Nanometre: math_2,
      Micrometre: math_2 * 1000.0).output)
}

geometry graph "Angstrom to World"(Angstrom: Float = 3.0 in -10000.0..10000.0) -> (World: Float) {
  return (World: unit_convert(from: Angstrom))
}

geometry graph "Backbone CA"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (CA: Vector) {
  return (CA: backbone_position(method: Method, menu: backbone_CA))
}

geometry graph "Offset Index"(
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(description: "The `Offset` to apply to the `Index` of the point")
) -> (Index: Int(description: "The `Index` + `Offset`")) {
  return (Index: IntegerMath[ADD](Value: Index, Value_001: Offset))
}

geometry graph "Offset Vector"(
    Vector: Vector(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true) = Position(),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field") in -2147483647..
) -> (Value: Vector(description: "The field evaluated at the offset `Index` value")) {
  return (
    Value: EvaluateAtIndex[FLOAT_VECTOR](
      value: Vector,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Vector Direction"(
    Normalize: Bool = true,
    To: Vector in -10000.0..10000.0,
    From: Vector in -10000.0..10000.0
) -> (
    Direction: Vector(description: "Vector between the points, potentially normalized"),
    Distance: Float(description: "Distance between the points before normalization")
) {
  vector_math = To - From
  return (
    Direction: Normalize ? normalize(vector_math) : vector_math,
    Distance: length(vector_math))
}

geometry graph "Backbone NH"(
    Menu: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (NH: Vector) {
  group = backbone_n(method: Read)
  group_2 = backbone_n()
  string = "backbone_NH"
  vector_math = VectorMath[MULTIPLY_ADD](
    Vector: normalize(
      vector_direction(to: group, from: backbone_ca(method: Read)).direction
        + vector_direction(to: group, from: backbone_c(method: Read)).direction),
    Vector_001: angstrom_to_world(angstrom: 1.01),
    Vector_002: backbone_n(method: Read))
  return (
    NH: MenuSwitch(
      menu: Menu,
      Read: NamedAttribute[FLOAT_VECTOR](name: string).attribute,
      Compute: fallback_vector(
        name: string,
        fallback: VectorMath[MULTIPLY_ADD](
          Vector: vector_direction(
            to: group_2,
            from: Mix[VECTOR](
              factor: 0.5,
              a: backbone_ca(),
              b: offset_vector(vector: backbone_c(), offset: -1))).direction,
          Vector_001: angstrom_to_world(angstrom: 1.01),
          Vector_002: group_2))).output)
}

geometry graph "Backbone O"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (O: Vector) {
  return (O: backbone_position(method: Method, menu: backbone_O))
}

geometry graph "World to Angstrom"(World: Float = 0.5 in -10000.0..10000.0) -> (Angstrom: Float) {
  return (Angstrom: World / mn_world_scale())
}

geometry graph "Recip. Ang. Dis"(
    A: Vector in -10000.0..10000.0,
    B: Vector in -10000.0..10000.0
) -> (Value: Float) {
  return (Value: 1.0 / world_to_angstrom(world: distance(A, B)))
}

geometry graph "HBond Energy"(
    O: Vector,
    C: Vector,
    N: Vector,
    H: Vector
) -> ("Is Bonded": Bool, "Bond Energy": Float, "Bond Vector": Vector) {
  "1 / r(ON)" {
    group = recip_ang_dis(a: O, b: N)
  }
  "1 / r(CH)" {
    group_2 = recip_ang_dis(a: C, b: H)
  }
  "1 / r(OH)" {
    group_3 = recip_ang_dis(a: O, b: H)
  }
  "1 / r(CN)" {
    group_4 = recip_ang_dis(a: C, b: N)
  }
  math = -(group + group_2 - group_3 - group_4) @ mute
  math_2 = math * 0.084 * 332.0
  return ("Is Bonded": math_2 < -0.5, "Bond Energy": math_2, "Bond Vector": O - H)
}

geometry graph "Integer Distance"(
    A: Int,
    B: Int,
    Distance: Int = 2
) -> (Cutoff: Bool, Distance: Int) {
  integer_math = IntegerMath[ABSOLUTE](value: IntegerMath[SUBTRACT](Value: A, Value_001: B))
  return (Cutoff: integer_math >= Distance, Distance: integer_math)
}

geometry graph ".Check HBond"(
    "CO Index": Int = Index() in 0..,
    "NH Index": Int = Index() in 0..,
    Distance: Int = 2
) -> ("Is Bonded": Bool, "Bond Energy": Float, "Bond Vector": Vector) {
  group = hbond_energy(
    o: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_o(method: Read), index: co_index),
    c: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_c(method: Read), index: co_index),
    n: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_n(method: Read), index: nh_index),
    h: EvaluateAtIndex[FLOAT_VECTOR](value: backbone_nh(menu: Read), index: nh_index))
  return (
    "Is Bonded": group.is_bonded
      and integer_distance(
        a: ures_id(index: co_index).ures_id,
        b: ures_id(index: nh_index).ures_id,
        distance: Distance).cutoff,
    "Bond Energy": group.bond_energy,
    "Bond Vector": group.bond_vector)
}

geometry graph "Boolean Run Fill"(
    Boolean: Bool(
      description: "The `Boolean` field to potentially fill gaps of `False` with",
      hide_value: true) = true,
    "Fill Size": Int(
      description: "A run of `False` values equal to or less than this size will become `True`") = 3
) -> (Boolean: Bool(description: "The `Boolean` array with gaps potentially filled")) {
  "Moving down the points, fill in `False` values that are equal to or less than the `Fill Size`"
  accumulate_field = AccumulateField[INT](group_id: AccumulateField[INT](value: Boolean).leading)
  return (
    Boolean: Boolean
      or accumulate_field.trailing <= fill_size and accumulate_field.total <= fill_size)
}

geometry graph "Offset Boolean"(
    Boolean: Bool(
      description: "The field to evaluate at the given `Index` + `Offset` on the point domain",
      hide_value: true),
    Index: Int(description: "The `Index` at which to evaluate this offset from") = Index() in 0..,
    Offset: Int(
      description: "The offset to apply to the `Index` before evaluating the input field") in -2147483647..
) -> (Boolean: Bool(description: "The field evaluated at the offset `Index` value")) {
  return (
    Boolean: EvaluateAtIndex[BOOLEAN](
      value: Boolean,
      index: offset_index(index: Index, offset: Offset)))
}

geometry graph "Vector from Point"(
    Target: Vector(description: "Vector that is the target") in -10000.0..10000.0,
    Position: Vector(
      description: "Position of the current point") = Position() in -10000.0..10000.0
) -> (
    Vector: Vector(description: "Vector from the current point's position to the given vector"),
    Direction: Vector(description: "Normalized output vector"),
    Length: Float(description: "Length of the output vector"),
    Rotation: Rotation
) {
  vector_math = Target - Position
  return (
    Vector: vector_math,
    Direction: normalize(vector_math),
    Length: length(vector_math),
    Rotation: AlignRotationToVector(vector: vector_math))
}

geometry graph "Index Distance"(
    Index: Int = Index() in 0..,
    "Target Index": Int(description: "Index for the selected point to measure to") = 100 in 0..,
    Position: Vector = Position()
) -> (
    Vector: Vector(description: "Vector from the current point to the indexed point"),
    Direction: Vector(description: "Normalized vector from the current point to the indexed point"),
    Distance: Float(description: "Distance from the current point to the indexed point"),
    Rotation: Rotation
) {
  group = vector_from_point(
    target: EvaluateAtIndex[FLOAT_VECTOR](
      value: Position,
      index: EvaluateAtIndex[INT](value: target_index, index: Index)),
    position: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: Index))
  return (
    Vector: group.vector,
    Direction: group.direction,
    Distance: group.length,
    Rotation: group.rotation)
}

geometry graph "Primitive Arrow"(
    Vertices: Int = 6 in 3..16,
    Height: Float(subtype: DISTANCE) = 1.0 in 0.0..10000.0,
    Ratio: Float(subtype: FACTOR) = 0.7 in 0.0..1.0,
    Value: Color = (0.8, 0.8, 0.8),
    Material: Material(description: "Material to apply to the resulting geometry")
) -> Geometry {
  math = Height * Ratio
  math_2 = Height - math
  return (Cone(vertices: Vertices, radius_bottom: 0.2, depth: math_2).mesh
        |> TransformGeometry(translation: CombineXYZ(z: Height - math_2)))
      + (Cylinder(vertices: Vertices, radius: 0.08, depth: math).mesh
        |> TransformGeometry(translation: CombineXYZ(z: math / 2.0)))
    |> StoreNamedAttribute[FLOAT_COLOR](name: "Color", value: Value)
    |> SetMaterial(material: Material)
}

geometry graph "Visualize Relative Atoms"(
    Atoms: Geometry,
    Selection: Bool(hide_value: true) = true,
    Scale: Float = 1.0 in -10000.0..10000.0,
    Position: Vector(hide_value: true) = Position(),
    "Target Index": Int(description: "Index for the selected point to measure to") = 100 in 0..,
    "Target Position": Vector(hide_value: true) = Position()
) -> (Instances: Geometry) {
  group = index_distance(target_index: target_index, position: target_position)
  return (
    Instances: Atoms
      |> SetPosition(position: Position)
      |> InstanceOnPoints(
        selection: Selection,
        instance: primitive_arrow(vertices: 3, ratio: 0.5625, value: (0.0, 0.0, 0.0, 1.0)),
        rotation: group.rotation,
        scale: CombineXYZ(x: 0.02, y: 0.02, z: group.distance * Scale)))
}

geometry graph ".MN_topo_calc_sheet"(
    "CA Mesh": Geometry
) -> ("Is Sheet": Bool, Instances: Geometry) {
  "Find Residues that we might be HBonding to" {
    group = backbone_nh(menu: Read)
    group_2 = backbone_o(method: Read)
    capture_attribute = CaptureAttribute(
      ca_mesh,
      "O -> NH": ca_mesh |> SetPosition(position: group) |> SampleNearest(sample_position: group_2),
      "NH -> O": ca_mesh |> SetPosition(position: group_2) |> SampleNearest(sample_position: group))
  }
  "Check if they are actually bonded to to the relevant atom" {
    capture_attribute_2 = CaptureAttribute(
      capture_attribute.geometry,
      "CO:NH": check_hbond(nh_index: capture_attribute.o_nh, distance: 3).is_bonded,
      "NH:CO": check_hbond(co_index: capture_attribute.nh_o, distance: 4).is_bonded)
  }
  "Debug arrows for HBonds" {
    value = 1.0
    join_geometry = visualize_relative_atoms(
        capture_attribute_2.geometry,
        selection: capture_attribute_2.co_nh,
        scale: value,
        position: backbone_o(method: Read),
        target_index: capture_attribute.o_nh,
        target_position: backbone_nh(menu: Read))
      + visualize_relative_atoms(
        capture_attribute_2.geometry,
        selection: capture_attribute_2.nh_co,
        scale: value,
        position: backbone_nh(menu: Read),
        target_index: capture_attribute.nh_o,
        target_position: backbone_o(method: Read))
  }
  "Not 100% correct but best I can do without Lists" {
    group_3 = boolean_run_fill(
      boolean: capture_attribute_2.co_nh
          and offset_boolean(boolean: capture_attribute_2.nh_co, index: capture_attribute.o_nh)
        or offset_boolean(boolean: capture_attribute_2.co_nh, offset: -1)
          and offset_boolean(boolean: capture_attribute_2.nh_co, offset: 1),
      fill_size: 2)
  }
  capture_attribute_3 = CaptureAttribute(capture_attribute_2.geometry, Boolean: group_3)
  return (
    "Is Sheet": SampleIndex[BOOLEAN](
      capture_attribute_3.geometry,
      value: capture_attribute_3.boolean,
      index: Index()),
    Instances: join_geometry)
}
