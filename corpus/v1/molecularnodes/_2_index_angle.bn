geometry graph "Vector Angle"(
    A: Vector(description: "The first vector for angle calculation") in -10000.0..10000.0,
    B: Vector(description: "The second vector for the angle calculation") in -10000.0..10000.0
) -> (
    Angle: Float(subtype: ANGLE, description: "The angle between the two vectors in radians"),
    "A×B": Vector(description: "Axis around which the angle rotates (cross product of A and B)")
) {
  "The angle between two vectors, in radians"
  vector_math = normalize(A)
  vector_math_2 = normalize(B)
  return (Angle: acos(vector_math ⋅ vector_math_2), "A×B": vector_math × vector_math_2)
}

geometry graph "2 Index Angle"(
    Position: Vector(
      description: "The `Position` vectors to use for the angle calculation") = Position(),
    "Index A": Int(
      description: "First end point for the angle calculation around the current point") in 0..,
    "Index B": Int(
      description: "The `Index` for the middle point in the angle calculation, defaulting to the current point") = Index() in 0..,
    "Index C": Int(
      description: "Last end point for the angle calculation around the current point") = 2 in 0..
) -> (Angle: Float(description: "Angle of the line A -> Self -> C in radians")) {
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: index_b)
  return (
    Angle: vector_angle(
      a: EvaluateAtIndex[FLOAT_VECTOR](
          value: Position,
          index: EvaluateAtIndex[INT](value: index_a, index: index_b))
        - evaluate_at_index,
      b: EvaluateAtIndex[FLOAT_VECTOR](
          value: Position,
          index: EvaluateAtIndex[INT](value: index_c, index: index_b))
        - evaluate_at_index).angle)
}
