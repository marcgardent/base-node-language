geometry graph "Menu Residue Mask"(
    "Atom Name": Menu(optional_label: true) = N
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(
    pick: menu_atom_name(atom_name: atom_name).selection,
    group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}

geometry graph ".MN_topo_assign_backbone"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges")
) -> (Atoms: Geometry, "CA Atoms": Geometry, "Sample Index": Int) {
  "Compute only on backbone atoms, but capture their idx first" {
    group = is_alpha_carbon()
    capture_attribute = CaptureAttribute(
      Atoms,
      Selection as selection_2: group.selection,
      Index: AccumulateField[INT](value: group.selection).trailing)
    separate_geometry = SeparateGeometry(
      capture_attribute.geometry,
      selection: is_backbone().selection)
  }
  string = "backbone"
  repeat_output = repeat(4, Geometry: separate_geometry.selection) -> {
    group_2 = menu_residue_mask(atom_name: IndexSwitch[MENU](iteration, N, CA, C, O))
    return StoreNamedAttribute[FLOAT_VECTOR](
      Geometry,
      selection: group_2.is_valid,
      name: JoinStrings("_", string, IndexSwitch(iteration, "N", "CA", "C", "O")),
      value: group_2.position)
  }
  return (
    Atoms: repeat_output,
    "CA Atoms": repeat_output
      |> SeparateGeometry(selection: capture_attribute.selection_2).selection
      |> StoreNamedAttribute[FLOAT_VECTOR](name: "backbone_NH", value: backbone_nh()),
    "Sample Index": SampleIndex[INT](
      capture_attribute.geometry,
      value: capture_attribute.index,
      index: Index()))
}

geometry graph "Atom ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_id: Int(
      description: "The `atom_id` attribute, read from geometry. Corresponds to the order of the atoms when they were read from the file")
) {
  return (atom_id: attribute_at_index(index: Index, name: "atom_id"))
}

geometry graph "Chain ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    chain_id: Int(
      description: "The `chain_id` attribute read from the points, corresponding to the different chains that were read from the structure")
) {
  "Integer representation of the Chain IDs that were present in the structure"
  return (chain_id: attribute_at_index(index: Index, name: "chain_id"))
}

geometry graph "Unique Chain ID"(
    Cutoff: Float(
      subtype: DISTANCE,
      description: "Threshold distance over which the next points are considered to be part of a new chain") = 4.5 in 0.0..10000.0
) -> ("Group ID": Int(description: "Calculated `Group ID` attribute")) {
  "Compute a unique Group ID based on the `chain_id` attribute, but also incrememnting if subsequent points are over a cutoff distance from each other"
  position = Position()
  return (
    "Group ID": IntegerMath[ADD](
      Value: integer_run(value: chain_id()).group_id,
      Value_001: AccumulateField[INT](
        value: distance(offset_vector(vector: position, offset: -1), position)
          > angstrom_to_world(angstrom: Cutoff)).leading))
}

geometry graph "Atoms to Curves"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Points to maintain and use for splines, non-selected points are removed",
      hide_value: true) = true,
    "Sort Points": Bool(
      description: "Sort points first by atom_id and chain_id before splitting to curves"),
    Cutoff: Float(subtype: DISTANCE) = 6.0 in -10000.0..10000.0
) -> (Curves: Geometry) {
  group = chain_id()
  separate_components = SeparateComponents(Atoms)
  mesh_to_points = MeshToPoints(
    CurveToMesh(separate_components.curve) + separate_components.mesh,
    selection: Selection)
  return (
    Curves: PointsToCurves(
      sort_points
        ? mesh_to_points
          |> SortElements(sort_weight: group)
          |> SortElements(group_id: group, sort_weight: atom_id())
        : mesh_to_points,
      curve_group_id: unique_chain_id(cutoff: Cutoff)))
}

geometry graph "Backbone O"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (O: Vector) {
  return (O: backbone_position(method: Method, menu: backbone_O))
}

geometry graph "Backbone Positions"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (
    O: Vector(description: "The position of the backbone _O_ atom for the residue"),
    C: Vector(description: "The position of the backbone _C_ atom for the residue"),
    CA: Vector(description: "The position of the backbone _CA_ atom for the residue"),
    N: Vector(description: "The position of the backbone _N_ atom for the residue"),
    NH: Vector
) {
  menu_switch = MenuSwitch(menu: Method, Read: 0, Compute: 1)
  return (
    O: backbone_o(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    C: backbone_c(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    CA: backbone_ca(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    N: backbone_n(method: IndexSwitch[MENU](menu_switch.output, Read, Compute)),
    NH: backbone_nh(menu: IndexSwitch[MENU](menu_switch.output, Read, Compute)))
}

geometry graph "Backbone Vectors"(
    Method: Menu(menu_expanded: true, optional_label: true) = Compute
) -> (
    Normal: Vector(
      description: "The vector used for the `Normal` of a curve when reading positions from a peptide backbone"),
    Tangent: Vector(
      description: "The vector used as the `Tangent` for a curve when reading values from a peptide backbone"),
    Bitangent: Vector(description: "Cross product of the Normal and Tangent")
) {
  "The `Vectors` that are useful for a curve when reading from a peptide backbone"
  group = backbone_positions(method: Method)
  vector_math = normalize(group.c - group.n)
  vector_math_2 = normalize(Mix[VECTOR](factor: 0.45, a: group.c, b: group.n) - group.ca)
  return (
    Normal: vector_math_2,
    Tangent: vector_math,
    Bitangent: normalize(vector_math × vector_math_2))
}

geometry(is_modifier: false) graph "Atoms to CA Curves"(
    Atoms: Geometry(description: "Atomic geometry that contains vertices and edges"),
    Selection: Bool(
      description: "Selection of atoms to apply this node to",
      hide_value: true) = true,
    "BS Smoothing": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Threshold: Float(
      description: "Distance (Angstroms) over which subsequent CA points are treated as a new chain") = 4.5 in 0.0..10000.0
) -> (Curves: Geometry) {
  "Turn backbone points to curves" {
    group = Atoms
      |> mn_topo_assign_backbone().atoms
      |> atoms_to_curves(selection: is_alpha_carbon(and_: Selection).selection, cutoff: Threshold)
  }
  position = Position()
  return (
    Curves: group
      |> StoreNamedAttribute[INT](name: "tmp_idx", value: Index())
      |> mn_init_tmp_attributes()
      |> SetCurveNormal(mode: Free, normal: backbone_vectors(method: Read).normal)
      |> mn_bs_smooth(factor: bs_smoothing, iterations: 1)
      |> SeparateGeometry[CURVE](selection: SplineLength().point_count > 1).selection
      |> SetSplineCyclic(
        cyclic: distance(
            EvaluateAtIndex[FLOAT_VECTOR](value: position, index: PointsOfCurve().point_index),
            EvaluateAtIndex[FLOAT_VECTOR](
              value: position,
              index: PointsOfCurve(sort_index: -1).point_index))
          < angstrom_to_world(angstrom: 4.0)))
}
