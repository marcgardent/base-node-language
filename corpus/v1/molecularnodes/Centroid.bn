geometry graph Centroid(
    Position: Vector(
      description: "The `Position` vector to use for the centroid calculation",
      hide_value: true) = Position(),
    Selection: Bool(
      description: "Selected points contribute to the computation of the centroid, unselected points do not contribute but still return the centroid for their `Group ID`",
      hide_value: true) = true,
    "Group ID": Int(
      description: "Compute the centroid on for each unique `Group ID`",
      hide_value: true)
) -> (Centroid: Vector(description: "The computed average vector for each `Group ID`")) {
  return (
    Centroid: AccumulateField[FLOAT_VECTOR](
        value: Selection ? Position : (0.0, 0.0, 0.0),
        group_id: group_id).total
      / AccumulateField[INT](value: Selection, group_id: group_id).total)
}
