geometry graph Centroid(
    Position: Vector(
      description: "The `Position` vector to use for the centroid calculation",
      hide_value: true) = Position(),
    Selection: Bool(
      description: "Selected points contribute to the computation of the centroid, unselected points do not contribute but still return the centroid for their `Group ID`",
      hide_value: true) = true,
    "Group ID": Int(
      description: "Compute the centroid on for each unique `Group ID`",
      hide_value: true)
) -> (Centroid: Vector(description: "The computed average vector for each `Group ID`")) {
  return (
    Centroid: AccumulateField[FLOAT_VECTOR](
        value: Selection ? Position : (0.0, 0.0, 0.0),
        group_id: group_id).total
      / AccumulateField[INT](value: Selection, group_id: group_id).total)
}

geometry(is_modifier: false) graph "Centre on Selection"(
    Atoms: Geometry(
      description: "Atomic geometry that contains vertices and edges",
      hide_value: true),
    Selection: Bool(
      description: "Selection within the groups to calculate the centroid for, which then affects all other points in the group",
      hide_value: true) = true,
    "Group ID": Int(
      description: "Optionally centre the points separately for each group based on the `Group ID` input",
      hide_value: true)
) -> (
    Atoms: Geometry(
      description: "Atoms that have been moved to object origin based on their group's calculated centroid"),
    Offset: Vector(description: "The calculated vector offset that was applied to the points")
) {
  Centroid = Centroid(selection: Selection, group_id: group_id)
  capture_attribute = CaptureAttribute(Atoms, Vector: Centroid)
  vector_math = -capture_attribute.vector
  return (Atoms: SetPosition(capture_attribute.geometry, offset: vector_math), Offset: vector_math)
}
