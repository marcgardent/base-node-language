geometry graph ".MN_world_scale"() -> (world_scale: Float) {
  value = 0.1
  return (world_scale: value)
}

geometry graph "Unit Convert"(
    "Distance Type": Menu(
      description: "What unit to scale the value to",
      optional_label: true) = Angstrom,
    From: Float(
      description: "A value which will be scaled appropriately for the world") = 3.0 in -10000.0..10000.0
) -> (
    World: Float(description: "The value that has been scaled appropriately for the world space")
) {
  math = From * mn_world_scale()
  math_2 = math * 10.0
  return (
    World: MenuSwitch(
      menu: distance_type,
      Angstrom: math,
      Nanometre: math_2,
      Micrometre: math_2 * 1000.0).output)
}

geometry graph "Angstrom to World"(Angstrom: Float = 3.0 in -10000.0..10000.0) -> (World: Float) {
  return (World: unit_convert(from: Angstrom))
}

geometry graph "oxDNA Vectors"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    base_vector: Vector,
    base_normal: Vector,
    "Backbone Offset": Vector,
    "Base Offset": Vector,
    Rotation: Rotation
) {
  group = angstrom_to_world(angstrom: 3.4)
  evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_vector").attribute,
    index: Index)
  evaluate_at_index_2 = EvaluateAtIndex[FLOAT_VECTOR](
    value: NamedAttribute[FLOAT_VECTOR](name: "base_normal").attribute,
    index: Index)
  return (
    base_vector: evaluate_at_index,
    base_normal: evaluate_at_index_2,
    "Backbone Offset": evaluate_at_index * -group
      + (evaluate_at_index × evaluate_at_index_2) * group,
    "Base Offset": evaluate_at_index * group,
    Rotation: AxesToRotation(primary_axis: evaluate_at_index, secondary_axis: evaluate_at_index_2))
}

geometry(is_modifier: false) graph "oxDNA Realize Vectors"(
    Atoms: Geometry(description: "Geometry to duplicate elements of")
) -> Geometry {
  value = 0.15
  group = oxdna_vectors()
  "Store attribute_ID on edge verts: 0=bbone, 1=base vec, 2=normal" {
    string = "attribute_ID"
    string_2 = "attribute_ID"
  }
  "Transfer all attrib to new verts to retain thru Merge by Dist" {
    integer = 0
    string_3 = "position,attribute_ID"
  }
  foreach_output = foreach(
    Atoms,
    Position: Position(),
    base_vector: group.base_vector,
    base_normal: group.base_normal) -> {
    "Create edges pointing along base and normal vectors" {
      mesh_line = MeshLine[END_POINTS](
        count: 2,
        start_location: Position,
        offset: Position + base_vector * value)
      mesh_line_2 = MeshLine[END_POINTS](
        count: 2,
        start_location: Position,
        offset: Position + base_normal * value)
    }
    "Store attribute_ID on edge verts: 0=bbone, 1=base vec, 2=normal" .. {
      sample_nearest = SampleNearest(mesh_line, sample_position: Position)
      store_named_attribute = mesh_line
        |> StoreNamedAttribute[INT](selection: Index() == sample_nearest, name: string)
        |> StoreNamedAttribute[INT](selection: Index() != sample_nearest, name: string_2, value: 1)
      sample_nearest_2 = SampleNearest(mesh_line_2, sample_position: Position)
      store_named_attribute_2 = mesh_line_2
        |> StoreNamedAttribute[INT](selection: Index() == sample_nearest_2, name: string)
        |> StoreNamedAttribute[INT](
          selection: Index() != sample_nearest_2,
          name: string_2,
          value: 2)
    }
    join_geometry = store_named_attribute_2 + store_named_attribute
    "Transfer all attrib to new verts to retain thru Merge by Dist" .. {
      transfer_attributes = TransferAttributes(
        join_geometry,
        target_point_id: integer,
        source: element,
        source_point_id: integer,
        pattern_mode: Exact,
        attribute_names: SplitString(string: string_3, separator: ","),
        exclude_names: true)
    }
    return (Geometry: transfer_attributes.target)
  }
  string_4 = "attribute_ID"
  return MergeByDistance(
    foreach_output.Geometry + StoreNamedAttribute[INT](foreach_output, name: string_4))
}
