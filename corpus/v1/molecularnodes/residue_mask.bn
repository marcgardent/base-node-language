geometry graph "Attribute at Index"(
    Index: Int = Index() in 0..,
    Name: String = "res_id"
) -> (Value: Int) {
  return (
    Value: EvaluateAtIndex[INT](value: NamedAttribute[INT](name: Name).attribute, index: Index))
}

geometry graph "Atom Name"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    atom_name: Int(
      description: "The `atom_name` attribute read from the points, an integer representation of the atom names. Corresponds to `CA` and `O` in the file etc. ")
) {
  "Geometry Nodes doesn't currently support text attributes, so strings like atom names have to be first converted to integers and mapping to atom names back and forth. Definitions for the atom names are available on the GitHub page"
  return (atom_name: attribute_at_index(index: Index, name: "atom_name"))
}

geometry graph "Group Pick"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true)
) -> (
    "Is Valid": Bool(
      description: "Valid for the point only if there is 1 single `True` for the `Pick` field in the point's group in the `Group ID`"),
    Index: Int(description: "Index of picked item. Returns -1 if not a valid pick")
) {
  "Get the item of the `True` in each `Group ID`, but only if there is a single `True` in each group"
  compare = AccumulateField[INT](value: Pick, group_id: group_id).total == 1
  return (
    "Is Valid": compare,
    Index: compare ? AccumulateField[INT](value: Pick ? Index() : 0, group_id: group_id).total : -1)
}

geometry graph "Group Pick Vector"(
    Pick: Bool(
      description: "Selection for the point to pick for the `Group ID`. Will only be valid for a single `Pick` for each `Group ID`",
      hide_value: true),
    "Group ID": Int(
      description: "Field definining the `Group ID` to pick from for the points",
      hide_value: true),
    Position: Vector(
      description: "Vector field to pick vlaue for, defaults to `Position`",
      hide_value: true) = Position()
) -> (
    "Is Valid": Bool(description: "Whether the pick for the point's `Group ID` is valid"),
    Index: Int(description: "Picked Index for the Group, -1 if not valid"),
    Vector: Vector(description: "Picked vector for the group, `(0, 0, 0)` if not valid")
) {
  group = group_pick(pick: Pick, group_id: group_id)
  return (
    "Is Valid": group.is_valid,
    Index: group.index,
    Vector: group.is_valid
      ? EvaluateAtIndex[FLOAT_VECTOR](value: Position, index: group.index)
      : (0.0, 0.0, 0.0))
}

geometry graph "URes ID"(
    Index: Int(hide_value: true) = Index() in 0..
) -> (
    ures_id: Int,
    Size: Int(description: "The total of all of the values in the corresponding group")
) {
  group = attribute_at_index(index: Index, name: "ures_id")
  return (ures_id: group, Size: AccumulateField[INT](group_id: group).total)
}

geometry graph "Residue Mask"(
    atom_name: Int(description: "Atom to pick from the group") = 1 in 2..
) -> (
    "Is Valid": Bool(
      description: "Group contains only one occurrance of the selected atom. None or more than one returns False"),
    Index: Int(
      description: "Index for the group's atom with specified name, returns -1 if not valid"),
    Position: Vector(
      description: "Position of the picked point in the group, returns (0, 0, 0) if not valid")
) {
  group = group_pick_vector(pick: atom_name() == atom_name, group_id: ures_id().ures_id)
  return ("Is Valid": group.is_valid, Index: group.index, Position: group.vector)
}
