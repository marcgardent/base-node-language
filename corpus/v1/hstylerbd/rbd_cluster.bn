geometry(is_modifier: false) graph "RBD Cluster"(
    Geometry: Geometry(description: "The pieces"),
    "Constraint Geometry": Geometry(description: "One edge per glue bond"),
    "Proxy Geometry": Geometry(description: "What collides"),
    Size: Float(subtype: DISTANCE, description: "Rough size of a cluster") = 1.0 in 0.001..,
    Jitter: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Seed: Int in 0..,
    "Strength Scale": Float(
      description: "Bonds inside a cluster are this many times stronger") = 10.0 in 0.0..
) -> (Geometry: Geometry, "Constraint Geometry": Geometry, "Proxy Geometry": Geometry) {
  voronoi_texture = VoronoiTexture(
    vector: NamedAttribute[FLOAT_VECTOR](name: "rbd_pivot").attribute + (17.3, 5.1, 9.7) * Seed,
    scale: 1.0 / Size,
    randomness: Jitter)
  voronoi_texture_2 = VoronoiTexture(
    vector: Position() + (17.3, 5.1, 9.7) * Seed,
    scale: 1.0 / Size,
    randomness: Jitter)
  edge_vertices = EdgeVertices()
  return (
    Geometry: StoreNamedAttribute[INT](
      Geometry,
      name: "cluster",
      value: floor(
        voronoi_texture.color.x * 1000.0
          + voronoi_texture.color.y * 1000000.0
          + voronoi_texture.color.z * 97.0)),
    "Constraint Geometry": constraint_geometry
      |> StoreNamedAttribute[INT](
        name: "cluster",
        value: floor(
          voronoi_texture_2.color.x * 1000.0
            + voronoi_texture_2.color.y * 1000000.0
            + voronoi_texture_2.color.z * 97.0))
      |> StoreNamedAttribute[EDGE](
        selection: EvaluateAtIndex[INT](
            value: NamedAttribute[INT](name: "cluster").attribute,
            index: edge_vertices.vertex_index_1)
          == EvaluateAtIndex[INT](
            value: NamedAttribute[INT](name: "cluster").attribute,
            index: edge_vertices.vertex_index_2),
        name: "strength",
        value: NamedAttribute(name: "strength").attribute * strength_scale),
    "Proxy Geometry": proxy_geometry)
}
