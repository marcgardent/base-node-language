geometry graph "Normal Selection"(
    Direction: Vector(
      subtype: XYZ,
      description: "Target direction to compare the normal to") = (0.0, 0.0, 1.0),
    Threshold: Float(
      subtype: ANGLE,
      description: "Maximum angle between normal and target to include in the selection") = 0.0872665
) -> (
    Selection: Bool(
      description: "Selection of elements with normals matching a target direction. (The normal is evaluated on the same domain as this selection output.)")
) {
  return (
    Selection: Compare[LESS_EQUAL, VECTOR, DIRECTION](
      a: Direction,
      b: Normal().normal,
      angle: Threshold))
}
