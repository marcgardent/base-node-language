geometry(is_modifier: false) graph "Displace Geometry"(
    Geometry: Geometry(description: "Geometry with points to displace"),
    Selection: Bool(
      description: "Selection of points that should be displaced",
      hide_value: true) = true,
    Strength: Float(
      description: "Factor that the displacement is multiplied with",
      structure_type: FIELD) = 1.0 in -10000.0..10000.0,
    "Offset Method": Menu(
      description: "Input method for how to generate the displacement vector",
      force_non_field: true,
      menu_expanded: true,
      optional_label: true,
      structure_type: SINGLE) = Normal,
    "Offset Vector": Vector(
      subtype: TRANSLATION,
      description: "Displacement offset vector",
      hide_value: true,
      structure_type: FIELD),
    "Offset Distance": Float(
      subtype: DISTANCE,
      description: "Distance of the displacement offset in normal direction",
      structure_type: FIELD) = 1.0 in -10000.0..10000.0,
    Substeps: Int(
      description: "Number of steps to divide the full displacement into. Fields, including normal and position, are re-evaluated before each step.") = 1 in 1..64,
    "Post Substep Process": Closure(
      description: "Geometry process to apply after each displacement step")
) -> (Geometry: Geometry(description: "Displaced geometry")) {
  math = Strength / Substeps
  "Normal Displacement" {
    vector_math = Normal().normal * (offset_distance * Strength)
  }
  menu_switch = MenuSwitch(menu: offset_method, Normal: 0, Vector: 1) @ hide
  repeat_output = repeat(Substeps, Geometry: Geometry) -> {
    return EvaluateClosure[define_signature: true](
      post_substep_process,
      Geometry: SetPosition(
        Geometry,
        selection: Selection,
        offset: IndexSwitch(menu_switch.output, vector_math, offset_vector) * math),
      Selection: Selection,
      Strength: math,
      "Substep Index": iteration) -> Geometry
  }
  return (
    Geometry: Warning[WARNING](
        show: Substeps <= 0,
        message: "Substeps <1 means the process is not executed")
      ? Geometry
      : repeat_output)
}
