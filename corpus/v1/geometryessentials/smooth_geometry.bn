geometry(is_modifier: false) graph "Smooth Geometry"(
    Geometry: Geometry(description: "Points to smooth based on their neighbors"),
    Selection: Bool(hide_value: true) = true,
    Iterations: Int(description: "How many times to repeat the smoothing step") = 5 in 0..,
    Weight: Float(
      subtype: FACTOR,
      description: "Relative mix weight of neighboring elements") = 0.5 in 0.0..1.0
) -> Geometry {
  return SetPosition(
    Geometry,
    selection: Selection,
    position: BlurAttribute[FLOAT_VECTOR](
      value: Position(),
      iterations: Iterations,
      weight: Weight))
}
