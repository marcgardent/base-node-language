geometry(show_modifier_manage_panel: false) graph "Geometry Input"(
    Geometry: Geometry,
    "Input Type": Menu(
      description: "How the geometry input should be exposed",
      menu_expanded: true,
      optional_label: true) = Object,
    Object: Object(description: "Object to use as the input geometry"),
    Collection: Collection(description: "Collection to use as the input geometry"),
    "Relative Space": Bool(description: "Transform the input relative to the main geometry"),
    "As Instance": Bool(
      description: "Input the geometry as an instance. (Further processing might require non-instance geometry).") = true,
    "Replace Original": Bool(
      description: "Replace the original input geometry with the selected input geometry")
) -> Geometry {
  menu_switch = MenuSwitch(
    menu: input_type,
    Object: relative_space
      ? ObjectInfo[RELATIVE](object: Object, as_instance: as_instance).geometry
      : ObjectInfo(object: Object, as_instance: as_instance).geometry,
    Collection: relative_space
      ? CollectionInfo[RELATIVE](collection: Collection)
      : CollectionInfo(collection: Collection))
  switch = as_instance
    ? menu_switch.output
    : RealizeInstances[realize_to_point_domain: true](menu_switch.output)
  return replace_original ? switch : Geometry + switch
}
