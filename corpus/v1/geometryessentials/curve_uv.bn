geometry graph ".curve_UV"(
    Menu: Menu(optional_label: true) = Factor
) -> (
    Factor: Float(
      description: "For points, the portion of the spline's total length at the control point. For Splines, the factor of that spline within the entire curve"),
    Length: Bool
) {
  spline_parameter = SplineParameter()
  menu_switch = MenuSwitch(
    menu: Menu,
    Factor(description: "Use the portion of the curve's total length"): spline_parameter.factor,
    Length(
      description: "Use the curve length at each point as the UV map coordinate directly"): spline_parameter.factor,
    Index(
      description: "Use the portion of the total evaluated points along the curve as the UV coordinate"): spline_parameter.index
        / IntegerMath[SUBTRACT](Value: SplineLength().point_count, Value_001: not IsSplineCyclic()))
  return (Factor: menu_switch.output, Length: menu_switch.length)
}
