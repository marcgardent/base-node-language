geometry(is_modifier: true) graph "O Displace Geometry"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Strength: Float = 1.0 in -10000.0..10000.0,
    Direction: Menu(menu_expanded: true, optional_label: true) = Normal,
    Height: Float(subtype: DISTANCE) = 1.0,
    Vector: Vector(subtype: TRANSLATION) = (1.0, 1.0, 1.0),
    "Options"(default_closed: true) {
        Midlevel: Float(subtype: DISTANCE) in 0.0..1.0
    }
) -> Geometry {
  return SetPosition(
    Geometry,
    selection: Selection,
    offset: MenuSwitch(
      menu: Direction,
      Normal: Normal[legacy_corner_normals: true]().normal * ((Height - Midlevel) * Strength),
      Vector: (Vector - Midlevel) * Strength).output)
}

geometry graph "O Is Edge Boundary"() -> ("Is Edge Boundary": Bool) {
  return (
    "Is Edge Boundary": EvaluateOnDomain[EDGE, BOOLEAN](value: EdgeNeighbors() == 1)
      or VertexNeighbors().vertex_count == 1)
}

geometry graph "O Project Geometry"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Source: Geometry,
    Menu: Menu(optional_label: true) = "Minimum Distance",
    "Positive Weight": Float(
      subtype: FACTOR,
      description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
    "Negative Weight": Float(
      subtype: FACTOR,
      description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
    "Options" {
        Weight: Float(
          subtype: FACTOR,
          description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
        "Max Distance": Float = 5.0 in -10000.0..10000.0
    }
) -> Geometry {
  normal = Normal()
  sample_nearest_surface = SampleNearestSurface[FLOAT_VECTOR](Source, value: normal.normal) @ hide
  vector_math = -normal.normal @ hide
  math = sqrt(FaceArea()) * max_distance
  raycast = Raycast(Source, ray_direction: normal.normal, ray_length: math)
  raycast_2 = Raycast(Source, ray_direction: vector_math, ray_length: math)
  normal_2 = Normal() @ hide
  vector_math_2 = raycast_2.hit_normal ⋅ normal_2.normal @ hide
  compare = vector_math_2 > 0.0 @ hide
  boolean_math = raycast_2.is_hit and compare @ hide
  normal_3 = Normal() @ hide
  vector_math_3 = raycast.hit_normal ⋅ normal_3.normal @ hide
  compare_2 = vector_math_3 > 0.0 @ hide
  boolean_math_2 = raycast.is_hit and compare_2 @ hide
  position = Position()
  math_2 = boolean_math * negative_weight @ hide
  mix = Mix[VECTOR](factor: math_2, a: position, b: raycast_2.hit_position) @ hide
  math_3 = boolean_math_2 * positive_weight @ hide
  mix_2 = Mix[VECTOR](factor: math_3, a: position, b: raycast.hit_position) @ hide
  set_position = SetPosition(
    Geometry,
    selection: Selection,
    position: Mix[VECTOR, clamp_factor: false](
      factor: Weight,
      a: Position(),
      b: MenuSwitch(
        menu: Menu,
        "Minimum Distance": GeometryProximity(Source).position,
        Project: raycast.is_hit ? mix_2 : mix).output)) @ hide
  return set_position
}

geometry(is_modifier: true) graph "O Smooth Geometry"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Iterations: Int(description: "How many times to blur the values for all elements") = 5 in 1..20,
    Weight: Float(
      subtype: FACTOR,
      description: "Relative mix weight of neighboring elements") = 1.0 in 0.0..1.0,
    "Pin Sharp": Float(
      subtype: FACTOR,
      description: "Relative mix weight of neighboring elements") in 0.0..1.0,
    "Pin Boundary": Float(
      subtype: FACTOR,
      description: "Relative mix weight of neighboring elements") in 0.0..0.9999,
    "Project"(default_closed: true) {
        Project: Bool(is_panel_toggle: true),
        "Positive Weight": Float(
          subtype: FACTOR,
          description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
        "Negative Weight": Float(
          subtype: FACTOR,
          description: "Amount of mixing between the A and B inputs") = 1.0 in 0.0..1.0,
        "Max Distance": Float = 2.0 in 1.0..5.0,
        Source: Menu(menu_expanded: true, optional_label: true) = Original,
        Source as source_geometry: Geometry,
        "Mesh Island": Int(
          description: "Splits the faces of the input mesh into groups which can be sampled individually",
          hide_value: true)
    }
) -> Geometry {
  position = Position() @ hide
  blur_attribute = BlurAttribute[FLOAT_VECTOR](value: position) @ hide
  position_2 = Position() @ hide
  blur_attribute_2 = BlurAttribute[FLOAT_VECTOR](value: position_2, weight: 0.5) @ hide
  normal = Normal() @ hide
  menu_switch = MenuSwitch(menu: Source, Original: 0, Custom: 1)
  index_switch = IndexSwitch(menu_switch.output, Geometry, source_geometry) @ hide
  index_switch_2 = IndexSwitch(menu_switch.output, MeshIsland().island_index, mesh_island) @ hide
  repeat_output = repeat(Iterations, Geometry: Geometry) -> {
    separate_geometry = SeparateGeometry(
      Geometry,
      selection: EvaluateOnDomain[BOOLEAN](value: o_is_edge_boundary())) @ hide
    sample_nearest = SampleNearest(separate_geometry.selection) @ hide
    sample_index = SampleIndex[FLOAT_VECTOR](
      separate_geometry.selection,
      value: blur_attribute_2,
      index: sample_nearest) @ hide
    mix = Mix[VECTOR](
      factor: pin_boundary,
      a: blur_attribute,
      b: o_is_edge_boundary() ? sample_index : blur_attribute) @ hide
    set_position = SetPosition(
      Geometry,
      selection: Selection,
      position: Mix[VECTOR](
        factor: Weight
          * (pin_sharp
            ? length(
              BlurAttribute[FLOAT_VECTOR](value: normal.normal, iterations: 10, weight: pin_sharp))
            : 1.0),
        a: Position(),
        b: pin_boundary ? mix : blur_attribute)) @ hide
    split_to_instances = SplitToInstances(set_position, group_id: MeshIsland().island_index)
    foreach_output = foreach[INSTANCE](
      split_to_instances.instances,
      "Group ID": split_to_instances.group_id) -> {
      separate_geometry_2 = SeparateGeometry(
        index_switch,
        selection: group_id == index_switch_2) @ hide
      return (
        Geometry: element
          |> RealizeInstances[realize_to_point_domain: true]()
          |> o_project_geometry(
            selection: Selection,
            source: separate_geometry_2.selection,
            menu: "Project",
            positive_weight: positive_weight,
            negative_weight: negative_weight,
            max_distance: max_distance))
    }
    return Project ? foreach_output.Geometry : set_position
  }
  return repeat_output
}

geometry graph "O Realize Structure"(
    Structure: Bundle,
    Density: Float = 10.0 in 0.0..100.0,
    "Surface"(default_closed: true) {
        Surface: Bool(is_panel_toggle: true),
        Sepcular: Float = 0.5 in 0.0..1.0,
        "Bump Scale": Float(force_non_field: true, structure_type: SINGLE) in 0.0..10.0
    },
    "Options"(default_closed: true) {
        "Random Offset": Float = 0.001 in 0.0001..0.01
    }
) -> Geometry {
  separate_bundle = SeparateBundle[define_signature: true](
    Structure) -> (
    Solid: Bool(structure_type: GRID),
    Albedo: Vector(structure_type: GRID),
    Opacity: Float(structure_type: GRID),
    Roughness: Float(structure_type: GRID),
    Emission: Vector(structure_type: GRID),
    Bump: Float(structure_type: GRID),
    Name: String(structure_type: SINGLE),
    ID: Int(structure_type: DYNAMIC))
  sample_grid = SampleGrid[BOOLEAN](grid: separate_bundle.solid) @ hide
  math = separate_bundle.opacity * sample_grid @ hide
  sample_grid_2 = SampleGrid(grid: separate_bundle.roughness) @ hide
  math_2 = -random_offset @ hide
  sample_grid_3 = SampleGrid(grid: separate_bundle.bump) @ hide
  math_3 = bump_scale * 0.01 @ hide
  math_4 = sample_grid_3 - 0.5 @ hide
  capture_attribute = GridToMesh(grid: separate_bundle.solid)
    |> CaptureAttribute(Value: math_4)
  math_5 = capture_attribute.value * math_3
  group = capture_attribute.geometry
    |> StoreNamedAttribute(name: "o_bump", value: math_5)
    |> StoreNamedAttribute(name: "o_roughness", value: sample_grid_2)
    |> StoreNamedAttribute(name: "o_opacity", value: Sepcular)
    |> o_smooth_geometry(iterations: 1)
  return GeometryToInstance(
    Switch[GEOMETRY](
          switch: Surface,
          true_: (bump_scale ? o_displace_geometry(group, height: math_5) : group)
            |> SetShadeSmooth()
            |> SetMaterial(material: "O Surface"))
        + (StoreNamedGrid(name: "o_density", grid: math * Density)
          |> StoreNamedGrid[VECTOR_FLOAT](name: "o_albedo", grid: separate_bundle.albedo)
          |> StoreNamedGrid[VECTOR_FLOAT](name: "o_emission", grid: separate_bundle.emission)
          |> SetMaterial(material: "O Volume"))
      |> SetGeometryName(name: separate_bundle.name)
      |> TransformGeometry(
        translation: RandomValue[FLOAT_VECTOR](
          min: math_2,
          max: random_offset,
          id: separate_bundle.id)))
}
