geometry graph "O Mesh to Layer"(
    Mesh: Geometry(
      description: "Geometry to compute the bounding box of. Instances have to be realized before the full bounding box can be computed"),
    "Bioxel Size": Float(force_non_field: true, structure_type: SINGLE) = 2.0 in 1.0..10.0,
    ID: Int,
    "Options"(default_closed: true) {
        Name: String
    }
) -> (Label: Bundle) {
  bounding_box = BoundingBox(Mesh)
  vector_math = bounding_box.max - bounding_box.min @ hide
  group = Group()
  math_2 = bioxel_size * 0.01
  math = 1.0 / math_2 @ hide
  vector_math_2 = vector_math * math @ hide
  vector_math_3 = ceil(vector_math_2)
  vector_math_4 = vector_math_3 * math_2 @ hide
  vector_math_5 = bounding_box.min + vector_math_4 @ hide
  return (
    Label: CombineBundle[define_signature: true](
      Name: Name,
      Data(
        structure_type: GRID): FieldToGrid(
          topology: VoxelizeGrid(
            grid: VolumeCube(
                min: bounding_box.min,
                max: vector_math_5,
                resolution_x: vector_math_3.x,
                resolution_y: vector_math_3.y,
                resolution_z: vector_math_3.z)
              |> TransformGeometry(mode: Matrix)
              |> GetNamedGrid(name: "density").grid),
          Selection: false),
      Kind(structure_type: SINGLE): "label",
      Shape(structure_type: SINGLE): vector_math_3,
      ID(structure_type: SINGLE): ID))
}
