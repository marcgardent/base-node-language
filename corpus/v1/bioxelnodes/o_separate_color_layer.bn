geometry graph "O Separate Color Layer"(
    Color: Bundle
) -> ("X Scalar": Bundle, "Y Scalar": Bundle, "Z Scalar": Bundle) {
  separate_bundle = SeparateBundle[define_signature: true](
    Color) -> (
    Data: Vector(structure_type: GRID),
    Name: String(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    Shape: Vector(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE))
  string = "X"
  math = separate_bundle.id + -1000.0 @ hide
  string_2 = "Y"
  string_3 = "Z"
  math_2 = separate_bundle.id + -2000.0 @ hide
  math_3 = separate_bundle.id + -3000.0 @ hide
  return (
    "X Scalar": CombineBundle[define_signature: true](
      Data(structure_type: GRID): separate_bundle.data.x,
      Name: JoinStrings("_", separate_bundle.name, string),
      Kind(structure_type: SINGLE): "scalar",
      Shape(structure_type: SINGLE): separate_bundle.shape,
      ID(structure_type: SINGLE): Int = math,
      Min(structure_type: SINGLE): 0.0,
      Max(structure_type: SINGLE): 1.0),
    "Y Scalar": CombineBundle[define_signature: true](
      Data(structure_type: GRID): separate_bundle.data.y,
      Name: JoinStrings("_", separate_bundle.name, string_2),
      Kind(structure_type: SINGLE): "scalar",
      Shape(structure_type: SINGLE): (0.0, 0.0, 0.0),
      ID(structure_type: SINGLE): Int = math_2,
      Min(structure_type: SINGLE): 0.0,
      Max(structure_type: SINGLE): 1.0),
    "Z Scalar": CombineBundle[define_signature: true](
      Data(structure_type: GRID): separate_bundle.data.z,
      Name: JoinStrings("_", separate_bundle.name, string_3),
      Kind(structure_type: SINGLE): "scalar",
      Shape(structure_type: SINGLE): (0.0, 0.0, 0.0),
      ID(structure_type: SINGLE): Int = math_3,
      Min(structure_type: SINGLE): 0.0,
      Max(structure_type: SINGLE): 1.0))
}
