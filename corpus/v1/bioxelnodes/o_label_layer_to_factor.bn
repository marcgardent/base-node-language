geometry graph "O Label Layer to Factor"(Label: Bundle) -> (Factor: Float) {
  return (
    Factor: SampleGrid[BOOLEAN](
      grid: (SeparateBundle[define_signature: true](
        Label) -> (
        Data: Bool(structure_type: GRID),
        Shape: Vector(structure_type: SINGLE),
        Kind: String(structure_type: SINGLE),
        ID: Int(structure_type: SINGLE))).data))
}
