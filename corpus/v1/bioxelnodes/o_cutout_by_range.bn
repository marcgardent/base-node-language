geometry graph "O Build Structure"(
    Solid: Bool(structure_type: GRID),
    Color: Color,
    Roughness: Float(subtype: FACTOR) = 0.1 in 0.0..1.0,
    Emission: Color,
    Bump: Float in -1.0..1.0,
    Name: String,
    ID: Int
) -> (Structure: Bundle) {
  separate_color = SeparateColor(color: Color)
  field_to_grid_2 = FieldToGrid[BOOLEAN](topology: Solid, Opacity: separate_color.alpha) @ hide
  combine_xyz = CombineXYZ(
    x: separate_color.red,
    y: separate_color.green,
    z: separate_color.blue) @ hide
  field_to_grid = FieldToGrid[BOOLEAN](topology: Solid, Albedo: combine_xyz) @ hide
  field_to_grid_3 = FieldToGrid[BOOLEAN](topology: Solid, Roughness: Roughness) @ hide
  field_to_grid_4 = FieldToGrid[BOOLEAN](topology: Solid, Emission: Vector = Emission) @ hide
  map_range = MapRange(value: Bump, from_min: -1.0) @ hide
  return (
    Structure: CombineBundle[define_signature: true](
      Solid: Solid,
      Albedo(structure_type: GRID): field_to_grid,
      Opacity(structure_type: GRID): field_to_grid_2,
      Roughness: field_to_grid_3,
      Emission: field_to_grid_4,
      Bump: FieldToGrid[BOOLEAN](topology: Solid, Bump: map_range),
      Name: Name,
      ID: ID))
}

geometry graph "O Float to Target Digits"(
    Value: Float in -10000.0..10000.0,
    Target: Int = 4 in 0..9
) -> (Output: Float) {
  return (Output: pow(10.0, Target - ceil(log(abs(Value), 10.0))) * Value)
}

geometry graph "O Cutout by Range"(
    Scalar: Bundle,
    Label: Bundle,
    "From Min": Float in -10000.0..10000.0,
    "From Max": Float = 1.0 in -10000.0..10000.0,
    "Properties"(default_closed: true) {
        Color: Color = (0.6038313, 0.6038313, 0.6038313),
        Roughness: Float(subtype: FACTOR) = 0.2 in 0.0..1.0,
        Emission: Color,
        Bump: Float in -1.0..1.0
    },
    "Options"(default_closed: true) {
        Name: String,
        Invert: Bool(force_non_field: true, structure_type: SINGLE),
        Prune: Bool = true
    }
) -> (Structure: Bundle) {
  math = o_float_to_target_digits(value: from_min)
    + o_float_to_target_digits(value: from_max) @ hide
  separate_bundle = SeparateBundle[define_signature: true](
    Scalar) -> (
    Data: Float(structure_type: GRID),
    Shape: Vector(structure_type: SINGLE),
    Min: Float(structure_type: SINGLE),
    Max: Float(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE))
  math_2 = separate_bundle.id + math @ hide
  separate_bundle_2 = SeparateBundle[define_signature: true](
    Label) -> (
    Data: Bool(structure_type: GRID),
    Shape: Vector(structure_type: SINGLE),
    Kind: String(structure_type: SINGLE),
    ID: Int(structure_type: SINGLE))
  match_string = MatchString(
    string: separate_bundle_2.kind,
    operation: Contains,
    key: "label") @ hide
  sample_grid = SampleGrid[BOOLEAN](grid: separate_bundle_2.data) @ hide
  switch = match_string ? sample_grid : true @ hide
  boolean_math = switch
    and (Invert xor separate_bundle.data > from_min and separate_bundle.data < from_max) @ hide
  math_3 = separate_bundle.data - separate_bundle.min @ hide
  return (
    Structure: o_build_structure(
      solid: Prune ? PruneGrid(grid: math_3 * boolean_math) : boolean_math,
      color: Color,
      roughness: Roughness,
      emission: Emission,
      bump: Bump,
      name: Name,
      id: math_2))
}
