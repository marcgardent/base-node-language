geometry graph NodeGroup(
    Menu: Menu(optional_label: true) = A,
    "Voxel Size": Float(subtype: DISTANCE) = 0.05 in 0.01..,
    Grid: Float(hide_value: true),
    Grid as grid_vector: Vector(hide_value: true, structure_type: GRID)
) -> ("Value.001": Float(description: "Output grid with evaluated field values"), Grid: Vector) {
  field_to_grid = FieldToGrid[BOOLEAN](
    topology: VoxelizeGrid[BOOLEAN](
      grid: StoreNamedGrid[BOOLEAN](
          name: "o_",
          grid: MenuSwitch[BOOLEAN](menu: Menu, A: Grid, B: grid_vector).output)
        |> BoundingBox().bounding_box
        |> MeshToDensityGrid(voxel_size: voxel_size, gradient_width: 0.0)),
    "Value.001": SampleGrid(grid: Grid),
    Value: SampleGrid[VECTOR](grid: grid_vector))
  return (
    "Value.001": PruneGrid(grid: field_to_grid.value_001),
    Grid: PruneGrid[VECTOR](grid: field_to_grid.value))
}
