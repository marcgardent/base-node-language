geometry graph "Prism Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION),
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    vector_math = RotateVector(
        vector: Position() - Location,
        rotation: InvertRotation(rotation: Rotation))
      / (Scale * 0.5)
  }
  "SDF Prism" {
    vector_math_2 = vector_math / (0.866025, 0.866025, 1.0)
    math_2 = abs(vector_math_2.z) - Scale.z * 0.5
    combine_xyz = CombineXYZ(x: abs(vector_math_2.x) - 1.0, y: vector_math_2.y + 0.57735026)
    math_3 = 1.7320508 * combine_xyz.y
    mix = Mix[VECTOR](
      factor: Math[GREATER_THAN](Value: combine_xyz.x + math_3, Value_001: 0.0),
      a: combine_xyz,
      b: CombineXYZ(x: combine_xyz.x - math_3, y: -1.7320508 * combine_xyz.x - combine_xyz.y) * 0.5)
    math = length(CombineXYZ(x: mix.x - Clamp(value: mix.x, min: -2.0, max: 0.0), y: mix.y))
      * sign(-mix.y)
    math_4 = -(length(max(CombineXYZ(x: math, y: math_2), 0.0)) + min(max(math, math_2), 0.0))
    switch = Clamp ? Clamp(value: math_4) : math_4
  }
  return (Factor: switch)
}
