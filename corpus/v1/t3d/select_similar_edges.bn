geometry graph "Select Similar Edges"(
    Index: Int = 1 in 0..,
    Threshold: Float = 0.001 in 0.0..1.0
) -> (Length: Bool, Direction: Bool, "Adjacent Faces": Bool, "Edge Angle": Bool) {
  "Direction" {
    edge_vertices = EdgeVertices()
    vector_math = edge_vertices.position_1 - edge_vertices.position_2
    compare = Compare[EQUAL](
      a: EvaluateAtIndex[FLOAT_VECTOR](value: vector_math, index: Index) ⋅ vector_math,
      b: 1.0,
      epsilon: Threshold)
  }
  "Length" {
    edge_vertices_2 = EdgeVertices()
    vector_math_2 = distance(edge_vertices_2.position_1, edge_vertices_2.position_2)
    compare_2 = Compare[EQUAL](
      a: EvaluateAtIndex(value: vector_math_2, index: Index),
      b: vector_math_2,
      epsilon: Threshold)
  }
  {
    edge_angle = EdgeAngle()
    compare_3 = Compare[EQUAL](
      a: edge_angle.unsigned_angle,
      b: EvaluateAtIndex(value: edge_angle.unsigned_angle, index: Index),
      epsilon: Threshold)
  }
  {
    edge_neighbors = EdgeNeighbors()
    compare_4 = edge_neighbors == EvaluateAtIndex[INT](value: edge_neighbors, index: Index)
  }
  return (
    Length: compare_2,
    Direction: compare,
    "Adjacent Faces": compare_4,
    "Edge Angle": compare_3)
}
