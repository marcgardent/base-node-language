geometry graph "Mesh To Field"(Mesh: Geometry) -> (Factor: Float) {
  {
    boolean_math = Raycast(Mesh).is_hit
      and Raycast(Mesh, ray_direction: (0.0, 0.0, 1.0)).is_hit
      and (Raycast(Mesh, ray_direction: (0.0, -1.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (0.0, 1.0, 0.0)).is_hit)
      and (Raycast(Mesh, ray_direction: (-1.0, 0.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (1.0, 0.0, 0.0)).is_hit)
  }
  "Field" {
    math = -((boolean_math ? -1.0 : 1.0) * GeometryProximity(Mesh).distance)
  }
  return (Factor: math)
}

geometry graph "Non-Manifold Edge Selection"() -> (
    "Non-Manifold Edge": Bool,
    "Manifold Edge": Bool
) {
  "Manifold / Non-Manifold" {
    edge_neighbors = EdgeNeighbors()
    boolean_math = edge_neighbors > 2 or edge_neighbors == 1
    boolean_math_2 = not boolean_math
  }
  return ("Non-Manifold Edge": boolean_math, "Manifold Edge": boolean_math_2)
}

geometry(is_modifier: true) graph "Parent To Object"(
    Children: Geometry,
    Parent: Object,
    Location: Bool = true,
    Rotation: Bool = true,
    Scale: Bool = true
) -> Geometry {
  {
    object_info = ObjectInfo[RELATIVE](object: Parent)
  }
  {
    vector_math = object_info.location * Location
    vector_math_2 = VectorMath[SCALE](vector: object_info.rotation, scale: Rotation)
    vector_math_3 = object_info.scale * Scale
  }
  "Transformation" {
    set_position = SetPosition(
      Children,
      position: VectorRotate[EULER_XYZ](
          vector: Position() + vector_math,
          center: object_info.location,
          rotation: vector_math_2)
        * vector_math_3)
  }
  return set_position
}

geometry(is_modifier: true) graph Phyllotaxis(
    Points: Int = 750 in 1..,
    Angle: Float(subtype: ANGLE) = 2.3998277 in -6.2831855..6.2831855,
    Radius: Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "Inner Radius": Float,
    Depth: Float(subtype: DISTANCE),
    Falloff: Float = 1.0 in 1.0..10000.0,
    "Point Radius": Float(subtype: DISTANCE) = 0.025 in 0.0..
) -> (Points: Geometry, Normal: Vector, Rotation: Rotation) {
  "Radius" {
    math_2 = sqrt(Index())
    math = math_2 * Radius + (inner_radius + math_2)
  }
  {
    math_4 = Index() * -Angle
  }
  "X" {
    math_3 = cos(math_4) * math
  }
  "Y" {
    math_5 = sin(math_4) * math
  }
  "Depth & Falloff" {
    math_6 = Depth * pow(1.0 - Index() / (Points - 1.0), Falloff)
  }
  "Z" {
    switch = math_6 < 0.0 ? -math_6 : math_6
  }
  "Radius & Angle" {
    resample_curve = CurveLine(end: (0.0, 0.0, 0.0))
      |> ResampleCurve[keep_last_segment: false](count: Points)
  }
  set_position = SetPosition(resample_curve, position: CombineXYZ(x: math_3, y: math_5, z: switch))
  "Accurate Size" {
    bounding_box = BoundingBox(set_position)
    vector_math = CombineXYZ(x: Radius, y: Radius, z: Depth)
      * (2.0, 2.0, 1.0)
      / (bounding_box.max - bounding_box.min)
      * Position()
  }
  "Point Radius" {
    curve_to_points = set_position
      |> SetPosition(position: vector_math)
      |> CurveToPoints[EVALUATED]()
    set_point_radius = SetPointRadius(curve_to_points.points, radius: point_radius)
  }
  return (
    Points: set_point_radius,
    Normal: curve_to_points.normal,
    Rotation: curve_to_points.rotation)
}

geometry(is_modifier: true) graph "Point Grid"(
    "Count X": Int = 3 in 1..,
    "Count Y": Int = 3 in 1..,
    "Count Z": Int = 3 in 1..,
    Spacing: Vector = (1.0, 1.0, 1.0),
    "Point Radius": Float(subtype: DISTANCE) = 0.25 in 0.0..
) -> (Points: Geometry) {
  "Points X" {
    duplicate_elements = Points(radius: point_radius)
      |> DuplicateElements(amount: count_x)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements.duplicate_index,
        Vector_001: Spacing * (1.0, 0.0, 0.0)))
  }
  "Points Y" {
    duplicate_elements_2 = DuplicateElements(set_position, amount: count_y)
    set_position_2 = SetPosition(
      duplicate_elements_2.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_2.duplicate_index,
        Vector_001: Spacing * (0.0, 1.0, 0.0)))
  }
  "Points Z" {
    duplicate_elements_3 = DuplicateElements(set_position_2, amount: count_z)
    set_position_3 = SetPosition(
      duplicate_elements_3.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_3.duplicate_index,
        Vector_001: Spacing * (0.0, 0.0, 1.0)))
  }
  "Center At Origin" {
    bounding_box = BoundingBox(set_position_3)
    set_position_4 = SetPosition(
      set_position_3,
      offset: -Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max))
  }
  return (Points: set_position_4)
}

geometry(is_modifier: true) graph "Point Honeycomb"(
    "Count X": Int = 5 in 2..,
    "Count Y": Int = 5 in 2..,
    "Spacing X": Float = 1.0 in -10000.0..10000.0,
    "Spacing Y": Float = 1.0 in -10000.0..10000.0,
    "Offset X": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    "Offset Y": Float(subtype: FACTOR) in 0.0..1.0,
    "Point Radius": Float(subtype: DISTANCE) = 0.25 in 0.0..
) -> (Points: Geometry) {
  "Points X" {
    duplicate_elements_2 = Points(radius: 0.0)
      |> DuplicateElements(amount: count_x)
    set_position_3 = SetPosition(
      duplicate_elements_2.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_2.duplicate_index,
        Vector_001: CombineXYZ(x: spacing_x)))
  }
  "Points Y" {
    duplicate_elements = DuplicateElements(set_position_3, amount: count_y)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements.duplicate_index,
        Vector_001: CombineXYZ(y: spacing_y)))
  }
  bounding_box = BoundingBox(set_position)
  set_position_5 = SetPosition(set_position, offset: (bounding_box.max - bounding_box.min) * -0.5)
  "Offset X" {
    set_position_2 = SetPosition(
      set_position_5,
      selection: mod(duplicate_elements.duplicate_index, 2.0),
      offset: CombineXYZ(x: MapRange[clamp: false](value: offset_x, to_max: spacing_x)))
  }
  "Offset y" {
    set_position_4 = SetPosition(
      set_position_2,
      selection: mod(duplicate_elements_2.duplicate_index, 2.0),
      offset: CombineXYZ(y: MapRange[clamp: false](value: offset_y, to_max: spacing_y)))
  }
  {
    set_point_radius = SetPointRadius(set_position_4, radius: point_radius)
  }
  return (Points: set_point_radius)
}

geometry(is_modifier: true) graph "Poke Faces"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Depth: Float(subtype: DISTANCE)
) -> (Mesh: Geometry, "New Vertices": Bool) {
  "Initial Index" {
    capture_attribute = CaptureAttribute(Mesh, Value: Index())
  }
  "Poke" {
    extrude_mesh = ExtrudeMesh(
      capture_attribute.geometry,
      selection: Selection,
      offset_scale: Depth)
    merge_by_distance = extrude_mesh.mesh
      |> ScaleElements(selection: extrude_mesh.top, scale: 0.0)
      |> MergeByDistance(selection: extrude_mesh.top, mode: Connected, distance: 0.0005)
  }
  "New Vertices" {
    capture_attribute_2 = CaptureAttribute(
      merge_by_distance,
      Value: Index() - capture_attribute.value > 0.0)
  }
  return (Mesh: capture_attribute_2.geometry, "New Vertices": capture_attribute_2.value)
}

geometry graph "Prism Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION),
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    vector_math = RotateVector(
        vector: Position() - Location,
        rotation: InvertRotation(rotation: Rotation))
      / (Scale * 0.5)
  }
  "SDF Prism" {
    vector_math_2 = vector_math / (0.866025, 0.866025, 1.0)
    math_2 = abs(vector_math_2.z) - Scale.z * 0.5
    combine_xyz = CombineXYZ(x: abs(vector_math_2.x) - 1.0, y: vector_math_2.y + 0.57735026)
    math_3 = 1.7320508 * combine_xyz.y
    mix = Mix[VECTOR](
      factor: Math[GREATER_THAN](Value: combine_xyz.x + math_3, Value_001: 0.0),
      a: combine_xyz,
      b: CombineXYZ(x: combine_xyz.x - math_3, y: -1.7320508 * combine_xyz.x - combine_xyz.y) * 0.5)
    math = length(CombineXYZ(x: mix.x - Clamp(value: mix.x, min: -2.0, max: 0.0), y: mix.y))
      * sign(-mix.y)
    math_4 = -(length(max(CombineXYZ(x: math, y: math_2), 0.0)) + min(max(math, math_2), 0.0))
    switch = Clamp ? Clamp(value: math_4) : math_4
  }
  return (Factor: switch)
}

geometry(is_modifier: true) graph "Radial Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Count: Int = 32 in 3..10000,
    "Radius X": Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "Radius Y": Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "End Angle": Float(subtype: ANGLE) = 6.2831855 in 0.0..6.2831855,
    "Offset Angle": Float(subtype: ANGLE),
    "Options"(default_closed: true) {
        "Align Rotation": Bool = true,
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "Point Ellipse" {
    duplicate_elements = Points()
      |> DuplicateElements(amount: Count)
    map_range = MapRange[clamp: false](
      value: duplicate_elements.duplicate_index,
      from_max: Count,
      to_max: end_angle)
    vector_rotate = VectorRotate[Z_AXIS](
      vector: CombineXYZ(x: sin(map_range), y: cos(map_range)),
      angle: offset_angle)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: vector_rotate * CombineXYZ(x: radius_x, y: radius_y))
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index,
      rotation: AlignRotationToVector[axis: X](factor: align_rotation, vector: vector_rotate))
  }
  return (Instances: instance_on_points)
}

geometry graph "Replace Vector"(
    Menu: Menu(force_non_field: true, optional_label: true, structure_type: SINGLE) = X,
    Vector: Vector(hide_value: true),
    Value: Float
) -> Vector {
  {
    menu_switch = MenuSwitch(
      menu: Menu,
      X: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (0.0, 1.0, 1.0),
        Vector_002: CombineXYZ(x: Value)),
      Y: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (1.0, 0.0, 1.0),
        Vector_002: CombineXYZ(y: Value)),
      Z: VectorMath[MULTIPLY_ADD](
        Vector: Vector,
        Vector_001: (1.0, 1.0, 0.0),
        Vector_002: CombineXYZ(z: Value)))
  }
  return menu_switch.output
}

geometry graph "Scalar Matrix"(Value: Float = 1.0) -> Matrix {
  return CombineMatrix(
    column_1_row_1: Value,
    column_2_row_2: Value,
    column_3_row_3: Value,
    column_4_row_4: Value)
}

geometry graph "Seamless Vector"(
    Position: Vector(hide_value: true) = Position() in -10000.0..10000.0
) -> (Vector: Vector, W: Float) {
  "Loop" {
    vector_math = Position * 6.2831855
    combine_xyz = CombineXYZ(x: sin(vector_math.x), y: cos(vector_math.x), z: sin(vector_math.y))
    math = cos(vector_math.y)
  }
  return (Vector: combine_xyz, W: math)
}

geometry graph "Select Similar Edges"(
    Index: Int = 1 in 0..,
    Threshold: Float = 0.001 in 0.0..1.0
) -> (Length: Bool, Direction: Bool, "Adjacent Faces": Bool, "Edge Angle": Bool) {
  "Direction" {
    edge_vertices = EdgeVertices()
    vector_math = edge_vertices.position_1 - edge_vertices.position_2
    compare = Compare[EQUAL](
      a: EvaluateAtIndex[FLOAT_VECTOR](value: vector_math, index: Index) ⋅ vector_math,
      b: 1.0,
      epsilon: Threshold)
  }
  "Length" {
    edge_vertices_2 = EdgeVertices()
    vector_math_2 = distance(edge_vertices_2.position_1, edge_vertices_2.position_2)
    compare_2 = Compare[EQUAL](
      a: EvaluateAtIndex(value: vector_math_2, index: Index),
      b: vector_math_2,
      epsilon: Threshold)
  }
  {
    edge_angle = EdgeAngle()
    compare_3 = Compare[EQUAL](
      a: edge_angle.unsigned_angle,
      b: EvaluateAtIndex(value: edge_angle.unsigned_angle, index: Index),
      epsilon: Threshold)
  }
  {
    edge_neighbors = EdgeNeighbors()
    compare_4 = edge_neighbors == EvaluateAtIndex[INT](value: edge_neighbors, index: Index)
  }
  return (
    Length: compare_2,
    Direction: compare,
    "Adjacent Faces": compare_4,
    "Edge Angle": compare_3)
}

geometry graph "Select Similar Faces"(
    Index: Int = 1 in 0..,
    Thershold: Float = 0.001 in 0.0..1.0
) -> (
    Material: Bool,
    "Face Area": Bool,
    "Polygon Sides": Bool,
    Normal: Bool,
    Coplanar: Bool,
    "Flat / Smooth": Bool(attribute_domain: FACE)
) {
  "Material" {
    material_index = MaterialIndex()
    compare_3 = material_index == EvaluateAtIndex[FACE, INT](value: material_index, index: Index)
  }
  "Face Area" {
    face_area = FaceArea()
    compare = Compare[EQUAL](
      a: face_area,
      b: EvaluateAtIndex[FACE](value: face_area, index: Index),
      epsilon: Thershold)
  }
  "Polygon Sides" {
    face_neighbors = FaceNeighbors()
    compare_2 = face_neighbors.vertex_count
      == EvaluateAtIndex[FACE, INT](value: face_neighbors.vertex_count, index: Index)
  }
  "Normal" {
    normal = Normal[legacy_corner_normals: true]()
    evaluate_at_index = EvaluateAtIndex[FACE, FLOAT_VECTOR](value: normal.normal, index: Index)
    compare_4 = Compare[EQUAL](a: evaluate_at_index ⋅ normal.normal, b: 1.0, epsilon: Thershold)
  }
  "Coplanar" {
    position = Position()
    boolean_math = compare_4
      and Compare[EQUAL](
        a: (EvaluateAtIndex[FACE, FLOAT_VECTOR](value: position, index: Index) - position)
          ⋅ evaluate_at_index,
        epsilon: Thershold)
  }
  "Flat / Smooth" {
    is_face_smooth = IsFaceSmooth()
    evaluate_on_domain = EvaluateOnDomain[FACE, BOOLEAN](
      value: Compare[EQUAL, INT](
        a: EvaluateAtIndex[FACE, BOOLEAN](value: is_face_smooth, index: Index),
        b: is_face_smooth))
  }
  return (
    Material: compare_3,
    "Face Area": compare,
    "Polygon Sides": compare_2,
    Normal: compare_4,
    Coplanar: boolean_math,
    "Flat / Smooth": evaluate_on_domain)
}

geometry graph "Select Similar Vertices"(
    Index: Int = 1 in 0..,
    Threshold: Float = 0.001 in 0.0..1.0
) -> (Normal: Bool, "Adjacent Edges": Bool, "Adjacent Faces": Bool) {
  {
    vertex_neighbors = VertexNeighbors()
    compare = vertex_neighbors.vertex_count
      == EvaluateAtIndex[INT](value: vertex_neighbors.vertex_count, index: Index)
  }
  {
    vertex_neighbors_2 = VertexNeighbors()
    compare_2 = vertex_neighbors_2.face_count
      == EvaluateAtIndex[INT](value: vertex_neighbors_2.face_count, index: Index)
  }
  {
    normal = Normal[legacy_corner_normals: true]()
    compare_3 = Compare[EQUAL](
      a: EvaluateAtIndex[FLOAT_VECTOR](value: normal.normal, index: Index) ⋅ normal.normal,
      b: 1.0,
      epsilon: Threshold)
  }
  return (Normal: compare_3, "Adjacent Edges": compare, "Adjacent Faces": compare_2)
}

geometry(is_modifier: true) graph "Set Geometry Size"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Menu: Menu(optional_label: true) = Proportional,
    Size: Vector(subtype: TRANSLATION) = (1.0, 1.0, 1.0) in 0.0..
) -> Geometry {
  {
    bounding_box_2 = BoundingBox(Geometry)
    set_position = SetPosition(
      Geometry,
      selection: Selection,
      position: MapRange[FLOAT_VECTOR](
        vector: Position(),
        from_min: bounding_box_2.min,
        from_max: bounding_box_2.max,
        to_max: Size))
    bounding_box = BoundingBox(set_position)
    set_position_2 = SetPosition(
      set_position,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](factor: 0.5, a: bounding_box.min, b: bounding_box.max))
  }
  {
    bounding_box_3 = BoundingBox(Geometry)
    vector_math = bounding_box_3.max - bounding_box_3.min
    set_position_3 = SetPosition(
      Geometry,
      position: Size / max(max(vector_math.x, vector_math.y), vector_math.z) * Position())
  }
  {
    menu_switch = MenuSwitch(menu: Menu, Fit: set_position_2, Proportional: set_position_3)
    bounding_box_4 = BoundingBox(menu_switch.output)
    set_position_4 = SetPosition(
      menu_switch.output,
      selection: Selection,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](
          factor: 0.5,
          a: bounding_box_4.min,
          b: bounding_box_4.max))
  }
  return set_position_4
}

geometry(is_modifier: true) graph "Set Geometry Visibility"(
    Viewport: Geometry,
    Render: Geometry,
    "Preview Render": Bool
) -> Geometry {
  "Viewport" {
    switch = IsViewport() ? Viewport : Render
  }
  "Render View" {
    switch_2 = preview_render ? Render : switch
  }
  return switch_2
}

geometry(is_modifier: true) graph Shear(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int = 1 in 1..3,
    Strength: Float = 0.5,
    Angle: Float(subtype: ANGLE),
    "Mid-Level": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    "Limit Lower": Float(subtype: FACTOR) in 0.0..1.0,
    "Limit Higher": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Smoothness: Float(subtype: FACTOR) in 0.0..1.0
) -> Geometry {
  "Strength" {
    bounding_box = BoundingBox(Geometry)
    math_2 = Strength * -1.0000001
    math = VectorRotate[Y_AXIS, invert: true](vector: Position(), angle: 1.5707964).x * math_2
      + math_2
        * (MapRange[clamp: false](value: mid_level, to_min: -1.0)
          * ((bounding_box.max - bounding_box.min) * 0.5).z)
  }
  "Limits" {
    attribute_statistic = AttributeStatistic(Geometry, attribute: math)
    mix = Mix(factor: limit_lower, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_2 = Mix(factor: limit_higher, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_3 = Mix(
      factor: Smoothness,
      a: MapRange(
        value: math,
        from_min: mix,
        from_max: mix_2,
        to_min: attribute_statistic.min,
        to_max: attribute_statistic.max),
      b: MapRange[SMOOTHERSTEP](
        value: math,
        from_min: mix,
        from_max: mix_2,
        to_min: attribute_statistic.min,
        to_max: attribute_statistic.max))
  }
  "Axis" {
    combine_xyz = CombineXYZ(x: x_y_z == 1, y: x_y_z == 2, z: x_y_z == 3)
  }
  "Angle" {
    vector_rotate = VectorRotate[Z_AXIS](
      vector: VectorMath[MULTIPLY](Vector: mix_3, Vector_001: combine_xyz),
      angle: Angle)
  }
  {
    set_position = SetPosition(Geometry, selection: Selection, offset: vector_rotate)
  }
  return set_position
}

geometry(is_modifier: true) graph "Smooth Geometry"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Iterations: Int = 16 in 0..,
    Stiffness: Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Strength: Float = 1.0 in 0.0..
) -> Geometry {
  {
    position = Position()
    blur_attribute = BlurAttribute[FLOAT_VECTOR](
      value: position,
      iterations: Iterations,
      weight: Strength)
    mix = Mix[VECTOR, NON_UNIFORM](
      factor: Strength,
      a: position,
      b: Mix[VECTOR](
        factor: Stiffness,
        a: blur_attribute,
        b: (blur_attribute + EvaluateOnDomain[FACE, FLOAT_VECTOR](value: position)) * 0.5))
  }
  {
    separate_components = SeparateComponents(Geometry)
  }
  {
    separate_components_2 = SeparateComponents(Geometry)
  }
  {
    capture_attribute_2 = CaptureAttribute(
      separate_components_2.curve,
      Value: SplineLength().length)
    capture_attribute = capture_attribute_2.geometry
      |> SetPosition(position: mix)
      |> CaptureAttribute(Value: SplineLength().length)
    set_handle_type = capture_attribute.geometry
      |> SetPosition(
        selection: Selection,
        position: Position() * (capture_attribute_2.value / capture_attribute.value))
      |> SetSplineType[BEZIER]()
      |> SetHandleType()
  }
  {
    set_position = SetPosition(separate_components_2.mesh, selection: Selection, position: mix)
  }
  {
    join_geometry = set_position
      + set_handle_type
      + separate_components.point_cloud
      + separate_components.volume
  }
  return join_geometry
}

geometry graph "Spherical Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION) in -10000.0..10000.0,
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    vector_math = RotateVector(
        vector: Position() - Location,
        rotation: InvertRotation(rotation: Rotation))
      / (Scale * 0.5)
  }
  "SDF Sphere" {
    gradient_texture = GradientTexture[SPHERICAL](vector: vector_math)
    switch = Clamp ? Clamp(value: gradient_texture.factor) : gradient_texture.factor
  }
  return (Factor: switch)
}

geometry(is_modifier: true) graph "Spherical Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Count: Int = 32 in 3..100000,
    Rotations: Float = 75.0 in -10000.0..10000.0,
    Radius: Float = 1.0 in -10000.0..10000.0,
    "Options"(default_closed: true) {
        "Align Rotation": Bool = true,
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "Spiral Curve" {
    math = Rotations * SplineParameter().factor
    vector_rotate = VectorRotate[EULER_XYZ](
      vector: CombineXYZ(x: sin(math), y: cos(math)),
      rotation: AlignEulerToVector[axis: Z](vector: CurveTangent()))
  }
  "Spherical Spiral" {
    vector_math_2 = Position() + (vector_rotate + (0.0, 0.0, -1.57))
    math_2 = cos(vector_math_2.z)
    vector_math = CombineXYZ(
        x: vector_math_2.x * math_2,
        y: math_2 * vector_math_2.y,
        z: sin(vector_math_2.z))
      * Radius
  }
  "Count" {
    resample_curve = CurveLine(end: (0.0, 0.0, 3.1415927))
      |> ResampleCurve[keep_last_segment: false](count: Count)
  }
  set_position = SetPosition(resample_curve, position: vector_math)
  "Align Rotation" {
    align_rotation_to_vector = AlignRotationToVector[axis: Y](
      factor: align_rotation,
      vector: -Normal[legacy_corner_normals: true]().normal)
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index,
      rotation: align_rotation_to_vector)
  }
  return (Instances: instance_on_points)
}

geometry graph "Spherical to Cartesian"(
    "ρ, θ, φ": Vector in -10000.0..10000.0
) -> ("x,y,z": Vector) {
  "to cartesian" {
    math = ρ_θ_φ.x * (sin(ρ_θ_φ.y) * sin(ρ_θ_φ.z))
    math_2 = ρ_θ_φ.x * (cos(ρ_θ_φ.y) * sin(ρ_θ_φ.z))
    math_3 = ρ_θ_φ.x * cos(ρ_θ_φ.z)
  }
  return ("x,y,z": CombineXYZ(x: math_2, y: math, z: math_3))
}

geometry(is_modifier: true) graph Spherify(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Strength: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Preserve Area": Bool = true
) -> (Mesh: Geometry) {
  "Input" {
    split_edges = SplitEdges(Mesh, selection: Selection)
  }
  "Preserve Face Area" {
    face_area = FaceArea()
  }
  "Boundary Edge" {
    compare = EdgeNeighbors() == 1
  }
  "Field Sphere" {
    bounding_box = BoundingBox(split_edges)
    vector_math = normalize(Position())
      * Math[INVERSE_SQRT](value: abs(bounding_box.min - bounding_box.max))
  }
  "Deform Position " {
    set_position = SetPosition(
      split_edges,
      selection: Selection,
      position: Mix[VECTOR](factor: Strength, a: Position(), b: vector_math))
  }
  "Preserve Face Area" .. {
    merge_by_distance = set_position
      |> SetPosition(
        selection: preserve_area,
        position: Position()
          * sqrt(
            AttributeStatistic[FACE](split_edges, attribute: face_area).sum
              / AttributeStatistic[FACE](set_position, attribute: face_area).sum))
      |> MergeByDistance(selection: compare)
  }
  return (Mesh: merge_by_distance)
}

geometry(is_modifier: true) graph Spirograph(
    Resolution: Int = 1024 in 3..10000,
    Turns: Int = 5 in 3..,
    Radius: Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "Inner Radius": Float = 0.5 in 0.0..10000.0
) -> (Curve: Geometry) {
  "Turns " {
    value = 6.28319 @ "tau"
    math = Index() * (value / Resolution)
    math_2 = math * (-Turns + 1.0)
    math_3 = value / 10.0 + math
  }
  "Inner & Outer Radius" {
    vector_math = VectorMath[MULTIPLY](
      Vector: CombineXYZ(x: sin(math_3), y: cos(math_3))
        + VectorMath[MULTIPLY](
          Vector: CombineXYZ(x: sin(math_2), y: cos(math_2)),
          Vector_001: inner_radius),
      Vector_001: Radius / (inner_radius + 1.0))
  }
  "Output" {
    set_position = CurveCircle(resolution: Resolution)
      |> SetPosition(position: vector_math)
  }
  "Inner & Outer Radius" .. {
    return (Curve: set_position)
  }
}

geometry graph Stretch(
    Geometry: Geometry,
    Selection: Bool(hide_value: true) = true,
    Strength: Vector,
    Offset: Vector in -1.0..1.0,
    "Mid-Level": Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> Geometry {
  {
    vector_math = Strength * (1.0, 0.0, 0.0) * 0.5
  }
  {
    vector_math_2 = Strength * (0.0, 1.0, 0.0) * 0.5
  }
  {
    vector_math_3 = Strength * (0.0, 0.0, 1.0) * 0.5
  }
  {
    bounding_box = BoundingBox(Geometry)
    map_range = MapRange[FLOAT_VECTOR](
      vector: Position(),
      from_min: bounding_box.min,
      from_max: bounding_box.max,
      to_min: (-1.0, -1.0, -1.0))
  }
  {
    switch = map_range.x >= Offset.x ? vector_math : -vector_math
  }
  {
    switch_2 = map_range.y >= Offset.y ? vector_math_2 : -vector_math_2
  }
  {
    switch_3 = map_range.z >= Offset.z ? vector_math_3 : -vector_math_3
  }
  {
    vector_math_4 = switch
      + switch_2
      + switch_3
      + Strength * Math[MULTIPLY_ADD](Value: mid_level, Value_001: -1.0)
  }
  {
    return SetPosition(Geometry, selection: Selection, offset: vector_math_4)
  }
}

geometry(is_modifier: true) graph "Sweep Curve"(
    Curve: Geometry,
    "Profile Curve": Geometry,
    "Fill Caps": Bool = true
) -> (Mesh: Geometry, UV: Vector(attribute_domain: CORNER)) {
  {
    position = Position()
    spline_parameter = SplineParameter()
    spline_parameter_2 = SplineParameter()
    capture_attribute_2 = CaptureAttribute(
      profile_curve,
      Factor: spline_parameter_2.factor,
      Index: spline_parameter_2.index)
    named_attribute = NamedAttribute(name: "radius")
  }
  {
    position_2 = Position()
    vector_math = normalize(
      EvaluateAtIndex[FLOAT_VECTOR](
          value: position_2,
          index: OffsetPointInCurve(offset: -1).point_index)
        - position_2)
    vector_math_2 = normalize(
      EvaluateAtIndex[FLOAT_VECTOR](
          value: position_2,
          index: OffsetPointInCurve(offset: 1).point_index)
        - position_2)
    vector_math_3 = normalize(vector_math + vector_math_2)
    math = 2.0 / distance(vector_math, vector_math_2) - 1.0
  }
  {
    capture_attribute = CaptureAttribute(
      Curve,
      Position: position,
      Direction: vector_math_3,
      "Scale Factor": math,
      Factor: spline_parameter.factor,
      Index: spline_parameter.index)
  }
  {
    evaluate_on_domain = EvaluateOnDomain[FACE, INT](value: capture_attribute_2.index)
    evaluate_on_domain_2 = EvaluateOnDomain[FACE, INT](value: capture_attribute.index)
    combine_xyz = CombineXYZ(
      x: evaluate_on_domain_2 > 1 and evaluate_on_domain_2 == 0 ? 1.0 : capture_attribute.factor,
      y: evaluate_on_domain > 1 and evaluate_on_domain == 0 ? 1.0 : capture_attribute_2.factor)
  }
  {
    capture_attribute_3 = capture_attribute.geometry
      |> CurveToMesh(
        profile_curve: capture_attribute_2.geometry,
        scale: named_attribute.exists ? named_attribute.attribute : 1.0,
        fill_caps: fill_caps)
      |> SetPosition(
        offset: capture_attribute.direction
          * (((position - capture_attribute.position) ⋅ capture_attribute.direction)
            * capture_attribute.scale_factor))
      |> SetShadeSmooth(shade_smooth: false)
      |> CaptureAttribute[CORNER](Vector: combine_xyz)
  }
  return (Mesh: capture_attribute_3.geometry, UV: capture_attribute_3.vector)
}

geometry(is_modifier: true) graph Taper(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int = 3 in 1..3,
    "Factor Lower": Float = 0.5,
    "Factor Higher": Float,
    "Limit Lower": Float(subtype: FACTOR) in 0.0..1.0,
    "Limit Higher": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Smoothing: Float(subtype: FACTOR) in 0.0..1.0
) -> Geometry {
  "Limits" {
    math = factor_lower + 1.0
    math_2 = factor_higher + 1.0
  }
  "Axis" {
    rotation_to_euler = RotationToEuler(
      rotation: AlignRotationToVector(
        vector: CombineXYZ(x: x_y_z == 1, y: x_y_z == 2, z: x_y_z == 3)))
    vector_rotate_2 = VectorRotate[EULER_XYZ, invert: true](
      vector: Position(),
      rotation: rotation_to_euler)
  }
  "Limits" .. {
    attribute_statistic = AttributeStatistic(Geometry, attribute: vector_rotate_2.z)
    mix = Mix(factor: limit_lower, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_2 = Mix(factor: limit_higher, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_3 = Mix(
      factor: Smoothing,
      a: MapRange(
        value: vector_rotate_2.z,
        from_min: mix,
        from_max: mix_2,
        to_min: math,
        to_max: math_2),
      b: MapRange[SMOOTHERSTEP](
        value: vector_rotate_2.z,
        from_min: mix,
        from_max: mix_2,
        to_min: math,
        to_max: math_2))
  }
  "Deformation" {
    vector_rotate = VectorRotate[EULER_XYZ](
      vector: VectorMath[MULTIPLY_ADD](
        Vector: vector_rotate_2 * (1.0, 1.0, 0.0),
        Vector_001: mix_3,
        Vector_002: vector_rotate_2 * (0.0, 0.0, 1.0)),
      rotation: rotation_to_euler)
  }
  {
    set_position = SetPosition(Geometry, selection: Selection, position: vector_rotate)
  }
  return set_position
}

geometry graph "Torus Field"(
    Clamp: Bool = true,
    "Minor Radius": Float = 0.5 in 0.0..,
    "Major Radius": Float = 0.7 in 0.0..,
    Location: Vector(subtype: TRANSLATION) in -10000.0..10000.0,
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    rotate_vector = RotateVector(
      vector: RotateVector(
          vector: Position() - Location,
          rotation: InvertRotation(rotation: Rotation))
        / (Scale * 0.4999999),
      rotation: (1.5707964, 0.0, 0.0))
  }
  "Torus Field" {
    math = -(length(
        CombineXYZ(
          x: length(CombineXYZ(x: rotate_vector.x, z: rotate_vector.z)) - major_radius,
          y: rotate_vector.y))
      - minor_radius)
    switch = Clamp ? Clamp(value: math) : math
  }
  return (Factor: switch)
}

geometry graph "Trace Matrix"(Matrix: Matrix) -> (Value: Float) {
  {
    separate_matrix = SeparateMatrix(matrix: Matrix)
    math = separate_matrix.column_1_row_1
      + separate_matrix.column_2_row_2
      + separate_matrix.column_3_row_3
      + separate_matrix.column_4_row_4
  }
  return (Value: math)
}

geometry graph "Triangular Matrix"(
    Matrix: Matrix,
    Socket: Menu(optional_label: true) = "Upper Triangular"
) -> Matrix {
  separate_matrix = SeparateMatrix(matrix: Matrix)
  separate_matrix_2 = SeparateMatrix(matrix: Matrix)
  return MenuSwitch(
    menu: Socket,
    "Upper Triangular": CombineMatrix(
      column_1_row_1: separate_matrix.column_1_row_1,
      column_1_row_2: separate_matrix.column_1_row_2,
      column_1_row_3: separate_matrix.column_1_row_3,
      column_1_row_4: separate_matrix.column_1_row_4,
      column_2_row_2: separate_matrix.column_2_row_2,
      column_2_row_3: separate_matrix.column_2_row_3,
      column_2_row_4: separate_matrix.column_2_row_4,
      column_3_row_3: separate_matrix.column_3_row_3,
      column_3_row_4: separate_matrix.column_3_row_4,
      column_4_row_4: separate_matrix.column_4_row_4),
    "Lower Triangular": CombineMatrix(
      column_1_row_1: separate_matrix_2.column_1_row_1,
      column_2_row_1: separate_matrix_2.column_2_row_1,
      column_2_row_2: separate_matrix_2.column_2_row_2,
      column_3_row_1: separate_matrix_2.column_3_row_1,
      column_3_row_2: separate_matrix_2.column_3_row_2,
      column_3_row_3: separate_matrix_2.column_3_row_3,
      column_4_row_1: separate_matrix_2.column_4_row_1,
      column_4_row_2: separate_matrix_2.column_4_row_2,
      column_4_row_3: separate_matrix_2.column_4_row_3,
      column_4_row_4: separate_matrix_2.column_4_row_4)).output
}

geometry(is_modifier: true) graph Twist(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int = 3 in 1..3,
    "Angle Lower": Float(subtype: ANGLE) = 0.7853982,
    "Angle Higher": Float(subtype: ANGLE) = -0.7853982,
    "Limit Lower": Float(subtype: FACTOR) in 0.0..1.0,
    "Limit Higher": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Smoothness: Float(subtype: FACTOR) in 0.0..1.0
) -> Geometry {
  "Axis" {
    switch = x_y_z == 3 ? CombineXYZ(z: 1.0) : x_y_z == 2 ? CombineXYZ(y: 1.0) : CombineXYZ(x: 1.0)
  }
  {
    vector_math = switch ⋅ Position()
  }
  "Limits" {
    attribute_statistic = AttributeStatistic(Geometry, attribute: vector_math)
    mix = Mix(factor: limit_higher, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_2 = Mix(factor: limit_lower, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_3 = Mix(
      factor: Smoothness,
      a: MapRange(
        value: vector_math,
        from_min: mix_2,
        from_max: mix,
        to_min: angle_lower,
        to_max: angle_higher),
      b: MapRange[SMOOTHERSTEP](
        value: vector_math,
        from_min: mix_2,
        from_max: mix,
        to_min: angle_lower,
        to_max: angle_higher))
  }
  "Deform" {
    set_position = SetPosition(
      Geometry,
      selection: Selection,
      position: VectorRotate(vector: Position(), angle: mix_3))
  }
  return set_position
}

geometry(is_modifier: true) graph "UV Deform"(
    "Target Mesh": Geometry,
    "Sample Mesh": Geometry,
    Strength: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Target UV": Vector(hide_value: true),
    "Sample UV": Vector
) -> (Mesh: Geometry, Position: Vector) {
  {
    position = Position()
    sample_uvsurface = SampleUVSurface[FLOAT_VECTOR](
      sample_mesh,
      value: position,
      uv_map: sample_uv,
      sample_uv: target_uv)
    set_position = SetPosition(
      target_mesh,
      position: Mix[VECTOR](factor: Strength, a: position, b: sample_uvsurface.value))
  }
  return (Mesh: set_position, Position: sample_uvsurface.value)
}

geometry graph "UV Displace"(
    "UV Map": Vector(hide_value: true) in 0.0..1.0,
    Displacement: Vector(hide_value: true) in 0.0..1.0,
    "U Strength": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "V Strength": Float(subtype: FACTOR) = 1.0 in 0.0..1.0
) -> ("UV Map": Vector(attribute_domain: CORNER)) {
  {
    vector_math = uv_map
      * MapRange[SMOOTHSTEP, FLOAT_VECTOR](
        vector: Displacement,
        from_min: (-1.0, -1.0, 0.0),
        from_max: (1.0, 1.0, 0.0),
        to_max: (1.0, 1.0, 0.0))
  }
  {
    mix = Mix[VECTOR, NON_UNIFORM](
      factor: CombineXYZ(x: u_strength, y: v_strength),
      a: uv_map,
      b: vector_math)
  }
  return ("UV Map": mix)
}

geometry(is_modifier: true) graph "UV Project"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Rotation: Rotation
) -> (Mesh: Geometry, "UV Map": Vector(attribute_domain: CORNER)) {
  {
    set_position = Mesh
      |> SplitEdges(selection: Selection)
      |> SetPosition(
        selection: Selection,
        position: RotateVector(vector: Position(), rotation: Rotation) * (1.0, 1.0, 0.0))
  }
  "Size" {
    bounding_box = BoundingBox(set_position)
    vector_math = bounding_box.max - bounding_box.min
    set_position_2 = SetPosition(
      set_position,
      selection: Selection,
      position: VectorMath[MULTIPLY](
        Vector: 1.0 / max(max(vector_math.x, vector_math.y), vector_math.z),
        Vector_001: Position()))
  }
  {
    capture_attribute = CaptureAttribute[CORNER](
      Mesh,
      Value: set_position_2
        |> SetPosition(offset: -BoundingBox(set_position_2).min)
        |> SampleIndex[FLOAT_VECTOR, CORNER, clamp: true](value: Position(), index: Index()))
    return (Mesh: capture_attribute.geometry, "UV Map": capture_attribute.value)
  }
}

geometry(is_modifier: true) graph "UV To Mesh"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "UV Map": Vector(description: "By default uses UVMap", hide_value: true),
    Strength: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Preserve Area": Bool = true,
    "Center At Origin": Bool = true
) -> (Mesh: Geometry, "UV Map": Vector(attribute_domain: CORNER)) {
  "Preserve Face Area" {
    face_area = FaceArea()
  }
  "Edge Split" {
    capture_attribute = Mesh
      |> SplitEdges(selection: Selection)
      |> CaptureAttribute[CORNER](Value: uv_map)
  }
  "Preserve Face Area" .. {
    vector_math_2 = capture_attribute.value
      * sqrt(
        AttributeStatistic(capture_attribute.geometry, attribute: face_area).sum
          / (capture_attribute.geometry
            |> SetPosition(position: capture_attribute.value)
            |> AttributeStatistic(attribute: face_area).sum))
  }
  {
    set_position_2 = SetPosition(
      capture_attribute.geometry,
      position: preserve_area ? vector_math_2 : capture_attribute.value)
  }
  {
    bounding_box = BoundingBox(set_position_2)
    vector_math = Position()
      + Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max) * -center_at_origin
  }
  {
    sample_index = SampleIndex[FLOAT_VECTOR, clamp: true](
      capture_attribute.geometry,
      value: Position(),
      index: Index())
  }
  {
    set_position = SetPosition(
      set_position_2,
      position: Mix[VECTOR](factor: Strength, a: sample_index, b: vector_math))
  }
  return (Mesh: set_position, "UV Map": capture_attribute.value)
}

geometry graph "Vector Clamp"(
    Vector: Vector in -10000.0..10000.0,
    Min: Vector in -10000.0..10000.0,
    Max: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> Vector {
  "Clamping" {
    combine_xyz = CombineXYZ(
      x: Clamp(value: Vector.x, min: Min.x, max: Max.x),
      y: Clamp(value: Vector.y, min: Min.y, max: Max.y),
      z: Clamp(value: Vector.z, min: Min.z, max: Max.z))
  }
  return combine_xyz
}

geometry graph "Vector Mapping"(
    Invert: Bool,
    Vector: Vector(hide_value: true) = Position() in -10000.0..10000.0,
    Translation: Vector(subtype: TRANSLATION),
    Rotation: Rotation,
    Scale: Vector(subtype: XYZ) = (1.0, 1.0, 1.0)
) -> Vector {
  "Mapping" {
    switch = Invert
      ? RotateVector(vector: Vector - Translation, rotation: InvertRotation(rotation: Rotation))
        / Scale
      : RotateVector(vector: Vector + Translation, rotation: Rotation) * Scale
  }
  return switch
}

geometry(is_modifier: true) graph "Vertex Slide"(
    Mesh: Geometry,
    Factor: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Vertex Index": Int in 0..,
    Value: Int
) -> (Mesh: Geometry) {
  {
    compare = Index() == vertex_index
  }
  {
    position = Position()
  }
  math = DomainSize(Mesh).point_count - 1.0
  .. {
    mix = Mix[VECTOR, clamp_factor: false](
      factor: Factor,
      a: position,
      b: EvaluateAtIndex[FLOAT_VECTOR](
        value: position,
        index: IndexOfNearest().index + mod(Value, math)))
  }
  {
    set_position = SetPosition(Mesh, selection: compare, position: mix)
  }
  return (Mesh: set_position)
}

geometry graph "Vertex of Edge"(
    "Edge Index": Int(hide_value: true) = Index(),
    Weights: Float(hide_value: true)
) -> ("Vertex Index 1": Int, "Vertex Index 2": Int) {
  {
    corners_of_edge = CornersOfEdge(edge_index: edge_index, weights: Weights, sort_index: 1)
    vertex_of_corner = VertexOfCorner(corner_index: corners_of_edge.corner_index)
    vertex_of_corner_2 = VertexOfCorner(
      corner_index: OffsetCornerInFace(corner_index: corners_of_edge.corner_index, offset: 1))
    compare = EvaluateAtIndex(value: Weights, index: vertex_of_corner)
      > EvaluateAtIndex(value: Weights, index: vertex_of_corner_2)
    switch = compare ? vertex_of_corner_2 : vertex_of_corner
    switch_2 = not compare ? vertex_of_corner_2 : vertex_of_corner
  }
  return ("Vertex Index 1": switch, "Vertex Index 2": switch_2)
}

geometry graph easeBack(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  boolean_math = EaseIn and EaseOut @ hide
  {
    math = pow(Value, 3.0) * 2.70158 - pow(Value, 2.0) * 1.70158
  }
  switch = EaseIn ? math : Value @ hide
  {
    math_2 = Math[MULTIPLY_ADD](
      Value: pow(Value - 1.0, 2.0),
      Value_001: 1.70158,
      Value_002: Math[MULTIPLY_ADD](
        Value: pow(Value - 1.0, 3.0),
        Value_001: 2.70158,
        Value_002: 1.0))
  }
  switch_2 = EaseOut ? math_2 : switch @ hide
  {
    compare = Value < 0.5 @ hide
    switch_4 = compare
      ? (Value * 7.18982 - 2.59491) * pow(Value * 2.0, 2.0) / 2.0
      : Math[MULTIPLY_ADD](
          Value: Math[MULTIPLY_ADD](
            Value: 2.0 * Value - 2.0,
            Value_001: 3.59491,
            Value_002: 2.59491),
          Value_001: pow(2.0 * Value - 2.0, 2.0),
          Value_002: 2.0)
        / 2.0
  }
  switch_3 = boolean_math ? switch_4 : switch_2 @ hide
  return (Value: switch_3)
}

geometry graph easeBounce(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  boolean_math = EaseIn and EaseOut @ hide
  {
    compare = Value < 0.36363637 @ hide
    compare_2 = Value < 0.72727275 @ hide
    compare_3 = Value < 0.90909094 @ hide
    math = Value - 0.818182
    switch_4 = compare
      ? pow(Value, 2.0) * 7.5625
      : compare_2
        ? Math[MULTIPLY_ADD](
          Value: (Value - 0.54545456) * 7.5625,
          Value_001: Value - 0.54545456,
          Value_002: 0.75)
        : compare_3
          ? Math[MULTIPLY_ADD](Value: math * 7.5625, Value_001: math, Value_002: 0.9375)
          : Math[MULTIPLY_ADD](
            Value: (Value - 0.954545) * 7.5625,
            Value_001: Value - 0.954545,
            Value_002: 0.984375)
  }
  {
    math_3 = 1.0000001 - Value
    compare_4 = math_3 < 0.36363637 @ hide
    compare_5 = math_3 < 0.72727275 @ hide
    compare_6 = math_3 < 0.90909094 @ hide
    math_2 = math_3 - 0.818182
    math_4 = 1.0
      - (compare_4
        ? pow(math_3, 2.0) * 7.5625
        : compare_5
          ? Math[MULTIPLY_ADD](
            Value: (math_3 - 0.54545456) * 7.5625,
            Value_001: math_3 - 0.54545456,
            Value_002: 0.75)
          : compare_6
            ? Math[MULTIPLY_ADD](Value: math_2 * 7.5625, Value_001: math_2, Value_002: 0.9375)
            : Math[MULTIPLY_ADD](
              Value: (math_3 - 0.954545) * 7.5625,
              Value_001: math_3 - 0.954545,
              Value_002: 0.984375))
  }
  switch = EaseIn ? math_4 : Value @ hide
  switch_2 = EaseOut ? switch_4 : switch @ hide
  compare_10 = Value < 0.5 @ hide
  {
    math_6 = 1.0 - Value * 2.0
    compare_7 = math_6 < 0.36363637 @ hide
    compare_8 = math_6 < 0.72727275 @ hide
    compare_9 = math_6 < 0.90909094 @ hide
    math_5 = math_6 - 0.818182
    math_7 = 1.0
      - (compare_7
        ? pow(math_6, 2.0) * 7.5625
        : compare_8
          ? Math[MULTIPLY_ADD](
            Value: (math_6 - 0.54545456) * 7.5625,
            Value_001: math_6 - 0.54545456,
            Value_002: 0.75)
          : compare_9
            ? Math[MULTIPLY_ADD](Value: math_5 * 7.5625, Value_001: math_5, Value_002: 0.9375)
            : Math[MULTIPLY_ADD](
              Value: (math_6 - 0.954545) * 7.5625,
              Value_001: math_6 - 0.954545,
              Value_002: 0.984375))
  }
  {
    math_10 = Value * 2.0 - 1.0
    compare_11 = math_10 < 0.36363637 @ hide
    compare_12 = math_10 < 0.90909094 @ hide
    math_8 = math_10 - 0.818182
    math_9 = (compare_11
        ? pow(math_10, 2.0) * 7.5625
        : math_10 < 0.72727275
          ? Math[MULTIPLY_ADD](
            Value: (math_10 - 0.54545456) * 7.5625,
            Value_001: math_10 - 0.54545456,
            Value_002: 0.75)
          : compare_12
            ? Math[MULTIPLY_ADD](Value: math_8 * 7.5625, Value_001: math_8, Value_002: 0.9375)
            : Math[MULTIPLY_ADD](
              Value: (math_10 - 0.954545) * 7.5625,
              Value_001: math_10 - 0.954545,
              Value_002: 0.984375))
      + 1.0
  }
  switch_3 = boolean_math ? (compare_10 ? math_7 : math_9) / 2.0 : switch_2 @ hide
  return (Value: switch_3)
}

geometry graph easeCirc(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  {
    math = 1.0 - sqrt(1.0 - pow(Value, 2.0))
  }
  {
    math_2 = sqrt(1.0 - pow(Value - 1.0, 2.0))
  }
  {
    compare = Value < 0.5 @ hide
    switch = compare
      ? (1.0 - sqrt(1.0 - pow(Value * 2.0, 2.0))) / 2.0
      : (sqrt(1.0 - pow(Math[MULTIPLY_ADD](Value: Value, Value_001: -2.0, Value_002: 2.0), 2.0))
          + 1.0)
        / 2.0
  }
  switch_2 = EaseIn ? math : Value @ hide
  switch_3 = EaseOut ? math_2 : switch_2 @ hide
  boolean_math = EaseIn and EaseOut @ hide
  switch_4 = boolean_math ? switch : switch_3 @ hide
  return (Value: switch_4)
}

geometry graph easeCubic(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  switch = EaseIn ? pow(Value, 3.0) : Value @ hide
  boolean_math = EaseIn and EaseOut @ hide
  {
    math = 1.0 - pow(1.0 - Value, 3.0)
  }
  switch_2 = EaseOut ? math : switch @ hide
  {
    compare = Value < 0.5 @ hide
    switch_4 = compare
      ? pow(Value, 3.0) * 4.0
      : 1.0 - pow(Math[MULTIPLY_ADD](Value: Value, Value_001: -2.0, Value_002: 2.0), 3.0) / 2.0
  }
  switch_3 = boolean_math ? switch_4 : switch_2 @ hide
  return (Value: switch_3)
}

geometry graph easeElastic(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  {
    math = Value * 10.0
    switch_2 = EaseIn ? -pow(2.0, math - 10.0) * sin((math - 10.75) * 2.0943952) : Value
  }
  {
    math_2 = pow(2.0, Value * -10.0) * sin((Value * 10.0 - 0.75) * 2.0943952) + 1.0
  }
  {
    math_3 = Value * 20.0
    switch = Value < 0.5
      ? -(pow(2.0, math_3 - 10.0) * sin((math_3 - 11.125) * 1.4959965) / 2.0)
      : pow(2.0, Value * -20.0 + 10.0) * sin((Value * 20.0 - 11.125) * 1.3962634) / 2.0 + 1.0
  }
  switch_3 = EaseIn ? switch_2 : Value @ hide
  switch_4 = EaseOut ? math_2 : switch_3 @ hide
  boolean_math = EaseIn and EaseOut @ hide
  switch_5 = boolean_math ? switch : switch_4 @ hide
  return (Value: switch_5)
}

geometry graph easeExpo(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  boolean_math = EaseIn and EaseOut @ hide
  {
    switch_4 = Value == 0.0 ? 0.0 : pow(2.0, Value * 10.0 - 10.0)
  }
  switch = EaseIn ? switch_4 : Value @ hide
  {
    switch_5 = Value == 1.0 ? 1.0 : 1.0 - pow(2.0, Value * -10.0)
  }
  switch_2 = EaseOut ? switch_5 : switch @ hide
  {
    compare = Value == 0.0 @ hide
    compare_2 = Value == 1.0 @ hide
    compare_3 = Value < 0.5 @ hide
    boolean_math_2 = not compare_3 @ hide
    switch_6 = boolean_math_2
      ? (2.0 - pow(2.0, Math[MULTIPLY_ADD](Value: Value, Value_001: -20.0, Value_002: 10.0))) / 2.0
      : compare_3 ? pow(2.0, Value * 20.0 - 10.0) / 2.0 : compare_2 ? 1.0 : compare ? 0.0 : Value
  }
  switch_3 = boolean_math ? switch_6 : switch_2 @ hide
  return (Value: switch_3)
}

geometry graph easeQuad(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
