  boolean_math = EaseIn and EaseOut @ hide
  {
    math = 1.0 - pow(1.0 - Value, 5.0)
  }
  switch_2 = EaseOut ? math : switch @ hide
  {
    compare = Value < 0.5 @ hide
    switch_4 = compare
      ? pow(Value, 5.0) * 16.0
      : 1.0 - pow(Math[MULTIPLY_ADD](Value: Value, Value_001: -2.0, Value_002: 2.0), 5.0) / 2.0
  }
  switch_3 = boolean_math ? switch_4 : switch_2 @ hide
