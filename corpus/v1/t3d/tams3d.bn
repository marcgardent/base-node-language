geometry(is_modifier: true) graph "Align Islands"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Strength: Vector = (1.0, 0.0, 0.0) in 0.0..1.0
) -> (Mesh: Geometry) {
  {
    sample_index = Mesh
      |> ScaleElements(selection: Selection, scale: 0.0)
      |> SampleIndex[FLOAT_VECTOR, clamp: true](value: Position(), index: Index())
  }
  {
    set_position = SetPosition(
      Mesh,
      selection: Selection,
      position: Position() - Strength * sample_index)
  }
  return (Mesh: set_position)
}

geometry(is_modifier: true, is_tool: true) graph "Align To Spline"(
    Geometry: Geometry(description: "Geometry which need to be aligned"),
    Curve: Geometry(description: "Curve path which guides the alignment of Geometry"),
    Factor: Float(
      subtype: FACTOR,
      description: "Affects Geometry's position based on the Curve",
      default_attribute_name: "Factor") in 0.0..1.0,
    "Preview Curve": Bool(description: "Preview Spline in Viewport") = true,
    Strength: Vector(description: "Per Axis Strength") = (1.0, 1.0, 1.0) in 0.0..1.0
) -> Geometry {
  "Sampling Curves" {
    sample_curve = Curve
      |> ResampleCurve[keep_last_segment: false](mode: Evaluated)
      |> SampleCurve[use_all_curves: true](factor: Factor)
  }
  "Axis Rotation" {
    align_rotation_to_vector = AlignRotationToVector[axis: X](
      rotation: AlignRotationToVector[axis: X](vector: sample_curve.normal),
      vector: sample_curve.tangent)
    align_rotation_to_vector_2 = AlignRotationToVector[axis: X](
      rotation: AlignRotationToVector[axis: X](vector: sample_curve.normal * 1.25),
      vector: sample_curve.tangent * 1.25)
  }
  "Position Offset" {
    set_position = SetPosition(
      Geometry,
      position: VectorRotate[EULER_XYZ](
          vector: Position(),
          rotation: Strength
            * (VectorMath[ADD](
                Vector: align_rotation_to_vector,
                Vector_001: align_rotation_to_vector_2)
              * 0.5))
        + sample_curve.position)
  }
  "Preview Curve" {
    switch = preview_curve and IsViewport() ? Curve + set_position : set_position
  }
  return switch
}

geometry(is_modifier: true) graph Bend(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int(description: "1 - X Axis / 2 - Y  Axis / 3 - Z Axis") = 1 in 1..3,
    Strength: Float(subtype: ANGLE, description: "Strength of the Node's function") = 0.7853982,
    Angle: Float(subtype: ANGLE, description: "Bend along the specified Angle"),
    "Mid-Level": Float(subtype: FACTOR, description: "Mid-Level of the Bend") = 0.5 in 0.0..1.0,
    Expansion: Float(description: "Expand along specified Axis")
) -> Geometry {
  {
    position = Position()
    switch = x_y_z == 3
      ? CombineXYZ(x: position.z, y: position.y, z: position.x)
      : x_y_z == 2 ? CombineXYZ(x: position.y, y: position.x, z: position.z) : position
  }
  "Bending" {
    named_attribute = NamedAttribute(name: "Center") @ "Center"
    named_attribute_2 = NamedAttribute(name: "Center") @ "Center"
    named_attribute_3 = NamedAttribute(name: "Z Length") @ "Z Length"
    math = 1.0 / named_attribute_3.attribute
  }
  "Position Defomed At Angle" {
    named_attribute_4 = NamedAttribute[FLOAT_VECTOR](name: "Position") @ "Position"
    vector_rotate_2 = VectorRotate[Z_AXIS, invert: true](
      vector: named_attribute_4.attribute,
      angle: Angle)
  }
  "Bending" .. {
    math_2 = named_attribute_3.attribute * (vector_rotate_2.z - named_attribute.attribute)
    math_7 = vector_rotate_2.y - math
    math_3 = math + math_7 * cos(math_2)
    math_4 = -(math_7 * sin(math_2)) + named_attribute_2.attribute
  }
  "Tilt" {
    vector_rotate = VectorRotate[Z_AXIS](
      vector: CombineXYZ(x: vector_rotate_2.x, y: math_3),
      angle: Angle)
    combine_xyz = CombineXYZ(x: vector_rotate.x, y: vector_rotate.y, z: math_4)
  }
  {
    switch_2 = x_y_z == 3
      ? CombineXYZ(x: combine_xyz.z, y: combine_xyz.y, z: combine_xyz.x)
      : x_y_z == 2 ? CombineXYZ(x: combine_xyz.y, y: combine_xyz.x, z: combine_xyz.z) : combine_xyz
  }
  {
    vector_rotate_3 = VectorRotate[Z_AXIS](
      vector: VectorMath[MULTIPLY](Vector: Expansion, Vector_001: (0.0, 1.0, 0.0)),
      angle: Angle)
    vector_math = switch + vector_rotate_3
  }
  {
    vector_math_2 = -(x_y_z == 3
      ? CombineXYZ(x: vector_rotate_3.z, y: vector_rotate_3.y, z: vector_rotate_3.x)
      : x_y_z == 2
        ? CombineXYZ(x: vector_rotate_3.y, y: vector_rotate_3.x, z: vector_rotate_3.z)
        : vector_rotate_3)
  }
  "Store Position" {
    store_named_attribute_2 = StoreNamedAttribute[FLOAT_VECTOR](
      Geometry,
      name: "Position",
      value: vector_math)
  }
  bounding_box = BoundingBox(store_named_attribute_2)
  {
    switch_3 = x_y_z == 3 ? bounding_box.max.x : bounding_box.max.z
  }
  {
    switch_4 = x_y_z == 3 ? bounding_box.min.x : bounding_box.min.z
  }
  {
    math_5 = switch_3 * mid_level + (1.0 - mid_level) * switch_4
  }
  {
    math_6 = Strength / abs(switch_4 - switch_3)
  }
  store_named_attribute = store_named_attribute_2
    |> StoreNamedAttribute(name: "Center", value: math_5)
    |> StoreNamedAttribute(name: "Z Length", value: math_6)
  {
    set_position = SetPosition(
      store_named_attribute,
      selection: Selection and Strength != 0.0,
      position: switch_2,
      offset: vector_math_2)
  }
  "Removing Attributes" {
    remove_named_attribute = set_position
      |> RemoveNamedAttribute(name: "Center")
      |> RemoveNamedAttribute(name: "Z Length")
      |> RemoveNamedAttribute(name: "Position")
  }
  return remove_named_attribute
}

geometry graph "Boundary Edge Selection"() -> (Selection: Bool) {
  "Boundary Edge" {
    compare = EdgeNeighbors() == 1
  }
  return (Selection: compare)
}

geometry graph "Box Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION) in -10000.0..10000.0,
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    vector_math = abs(RotateVector(vector: Position() - Location, rotation: Rotation)) - Scale * 0.5
  }
  "Box Field" {
    math = 0.0 - max(max(vector_math.x, vector_math.y), vector_math.z)
    switch = Clamp ? Clamp(value: math) : math
  }
  return (Factor: switch)
}

geometry(is_modifier: true) graph Bulge(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int = 3 in 1..3,
    Strength: Float = 0.5,
    Offset: Vector,
    "Limit Lower": Float(subtype: FACTOR) in 0.0..1.0,
    "Limit Higher": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Smoothness: Float(subtype: FACTOR) in 0.0..1.0
) -> Geometry {
  "Center" {
    bounding_box = BoundingBox(Geometry)
    store_named_attribute = StoreNamedAttribute[FLOAT_VECTOR](
      Geometry,
      name: "Center",
      value: Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max) - Offset)
  }
  "Vector" {
    named_attribute = NamedAttribute[FLOAT_VECTOR](name: "Center") @ "Center"
    named_attribute_2 = NamedAttribute[FLOAT_VECTOR](name: "Rotation") @ "Rotation"
    named_attribute_5 = NamedAttribute[FLOAT_VECTOR](name: "Center") @ "Center"
    vector_math = VectorRotate[EULER_XYZ](
        vector: Position(),
        center: named_attribute_5.attribute,
        rotation: named_attribute_2.attribute)
      - named_attribute.attribute
  }
  "Adding Offsets" {
    named_attribute_3 = NamedAttribute[FLOAT_VECTOR](name: "Center") @ "Center"
    named_attribute_4 = NamedAttribute[FLOAT_VECTOR](name: "Rotation") @ "Rotation"
  }
  "Axis" {
    store_named_attribute_2 = StoreNamedAttribute[FLOAT_VECTOR](
      store_named_attribute,
      name: "Rotation",
      value: RotationToEuler(
        rotation: AlignRotationToVector(
          vector: CombineXYZ(x: x_y_z == 1, y: x_y_z == 2, z: x_y_z == 3))))
  }
  "Limits" {
    attribute_statistic = AttributeStatistic(store_named_attribute_2, attribute: vector_math.z)
    mix = Mix(factor: limit_lower, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_2 = Mix(factor: limit_higher, a: attribute_statistic.min, b: attribute_statistic.max)
  }
  {
    math_3 = attribute_statistic.range / 2.0
    math_2 = attribute_statistic.min / math_3
    math_4 = math_3 / attribute_statistic.max
    mix_3 = Mix(
      factor: Smoothness,
      a: MapRange(
        value: vector_math.z,
        from_min: mix,
        from_max: mix_2,
        to_min: math_2,
        to_max: math_4),
      b: MapRange[SMOOTHERSTEP, clamp: false](
        value: vector_math.z,
        from_min: mix,
        from_max: mix_2,
        to_min: math_2,
        to_max: math_4))
  }
  "Deforming" {
    math = Math[MULTIPLY_ADD](
      Value: Math[MULTIPLY_ADD](Value: mix_3, Value_001: -mix_3, Value_002: 1.0),
      Value_001: Strength,
      Value_002: 1.0)
    combine_xyz = CombineXYZ(x: vector_math.x * math, y: vector_math.y * math, z: vector_math.z)
  }
  "Adding Offsets" .. {
    vector_rotate = VectorRotate[EULER_XYZ, invert: true](
      vector: combine_xyz + named_attribute_3.attribute,
      center: named_attribute_3.attribute,
      rotation: named_attribute_4.attribute)
  }
  {
    set_position = SetPosition(
      store_named_attribute_2,
      selection: Selection,
      position: vector_rotate)
  }
  "Removing Attributes" {
    remove_named_attribute = set_position
      |> RemoveNamedAttribute(name: "Center")
      |> RemoveNamedAttribute(name: "Rotation")
  }
  return remove_named_attribute
}

geometry graph "Cartesian to Cylindrical"(
    "x,y,z": Vector in -10000.0..10000.0
) -> ("r, θ, z": Vector) {
  "To Cylindrical" {
    combine_xyz = CombineXYZ(
      x: length(x_y_z * (1.0, 1.0, 0.0)),
      y: atan2(x_y_z.y, x_y_z.x),
      z: x_y_z.z)
  }
  return ("r, θ, z": combine_xyz)
}

geometry graph "Cartesian to Spherical"(
    "x,y,z": Vector in -10000.0..10000.0
) -> ("ρ, θ, φ": Vector) {
  "To Spherical" {
    vector_math = length(x_y_z)
    combine_xyz = CombineXYZ(
      x: vector_math,
      y: atan2(x_y_z.y, x_y_z.x),
      z: acos(x_y_z.z / vector_math))
  }
  return ("ρ, θ, φ": combine_xyz)
}

geometry(is_modifier: true) graph "Center Elements"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Menu: Menu(optional_label: true) = "Bound Center",
    Center: Vector(subtype: TRANSLATION)
) -> Geometry {
  {
    bounding_box_2 = BoundingBox(Geometry)
    set_position_3 = SetPosition(
      Geometry,
      selection: Selection,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](
          factor: 0.5,
          a: bounding_box_2.min,
          b: bounding_box_2.max),
      offset: Center)
  }
  {
    separate_components = SeparateComponents(set_position_3)
    capture_attribute = separate_components.curve
      |> CurveToMesh()
      |> CaptureAttribute(Value: true)
    join_geometry = separate_components.mesh + capture_attribute.geometry
  }
  {
    set_position = SetPosition(
      join_geometry,
      selection: Selection,
      offset: Center
        - (join_geometry
          |> ScaleElements[EDGE](scale: 0.0)
          |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index())))
  }
  {
    separate_geometry = SeparateGeometry(set_position, selection: capture_attribute.value)
  }
  {
    bounding_box = BoundingBox(separate_components.point_cloud)
    set_position_2 = SetPosition(
      separate_components.point_cloud,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](factor: 0.5, a: bounding_box.min, b: bounding_box.max),
      offset: Center)
  }
  {
    join_geometry_2 = set_position_2
      + separate_geometry.inverted
      + MeshToCurve(separate_geometry.selection)
  }
  return MenuSwitch(
    menu: Menu,
    "Bound Center": set_position_3,
    "Element Center": join_geometry_2).output
}

geometry graph "Component Selection"() -> (
    "Is Mesh": Bool,
    "Is Curve": Bool,
    "Is Instance": Bool,
    "Is Point Cloud": Bool
) {
  {
    index = Index()
    compare = AccumulateField[INT, EDGE](group_id: index).total > 0
    compare_2 = AccumulateField[INT, CURVE](group_id: index).total > 0
    compare_3 = AccumulateField[INT, INSTANCE](group_id: index).total > 0
    boolean_math = AccumulateField[INT](group_id: index).total > 0 and Radius() > 0.0
  }
  return (
    "Is Mesh": compare,
    "Is Curve": compare_2,
    "Is Instance": compare_3,
    "Is Point Cloud": boolean_math)
}

geometry(is_modifier: true) graph "Curve Ellipse"(
    Resolution: Int = 32 in 4..,
    "Radius X": Float(subtype: DISTANCE) = 2.0 in 0.0..,
    "Radius Y": Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "Trim Start": Float(subtype: FACTOR) in 0.0..1.0,
    "Trim End": Float(subtype: FACTOR) = 1.0 in 0.0..1.0
) -> (Curve: Geometry) {
  "Index On Trim" {
    map_range = MapRange[clamp: false](
      value: Index() / (Resolution - 1.0),
      to_min: MapRange[clamp: false](value: trim_start, to_max: 6.2831855),
      to_max: MapRange[clamp: false](value: trim_end, to_max: 6.2831855))
    switch = Index() == Resolution
      ? (0.0, 0.0, 0.0)
      : CombineXYZ(x: sin(map_range), y: cos(map_range))
  }
  "Radius" {
    vector_math = switch * CombineXYZ(x: radius_x, y: radius_y)
  }
  "Trim" {
    compare = Compare[EQUAL](
      a: MapRange[clamp: false](value: trim_end, to_max: 6.2831855)
        - MapRange[clamp: false](value: trim_start, to_max: 6.2831855),
      b: 6.2831855,
      epsilon: 0.0)
  }
  "Resampling" {
    resample_curve = CurveCircle(resolution: Resolution)
      |> ResampleCurve[keep_last_segment: false](
        count: Switch[INT](switch: compare, false_: Resolution + 1.0, true_: Resolution))
  }
  "Output" {
    mesh_to_curve = resample_curve
      |> SetPosition(position: vector_math)
      |> CurveToMesh()
      |> MergeByDistance()
      |> MeshToCurve()
  }
  return (Curve: mesh_to_curve)
}

geometry graph "Cylinder Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION),
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0)
) -> (Factor: Float) {
  "Transformation" {
    vector_math = RotateVector(vector: Position() - Location, rotation: Rotation) / (Scale * 0.5)
  }
  "Parameters" {
    math = abs(vector_math.z) - 1.0
    math_2 = length(vector_math * (1.0, 1.0, 0.0)) - 1.0
  }
  "Cylinderical Field" {
    combine_xyz = CombineXYZ(x: math_2, y: math)
    math_3 = -(length(max(combine_xyz, 0.0)) + min(max(combine_xyz.x, combine_xyz.y), 0.0))
    switch = Clamp ? Clamp(value: math_3) : math_3
  }
  return (Factor: switch)
}

geometry graph "Cylindrical to Cartesian"(
    "r, θ, z": Vector in -10000.0..10000.0
) -> ("x,y,z": Vector) {
  "To cartesian" {
    combine_xyz = CombineXYZ(x: cos(r_θ_z.y) * r_θ_z.x, y: r_θ_z.x * sin(r_θ_z.y), z: r_θ_z.z)
  }
  return ("x,y,z": combine_xyz)
}

geometry(is_modifier: true) graph "Delete Islands"(
    Mesh: Geometry,
    Method: Menu(force_non_field: true, optional_label: true, structure_type: SINGLE) = Smaller,
    Factor: Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Thershold: Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Mesh: Geometry) {
  {
    accumulate_field = AccumulateField[INT](group_id: MeshIsland().island_index)
    attribute_statistic = AttributeStatistic(Mesh, attribute: accumulate_field.total)
    mix = Mix(
      factor: Thershold,
      a: MapRange(
        value: accumulate_field.total,
        from_min: attribute_statistic.min,
        from_max: attribute_statistic.max),
      b: MapRange[SMOOTHERSTEP](
        value: accumulate_field.total,
        from_min: attribute_statistic.min,
        from_max: attribute_statistic.max))
  }
  {
    compare = mix >= Switch(false_: mix, true_: MapRange(value: Factor, to_min: 1.0, to_max: 0.0))
    menu_switch = MenuSwitch(
      menu: Method,
      Smaller: Switch[BOOLEAN](false_: mix <= Factor, true_: compare),
      Larger: compare)
  }
  {
    return (Mesh: DeleteGeometry(Mesh, selection: menu_switch.output))
  }
}

geometry graph "Diagonal Matrix"(Matrix: Matrix) -> Matrix {
  {
    separate_matrix = SeparateMatrix(matrix: Matrix)
    combine_matrix = CombineMatrix(
      column_1_row_1: separate_matrix.column_1_row_1,
      column_2_row_2: separate_matrix.column_2_row_2,
      column_3_row_3: separate_matrix.column_3_row_3,
      column_4_row_4: separate_matrix.column_4_row_4)
  }
  return combine_matrix
}

geometry(is_modifier: true) graph Displacer(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Normal: Vector(hide_value: true) = Normal(),
    Texture: Color(hide_value: true, hide_in_modifier: true) = (1.0, 1.0, 1.0),
    "Mid-level": Float(subtype: FACTOR) in 0.0..1.0,
    Strength: Float = 1.0
) -> Geometry {
  "Output" {
    separate_components = SeparateComponents(Geometry)
    vector_math = (Texture - mid_level) * (Normal * Strength)
    join_geometry = SetPosition(
        separate_components.mesh + separate_components.curve + separate_components.volume,
        selection: Selection,
        offset: vector_math)
      + SetPosition(separate_components.point_cloud, selection: Selection, offset: vector_math)
  }
  return join_geometry
}

geometry graph "Edge Angle Selection"(
    Angle: Float(subtype: ANGLE) = 0.5235988
) -> (Selection: Bool) {
  "Edge Angle" {
    return (Selection: EdgeAngle().unsigned_angle > Angle)
  }
}

geometry graph "Edge Path Selection"(
    "Edge Cost": Float = 1.0,
    "Start Index": Int in 0..,
    "End Index": Int in 0..
) -> (Selection: Bool) {
  {
    index = Index()
    edge_paths_to_selection = EdgePathsToSelection(
      start_vertices: index == start_index,
      next_vertex_index: ShortestEdgePaths(
        end_vertex: index == end_index,
        edge_cost: edge_cost).next_vertex_index)
  }
  return (Selection: edge_paths_to_selection)
}

geometry(is_modifier: true) graph "Extend Curve"(
    Curve: Geometry,
    Selection: Bool(hide_value: true) = true,
    "Start Point": Float = 1.0,
    "End Point": Float = 1.0
) -> (Curve: Geometry) {
  {
    endpoint_selection = EndpointSelection(end_size: 0)
    endpoint_selection_2 = EndpointSelection(start_size: 0)
    vector_math = CurveTangent()
      * (-start_point * nimply(endpoint_selection, endpoint_selection_2)
        + nimply(endpoint_selection_2, endpoint_selection) * end_point)
  }
  {
    set_position = Curve
      |> ResampleCurve[keep_last_segment: false](mode: Evaluated)
      |> SetPosition(selection: Selection, offset: vector_math)
  }
  return (Curve: set_position)
}

geometry graph "Face Sides Selection"(Sides: Int = 3 in 3..) -> (Selection: Bool) {
  "Face Sides" {
    compare = FaceNeighbors().vertex_count == Sides
  }
  return (Selection: compare)
}

geometry graph "Flip UV"(
    " UV Map": Vector(hide_value: true) in 0.0..1.0,
    "Flip U": Bool(description: "Flip U (also use as selection if needed)") = true,
    "Flip V": Bool(description: "Flip V (also use as selection if needed)")
) -> (" UV Map": Vector(attribute_domain: CORNER)) {
  {
    switch = flip_u ? (uv_map + (-1.0, 0.0, 0.0)) * (-1.0, 1.0, 1.0) : uv_map
  }
  {
    switch_2 = flip_v ? (switch + (0.0, -1.0, 0.0)) * (1.0, -1.0, 1.0) : switch
  }
  return (" UV Map": switch_2)
}

geometry graph "Geometry Size"(
    Geometry: Geometry
) -> ("Bound Size": Vector, "Bound Center": Vector, "Max size": Float) {
  {
    bounding_box = BoundingBox(Geometry)
    mix = Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max)
    vector_math = bounding_box.max - bounding_box.min
    math = max(max(vector_math.x, vector_math.y), vector_math.z)
  }
  return ("Bound Size": vector_math, "Bound Center": mix, "Max size": math)
}

geometry(is_modifier: true) graph "Geometry To Spline"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true
) -> (Curve: Geometry) {
  {
    separate_components = Geometry
      |> RealizeInstances[realize_to_point_domain: true]()
      |> SeparateComponents()
    mesh_to_points = MeshToPoints(separate_components.mesh, selection: Selection)
    curve_to_points = CurveToPoints[EVALUATED](separate_components.curve)
  }
  {
    points_to_curves = PointsToCurves(curve_to_points.points + mesh_to_points)
  }
  "Spline Resolution & Cyclic" {
    set_handle_type = points_to_curves
      |> SetSplineCyclic(cyclic: true)
      |> SetSplineType[BEZIER]()
      |> SetHandleType()
  }
  return (Curve: set_handle_type)
}

geometry(is_modifier: true) graph "Grid Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "Count X": Int = 3 in 1..,
    "Count Y": Int = 3 in 1..,
    "Count Z": Int = 3 in 1..,
    Spacing: Vector = (1.0, 1.0, 1.0),
    "Options"(default_closed: true) {
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "X" {
    duplicate_elements = Points()
      |> DuplicateElements(amount: count_x)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements.duplicate_index,
        Vector_001: Spacing * (1.0, 0.0, 0.0)))
  }
  "Y" {
    duplicate_elements_2 = DuplicateElements(set_position, amount: count_y)
    set_position_2 = SetPosition(
      duplicate_elements_2.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_2.duplicate_index,
        Vector_001: Spacing * (0.0, 1.0, 0.0)))
  }
  "Z" {
    duplicate_elements_3 = DuplicateElements(set_position_2, amount: count_z)
    set_position_3 = SetPosition(
      duplicate_elements_3.geometry,
      offset: VectorMath[MULTIPLY](
        Vector: duplicate_elements_3.duplicate_index,
        Vector_001: Spacing * (0.0, 0.0, 1.0)))
  }
  "Center" {
    bounding_box = BoundingBox(set_position_3)
    set_position_4 = SetPosition(
      set_position_3,
      offset: -Mix[VECTOR](factor: 0.5, a: bounding_box.min, b: bounding_box.max))
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position_4,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index)
  }
  return (Instances: instance_on_points)
}

geometry(is_modifier: true) graph "Inset Faces"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Menu: Menu(optional_label: true) = Relative,
    Inset: Float = 0.5 in 0.0..1e+18,
    Depth: Float in -10000.0..10000.0,
    "Options" {
        "Delete Inner Face": Bool,
        "Delete Outer Face": Bool,
        "Delete Umselected": Bool
    }
) -> (
    Mesh: Geometry,
    "Inner Face": Bool(attribute_domain: FACE),
    "Outer Face": Bool(attribute_domain: FACE),
    "Unselected Face": Bool(attribute_domain: FACE)
) {
  {
    capture_attribute = CaptureAttribute[FACE](
      Mesh,
      Normal: Normal[legacy_corner_normals: true]().normal)
  }
  {
    extrude_mesh = ExtrudeMesh(capture_attribute.geometry, selection: Selection, offset_scale: 0.0)
  }
  {
    edge_vertices = EdgeVertices()
    evaluate_on_domain = EvaluateOnDomain[EDGE, FLOAT_VECTOR](
      value: normalize(edge_vertices.position_1 - edge_vertices.position_2))
    vector_math = normalize(evaluate_on_domain × capture_attribute.normal)
      * (1.0
        / sin(
          3.1415927
            - acos((pow(length(evaluate_on_domain) * 1.5, 2.0) - 0.5) * 2.0) / 2.0
            - 1.5707964)
        * Inset)
  }
  {
    boolean_math = not EvaluateOnDomain[FACE, BOOLEAN](value: Selection)
  }
  {
    menu_switch = MenuSwitch(
      menu: Menu,
      Relative: ScaleElements(extrude_mesh.mesh, selection: extrude_mesh.top, scale: 1.0 - Inset),
      Even: SetPosition(extrude_mesh.mesh, selection: extrude_mesh.top, offset: vector_math))
  }
  {
    set_position = SetPosition(
      menu_switch.output,
      selection: extrude_mesh.top,
      offset: capture_attribute.normal * Depth)
  }
  {
    delete_geometry = DeleteGeometry[FACE](
      set_position,
      selection: boolean_math and delete_umselected
        or (delete_inner_face and extrude_mesh.top or delete_outer_face and extrude_mesh.side))
  }
  return (
    Mesh: delete_geometry,
    "Inner Face": extrude_mesh.top,
    "Outer Face": extrude_mesh.side,
    "Unselected Face": boolean_math)
}

geometry graph "Is Empty Geometry"() -> ("Is Empty Geometry": Bool) {
  "Index = 0" {
    return ("Is Empty Geometry": Index() < 0)
  }
}

geometry graph "Is Inside Volume"(Mesh: Geometry) -> ("Is Volume": Bool) {
  "Is Inside Volume" {
    boolean_math = Raycast(Mesh).is_hit
      and Raycast(Mesh, ray_direction: (0.0, 0.0, 1.0)).is_hit
      and (Raycast(Mesh, ray_direction: (0.0, -1.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (0.0, 1.0, 0.0)).is_hit)
      and (Raycast(Mesh, ray_direction: (-1.0, 0.0, 0.0)).is_hit
        and Raycast(Mesh, ray_direction: (1.0, 0.0, 0.0)).is_hit)
  }
  return ("Is Volume": boolean_math)
}

geometry graph "Is Symmetric Matrix"(Matrix: Matrix) -> (Symmentric: Bool) {
  {
    separate_matrix = SeparateMatrix(matrix: Matrix)
    separate_matrix_2 = SeparateMatrix(matrix: TransposeMatrix(matrix: Matrix))
  }
  {
    compare = separate_matrix.column_1_row_1 == separate_matrix_2.column_1_row_1 @ hide
    compare_2 = separate_matrix.column_1_row_2 == separate_matrix_2.column_1_row_2 @ hide
    compare_3 = separate_matrix.column_1_row_3 == separate_matrix_2.column_1_row_3 @ hide
    compare_4 = separate_matrix.column_1_row_4 == separate_matrix_2.column_1_row_4 @ hide
    compare_5 = separate_matrix.column_2_row_1 == separate_matrix_2.column_2_row_1 @ hide
    compare_6 = separate_matrix.column_2_row_2 == separate_matrix_2.column_2_row_2 @ hide
    compare_7 = separate_matrix.column_2_row_3 == separate_matrix_2.column_2_row_3 @ hide
    compare_8 = separate_matrix.column_2_row_4 == separate_matrix_2.column_2_row_4 @ hide
    compare_9 = separate_matrix.column_3_row_1 == separate_matrix_2.column_3_row_1 @ hide
    compare_10 = separate_matrix.column_3_row_2 == separate_matrix_2.column_3_row_2 @ hide
    compare_11 = separate_matrix.column_3_row_3 == separate_matrix_2.column_3_row_3 @ hide
    compare_12 = separate_matrix.column_3_row_4 == separate_matrix_2.column_3_row_4 @ hide
    compare_13 = separate_matrix.column_4_row_1 == separate_matrix_2.column_4_row_1 @ hide
    compare_14 = separate_matrix.column_4_row_2 == separate_matrix_2.column_4_row_2 @ hide
    compare_15 = separate_matrix.column_4_row_3 == separate_matrix_2.column_4_row_3 @ hide
    compare_16 = separate_matrix.column_4_row_4 == separate_matrix_2.column_4_row_4 @ hide
    boolean_math = compare and compare_2 @ hide
    boolean_math_2 = compare_3 and compare_4 @ hide
    boolean_math_3 = compare_5 and compare_6 @ hide
    boolean_math_4 = compare_7 and compare_8 @ hide
    boolean_math_5 = compare_9 and compare_10 @ hide
    boolean_math_6 = compare_11 and compare_12 @ hide
    boolean_math_7 = compare_13 and compare_14 @ hide
    boolean_math_8 = compare_15 and compare_16 @ hide
    boolean_math_9 = boolean_math and boolean_math_2 @ hide
    boolean_math_10 = boolean_math_3 and boolean_math_4 @ hide
    boolean_math_11 = boolean_math_5 and boolean_math_6 @ hide
    boolean_math_12 = boolean_math_7 and boolean_math_8 @ hide
    boolean_math_13 = boolean_math_9 and boolean_math_10 @ hide
    boolean_math_14 = boolean_math_11 and boolean_math_12 @ hide
    boolean_math_15 = boolean_math_13 and boolean_math_14 @ hide
  }
  return (Symmentric: boolean_math_15)
}

geometry graph "Is Vector Coplanar"(
    "Vector 1": Vector in -10000.0..10000.0,
    "Vector 2": Vector in -10000.0..10000.0,
    "Vector 3": Vector in -10000.0..10000.0
) -> (Coplanar: Bool) {
  {
    separate_xyz = SeparateXYZ(vector: vector_1) @ hide
    separate_xyz_2 = SeparateXYZ(vector: vector_2) @ hide
    separate_xyz_3 = SeparateXYZ(vector: vector_3) @ hide
    compare = Compare[EQUAL](
      a: MatrixDeterminant(
        matrix: CombineMatrix(
          column_1_row_1: separate_xyz.x,
          column_1_row_2: separate_xyz.y,
          column_1_row_3: separate_xyz.z,
          column_2_row_1: separate_xyz_2.x,
          column_2_row_2: separate_xyz_2.y,
          column_2_row_3: separate_xyz_2.z,
          column_3_row_1: separate_xyz_3.x,
          column_3_row_2: separate_xyz_3.y,
          column_3_row_3: separate_xyz_3.z)),
      epsilon: 0.0)
  }
  return (Coplanar: compare)
}

geometry graph "Island Center"(Mesh: Geometry, " Merge Connected": Bool) -> (Center: Vector) {
  {
    sample_index = Mesh
      |> ScaleElements(scale: 0.0)
      |> MergeByDistance(selection: merge_connected, mode: Connected)
      |> SampleIndex[FLOAT_VECTOR, clamp: true](value: Position(), index: Index())
  }
