geometry graph easeSine(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  {
    math = 1.0 - cos(Value * 3.1415927 / 2.0)
  }
  switch = EaseIn ? math : Value @ hide
  {
    math_2 = sin(Value * 3.1415927 / 2.0)
  }
  switch_2 = EaseOut ? math_2 : switch @ hide
  boolean_math = EaseIn and EaseOut @ hide
  {
    math_3 = -(cos(Value * 3.1415927) - 1.0) / 2.0
  }
  switch_3 = boolean_math ? math_3 : switch_2 @ hide
  return (Value: switch_3)
}

