      ? pow(Value, 4.0) * 8.0
      : 1.0 - pow(Math[MULTIPLY_ADD](Value: Value, Value_001: -2.0, Value_002: 2.0), 4.0) / 2.0
  }
  switch_3 = boolean_math ? switch_4 : switch_2 @ hide
