}

geometry(is_modifier: true) graph "Lathe Curve"(
    Curve: Geometry,
    Resolution: Int = 12 in 3..100000,
    "Preview Curve": Bool = true
) -> (Mesh: Geometry) {
  {
    Transform = TransformGeometry(Curve, rotation: (1.5707964, 0.0, 0.0))
    named_attribute = NamedAttribute(name: "radius")
    curve_to_mesh = CurveCircle(resolution: Resolution, radius: 0.0001)
      |> CurveToMesh(
        profile_curve: ResampleCurve[keep_last_segment: false](Transform, mode: Evaluated),
        scale: named_attribute.exists ? named_attribute.attribute : 1.0)
  }
  {
    switch = preview_curve and IsViewport() ? curve_to_mesh + Curve : curve_to_mesh
  }
  return (Mesh: switch)
}

geometry graph "Linear Field"(
    Clamp: Bool = true,
    Location: Vector(subtype: TRANSLATION) in -10000.0..10000.0,
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Field" {
    vector_math = RotateVector(
        vector: Position() - Location,
        rotation: InvertRotation(rotation: Rotation))
      / Scale
    switch = Clamp ? Clamp(value: vector_math.x) : vector_math.x
  }
  return (Factor: switch)
}

geometry(is_modifier: true) graph "Linear Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Count: Int = 5 in 2..,
    "Start Location": Vector,
    Offset: Vector = (1.0, 0.0, 0.0) in -10000.0..10000.0,
    "Options"(default_closed: true) {
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "Duplication" {
    duplicate_elements = Points(position: start_location)
      |> DuplicateElements(amount: Count)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: VectorMath[MULTIPLY](Vector: duplicate_elements.duplicate_index, Vector_001: Offset))
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index)
  }
  return (Instances: instance_on_points)
}

geometry(is_modifier: true) graph "Logarithmic Spiral"(
    Resolution: Int = 32 in 1..100000,
    Rotation: Float(subtype: ANGLE) = 3.1415927 in 0.0..,
    a: Float = 0.02 in 0.0..10000.0,
    k: Float = 0.17 in 0.0..10000.0,
    "Connect Center": Bool
) -> (Curve: Geometry) {
  "Resolution & Angle" {
    float_to_integer = FloatToInteger[FLOOR](float: Resolution * Rotation)
    arc = Arc(resolution: float_to_integer, sweep_angle: 5.75435, connect_center: connect_center)
  }
  "Angle On Index" {
    math = Index() / float_to_integer * (radians(Rotation) * 360.0)
  }
  "Formula" {
    vector_rotate = VectorRotate[Z_AXIS](vector: CombineXYZ(x: -a + a * exp(k * math)), angle: math)
  }
  return (Curve: SetPosition(arc, position: vector_rotate))
}

geometry graph "Loose Edge Selection"() -> (Selection: Bool) {
