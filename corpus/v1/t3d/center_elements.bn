geometry graph "Center Elements"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Menu: Menu(optional_label: true) = "Bound Center",
    Center: Vector(subtype: TRANSLATION)
) -> Geometry {
  {
    bounding_box_2 = BoundingBox(Geometry)
    set_position_3 = SetPosition(
      Geometry,
      selection: Selection,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](
          factor: 0.5,
          a: bounding_box_2.min,
          b: bounding_box_2.max),
      offset: Center)
  }
  {
    separate_components = SeparateComponents(set_position_3)
    capture_attribute = separate_components.curve
      |> CurveToMesh()
      |> CaptureAttribute(Value: true)
    join_geometry = separate_components.mesh + capture_attribute.geometry
  }
  {
    set_position = SetPosition(
      join_geometry,
      selection: Selection,
      offset: Center
        - (join_geometry
          |> ScaleElements[EDGE](scale: 0.0)
          |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index())))
  }
  {
    separate_geometry = SeparateGeometry(set_position, selection: capture_attribute.value)
  }
  {
    bounding_box = BoundingBox(separate_components.point_cloud)
    set_position_2 = SetPosition(
      separate_components.point_cloud,
      position: Position()
        - Mix[VECTOR, clamp_factor: false](factor: 0.5, a: bounding_box.min, b: bounding_box.max),
      offset: Center)
  }
  {
    join_geometry_2 = set_position_2
      + separate_geometry.inverted
      + MeshToCurve(separate_geometry.selection)
  }
  return MenuSwitch(
    menu: Menu,
    "Bound Center": set_position_3,
    "Element Center": join_geometry_2).output
}
