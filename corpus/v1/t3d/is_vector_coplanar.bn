geometry graph "Is Vector Coplanar"(
    "Vector 1": Vector in -10000.0..10000.0,
    "Vector 2": Vector in -10000.0..10000.0,
    "Vector 3": Vector in -10000.0..10000.0
) -> (Coplanar: Bool) {
  {
    separate_xyz = SeparateXYZ(vector: vector_1) @ hide
    separate_xyz_2 = SeparateXYZ(vector: vector_2) @ hide
    separate_xyz_3 = SeparateXYZ(vector: vector_3) @ hide
    compare = Compare[EQUAL](
      a: MatrixDeterminant(
        matrix: CombineMatrix(
          column_1_row_1: separate_xyz.x,
          column_1_row_2: separate_xyz.y,
          column_1_row_3: separate_xyz.z,
          column_2_row_1: separate_xyz_2.x,
          column_2_row_2: separate_xyz_2.y,
          column_2_row_3: separate_xyz_2.z,
          column_3_row_1: separate_xyz_3.x,
          column_3_row_2: separate_xyz_3.y,
          column_3_row_3: separate_xyz_3.z)),
      epsilon: 0.0)
  }
  return (Coplanar: compare)
}
