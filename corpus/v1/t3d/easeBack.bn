geometry graph easeBack(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  boolean_math = EaseIn and EaseOut @ hide
  {
    math = pow(Value, 3.0) * 2.70158 - pow(Value, 2.0) * 1.70158
  }
  switch = EaseIn ? math : Value @ hide
  {
    math_2 = Math[MULTIPLY_ADD](
      Value: pow(Value - 1.0, 2.0),
      Value_001: 1.70158,
      Value_002: Math[MULTIPLY_ADD](
        Value: pow(Value - 1.0, 3.0),
        Value_001: 2.70158,
        Value_002: 1.0))
  }
  switch_2 = EaseOut ? math_2 : switch @ hide
  {
    compare = Value < 0.5 @ hide
    switch_4 = compare
      ? (Value * 7.18982 - 2.59491) * pow(Value * 2.0, 2.0) / 2.0
      : Math[MULTIPLY_ADD](
          Value: Math[MULTIPLY_ADD](
            Value: 2.0 * Value - 2.0,
            Value_001: 3.59491,
            Value_002: 2.59491),
          Value_001: pow(2.0 * Value - 2.0, 2.0),
          Value_002: 2.0)
        / 2.0
  }
  switch_3 = boolean_math ? switch_4 : switch_2 @ hide
  return (Value: switch_3)
}
