geometry graph "Vertex Slide"(
    Mesh: Geometry,
    Factor: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    "Vertex Index": Int in 0..,
    Value: Int
) -> (Mesh: Geometry) {
  {
    compare = Index() == vertex_index
  }
  {
    position = Position()
  }
  math = DomainSize(Mesh).point_count - 1.0
  .. {
    mix = Mix[VECTOR, clamp_factor: false](
      factor: Factor,
      a: position,
      b: EvaluateAtIndex[FLOAT_VECTOR](
        value: position,
        index: IndexOfNearest().index + mod(Value, math)))
  }
  {
    set_position = SetPosition(Mesh, selection: compare, position: mix)
  }
  return (Mesh: set_position)
}
