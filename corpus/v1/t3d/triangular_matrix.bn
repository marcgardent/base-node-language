geometry graph "Triangular Matrix"(
    Matrix: Matrix,
    Socket: Menu(optional_label: true) = "Upper Triangular"
) -> Matrix {
  separate_matrix = SeparateMatrix(matrix: Matrix)
  separate_matrix_2 = SeparateMatrix(matrix: Matrix)
  return MenuSwitch(
    menu: Socket,
    "Upper Triangular": CombineMatrix(
      column_1_row_1: separate_matrix.column_1_row_1,
      column_1_row_2: separate_matrix.column_1_row_2,
      column_1_row_3: separate_matrix.column_1_row_3,
      column_1_row_4: separate_matrix.column_1_row_4,
      column_2_row_2: separate_matrix.column_2_row_2,
      column_2_row_3: separate_matrix.column_2_row_3,
      column_2_row_4: separate_matrix.column_2_row_4,
      column_3_row_3: separate_matrix.column_3_row_3,
      column_3_row_4: separate_matrix.column_3_row_4,
      column_4_row_4: separate_matrix.column_4_row_4),
    "Lower Triangular": CombineMatrix(
      column_1_row_1: separate_matrix_2.column_1_row_1,
      column_2_row_1: separate_matrix_2.column_2_row_1,
      column_2_row_2: separate_matrix_2.column_2_row_2,
      column_3_row_1: separate_matrix_2.column_3_row_1,
      column_3_row_2: separate_matrix_2.column_3_row_2,
      column_3_row_3: separate_matrix_2.column_3_row_3,
      column_4_row_1: separate_matrix_2.column_4_row_1,
      column_4_row_2: separate_matrix_2.column_4_row_2,
      column_4_row_3: separate_matrix_2.column_4_row_3,
      column_4_row_4: separate_matrix_2.column_4_row_4)).output
}
