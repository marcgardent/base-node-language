geometry graph easeElastic(
    Value: Float(hide_value: true) = 0.5 in 0.0..1.0,
    EaseIn: Bool = true,
    EaseOut: Bool
) -> (Value: Float) {
  {
    math = Value * 10.0
    switch_2 = EaseIn ? -pow(2.0, math - 10.0) * sin((math - 10.75) * 2.0943952) : Value
  }
  {
    math_2 = pow(2.0, Value * -10.0) * sin((Value * 10.0 - 0.75) * 2.0943952) + 1.0
  }
  {
    math_3 = Value * 20.0
    switch = Value < 0.5
      ? -(pow(2.0, math_3 - 10.0) * sin((math_3 - 11.125) * 1.4959965) / 2.0)
      : pow(2.0, Value * -20.0 + 10.0) * sin((Value * 20.0 - 11.125) * 1.3962634) / 2.0 + 1.0
  }
  switch_3 = EaseIn ? switch_2 : Value @ hide
  switch_4 = EaseOut ? math_2 : switch_3 @ hide
  boolean_math = EaseIn and EaseOut @ hide
  switch_5 = boolean_math ? switch : switch_4 @ hide
  return (Value: switch_5)
}
