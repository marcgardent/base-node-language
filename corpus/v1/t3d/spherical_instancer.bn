geometry graph "Spherical Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Count: Int = 32 in 3..100000,
    Rotations: Float = 75.0 in -10000.0..10000.0,
    Radius: Float = 1.0 in -10000.0..10000.0,
    "Options"(default_closed: true) {
        "Align Rotation": Bool = true,
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "Spiral Curve" {
    math = Rotations * SplineParameter().factor
    vector_rotate = VectorRotate[EULER_XYZ](
      vector: CombineXYZ(x: sin(math), y: cos(math)),
      rotation: AlignEulerToVector[axis: Z](vector: CurveTangent()))
  }
  "Spherical Spiral" {
    vector_math_2 = Position() + (vector_rotate + (0.0, 0.0, -1.57))
    math_2 = cos(vector_math_2.z)
    vector_math = CombineXYZ(
        x: vector_math_2.x * math_2,
        y: math_2 * vector_math_2.y,
        z: sin(vector_math_2.z))
      * Radius
  }
  "Count" {
    resample_curve = CurveLine(end: (0.0, 0.0, 3.1415927))
      |> ResampleCurve[keep_last_segment: false](count: Count)
  }
  set_position = SetPosition(resample_curve, position: vector_math)
  "Align Rotation" {
    align_rotation_to_vector = AlignRotationToVector[axis: Y](
      factor: align_rotation,
      vector: -Normal[legacy_corner_normals: true]().normal)
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index,
      rotation: align_rotation_to_vector)
  }
  return (Instances: instance_on_points)
}
