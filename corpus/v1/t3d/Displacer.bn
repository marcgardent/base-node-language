geometry graph Displacer(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Normal: Vector(hide_value: true) = Normal(),
    Texture: Color(hide_value: true, hide_in_modifier: true) = (1.0, 1.0, 1.0),
    "Mid-level": Float(subtype: FACTOR) in 0.0..1.0,
    Strength: Float = 1.0
) -> Geometry {
  "Output" {
    separate_components = SeparateComponents(Geometry)
    vector_math = (Texture - mid_level) * (Normal * Strength)
    join_geometry = SetPosition(
        separate_components.mesh + separate_components.curve + separate_components.volume,
        selection: Selection,
        offset: vector_math)
      + SetPosition(separate_components.point_cloud, selection: Selection, offset: vector_math)
  }
  return join_geometry
}
