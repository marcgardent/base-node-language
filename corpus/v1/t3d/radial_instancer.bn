geometry graph "Radial Instancer"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Count: Int = 32 in 3..10000,
    "Radius X": Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "Radius Y": Float(subtype: DISTANCE) = 1.0 in 0.0..,
    "End Angle": Float(subtype: ANGLE) = 6.2831855 in 0.0..6.2831855,
    "Offset Angle": Float(subtype: ANGLE),
    "Options"(default_closed: true) {
        "Align Rotation": Bool = true,
        "Pick Instance": Bool,
        "Instance Index": Int(hide_value: true)
    }
) -> (Instances: Geometry) {
  "Point Ellipse" {
    duplicate_elements = Points()
      |> DuplicateElements(amount: Count)
    map_range = MapRange[clamp: false](
      value: duplicate_elements.duplicate_index,
      from_max: Count,
      to_max: end_angle)
    vector_rotate = VectorRotate[Z_AXIS](
      vector: CombineXYZ(x: sin(map_range), y: cos(map_range)),
      angle: offset_angle)
    set_position = SetPosition(
      duplicate_elements.geometry,
      offset: vector_rotate * CombineXYZ(x: radius_x, y: radius_y))
  }
  "Instancing" {
    instance_on_points = InstanceOnPoints(
      set_position,
      selection: Selection,
      instance: Geometry,
      pick_instance: pick_instance,
      instance_index: instance_index,
      rotation: AlignRotationToVector[axis: X](factor: align_rotation, vector: vector_rotate))
  }
  return (Instances: instance_on_points)
}
