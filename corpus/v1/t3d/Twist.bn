geometry graph Twist(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    "X / Y / Z": Int = 3 in 1..3,
    "Angle Lower": Float(subtype: ANGLE) = 0.7853982,
    "Angle Higher": Float(subtype: ANGLE) = -0.7853982,
    "Limit Lower": Float(subtype: FACTOR) in 0.0..1.0,
    "Limit Higher": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Smoothness: Float(subtype: FACTOR) in 0.0..1.0
) -> Geometry {
  "Axis" {
    switch = x_y_z == 3 ? CombineXYZ(z: 1.0) : x_y_z == 2 ? CombineXYZ(y: 1.0) : CombineXYZ(x: 1.0)
  }
  {
    vector_math = switch ⋅ Position()
  }
  "Limits" {
    attribute_statistic = AttributeStatistic(Geometry, attribute: vector_math)
    mix = Mix(factor: limit_higher, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_2 = Mix(factor: limit_lower, a: attribute_statistic.min, b: attribute_statistic.max)
    mix_3 = Mix(
      factor: Smoothness,
      a: MapRange(
        value: vector_math,
        from_min: mix_2,
        from_max: mix,
        to_min: angle_lower,
        to_max: angle_higher),
      b: MapRange[SMOOTHERSTEP](
        value: vector_math,
        from_min: mix_2,
        from_max: mix,
        to_min: angle_lower,
        to_max: angle_higher))
  }
  "Deform" {
    set_position = SetPosition(
      Geometry,
      selection: Selection,
      position: VectorRotate(vector: Position(), angle: mix_3))
  }
  return set_position
}
