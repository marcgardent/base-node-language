geometry graph "Non-Manifold Edge Selection"() -> (
    "Non-Manifold Edge": Bool,
    "Manifold Edge": Bool
) {
  "Manifold / Non-Manifold" {
    edge_neighbors = EdgeNeighbors()
    boolean_math = edge_neighbors > 2 or edge_neighbors == 1
    boolean_math_2 = not boolean_math
  }
  return ("Non-Manifold Edge": boolean_math, "Manifold Edge": boolean_math_2)
}
