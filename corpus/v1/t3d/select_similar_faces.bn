geometry graph "Select Similar Faces"(
    Index: Int = 1 in 0..,
    Thershold: Float = 0.001 in 0.0..1.0
) -> (
    Material: Bool,
    "Face Area": Bool,
    "Polygon Sides": Bool,
    Normal: Bool,
    Coplanar: Bool,
    "Flat / Smooth": Bool(attribute_domain: FACE)
) {
  "Material" {
    material_index = MaterialIndex()
    compare_3 = material_index == EvaluateAtIndex[FACE, INT](value: material_index, index: Index)
  }
  "Face Area" {
    face_area = FaceArea()
    compare = Compare[EQUAL](
      a: face_area,
      b: EvaluateAtIndex[FACE](value: face_area, index: Index),
      epsilon: Thershold)
  }
  "Polygon Sides" {
    face_neighbors = FaceNeighbors()
    compare_2 = face_neighbors.vertex_count
      == EvaluateAtIndex[FACE, INT](value: face_neighbors.vertex_count, index: Index)
  }
  "Normal" {
    normal = Normal[legacy_corner_normals: true]()
    evaluate_at_index = EvaluateAtIndex[FACE, FLOAT_VECTOR](value: normal.normal, index: Index)
    compare_4 = Compare[EQUAL](a: evaluate_at_index ⋅ normal.normal, b: 1.0, epsilon: Thershold)
  }
  "Coplanar" {
    position = Position()
    boolean_math = compare_4
      and Compare[EQUAL](
        a: (EvaluateAtIndex[FACE, FLOAT_VECTOR](value: position, index: Index) - position)
          ⋅ evaluate_at_index,
        epsilon: Thershold)
  }
  "Flat / Smooth" {
    is_face_smooth = IsFaceSmooth()
    evaluate_on_domain = EvaluateOnDomain[FACE, BOOLEAN](
      value: Compare[EQUAL, INT](
        a: EvaluateAtIndex[FACE, BOOLEAN](value: is_face_smooth, index: Index),
        b: is_face_smooth))
  }
  return (
    Material: compare_3,
    "Face Area": compare,
    "Polygon Sides": compare_2,
    Normal: compare_4,
    Coplanar: boolean_math,
    "Flat / Smooth": evaluate_on_domain)
}
