geometry graph "Inset Faces"(
    Mesh: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Menu: Menu(optional_label: true) = Relative,
    Inset: Float = 0.5 in 0.0..1e+18,
    Depth: Float in -10000.0..10000.0,
    "Options" {
        "Delete Inner Face": Bool,
        "Delete Outer Face": Bool,
        "Delete Umselected": Bool
    }
) -> (
    Mesh: Geometry,
    "Inner Face": Bool(attribute_domain: FACE),
    "Outer Face": Bool(attribute_domain: FACE),
    "Unselected Face": Bool(attribute_domain: FACE)
) {
  {
    capture_attribute = CaptureAttribute[FACE](
      Mesh,
      Normal: Normal[legacy_corner_normals: true]().normal)
  }
  {
    extrude_mesh = ExtrudeMesh(capture_attribute.geometry, selection: Selection, offset_scale: 0.0)
  }
  {
    edge_vertices = EdgeVertices()
    evaluate_on_domain = EvaluateOnDomain[EDGE, FLOAT_VECTOR](
      value: normalize(edge_vertices.position_1 - edge_vertices.position_2))
    vector_math = normalize(evaluate_on_domain × capture_attribute.normal)
      * (1.0
        / sin(
          3.1415927
            - acos((pow(length(evaluate_on_domain) * 1.5, 2.0) - 0.5) * 2.0) / 2.0
            - 1.5707964)
        * Inset)
  }
  {
    boolean_math = not EvaluateOnDomain[FACE, BOOLEAN](value: Selection)
  }
  {
    menu_switch = MenuSwitch(
      menu: Menu,
      Relative: ScaleElements(extrude_mesh.mesh, selection: extrude_mesh.top, scale: 1.0 - Inset),
      Even: SetPosition(extrude_mesh.mesh, selection: extrude_mesh.top, offset: vector_math))
  }
  {
    set_position = SetPosition(
      menu_switch.output,
      selection: extrude_mesh.top,
      offset: capture_attribute.normal * Depth)
  }
  {
    delete_geometry = DeleteGeometry[FACE](
      set_position,
      selection: boolean_math and delete_umselected
        or (delete_inner_face and extrude_mesh.top or delete_outer_face and extrude_mesh.side))
  }
  return (
    Mesh: delete_geometry,
    "Inner Face": extrude_mesh.top,
    "Outer Face": extrude_mesh.side,
    "Unselected Face": boolean_math)
}
