geometry graph "Torus Field"(
    Clamp: Bool = true,
    "Minor Radius": Float = 0.5 in 0.0..,
    "Major Radius": Float = 0.7 in 0.0..,
    Location: Vector(subtype: TRANSLATION) in -10000.0..10000.0,
    Rotation: Rotation,
    Scale: Vector = (1.0, 1.0, 1.0) in -10000.0..10000.0
) -> (Factor: Float) {
  "Transformation" {
    rotate_vector = RotateVector(
      vector: RotateVector(
          vector: Position() - Location,
          rotation: InvertRotation(rotation: Rotation))
        / (Scale * 0.4999999),
      rotation: (1.5707964, 0.0, 0.0))
  }
  "Torus Field" {
    math = -(length(
        CombineXYZ(
          x: length(CombineXYZ(x: rotate_vector.x, z: rotate_vector.z)) - major_radius,
          y: rotate_vector.y))
      - minor_radius)
    switch = Clamp ? Clamp(value: math) : math
  }
  return (Factor: switch)
}
