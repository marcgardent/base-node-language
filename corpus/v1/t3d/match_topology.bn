geometry graph "Match Topology"(
    "Target Mesh": Geometry,
    "Sample Mesh": Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Strength: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Stiffness: Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Mesh: Geometry, Position: Vector) {
  {
    realize_instances = RealizeInstances[realize_to_point_domain: true](sample_mesh)
    geometry_proximity = GeometryProximity(realize_instances)
    mix = Mix[VECTOR](
      factor: geometry_proximity.distance,
      a: GeometryProximity[POINTS](realize_instances).position,
      b: geometry_proximity.position)
  }
  {
    sample_nearest_surface = SampleNearestSurface[FLOAT_VECTOR](sample_mesh, value: Position())
  }
  {
    mix_2 = Mix[VECTOR](factor: Stiffness, a: mix, b: sample_nearest_surface.value)
    set_position = SetPosition(
      target_mesh,
      selection: Selection,
      position: Mix[VECTOR, clamp_factor: false](factor: Strength, a: Position(), b: mix_2))
  }
  return (Mesh: set_position, Position: mix_2)
}
