geometry graph "Smooth Geometry"(
    Geometry: Geometry,
    Selection: Bool(hide_value: true, hide_in_modifier: true) = true,
    Iterations: Int = 16 in 0..,
    Stiffness: Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Strength: Float = 1.0 in 0.0..
) -> Geometry {
  {
    position = Position()
    blur_attribute = BlurAttribute[FLOAT_VECTOR](
      value: position,
      iterations: Iterations,
      weight: Strength)
    mix = Mix[VECTOR, NON_UNIFORM](
      factor: Strength,
      a: position,
      b: Mix[VECTOR](
        factor: Stiffness,
        a: blur_attribute,
        b: (blur_attribute + EvaluateOnDomain[FACE, FLOAT_VECTOR](value: position)) * 0.5))
  }
  {
    separate_components = SeparateComponents(Geometry)
  }
  {
    separate_components_2 = SeparateComponents(Geometry)
  }
  {
    capture_attribute_2 = CaptureAttribute(
      separate_components_2.curve,
      Value: SplineLength().length)
    capture_attribute = capture_attribute_2.geometry
      |> SetPosition(position: mix)
      |> CaptureAttribute(Value: SplineLength().length)
    set_handle_type = capture_attribute.geometry
      |> SetPosition(
        selection: Selection,
        position: Position() * (capture_attribute_2.value / capture_attribute.value))
      |> SetSplineType[BEZIER]()
      |> SetHandleType()
  }
  {
    set_position = SetPosition(separate_components_2.mesh, selection: Selection, position: mix)
  }
  {
    join_geometry = set_position
      + set_handle_type
      + separate_components.point_cloud
      + separate_components.volume
  }
  return join_geometry
}
