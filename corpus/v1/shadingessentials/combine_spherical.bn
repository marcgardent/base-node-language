shader graph "Combine Spherical"(
    R: Float(description: "Radius - Length of the vector") in 0.0..10000.0,
    Phi: Float(
      subtype: ANGLE,
      description: "Azimuth - Angle around the up axis") in -3.1415927..3.1415927,
    Theta: Float(
      subtype: ANGLE,
      description: "Zenith - Angle from the ground plane") in -1.5707964..1.5707964
) -> Vector {
  return VectorRotate[Z_AXIS](
    vector: VectorRotate[Y_AXIS, invert: true](vector: (1.0, 0.0, 0.0) * R, angle: Theta),
    angle: Phi)
}
