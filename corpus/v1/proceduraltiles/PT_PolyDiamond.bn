shader graph PT_PolyDiamond(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0 in -10000.0..10000.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  {
    vector_math = (0.142265, 0.5, 0.0) + 0.0 @ "left"
    vector_math_2 = (0.5, 1.142265, 0.0) + 0.0 @ "top"
    vector_math_3 = (0.85773504, 0.5, 0.0) + 0.0 @ "right"
    vector_math_4 = (0.5, -0.14226498, 0.0) + 0.0 @ "bottom"
  }
  {
    vector_math_7 = (-0.142265, 0.5, 0.0) + 0.0 @ "left"
    vector_math_8 = (0.5, 0.857736, 0.0) + 0.0 @ "top"
    vector_math_9 = (1.14226, 0.5, 0.0) + 0.0 @ "right"
    vector_math_10 = (0.5, 0.142265, 0.0) + 0.0 @ "bottom"
  }
  {
    vector_math_14 = CombineXYZ(x: -0.288675, y: 0.5) + 0.0 @ hide
    vector_math_15 = CombineXYZ(x: 0.288675, y: -0.5) + 0.0 @ hide
    vector_math_17 = vector_math_15 - vector_math_14 @ hide
    vector_math_19 = vector_math_17 ⋅ vector_math_17 @ hide
    vector_math_24 = CombineXYZ() + 0.0 @ hide
    vector_math_25 = CombineXYZ(x: 0.5, y: 0.288675) + 0.0 @ hide
    vector_math_27 = vector_math_25 - vector_math_24 @ hide
    vector_math_29 = vector_math_27 ⋅ vector_math_27 @ hide
    vector_math_34 = CombineXYZ(x: 0.5, y: 0.288675) + 0.0 @ hide
    vector_math_35 = CombineXYZ(x: 0.5, y: 0.5) + 0.0 @ hide
    vector_math_37 = vector_math_35 - vector_math_34 @ hide
    vector_math_39 = vector_math_37 ⋅ vector_math_37 @ hide
  }
  {
    vector_math_44 = CombineXYZ(x: -0.288675, y: 0.5) + 0.0 @ hide
    vector_math_45 = CombineXYZ(x: 0.288675, y: -0.5) + 0.0 @ hide
    vector_math_47 = vector_math_45 - vector_math_44 @ hide
    vector_math_49 = vector_math_47 ⋅ vector_math_47 @ hide
    vector_math_54 = CombineXYZ() + 0.0 @ hide
    vector_math_55 = CombineXYZ(x: 0.5, y: 0.288675) + 0.0 @ hide
    vector_math_57 = vector_math_55 - vector_math_54 @ hide
    vector_math_59 = vector_math_57 ⋅ vector_math_57 @ hide
    vector_math_64 = CombineXYZ(x: 0.5, y: 0.288675) + 0.0 @ hide
    vector_math_65 = CombineXYZ(x: 0.5, y: 0.5) + 0.0 @ hide
    vector_math_67 = vector_math_65 - vector_math_64 @ hide
    vector_math_69 = vector_math_67 ⋅ vector_math_67 @ hide
  }
  vector_math_73 = Vector * Scale
  vector_math_5 = fract(vector_math_73)
  {
    math = Math[PINGPONG](Value: vector_math_5.x) * 0.57735026
        - Math[PINGPONG](Value: vector_math_5.y)
      > 0.0
    mix = math
      ? vector_math_2 * ((vector_math_5.y > 0.5) * math)
        + vector_math_4 * ((vector_math_5.y < 0.5) * math)
      : Mix[RGBA](factor: vector_math_5.x > 0.5, a: vector_math, b: vector_math_3)
  }
  "checker" {
    vector_math_6 = floor(vector_math_73)
    math_3 = Math[FLOORED_MODULO](
      Value: Math[MULTIPLY](Value: vector_math_6, Value_001: 3.0),
      Value_001: 2.0)
  }
  {
    vector_rotate = VectorRotate(
      vector: vector_math_5,
      center: (0.5, 0.5, 0.0),
      angle: 1.5707964) @ hide
    math_2 = Math[PINGPONG](Value: vector_rotate.x) * 0.57735026
        - Math[PINGPONG](Value: vector_rotate.y)
      > 0.0
    mix_2 = math_2
      ? vector_math_9 * ((vector_rotate.y > 0.5) * math_2)
        + vector_math_7 * ((vector_rotate.y < 0.5) * math_2)
      : Mix[RGBA](factor: vector_rotate.x > 0.5, a: vector_math_8, b: vector_math_10)
  }
  mix_3 = Mix[RGBA](factor: math_3, a: mix, b: mix_2)
  vector_math_11 = mix_3 + vector_math_6 + (1000.0, 1000.0, 0.0) @ hide
  white_noise_texture = WhiteNoiseTexture["2D"](vector: vector_math_11) @ #9b9b9b
  {
    vector_rotate_2 = VectorRotate(
      vector: vector_math_5,
      center: (0.5, 0.5, 0.0),
      angle: 1.5707964) @ hide
    separate_xyz = SeparateXYZ(vector: vector_rotate_2) @ hide
    math_4 = separate_xyz.x > 0.5 @ hide
    math_8 = Math[PINGPONG](Value: separate_xyz.x) @ hide
    math_7 = math_8 * 0.57735026 @ hide
    math_9 = Math[PINGPONG](Value: separate_xyz.y) @ hide
    math_6 = math_7 - math_9 @ hide
    math_5 = math_6 > 0.0 @ hide
    math_10 = separate_xyz.y > 0.5 @ hide
    math_11 = math_10 * math_5 @ hide
    math_12 = separate_xyz.y < 0.5 @ hide
    math_13 = math_12 * math_5 @ hide
    value = 2.0 @ hide
    math_29 = math_11 * value @ hide
    value_2 = 1.0 @ hide
    value_3 = 0.0 @ hide
    math_30 = math_13 * value_3 @ hide
    math_28 = math_29 + math_30 @ hide
    value_4 = 3.0 @ hide
    mix_4 = math_4 ? value_4 : value_2 @ hide
    mix_5 = math_5 ? math_28 : mix_4 @ hide
  }
  {
    math_16 = Math[PINGPONG](Value: vector_math_73.x) @ hide
    math_17 = Math[PINGPONG](Value: vector_math_73.y) @ hide
    combine_xyz = CombineXYZ(x: math_16, y: math_17)
    vector_math_13 = combine_xyz + 0.0 @ hide
    vector_math_16 = vector_math_13 - vector_math_14 @ hide
    vector_math_18 = vector_math_16 ⋅ vector_math_17 @ hide
    math_18 = Math[DIVIDE, use_clamp: true](Value: vector_math_18, Value_001: vector_math_19) @ hide
    vector_math_22 = vector_math_17 * math_18 @ hide
    vector_math_21 = vector_math_16 - vector_math_22 @ hide
    vector_math_20 = length(vector_math_21) @ hide
    vector_math_23 = combine_xyz + 0.0 @ hide
    vector_math_26 = vector_math_23 - vector_math_24 @ hide
    vector_math_28 = vector_math_26 ⋅ vector_math_27 @ hide
    math_19 = Math[DIVIDE, use_clamp: true](Value: vector_math_28, Value_001: vector_math_29) @ hide
    vector_math_32 = vector_math_27 * math_19 @ hide
    vector_math_31 = vector_math_26 - vector_math_32 @ hide
    vector_math_30 = length(vector_math_31) @ hide
    math_15 = min(vector_math_20, vector_math_30) @ hide
    vector_math_33 = combine_xyz + 0.0 @ hide
    vector_math_36 = vector_math_33 - vector_math_34 @ hide
    vector_math_38 = vector_math_36 ⋅ vector_math_37 @ hide
    math_20 = Math[DIVIDE, use_clamp: true](Value: vector_math_38, Value_001: vector_math_39) @ hide
    vector_math_42 = vector_math_37 * math_20 @ hide
    vector_math_41 = vector_math_36 - vector_math_42 @ hide
    vector_math_40 = length(vector_math_41) @ hide
    math_14 = min(math_15, vector_math_40) @ hide
  }
  {
    vector_rotate_3 = VectorRotate(
      vector: vector_math_73,
      center: (0.5, 0.5, 0.0),
      angle: 1.5707964) @ hide
    math_23 = Math[PINGPONG](Value: vector_rotate_3.x) @ hide
    math_24 = Math[PINGPONG](Value: vector_rotate_3.y) @ hide
    combine_xyz_2 = CombineXYZ(x: math_23, y: math_24)
    vector_math_43 = combine_xyz_2 + 0.0 @ hide
    vector_math_46 = vector_math_43 - vector_math_44 @ hide
    vector_math_48 = vector_math_46 ⋅ vector_math_47 @ hide
    math_25 = Math[DIVIDE, use_clamp: true](Value: vector_math_48, Value_001: vector_math_49) @ hide
    vector_math_52 = vector_math_47 * math_25 @ hide
    vector_math_51 = vector_math_46 - vector_math_52 @ hide
    vector_math_50 = length(vector_math_51) @ hide
    vector_math_53 = combine_xyz_2 + 0.0 @ hide
    vector_math_56 = vector_math_53 - vector_math_54 @ hide
    vector_math_58 = vector_math_56 ⋅ vector_math_57 @ hide
    math_26 = Math[DIVIDE, use_clamp: true](Value: vector_math_58, Value_001: vector_math_59) @ hide
    vector_math_62 = vector_math_57 * math_26 @ hide
    vector_math_61 = vector_math_56 - vector_math_62 @ hide
    vector_math_60 = length(vector_math_61) @ hide
    math_22 = min(vector_math_50, vector_math_60) @ hide
    vector_math_63 = combine_xyz_2 + 0.0 @ hide
    vector_math_66 = vector_math_63 - vector_math_64 @ hide
    vector_math_68 = vector_math_66 ⋅ vector_math_67 @ hide
    math_27 = Math[DIVIDE, use_clamp: true](Value: vector_math_68, Value_001: vector_math_69) @ hide
    vector_math_72 = vector_math_67 * math_27 @ hide
    vector_math_71 = vector_math_66 - vector_math_72 @ hide
    vector_math_70 = length(vector_math_71) @ hide
    math_21 = min(math_22, vector_math_70) @ hide
  }
  mix_6 = Mix(factor: math_3, a: math_14, b: math_21) @ #9b9b9b
  vector_math_74 = (vector_math_6 + mix_3) * (1.0 / Scale)
  vector_math_12 = Vector - vector_math_74 @ #9b9b9b
  {
    separate_xyz_2 = SeparateXYZ(vector: vector_math_5) @ hide
    math_31 = separate_xyz_2.x > 0.5 @ hide
    math_35 = Math[PINGPONG](Value: separate_xyz_2.x) @ hide
    math_34 = math_35 * 0.57735026 @ hide
    math_36 = Math[PINGPONG](Value: separate_xyz_2.y) @ hide
    math_33 = math_34 - math_36 @ hide
    math_32 = math_33 > 0.0 @ hide
    math_37 = separate_xyz_2.y > 0.5 @ hide
    math_38 = math_37 * math_32 @ hide
    math_39 = separate_xyz_2.y < 0.5 @ hide
    math_40 = math_39 * math_32 @ hide
    value_5 = 3.0 @ hide
    math_42 = math_38 * value_5 @ hide
    value_6 = 2.0 @ hide
    value_7 = 1.0 @ hide
    math_43 = math_40 * value_7 @ hide
    math_41 = math_42 + math_43 @ hide
    value_8 = 0.0 @ hide
    mix_7 = math_31 ? value_8 : value_6 @ hide
    mix_8 = math_32 ? math_41 : mix_7 @ hide
  }
  mix_9 = Mix(factor: math_3, a: mix_8, b: mix_5) @ #9b9b9b
  return (
    Position: vector_math_74,
    UV: vector_math_12,
    Color: white_noise_texture.color,
    Edge: mix_6 / Scale,
    Masks: mix_9)
}
