shader graph PT_SquaryFan(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    "Outer Thickness": Float(subtype: FACTOR) = 0.75 in 0.0..1.0,
    "Outer boards": Int = 2 in 1..,
    "Inner boards": Int = 4 in 1..
) -> (Position: Vector, UV: Vector, "UV center": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  math_7 = outer_thickness - 0.5 @ hide
  math_8 = abs(math_7) @ hide
  math_9 = Math[MULTIPLY_ADD](Value: math_8, Value_001: -1.0) @ hide
  math_12 = 0.5 - math_9 @ hide
  math_16 = Math[MULTIPLY_ADD](Value: outer_thickness, Value_001: -1.0) @ hide
  math_17 = math_16 / inner_boards
  math_20 = outer_thickness < 0.5 @ hide
  math_22 = math_9 / 2.0 @ hide
  math_21 = math_22 / outer_boards
  math_26 = math_17 * 2.0 @ hide
  math_30 = math_21 * 2.0
  math_34 = 1.0 - outer_thickness @ hide
  math_39 = 1.0 / math_30 @ hide
  math_40 = (0.5 - math_9) / inner_boards * 1.4142135 @ "n"
  math_43 = math_40 * math_40
  math_44 = math_43 * 0.5
  "p4(10)" #7b2a1b {
    vector_math_6 = Vector * Scale
    vector_math_7 = fract(vector_math_6) - (0.5, 0.5, 0.0)
    vector_math_8 = abs(vector_math_7)
    math_46 = sign(vector_math_7.x * vector_math_7.y)
    separate_xyz = SeparateXYZ(vector: vector_math_8) @ hide
    combine_xyz_5 = CombineXYZ(x: separate_xyz.y, y: separate_xyz.x) @ hide
    mix_6 = Mix[VECTOR](factor: math_46, a: combine_xyz_5, b: vector_math_8)
    vector_math_9 = floor(vector_math_6) + (0.5, 0.5, 0.0) @ hide
    math_47 = sign(vector_math_7.x) @ hide
    math_48 = sign(vector_math_7.y) @ hide
    vector_math_10 = (1.0, 0.0, 0.0) * math_47 @ hide
    vector_math_11 = (0.0, 1.0, 0.0) * math_48 @ hide
    mix_7 = Mix[VECTOR](factor: math_46, a: vector_math_11, b: vector_math_10) @ hide
    mix_8 = Mix[VECTOR](factor: math_46, a: vector_math_10, b: vector_math_11) @ hide
  }
  map_range = MapRange[FLOAT_VECTOR](
    vector: mix_6,
    from_max: (0.5, 0.5, 0.0),
    to_min: (0.5, 0.5, 0.0),
    to_max: (0.0, 0.0, 0.0)) @ hide
  math = map_range.x - math_9
  math_2 = map_range.y - math_9
  math_3 = abs(math_2) @ hide
  math_4 = abs(math) @ hide
  math_5 = min(math_2, math_4)
  math_6 = min(math, math_3)
  math_10 = mix_6.x + math_12 @ hide
  math_11 = mix_6.y + math_12 @ hide
  math_13 = mix_6.y - mix_6.x
  math_15 = mix_6.y + mix_6.x
  math_18 = Math[PINGPONG](Value: math_2, Value_001: math_21)
  math_19 = Math[PINGPONG](Value: math, Value_001: math_21)
  math_23 = min(map_range.x, map_range.y)
  math_14 = min(
    max(
      min(
          max(Math[PINGPONG](Value: math_15, Value_001: math_17), math_13),
          max(Math[PINGPONG](Value: math_13, Value_001: math_17), -math_13))
        / 1.4142135,
      -min(math, math_2)),
    min(
      math_23,
      math_20
        ? min(min(max(math, math_19), max(max(-math, math_18), math_2)), math_11)
        : min(min(max(math_2, math_18), max(math, max(-math_2, math_19))), math_10))) @ #5a1616
  math_24 = math_13 > 0.0
  math_25 = -math_13 @ hide
  math_27 = Math[FLOORED_MODULO](Value: math_2, Value_001: math_30) @ hide
  math_28 = Math[FLOORED_MODULO](Value: math, Value_001: math_30) @ hide
  math_29 = math_2 < 0.0 @ hide
  mix = math_29 ? math_27 : math_28 @ hide
  math_31 = Math[MULTIPLY_ADD](
    Value: map_range.x,
    Value_001: -1.0,
    Value_002: outer_thickness) @ hide
  mix_2 = math_29 ? math_31 : math_2 @ hide
  combine_xyz = CombineXYZ(x: mix_2, y: mix) @ hide
  math_32 = math < 0.0 @ hide
  mix_3 = math_32 ? math_28 : math_27 @ hide
  math_33 = Math[MULTIPLY_ADD](Value: map_range.y, Value_001: -1.0, Value_002: math_34) @ hide
  mix_4 = math_32 ? math_33 : math @ hide
  combine_xyz_2 = CombineXYZ(x: mix_4, y: mix_3) @ hide
  math_35 = math_23 < math_9
  math_36 = math_2 < 0.0 @ hide
  math_37 = math < 0.0 @ hide
  vector_math_2 = map_range * math_39 @ hide
  vector_math = floor(vector_math_2) @ hide
  vector_math_3 = vector_math * math_30 @ hide
  math_49 = math_9 * (math_20 ? 1.0 : -1.0) @ hide
  math_38 = math_49 / 2.0
  math_50 = 0.5 - math_9 / outer_boards / 2.0
  vector_math_4 = CombineXYZ(x: math_50, y: math_50) - vector_math_3
  combine_xyz_3 = CombineXYZ(x: vector_math_4.x, y: math_38)
  combine_xyz_4 = CombineXYZ(x: -math_38, y: vector_math_4.y)
  math_51 = math_13 > 0.0 @ hide
  mix_9 = math_51 ? floor(math_13 / 1.4142135 / math_40) : floor(math_15 / 1.4142135 / math_40)
  math_41 = inner_boards - mix_9
  math_42 = math_41 * math_43
  math_45 = math_42 + math_44 @ hide
  vector_math_5 = ((CombineXYZ(x: 1.0, y: math_41) * 0.5 + CombineXYZ(x: mix_9)) * math_40 * math_42
      + (CombineXYZ(x: mix_9, y: math_41) + (1.0, 1.0, 0.0) * 3.0) * math_40 * math_44)
    / math_45
  mix_5 = math_35
    ? (math_20
      ? Mix[VECTOR, clamp_factor: false](factor: math_37, a: combine_xyz_4, b: combine_xyz_3)
      : Mix[VECTOR, clamp_factor: false](factor: math_36, a: combine_xyz_3, b: combine_xyz_4))
    : (math_51
        ? (-1.0, 1.0, 0.0) * vector_math_5.x + (1.0, 1.0, 0.0) * vector_math_5.y
        : (1.0, 1.0, 0.0) * vector_math_5.x + (1.0, -1.0, 0.0) * vector_math_5.y)
      * 0.707107
  vector_math_12 = mix_7 * mix_5.x + mix_8 * mix_5.y + vector_math_9
  vector_math_13 = vector_math_12 / Scale
  return (
    Position: vector_math_13,
    UV: math_35
      ? (math_20 ? combine_xyz_2 : combine_xyz)
      : CombineXYZ(
          x: math_24 ? math_15 : math_25,
          y: math_24 ? mod(math_13, math_26) : mod(math_15, math_26))
        * 0.70710677,
    "UV center": Vector - vector_math_13,
    Color: WhiteNoiseTexture(vector: vector_math_12 + (1000.0, 1000.0, 0.0)).color,
    Edge: math_14 / Scale,
    Masks: math_35 ? 0.0 : mix_9 + 1.0)
}
