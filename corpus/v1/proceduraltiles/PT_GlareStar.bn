shader graph PT_GlareStar(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    Factor: Float(subtype: FACTOR) = 0.33333334 in 0.0..1.0
) -> (Position: Vector, UV: Vector, "UV oriented": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  math_7 = Scale / 2.0 @ hide
  "p4m(11)" #7b2a1b {
    vector_math_3 = Vector * math_7
    vector_math_4 = fract(vector_math_3) - (0.5, 0.5, 0.0)
    vector_math_5 = abs(vector_math_4)
    vector_math_6 = floor(vector_math_3) + (0.5, 0.5, 0.0) @ hide
    math_3 = sign(vector_math_4.x) @ hide
    math_4 = sign(vector_math_4.y) @ hide
    vector_math_7 = (1.0, 0.0, 0.0) * math_3 @ hide
    vector_math_8 = (0.0, 1.0, 0.0) * math_4 @ hide
    math_5 = vector_math_5.x - vector_math_5.y < 0.0
    mix_2 = math_5 ? vector_math_8 : vector_math_7 @ hide
    mix_3 = math_5 ? vector_math_7 : vector_math_8 @ hide
    mix_4 = math_5 ? CombineXYZ(x: vector_math_5.y, y: vector_math_5.x) : vector_math_5
  }
  vector_math = (mix_4 - (0.5, 0.0, 0.0)) ⋅ normalize(CombineXYZ(x: Factor, y: 1.0))
  vector_math_2 = (mix_4 - (0.5, 0.0, 0.0)) ⋅ normalize(-CombineXYZ(x: 1.0, y: Factor))
  math = vector_math < 0.0
  math_2 = vector_math_2 < 0.0
  mix = math ? (0.0, 0.0, 0.0) : math_2 ? (0.5, 0.5, 0.0) : (0.25, 0.25, 0.0)
  vector_math_9 = mix_2 * mix.x + mix_3 * mix.y + vector_math_6
  vector_math_10 = vector_math_9 / math_7
  vector_math_11 = vector_math_9 + (1000.0, 1000.0, 0.0) @ hide
  math_6 = max(math, math_2)
  vector_math_12 = Vector - vector_math_10
  vector_rotate = VectorRotate(
    vector: vector_math_12,
    angle: (MapRange(
          value: floor(
            MapRange(
              value: atan2(vector_math_4.x, vector_math_4.y) + (vector_math_4.x < 0.0) * 6.2831855,
              from_max: 6.2831855,
              to_max: 4.0)),
          from_max: 4.0,
          to_max: 6.28319)
        + 0.7853982)
      * MapRange(value: math_6, to_min: 1.0, to_max: 0.0)) @ hide
  return (
    Position: vector_math_10,
    UV: vector_math_12,
    "UV oriented": vector_rotate,
    Color: WhiteNoiseTexture(vector: vector_math_11).color,
    Edge: abs(min(vector_math, vector_math_2)) / math_7,
    Masks: math_6)
}
