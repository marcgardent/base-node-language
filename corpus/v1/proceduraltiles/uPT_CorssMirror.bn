shader graph uPT_CorssMirror(Vector: Vector(hide_value: true)) -> Vector {
  "PT Utils"
  map_range = MapRange[FLOAT_VECTOR](
    vector: Vector,
    from_max: (1.0, 1.0, 0.0),
    to_min: (1.0, 1.0, 0.0),
    to_max: (0.0, 0.0, 0.0)) @ hide
  math = map_range.x + map_range.y > 1.0
  return Vector.x + Vector.y > 1.0
    ? (map_range.x - map_range.y > 0.0 ? map_range : CombineXYZ(x: map_range.y, y: map_range.x))
    : Vector.x - Vector.y > 0.0 ? Vector : CombineXYZ(x: Vector.y, y: Vector.x)
}
