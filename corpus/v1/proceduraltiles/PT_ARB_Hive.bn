shader graph ".uSDF_Segment"(
    Vector: Vector(hide_value: true),
    "Points" {
        A: Vector in -10000.0..10000.0,
        B: Vector = (1.0, 1.0, 0.0) in -10000.0..10000.0
    }
) -> (Value: Float, Value as value_float: Float) {
  "SDF node"
  vector_math = A + 0.0
  vector_math_2 = Vector + 0.0 - vector_math
  vector_math_3 = B + 0.0 - vector_math
  vector_math_4 = B - A
  return (
    Value: length(
      vector_math_2
        - vector_math_3
          * Math[DIVIDE, use_clamp: true](
            Value: vector_math_2 ⋅ vector_math_3,
            Value_001: vector_math_3 ⋅ vector_math_3)),
    value_float: (Vector - A) ⋅ normalize(CombineXYZ(x: -vector_math_4.y, y: vector_math_4.x)))
}

shader graph PT_ARB_Hive(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  math_17 = Scale / 5.0
  vector_math = Vector * math_17
  vector_math_2 = fract(vector_math)
  {
    vector_math_7 = vector_math_2 - (0.5, 0.5, 0.0) @ hide
    vector_math_8 = abs(vector_math_7) @ hide
    vector_math_9 = VectorMath[SNAP](Vector: vector_math_2, Vector_001: (0.5, 0.5, 0.0)) @ hide
    vector_math_11 = vector_math_9 - (0.25, 0.25, 0.0) @ hide
    vector_math_10 = normalize(vector_math_11) @ hide
  }
  vector_math_3 = vector_math_8 * 2.0
  math_16 = vector_math_3.x - vector_math_3.y < 0.0
  {
    separate_xyz = SeparateXYZ(vector: vector_math_3) @ hide
    math_18 = separate_xyz.x + separate_xyz.y @ hide
    math_19 = separate_xyz.x - separate_xyz.y @ hide
    math_20 = math_18 > 1.0 @ hide
    math_21 = math_19 > 0.0 @ hide
    combine_xyz_2 = CombineXYZ(x: separate_xyz.y, y: separate_xyz.x) @ hide
    mix = math_21 ? vector_math_3 : combine_xyz_2 @ hide
    map_range_2 = MapRange[FLOAT_VECTOR](
      vector: vector_math_3,
      from_max: (1.0, 1.0, 0.0),
      to_min: (1.0, 1.0, 0.0),
      to_max: (0.0, 0.0, 0.0)) @ hide
    separate_xyz_2 = SeparateXYZ(vector: map_range_2) @ hide
    math_22 = separate_xyz_2.x + separate_xyz_2.y @ hide
    math_23 = separate_xyz_2.x - separate_xyz_2.y @ hide
    math_24 = math_22 > 1.0 @ hide
    math_25 = math_23 > 0.0 @ hide
    combine_xyz_3 = CombineXYZ(x: separate_xyz_2.y, y: separate_xyz_2.x) @ hide
    mix_3 = math_25 ? map_range_2 : combine_xyz_3 @ hide
    mix_2 = math_20 ? mix_3 : mix @ hide
  }
  {
    group = usdf_segment(vector: mix_2, a: (0.0, 0.166815, 0.0), b: (0.166815, 0.0, 0.0)) @ hide
    group_2 = usdf_segment(vector: mix_2, a: (0.166815, 0.0, 0.0), b: (0.352199, 0.0, 0.0)) @ hide
    group_3 = usdf_segment(
      vector: mix_2,
      a: (0.352199, 0.0, 0.0),
      b: (0.490864, 0.190856, 0.0)) @ hide
    group_4 = usdf_segment(
      vector: mix_2,
      a: (0.490864, 0.190856, 0.0),
      b: (0.422139, 0.422139, 0.0)) @ hide
    group_5 = usdf_segment(
      vector: mix_2,
      a: (0.422139, 0.422139, 0.0),
      b: (0.57786, 0.57786, 0.0)) @ hide
    group_6 = usdf_segment(
      vector: mix_2,
      a: (0.490864, 0.190856, 0.0),
      b: (0.71523, 0.117956, 0.0)) @ hide
    group_7 = usdf_segment(
      vector: mix_2,
      a: (0.71523, 0.117956, 0.0),
      b: (0.882044, 0.28477, 0.0)) @ hide
    group_8 = usdf_segment(
      vector: mix_2,
      a: (0.71523, 0.117956, 0.0),
      b: (0.715229, -0.117956, 0.0)) @ hide
    math_7 = min(group.Value, group_2.Value) @ hide
    math_6 = min(math_7, group_3.Value) @ hide
    math_5 = min(math_6, group_4.Value) @ hide
    math_4 = min(math_5, group_5.Value) @ hide
    math_3 = min(math_4, group_6.Value) @ hide
    math_2 = min(math_3, group_7.Value) @ hide
    math = min(math_2, group_8.Value) @ hide
  }
  math_8 = group.value_float > 0.0 @ hide
  math_9 = group_3.value_float > 0.0 @ hide
  math_10 = group_4.value_float < 0.0 @ hide
  math_11 = group_6.value_float > 0.0 @ hide
  math_12 = group_7.value_float < 0.0 @ hide
  math_13 = group_8.value_float > 0.0 @ hide
  math_14 = min(math_10, math_11) @ hide
  math_15 = min(math_12, math_13) @ hide
  vector_math_4 = Mix[VECTOR](
      factor: math_15,
      a: Mix[VECTOR](
        factor: math_14,
        a: math_9 ? (math_8 ? (0.231839, 0.231839, 0.0) : (0.0, 0.0, 0.0)) : (0.552877, 0.0, 0.0),
        b: (0.649547, 0.350453, 0.0)),
      b: (1.0, 0.0, 0.0))
    - (0.5, 0.5, 0.0)
  combine_xyz = CombineXYZ(x: vector_math_4.y, y: vector_math_4.x)
  map_range = MapRange[FLOAT_VECTOR](
    vector: math_16 ? vector_math_4 : combine_xyz,
    from_min: (-1.0, -1.0, 0.0),
    from_max: (1.0, 1.0, 0.0),
    to_min: (1.0, 1.0, 0.0),
    to_max: (-1.0, -1.0, 0.0)) @ hide
  vector_math_5 = floor(vector_math)
    + (((vector_math_3.x + vector_math_3.y > 1.0
            ? map_range
            : math_16 ? combine_xyz : vector_math_4)
          + (0.5, 0.5, 0.0))
        * (vector_math_10 * 1.4142135)
        * 0.5
      + (0.5, 0.5, 0.0))
  vector_math_6 = vector_math_5 / math_17
  return (
    Position: vector_math_6,
    UV: Vector - vector_math_6,
    Color: WhiteNoiseTexture(vector: vector_math_5 + (1000.0, 1000.0, 0.0)).color,
    Edge: Math[DIVIDE, use_clamp: true](
      Value: Math[DIVIDE, use_clamp: true](Value: math, Value_001: 2.0),
      Value_001: math_17),
    Masks: Mix(
      factor: math_15,
      a: Mix(factor: math_14, a: math_9 ? (math_8 ? 1.0 : 0.0) : 2.0, b: 3.0),
      b: 4.0))
}
