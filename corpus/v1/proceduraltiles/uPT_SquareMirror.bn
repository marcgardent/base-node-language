shader graph uPT_SquareMirror(
    Vector: Vector(hide_value: true)
) -> (Vector: Vector, Vector as vector_vector: Vector) {
  "PT Utils"
  return (
    Vector: abs(Vector - (0.5, 0.5, 0.0)),
    vector_vector: normalize(
        VectorMath[SNAP](Vector: Vector, Vector_001: (0.5, 0.5, 0.0)) - (0.25, 0.25, 0.0))
      * 1.4142135)
}
