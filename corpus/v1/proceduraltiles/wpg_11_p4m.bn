shader graph "WPG_11(p4m)"(
    Vector: Vector(hide_value: true),
    scale: Float = 5.0
) -> (UV: Vector, position: Vector, mx: Vector, my: Vector) {
  "Wallpaper group tile pattern more on :https://en.wikipedia.org/wiki/Wallpaper_group"
  "p4m(11)" #7b2a1b {
    vector_math = Vector * scale
    vector_math_2 = fract(vector_math) - (0.5, 0.5, 0.0)
    vector_math_3 = abs(vector_math_2)
    vector_math_4 = floor(vector_math) + (0.5, 0.5, 0.0) @ hide
    math = sign(vector_math_2.x) @ hide
    math_2 = sign(vector_math_2.y) @ hide
    vector_math_5 = (1.0, 0.0, 0.0) * math @ hide
    vector_math_6 = (0.0, 1.0, 0.0) * math_2 @ hide
    math_3 = vector_math_3.x - vector_math_3.y < 0.0
    mix = math_3 ? vector_math_6 : vector_math_5 @ hide
    mix_2 = math_3 ? vector_math_5 : vector_math_6 @ hide
    mix_3 = math_3 ? CombineXYZ(x: vector_math_3.y, y: vector_math_3.x) : vector_math_3
  }
  return (UV: mix_3, position: vector_math_4, mx: mix, my: mix_2)
}
