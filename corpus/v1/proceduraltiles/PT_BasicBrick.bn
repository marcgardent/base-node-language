shader graph PT_BasicBrick(
    Vector: Vector(hide_value: true) in -10000.0..10000.0,
    Scale: Float = 10.0,
    Offset: Float = 1.0,
    "Board size": Float = 2.0 in 0.0..,
    "Zigzag"(default_closed: true) {
        Zigzag: Bool,
        "Zigzag Span": Int = 1 in 1..
    }
) -> (
    Position: Vector,
    UV: Vector,
    "UV center": Vector,
    Color: Color,
    Edge: Float,
    "Zigzag" {
        Position as zigzag_position: Vector
    }
) {
  vector_math_2 = Vector * Scale
  vector_math = floor(vector_math_2)
  math = (Zigzag ? Math[PINGPONG](Value: vector_math.y, Value_001: zigzag_span) : vector_math.y)
      * Offset
    + vector_math_2.x
  math_2 = Math[FLOORED_MODULO](Value: math, Value_001: board_size)
  math_3 = board_size / 2.0
  combine_xyz = CombineXYZ(
    x: math_2,
    y: Math[FLOORED_MODULO](Value: vector_math_2.y, Value_001: 1.0))
  vector_math_3 = vector_math_2 - combine_xyz
  math_4 = 1.0 / Scale
  combine_xyz_2 = CombineXYZ(x: math_3, y: 0.5)
  return (
    Position: (vector_math_3 + combine_xyz_2) * math_4,
    UV: combine_xyz * math_4,
    "UV center": (combine_xyz - combine_xyz_2) * math_4,
    Color: WhiteNoiseTexture(vector: vector_math_3 + (10000.0, 10000.0, 0.0)).color,
    Edge: min(
        Math[PINGPONG](Value: math_2, Value_001: math_3),
        Math[PINGPONG](Value: vector_math_2.y))
      * math_4,
    zigzag_position: (CombineXYZ(x: floor(math / board_size) * board_size, y: vector_math_3.y)
        + combine_xyz_2)
      * math_4)
}
