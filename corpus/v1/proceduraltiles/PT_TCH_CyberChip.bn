shader graph PT_TCH_CyberChip(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, "Signed edge": Float, Masks: Int) {
  vector_math = (1.0, 1.0, 0.0) * 0.25 @ hide
  vector_math_2 = vector_math * (1.5, 0.0, 0.0) @ hide
  vector_math_5 = vector_math * (0.0, 1.5, 0.0) @ hide
  vector_math_8 = vector_math * (4.0, 4.0, 0.0) @ hide
  vector_math_11 = vector_math * (4.0, 0.0, 0.0) @ hide
  vector_math_14 = vector_math * (0.0, 4.0, 0.0) @ hide
  "uPT_TCH_RandomRotationTiling" {
    vector_math_17 = Vector * Scale
    vector_math_18 = fract(vector_math_17)
    vector_math_19 = floor(vector_math_17)
    value = 4.0 @ "Rotations (Int)"
    math_16 = Math[SNAP](
        Value: WhiteNoiseTexture(vector: vector_math_19).value,
        Value_001: 1.0 / value)
      * 6.2831855
    vector_rotate = VectorRotate(vector: vector_math_18, center: (0.5, 0.5, 0.0), angle: math_16)
  }
  vector_math_3 = vector_rotate - vector_math_2 @ hide
  vector_math_4 = length(vector_math_3) @ hide
  vector_math_6 = vector_rotate - vector_math_5 @ hide
  vector_math_7 = length(vector_math_6) @ hide
  vector_math_9 = vector_rotate - vector_math_8 @ hide
  vector_math_10 = length(vector_math_9) @ hide
  vector_math_12 = vector_rotate - vector_math_11 @ hide
  vector_math_13 = length(vector_math_12) @ hide
  vector_math_15 = vector_rotate - vector_math_14 @ hide
  vector_math_16 = length(vector_math_15) @ hide
  math_2 = abs(vector_math_10 - 0.5) - 0.25 @ hide
  math_4 = abs(vector_math_16 - 0.375) - 0.125 @ hide
  math_5 = abs(math_4) @ hide
  math_6 = min(math_5, math_2) @ hide
  math = Math[PINGPONG](Value: math_6, Value_001: 0.125) @ hide
  math_3 = max(math_6, math) @ hide
  math_7 = min(vector_math_4, vector_math_7) @ hide
  math_8 = min(min(math_3, abs(vector_math_13 - 0.25)), abs(math_7 - 0.125))
  math_9 = math_8 > 0.0625
  math_10 = math_8 - 0.0625
  math_11 = vector_math_10 > 0.75 @ hide
  math_12 = vector_math_16 > 0.5 @ hide
  math_13 = vector_math_13 > 0.25 @ hide
  math_14 = vector_math_4 > 0.125 @ hide
  math_15 = vector_math_7 > 0.125 @ hide
  vector_math_22 = VectorRotate[invert: true](
      vector: (math_9
          ? (math_11
            ? (math_12
              ? (math_13
                ? (math_14 ? (math_15 ? (0.0, 0.0, 0.0) : vector_math_5) : vector_math_2)
                : vector_math_11)
              : vector_math_14)
            : vector_math_8)
          : (0.5, 0.5, 0.0))
        - (0.5, 0.5, 0.0),
      angle: math_16)
    + vector_math_19
    + (0.5, 0.5, 0.0)
  vector_math_20 = vector_math_22 / Scale
  vector_math_21 = vector_math_22 + (1000.0, 1000.0, 0.0) @ hide
  math_18 = math_10 / Scale @ hide
  math_19 = Math[PINGPONG](Value: vector_math_18.x) @ hide
  math_20 = Math[PINGPONG](Value: vector_math_18.y) @ hide
  math_17 = min(abs(math_10), min(math_19, math_20)) / Scale @ hide
  return (
    Position: vector_math_20,
    UV: Vector - vector_math_20,
    Color: WhiteNoiseTexture(vector: vector_math_21).color,
    Edge: math_17,
    "Signed edge": math_18,
    Masks: math_9)
}
