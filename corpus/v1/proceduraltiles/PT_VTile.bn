shader graph PT_VTile(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    Thickness: Float = 0.5,
    Slope: Float = 2.0,
    "Join tiles": Bool,
    "UV oriented": Bool
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  vector_math = abs(fract(Vector * CombineXYZ(x: Scale, y: 1.0)) - (0.5, 0.0, 0.0))
  vector_math_2 = Vector * Scale
  math = atan(Slope)
  math_2 = Slope / 2.0 @ hide
  {
    map_range = MapRange(value: vector_math.x, from_max: 0.5, to_min: 0.5, to_max: 0.0)
    math_7 = 1.0 / Thickness
  }
  math_6 = cos(math) * math_7
  combine_xyz = CombineXYZ(x: 1.0, y: math_6)
  vector_math_5 = (vector_math_2 + CombineXYZ(y: vector_math.x) * Slope) * combine_xyz
  vector_math_3 = floor(vector_math_5)
  math_5 = 1.0 / math_6 @ hide
  math_3 = math_5 - math_2 @ hide
  math_4 = math_3 / 2.0 @ hide
  vector_math_4 = vector_math_2 - (vector_math_3 / combine_xyz + CombineXYZ(x: 0.5, y: math_4))
  .. {
    math_8 = min(
        Mix[clamp_factor: false](
          factor: join_tiles,
          a: Math[PINGPONG](Value: map_range, Value_001: 0.25),
          b: map_range),
        Math[PINGPONG](Value: vector_math_5.y) * Thickness)
      / Scale
  }
  mix = join_tiles
    ? vector_math_4 / Scale
    : CombineXYZ(x: Math[FLOORED_MODULO](Value: vector_math_4.x) - 0.25, y: vector_math_4.y) / Scale
  vector_math_6 = Vector - mix
  vector_math_7 = vector_math_6 * Scale + (1000.0, 1000.0, 0.0) @ hide
  vector_rotate = VectorRotate(vector: mix, axis: (0.0, 0.0, -1.0), angle: math) @ hide
  mix_2 = uv_oriented ? vector_rotate : mix @ "uv"
  return (
    Position: vector_math_6,
    UV: mix_2,
    Color: WhiteNoiseTexture(vector: vector_math_7).color,
    Edge: math_8,
    Masks: vector_math_3.y)
}
