shader graph "PT_ARB_TiedStars(8)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p6(16) modified" #311b4e {
    vector_math_2 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_4 = vector_math_2 / combine_xyz @ hide
    vector_math_3 = fract(vector_math_4) @ hide
    vector_math = vector_math_3 - (0.5, 0.5, 0.0) @ hide
    vector_math_5 = vector_math * combine_xyz @ hide
    vector_math_8 = combine_xyz * 0.5 @ hide
    vector_math_6 = vector_math_2 - vector_math_8 @ hide
    vector_math_7 = vector_math_6 / combine_xyz @ hide
    vector_math_9 = floor(vector_math_4) @ hide
    vector_math_10 = vector_math_9 * combine_xyz @ hide
    vector_math_11 = floor(vector_math_7) @ hide
    vector_math_12 = vector_math_11 * combine_xyz @ hide
    vector_math_13 = vector_math_12 + combine_xyz @ hide
    vector_math_15 = combine_xyz * 0.5 @ hide
    vector_math_14 = vector_math_10 + vector_math_15 @ hide
    vector_math_16 = abs(vector_math_5) @ hide
    vector_math_18 = vector_math_16 - (1.0, 0.0, 0.0) @ hide
    vector_math_17 = vector_math_18 ⋅ combine_xyz @ hide
    math = vector_math_17 > 0.0 @ hide
    mix = math ? vector_math_13 : vector_math_14
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_2 - mix, angle: 1.5707964) @ #572eda
    math_2 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_4 = vector_rotate.y < 0.0 @ hide
    math_6 = math_4 * 6.2831855 @ hide
    math_5 = math_2 + math_6 @ hide
    math_3 = floor(MapRange(value: math_5, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_7 = math_3 * 5.2359877
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_7)
    math_8 = math_7 + 1.5707964 @ #572eda
    math_9 = cos(math_8) @ hide
    math_10 = sin(math_8) @ hide
    combine_xyz_3 = CombineXYZ(x: math_10, y: math_9) @ hide
    math_11 = -math_10 @ hide
    combine_xyz_2 = CombineXYZ(x: math_9, y: math_11) @ hide
  }
  vector_math_19 = vector_rotate_2 - (0.28867513, 0.16666667, 0.0) @ #175531
  math_12 = vector_rotate_2.x > 0.57735026
  value = 0.57735026
  "p3(13) modified : no tiling" #311b4e {
    vector_rotate_3 = VectorRotate[Z_AXIS](vector: vector_math_19, angle: 0.5235988) @ hide
    math_13 = atan2(vector_rotate_3.y, vector_rotate_3.x) @ hide
    math_15 = vector_rotate_3.y < 0.0 @ hide
    math_17 = math_15 * 6.2831855 @ hide
    math_16 = math_13 + math_17 @ hide
    math_14 = floor(MapRange(value: math_16, from_max: 6.2831855, to_max: 3.0)) @ hide
    math_18 = math_14 * 4.1887903
    vector_rotate_4 = VectorRotate[Z_AXIS](vector: vector_rotate_3, angle: math_18)
    math_19 = math_18 + 0.5235988
    math_20 = cos(math_19) @ hide
    math_21 = sin(math_19) @ hide
    combine_xyz_5 = CombineXYZ(x: math_21, y: math_20) @ hide
    math_22 = -math_21 @ hide
    combine_xyz_4 = CombineXYZ(x: math_20, y: math_22) @ hide
  }
  vector_math_20 = vector_rotate_4 - (0.33333334, 0.0, 0.0) @ #175531
  vector_rotate_5 = VectorRotate(
    vector: vector_math_20,
    axis: (0.0, 0.0, -1.0),
    angle: 2.6179938) @ #175531
  math_23 = value * 0.2 @ hide
  combine_xyz_6 = CombineXYZ(x: math_23) @ hide
  vector_math_21 = vector_rotate_5 - combine_xyz_6 @ hide
  math_24 = value * 0.4 @ hide
  combine_xyz_7 = CombineXYZ(x: math_24) @ hide
  vector_math_22 = vector_rotate_5 - combine_xyz_7 @ hide
  math_25 = value * 0.8 @ hide
  combine_xyz_8 = CombineXYZ(x: math_25) @ hide
  vector_math_23 = vector_rotate_5 - combine_xyz_8 @ hide
  vector_math_27 = normalize((1.73205, -1.0, 0.0)) @ hide
  vector_math_24 = vector_math_21 ⋅ vector_math_27 @ hide
  vector_math_25 = vector_math_22 ⋅ vector_math_27 @ hide
  vector_math_28 = normalize((1.73205, 1.0, 0.0)) @ hide
  vector_math_26 = vector_math_23 ⋅ vector_math_28 @ hide
  math_26 = value * 0.5 @ hide
  combine_xyz_9 = CombineXYZ(x: math_26) @ hide
  vector_math_29 = vector_rotate_5 - combine_xyz_9 @ hide
  vector_math_30 = vector_math_29 ⋅ vector_math_27 @ hide
  math_27 = min(
    -(vector_rotate_5.y - value / 5.0 * 0.8660254),
    max(-vector_math_24, vector_math_25))
  math_28 = vector_math_26 > 0.0 @ hide
  math_29 = math_27 < 0.0 @ hide
  math_30 = vector_math_24 < 0.0 @ hide
  mix_2 = math_28
    ? (-0.166667, 0.288675, 0.0)
    : math_29 ? (0.0, 0.0, 0.0) : math_30 ? (0.33333334, 0.0, 0.0) : (0.166667, 0.288675, 0.0)
  vector_math_31 = combine_xyz_4 * mix_2.x
    + combine_xyz_5 * mix_2.y
    + (0.28867513, 0.16666667, 0.0) @ #175531
  vector_math_32 = combine_xyz_2 * vector_math_31.x + combine_xyz_3 * vector_math_31.y + mix
  vector_math_33 = vector_math_32 / Scale
  vector_math_34 = vector_math_32 + (1000.0, 1000.0, 0.0) @ hide
  vector_math_35 = Vector - vector_math_33 @ hide
  return (
    Position: vector_math_33,
    UV: vector_math_35,
    Color: WhiteNoiseTexture(vector: vector_math_34).color,
    Edge: min(
