shader graph SDF_Ellipse(
    Vector: Vector(hide_value: true),
    X: Float in 0.0..10000.0,
    Y: Float in 0.0..10000.0
) -> (Value: Float) {
  "SDF node"
  vector_math = abs(Vector) @ "p"
  math = vector_math.x > vector_math.y
  mix = Mix[RGBA](
    factor: math,
    a: vector_math,
    b: CombineXYZ(x: vector_math.y, y: vector_math.x)) @ "p"
  separate_xyz_2 = SeparateXYZ(vector: mix) @ "p"
  combine_xyz = CombineXYZ(x: X, y: Y)
  mix_2 = Mix[RGBA](
    factor: math,
    a: combine_xyz,
    b: CombineXYZ(x: combine_xyz.y, y: combine_xyz.x)) @ "ab"
  separate_xyz = SeparateXYZ(vector: mix_2) @ "ab"
  math_2 = pow(separate_xyz.y, 2.0) - pow(separate_xyz.x, 2.0) @ "l" #1d1d1d
  math_3 = separate_xyz.x * separate_xyz_2.x / math_2 @ "m" #1d1d1d
  math_4 = separate_xyz.y * separate_xyz_2.y / math_2 @ "n" #1d1d1d
  math_5 = math_3 * math_3 @ "m2" #1d1d1d
  math_6 = math_4 * math_4 @ "n2" #1d1d1d
  math_7 = (math_5 + math_6 - 1.0) / 3.0 @ "c"
  math_8 = pow(math_7, 3.0) @ "c3"
  math_9 = math_5 * math_6
  math_10 = math_9 * 2.0 + math_8 @ "q" #1d1d1d
  math_11 = math_8 + math_9 @ "d" #1d1d1d
  math_12 = math_3 * (1.0 + math_6) @ "g" #1d1d1d
  {
    math_14 = acos(math_10 / math_8) / 3.0
    math_13 = cos(math_14) @ "s"
    math_15 = sin(math_14) * 1.7320508 @ "t"
    math_17 = -math_7 @ "-c"
    math_16 = sqrt((math_13 + math_15 + 2.0) * math_17 + math_5) @ "rx"
    math_18 = sqrt((math_13 - math_15 + 2.0) * math_17 + math_5) @ "ry"
    math_19 = (Math[MULTIPLY_ADD](
          Value: math_2 > 0.0 ? 1.0 : -1.0,
          Value_001: math_16,
          Value_002: math_18)
        + abs(math_12) / (math_16 * math_18)
        - math_3)
      / 2.0
  }
  {
    math_20 = 2.0 * math_3 * math_4 * sqrt(math_11)
    math_21 = math_10 + math_20
    math_22 = math_10 - math_20
    math_23 = (math_21 > 0.0 ? 1.0 : -1.0) * pow(abs(math_21), 0.33333334) @ "s"
    math_24 = (math_22 > 0.0 ? 1.0 : -1.0) * pow(abs(math_22), 0.33333334) @ "u"
    math_25 = Math[MULTIPLY_ADD](
      Value: 2.0,
      Value_001: math_5,
      Value_002: -math_23 - math_24 - math_7 * 4.0) @ "rx"
    math_26 = (math_23 - math_24) * sqrt(3.0) @ "ry"
    vector_math_2 = length(CombineXYZ(x: math_25, y: math_26)) @ "rm"
    math_27 = (math_26 / sqrt(vector_math_2 - math_25) + 2.0 * math_12 / vector_math_2 - math_3)
      / 2.0
  }
  {
    mix_3 = Mix[clamp_factor: false](factor: math_11 < 0.0, a: math_27, b: math_19)
    vector_math_3 = mix_2 * CombineXYZ(x: mix_3, y: sqrt(1.0 - mix_3 * mix_3)) @ "r"
    math_28 = length(vector_math_3 - mix) * (mix.y - vector_math_3.y > 0.0 ? 1.0 : -1.0)
  }
  return (Value: math_28)
}
