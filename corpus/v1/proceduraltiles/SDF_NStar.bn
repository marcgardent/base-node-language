shader graph SDF_NStar(
    Vector: Vector(hide_value: true),
    N: Int = 6 in 2..,
    Radius: Float(description: "0") = 1.0 in -10000.0..10000.0,
    m: Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Value: Float) {
  "SDF node"
  math = 3.14159 / N @ "an"
  math_2 = 3.1415927
    / MapRange(value: m, from_min: 1.0, from_max: 0.0, to_min: 2.0, to_max: N) @ "en"
  math_3 = cos(math) @ hide
  math_4 = sin(math) @ hide
  combine_xyz = CombineXYZ(x: math_3, y: math_4) @ "acs"
  math_5 = cos(math_2) @ hide
  math_6 = sin(math_2) @ hide
  combine_xyz_2 = CombineXYZ(x: math_5, y: math_6) @ "ecs"
  separate_xyz = SeparateXYZ(vector: Vector) @ "p"
  math_7 = Math[FLOORED_MODULO](Value: atan2(separate_xyz.y, separate_xyz.x), Value_001: math * 2.0)
    - math
  math_8 = cos(math_7) @ hide
  math_9 = sin(math_7) @ hide
  vector_math = CombineXYZ(x: math_8, y: abs(math_9)) * length(Vector) - combine_xyz * Radius
  vector_math_2 = vector_math
    + combine_xyz_2 * Clamp(value: -(vector_math ⋅ combine_xyz_2), max: Radius * math_4 / math_6)
  math_10 = Math[DIVIDE, use_clamp: true](Value_001: 1.0)
  math_11 = 0.5 * -1.0
  return (
    Value: length(vector_math_2)
      * Mix[clamp_factor: false](factor: vector_math_2.x > 0.0, a: -1.0, b: 1.0))
}
