shader graph "PT_ARB_ThreeSpikes(20)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  vector_math_3 = normalize(CombineXYZ(x: 1.7320508, y: -1.0))
  vector_math_4 = normalize(CombineXYZ(x: 1.7320508, y: 1.0))
  "p6m(17)" #311b4e {
    vector_math_10 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_12 = vector_math_10 / combine_xyz @ hide
    vector_math_11 = fract(vector_math_12) @ hide
    vector_math_9 = vector_math_11 - (0.5, 0.5, 0.0) @ hide
    vector_math_13 = vector_math_9 * combine_xyz @ hide
    vector_math_16 = combine_xyz * 0.5 @ hide
    vector_math_14 = vector_math_10 - vector_math_16 @ hide
    vector_math_15 = vector_math_14 / combine_xyz @ hide
    vector_math_17 = floor(vector_math_12) @ hide
    vector_math_18 = vector_math_17 * combine_xyz @ hide
    vector_math_19 = floor(vector_math_15) @ hide
    vector_math_20 = vector_math_19 * combine_xyz @ hide
    vector_math_21 = vector_math_20 + combine_xyz @ hide
    vector_math_23 = combine_xyz * 0.5 @ hide
    vector_math_22 = vector_math_18 + vector_math_23 @ hide
    vector_math_24 = abs(vector_math_13) @ hide
    vector_math_26 = vector_math_24 - (1.0, 0.0, 0.0) @ hide
    vector_math_25 = vector_math_26 ⋅ combine_xyz @ hide
    math_7 = vector_math_25 > 0.0 @ hide
    mix_2 = math_7 ? vector_math_21 : vector_math_22
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_10 - mix_2, angle: 1.0471976) @ hide
    math_8 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_10 = vector_rotate.y < 0.0 @ hide
    math_12 = math_10 * 6.2831855 @ hide
    math_11 = math_8 + math_12 @ hide
    map_range = MapRange(value: math_11, from_max: 6.2831855, to_max: 6.0)
    math_9 = floor(map_range) @ hide
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_9 * 5.2359877)
    separate_xyz = SeparateXYZ(
      vector: VectorRotate[Z_AXIS](vector: vector_rotate_2, angle: 0.5235988)) @ hide
    math_16 = map_range * 2.0 @ hide
    math_17 = floor(math_16) @ hide
    math_18 = Math[FLOORED_MODULO](Value: math_17, Value_001: 2.0)
    combine_xyz_4 = CombineXYZ(
      x: Mix(factor: math_18, a: vector_rotate_2.x, b: separate_xyz.y),
      y: Mix(factor: math_18, a: vector_rotate_2.y, b: separate_xyz.x))
    math_19 = math_11 - 0.5235988 @ hide
    math_20 = Math[FLOORED_MODULO](Value: math_19, Value_001: 6.2831855) @ hide
    math_21 = floor(MapRange(value: math_20, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_22 = math_21 * 5.2359877
    math_13 = cos(math_22) @ hide
    math_14 = sin(math_22) @ hide
    combine_xyz_3 = CombineXYZ(x: math_14, y: math_13) @ hide
    math_15 = -math_14 @ hide
    combine_xyz_2 = CombineXYZ(x: math_13, y: math_15) @ hide
    vector_math_27 = combine_xyz_3 * MapRange(value: math_18, to_min: 1.0, to_max: -1.0)
  }
  vector_math = combine_xyz_4 - (0.35714287, 0.12371791, 0.0)
  vector_math_2 = combine_xyz_4 - (0.44642857, 0.21650635, 0.0)
  vector_math_5 = (combine_xyz_4 - (0.14285715, 0.0, 0.0)) ⋅ vector_math_3
  vector_math_6 = vector_math ⋅ vector_math_4 @ hide
  vector_math_7 = vector_math_2 ⋅ vector_math_4 @ hide
  vector_math_8 = (combine_xyz_4 - (0.42857143, 0.0, 0.0)) ⋅ vector_math_3
  math = -max(max(vector_math_7, vector_math_2.y), vector_math_8)
  math_2 = min(max(max(-vector_math_5, vector_math.y), vector_math_6), math)
  math_3 = math < 0.0 @ hide
  math_4 = math_2 < 0.0 @ hide
  math_5 = vector_math_5 < 0.0 @ hide
  math_6 = vector_math_8 < 0.0 @ hide
  mix = math_3
    ? (math_6 ? (0.5, 0.28867513, 0.0) : (0.5, 0.0, 0.0))
    : math_4 ? (0.2857143, 0.0, 0.0) : math_5 ? (0.0, 0.0, 0.0) : (0.35481367, 0.20485176, 0.0)
  vector_math_28 = combine_xyz_2 * mix.x + vector_math_27 * mix.y + mix_2
  vector_math_29 = vector_math_28 / Scale
  vector_math_30 = vector_math_28 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_29,
    UV: Vector - vector_math_29,
    Color: WhiteNoiseTexture(vector: vector_math_30).color,
    Edge: abs(math_2) / Scale,
    Masks: math_3 ? (math_6 ? 4.0 : 3.0) : math_4 ? 1.0 : math_5 ? 0.0 : 2.0)
}
