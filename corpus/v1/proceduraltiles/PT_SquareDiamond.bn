shader graph PT_SquareDiamond(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0,
    "Square 1 size": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    "Square 2 size": Float(subtype: FACTOR) = 0.5 in 0.0..1.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  vector_math_3 = Vector * Scale
  vector_math_4 = fract(vector_math_3)
  vector_math_2 = abs(vector_math_4 - (0.5, 0.5, 0.0))
  math = Math[MULTIPLY](Value: vector_math_2, Value_001: 3.0)
  math_2 = (math - MapRange(value: square_1_size, to_max: 0.5)) * 0.70710677
  math_3 = (math - MapRange(value: square_2_size, from_min: 1.0, from_max: 0.0, to_min: 0.5))
    * 0.70710677
  vector_math = vector_math_2 - (0.25, 0.25, 0.0)
  math_4 = math_2 < 0.0
  math_5 = math_3 > 0.0
  vector_math_5 = floor(vector_math_4 * 2.0) - (0.5, 0.5, 0.0)
  vector_math_6 = ((math_5 ? (0.5, 0.5, 0.0) : math_4 ? (0.0, 0.0, 0.0) : (0.25, 0.25, 0.0))
        + vector_math_5)
      * (vector_math_5 * 2.0)
    + floor(vector_math_3)
  math_6 = 1.0 / Scale
  vector_math_7 = vector_math_6 * math_6
  vector_math_8 = vector_math_6 + (1000.0, 1000.0, 0.0) @ hide
  {
    vector_math_9 = abs(vector_math) @ hide
    vector_math_10 = vector_math_9 - (0.25, 0.25, 0.0) @ hide
    vector_math_12 = max(vector_math_10, 0.0) @ hide
    vector_math_11 = length(vector_math_12) @ hide
    separate_xyz = SeparateXYZ(vector: vector_math_10) @ hide
    math_8 = max(separate_xyz.x, separate_xyz.y) @ hide
    math_7 = min(math_8, 0.0) @ hide
    math_9 = vector_math_11 + math_7 @ hide
  }
  return (
    Position: vector_math_7,
    UV: Vector - vector_math_7,
    Color: WhiteNoiseTexture(vector: vector_math_8).color,
    Edge: abs(max(max(-math_2, math_3), math_9)) * math_6,
    Masks: math_4 * 1.0 + math_5 * 2.0)
}
