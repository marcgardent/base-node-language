shader graph SDF_rUnion(
    Value: Float = 0.5 in -10000.0..10000.0,
    Value as value_float: Float = 0.5 in -10000.0..10000.0,
    Radius: Float = 0.5 in -10000.0..10000.0
) -> (Value: Float) {
  "SDF Operation"
  return (
    Value: -length(min(CombineXYZ(x: Value - Radius, y: value_float - Radius), 0.0))
      + max(min(Value, value_float), Radius))
}
