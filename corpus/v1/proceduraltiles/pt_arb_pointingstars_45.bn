shader graph "PT_ARB_PointingStars(45)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  value = 1.0
  value_2 = 2.41421
  math = -value @ hide
  math_2 = -value_2 @ hide
  combine_xyz = CombineXYZ(x: value_2, y: math)
  combine_xyz_2 = CombineXYZ(x: value, y: value_2)
  combine_xyz_3 = CombineXYZ(x: math_2, y: math)
  value_3 = 0.07925633
  "p4m(11)" #7b2a1b {
    vector_math_5 = Vector * Scale
    vector_math_6 = fract(vector_math_5) - (0.5, 0.5, 0.0)
    vector_math_7 = abs(vector_math_6)
    vector_math_8 = floor(vector_math_5) + (0.5, 0.5, 0.0) @ hide
    math_4 = sign(vector_math_6.x) @ hide
    math_5 = sign(vector_math_6.y) @ hide
    vector_math_9 = (1.0, 0.0, 0.0) * math_4 @ hide
    vector_math_10 = (0.0, 1.0, 0.0) * math_5 @ hide
    math_6 = vector_math_7.x - vector_math_7.y < 0.0
    mix = math_6 ? vector_math_10 : vector_math_9 @ hide
    mix_2 = math_6 ? vector_math_9 : vector_math_10 @ hide
    mix_3 = math_6 ? CombineXYZ(x: vector_math_7.y, y: vector_math_7.x) : vector_math_7
  }
  vector_math = mix_3 - (0.10355339, 0.04289321, 0.0)
  vector_math_2 = mix_3 - (0.29289323, 0.29289323, 0.0)
  vector_math_3 = vector_math_2 ⋅ normalize(combine_xyz_2)
  vector_math_4 = mix_3 ⋅ normalize(CombineXYZ(x: value, y: math_2))
  math_3 = min(vector_math ⋅ normalize(combine_xyz), vector_math ⋅ normalize(combine_xyz_2))
  vector_math_11 = mix_3 - (0.5, 0.20710678, 0.0)
  vector_math_12 = vector_math_11 ⋅ normalize(combine_xyz)
  vector_math_13 = vector_math_11 ⋅ normalize(combine_xyz_3)
  math_7 = min(abs(vector_math_4) - value_3, vector_math_2 ⋅ normalize(combine_xyz_3))
  math_8 = vector_math_3 - 0.15851267
  math_9 = math_7 < 0.0 @ hide
  math_10 = vector_math_4 < 0.0 @ hide
  math_11 = vector_math_12 > 0.0 @ hide
  math_12 = vector_math_3 < 0.0 @ hide
  math_13 = math_3 < 0.0 @ hide
  math_14 = vector_math_13 > 0.0 @ hide
  math_15 = math_8 < 0.0 @ hide
  mix_4 = math_9
    ? (math_11
      ? (0.5, 0.0, 0.0)
      : math_12
        ? (math_13 ? (0.0, 0.0, 0.0) : (0.30952814, 0.12821075, 0.0))
        : math_14
          ? (0.35355338, 0.35355338, 0.0)
          : math_15 ? (0.5, 0.33333334, 0.0) : (0.5, 0.5, 0.0))
    : math_10 ? (0.2369288, 0.2369288, 0.0) : (0.33506793, 0.0, 0.0)
  mix_8 = math_13 ? 0.0 : 1.0 @ hide
  mix_10 = math_15 ? 4.0 : 5.0 @ hide
  mix_9 = math_14 ? 3.0 : mix_10 @ hide
  mix_7 = math_12 ? mix_8 : mix_9 @ hide
  mix_6 = math_11 ? 3.0 : mix_7 @ hide
  mix_5 = math_9 ? mix_6 : 2.0 @ hide
  vector_math_14 = mix * mix_4.x + mix_2 * mix_4.y + vector_math_8
  vector_math_15 = vector_math_14 / Scale
  vector_math_16 = vector_math_14 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_15,
    UV: Vector - vector_math_15,
    Color: WhiteNoiseTexture(vector: vector_math_16).color,
    Edge: abs(
        min(
          min(abs(min(max(max(math_7, vector_math_12), vector_math_3), vector_math_13)), math_3),
          -math_8))
      / Scale,
    Masks: mix_5)
}
