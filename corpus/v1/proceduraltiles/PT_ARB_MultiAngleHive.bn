    separate_xyz_12 = SeparateXYZ(vector: vector_math_36) @ hide
    math_57 = separate_xyz_12.x + separate_xyz_12.y @ hide
    math_58 = math_57 > 0.5 @ hide
    mix_3 = math_58 ? vector_math_40 : vector_math_39 @ hide
