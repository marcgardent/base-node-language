  vector_math_27 = mix - (0.654225, 0.345775, 0.0) @ hide
  vector_math_25 = vector_math_27 ⋅ combine_xyz_9
  math_12 = abs(vector_math) @ hide
  math_13 = abs(vector_math_4) @ hide
  math_11 = min(math_12, math_13) @ hide
  math_14 = min(vector_math_7, vector_math_19) @ hide
  math_16 = abs(vector_math_16) @ hide
  math_17 = -vector_math_10 @ hide
  math_18 = -math_14 @ hide
  math_19 = min(math_18, math_16) @ hide
  math_15 = abs(math_19) @ hide
  math_10 = min(math_11, math_15) @ hide
  math_20 = min(math_17, vector_math_25) @ hide
  math_23 = abs(vector_math_13) @ hide
  math_25 = -math_20 @ hide
  math_24 = min(math_23, math_25) @ hide
  math_21 = abs(math_24) @ hide
  math_22 = min(math_10, math_21) @ hide
  math_26 = abs(vector_math_22) @ hide
  math_27 = min(math_22, math_26) @ hide
  math_28 = mix.x < 0.358 @ hide
  math_29 = mix.x > 0.162 @ hide
  math_30 = min(math_29, math_28) @ hide
  math_31 = mix.x > 0.552 @ hide
  math_32 = Math[MAXIMUM, use_clamp: true](Value: math_31, Value_001: math_30) @ hide
  math_33 = mix.y + math_32 @ hide
  math_34 = min(math_27, math_33) @ hide
  math_35 = mix.x - mix.y @ hide
  math_36 = mix.x + mix.y @ hide
  math_37 = math_36 > 0.8216581 @ hide
  math_38 = math_36 < 0.4992174 @ hide
  math_39 = max(math_38, math_37) @ hide
  math_41 = math_35 / 1.4142135 @ hide
  math_40 = math_41 + math_39 @ hide
  math_42 = min(math_34, math_40) @ hide
  math_44 = vector_math > 0.0 @ hide
  math_45 = vector_math_4 > 0.0 @ hide
  math_46 = vector_math_7 > 0.0 @ hide
  math_47 = vector_math_19 < 0.0 @ hide
  math_48 = vector_math_16 < 0.0 @ hide
  math_49 = vector_math_13 > 0.0 @ hide
  math_50 = vector_math_10 > 0.0 @ hide
  math_51 = vector_math_25 > 0.0 @ hide
  math_52 = vector_math_22 > 0.0 @ hide
  math_53 = min(math_47, math_48) @ hide
  math_54 = min(math_49, math_50) @ hide
