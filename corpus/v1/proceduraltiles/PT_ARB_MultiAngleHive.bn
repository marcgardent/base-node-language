  "A node tree :)"
  vector_math_2 = normalize((0.3302788, 0.9438834, 0.0)) @ hide
  separate_xyz = SeparateXYZ(vector: vector_math_2) @ hide
  math = -separate_xyz.x @ hide
  combine_xyz = CombineXYZ(x: separate_xyz.y, y: math) @ hide
  vector_math_5 = normalize((-0.39988518, 0.91656524, 0.0)) @ hide
