shader graph "WPG_16(p6)"(
    Vector: Vector(hide_value: true),
    scale: Float = 5.0
) -> (UV: Vector, position: Vector, mx: Vector, my: Vector) {
  "Wallpaper group tile pattern more on :https://en.wikipedia.org/wiki/Wallpaper_group"
  "p6(16)" #311b4e {
    vector_math_2 = Vector * scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_4 = vector_math_2 / combine_xyz @ hide
    vector_math_3 = fract(vector_math_4) @ hide
    vector_math = vector_math_3 - (0.5, 0.5, 0.0) @ hide
    vector_math_5 = vector_math * combine_xyz @ hide
    vector_math_8 = combine_xyz * 0.5 @ hide
    vector_math_6 = vector_math_2 - vector_math_8 @ hide
    vector_math_7 = vector_math_6 / combine_xyz @ hide
    vector_math_9 = floor(vector_math_4) @ hide
    vector_math_10 = vector_math_9 * combine_xyz @ hide
    vector_math_11 = floor(vector_math_7) @ hide
    vector_math_12 = vector_math_11 * combine_xyz @ hide
    vector_math_13 = vector_math_12 + combine_xyz @ hide
    vector_math_15 = combine_xyz * 0.5 @ hide
    vector_math_14 = vector_math_10 + vector_math_15 @ hide
    vector_math_16 = abs(vector_math_5) @ hide
    vector_math_18 = vector_math_16 - (1.0, 0.0, 0.0) @ hide
    vector_math_17 = vector_math_18 ⋅ combine_xyz @ hide
    math = vector_math_17 > 0.0 @ hide
    mix = math ? vector_math_13 : vector_math_14
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_2 - mix, angle: 1.0471976) @ hide
    math_2 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_4 = vector_rotate.y < 0.0 @ hide
    math_6 = math_4 * 6.2831855 @ hide
    math_5 = math_2 + math_6 @ hide
    math_3 = floor(MapRange(value: math_5, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_7 = math_3 * 5.2359877
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_7)
    math_8 = math_7 + 1.0471976
    math_9 = cos(math_8) @ hide
    math_10 = sin(math_8) @ hide
    combine_xyz_3 = CombineXYZ(x: math_10, y: math_9) @ hide
    math_11 = -math_10 @ hide
    combine_xyz_2 = CombineXYZ(x: math_9, y: math_11) @ hide
  }
  return (UV: vector_rotate_2, position: mix, mx: combine_xyz_2, my: combine_xyz_3)
}
