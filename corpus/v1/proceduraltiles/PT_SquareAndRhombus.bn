shader graph PT_SquareAndRhombus(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  vector_math_2 = normalize((0.9659258, 0.25881904, 0.0)) @ hide
  value = 0.517638
  vector_math_4 = normalize((1.0, 1.0, 0.0)) @ hide
  vector_math_5 = vector_math_4 * value @ hide
  vector_math_7 = normalize((-0.258819, 0.965926, 0.0)) @ hide
  vector_math_9 = normalize((0.965926, 0.258819, 0.0)) @ hide
  vector_math_10 = vector_math_9 * value @ hide
  vector_math_11 = vector_math_5 + vector_math_10 @ hide
  vector_math_13 = normalize((-0.965926, -0.258819, 0.0)) @ hide
  vector_math_15 = normalize((-0.965926, 0.258819, 0.0)) @ hide
  vector_math_17 = normalize((0.258819, 0.965926, 0.0)) @ hide
  vector_math_18 = normalize((0.965926, -0.258819, 0.0)) @ hide
  vector_math_19 = vector_math_18 * value @ hide
  math_20 = Scale / 2.0 @ hide
  vector_math_23 = Vector * math_20
  vector_math_24 = fract(vector_math_23)
  separate_xyz = SeparateXYZ(vector: vector_math_24) @ hide
  math_8 = separate_xyz.x - separate_xyz.y @ hide
  math_9 = math_8 < 0.0 @ hide
  mix = math_9 ? CombineXYZ(x: separate_xyz.y, y: separate_xyz.x) : vector_math_24
  vector_math_3 = mix - vector_math_5
  vector_math = vector_math_3 ⋅ vector_math_2 @ hide
  vector_math_6 = vector_math_3 ⋅ vector_math_7 @ hide
  vector_math_8 = mix - vector_math_11
  vector_math_12 = vector_math_8 ⋅ vector_math_13 @ hide
  vector_math_14 = vector_math_8 ⋅ vector_math_15 @ hide
  vector_math_16 = vector_math_8 ⋅ vector_math_17 @ hide
  vector_math_20 = mix - vector_math_19
  vector_math_21 = vector_math_20 ⋅ vector_math_17 @ hide
  vector_math_22 = vector_math_20 ⋅ vector_math_7 @ hide
  math = max(vector_math_12, vector_math_14) @ hide
  math_2 = abs(vector_math_16) @ hide
  math_3 = -math @ hide
  math_4 = min(math_3, math_2) @ hide
  math_5 = max(math_4, min(vector_math_6, math)) @ hide
  math_6 = -math_5 @ hide
  math_7 = min(vector_math_21, vector_math_22) @ hide
  math_10 = vector_math_14 > 0.0 @ hide
  math_11 = max(vector_math_6, vector_math_16) @ hide
  math_12 = math_11 > 0.0 @ hide
  math_13 = vector_math_12 > 0.0 @ hide
  math_14 = vector_math > 0.0 @ hide
  mix_2 = math_14
    ? (math_12
      ? (math_10 ? (0.6830128, 0.683013, 0.0) : (1.1830128, 0.6830127, 0.0))
      : math_13 ? (0.683013, 0.1830127, 0.0) : (1.18301, 0.18301, 0.0))
    : (0.1830128, 0.183013, 0.0)
  vector_math_25 = (math_9 ? CombineXYZ(x: mix_2.y, y: mix_2.x) : mix_2) + floor(vector_math_23)
  vector_math_27 = vector_math_25 + (1000.0, 1000.0, 0.0) @ hide
  math_15 = vector_math_14 > 0.0 @ hide
  math_16 = max(vector_math_6, vector_math_16) @ hide
  math_17 = math_16 > 0.0 @ hide
  math_18 = vector_math_12 > 0.0 @ hide
  math_19 = vector_math > 0.0 @ hide
  math_21 = Scale / 2.0 @ hide
  vector_math_26 = vector_math_25 / math_21
  math_22 = min(abs(min(math_6, vector_math)), math_7) / math_21 @ hide
  return (
    Position: vector_math_26,
    UV: Vector - vector_math_26,
    Color: WhiteNoiseTexture(vector: vector_math_27).color,
    Edge: math_22,
    Masks: math_19 ? (math_17 ? (math_15 ? 0.0 : 1.0) : math_18 ? 1.0 : 0.0) : 0.0)
}
