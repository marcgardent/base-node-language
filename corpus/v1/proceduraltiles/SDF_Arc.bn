shader graph SDF_Arc(
    Vector: Vector(hide_value: true),
    Arc: Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Radius: Float = 1.0 in 0.0..,
    Orientation: Float(subtype: ANGLE)
) -> (Value: Float) {
  "SDF node"
  map_range = MapRange(
    value: Arc,
    from_min: 1.0,
    from_max: 0.0,
    to_min: -1.5707964,
    to_max: 1.5707964)
  combine_xyz = CombineXYZ(x: cos(map_range), y: sin(map_range)) @ "sc"
  vector_rotate = VectorRotate(vector: Vector, angle: Orientation)
  math = abs(vector_rotate.x) @ hide
  combine_xyz_2 = CombineXYZ(x: math, y: vector_rotate.y, z: vector_rotate.z)
  return (
    Value: Mix[clamp_factor: false](
      factor: math * combine_xyz.y > combine_xyz.x * vector_rotate.y,
      a: abs(length(combine_xyz_2) - Radius),
      b: length(combine_xyz_2 - combine_xyz * Radius)))
}
