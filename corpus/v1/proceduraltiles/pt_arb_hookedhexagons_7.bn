shader graph "PT_ARB_HookedHexagons(7)"(
    Vector: Vector(hide_value: true),
    Scale: Float
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p6m(17)" #311b4e {
    vector_math_5 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_7 = vector_math_5 / combine_xyz @ hide
    vector_math_6 = fract(vector_math_7) @ hide
    vector_math_4 = vector_math_6 - (0.5, 0.5, 0.0) @ hide
    vector_math_8 = vector_math_4 * combine_xyz @ hide
    vector_math_11 = combine_xyz * 0.5 @ hide
    vector_math_9 = vector_math_5 - vector_math_11 @ hide
    vector_math_10 = vector_math_9 / combine_xyz @ hide
    vector_math_12 = floor(vector_math_7) @ hide
    vector_math_13 = vector_math_12 * combine_xyz @ hide
    vector_math_14 = floor(vector_math_10) @ hide
    vector_math_15 = vector_math_14 * combine_xyz @ hide
    vector_math_16 = vector_math_15 + combine_xyz @ hide
    vector_math_18 = combine_xyz * 0.5 @ hide
    vector_math_17 = vector_math_13 + vector_math_18 @ hide
    vector_math_19 = abs(vector_math_8) @ hide
    vector_math_21 = vector_math_19 - (1.0, 0.0, 0.0) @ hide
    vector_math_20 = vector_math_21 ⋅ combine_xyz @ hide
    math_6 = vector_math_20 > 0.0 @ hide
    mix = math_6 ? vector_math_16 : vector_math_17
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_5 - mix, angle: 1.0471976) @ hide
    math_7 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_9 = vector_rotate.y < 0.0 @ hide
    math_11 = math_9 * 6.2831855 @ hide
    math_10 = math_7 + math_11 @ hide
    map_range = MapRange(value: math_10, from_max: 6.2831855, to_max: 6.0)
    math_8 = floor(map_range) @ hide
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_8 * 5.2359877)
    separate_xyz = SeparateXYZ(
      vector: VectorRotate[Z_AXIS](vector: vector_rotate_2, angle: 0.5235988)) @ hide
    math_15 = map_range * 2.0 @ hide
    math_16 = floor(math_15) @ hide
    math_17 = Math[FLOORED_MODULO](Value: math_16, Value_001: 2.0)
    combine_xyz_4 = CombineXYZ(
      x: Mix(factor: math_17, a: vector_rotate_2.x, b: separate_xyz.y),
      y: Mix(factor: math_17, a: vector_rotate_2.y, b: separate_xyz.x))
    math_18 = math_10 - 0.5235988 @ hide
    math_19 = Math[FLOORED_MODULO](Value: math_18, Value_001: 6.2831855) @ hide
    math_20 = floor(MapRange(value: math_19, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_21 = math_20 * 5.2359877
    math_12 = cos(math_21) @ hide
    math_13 = sin(math_21) @ hide
    combine_xyz_3 = CombineXYZ(x: math_13, y: math_12) @ hide
    math_14 = -math_13 @ hide
    combine_xyz_2 = CombineXYZ(x: math_12, y: math_14) @ hide
    vector_math_22 = combine_xyz_3 * MapRange(value: math_17, to_min: 1.0, to_max: -1.0)
  }
  vector_math = combine_xyz_4 - (0.33333334, 0.0, 0.0)
  math = combine_xyz_4 ⋅ normalize((1.0, -1.73205, 0.0)) - 0.05612
  vector_math_2 = vector_math ⋅ normalize((1.0, 1.73205, 0.0))
  vector_math_3 = vector_math ⋅ normalize((-1.0, 1.73205, 0.0))
  math_2 = -((combine_xyz_4 - (0.11111111, 0.0, 0.0)) ⋅ normalize((1.0, 1.73205, 0.0)))
  math_3 = min(math, vector_math_2)
  math_4 = max(vector_math_3, combine_xyz_4.x - 0.444444)
  math_5 = combine_xyz_4.x - 0.3888889
  math_22 = Math[PINGPONG](Value: math_8, Value_001: 1.0)
  math_23 = max(min(math, -(math_5 + 0.055555556)), math_5 - 0.055555556)
  math_24 = math_23 < 0.0 @ hide
  math_25 = math_5 < 0.0 @ hide
  math_26 = math_3 > 0.0 @ hide
  math_27 = math_2 < 0.0 @ hide
  math_28 = math_4 > 0.0 @ hide
  math_29 = 0.5 / sqrt(3.0)
  combine_xyz_5 = CombineXYZ(x: 0.5, y: math_29)
  combine_xyz_6 = CombineXYZ(x: 0.5, y: -math_29)
  mix_2 = Mix[VECTOR](
    factor: math_22,
    a: math_26
      ? (math_28 ? combine_xyz_6 : (0.0, 0.0, 0.0))
      : math_27 ? combine_xyz_5 : (0.0, 0.0, 0.0),
    b: math_24 ? (0.0, 0.0, 0.0) : math_25 ? combine_xyz_6 : combine_xyz_5)
  vector_math_23 = combine_xyz_2 * mix_2.x + vector_math_22 * mix_2.y + mix
  vector_math_24 = vector_math_23 / Scale
  vector_math_25 = vector_math_23 + (10000.0, 10000.0, 0.0) @ hide
  return (
    Position: vector_math_24,
    UV: vector_math_24 - Vector,
    Color: WhiteNoiseTexture(vector: vector_math_25).color,
    Edge: Mix(
        factor: math_22,
        a: abs(min(max(math_3, math_2), math_4)),
        b: min(abs(math_23), max(vector_math_2, vector_math_3)))
      / Scale,
    Masks: Mix(
      factor: math_22,
      a: math_26 ? (math_28 ? 2.0 : 1.0) : math_27 ? 0.0 : 1.0,
      b: math_24 ? 1.0 : math_25 ? 0.0 : 2.0))
}
