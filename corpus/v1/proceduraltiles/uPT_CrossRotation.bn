shader graph uPT_CrossRotation(Vector: Vector(hide_value: true)) -> (Vector: Vector, Masks: Int) {
  "PT Utils"
  vector_math_2 = Vector - (0.5, 0.5, 0.0)
  math = vector_math_2.x + vector_math_2.y > 0.0
  math_2 = vector_math_2.x - vector_math_2.y > 0.0
  vector_math = ((1.0, 1.0, 0.0) * ((math - 0.5) * 2.0) + (1.0, -1.0, 0.0) * ((math_2 - 0.5) * 2.0))
    * 0.5
  return (
    Vector: VectorRotate[invert: true](
        vector: vector_math_2 - vector_math,
        angle: atan2(vector_math.y, vector_math.x) + 1.5707964)
      + (0.5, -0.5, 0.0),
    Masks: math_2 ? (math ? 0.0 : 3.0) : math ? 1.0 : 2.0)
}
