shader graph PT_HexParallelogram(
    Vector: Vector(hide_value: true),
    Scale: Float = 10.0
) -> (Position: Vector, UV: Vector, "UV center": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  vector_math_2 = normalize((1.7320508, 1.0, 0.0)) @ hide
  "p3(13)" #311b4e {
    vector_math_5 = Vector * Scale
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_7 = vector_math_5 / combine_xyz @ hide
    vector_math_6 = fract(vector_math_7) @ hide
    vector_math_4 = vector_math_6 - (0.5, 0.5, 0.0) @ hide
    vector_math_8 = vector_math_4 * combine_xyz @ hide
    vector_math_11 = combine_xyz * 0.5 @ hide
    vector_math_9 = vector_math_5 - vector_math_11 @ hide
    vector_math_10 = vector_math_9 / combine_xyz @ hide
    vector_math_12 = floor(vector_math_7) @ hide
    vector_math_13 = vector_math_12 * combine_xyz @ hide
    vector_math_14 = floor(vector_math_10) @ hide
    vector_math_15 = vector_math_14 * combine_xyz @ hide
    vector_math_16 = vector_math_15 + combine_xyz @ hide
    vector_math_18 = combine_xyz * 0.5 @ hide
    vector_math_17 = vector_math_13 + vector_math_18 @ hide
    vector_math_19 = abs(vector_math_8) @ hide
    vector_math_21 = vector_math_19 - (1.0, 0.0, 0.0) @ hide
    vector_math_20 = vector_math_21 ⋅ combine_xyz @ hide
    math_4 = vector_math_20 > 0.0 @ hide
    mix = math_4 ? vector_math_16 : vector_math_17
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_5 - mix, angle: 0.5235988) @ hide
    math_5 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_7 = vector_rotate.y < 0.0 @ hide
    math_9 = math_7 * 6.2831855 @ hide
    math_8 = math_5 + math_9 @ hide
    math_6 = floor(MapRange(value: math_8, from_max: 6.2831855, to_max: 3.0)) @ hide
    math_10 = math_6 * 4.1887903
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_10)
    math_11 = math_10 + 0.5235988
    math_12 = cos(math_11) @ hide
    math_13 = sin(math_11) @ hide
    combine_xyz_3 = CombineXYZ(x: math_13, y: math_12) @ hide
    math_14 = -math_13 @ hide
    combine_xyz_2 = CombineXYZ(x: math_12, y: math_14) @ hide
  }
  map_range = MapRange(value: vector_rotate_2.y, from_min: 0.5, from_max: 0.0, to_max: 0.5) @ hide
  vector_math = vector_rotate_2 ⋅ vector_math_2
  map_range_2 = MapRange(value: vector_math, from_min: 0.5, from_max: 0.0, to_max: 0.5) @ hide
  math_3 = min(vector_math, map_range_2) @ hide
  math_2 = min(math_3, vector_rotate_2.y) @ hide
  math = min(math_2, map_range) @ hide
  vector_math_3 = combine_xyz_2 * 0.1443375 + combine_xyz_3 * 0.25 + mix
  vector_math_22 = vector_math_3 / Scale
  vector_math_23 = vector_math_3 + (1000.0, 1000.0, 0.0) @ hide
  return (
    Position: vector_math_22,
    UV: vector_rotate_2,
    "UV center": Vector - vector_math_22,
    Color: WhiteNoiseTexture(vector: vector_math_23).color,
    Edge: math / Scale,
    Masks: math_6)
}
