shader graph PT_SquaryDiamondBoard(
    Vector: Vector(hide_value: true),
    Scale: Float = 5.0,
    "Board size": Float(subtype: FACTOR) = 0.25 in 0.0..1.0,
    Boards: Int = 3
) -> (Position: Vector, UV: Vector, "UV oriented": Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  math_8 = 0.5 / Boards @ hide
  "p4m(11)" #7b2a1b {
    vector_math = Vector * Scale
    vector_math_2 = fract(vector_math) - (0.5, 0.5, 0.0)
    vector_math_3 = abs(vector_math_2)
    vector_math_4 = floor(vector_math) + (0.5, 0.5, 0.0) @ hide
    math_9 = sign(vector_math_2.x) @ hide
    math_10 = sign(vector_math_2.y) @ hide
    vector_math_5 = (1.0, 0.0, 0.0) * math_9 @ hide
    vector_math_6 = (0.0, 1.0, 0.0) * math_10 @ hide
    math_11 = vector_math_3.x - vector_math_3.y < 0.0
    mix_2 = math_11 ? vector_math_6 : vector_math_5 @ hide
    mix_3 = math_11 ? vector_math_5 : vector_math_6 @ hide
    mix_4 = math_11 ? CombineXYZ(x: vector_math_3.y, y: vector_math_3.x) : vector_math_3
  }
  math = mix_4.x - mix_4.y - MapRange(value: board_size, to_max: 0.5)
  math_2 = mix_4.x * Boards
  map_range = MapRange(value: mix_4.x, from_max: 0.5, to_min: 0.5, to_max: 0.0) @ hide
  math_3 = math / 1.4142135
  math_4 = math < 0.0 @ hide
  math_5 = floor(math_2) @ hide
  math_6 = math_5 / Boards @ hide
  math_7 = math_6 + math_8 @ hide
  mix = math_4 ? (0.25, 0.25, 0.0) : CombineXYZ(x: math_7)
  vector_math_7 = mix_2 * mix.x + mix_3 * mix.y + vector_math_4
  vector_math_8 = vector_math_7 / Scale
  vector_math_9 = Vector - vector_math_8
  math_12 = math_5 + 1.0
  return (
    Position: vector_math_8,
    UV: vector_math_9,
    "UV oriented": VectorRotate(
      vector: vector_math_9,
      angle: math > 0.0 ? math_11 * 4.712389 : 0.7853982),
    Color: WhiteNoiseTexture(vector: vector_math_7 + (1000.0, 1000.0, 0.0)).color,
    Edge: max(
        min(Math[PINGPONG](Value: math_2) / Boards, math_3),
        min(-math_3, min(map_range, min(mix_4.y, 0.5))))
      / Scale,
    Masks: (math > math_12) * math_12)
}
