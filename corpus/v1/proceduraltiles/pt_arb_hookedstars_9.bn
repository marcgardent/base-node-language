shader graph "PT_ARB_HookedStars(9)"(
    Vector: Vector(hide_value: true),
    Scale: Float = 3.0
) -> (Position: Vector, UV: Vector, Color: Color, Edge: Float, Masks: Int) {
  "A node tree :)"
  "p6(16) modified" #311b4e {
    combine_xyz = CombineXYZ(x: 1.0, y: 1.73205)
    vector_math_8 = combine_xyz * 0.5 @ hide
    vector_math_15 = combine_xyz * 0.5 @ hide
  }
  vector_math_20 = normalize((2.5, 0.28867513, 0.0))
  math_22 = -2.0943952 + atan2(vector_math_20.y, vector_math_20.x)
  math_23 = 2.51661 / 0.33333334
  vector_math_28 = normalize((2.5, 0.28867513, 0.0))
  vector_rotate_6 = VectorRotate[Z_AXIS, invert: true](
    vector: Vector,
    angle: atan2(vector_math_28.y, vector_math_28.x))
  "p6(16) modified" .. {
    vector_math_2 = vector_rotate_6 * Scale
    vector_math_4 = vector_math_2 / combine_xyz @ hide
    vector_math_3 = fract(vector_math_4) @ hide
    vector_math = vector_math_3 - (0.5, 0.5, 0.0) @ hide
    vector_math_5 = vector_math * combine_xyz @ hide
    vector_math_6 = vector_math_2 - vector_math_8 @ hide
    vector_math_7 = vector_math_6 / combine_xyz @ hide
    vector_math_9 = floor(vector_math_4) @ hide
    vector_math_10 = vector_math_9 * combine_xyz @ hide
    vector_math_11 = floor(vector_math_7) @ hide
    vector_math_12 = vector_math_11 * combine_xyz @ hide
    vector_math_13 = vector_math_12 + combine_xyz @ hide
    vector_math_14 = vector_math_10 + vector_math_15 @ hide
    vector_math_16 = abs(vector_math_5) @ hide
    vector_math_18 = vector_math_16 - (1.0, 0.0, 0.0) @ hide
    vector_math_17 = vector_math_18 ⋅ combine_xyz @ hide
    math = vector_math_17 > 0.0 @ hide
    mix = math ? vector_math_13 : vector_math_14
    vector_rotate = VectorRotate[Z_AXIS](vector: vector_math_2 - mix, angle: 1.5707964) @ #572eda
    math_2 = atan2(vector_rotate.y, vector_rotate.x) @ hide
    math_4 = vector_rotate.y < 0.0 @ hide
    math_6 = math_4 * 6.2831855 @ hide
    math_5 = math_2 + math_6 @ hide
    math_3 = floor(MapRange(value: math_5, from_max: 6.2831855, to_max: 6.0)) @ hide
    math_7 = math_3 * 5.2359877
    vector_rotate_2 = VectorRotate[Z_AXIS](vector: vector_rotate, angle: math_7)
    math_8 = math_7 + 1.5707964 @ #572eda
    math_9 = cos(math_8) @ hide
    math_10 = sin(math_8) @ hide
    combine_xyz_3 = CombineXYZ(x: math_10, y: math_9) @ hide
    math_11 = -math_10 @ hide
    combine_xyz_2 = CombineXYZ(x: math_9, y: math_11) @ hide
  }
  vector_math_19 = vector_rotate_2 - (0.28867513, 0.16666667, 0.0) @ #175531
  "p3(13) modified : no tiling" #311b4e {
    vector_rotate_3 = VectorRotate[Z_AXIS](vector: vector_math_19, angle: 0.5235988) @ hide
    math_12 = atan2(vector_rotate_3.y, vector_rotate_3.x) @ hide
    math_14 = vector_rotate_3.y < 0.0 @ hide
    math_16 = math_14 * 6.2831855 @ hide
    math_15 = math_12 + math_16 @ hide
    math_13 = floor(MapRange(value: math_15, from_max: 6.2831855, to_max: 3.0)) @ hide
    math_17 = math_13 * 4.1887903
    vector_rotate_4 = VectorRotate[Z_AXIS](vector: vector_rotate_3, angle: math_17)
    math_18 = math_17 + 0.5235988
    math_19 = cos(math_18) @ hide
    math_20 = sin(math_18) @ hide
    combine_xyz_5 = CombineXYZ(x: math_20, y: math_19) @ hide
    math_21 = -math_20 @ hide
    combine_xyz_4 = CombineXYZ(x: math_19, y: math_21) @ hide
  }
  vector_math_21 = VectorRotate[Z_AXIS](vector: vector_rotate_4, angle: math_22) * math_23
  vector_math_22 = vector_math_21 - (-0.5, -1.4433756, 0.0)
  vector_math_23 = vector_math_21 - (1.0, -0.57735026, 0.0)
  vector_math_24 = vector_math_23 ⋅ normalize((1.7320508, -1.0, 0.0))
  math_24 = -vector_math_22.y @ hide
  math_25 = -(vector_math_22 ⋅ normalize((1.7320508, 1.0, 0.0))) @ hide
  math_26 = min(vector_math_21.x, vector_math_23.y)
  math_28 = math_26 < 0.0 @ hide
  math_29 = vector_math_24 < 0.0 @ hide
  math_30 = max(math_25, math_24) @ hide
  math_27 = math_30 > 0.0 @ hide
  vector_rotate_5 = VectorRotate[Z_AXIS, invert: true](
    vector: (math_27
        ? (-1.0, -2.309401, 0.0)
        : math_28
          ? (0.75, -1.010363, 0.0)
          : math_29 ? (0.5, 1.1547005, 0.0) : (2.5, 0.28867513, 0.0))
      / math_23,
    angle: math_22)
  vector_math_25 = combine_xyz_4 * vector_rotate_5.x
    + combine_xyz_5 * vector_rotate_5.y
    + (0.28867513, 0.16666667, 0.0) @ #175531
  vector_math_26 = combine_xyz_2 * vector_math_25.x + combine_xyz_3 * vector_math_25.y + mix
  vector_math_27 = vector_math_26 + (1000.0, 1000.0, 0.0) @ hide
  math_31 = max(math_28, math_29) @ hide
  mix_2 = math_27 ? 0.0 : math_31 @ hide
  vector_math_29 = normalize((2.5, 0.28867513, 0.0))
  vector_rotate_7 = VectorRotate[Z_AXIS](
    vector: vector_math_26 / Scale,
    angle: atan2(vector_math_29.y, vector_math_29.x))
  return (
    Position: vector_rotate_7,
    UV: Vector - vector_rotate_7,
    Color: WhiteNoiseTexture(vector: vector_math_27).color,
    Edge: min(
        abs(min(max(max(math_26, math_25), math_24), abs(min(math_26, abs(vector_math_24))))),
        vector_math_21 ⋅ normalize((0.57735026, -1.0, 0.0)))
      / (2.51661 / 0.33333334)
      / Scale,
    Masks: Mix(
      factor: mix_2,
      b: Math[FLOORED_MODULO](
          Value: (math_13 > 1.0
              ? (math_28 ? 2.0 : 1.0)
              : math_13 > 0.0 ? (math_28 ? 0.0 : 2.0) : math_28 ? 1.0 : 0.0)
            + math_3 * 0.5 * 2.0,
          Value_001: 3.0)
        + 1.0))
}
