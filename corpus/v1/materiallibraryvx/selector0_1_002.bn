shader graph "Output 1 if input is equal Value.002"(
    Value: Float = 0.5 in -10000.0..10000.0,
    Input: Float = 0.001 in -10000.0..10000.0
) -> (Value: Float) {
  return (Value: (Value + 0.01 > Input) * (Value - 0.01 < Input))
}

shader graph "Selector.002"(
    Input: Float = 0.100000024 in -10000.0..10000.0
) -> (
    "0": Float,
    "0.1": Float,
    "0.2": Float,
    "0.3": Float,
    "0.4": Float,
    "0.5": Float,
    "0.6": Float,
    "0.7": Float,
    "0.8": Float,
    "0.9": Float,
    "1": Float
) {
  group = output_1_if_input_is_equal_value_002(value: 0.8000001, input: Input)
  group_2 = output_1_if_input_is_equal_value_002(input: Input)
  group_3 = output_1_if_input_is_equal_value_002(value: 0.2, input: Input)
  group_4 = output_1_if_input_is_equal_value_002(value: 1.0, input: Input)
  group_5 = output_1_if_input_is_equal_value_002(value: 0.4, input: Input)
  group_6 = output_1_if_input_is_equal_value_002(value: 0.1, input: Input)
  group_7 = output_1_if_input_is_equal_value_002(value: 0.3, input: Input)
  group_8 = output_1_if_input_is_equal_value_002(value: 0.70000005, input: Input)
  group_9 = output_1_if_input_is_equal_value_002(value: 0.9000001, input: Input)
  group_10 = output_1_if_input_is_equal_value_002(value: 0.6, input: Input)
  group_11 = output_1_if_input_is_equal_value_002(value: 0.0, input: Input)
  "bwide.wordpress.com" {
    return (
      "0": group_11,
      "0.1": group_6,
      "0.2": group_3,
      "0.3": group_7,
      "0.4": group_5,
      "0.5": group_2,
      "0.6": group_10,
      "0.7": group_8,
      "0.8": group,
      "0.9": group_9,
      "1": group_4)
  }
}

shader graph "Selector0-1.002"(
    Select: Float in 0.0..1.0,
    Color: Color = (0.5, 0.496704, 0.0),
    Color as color_color: Color = (0.257913, 0.5, 0.0),
    Color as color_2: Color = (0.015911, 0.5, 0.0),
    Color as color_3: Color = (0.0, 0.5, 0.275122),
    Color as color_4: Color = (0.0, 0.365213, 0.5),
    Color as color_5: Color = (0.0, 0.125, 0.5),
    Color as color_6: Color = (0.103664, 0.0, 0.5),
    Color as color_7: Color = (0.276842, 0.0, 0.5),
    Color as color_8: Color = (0.5, 0.0, 0.323475),
    Color as color_9: Color = (0.5, 0.001576, 0.0),
    Color as color_10: Color = (0.5, 0.124847, 0.0),
    Color as color_11: Color = (0.5, 0.228229, 0.0)
) -> Color {
  mix_9 = Mix[RGBA](factor: 0.5, a: color_11, b: color_10) @ hide
  mix_10 = Mix[RGBA](factor: 0.5, a: mix_9, b: color_9) @ hide
  mix_11 = Mix[RGBA](factor: 0.5, a: mix_10, b: color_8) @ hide
  mix_6 = Mix[RGBA](factor: 0.5, a: mix_11, b: color_7) @ hide
  mix_7 = Mix[RGBA](factor: 0.5, a: mix_6, b: color_6) @ hide
  mix_8 = Mix[RGBA](factor: 0.5, a: mix_7, b: color_5) @ hide
  mix_5 = Mix[RGBA](factor: 0.5, a: mix_8, b: color_4) @ hide
  mix_3 = Mix[RGBA](factor: 0.5, a: mix_5, b: color_3) @ hide
  mix_2 = Mix[RGBA](factor: 0.5, a: mix_3, b: color_2) @ hide
  mix = Mix[RGBA](factor: 0.5, a: mix_2, b: color_color) @ hide
  mix_4 = Mix[RGBA](factor: 0.5, a: mix, b: Color) @ hide
  group = selector_002(input: Select)
  "bwide.wordpress.com" {
    return mix_4
  }
}
