shader graph "fres rough"(
    Fresnel: Float = 0.5999999 in 0.0..1.0,
    "Fresnel/Facing": Float(subtype: FACTOR) = 1.0 in 0.0..1.0,
    Center: Float(subtype: FACTOR) = 0.3 in 0.0..1.0,
    Edge: Float(subtype: FACTOR) in 0.0..1.0
) -> Color {
  layer_weight = LayerWeight(blend: Fresnel)
  mix = Mix[RGBA](
    factor: Mix[RGBA](factor: fresnel_facing, a: layer_weight.fresnel, b: layer_weight.facing),
    a: Center,
    b: Edge)
  "bwide.wordpress.com" {
    return mix
  }
}

shader graph "Ceramic.001"(
    Color: Color = (0.781753, 0.8, 0.7499394),
    "Center Gloss": Float(subtype: FACTOR) = 0.08 in 0.0..1.0,
    "Edge Gloss": Float(subtype: FACTOR) = 0.002 in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> (Exterior: Shader, Interior: Shader, Color: Color) {
  return (
    Exterior: MixShader(
      factor: Fresnel(ior: 1.5500001),
      a: AddShader(a: DiffuseBSDF(color: Color, roughness: 0.8, normal: Normal)),
      b: GlossyBSDF[BECKMANN](
        color: (0.9, 0.9, 0.9, 1.0),
        roughness: Math[POWER](Value: fres_rough(center: center_gloss, edge: edge_gloss)),
        normal: Normal)),
    Interior: AddShader(
      a: DiffuseBSDF(
        color: Color,
        normal: Bump(
          strength: 0.1,
          distance: 0.1,
          filter_width: 1.0,
          height: NoiseTexture(scale: 1000.0, distortion: 0.5).factor,
          normal: Normal))))
}
