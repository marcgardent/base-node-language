shader graph "MetalJewelry.002"(
    ForeColor: Color = (0.04357, 0.04357, 0.04357),
    MiddleColor: Color = (0.8, 0.8, 0.8),
    Roughness: Float = 0.00999,
    BackColor: Color = (0.8, 0.8, 0.8),
    Roughness as roughness_float: Float = 0.03999,
    Normal: Vector
) -> Shader {
  geometry = Geometry()
  return MixShader(
    factor: geometry.normal ⋅ geometry.incoming,
    a: GlossyBSDF[BECKMANN](color: BackColor, roughness: pow(roughness_float, 0.5), normal: Normal),
    b: GlossyBSDF[BECKMANN](
      color: Mix[RGBA](factor: LayerWeight(blend: 0.66499).facing, a: ForeColor, b: MiddleColor),
      roughness: pow(Roughness, 0.5),
      normal: Normal))
}
