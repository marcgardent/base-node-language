shader graph "FlakesHomogeneous.001"(
    BaseColor: Color = (0.8, 0.8, 0.8),
    Scale: Float = 500.0
) -> Shader {
  hue_saturation_value = HueSaturationValue(color: BaseColor) @ "ColorRepeater" hide
  return MixShader(
    factor: Gamma(color: VoronoiTexture(scale: Scale).color, gamma: 5.0),
    a: GlossyBSDF[BECKMANN](
      color: BrightnessContrast(color: hue_saturation_value, brightness: -0.2),
      roughness: 0.5477134),
    b: GlossyBSDF[BECKMANN](color: hue_saturation_value, roughness: 0.6324476))
}

shader graph "SpecularReflection.001"(
    Shader: Shader,
    Fac: Float = 0.02999,
    ColorSpec: Color = (0.8, 0.8, 0.8),
    RoughReflec: Float = 0.00999
) -> Shader {
  return MixShader(
    factor: Fac,
    a: Shader,
    b: GlossyBSDF[BECKMANN](color: ColorSpec, roughness: pow(RoughReflec, 0.5)))
}

shader(material: true) graph "Metalic Paint"() -> (surface: Shader) {
  RGB = (0.0, 0.3, 0.8, 1.0)
  return (
    surface: specularreflection_001(
      shader: flakeshomogeneous_001(basecolor: RGB, scale: 1000.0),
      fac: 0.1))
}
