shader(material: true) graph Building() -> (surface: Shader, displacement: Vector) {
  brick_texture = BrickTexture[offset_frequency: 1, squash_frequency: 3, offset: 0.0, squash: 0.0](
    vector: Mapping[VECTOR](
      vector: TextureCoordinate().generated,
      rotation: (1.57079, -0.78539, 3.1450837)),
    scale: 16.0,
    mortar_size: 0.05,
    mortar_smooth: 0.0,
    brick_width: 0.74999,
    row_height: 0.5)
  return (
    surface: MixShader(
      factor: brick_texture.factor,
      a: MixShader(
        factor: 0.72878337,
        a: GlassBSDF[BECKMANN](color: (0.72815, 1.0, 1.0, 1.0)),
        b: GlossyBSDF[BECKMANN](color: (1.0, 1.0, 1.0, 1.0), roughness: 0.141386)),
      b: DiffuseBSDF(color: (0.3304, 0.3304, 0.3304, 1.0))),
    displacement: Displacement(
      height: brick_texture.factor * 0.05,
      midlevel: 0.099999994,
      scale: 0.2))
}
