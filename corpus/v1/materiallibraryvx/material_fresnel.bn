shader graph "GL_Fresnel.001"(
    Power: Float = 2.5,
    Roughness: Float = 0.05,
    "Facing Limit": Float = 0.03999,
    Normal: Vector
) -> (Fresnel: Float) {
  return (
    Fresnel: Mix[RGBA](
      factor: pow(Roughness, 1.0 / Power),
      a: Mix[RGBA](
        factor: pow(LayerWeight(normal: Normal).facing, Power),
        a: facing_limit,
        b: (1.0, 1.0, 1.0, 1.0)),
      b: facing_limit))
}

shader(material: true) graph Fresnel() -> (surface: Shader) {
  emission = Emission(color: gl_fresnel_001()) @ "Viewer" #998066
  return (surface: emission)
}
