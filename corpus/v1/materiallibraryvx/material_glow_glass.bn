shader(material: true) graph "Glow Glass"() -> (surface: Shader) {
  return (
    surface: AddShader(
      a: MixShader(
        factor: RGBCurves[
          mapping: Curves(c: Curve((0.0, 0.0), (0.55454576, 0.4875005), (1.0, 1.0)))](
          color: Fresnel(ior: 1.45)),
        a: TransparentBSDF(),
        b: PrincipledBSDF[GGX, BURLEY](
          base_color: (0.86234015, 0.86234015, 0.86234015, 1.0),
          metallic: 1.0,
          roughness: 0.0,
          ior: 1.45,
          subsurface_scale: 0.05,
          emission_color: (0.0, 0.0, 0.0, 1.0),
          emission_strength: 1.0)),
      b: TransparentBSDF()))
}
