shader graph "SY_CoatedGlossy.000"(
    DiffuseColor: Color = (0.98, 0.0, 0.00999),
    GlossyColor: Color = (0.8, 0.8, 0.8),
    MirrorFac: Float = 0.05,
    Roughness: Float = 0.00999,
    CoatColor: Color = (0.09603, 0.09603, 0.09603),
    IOR: Float = 2.74999
) -> Shader {
  return MixShader(
    factor: Fresnel(ior: IOR),
    a: MixShader(
      factor: MirrorFac,
      a: DiffuseBSDF(color: DiffuseColor),
      b: GlossyBSDF[BECKMANN](color: GlossyColor, roughness: pow(Roughness, 0.5))),
    b: GlossyBSDF[BECKMANN](color: CoatColor, roughness: 0.099949986))
}

shader(material: true) graph "Coated Glossy"() -> (surface: Shader) {
  return (surface: sy_coatedglossy_000())
}
