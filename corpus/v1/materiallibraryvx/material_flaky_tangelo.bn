shader(material: true) graph "Flaky Tangelo"() -> (surface: Shader) {
  fresnel = Fresnel(ior: 2.0)
  RGB = (1.0, 0.18256, 0.0, 1.0)
  brightness_contrast = BrightnessContrast(color: RGB, brightness: -0.2)
  color = (0.5, 0.24046, 0.0, 1.0)
  color_2 = (0.7575, 0.50051, 0.0, 1.0)
  math_2 = fresnel * 0.2 @ hide
  math = 0.1 + math_2 @ hide
  return (
    surface: MixShader(
      factor: 0.03999,
      a: MixShader(
        factor: Gamma(color: VoronoiTexture(scale: 1500.0).color, gamma: 5.0),
        a: GlossyBSDF[BECKMANN](
          color: Mix[RGBA](factor: fresnel, a: brightness_contrast, b: color_2),
          roughness: 0.5477134),
        b: GlossyBSDF[BECKMANN](
          color: Mix[RGBA](
            factor: fresnel,
            a: brightness_contrast,
            b: BrightnessContrast(color: color, brightness: 0.5)),
          roughness: pow(math, 0.5))),
      b: GlossyBSDF[BECKMANN](roughness: 0.099949986)))
}
