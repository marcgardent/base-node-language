shader graph "Math.Root"(
    Value: Float = 0.5 in -10000.0..10000.0,
    Root: Float = 0.5 in -10000.0..10000.0
) -> (Value: Float) {
  return (Value: pow(Value, 1.0 / Root))
}

shader graph "PBR.Fresnel"(
    "Fresnel Power": Float = 5.0 in -10000.0..10000.0,
    "F-0": Float = 0.04 in 0.0..1.0,
    Roughness: Float in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> (Output: Float) {
  mix = Mix[RGBA](
    factor: pow(LayerWeight(normal: Normal).facing, fresnel_power),
    a: f_0,
    b: (1.0, 1.0, 1.0, 1.0)) @ hide
  mix_2 = Mix[RGBA](factor: math_root(value: Roughness, root: fresnel_power), a: mix, b: f_0) @ hide
  return (Output: mix_2)
}

shader graph SpecularLayer(
    Shader: Shader,
    Roughness: Float in 0.0..1.0,
    Normal: Vector(hide_value: true) in -1.0..1.0
) -> Shader {
  mix_shader = MixShader(
    factor: pbr_fresnel(roughness: Roughness, normal: Normal),
    a: Shader,
    b: GlossyBSDF[GGX](
      color: (1.0, 1.0, 1.0, 1.0),
      roughness: pow(Roughness, 0.5),
      normal: Normal)) @ hide
  return mix_shader
}

shader graph "PBR (Specular Setup)"(
    "Base Color": Color = (1.0, 1.0, 1.0),
    "Use Specular %": Float(subtype: FACTOR) in 0.0..100.0,
    "Specular Color": Color = (1.0, 1.0, 1.0),
    "Use Refraction %": Float(subtype: FACTOR) in 0.0..100.0,
    "Refraction Color": Color = (1.0, 1.0, 1.0),
    IOR: Float = 1.45 in 1.0..2.42,
    "Roughness %": Float(subtype: FACTOR) in 0.0..100.0,
    Normal: Vector(hide_value: true) in -1.0..1.0,
    "Coat Roughness %": Float(subtype: FACTOR) in 0.0..100.0,
    "Coat Normal": Vector(hide_value: true) in -1.0..1.0,
    "Volume Color": Color = (1.0, 1.0, 1.0),
    "Volume Density %": Float(subtype: FACTOR) in 0.0..100.0
) -> (Shader: Shader, Volume: Shader) {
  math = use_refraction / 100.0 @ "Percent" hide
  math_2 = roughness / 100.0 @ "Percent" hide
  math_3 = use_specular / 100.0 @ "Percent" hide
  mix_shader = MixShader(
    factor: math_3,
    a: DiffuseBSDF(color: base_color, roughness: math_2, normal: Normal),
    b: GlossyBSDF[GGX](
      color: specular_color,
      roughness: pow(math_2, 0.5),
      normal: Normal)) @ "Specular Factor"
  mix_shader_2 = MixShader(
    factor: math,
    a: mix_shader,
    b: RefractionBSDF(
      color: refraction_color,
      roughness: pow(math_2, 0.5),
      ior: IOR,
      normal: Normal)) @ "Refraction Factor"
  math_4 = coat_roughness / 100.0 @ "Percent" hide
  math_5 = volume_density / 100.0 @ "Percent" hide
  return (
    Shader: SpecularLayer(shader: mix_shader_2, roughness: math_4, normal: coat_normal),
    Volume: VolumeAbsorption(color: volume_color, density: math_5))
}
