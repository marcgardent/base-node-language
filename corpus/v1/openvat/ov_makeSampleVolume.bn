geometry graph ov_makeSampleVolume(
    Geometry: Geometry,
    Resolution: Int = 2 in 2..10,
    Size: Float = 4.0 in 1.0..10.0
) -> Geometry {
  math_2 = floor(Size) * Resolution
  math = 1.0 / math_2 * floor(Size) * math_2
  return MeshLine(count: math_2, offset: CombineXYZ(z: math / (math_2 - 1.0)))
    |> InstanceOnPoints(
      instance: Grid(size_x: math, size_y: math, vertices_x: math_2, vertices_y: math_2).mesh)
    |> RealizeInstances[realize_to_point_domain: true]()
    |> MeshToPoints()
    |> PointsToVertices()
    |> RealizeInstances[realize_to_point_domain: true]()
}
