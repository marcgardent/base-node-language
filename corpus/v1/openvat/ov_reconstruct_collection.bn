geometry graph ov_reconstruct_collection(
    Geometry: Geometry,
    Collection: Collection,
    Facecount: Int = 1000 in 1..10000
) -> (Geometry: Geometry, ov_normal: Vector, "Instance Count": Int) {
  realize_instances = CollectionInfo(collection: Collection)
    |> RealizeInstances[realize_to_point_domain: true]()
  split_to_instances = realize_instances
    |> Triangulate()
    |> SplitEdges()
    |> SplitToInstances[FACE](group_id: Index())
  capture_attribute = MeshLine(count: Facecount, offset: (0.0, 0.0, 0.0))
    |> InstanceOnPoints(
      instance: MeshCircle[TRIANGLE_FAN](vertices: 3)
        |> Triangulate()
        |> SeparateGeometry[FACE](selection: Index() == 0).selection)
    |> RealizeInstances[realize_to_point_domain: true]()
    |> SetPosition(
      position: split_to_instances.instances
        |> RealizeInstances[realize_to_point_domain: true]()
        |> SampleIndex[FLOAT_VECTOR](value: Position(), index: Index()))
    |> CaptureAttribute(
      Value: SampleIndex[FLOAT_VECTOR](
        realize_instances,
        value: Normal().normal,
        index: SampleNearest(realize_instances, sample_position: Position())),
      "Instance Count": DomainSize[INSTANCES](split_to_instances.instances))
  return (
    Geometry: capture_attribute.geometry,
    ov_normal: capture_attribute.value,
    "Instance Count": capture_attribute.instance_count)
}
