compositor graph "Split Toning"(
    Image: Color = (0.5, 0.5, 0.5),
    Highlights: Color(
      description: "Value of the first color input") = (0.49981207, 0.16640088, 0.07267823),
    "Factor Highlights": Float(subtype: FACTOR) = 0.5 in 0.0..1.0,
    Shadows: Color(
      description: "Value of the second color input") = (0.084500894, 0.2313829, 0.4998591),
    "Factor Shadows": Float(subtype: FACTOR) = 0.2 in 0.0..1.0,
    "Transition"(default_closed: true) {
        Balance: Float(
          description: "How dominant highlights are compared to shadows") = 0.2 in 0.0..10.0,
        Smoothness: Float(
          subtype: FACTOR,
          description: "Controls transition between highlights and shadows") = 0.4 in 0.0..0.5
    }
) -> (Image: Color) {
  math = Balance + (Smoothness + 0.0001) @ hide
  map_range = MapRange[SMOOTHSTEP](
    value: SeparateColor[HSV](Image).blue,
    from_min: Balance,
    from_max: math)
  return (
    Image: Mix[RGBA, COLOR](
      factor: (1.0 - map_range) * factor_shadows,
      a: Mix[RGBA, COLOR](factor: map_range * factor_highlights, a: Image, b: Highlights),
      b: Shadows))
}
