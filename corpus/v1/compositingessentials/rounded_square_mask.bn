compositor graph "Rounded Square Mask"(
    Image: Color(hide_value: true) = (0.8, 0.8, 0.8),
    Scale: Vector = (1.0, 1.0) in -10000.0..10000.0,
    "Corner Roundness": Float(subtype: FACTOR) in 0.0..1.0,
    Feather: Float(subtype: FACTOR) in 0.0..1.0,
    Offset: Vector(subtype: XYZ) = (0.0, 0.0),
    Angle: Float(subtype: ANGLE, description: "Angle to rotate the input vector by")
) -> (Mask: Float) {
  math = Feather + 0.0001
  image_info = ImageInfo(Image)
  vector_math_2 = Switch[RGBA](
      switch: Math[GREATER_THAN](
        Value: image_info.dimensions.y,
        Value_001: image_info.dimensions.x),
      false_: CombineXYZ(x: 1.0, y: 1.0 / image_info.dimensions.x * image_info.dimensions.y),
      true_: CombineXYZ(x: 1.0 / image_info.dimensions.y * image_info.dimensions.x, y: 1.0))
    * Scale
  switch = Switch[RGBA](
    switch: true,
    false_: corner_roundness,
    true_: Clamp(value: corner_roundness, max: min(vector_math_2.x, vector_math_2.y)))
  vector_math = abs(
      VectorRotate[Z_AXIS](vector: ImageCoordinates(Image).uniform - Offset, angle: Angle))
    - vector_math_2
    + VectorMath[SCALE](vector: (1.0, 1.0, 0.0), scale: switch)
  return (
    Mask: MapRange[SMOOTHSTEP](
      value: min(max(vector_math.x, vector_math.y), 0.0)
        + Math[SUBTRACT](Value: length(max(vector_math, 0.0)), Value_001: switch),
      from_min: MapRange(value: math, from_min: 1.0, from_max: 0.0, to_min: -0.5, to_max: 0.0),
      from_max: MapRange(
        value: math,
        from_min: 1.0,
        from_max: math * 0.5,
        to_min: 1.0,
        to_max: 0.0),
      to_min: 1.0,
      to_max: 0.0))
}
