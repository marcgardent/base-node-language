compositor graph "Unsharp Mask"(
    Image: Color,
    Radius: Float(description: "The pixel radius of the sharpening mask") = 8.0 in 0.0..10000.0,
    Factor: Float(subtype: FACTOR, description: "The amount of sharpening") = 0.5 in 0.0..1.0,
    Threshold: Float(description: "Edge threshold") in 0.0..1.0
) -> (Result: Color) {
  map_range = MapRange(value: Factor, to_max: 5.0)
  "Unsharp" {
    vector_math = Image
      + VectorMath[MULTIPLY](Vector: Image - Blur(Image, size: Radius), Vector_001: map_range)
  }
  "Threshold" {
    combine_xyz = CombineXYZ(
      x: Math[COMPARE](Value: Image.x, Value_001: vector_math.x, Value_002: Threshold),
      y: Math[COMPARE](Value: Image.y, Value_001: vector_math.y, Value_002: Threshold),
      z: Math[COMPARE](Value: Image.z, Value_001: vector_math.z, Value_002: Threshold))
  }
  set_alpha_2 = Mix[RGBA, clamp_factor: false](factor: combine_xyz, a: vector_math, b: Image)
    |> SetAlpha(alpha: SeparateColor[ITUBT601](vector_math).alpha, type: "Replace Alpha")
  "Restore Alpha" {
    set_alpha = SetAlpha(set_alpha_2, alpha: SeparateColor(Image).alpha, type: "Replace Alpha")
  }
  return (Result: set_alpha)
}
