compositor graph "Project with Depth"(
    Normalized: Vector(subtype: FACTOR) = (0.5, 0.5) in -10000.0..10000.0,
    Depth: Float = 1.0 in -10000.0..10000.0,
    Projection: Matrix,
    Transform: Matrix,
    "Clip Start": Float(subtype: DISTANCE) = 0.1 in -10000.0..10000.0,
    "Clip End": Float(subtype: DISTANCE) = 100.0 in -10000.0..10000.0
) -> (Vector: Vector(subtype: XYZ)) {
  "Project Depth" {
    "(f + n) / (f - n)" {
      math = (clip_start + clip_end) / (clip_end - clip_start)
    }
    "2fn / Z*(f - n)" {
      math_3 = clip_start * clip_end * 2.0 / (Depth * (clip_end - clip_start))
    }
    math_2 = math - math_3
  }
  {
    vector_math = VectorMath[MULTIPLY_ADD](
      Vector: Normalized,
      Vector_001: (2.0, 2.0, 2.0),
      Vector_002: (-1.0, -1.0, -1.0)) @ "[0, 1] to [-1, 1] unclamped"
    transform_point = TransformPoint(
      vector: ProjectPoint(
        vector: CombineXYZ(x: vector_math.x, y: vector_math.y, z: math_2),
        transform: Projection),
      transform: Transform)
  }
  return (Vector: transform_point)
}

compositor graph "Screen to 3D Space"(
    Normalized: Vector(
      subtype: FACTOR,
      description: "2D screen space coordinates in the [0, 1] range") = (0.5, 0.5) in 0.0..1.0,
    Depth: Float(
      subtype: DISTANCE,
      description: "Depth from camera in scene units. Same as depth pass") in -10000.0..10000.0,
    Camera: Object(description: "The camera used for rendering the scene", optional_label: true)
) -> (Vector: Vector(subtype: XYZ, description: "Projected 3D vector in 3D space")) {
  "Convert coordinates from screen to world space"
  camera_info = CameraInfo(camera: Camera)
  group = project_with_depth(
    normalized: Normalized,
    depth: Depth,
    projection: InvertMatrix(matrix: camera_info.projection_matrix).matrix,
    transform: ObjectInfo(object: Camera).transform,
    clip_start: camera_info.clip_start,
    clip_end: camera_info.clip_end) @ "Project with Depth"
  return (Vector: group)
}
