geometry graph "Curve Root"() -> (
    "Root Selection": Bool(description: "Boolean selection of curve root points"),
    "Root Position": Vector(
      description: "Position of the root point of a curve",
      attribute_domain: CURVE),
    "Root Direction": Vector(
      description: "Direction of the root segment of a curve",
      attribute_domain: CURVE),
    "Root Index": Int(description: "Index of the root point of a curve", attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](value: PointsOfCurve().point_index)
  return (
    "Root Selection": EndpointSelection(end_size: 0),
    "Root Position": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: evaluate_on_domain)),
    "Root Direction": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: CurveTangent(), index: evaluate_on_domain)),
    "Root Index": evaluate_on_domain)
}

geometry graph "Curve Tip"() -> (
    "Tip Selection": Bool(description: "Boolean selection of curve tip points"),
    "Tip Position": Vector(
      description: "Position of the tip point of a curve",
      attribute_domain: CURVE),
    "Tip Direction": Vector(
      description: "Direction of the tip segment of a curve",
      attribute_domain: CURVE),
    "Tip Index": Int(description: "Index of the tip point of a curve", attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](
    value: PointsOfCurve(sort_index: -1).point_index)
  return (
    "Tip Selection": EndpointSelection(start_size: 0),
    "Tip Position": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: Position(), index: evaluate_on_domain)),
    "Tip Direction": EvaluateOnDomain[CURVE, FLOAT_VECTOR](
      value: EvaluateAtIndex[FLOAT_VECTOR](value: CurveTangent(), index: evaluate_on_domain)),
    "Tip Index": evaluate_on_domain)
}

geometry graph "Curve Info"() -> (
    "Curve Index": Int(description: "Index of each curve", attribute_domain: CURVE),
    "Curve ID": Int(description: "ID of each curve", attribute_domain: CURVE),
    Length: Float(description: "Length of each curve", attribute_domain: CURVE),
    Direction: Vector(
      description: "Direction from root to tip of each curve",
      attribute_domain: CURVE),
    Random: Float(description: "Random vector for each curve", attribute_domain: CURVE),
    "Surface UV": Vector(
      description: "Attachment surface UV coordinates of each curve",
      attribute_domain: CURVE)
) {
  evaluate_on_domain = EvaluateOnDomain[CURVE, INT](value: Index()) @ hide
  "ID per Curve" {
    evaluate_on_domain_2 = EvaluateOnDomain[CURVE, INT](
      value: EvaluateAtIndex[INT](value: ID(), index: curve_root().root_index))
  }
  return (
    "Curve Index": evaluate_on_domain,
    "Curve ID": evaluate_on_domain_2,
    Length: SplineLength().length,
    Direction: normalize(curve_tip().tip_position - curve_root().root_position),
    Random: EvaluateOnDomain[CURVE](
      value: EvaluateAtIndex(
        value: RandomValue(id: evaluate_on_domain_2),
        index: curve_root().root_index)),
    "Surface UV": NamedAttribute[FLOAT_VECTOR](name: "surface_uv_coordinate").attribute)
}

geometry graph "Curve Segment"() -> (
    "Segment Length": Float(description: "Distance to the previous point on the curve"),
    "Segment Direction": Vector(
      description: "Direction from the previous neighboring point on the segment"),
    "Neighbor Index": Int(description: "Index of the previous neighboring point on the segment")
) {
  boolean = true
  evaluate_on_domain_2 = EvaluateOnDomain[CURVE, BOOLEAN](value: boolean)
  offset_point_in_curve = OffsetPointInCurve(offset: -1)
  switch_4 = offset_point_in_curve.is_valid_offset ? offset_point_in_curve.point_index : Index()
  switch_3 = evaluate_on_domain_2 ? EvaluateOnDomain[INT](value: switch_4) : 0 @ hide
  position = Position()
  evaluate_on_domain = EvaluateOnDomain[FLOAT_VECTOR](
    value: position - EvaluateAtIndex[FLOAT_VECTOR](value: position, index: switch_4))
  switch = evaluate_on_domain_2 ? normalize(evaluate_on_domain) : (0.0, 0.0, 0.0) @ hide
  switch_2 = evaluate_on_domain_2 ? length(evaluate_on_domain) : 0.0 @ hide
  return ("Segment Length": switch_2, "Segment Direction": switch, "Neighbor Index": switch_3)
}

geometry(is_modifier: true, show_modifier_manage_panel: false) graph "Restore Curve Segment Length"(
    Curves: Geometry,
    Selection: Bool(description: "Only affect selected elements", hide_value: true) = true,
    Factor: Float(subtype: FACTOR, description: "Factor to blend overall effect") = 1.0 in 0.0..1.0,
    "Reference Position": Vector(
      description: "Reference position before deformation",
      hide_value: true,
      default_attribute_name: "rest_position") = (8.14654, 4.96987, 9.87454),
    "Pin at Parameter": Float(
      subtype: FACTOR,
      description: "Pin each curve at a certain point for the operation") in 0.0..1.0
) -> (Curves: Geometry) {
  "Restore Segment Lengths" {
    index = Index()
    math = index - 1.0 @ hide
    compare = CurveOfPoint().index_in_curve == 0 @ hide
    group = curve_segment()
  }
  "Default Fallback" {
    named_attribute = NamedAttribute[FLOAT_VECTOR](name: "rest_position")
    switch_2 = Compare[EQUAL, VECTOR](
        a: reference_position,
        b: (8.14654, 4.96987, 9.87454),
        epsilon: 0.0)
      ? (named_attribute.exists ? named_attribute.attribute : Position())
      : reference_position
  }
  "Restore Segment Lengths" .. {
    set_position = SetPosition(
      Curves,
      selection: Factor > 0.0 and Selection,
      position: curve_root().root_position,
      offset: AccumulateField[FLOAT_VECTOR](
        value: group.segment_direction
          * Mix(
            factor: Factor,
            a: group.segment_length,
            b: distance(
              EvaluateAtIndex[FLOAT_VECTOR](
                value: switch_2,
                index: Switch[INT](switch: compare, false_: math, true_: index)),
              switch_2)),
        group_id: CurveOfPoint().curve_index).leading)
  }
  "Pin at Parameter" {
    sample_curve = SampleCurve[FLOAT_VECTOR](
      set_position,
      value: switch_2,
      factor: pin_at_parameter,
      curve_index: Index())
    vector_math = sample_curve.value - sample_curve.position @ hide
    evaluate_on_domain = EvaluateOnDomain[CURVE, FLOAT_VECTOR](value: vector_math) @ hide
    compare_2 = Compare[NOT_EQUAL](a: pin_at_parameter, epsilon: 0.0) @ hide
    boolean_math = compare_2 and Selection @ hide
    attribute_statistic = AttributeStatistic[CURVE](set_position, attribute: boolean_math) @ hide
    compare_3 = attribute_statistic.max > 0.0 @ hide
    switch = compare_3
      ? SetPosition(set_position, selection: boolean_math, offset: evaluate_on_domain)
      : set_position
  }
  return (Curves: switch)
}

geometry graph ".shape_range"(
    Value: Float(hide_value: true) in 0.0..1.0,
    Min: Float(description: "rdghrhd") in -10000.0..10000.0,
    Max: Float = 1.0 in -10000.0..10000.0,
    Shape: Float in -1.0..1.0,
    Base: Float = 2.0 in 1.0..10000.0
) -> (Value: Float) {
  map_range = MapRange[clamp: false](value: Value, from_min: Min, from_max: Max) @ hide
  math_2 = 1.0 - map_range @ hide
  compare = Shape < 0.0 @ hide
  boolean_math = not compare @ hide
  math_7 = max(Base, 1.00001) @ hide
  math_3 = 1.0 / math_7 @ hide
  math_4 = 1.0 - math_3 @ hide
  math_5 = math_4 * 2.0 @ hide
  math_10 = max(math_7, 1.000001) @ hide
  math_15 = min(abs(Shape), 0.999999)
  compare_2 = math_15 > 0.5 @ hide
  switch_2 = compare_2 ? boolean_math : compare @ hide
  switch = switch_2 ? math_2 : map_range @ hide
  math_14 = Math[PINGPONG](Value: math_15) @ hide
  math_6 = math_14 * math_5 @ hide
  math_9 = 1.0 - math_6 @ hide
  math_11 = max(math_9, 1e-05) @ hide
  math_13 = log(math_11, math_10) @ hide
  math_8 = -math_13 @ hide
  math_12 = pow(switch, math_8)
  math = 1.0 - math_12 @ hide
  switch_3 = compare_2 ? math : math_12 @ hide
  return (
    Value: Compare[EQUAL](a: Shape, epsilon: 1e-05)
      ? 1.0
      : MapRange(value: switch_3, to_min: Min, to_max: Max))
}

geometry(is_modifier: true, show_modifier_manage_panel: false) graph "Smooth Hair Curves"(
    Geometry: Geometry(description: "Input geometry (may include geometry other than curves)"),
    Amount: Float(subtype: FACTOR, description: "Amount of smoothing") = 1.0 in -1.0..1.0,
    Shape: Float(
      description: "Shape of the influence along curves (0 = constant, 0.5 = linear)") in -1.0..1.0,
    Iterations: Int(description: "Amount of smoothing steps") = 10 in 0..10000,
    Weight: Float(subtype: FACTOR, description: "Weight used for smoothing") = 0.5 in 0.0..1.0,
    "Lock Tips": Bool(description: "Lock tip position when smoothing"),
    "Preserve Length": Bool(description: "Preserve each curve's length during deformation") = true
) -> Geometry {
  "Optimization" {
    compare = Compare[NOT_EQUAL](a: Amount, epsilon: 0.0) @ hide
    accumulate_field = AccumulateField[INT, CURVE](value: compare) @ hide
    sample_index = SampleIndex[INT, CURVE](Geometry, value: accumulate_field.total) @ hide
    compare_2 = sample_index == 0 @ hide
  }
  "Blurred Position Attribute" {
    "Root Pinning" {
      group_2 = curve_root()
    }
  }
  "Smoothing Mask" {
    boolean_math_2 = Compare[NOT_EQUAL](a: Amount, epsilon: 0.0) and Weight > 0.0 @ hide
    boolean_math_4 = curve_tip().tip_selection and lock_tips @ hide
    boolean_math_3 = not boolean_math_4 @ hide
    boolean_math_5 = boolean_math_3 and boolean_math_2 @ hide
  }
  "Smooth Weight" {
    math = Weight
      * boolean_math_5
      * (shape_range(value: SplineParameter().factor, shape: Shape, base: 2.7182817)
        * (not curve_root().root_selection))
  }
  "Length Preservation" {
    boolean_math = preserve_length and boolean_math_2 @ hide
  }
  "Blurred Position Attribute" .. {
    blur_attribute = BlurAttribute[FLOAT_VECTOR](
      value: Position(),
      iterations: Iterations,
      weight: math)
    "Root Pinning" .. {
      evaluate_at_index_2 = EvaluateAtIndex[FLOAT_VECTOR](
        value: blur_attribute,
        index: group_2.root_index) @ hide
    }
  }
  get_geometry_component = GetGeometryComponent(Geometry, type: Curve)
  "Optimization" {
    capture_attribute_2 = CaptureAttribute[CURVE](
      get_geometry_component.component,
      Value: SplineResolution())
    set_spline_type = SetSplineType(capture_attribute_2.geometry)
  }
  capture_attribute = CaptureAttribute(set_spline_type, Value: Position())
  "Blurred Position Attribute" .. {
    "Root Pinning" .. {
      evaluate_at_index = EvaluateAtIndex[FLOAT_VECTOR](
        value: capture_attribute.value,
        index: group_2.root_index) @ hide
      vector_math_2 = blur_attribute - (evaluate_at_index - evaluate_at_index_2)
    }
    vector_math = (vector_math_2 - Position()) * Amount
  }
  set_position = SetPosition(
    capture_attribute.geometry,
    selection: boolean_math_5,
    offset: vector_math)
  "Length Preservation" .. {
    group = restore_curve_segment_length(
      set_position,
      selection: boolean_math,
      reference_position: capture_attribute.value)
  }
  "Optimization" {
    set_spline_resolution = group
      |> SetSplineType[CATMULL_ROM]()
      |> SetSplineResolution(
        resolution: capture_attribute_2.value == 0 ? 12 : capture_attribute_2.value)
  }
  join_geometry = get_geometry_component.geometry + set_spline_resolution
  "Optimization" {
    switch = Iterations == 0 or compare_2 ? Geometry : join_geometry
  }
  return switch
}

geometry(show_modifier_manage_panel: false) graph "Roll Hair Curves"(
    Geometry: Geometry,
    Factor: Float(
      subtype: FACTOR,
      description: "Factor to blend the overall effect") = 1.0 in 0.0..1.0,
    Subdivision: Int(description: "Subdivision level applied before deformation") = 1 in 0..6,
    "Variation Level": Int(
      description: "Level of smoothing on the roll path to include shape variation") = 10 in 0..100,
    "Roll Length": Float(
      subtype: DISTANCE,
      description: "Length of each curve to be rolled") = 0.1 in 0.0..,
    "Roll Radius": Float(subtype: DISTANCE, description: "Radius of the rolls") = 0.05 in 0.0..,
    "Roll Depth": Float(subtype: DISTANCE, description: "Depth offset of the roll"),
    "Roll Taper": Float(subtype: FACTOR, description: "Taper of the roll") in 0.0..1.0,
    "Retain Overall Shape": Float(
      subtype: FACTOR,
      description: "Offset the roll along the original curve to retain shape") in 0.0..1.0,
    "Roll Direction": Vector(
      description: "Axis around which each curve is rolled",
      hide_value: true,
      hide_in_modifier: true),
    "Random Orientation": Float(
      subtype: FACTOR,
      description: "Amount of randomization of the direction of the roll") = 0.5 in 0.0..1.0,
    Seed: Int(description: "Random seed for the operation") in -10000..10000,
    "Preserve Length": Bool(description: "Preserve each curve's length during deformation")
) -> Geometry {
  "Store Detail in Tangent Space" {
    curve_tangent = CurveTangent()
    normal = Normal[legacy_corner_normals: true]()
    vector_math_4 = curve_tangent × normal.normal @ hide
  }
  "Randomization" {
    math = RandomValue(
        min: -3.1415927,
        max: 3.1415927,
        id: curve_info().curve_id,
        seed: HashValue(value: Seed, seed: -615487))
      * random_orientation
  }
  "Normal Fallback" {
    compare = Compare[NOT_EQUAL, VECTOR](a: roll_direction, epsilon: 0.0) @ hide
  }
  group_3 = curve_info()
  math_9 = roll_length * Factor @ hide
  evaluate_on_domain_2 = EvaluateOnDomain[CURVE](value: math_9) @ hide
  math_8 = min(group_3.length, evaluate_on_domain_2) @ hide
  math_10 = group_3.length - math_8
  "Restore Detail" {
    normal_2 = Normal[legacy_corner_normals: true]()
    curve_tangent_2 = CurveTangent()
    vector_math_16 = curve_tangent_2 × normal_2.normal @ hide
  }
  math_11 = SplineParameter().length - math_10 @ hide
  "Roll Displacement Vector" {
    math_7 = math_11 * (roll_depth / 6.2831855) @ hide
  }
  "Cumulative Segment Length" {
    compare_2 = math_11 > 0.0
  }
  "Displacement" {
    boolean_math = compare_2 and Factor > 0.0 @ hide
  }
  "Radius" {
    evaluate_on_domain_3 = EvaluateOnDomain[CURVE](value: roll_radius) @ hide
    math_12 = evaluate_on_domain_3
      * Mix(factor: roll_taper, a: 1.0, b: 1.0 - math_11 / group_3.length)
    math_13 = math_11 / math_12
  }
  "Cumulative Segment Length" .. {
    switch_2 = Compare[EQUAL](a: roll_taper, epsilon: 0.0)
      ? math_13
      : AccumulateField(
        value: curve_segment().segment_length / math_12 * compare_2,
        group_id: curve_info().curve_index).leading
  }
  "Roll Displacement Vector" .. {
    math_2 = cos(switch_2) @ hide
    math_3 = sin(switch_2) @ hide
    math_4 = math_2 * math_12 @ hide
    math_5 = math_3 * math_12 @ hide
    math_6 = evaluate_on_domain_3 - math_4 @ hide
  }
  get_geometry_component = GetGeometryComponent(Geometry, type: Curve)
  "Optimization" {
    capture_attribute_6 = CaptureAttribute(
      get_geometry_component.component,
      Value: SplineResolution())
    set_spline_type = SetSplineType(capture_attribute_6.geometry)
  }
  capture_attribute_5 = CaptureAttribute(set_spline_type, Value: Position()) @ hide
  "Smoothed Curve as Roll Base" {
    group = smooth_hair_curves(
      capture_attribute_5.geometry,
      iterations: variation_level,
      weight: 1.0,
      lock_tips: true,
      preserve_length: false)
  }
  sample_curve = SampleCurve[LENGTH, FLOAT_VECTOR](
    group,
    length: math_10,
    curve_index: curve_info().curve_index)
  capture_attribute_3 = CaptureAttribute[CURVE](group, Value: sample_curve.position) @ hide
  capture_attribute_2 = CaptureAttribute[CURVE](
    capture_attribute_3.geometry,
    Value: sample_curve.tangent) @ hide
  capture_attribute = CaptureAttribute[CURVE](
    capture_attribute_2.geometry,
    Value: sample_curve.normal) @ hide
  "Store Detail in Tangent Space" .. {
    vector_math_5 = capture_attribute_5.value - Position() @ hide
    vector_math = vector_math_5 ⋅ vector_math_4 @ hide
    vector_math_2 = vector_math_5 ⋅ curve_tangent @ hide
    vector_math_3 = vector_math_5 ⋅ normal.normal @ hide
    combine_xyz = CombineXYZ(x: vector_math_3, y: vector_math, z: vector_math_2)
  }
  capture_attribute_4 = CaptureAttribute(capture_attribute.geometry, Value: combine_xyz) @ hide
  "Normal Fallback" .. {
    vector_math_6 = VectorMath[PROJECT](
      Vector: roll_direction,
      Vector_001: capture_attribute_2.value) @ hide
    vector_math_7 = roll_direction - vector_math_6 @ hide
    vector_math_8 = normalize(vector_math_7) @ hide
    switch = compare ? vector_math_8 : capture_attribute.value
  }
  evaluate_on_domain = EvaluateOnDomain[CURVE, FLOAT_VECTOR](
    value: VectorRotate(vector: switch, axis: capture_attribute_2.value, angle: math))
  "Roll Displacement Vector" .. {
    vector_math_9 = capture_attribute_2.value * math_5 @ hide
    vector_math_11 = evaluate_on_domain * math_6 @ hide
    vector_math_13 = vector_math_9 + vector_math_11 @ hide
    vector_math_14 = capture_attribute_2.value × evaluate_on_domain @ hide
    vector_math_12 = vector_math_14 * math_7 @ hide
    vector_math_10 = vector_math_13 + vector_math_12 @ hide
    vector_math_15 = Mix[VECTOR](
        factor: retain_overall_shape,
        a: capture_attribute_3.value,
        b: Position())
      + vector_math_10
  }
  "Restore Detail" .. {
    vector_math_17 = vector_math_16 * capture_attribute_4.value.y @ hide
    vector_math_18 = curve_tangent_2 * capture_attribute_4.value.z @ hide
    vector_math_21 = normal_2.normal * capture_attribute_4.value.x @ hide
    vector_math_20 = vector_math_21 + vector_math_17 @ hide
    vector_math_19 = vector_math_20 + vector_math_18 @ hide
  }
  "Subdivision" {
    subdivide_curve = SubdivideCurve(
      capture_attribute_4.geometry,
      cuts: pow(2.0, Subdivision) - 1.0)
  }
  "Displacement" .. {
    set_position_2 = SetPosition(
      subdivide_curve,
      selection: boolean_math,
      position: Mix[VECTOR](factor: compare_2, a: Position(), b: vector_math_15))
  }
  set_position = SetPosition(set_position_2, selection: variation_level > 0, offset: vector_math_19)
  "Length Preservation" {
    group_2 = restore_curve_segment_length(
      set_position,
      selection: preserve_length,
      reference_position: capture_attribute_5.value)
  }
  "Optimization" {
    set_spline_resolution = group_2
      |> SetSplineType[CATMULL_ROM]()
      |> SetSplineResolution(
        resolution: capture_attribute_6.value == 0 ? 12 : capture_attribute_6.value)
  }
  return get_geometry_component.geometry + set_spline_resolution
}
