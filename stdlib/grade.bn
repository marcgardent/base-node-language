// Base Node Standard Library — Module grade
// @module grade
// @version 1.0.0-rc.7
// @target blender
// @edition 2026
// @description Compositor colour tools on premultiplied images: Nuke's Grade and ColorCorrect, saturation by Rec. 709, Rec. 2020 or ACEScg luma, hue shift, exposure in stops, soft clip, clamp, Cineon log2lin and lin2log

// The colour tools of compositing, on premultiplied images as the compositor gives them: each one
// grades the colours divided by the alpha, multiplies them by it again and leaves the alpha alone.
// Where the alpha is 0 the colours stay 0. mix and mask fade the result back to the image: the
// image where they are 0.
// A parameter given per channel is a Vector of red, green and blue, as x, y and z: a Color would
// not take a value below 0. A negative value goes through a power as it is, as a gamma leaves it:
// only the positive part is raised.

use merge (unpremult, premult, with_alpha, alpha_of, keymix)

// ---- Channels ----

compositor graph "signed pow"(x: Float, exponent: Float = 1.0) -> Float {
  "x to the exponent where it is positive, x itself where it is not"
  return pow(max(x, 0.0), exponent) + min(x, 0.0)
}

compositor graph "rec709 luma"(image: Color) -> Float {
  "Luminance of the colours by the weights of Rec. 709"
  c = SeparateColor(image)
  return c.red * 0.2126 + c.green * 0.7152 + c.blue * 0.0722
}

compositor graph "gray of"(value: Float, alpha: Float = 1.0) -> Color {
  "A gray of this value on the three channels, with this alpha"
  return CombineColor(red: value, green: value, blue: value, alpha: alpha)
}

compositor graph "graded image"(
    image: Color,
    graded: Color,
    mix: Float = 1.0,
    mask: Float = 1.0
) -> Color {
  "The graded colours, straight, made premultiplied and faded back to the image by mix and mask"
  return keymix(premult(graded), image, mask, mix)
}

// ---- Grade ----

compositor graph "grade channel"(
    x: Float,
    blackpoint: Float,
    whitepoint: Float = 1.0,
    lift: Float,
    gain: Float = 1.0,
    multiply: Float = 1.0,
    offset: Float,
    gamma: Float = 1.0,
    reverse: Bool,
    clamp_black: Bool = true,
    clamp_white: Bool
) -> Float {
  "pow(A x + B, 1/gamma), A = multiply (gain - lift) / (whitepoint - blackpoint), B = offset + lift - A blackpoint; reverse undoes it"
  a = multiply * (gain - lift) / (whitepoint - blackpoint)
  b = offset + lift - a * blackpoint
  y = Switch(
    switch: reverse,
    false_: signed_pow(a * x + b, 1.0 / gamma),
    true_: (signed_pow(x, gamma) - b) / a)
  low = Switch(switch: clamp_black, false_: y, true_: max(y, 0.0))
  return Switch(switch: clamp_white, false_: low, true_: min(low, 1.0))
}

compositor graph grade(
    image: Color,
    blackpoint: Vector = (0.0, 0.0, 0.0),
    whitepoint: Vector = (1.0, 1.0, 1.0),
    lift: Vector = (0.0, 0.0, 0.0),
    gain: Vector = (1.0, 1.0, 1.0),
    multiply: Vector = (1.0, 1.0, 1.0),
    offset: Vector = (0.0, 0.0, 0.0),
    gamma: Vector = (1.0, 1.0, 1.0),
    reverse: Bool,
    clamp_black: Bool = true,
    clamp_white: Bool,
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "Nuke's Grade: blackpoint to 0 and whitepoint to 1, then lift, gain, multiply, offset and gamma, per channel; reverse undoes it"
  c = SeparateColor(unpremult(image))
  k = SeparateXYZ(vector: blackpoint)
  w = SeparateXYZ(vector: whitepoint)
  l = SeparateXYZ(vector: lift)
  g = SeparateXYZ(vector: gain)
  m = SeparateXYZ(vector: multiply)
  o = SeparateXYZ(vector: offset)
  e = SeparateXYZ(vector: gamma)
  graded = CombineColor(
    red: grade_channel(c.red, k.x, w.x, l.x, g.x, m.x, o.x, e.x, reverse, clamp_black, clamp_white),
    green: grade_channel(
      c.green,
      k.y,
      w.y,
      l.y,
      g.y,
      m.y,
      o.y,
      e.y,
      reverse,
      clamp_black,
      clamp_white),
    blue: grade_channel(
      c.blue,
      k.z,
      w.z,
      l.z,
      g.z,
      m.z,
      o.z,
      e.z,
      reverse,
      clamp_black,
      clamp_white),
    alpha: c.alpha)
  return graded_image(image, graded, mix, mask)
}

// ---- Colour correct ----

compositor graph "correct channel"(
    x: Float,
    luma: Float,
    saturation: Float = 1.0,
    contrast: Float = 1.0,
    gamma: Float = 1.0,
    gain: Float = 1.0,
    offset: Float
) -> Float {
  "Saturation around the luma, contrast around 0.18, gamma, gain then offset: one range of a colour correct"
  s = luma + (x - luma) * saturation
  k = signed_pow(s / 0.18, contrast) * 0.18
  return signed_pow(k, 1.0 / gamma) * gain + offset
}

compositor graph "correct range"(
    image: Color,
    saturation: Float = 1.0,
    contrast: Float = 1.0,
    gamma: Float = 1.0,
    gain: Float = 1.0,
    offset: Float
) -> Color {
  "The colours of a straight image through one range of a colour correct"
  c = SeparateColor(image)
  luma = rec709_luma(image)
  return CombineColor(
    red: correct_channel(c.red, luma, saturation, contrast, gamma, gain, offset),
    green: correct_channel(c.green, luma, saturation, contrast, gamma, gain, offset),
    blue: correct_channel(c.blue, luma, saturation, contrast, gamma, gain, offset),
    alpha: c.alpha)
}

compositor graph "color correct"(
    image: Color,
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0,
    "Master" {
        saturation: Float = 1.0 in 0.0..,
        contrast: Float = 1.0 in 0.0..,
        gamma: Float = 1.0 in 0.0..,
        gain: Float = 1.0,
        offset: Float
    },
    "Shadows"(default_closed: true) {
        "shadows saturation": Float = 1.0 in 0.0..,
        "shadows contrast": Float = 1.0 in 0.0..,
        "shadows gamma": Float = 1.0 in 0.0..,
        "shadows gain": Float = 1.0,
        "shadows offset": Float
    },
    "Midtones"(default_closed: true) {
        "midtones saturation": Float = 1.0 in 0.0..,
        "midtones contrast": Float = 1.0 in 0.0..,
        "midtones gamma": Float = 1.0 in 0.0..,
        "midtones gain": Float = 1.0,
        "midtones offset": Float
    },
    "Highlights"(default_closed: true) {
        "highlights saturation": Float = 1.0 in 0.0..,
        "highlights contrast": Float = 1.0 in 0.0..,
        "highlights gamma": Float = 1.0 in 0.0..,
        "highlights gain": Float = 1.0,
        "highlights offset": Float
    },
    "Ranges"(default_closed: true) {
        "shadows start": Float,
        "shadows end": Float = 0.09,
        "highlights start": Float = 0.5,
        "highlights end": Float = 1.0
    }
) -> Color {
  "Nuke's ColorCorrect: saturation, contrast, gamma, gain and offset of the master times those of the shadows, midtones and highlights, mixed by the luma"
  c = unpremult(image)
  luma = rec709_luma(c)
  low = 1.0 - MapRange[SMOOTHSTEP](value: luma, from_min: shadows_start, from_max: shadows_end)
  high = MapRange[SMOOTHSTEP](value: luma, from_min: highlights_start, from_max: highlights_end)
  shadows = correct_range(
    c,
    saturation * shadows_saturation,
    contrast * shadows_contrast,
    gamma * shadows_gamma,
    gain * shadows_gain,
    offset + shadows_offset)
  midtones = correct_range(
    c,
    saturation * midtones_saturation,
    contrast * midtones_contrast,
    gamma * midtones_gamma,
    gain * midtones_gain,
    offset + midtones_offset)
  highlights = correct_range(
    c,
    saturation * highlights_saturation,
    contrast * highlights_contrast,
    gamma * highlights_gamma,
    gain * highlights_gain,
    offset + highlights_offset)
  graded = shadows * low + midtones * (1.0 - low - high) + highlights * high
  return graded_image(image, with_alpha(graded, alpha_of(image)), mix, mask)
}

// ---- Saturation and hue ----

compositor graph saturation(
    image: Color,
    s: Float = 1.0 in 0.0..,
    luma: Menu = Rec709,
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "The colours pushed away from their luma by s, 0 for a gray; the luma by the weights of Rec. 709, Rec. 2020 or ACEScg"
  c = unpremult(image)
  weights = MenuSwitch(
    menu: luma,
    Rec709: (0.2126, 0.7152, 0.0722),
    Rec2020: (0.2627, 0.678, 0.0593),
    ACEScg: (0.2722287, 0.6740818, 0.0536895))
  gray = gray_of(c ⋅ weights)
  return graded_image(image, with_alpha(c * s + gray * (1.0 - s), alpha_of(image)), mix, mask)
}

compositor graph "hue shift"(
    image: Color,
    angle: Float(subtype: ANGLE),
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "The colours turned by angle around the gray axis: red to green to blue for a positive angle"
  c = unpremult(image)
  turned = VectorRotate[AXIS_ANGLE](vector: c, axis: (1.0, 1.0, 1.0), angle: angle)
  return graded_image(image, with_alpha(turned, alpha_of(image)), mix, mask)
}

// ---- Range ----

compositor graph "exposure stops"(
    image: Color,
    stops: Float,
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "The colours times 2 to the stops: one stop doubles them"
  c = unpremult(image)
  return graded_image(image, with_alpha(c * pow(2.0, stops), alpha_of(image)), mix, mask)
}

compositor graph "soft clip channel"(x: Float, start: Float = 0.8, limit: Float = 1.0) -> Float {
  "x below start; above, limit - k exp(-(x - start) / k), k = limit - start: nearing limit, never reaching it"
  k = limit - start
  return min(x, start) + limit - k * exp((start - max(x, start)) / k) - start
}

compositor graph "soft clip"(
    image: Color,
    start: Float = 0.8,
    limit: Float = 1.0,
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "Colours above start bent smoothly toward limit, never past it, channel by channel"
  c = SeparateColor(unpremult(image))
  clipped = CombineColor(
    red: soft_clip_channel(c.red, start, limit),
    green: soft_clip_channel(c.green, start, limit),
    blue: soft_clip_channel(c.blue, start, limit),
    alpha: c.alpha)
  return graded_image(image, clipped, mix, mask)
}

compositor graph "clamp channels"(
    image: Color,
    low: Vector = (0.0, 0.0, 0.0),
    high: Vector = (1.0, 1.0, 1.0),
    mix: Float = 1.0 in 0.0..1.0,
    mask: Float = 1.0 in 0.0..1.0
) -> Color {
  "The colours kept between low and high, channel by channel"
  c = unpremult(image)
  return graded_image(image, with_alpha(max(min(c, high), low), alpha_of(image)), mix, mask)
}

// ---- Cineon ----

compositor graph "cineon offset"(
    black: Float = 95.0,
    white: Float = 685.0,
    gamma: Float = 0.6
) -> Float {
  "The linear value of the black of a Cineon log, before it is taken to 0"
  return pow(10.0, (black - white) * 0.002 / gamma)
}

compositor graph "log2lin channel"(
    x: Float,
    black: Float = 95.0,
    white: Float = 685.0,
    gamma: Float = 0.6
) -> Float {
  "(10^((1023 x - white) 0.002 / gamma) - offset) / (1 - offset): a Cineon code over 1023 made linear"
  offset = cineon_offset(black, white, gamma)
  return (pow(10.0, (x * 1023.0 - white) * 0.002 / gamma) - offset) / (1.0 - offset)
}

compositor graph "lin2log channel"(
    x: Float,
    black: Float = 95.0,
    white: Float = 685.0,
    gamma: Float = 0.6
) -> Float {
  "(white + log10(x (1 - offset) + offset) gamma / 0.002) / 1023: a linear value made a Cineon code over 1023"
  offset = cineon_offset(black, white, gamma)
  return (white + log(x * (1.0 - offset) + offset, 10.0) * gamma / 0.002) / 1023.0
}

compositor graph log2lin(
    image: Color,
    black: Float = 95.0 in 0.0..1023.0,
    white: Float = 685.0 in 0.0..1023.0,
    gamma: Float = 0.6 in 0.0..
) -> Color {
  "Cineon log colours, codes over 1023, made linear: black to 0, white to 1"
  c = SeparateColor(unpremult(image))
  linear = CombineColor(
    red: log2lin_channel(c.red, black, white, gamma),
    green: log2lin_channel(c.green, black, white, gamma),
    blue: log2lin_channel(c.blue, black, white, gamma),
    alpha: c.alpha)
  return premult(linear)
}

compositor graph lin2log(
    image: Color,
    black: Float = 95.0 in 0.0..1023.0,
    white: Float = 685.0 in 0.0..1023.0,
    gamma: Float = 0.6 in 0.0..
) -> Color {
  "Linear colours made Cineon log, codes over 1023: 0 to black, 1 to white"
  c = SeparateColor(unpremult(image))
  coded = CombineColor(
    red: lin2log_channel(c.red, black, white, gamma),
    green: lin2log_channel(c.green, black, white, gamma),
    blue: lin2log_channel(c.blue, black, white, gamma),
    alpha: c.alpha)
  return premult(coded)
}
